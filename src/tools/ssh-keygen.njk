---
toolSlug: ssh-keygen
permalink: /tools/ssh-keygen/
---

<div class="sk-safety-note" role="note">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
  Keys are generated entirely in your browser using the Web Crypto API. Nothing is transmitted to any server.
</div>

<div class="tool-row">
  <div class="tool-options" role="group" aria-label="Key type">
    <button class="tool-option active" data-keytype="RSA-2048" aria-pressed="true">RSA-2048</button>
    <button class="tool-option" data-keytype="RSA-4096" aria-pressed="false">RSA-4096</button>
    <button class="tool-option" data-keytype="Ed25519" aria-pressed="false">Ed25519 <span style="font-size:0.7em;color:#f97316;">(library)</span></button>
  </div>
</div>

<div id="sk-ed25519-note" style="display:none;" class="sk-notice">
  Ed25519 is not natively supported by the browser Web Crypto API (it lacks SubjectPublicKeyInfo DER export). This tool generates RSA keys fully client-side. For Ed25519, use <code>ssh-keygen -t ed25519</code> on the command line or a library like <a href="https://www.npmjs.com/package/@noble/ed25519" target="_blank" rel="noopener">@noble/ed25519</a>.
</div>

<div class="tool-group">
  <label for="sk-comment">Key comment (optional)</label>
  <input type="text" id="sk-comment" placeholder="user@hostname" spellcheck="false" autocomplete="off">
  <span style="font-size:0.75rem;color:var(--text-3,#888);margin-top:0.3rem;display:block;">Appears at the end of the public key for identification. Typically user@hostname.</span>
</div>

<div class="tool-group">
  <label for="sk-passphrase">Passphrase (optional)</label>
  <input type="password" id="sk-passphrase" placeholder="Leave empty for no passphrase" autocomplete="new-password">
  <span style="font-size:0.75rem;color:var(--text-3,#888);margin-top:0.3rem;display:block;">A passphrase encrypts the private key at rest. Recommended for keys stored on disk.</span>
</div>

<div class="tool-row">
  <button class="btn btn--primary" id="sk-generate-btn">Generate key pair</button>
  <span id="sk-generating" style="display:none;font-size:0.875rem;color:var(--text-3,#888);align-self:center;">Generating…</span>
</div>

<div id="sk-error" style="display:none;" class="tool-error" role="alert" aria-live="polite"></div>

<div id="sk-results" style="display:none;">
  <div class="sk-fingerprint-wrap" id="sk-fingerprint-wrap">
    <span class="sk-fp-label">Fingerprint (SHA-256)</span>
    <code class="sk-fp-value" id="sk-fingerprint"></code>
  </div>

  <div class="sk-key-block">
    <div class="sk-key-header">
      <span class="sk-key-title">Public key</span>
      <div style="display:flex;gap:0.5rem;">
        <button class="btn btn--copy" id="sk-copy-pub">Copy</button>
        <button class="btn" id="sk-download-pub">Download</button>
      </div>
    </div>
    <pre id="sk-public-key" class="sk-key-pre"></pre>
  </div>

  <div class="sk-key-block sk-key-block--private">
    <div class="sk-key-header">
      <span class="sk-key-title">Private key</span>
      <div style="display:flex;gap:0.5rem;">
        <button class="btn btn--copy" id="sk-copy-priv">Copy</button>
        <button class="btn" id="sk-download-priv">Download</button>
      </div>
    </div>
    <pre id="sk-private-key" class="sk-key-pre"></pre>
    <p class="sk-priv-warn">Keep this key secret. Never share it or commit it to version control.</p>
  </div>
</div>

<style>
