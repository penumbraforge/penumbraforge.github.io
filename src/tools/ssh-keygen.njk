<script>
(function () {
  var keyTypeBtns  = Array.prototype.slice.call(document.querySelectorAll('[data-keytype]'));
  var ed25519Note  = document.getElementById('sk-ed25519-note');
  var commentEl    = document.getElementById('sk-comment');
  var passphraseEl = document.getElementById('sk-passphrase');
  var generateBtn  = document.getElementById('sk-generate-btn');
  var generatingEl = document.getElementById('sk-generating');
  var errorEl      = document.getElementById('sk-error');
  var resultsEl    = document.getElementById('sk-results');
  var fingerprintEl= document.getElementById('sk-fingerprint');
  var pubKeyEl     = document.getElementById('sk-public-key');
  var privKeyEl    = document.getElementById('sk-private-key');
  var copyPubBtn   = document.getElementById('sk-copy-pub');
  var copyPrivBtn  = document.getElementById('sk-copy-priv');
  var dlPubBtn     = document.getElementById('sk-download-pub');
  var dlPrivBtn    = document.getElementById('sk-download-priv');

  var currentKeyType = 'RSA-2048';

  keyTypeBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      keyTypeBtns.forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-pressed','false'); });
      btn.classList.add('active'); btn.setAttribute('aria-pressed','true');
      currentKeyType = btn.getAttribute('data-keytype');
      ed25519Note.style.display = currentKeyType === 'Ed25519' ? '' : 'none';
    });
  });

  function bufferToBase64(buf) {
    var bytes = new Uint8Array(buf);
    var binary = '';
    for (var i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
    return btoa(binary);
  }

  function base64ToUint8(b64) {
    var binary = atob(b64);
    var arr = new Uint8Array(binary.length);
    for (var i = 0; i < binary.length; i++) arr[i] = binary.charCodeAt(i);
    return arr;
  }

  function chunk(str, n) {
    var result = [];
    for (var i = 0; i < str.length; i += n) result.push(str.slice(i, i + n));
    return result.join('\n');
  }

  // Convert RSA public key to OpenSSH wire format
  function rsaPubKeyToOpenSSH(spkiBuffer, comment) {
    var spki = new Uint8Array(spkiBuffer);
    // Extract modulus and exponent from SPKI DER
    // SPKI structure: SEQUENCE { SEQUENCE { OID, NULL }, BIT STRING { SEQUENCE { INTEGER n, INTEGER e } } }
    // We parse the DER manually for the RSA key data
    var keyName = 'ssh-rsa';
    var keyNameBytes = new TextEncoder().encode(keyName);

    // Parse DER to extract n and e
    function readDER(buf, pos) {
      var tag = buf[pos++];
      var len = buf[pos++];
      if (len & 0x80) {
        var lenBytes = len & 0x7f;
        len = 0;
        for (var i = 0; i < lenBytes; i++) len = (len << 8) | buf[pos++];
      }
      return { tag: tag, length: len, start: pos, end: pos + len };
    }

    // Navigate SPKI to find the RSA BIT STRING
    var pos = 0;
    var outer = readDER(spki, pos); // SEQUENCE
    pos = outer.start;
    var algoSeq = readDER(spki, pos); // SEQUENCE (algorithm)
    pos = algoSeq.end;
    var bitString = readDER(spki, pos); // BIT STRING
    // Skip the initial 0x00 byte of the bit string
    var rsaPos = bitString.start + 1;
    var rsaOuter = readDER(spki, rsaPos); // SEQUENCE
    rsaPos = rsaOuter.start;
    var modInfo = readDER(spki, rsaPos); // INTEGER (n)
    var modulus = spki.slice(modInfo.start, modInfo.end);
    rsaPos = modInfo.end;
    var expInfo = readDER(spki, rsaPos); // INTEGER (e)
    var exponent = spki.slice(expInfo.start, expInfo.end);

    // Build wire format: uint32(len) + data for each field
    function sshBytes(data) {
      var len = data.length;
      var arr = new Uint8Array(4 + len);
      arr[0] = (len >>> 24) & 0xff;
      arr[1] = (len >>> 16) & 0xff;
      arr[2] = (len >>> 8)  & 0xff;
      arr[3] =  len         & 0xff;
      arr.set(data, 4);
      return arr;
    }

    var parts = [sshBytes(keyNameBytes), sshBytes(exponent), sshBytes(modulus)];
    var totalLen = parts.reduce(function (a, p) { return a + p.length; }, 0);
    var wire = new Uint8Array(totalLen);
    var offset = 0;
    parts.forEach(function (p) { wire.set(p, offset); offset += p.length; });

    var b64 = btoa(String.fromCharCode.apply(null, wire));
    var commentStr = comment ? ' ' + comment : '';
    return 'ssh-rsa ' + b64 + commentStr;
  }

  // Compute SHA-256 fingerprint of the public key wire format
  function computeFingerprint(pubKeyLine) {
    var parts = pubKeyLine.split(' ');
    if (parts.length < 2) return Promise.reject(new Error('invalid key'));
    var keyData = base64ToUint8(parts[1]);
    return crypto.subtle.digest('SHA-256', keyData).then(function (buf) {
      var b64 = bufferToBase64(buf);
      return 'SHA256:' + b64.replace(/=+$/, '');
    });
  }

  // Encode RSA private key as PKCS#8 PEM (standard for OpenSSH)
  function privKeyToPEM(pkcs8Buffer) {
    var b64 = chunk(bufferToBase64(pkcs8Buffer), 64);
    return '-----BEGIN PRIVATE KEY-----\n' + b64 + '\n-----END PRIVATE KEY-----';
  }

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.style.display = '';
    resultsEl.style.display = 'none';
  }

  function hideError() {
    errorEl.textContent = '';
    errorEl.style.display = 'none';
  }

  function setGenerating(on) {
    generateBtn.disabled = on;
    generatingEl.style.display = on ? '' : 'none';
  }

  generateBtn.addEventListener('click', function () {
    if (currentKeyType === 'Ed25519') {
      showError('Ed25519 is not supported via the Web Crypto API. Please use RSA-2048 or RSA-4096, or run "ssh-keygen -t ed25519" on the command line.');
      return;
    }

    hideError();
    resultsEl.style.display = 'none';
    setGenerating(true);

    var modulusLength = currentKeyType === 'RSA-4096' ? 4096 : 2048;
    var comment = commentEl.value.trim();

    crypto.subtle.generateKey(
      {
        name: 'RSASSA-PKCS1-v1_5',
        modulusLength: modulusLength,
        publicExponent: new Uint8Array([1, 0, 1]),
        hash: 'SHA-256'
      },
      true,
      ['sign', 'verify']
    ).then(function (keyPair) {
      return Promise.all([
        crypto.subtle.exportKey('spki', keyPair.publicKey),
        crypto.subtle.exportKey('pkcs8', keyPair.privateKey)
      ]);
    }).then(function (exported) {
      var spkiBuf  = exported[0];
      var pkcs8Buf = exported[1];

      var pubKeyLine = rsaPubKeyToOpenSSH(spkiBuf, comment);
      var privPEM    = privKeyToPEM(pkcs8Buf);

      return computeFingerprint(pubKeyLine).then(function (fp) {
        return { pubKeyLine: pubKeyLine, privPEM: privPEM, fingerprint: fp };
      });
    }).then(function (result) {
      setGenerating(false);
      hideError();
      resultsEl.style.display = '';

      pubKeyEl.textContent  = result.pubKeyLine;
      privKeyEl.textContent = result.privPEM;
      fingerprintEl.textContent = result.fingerprint;
    }).catch(function (e) {
      setGenerating(false);
      showError('Key generation failed: ' + e.message);
    });
  });

  function copyText(text, btn) {
    if (!text) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () {
        btn.textContent = 'Copied!';
        setTimeout(function () { btn.textContent = 'Copy'; }, 2000);
      }).catch(function () {
        btn.textContent = 'Failed';
        setTimeout(function () { btn.textContent = 'Copy'; }, 2000);
      });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.cssText = 'position:fixed;opacity:0;';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); btn.textContent = 'Copied!'; } catch(e) { btn.textContent = 'Failed'; }
      document.body.removeChild(ta);
      setTimeout(function () { btn.textContent = 'Copy'; }, 2000);
    }
  }

  function downloadText(text, filename) {
    var blob = new Blob([text], { type: 'text/plain' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  copyPubBtn.addEventListener('click', function () { copyText(pubKeyEl.textContent, copyPubBtn); });
  copyPrivBtn.addEventListener('click', function () { copyText(privKeyEl.textContent, copyPrivBtn); });
  dlPubBtn.addEventListener('click', function () { downloadText(pubKeyEl.textContent, 'id_rsa.pub'); });
  dlPrivBtn.addEventListener('click', function () { downloadText(privKeyEl.textContent, 'id_rsa'); });
})();
</script>
