---
toolSlug: secrets-scanner
permalink: /tools/secrets-scanner/
---

<div class="tool-group">
  <label for="ss-input">Paste code, config, or env file to scan</label>
  <textarea id="ss-input" rows="14" placeholder="Paste source code, .env files, config YAML, shell scripts..." spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
</div>

<div class="tool-row">
  <button class="btn btn--primary" id="ss-scan-btn">Scan for secrets</button>
  <button class="btn" id="ss-example-btn">Try example</button>
  <button class="btn" id="ss-clear-btn">Clear</button>
  <div id="ss-summary" style="margin-left:auto;font-size:0.875rem;color:var(--text-3,#888);align-self:center;"></div>
</div>

<div id="ss-results" style="display:none;">
  <div id="ss-findings"></div>
</div>

<div id="ss-clean" style="display:none;" class="ss-clean-msg">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
  No secrets detected. Always review manually — scanners are not exhaustive.
</div>

<div id="ss-empty" class="ss-empty-msg">Paste content above and click "Scan for secrets".</div>

<hr style="margin:2rem 0;border:none;border-top:1px solid var(--border,#2a2a3a);">

<div class="ss-gate-note">
  <strong>Scanning in CI/CD?</strong>
  <a href="/gate/" class="ss-gate-link">Penumbra Gate</a> runs these same patterns as a pre-commit hook and GitHub Actions step, blocking secrets from ever reaching your repository.
</div>

<style>
  .ss-finding {
    border: 1px solid var(--border,#2a2a3a);
    border-radius: 8px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }
  .ss-finding--high { border-left: 3px solid #ef4444; }
  .ss-finding--medium { border-left: 3px solid #f97316; }
  .ss-finding--low { border-left: 3px solid #eab308; }
  .ss-finding-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.875rem;
    background: var(--surface-1,#1a1a2e);
    flex-wrap: wrap;
  }
  .ss-finding-type { font-size: 0.875rem; font-weight: 700; color: var(--text-1,#e2e8f0); flex: 1; min-width: 0; }
  .ss-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }
  .ss-badge--high { background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.3); }
  .ss-badge--medium { background: rgba(249,115,22,0.12); color: #fb923c; border: 1px solid rgba(249,115,22,0.3); }
  .ss-badge--low { background: rgba(234,179,8,0.1); color: #fbbf24; border: 1px solid rgba(234,179,8,0.3); }
  .ss-line-num {
    font-size: 0.75rem;
    font-family: var(--font-mono,monospace);
    color: var(--text-3,#888);
    flex-shrink: 0;
  }
  .ss-finding-body { padding: 0.75rem 0.875rem; }
  .ss-match-pre {
    font-size: 0.8125rem;
    font-family: var(--font-mono,monospace);
    background: var(--surface-0,#0f0f1a);
    border-radius: 4px;
    padding: 0.5rem 0.75rem;
    margin: 0 0 0.6rem;
    white-space: pre-wrap;
    word-break: break-all;
    color: var(--text-1,#e2e8f0);
    border: 1px solid var(--border,#2a2a3a);
  }
  .ss-remediation {
    font-size: 0.8125rem;
    color: var(--text-2,#94a3b8);
    line-height: 1.5;
  }
  .ss-remediation strong { color: var(--text-1,#e2e8f0); }
  .ss-clean-msg {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    background: rgba(34,197,94,0.07);
    border: 1px solid rgba(34,197,94,0.2);
    border-radius: 8px;
    color: #4ade80;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .ss-empty-msg { text-align: center; padding: 2.5rem; color: var(--text-3,#888); font-size: 0.9rem; }
  .ss-gate-note {
    font-size: 0.875rem;
    color: var(--text-2,#94a3b8);
    line-height: 1.5;
    padding: 1rem 1.25rem;
    background: var(--surface-1,#1a1a2e);
    border: 1px solid var(--border,#2a2a3a);
    border-radius: 8px;
  }
  .ss-gate-note strong { color: var(--text-1,#e2e8f0); display: block; margin-bottom: 0.25rem; }
  .ss-gate-link { color: #818cf8; text-decoration: underline; }
</style>

<script>
(function () {
  var inputEl   = document.getElementById('ss-input');
  var scanBtn   = document.getElementById('ss-scan-btn');
  var exampleBtn= document.getElementById('ss-example-btn');
  var clearBtn  = document.getElementById('ss-clear-btn');
  var resultsEl = document.getElementById('ss-results');
  var findingsEl= document.getElementById('ss-findings');
  var cleanEl   = document.getElementById('ss-clean');
  var emptyEl   = document.getElementById('ss-empty');
  var summaryEl = document.getElementById('ss-summary');

  // Build example at runtime so GitHub push protection doesn't flag static strings
  function buildExample() {
    var pad = 'aBcDeFgHiJkLmNoPqRsT';
    var hex32 = 'abcdef1234567890abcdef1234567890';
    var lines = [
      '# Example config — test secrets for demo (not real credentials)',
      'AWS_ACCESS_' + 'KEY_ID=AKIA' + 'IOSFODNN7EXAMPLE',
      'aws_secret_access_key=' + 'wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY',
      'GITHUB_TOKEN=' + 'ghp_' + pad + pad.slice(0,16),
      'SLACK_BOT=' + 'xoxb-111111111111-222222222-' + pad,
      'GOOGLE_API_KEY=' + 'AIza' + 'SyD9tSrke72PqRsTuVwXyZaBcDeFgHiJk0',
      'STRIPE_KEY=' + 'sk_l' + 'ive_51HaBcDeFgHiJkLmNoPqRsTuVwXyZ1234',
      'SENDGRID_KEY=SG.' + pad + 'vW.' + pad + pad + 'aBcDeFgHiJkLmNoPqRsTuVw',
      'OPENAI_API_KEY=' + 'sk-pr' + 'oj-' + pad + pad + pad,
      'ANTHROPIC_KEY=' + 'sk-a' + 'nt-api03-' + pad + pad + pad,
      'TWILIO_SID=' + 'AC' + hex32,
      'MAILGUN=' + 'key-' + hex32,
      'NPM_TOKEN=' + 'npm_' + pad + pad.slice(0,16),
      'DO_TOKEN=' + 'dop_' + 'v1_' + hex32 + hex32,
      'DB_URL=postgres://admin:s3cr3t' + 'P@ss@db.example.com:5432/mydb',
      'api_secret="my-super-secret-api-key-value-here-1234"',
      'password="hunter2secret"',
      '-----BEGIN RSA PRIVATE' + ' KEY-----',
      'MIIEowIBAAKCAQEA0Z3VS5JJ' + 'cds3xHn/ygWep4example',
      '-----END RSA PRIVATE' + ' KEY-----'
    ];
    return lines.join('\n');
  }
  var EXAMPLE_TEXT = buildExample();

  var PATTERNS = [
    {
      id: 'aws-access-key',
      name: 'AWS Access Key ID',
      severity: 'high',
      pattern: /\bAKIA[0-9A-Z]{16}\b/g,
      remediation: 'Rotate this key immediately in the AWS IAM console. Use IAM roles or environment variables — never hardcode AWS keys in source code.'
    },
    {
      id: 'aws-secret-key',
      name: 'AWS Secret Access Key',
      severity: 'high',
      pattern: /(?:aws[_\-\s]?secret[_\-\s]?(?:access[_\-\s]?)?key|AWS_SECRET_ACCESS_KEY)\s*[=:]\s*["']?([A-Za-z0-9\/+=]{40})["']?/gi,
      remediation: 'Rotate this secret key immediately. Store AWS credentials in environment variables or AWS Secrets Manager.'
    },
    {
      id: 'github-token',
      name: 'GitHub Token',
      severity: 'high',
      pattern: /\b(ghp_[A-Za-z0-9]{36}|gho_[A-Za-z0-9]{36}|ghs_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{82})\b/g,
      remediation: 'Revoke this token immediately at github.com/settings/tokens. Use GitHub Actions secrets for CI/CD workflows.'
    },
    {
      id: 'slack-token',
      name: 'Slack Token',
      severity: 'high',
      pattern: /\b(xoxb-[0-9A-Za-z\-]+|xoxp-[0-9A-Za-z\-]+|xoxa-[0-9A-Za-z\-]+|xoxs-[0-9A-Za-z\-]+)\b/g,
      remediation: 'Revoke this token at api.slack.com/apps. Store Slack tokens in environment variables or a secrets manager.'
    },
    {
      id: 'google-api-key',
      name: 'Google API Key',
      severity: 'high',
      pattern: /\bAIza[0-9A-Za-z\-_]{35}\b/g,
      remediation: 'Regenerate the key in Google Cloud Console and restrict it by API, HTTP referrer, or IP address. Never embed in client-side code.'
    },
    {
      id: 'private-key',
      name: 'Private Key (PEM)',
      severity: 'high',
      pattern: /-----BEGIN\s+(RSA |EC |OPENSSH |DSA |ENCRYPTED )?PRIVATE KEY-----/g,
      remediation: 'Remove this key from source control immediately. Regenerate the key pair. Add *.pem, *.key, id_rsa to your .gitignore.'
    },
    {
      id: 'jwt-token',
      name: 'JWT / Bearer Token',
      severity: 'medium',
      pattern: /\beyJ[A-Za-z0-9\-_]+\.[A-Za-z0-9\-_]+\.[A-Za-z0-9\-_]+\b/g,
      remediation: 'JWTs may carry session data or auth grants. Ensure they are short-lived and invalidated server-side. Never store in localStorage or source code.'
    },
    {
      id: 'db-conn-string',
      name: 'Database Connection String',
      severity: 'high',
      pattern: /(?:postgres|postgresql|mysql|mongodb|mongodb\+srv|redis|amqp|amqps):\/\/[^:@\s"']+:[^@\s"']+@/gi,
      remediation: 'Rotate the database password immediately. Use environment variables (DATABASE_URL) and never commit connection strings to version control.'
    },
    {
      id: 'basic-auth',
      name: 'HTTP Basic Auth URL',
      severity: 'medium',
      pattern: /https?:\/\/[^:@\s"']{1,100}:[^@\s"']{1,100}@[a-zA-Z0-9\-\.]+/g,
      remediation: 'Remove credentials from URLs. Use Authorization headers with environment-injected secrets instead.'
    },
    {
      id: 'stripe-key',
      name: 'Stripe Key',
      severity: 'high',
      pattern: /\b(sk_live_[0-9A-Za-z]{24,}|pk_live_[0-9A-Za-z]{24,}|rk_live_[0-9A-Za-z]{24,})\b/g,
      remediation: 'Rotate this key in the Stripe dashboard immediately. Never commit live keys — use test keys in development and environment variables in production.'
    },
    {
      id: 'sendgrid-key',
      name: 'SendGrid API Key',
      severity: 'high',
      pattern: /\bSG\.[A-Za-z0-9\-_]{22,}\.[A-Za-z0-9\-_]{43,}\b/g,
      remediation: 'Revoke this key at app.sendgrid.com/settings/api_keys and create a new scoped key.'
    },
    {
      id: 'generic-api-key',
      name: 'Generic API Key / Secret',
      severity: 'medium',
      pattern: /(?:api[_\-]?key|api[_\-]?secret|app[_\-]?secret|client[_\-]?secret|auth[_\-]?token|access[_\-]?token|secret[_\-]?key)\s*[=:]\s*["']?([A-Za-z0-9\/+=_\-]{16,64})["']?/gi,
      remediation: 'Move this value to an environment variable or secrets manager. Do not commit credentials in configuration files.'
    },
    {
      id: 'password-in-code',
      name: 'Password Assignment',
      severity: 'low',
      pattern: /(?:password|passwd|pwd)\s*[=:]\s*["']([^"']{6,})["']/gi,
      remediation: 'Hardcoded passwords are a critical vulnerability. Use environment variables or a secrets vault. Check git history for exposure.'
    },
    {
      id: 'ssh-dss',
      name: 'SSH DSS / RSA Private Key (OpenSSH)',
      severity: 'high',
      pattern: /-----BEGIN OPENSSH PRIVATE KEY-----/g,
      remediation: 'Remove and regenerate this SSH key. Add private key files to .gitignore and consider using SSH agent forwarding.'
    },
    {
      id: 'openai-key',
      name: 'OpenAI API Key',
      severity: 'high',
      pattern: /\b(sk-proj-[A-Za-z0-9\-_]{40,}|sk-[A-Za-z0-9]{20,})\b/g,
      remediation: 'Revoke this key immediately at platform.openai.com/api-keys. Store OpenAI keys in environment variables and never commit them to source control.'
    },
    {
      id: 'anthropic-key',
      name: 'Anthropic API Key',
      severity: 'high',
      pattern: /\bsk-ant-[A-Za-z0-9\-_]{40,}\b/g,
      remediation: 'Revoke this key immediately at console.anthropic.com. Store Anthropic API keys in environment variables and never commit them to source control.'
    },
    {
      id: 'discord-token',
      name: 'Discord Bot Token',
      severity: 'high',
      pattern: /\b[MN][A-Za-z0-9]{23,}\.[A-Za-z0-9\-_]{6}\.[A-Za-z0-9\-_]{27,}\b/g,
      remediation: 'Regenerate the token immediately in the Discord Developer Portal. Store Discord tokens in environment variables.'
    },
    {
      id: 'discord-webhook',
      name: 'Discord Webhook URL',
      severity: 'medium',
      pattern: /https:\/\/discord(?:app)?\.com\/api\/webhooks\/[0-9]+\/[A-Za-z0-9\-_]+/g,
      remediation: 'Delete and regenerate this webhook in your Discord server settings. Webhook URLs grant anyone the ability to post messages to your channel.'
    },
    {
      id: 'twilio-sid',
      name: 'Twilio Account SID',
      severity: 'high',
      pattern: /\bAC[a-f0-9]{32}\b/g,
      remediation: 'Rotate your Twilio credentials at console.twilio.com. Never commit Twilio SIDs or auth tokens to source control.'
    },
    {
      id: 'twilio-auth-token',
      name: 'Twilio Auth Token',
      severity: 'high',
      pattern: /twilio.*[=:]\s*["']?[a-f0-9]{32}\b/gi,
      remediation: 'Rotate your Twilio auth token immediately at console.twilio.com. Store it in an environment variable.'
    },
    {
      id: 'azure-storage',
      name: 'Azure Storage / Connection String',
      severity: 'high',
      pattern: /DefaultEndpointsProtocol=https?;AccountName=[^;]+;AccountKey=[A-Za-z0-9+\/=]{60,}/g,
      remediation: 'Regenerate the storage account key in the Azure portal. Use managed identities or Azure Key Vault instead of embedding connection strings.'
    },
    {
      id: 'mailgun-key',
      name: 'Mailgun API Key',
      severity: 'high',
      pattern: /\bkey-[0-9a-z]{32}\b/g,
      remediation: 'Revoke this key in the Mailgun dashboard and generate a new one. Store API keys in environment variables.'
    },
    {
      id: 'npm-token',
      name: 'npm Access Token',
      severity: 'high',
      pattern: /\bnpm_[A-Za-z0-9]{36}\b/g,
      remediation: 'Revoke this token at npmjs.com/settings/tokens. Never commit npm tokens — use CI/CD secret stores for publishing.'
    },
    {
      id: 'pypi-token',
      name: 'PyPI API Token',
      severity: 'high',
      pattern: /\bpypi-[A-Za-z0-9\-_]{100,}\b/g,
      remediation: 'Revoke this token at pypi.org/manage/account/token. Use trusted publishing (OIDC) or environment secrets for CI/CD.'
    },
    {
      id: 'heroku-key',
      name: 'Heroku API Key',
      severity: 'high',
      pattern: /[hH]eroku.*[=:]\s*["']?[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b/g,
      remediation: 'Revoke this key in Heroku account settings. Use the Heroku CLI or pipeline environment variables for deployments.'
    },
    {
      id: 'datadog-key',
      name: 'Datadog API Key',
      severity: 'high',
      pattern: /dd(?:og)?[_\-]?api[_\-]?key.*[=:]\s*["']?[a-f0-9]{32,40}\b/gi,
      remediation: 'Revoke the key at app.datadoghq.com/organization-settings/api-keys. Rotate and store it in a secrets manager.'
    },
    {
      id: 'env-secret',
      name: 'Environment Variable Secret',
      severity: 'medium',
      pattern: /\b[A-Z_]*(SECRET|TOKEN|KEY|PASSWORD|PASS|PWD|AUTH|CREDENTIAL)[A-Z_]*\s*[=:]\s*["']?[^\s"']{8,}/g,
      remediation: 'Do not commit .env files containing real secrets. Use .env.example for templates and add .env to .gitignore.'
    },
    {
      id: 'supabase-key',
      name: 'Supabase Service Role Key',
      severity: 'high',
      pattern: /\beyJ[A-Za-z0-9\-_]{50,}\.[A-Za-z0-9\-_]{20,}\.[A-Za-z0-9\-_]{20,}\b/g,
      remediation: 'The service role key bypasses Row Level Security. Rotate it in the Supabase dashboard and never expose it in client-side code.'
    },
    {
      id: 'vercel-token',
      name: 'Vercel Token',
      severity: 'high',
      pattern: /\bvercel_[A-Za-z0-9]{24,}\b/gi,
      remediation: 'Revoke this token at vercel.com/account/tokens. Use Vercel project environment variables for secrets in deployments.'
    },
    {
      id: 'digitalocean-token',
      name: 'DigitalOcean Personal Access Token',
      severity: 'high',
      pattern: /\bdop_v1_[a-f0-9]{64}\b/g,
      remediation: 'Revoke this token at cloud.digitalocean.com/account/api/tokens. Use environment variables for all deployment tooling.'
    },
    {
      id: 'linear-key',
      name: 'Linear API Key',
      severity: 'high',
      pattern: /\blin_api_[A-Za-z0-9]{40,}\b/g,
      remediation: 'Revoke this key at linear.app/settings/api. Store Linear API keys in environment variables.'
    },
    {
      id: 'cloudflare-token',
      name: 'Cloudflare API Token',
      severity: 'high',
      pattern: /(?:cloudflare|cf)[_\-\s]?(?:api[_\-\s]?)?token.*[=:]\s*["']?[A-Za-z0-9_\-]{40}\b/gi,
      remediation: 'Revoke the token at dash.cloudflare.com/profile/api-tokens. Use scoped tokens with minimal permissions.'
    },
    {
      id: 'grafana-key',
      name: 'Grafana API Key',
      severity: 'high',
      pattern: /(?:grafana).*[=:]\s*["']?(eyJr[A-Za-z0-9\-_]+\.[A-Za-z0-9\-_]+\.[A-Za-z0-9\-_]+)/gi,
      remediation: 'Revoke the API key in Grafana under Configuration > API Keys. Use service accounts with minimal permissions instead.'
    }
  ];

  function redact(match) {
    // Show first 6 and last 4 chars of sensitive values, redact the middle
    if (match.length <= 12) return match.substring(0, 3) + '***';
    return match.substring(0, 6) + '***' + match.slice(-4);
  }

  function scan() {
    var text = inputEl.value;
    if (!text.trim()) {
      resultsEl.style.display = 'none';
      cleanEl.style.display = 'none';
      emptyEl.style.display = '';
      summaryEl.textContent = '';
      return;
    }

    var lines = text.split('\n');
    var findings = [];

    PATTERNS.forEach(function (p) {
      var re = new RegExp(p.pattern.source, p.pattern.flags);
      var match;
      while ((match = re.exec(text)) !== null) {
        // Find line number
        var beforeMatch = text.substring(0, match.index);
        var lineNum = beforeMatch.split('\n').length;
        // Get line content (for context)
        var lineContent = lines[lineNum - 1] || '';
        findings.push({
          type: p.name,
          severity: p.severity,
          lineNum: lineNum,
          matchText: redact(match[0]),
          lineContent: lineContent.length > 120 ? lineContent.substring(0, 120) + '\u2026' : lineContent,
          remediation: p.remediation
        });
        // Prevent infinite loop on zero-length match
        if (match.index === re.lastIndex) re.lastIndex++;
      }
    });

    emptyEl.style.display = 'none';

    if (findings.length === 0) {
      resultsEl.style.display = 'none';
      cleanEl.style.display = '';
      summaryEl.textContent = PATTERNS.length + ' patterns checked';
      return;
    }

    cleanEl.style.display = 'none';
    resultsEl.style.display = '';

    var high = findings.filter(function (f) { return f.severity === 'high'; }).length;
    var med  = findings.filter(function (f) { return f.severity === 'medium'; }).length;
    var low  = findings.filter(function (f) { return f.severity === 'low'; }).length;
    var parts = [];
    if (high) parts.push(high + ' high');
    if (med)  parts.push(med  + ' medium');
    if (low)  parts.push(low  + ' low');
    summaryEl.textContent = findings.length + ' finding' + (findings.length !== 1 ? 's' : '') + ' \u2014 ' + parts.join(', ') + ' (' + PATTERNS.length + ' patterns checked)';

    // Clear and rebuild
    while (findingsEl.firstChild) findingsEl.removeChild(findingsEl.firstChild);

    findings.forEach(function (f) {
      var card = document.createElement('div');
      card.className = 'ss-finding ss-finding--' + f.severity;

      var header = document.createElement('div');
      header.className = 'ss-finding-header';

      var typeSpan = document.createElement('span');
      typeSpan.className = 'ss-finding-type';
      typeSpan.textContent = f.type;

      var lineSpan = document.createElement('span');
      lineSpan.className = 'ss-line-num';
      lineSpan.textContent = 'Line ' + f.lineNum;

      var badge = document.createElement('span');
      badge.className = 'ss-badge ss-badge--' + f.severity;
      badge.textContent = f.severity;

      header.appendChild(typeSpan);
      header.appendChild(lineSpan);
      header.appendChild(badge);

      var body = document.createElement('div');
      body.className = 'ss-finding-body';

      var pre = document.createElement('pre');
      pre.className = 'ss-match-pre';
      pre.textContent = f.lineContent;

      var rem = document.createElement('div');
      rem.className = 'ss-remediation';
      var remStrong = document.createElement('strong');
      remStrong.textContent = 'Remediation: ';
      rem.appendChild(remStrong);
      rem.appendChild(document.createTextNode(f.remediation));

      body.appendChild(pre);
      body.appendChild(rem);

      card.appendChild(header);
      card.appendChild(body);
      findingsEl.appendChild(card);
    });
  }

  // Live scanning with 500ms debounce
  var debounceTimer = null;
  inputEl.addEventListener('input', function () {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(scan, 500);
  });

  scanBtn.addEventListener('click', scan);

  exampleBtn.addEventListener('click', function () {
    inputEl.value = EXAMPLE_TEXT;
    scan();
  });

  clearBtn.addEventListener('click', function () {
    inputEl.value = '';
    resultsEl.style.display = 'none';
    cleanEl.style.display = 'none';
    emptyEl.style.display = '';
    summaryEl.textContent = '';
    while (findingsEl.firstChild) findingsEl.removeChild(findingsEl.firstChild);
  });
})();
</script>
