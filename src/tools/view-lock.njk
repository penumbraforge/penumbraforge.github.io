---
toolSlug: view-lock
permalink: /tools/view-lock/
---

<p style="margin:0 0 1.5rem; font-size:0.9375rem; line-height:1.65; color:var(--text-2);">
  Decrypt ciphertext produced by <a href="/tools/secret-lock/" style="color:var(--accent);">Secret Lock</a> using your passphrase. All decryption runs entirely in your browser via the Web Crypto API — the plaintext is never transmitted to any server.
</p>

<div class="tool-group">
  <label for="vl-ciphertext">Encrypted ciphertext</label>
  <textarea id="vl-ciphertext" rows="5" placeholder="Paste the base64 ciphertext from Secret Lock..." spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
</div>

<div class="tool-group">
  <label for="vl-passphrase">Passphrase</label>
  <input type="password" id="vl-passphrase" placeholder="Enter the passphrase used to encrypt this secret" autocomplete="off">
</div>

<div class="tool-row">
  <button class="btn btn--primary" id="vl-decrypt-btn">Decrypt</button>
</div>

<div id="vl-error" style="display:none;" role="alert" aria-live="polite" class="tool-error"></div>

<div class="output-area" id="vl-output-area" style="display:none;">
  <button class="btn btn--copy" id="vl-copy-btn" aria-label="Copy plaintext">Copy</button>
  <pre id="vl-output" aria-label="Decrypted plaintext"></pre>
</div>

<p style="margin:1.25rem 0 0; font-size:0.8125rem; color:var(--text-3);">
  Need to encrypt a secret first? Use <a href="/tools/secret-lock/" style="color:var(--accent);">Secret Lock</a>.
</p>

<hr>

<style>
.vl-security-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 0.6rem;
}
.vl-security-item {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  padding: 0.875rem 1rem;
  background: var(--surface-1);
  border: 1px solid var(--border);
  border-radius: 8px;
}
.vl-security-item .label {
  font-size: 0.75rem;
  color: var(--text-3);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.vl-security-item .value {
  font-size: 0.875rem;
  font-family: var(--font-mono);
  color: #4ade80;
}
</style>

<div>
  <h2 style="font-size:1.1rem; font-weight:700; margin:0 0 1.25rem;">Security properties</h2>
  <div class="vl-security-grid">
    <div class="vl-security-item">
      <span class="label">Encryption algorithm</span>
      <span class="value">AES-GCM 256-bit</span>
    </div>
    <div class="vl-security-item">
      <span class="label">Key derivation</span>
      <span class="value">PBKDF2 / SHA-256 / 100k rounds</span>
    </div>
    <div class="vl-security-item">
      <span class="label">Authentication</span>
      <span class="value">GCM tag (tamper-evident)</span>
    </div>
    <div class="vl-security-item">
      <span class="label">IV</span>
      <span class="value">Random 96-bit, prepended to ciphertext</span>
    </div>
    <div class="vl-security-item">
      <span class="label">Data transmission</span>
      <span class="value">None — local Web Crypto API only</span>
    </div>
    <div class="vl-security-item">
      <span class="label">Implementation</span>
      <span class="value">Web Crypto API (browser native)</span>
    </div>
  </div>
</div>

<hr>

<div>
  <h2 style="font-size:1.1rem; font-weight:700; margin:0 0 1.25rem;">Related tools</h2>
  <div class="tool-related-grid">
    <a href="/tools/secret-lock/" class="tool-related-card">
      <h4>Secret Lock</h4>
      <p>Create encrypted secrets to share</p>
    </a>
    <a href="/tools/one-time-secret/" class="tool-related-card">
      <h4>One-Time Secret</h4>
      <p>Burn-after-reading secret links</p>
    </a>
    <a href="/tools/hash-generator/" class="tool-related-card">
      <h4>Hash Generator</h4>
      <p>Verify file integrity with SHA-256</p>
    </a>
  </div>
</div>

<script>
(function () {
  var ciphertextEl = document.getElementById('vl-ciphertext');
  var passphraseEl = document.getElementById('vl-passphrase');
  var decryptBtn   = document.getElementById('vl-decrypt-btn');
  var errorEl      = document.getElementById('vl-error');
  var outputArea   = document.getElementById('vl-output-area');
  var outputEl     = document.getElementById('vl-output');
  var copyBtn      = document.getElementById('vl-copy-btn');

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.style.display = '';
    outputArea.style.display = 'none';
    outputEl.textContent = '';
  }

  function hideError() {
    errorEl.textContent = '';
    errorEl.style.display = 'none';
  }

  function showOutput(text) {
    hideError();
    outputEl.textContent = text;
    outputArea.style.display = '';
  }

  function base64ToBytes(b64) {
    try {
      var binary = atob(b64.trim());
      var bytes = new Uint8Array(binary.length);
      for (var i = 0; i < binary.length; i++) {
        bytes[i] = binary.charCodeAt(i);
      }
      return bytes;
    } catch (e) {
      return null;
    }
  }

  function decrypt() {
    var rawInput  = ciphertextEl.value.trim();
    var passphrase = passphraseEl.value;

    if (!rawInput) {
      showError('Please paste a ciphertext to decrypt.');
      return;
    }
    if (!passphrase) {
      showError('Please enter the passphrase.');
      return;
    }

    var combined = base64ToBytes(rawInput);
    if (!combined) {
      showError('Invalid base64 — make sure you pasted the full ciphertext without modifications.');
      return;
    }

    // Layout: [16 bytes salt][12 bytes IV][remaining: ciphertext + GCM tag]
    if (combined.length < 29) {
      showError('Corrupted data — ciphertext is too short to be a valid Secret Lock payload.');
      return;
    }

    var salt       = combined.slice(0, 16);
    var iv         = combined.slice(16, 28);
    var ciphertext = combined.slice(28);

    var enc = new TextEncoder();
    var keyMaterial;

    window.crypto.subtle.importKey(
      'raw',
      enc.encode(passphrase),
      { name: 'PBKDF2' },
      false,
      ['deriveKey']
    ).then(function (km) {
      keyMaterial = km;
      return window.crypto.subtle.deriveKey(
        {
          name: 'PBKDF2',
          salt: salt,
          iterations: 100000,
          hash: 'SHA-256'
        },
        keyMaterial,
        { name: 'AES-GCM', length: 256 },
        false,
        ['decrypt']
      );
    }).then(function (key) {
      return window.crypto.subtle.decrypt(
        { name: 'AES-GCM', iv: iv },
        key,
        ciphertext
      );
    }).then(function (plainBuffer) {
      var plaintext = new TextDecoder().decode(plainBuffer);
      showOutput(plaintext);
      decryptBtn.textContent = 'Decrypt';
      decryptBtn.disabled = false;
    }).catch(function (err) {
      decryptBtn.textContent = 'Decrypt';
      decryptBtn.disabled = false;
      if (err instanceof DOMException) {
        showError('Wrong passphrase or corrupted data.');
      } else {
        showError('Decryption failed: ' + err.message);
      }
    });

    decryptBtn.textContent = 'Decrypting\u2026';
    decryptBtn.disabled = true;
  }

  decryptBtn.addEventListener('click', decrypt);

  passphraseEl.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); decrypt(); }
  });

  copyBtn.addEventListener('click', function () {
    var text = outputEl.textContent;
    if (!text) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () {
        copyBtn.textContent = 'Copied!';
        setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
      }).catch(function () {
        copyBtn.textContent = 'Failed';
        setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
      });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try {
        document.execCommand('copy');
        copyBtn.textContent = 'Copied!';
      } catch (e) {
        copyBtn.textContent = 'Failed';
      }
      document.body.removeChild(ta);
      setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
    }
  });
})();
</script>
