---
toolSlug: passkey-inspector
permalink: /tools/passkey-inspector/
---

<div class="tool-options" role="group" aria-label="Inspector mode">
  <button class="tool-option active" id="pk-mode-decode" data-mode="decode" aria-pressed="true">Decode existing</button>
  <button class="tool-option" id="pk-mode-create" data-mode="create" aria-pressed="false">Create a passkey (live)</button>
</div>

<p class="pk-note">Everything runs locally in your browser — nothing is uploaded. Decode a WebAuthn / FIDO2 <span class="pk-code">attestationObject</span>, <span class="pk-code">authenticatorData</span>, or <span class="pk-code">clientDataJSON</span>, or mint a real passkey and inspect exactly what your authenticator returns.</p>

<!-- ============ DECODE MODE ============ -->
<div id="pk-panel-decode">
  <div class="tool-group">
    <label for="pk-att">attestationObject &mdash; base64 or base64url</label>
    <textarea id="pk-att" rows="4" placeholder="o2NmbXRkbm9uZWdhdHRTdG10oGhhdXRoRGF0YVik..." spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
  </div>

  <div class="tool-group">
    <label for="pk-ad">authenticatorData &mdash; base64 / base64url (optional)</label>
    <textarea id="pk-ad" rows="3" placeholder="Paste a raw authenticatorData blob (e.g. from an assertion) to parse it standalone..." spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
  </div>

  <div class="tool-group">
    <label for="pk-cd">clientDataJSON &mdash; base64url or raw JSON (optional)</label>
    <textarea id="pk-cd" rows="3" placeholder="eyJ0eXBlIjoid2ViYXV0aG4uY3JlYXRlIiwi...  — or paste the raw { ... } JSON" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
  </div>

  <div class="tool-row">
    <button class="btn btn--primary" id="pk-decode-btn">Decode</button>
    <button class="btn" id="pk-sample-btn">Load sample</button>
    <button class="btn" id="pk-clear-btn">Clear</button>
  </div>
</div>

<!-- ============ CREATE MODE ============ -->
<div id="pk-panel-create" style="display:none;">
  <p class="pk-note" id="pk-support-note">Checking WebAuthn support&hellip;</p>
  <div class="tool-row">
    <button class="btn btn--primary" id="pk-create-btn">Create passkey and inspect</button>
  </div>
  <p class="pk-note pk-note--dim">This calls <span class="pk-code">navigator.credentials.create()</span> with a random 32-byte challenge, ES256 + RS256 params, resident-key preferred, and <span class="pk-code">attestation: "direct"</span>. Your authenticator (Touch ID, Windows Hello, a security key, or your phone) will prompt you. The credential is decoded and discarded &mdash; it is never sent anywhere.</p>
</div>

<div id="pk-error" class="tool-error" role="alert" aria-live="assertive" style="display:none;"></div>

<div id="pk-results-toolbar" class="tool-row" style="display:none; justify-content:flex-end; margin-top:4px;">
  <button class="btn" id="pk-copy-btn">Copy JSON summary</button>
</div>

<div id="pk-results" aria-live="polite"></div>

