---
toolSlug: shell-explainer
permalink: /tools/shell-explainer/
---

<div class="tool-group">
  <label for="shell-input">Paste a shell command</label>
  <textarea id="shell-input" rows="5" placeholder="grep -rn 'TODO' ./src --include='*.js' | sort | head -20" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
</div>

<div class="tool-row">
  <div class="tool-options" role="group" aria-label="Example commands">
    <button class="tool-option" id="ex-find">find</button>
    <button class="tool-option" id="ex-grep">grep</button>
    <button class="tool-option" id="ex-tar">tar</button>
    <button class="tool-option" id="ex-curl">curl</button>
    <button class="tool-option" id="ex-docker">docker</button>
    <button class="tool-option" id="ex-git">git</button>
  </div>
</div>

<div id="shell-error" style="display:none;" role="alert" aria-live="polite" class="tool-error"></div>
<div id="shell-results" style="display:none;"></div>

<style>
  .shell-segment {
    margin-bottom: 20px;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }

  .shell-segment-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--surface-0);
    border-bottom: 1px solid var(--border);
  }

  .shell-pipe-label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
