  .shell-token--flag  { background: rgba(100,180,130,0.15); color: #64b482; }
  .shell-token--arg   { background: var(--surface-0); color: var(--text-1); border: 1px solid var(--border); }
  .shell-token--redir { background: rgba(200,140,80,0.15); color: #c8a050; font-weight: 600; }
  .shell-token--env   { background: rgba(160,100,200,0.15); color: #a070c8; }

  .shell-parts {
    padding: 10px 14px;
  }

  .shell-part {
    display: flex;
    gap: 10px;
    padding: 7px 0;
    border-bottom: 1px solid var(--border);
    align-items: flex-start;
    font-family: var(--font-sans);
    font-size: 13px;
  }

  .shell-part:last-child { border-bottom: none; }

  .shell-part-token {
    font-family: var(--font-mono);
    font-size: 12px;
    flex-shrink: 0;
    min-width: 120px;
    padding: 2px 6px;
    border-radius: 3px;
    background: var(--surface-0);
    border: 1px solid var(--border);
    color: var(--text-1);
    word-break: break-all;
  }

  .shell-part-kind {
    flex-shrink: 0;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: 3px;
    margin-top: 2px;
  }

  .shell-part-kind--flag  { background: rgba(100,180,130,0.15); color: #64b482; }
  .shell-part-kind--arg   { background: var(--surface-1); color: var(--text-3); }
  .shell-part-kind--redir { background: rgba(200,140,80,0.15); color: #c8a050; }
  .shell-part-kind--env   { background: rgba(160,100,200,0.15); color: #a070c8; }

  .shell-part-desc {
    color: var(--text-2);
    flex: 1;
    line-height: 1.5;
  }

  .shell-redirect-block {
    margin-top: 12px;
    padding: 10px 14px;
    background: rgba(200,140,80,0.06);
    border-top: 1px solid var(--border);
    font-family: var(--font-sans);
    font-size: 13px;
  }

  .shell-redirect-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-3);
    margin-bottom: 6px;
  }

  .shell-pipe-connector {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--text-3);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 4px;
    margin-bottom: 8px;
    margin-top: -12px;
  }

  .shell-pipe-arrow {
    font-size: 18px;
    color: var(--text-3);
    flex-shrink: 0;
  }
</style>

