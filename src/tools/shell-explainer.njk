    font-size: 13px;
    color: var(--text-2);
    flex: 1;
  }

  .shell-tokens {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 10px 14px;
    background: var(--surface-1);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 13px;
  }

