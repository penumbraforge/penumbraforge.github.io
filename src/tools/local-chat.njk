<div id="chatMount"></div>

<script>
(function () {
  if (!window.PenumbraAIUI) return;
  PenumbraAIUI.chat(document.getElementById('chatMount'), {
    system: "You are a concise, helpful assistant. Be direct and practical.",
    placeholder: "Ask anything…",
    starter: "Pick an engine with “Engine ▾” above before chatting. WebGPU keeps prompts in this page; configured-endpoint and API-key modes send them to the URL you choose."
  });
})();
</script>
