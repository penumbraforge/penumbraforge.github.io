---
toolSlug: totp-generator
permalink: /tools/totp-generator/
---

<div class="tool-group">
  <label for="totp-secret">Secret key</label>
  <input type="text" id="totp-secret" placeholder="JBSWY3DPEHPK3PXP" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off">
  <p class="totp-help">Base32, exactly as shown in your authenticator's setup QR code &mdash; e.g. <span class="totp-mono">JBSWY3DPEHPK3PXP</span>.</p>
</div>

<div class="totp-controls">
  <div class="totp-ctl">
    <span class="totp-ctl-label">Digits</span>
    <div class="tool-options" role="group" aria-label="Digits">
      <button class="tool-option active" data-digits="6" aria-pressed="true">6</button>
      <button class="tool-option" data-digits="8" aria-pressed="false">8</button>
    </div>
  </div>
  <div class="totp-ctl">
    <span class="totp-ctl-label">Period</span>
    <div class="tool-options" role="group" aria-label="Period">
      <button class="tool-option active" data-period="30" aria-pressed="true">30s</button>
      <button class="tool-option" data-period="60" aria-pressed="false">60s</button>
    </div>
  </div>
</div>

<div id="totp-error" style="display:none;" class="tool-error" role="alert" aria-live="polite"></div>

<div id="totp-display" style="display:none;">
  <div class="wb-panel totp-main">
    <div class="wb-panel-bar">
      <span>Current code</span>
      <button class="btn btn--copy" id="totp-copy-btn">Copy</button>
    </div>
    <div class="totp-main-body">
      <span class="totp-code" id="totp-current"></span>
      <div class="totp-timer-wrap" title="Seconds until this code rotates">
        <svg class="totp-ring" viewBox="0 0 44 44" aria-hidden="true">
          <circle class="totp-ring-bg" cx="22" cy="22" r="18"/>
          <circle class="totp-ring-fill" id="totp-ring-fill" cx="22" cy="22" r="18"/>
        </svg>
        <span class="totp-timer-num" id="totp-timer">&mdash;</span>
      </div>
    </div>
    <div class="totp-progress-bar-wrap" aria-hidden="true">
      <div class="totp-progress-bar" id="totp-progress-bar"></div>
    </div>
  </div>

  <div class="totp-adjacent">
    <div class="totp-adj">
      <span class="totp-adj-label">Previous</span>
      <span class="totp-adj-code" id="totp-prev"></span>
    </div>
    <div class="totp-adj">
      <span class="totp-adj-label">Next</span>
      <span class="totp-adj-code" id="totp-next"></span>
    </div>
  </div>
</div>

<div id="totp-empty" class="totp-empty">
  <span class="totp-empty-dot" aria-hidden="true"></span>
  <span>Enter a Base32 secret above to generate live TOTP codes.</span>
</div>

<div class="wb-note">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 2l7 4v5c0 4.5-3 8.5-7 9.5C8 19.5 5 15.5 5 11V6l7-4z"/>
    <path d="M9.4 11.8l1.9 1.9 3.3-3.6"/>
  </svg>
  <p><strong>Computed locally.</strong> Your secret is decoded and each code is generated with the browser's Web Crypto API. The key never leaves this page &mdash; nothing is uploaded.</p>
</div>

<style>
  /* ---------- Secret input ---------- */
  #totp-secret { letter-spacing: 0.08em; }
  .totp-help {
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-3);
    margin: 9px 0 0;
  }
  .totp-mono {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 10%, transparent);
    border-radius: 3px;
    padding: 1px 5px;
  }

  /* ---------- Configuration controls ---------- */
  .totp-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    align-items: flex-end;
    margin-bottom: 26px;
  }
  .totp-ctl { display: flex; flex-direction: column; gap: 10px; }
  .totp-ctl-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--slate);
  }
  .totp-ctl .tool-options { margin-bottom: 0; }

  /* ---------- Current code (hero) ---------- */
  .totp-main { margin-bottom: 14px; }
  .totp-main .wb-panel-bar .btn--copy {
    position: static; top: auto; right: auto;
    padding: 5px 13px; font-size: 10.5px;
  }
  .totp-main-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 26px 26px 24px;
  }
  .totp-code {
    font-family: var(--font-mono);
    font-size: clamp(2.3rem, 7vw, 3rem);
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1;
    color: var(--wb-ink, var(--text-1));
    font-variant-numeric: tabular-nums;
  }
  .totp-timer-wrap {
    position: relative;
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .totp-ring { position: absolute; inset: 0; width: 46px; height: 46px; transform: rotate(-90deg); }
  .totp-ring-bg { fill: none; stroke: rgba(255,255,255,0.07); stroke-width: 3.5; }
  .totp-ring-fill {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-dasharray: 113.1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.9s linear, stroke 0.3s;
  }
  .totp-timer-num {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }
  .totp-progress-bar-wrap {
    height: 3px;
    background: rgba(255,255,255,0.06);
    overflow: hidden;
  }
  .totp-progress-bar {
    height: 100%;
    width: 100%;
    background: var(--accent);
    transition: width 0.9s linear, background 0.3s;
  }

  /* ---------- Adjacent codes (context) ---------- */
  .totp-adjacent {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .totp-adj {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 16px;
    border: 1px solid var(--wb-line, var(--border));
    border-radius: 4px;
    background: var(--wb-panel, var(--surface-1));
  }
  .totp-adj-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--slate);
  }
  .totp-adj-code {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    letter-spacing: 0.1em;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Empty / waiting state ---------- */
  .totp-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 46px 24px;
    border: 1px solid var(--wb-line, var(--border));
    border-radius: 4px;
    background: var(--wb-panel, var(--surface-1));
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.4px;
  }
  .totp-empty-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--accent) 55%, transparent);
    box-shadow: 0 0 10px color-mix(in oklab, var(--accent) 45%, transparent);
    animation: totp-pulse 2.4s ease-in-out infinite;
  }
  @keyframes totp-pulse {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .totp-empty-dot { animation: none; }
    .totp-ring-fill, .totp-progress-bar { transition: none; }
  }
  @media (max-width: 460px) {
    .totp-adjacent { grid-template-columns: 1fr; }
    .totp-main-body { padding: 22px 20px; }
    .totp-code { font-size: clamp(2rem, 11vw, 2.6rem); }
  }
</style>

<script>
(function () {
  var secretEl  = document.getElementById('totp-secret');
  var errorEl   = document.getElementById('totp-error');
  var displayEl = document.getElementById('totp-display');
  var emptyEl   = document.getElementById('totp-empty');
  var prevEl    = document.getElementById('totp-prev');
  var currEl    = document.getElementById('totp-current');
  var nextEl    = document.getElementById('totp-next');
  var timerEl   = document.getElementById('totp-timer');
  var ringFill  = document.getElementById('totp-ring-fill');
  var progressBar= document.getElementById('totp-progress-bar');
  var copyBtn   = document.getElementById('totp-copy-btn');
  var digitBtns = Array.prototype.slice.call(document.querySelectorAll('[data-digits]'));
  var periodBtns= Array.prototype.slice.call(document.querySelectorAll('[data-period]'));

  var digits = 6;
  var period = 30;
  var tickInterval = null;
  var CIRCUMFERENCE = 2 * Math.PI * 18; // r=18

  digitBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      digitBtns.forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-pressed','false'); });
      btn.classList.add('active'); btn.setAttribute('aria-pressed','true');
      digits = parseInt(btn.getAttribute('data-digits'), 10);
      tryGenerate();
    });
  });
  periodBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      periodBtns.forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-pressed','false'); });
      btn.classList.add('active'); btn.setAttribute('aria-pressed','true');
      period = parseInt(btn.getAttribute('data-period'), 10);
      tryGenerate();
    });
  });

  // Base32 decode
  function base32decode(input) {
    var alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
    var clean = input.toUpperCase().replace(/=+$/, '').replace(/\s/g, '');
    var bits = 0, value = 0, index = 0;
    var output = new Uint8Array(Math.floor(clean.length * 5 / 8));
    for (var i = 0; i < clean.length; i++) {
      var idx = alphabet.indexOf(clean[i]);
      if (idx < 0) throw new Error('Invalid Base32 character: ' + clean[i]);
      value = (value << 5) | idx;
      bits += 5;
      if (bits >= 8) {
        output[index++] = (value >>> (bits - 8)) & 0xff;
        bits -= 8;
      }
    }
    return output.slice(0, index);
  }

  function numToBytes(num) {
    var arr = new Uint8Array(8);
    for (var i = 7; i >= 0; i--) {
      arr[i] = num & 0xff;
      num = Math.floor(num / 256);
    }
    return arr;
  }

  function generateTOTP(keyBytes, counter, digitCount) {
    var counterBytes = numToBytes(counter);
    return crypto.subtle.importKey(
      'raw', keyBytes, { name: 'HMAC', hash: 'SHA-1' }, false, ['sign']
    ).then(function (key) {
      return crypto.subtle.sign('HMAC', key, counterBytes);
    }).then(function (sig) {
      var hash = new Uint8Array(sig);
      var offset = hash[hash.length - 1] & 0x0f;
      var code = ((hash[offset] & 0x7f) << 24) |
                 ((hash[offset + 1] & 0xff) << 16) |
                 ((hash[offset + 2] & 0xff) << 8)  |
                 (hash[offset + 3] & 0xff);
      var mod = Math.pow(10, digitCount);
      return String(code % mod).padStart(digitCount, '0');
    });
  }

  function formatCode(code, digitCount) {
    // Add space in middle for readability (6 -> 3+3, 8 -> 4+4)
    var half = Math.floor(digitCount / 2);
    return code.substring(0, half) + ' ' + code.substring(half);
  }

  var lastCounter = -1;

  function tick() {
    var secret = secretEl.value.trim();
    if (!secret) return;

    var now = Math.floor(Date.now() / 1000);
    var timeLeft = period - (now % period);
    var counter = Math.floor(now / period);

    // Update timer display
    timerEl.textContent = timeLeft;

    // Progress ring (full = just refreshed, empty = about to refresh)
    var pct = timeLeft / period;
    var dashOffset = CIRCUMFERENCE * (1 - pct);
    ringFill.style.strokeDashoffset = dashOffset;
    ringFill.style.strokeDasharray = CIRCUMFERENCE;

    // Color warning when <7 seconds left
    var color = timeLeft <= 7 ? '#f87171' : '#818cf8';
    ringFill.style.stroke = color;
    progressBar.style.background = color;
    progressBar.style.width = (pct * 100).toFixed(1) + '%';

    // Only regenerate when counter changes
    if (counter === lastCounter) return;
    lastCounter = counter;

    var keyBytes;
    try {
      keyBytes = base32decode(secret);
    } catch (e) {
      showError(e.message);
      return;
    }

    var prevCounter = counter - 1;
    var nextCounter = counter + 1;

    Promise.all([
      generateTOTP(keyBytes, prevCounter, digits),
      generateTOTP(keyBytes, counter, digits),
      generateTOTP(keyBytes, nextCounter, digits)
    ]).then(function (codes) {
      hideError();
      displayEl.style.display = '';
      emptyEl.style.display = 'none';
      prevEl.textContent = formatCode(codes[0], digits);
      currEl.textContent = formatCode(codes[1], digits);
      nextEl.textContent = formatCode(codes[2], digits);
    }).catch(function (e) {
      showError('Failed to generate TOTP: ' + e.message);
    });
  }

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.style.display = '';
    displayEl.style.display = 'none';
  }

  function hideError() {
    errorEl.textContent = '';
    errorEl.style.display = 'none';
  }

  function tryGenerate() {
    var secret = secretEl.value.trim();
    if (!secret) {
      displayEl.style.display = 'none';
      emptyEl.style.display = '';
      hideError();
      lastCounter = -1;
      if (tickInterval) { clearInterval(tickInterval); tickInterval = null; }
      return;
    }
    // Validate base32
    try { base32decode(secret); } catch (e) { showError(e.message); return; }
    hideError();

    if (tickInterval) clearInterval(tickInterval);
    lastCounter = -1;
    tick();
    tickInterval = setInterval(tick, 500);
  }

  secretEl.addEventListener('input', tryGenerate);

  copyBtn.addEventListener('click', function () {
    var code = currEl.textContent.replace(/\s/g, '');
    if (!code) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(code).then(function () {
        copyBtn.textContent = 'Copied!';
        setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
      });
    } else {
      var ta = document.createElement('textarea');
      ta.value = code;
      ta.style.cssText = 'position:fixed;opacity:0;';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); copyBtn.textContent = 'Copied!'; } catch(e) {}
      document.body.removeChild(ta);
      setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
    }
  });
})();
</script>
