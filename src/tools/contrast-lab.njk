  .cl-swap {
    align-self: end; margin-bottom: 1px; width: 42px; height: 42px;
  }
  @media (max-width: 620px) { .cl-swap { width: auto; margin: 2px 0; } }

  .cl-preview { margin-top: 20px; border: 1px solid var(--wb-line); border-radius: 6px; overflow: hidden; }
  .cl-preview-stage { padding: 30px 26px; transition: background 140ms ease; }
  .cl-preview-stage .cl-lg { font-size: 27px; font-weight: 700; line-height: 1.25; margin: 0 0 12px; letter-spacing: -0.01em; transition: color 140ms; }
