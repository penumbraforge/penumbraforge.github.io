---
toolSlug: entropy-calculator
permalink: /tools/entropy-calculator/
---

<div class="tool-row" style="margin-bottom:0.5rem;">
  <div class="tool-options" role="group" aria-label="Input mode">
    <button class="tool-option active" data-mode="text" aria-pressed="true">Text</button>
    <button class="tool-option" data-mode="file" aria-pressed="false">File</button>
  </div>
</div>

<div id="ec-text-panel">
  <div class="tool-group">
    <label for="ec-input">Paste text or data</label>
    <textarea id="ec-input" rows="10" placeholder="Paste any text, ciphertext, base64, source code, config..." spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
  </div>
</div>

<div id="ec-file-panel" style="display:none;">
  <div class="tool-group">
    <label>Drop a file or click to browse</label>
    <div id="ec-drop-zone" style="border:2px dashed var(--border,#e5e7eb);border-radius:8px;padding:2rem;text-align:center;cursor:pointer;transition:border-color 0.2s;" role="button" tabindex="0" aria-label="Drop file or click to upload">
      <span id="ec-drop-label">Drop any file here or <u>click to browse</u></span>
      <input type="file" id="ec-file-input" style="display:none;" aria-hidden="true">
    </div>
    <div id="ec-file-info" style="margin-top:0.4rem;font-size:0.875rem;color:var(--text-secondary,#6b7280);"></div>
  </div>
</div>

<div id="ec-results" style="display:none;">

  <div class="ec-meter-wrap">
    <div class="ec-meter-header">
      <span class="ec-meter-label">Shannon Entropy</span>
      <span class="ec-meter-value" id="ec-bits">— bits/byte</span>
    </div>
    <div class="ec-meter-track" role="progressbar" aria-valuemin="0" aria-valuemax="8" aria-label="Entropy meter">
      <div class="ec-meter-fill" id="ec-meter-fill"></div>
      <div class="ec-meter-ticks" aria-hidden="true">
        <span>0</span><span>2</span><span>4</span><span>6</span><span>8</span>
      </div>
    </div>
    <div class="ec-classification" id="ec-classification"></div>
  </div>

  <div class="ec-stats-grid">
    <div class="ec-stat">
      <span class="ec-stat-label">Bytes</span>
      <span class="ec-stat-val" id="ec-stat-bytes">—</span>
    </div>
    <div class="ec-stat">
      <span class="ec-stat-label">Unique bytes</span>
      <span class="ec-stat-val" id="ec-stat-unique">—</span>
    </div>
    <div class="ec-stat">
      <span class="ec-stat-label">Total entropy</span>
      <span class="ec-stat-val" id="ec-stat-total">—</span>
    </div>
    <div class="ec-stat">
      <span class="ec-stat-label">χ² deviation</span>
      <span class="ec-stat-val" id="ec-stat-chi">—</span>
    </div>
  </div>

  <div class="ec-histogram-wrap">
    <div class="ec-histogram-title">Byte frequency distribution</div>
    <canvas id="ec-histogram" width="600" height="120" aria-label="Byte frequency histogram"></canvas>
    <div class="ec-histogram-legend">
      <span class="ec-legend-dot ec-legend-low"></span> Low frequency
      <span class="ec-legend-dot ec-legend-high" style="margin-left:1rem;"></span> High frequency
    </div>
  </div>

</div>

<div id="ec-empty" class="ec-empty-msg">Paste text above or upload a file to analyze its entropy.</div>

<style>
  .ec-meter-wrap {
    background: var(--surface-1,#1a1a2e);
    border: 1px solid var(--border,#2a2a3a);
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1rem;
  }
  .ec-meter-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.75rem;
  }
  .ec-meter-label { font-size: 0.875rem; font-weight: 600; color: var(--text-2,#94a3b8); }
  .ec-meter-value { font-size: 1.5rem; font-weight: 700; font-family: var(--font-mono,monospace); color: var(--text-1,#e2e8f0); }
  .ec-meter-track {
    position: relative;
    height: 20px;
    background: var(--surface-0,#0f0f1a);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }
  .ec-meter-fill {
    height: 100%;
    border-radius: 10px;
    transition: width 0.4s ease, background 0.4s ease;
    background: #22c55e;
  }
  .ec-meter-ticks {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--text-3,#888);
    padding: 0 2px;
  }
  .ec-classification {
    margin-top: 0.75rem;
    padding: 0.6rem 0.875rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .ec-class-plaintext { background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.25); color: #4ade80; }
  .ec-class-structured { background: rgba(234,179,8,0.1); border: 1px solid rgba(234,179,8,0.25); color: #fbbf24; }
  .ec-class-compressed { background: rgba(249,115,22,0.1); border: 1px solid rgba(249,115,22,0.25); color: #fb923c; }
  .ec-class-encrypted { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.25); color: #f87171; }
  .ec-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.6rem;
    margin-bottom: 1rem;
  }
  .ec-stat {
    background: var(--surface-1,#1a1a2e);
    border: 1px solid var(--border,#2a2a3a);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .ec-stat-label { font-size: 0.75rem; color: var(--text-3,#888); text-transform: uppercase; letter-spacing: 0.04em; }
  .ec-stat-val { font-size: 1rem; font-weight: 700; font-family: var(--font-mono,monospace); color: var(--text-1,#e2e8f0); }
  .ec-histogram-wrap {
    background: var(--surface-1,#1a1a2e);
    border: 1px solid var(--border,#2a2a3a);
    border-radius: 10px;
    padding: 1rem 1.25rem 0.875rem;
  }
  .ec-histogram-title { font-size: 0.8125rem; font-weight: 600; color: var(--text-2,#94a3b8); margin-bottom: 0.75rem; }
  #ec-histogram { width: 100%; height: 100px; display: block; }
  .ec-histogram-legend { font-size: 0.75rem; color: var(--text-3,#888); margin-top: 0.5rem; display: flex; align-items: center; }
  .ec-legend-dot { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 4px; }
  .ec-legend-low { background: #4ade80; }
  .ec-legend-high { background: #f87171; }
  .ec-empty-msg { text-align: center; padding: 2.5rem; color: var(--text-3,#888); font-size: 0.9rem; }
</style>

<script>
(function () {
  var modeText    = document.querySelector('[data-mode="text"]');
  var modeFile    = document.querySelector('[data-mode="file"]');
  var textPanel   = document.getElementById('ec-text-panel');
  var filePanel   = document.getElementById('ec-file-panel');
  var textInput   = document.getElementById('ec-input');
  var dropZone    = document.getElementById('ec-drop-zone');
  var fileInput   = document.getElementById('ec-file-input');
  var fileInfo    = document.getElementById('ec-file-info');
  var results     = document.getElementById('ec-results');
  var emptyMsg    = document.getElementById('ec-empty');
  var bitsEl      = document.getElementById('ec-bits');
  var meterFill   = document.getElementById('ec-meter-fill');
  var classBadge  = document.getElementById('ec-classification');
  var statBytes   = document.getElementById('ec-stat-bytes');
  var statUnique  = document.getElementById('ec-stat-unique');
  var statTotal   = document.getElementById('ec-stat-total');
  var statChi     = document.getElementById('ec-stat-chi');
  var canvas      = document.getElementById('ec-histogram');
  var ctx         = canvas.getContext('2d');

  var modeBtns = [modeText, modeFile];

  modeBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      modeBtns.forEach(function (b) {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      var m = btn.getAttribute('data-mode');
      textPanel.style.display = m === 'text' ? '' : 'none';
      filePanel.style.display = m === 'file' ? '' : 'none';
      if (m === 'text') analyzeText(textInput.value);
      else { results.style.display = 'none'; emptyMsg.style.display = ''; }
    });
  });

  function computeEntropy(bytes) {
    var freq = new Array(256).fill(0);
    for (var i = 0; i < bytes.length; i++) freq[bytes[i]]++;
    var n = bytes.length;
    var h = 0;
    var unique = 0;
    for (var b = 0; b < 256; b++) {
      if (freq[b] === 0) continue;
      unique++;
      var p = freq[b] / n;
      h -= p * Math.log2(p);
    }
    // chi-squared — expected uniform distribution
    var expected = n / 256;
    var chi = 0;
    for (var b2 = 0; b2 < 256; b2++) {
      var diff = freq[b2] - expected;
      chi += (diff * diff) / expected;
    }
    return { entropy: h, freq: freq, unique: unique, total: h * n, chi: chi };
  }

  function classify(h) {
    if (h < 3.5) return { label: 'Likely plain text or highly structured data', cls: 'ec-class-plaintext', color: '#4ade80', pct: (h / 8) * 100 };
    if (h < 6.0) return { label: 'Mixed or structured data (source code, config, markup)', cls: 'ec-class-structured', color: '#fbbf24', pct: (h / 8) * 100 };
    if (h < 7.5) return { label: 'Compressed, encoded, or packed data (ZIP, base64, binary)', cls: 'ec-class-compressed', color: '#fb923c', pct: (h / 8) * 100 };
    return { label: 'Likely encrypted or random data (ciphertext, /dev/random output)', cls: 'ec-class-encrypted', color: '#f87171', pct: (h / 8) * 100 };
  }

  function drawHistogram(freq, classColor) {
    var dpr = window.devicePixelRatio || 1;
    var w = canvas.parentElement.clientWidth - 40;
    var h = 100;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    ctx.scale(dpr, dpr);
    ctx.clearRect(0, 0, w, h);

    var maxFreq = Math.max.apply(null, freq);
    if (maxFreq === 0) return;

    var barW = w / 256;
    for (var i = 0; i < 256; i++) {
      var barH = maxFreq > 0 ? (freq[i] / maxFreq) * (h - 4) : 0;
      var ratio = freq[i] / maxFreq;
      // Color: green (low) to red (high) via lerp
      var r = Math.round(74 + ratio * (248 - 74));
      var g = Math.round(222 + ratio * (113 - 222));
      var bCh = Math.round(128 + ratio * (113 - 128));
      ctx.fillStyle = 'rgb(' + r + ',' + g + ',' + bCh + ')';
      ctx.fillRect(i * barW, h - barH, Math.max(barW - 0.5, 0.5), barH);
    }
  }

  function display(bytes) {
    if (!bytes || bytes.length === 0) {
      results.style.display = 'none';
      emptyMsg.style.display = '';
      return;
    }
    var res = computeEntropy(bytes);
    var cl = classify(res.entropy);

    emptyMsg.style.display = 'none';
    results.style.display = '';

    bitsEl.textContent = res.entropy.toFixed(4) + ' bits/byte';
    meterFill.style.width = cl.pct.toFixed(1) + '%';
    meterFill.style.background = cl.color;
    meterFill.parentElement.setAttribute('aria-valuenow', res.entropy.toFixed(2));

    classBadge.textContent = cl.label;
    classBadge.className = 'ec-classification ' + cl.cls;

    statBytes.textContent = bytes.length.toLocaleString();
    statUnique.textContent = res.unique;
    statTotal.textContent = (res.total / 8).toFixed(0) + ' bits';
    statChi.textContent = res.chi.toFixed(1);

    drawHistogram(res.freq, cl.color);
  }

  function analyzeText(text) {
    if (!text) {
      results.style.display = 'none';
      emptyMsg.style.display = '';
      return;
    }
    var enc = new TextEncoder();
    display(enc.encode(text));
  }

  textInput.addEventListener('input', function () { analyzeText(textInput.value); });

  dropZone.addEventListener('click', function () { fileInput.click(); });
  dropZone.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
  });
  dropZone.addEventListener('dragover', function (e) {
    e.preventDefault();
    dropZone.style.borderColor = 'var(--accent,#3b82f6)';
  });
  dropZone.addEventListener('dragleave', function () {
    dropZone.style.borderColor = '';
  });
  dropZone.addEventListener('drop', function (e) {
    e.preventDefault();
    dropZone.style.borderColor = '';
    var f = e.dataTransfer.files[0];
    if (f) processFile(f);
  });
  fileInput.addEventListener('change', function () {
    if (fileInput.files && fileInput.files[0]) processFile(fileInput.files[0]);
  });

  function processFile(file) {
    fileInfo.textContent = file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB)';
    var reader = new FileReader();
    reader.onload = function (e) {
      display(new Uint8Array(e.target.result));
    };
    reader.readAsArrayBuffer(file);
  }

  window.addEventListener('resize', function () {
    // Redraw histogram on resize
    var lastBytes = null;
    if (results.style.display !== 'none' && textInput.value) {
      var enc = new TextEncoder();
      lastBytes = enc.encode(textInput.value);
      var res2 = computeEntropy(lastBytes);
      drawHistogram(res2.freq, classify(res2.entropy).color);
    }
  });
})();
</script>
