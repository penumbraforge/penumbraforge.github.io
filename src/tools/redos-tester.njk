  padding: 10px 14px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--text-1);
  font-family: var(--font-mono);
  font-size: 14px;
  outline: none;
}
.tool-input-mono:focus { border-color: var(--border-active); }

.redos-result-card {
  margin-top: 20px;
  padding: 24px;
  border-radius: 12px;
  border: 1px solid var(--border);
}

.redos-result-card.redos-vuln {
  background: rgba(235, 87, 87, 0.04);
  border-color: rgba(235, 87, 87, 0.15);
}

