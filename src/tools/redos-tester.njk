<script>
(function () {
  var patternEl = document.getElementById('redos-pattern');
  var resultEl = document.getElementById('redos-result');
  var examplesEl = document.getElementById('redos-examples');
  var btnTest = document.getElementById('btn-test');
  var btnExamples = document.getElementById('btn-examples');
  var btnClear = document.getElementById('btn-clear');
  var flagsEl = document.getElementById('redos-flags');
  var repeatEl = document.getElementById('redos-repeat');
  var suffixEl = document.getElementById('redos-suffix');
  var activeRun = null;
  var runId = 0;

  /* ── ReDoS detection heuristics ── */
  function analyzePattern(pattern) {
    var issues = [];
    var severity = 'safe';

    /* Nested quantifiers: (a+)+ or (a*)*  */
    if (/\([^)]*[+*]\)[+*{]/.test(pattern) || /\([^)]*[+*]\)\{/.test(pattern)) {
      issues.push({ type: 'Nested quantifiers', detail: 'A quantified group containing a quantified element can cause excessive backtracking. The regex engine tries every possible way to split the input between the inner and outer repetitions.', severity: 'critical' });
      severity = 'vulnerable';
    }

    /* Overlapping alternation in quantified group: (a|a)+ */
    if (/\([^)]*\|[^)]*\)[+*]/.test(pattern)) {
      var altMatch = pattern.match(/\(([^)]*)\|([^)]*)\)/);
      if (altMatch) {
        issues.push({ type: 'Quantified alternation', detail: 'Alternation inside a quantified group can cause backtracking when both alternatives can match the same characters. The engine tries every combination.', severity: 'high' });
        if (severity !== 'vulnerable') severity = 'warning';
      }
    }

    /* Greedy quantifier followed by similar pattern */
    if (/\.\*.*\.\*/.test(pattern) || /\.+.*\.+/.test(pattern)) {
      issues.push({ type: 'Multiple greedy quantifiers', detail: 'Multiple .* or .+ in the same pattern create ambiguity about which quantifier should match which characters, leading to excessive backtracking.', severity: 'high' });
      if (severity !== 'vulnerable') severity = 'warning';
    }

    /* Star height > 1 */
    var starHeight = 0;
    var depth = 0;
    var maxStarDepth = 0;
    for (var i = 0; i < pattern.length; i++) {
      if (pattern[i] === '(') depth++;
      if (pattern[i] === ')') depth--;
      if ((pattern[i] === '+' || pattern[i] === '*') && depth > 0) {
        if (depth > maxStarDepth) maxStarDepth = depth;
        starHeight++;
      }
    }
    if (starHeight > 2 && maxStarDepth > 1) {
      issues.push({ type: 'Nested repetition syntax', detail: 'The source text contains several nested quantifier-like constructions. Review ambiguous repetitions; this text check does not parse the full regex syntax.', severity: 'high' });
      if (severity !== 'vulnerable') severity = 'warning';
    }

    /* Backreference with quantifier */
    if (/\\[1-9].*[+*]/.test(pattern) || /[+*].*\\[1-9]/.test(pattern)) {
      issues.push({ type: 'Backreference with quantifier', detail: 'Backreferences combined with quantifiers can cause exponential behavior as the engine tries to match the same text in different groupings.', severity: 'medium' });
      if (severity === 'safe') severity = 'warning';
    }

    return { severity: severity, issues: issues };
  }

  /* Isolated timing helpers */
  function buildSamples(repeated, suffix) {
    var samples = [{ label: 'Baseline', input: 'test' }];
    [8, 12, 16, 20, 24, 28, 32, 48, 64, 96, 128].forEach(function (count) {
      samples.push({ label: count + ' repeats + suffix', input: repeated.repeat(count) + suffix });
    });
    return samples;
  }

  function runSamples(pattern, flags, samples, onProgress) {
    var worker = null;
    var timer = null;
    var settled = false;
    var finish;
    var promise = new Promise(function (resolve) {
      var index = 0;
      var results = [];
      finish = function (status, message) {
        if (settled) return;
        settled = true;
        clearTimeout(timer);
        if (worker) worker.terminate();
        resolve({ status: status, message: message || '', results: results });
      };
      if (typeof Worker === 'undefined') {
        finish('unavailable', 'This browser does not provide Web Workers. No regex was executed.');
        return;
      }
      function nextSample() {
        if (index === samples.length) { finish('complete'); return; }
        var sample = samples[index];
        timer = setTimeout(function () {
          results.push({ label: sample.label, input: sample.input, timeout: true });
          finish('timeout', 'The worker exceeded its 250 ms time budget and was terminated.');
        }, 250);
        worker.postMessage({ type: 'sample', input: sample.input });
      }
      try {
        worker = new Worker('/js/redos-timing-worker.js?v={{ assetv }}');
        worker.onmessage = function (event) {
          if (settled) return;
          clearTimeout(timer);
          var data = event.data;
          if (data.type === 'ready') { nextSample(); return; }
          if (data.type === 'syntax-error') { finish('syntax-error', data.message); return; }
          if (data.type === 'error') { finish('error', data.message); return; }
          if (data.type !== 'sample') { finish('error', 'Unexpected worker response.'); return; }
          var sample = samples[index++];
          results.push({ label: sample.label, input: sample.input, duration: data.duration, matched: data.matched });
          if (onProgress) onProgress(results.length, samples.length);
          nextSample();
        };
        worker.onerror = function (event) {
          if (event.preventDefault) event.preventDefault();
          finish('unavailable', 'The worker could not run. This browser or its security policy may block isolated execution. No main-thread fallback was used.');
        };
        timer = setTimeout(function () {
          finish('unavailable', 'The worker did not initialize within 2 seconds. No main-thread fallback was used.');
        }, 2000);
        worker.postMessage({ type: 'init', pattern: pattern, flags: flags });
      } catch (error) {
        finish('unavailable', 'Isolated execution is unavailable. No regex was executed on the page.');
      }
    });
    return { promise: promise, cancel: function () { finish('cancelled'); } };
  }

  function esc(s) {
    var d = document.createElement('div');
    d.appendChild(document.createTextNode(s || ''));
    return d.innerHTML;
  }

  function cancelRun() {
    runId++;
    if (activeRun) activeRun.cancel();
    activeRun = null;
    btnTest.disabled = false;
    btnTest.textContent = 'Test for ReDoS';
  }

  function renderResult(analysis, outcome) {
    var title;
    if (outcome.status === 'syntax-error') title = 'Invalid regular expression or flags';
    else if (outcome.status === 'unavailable') title = 'Timing unavailable';
    else if (outcome.status === 'error') title = 'Timing could not finish';
    else if (outcome.status === 'timeout') title = 'Time budget exceeded';
    else title = 'Bounded samples completed';
    var html = '<div class="redos-result-card redos-warn"><div class="redos-result-title">' + title + '</div>';
    if (outcome.message) html += '<p class="redos-result-detail">' + esc(outcome.message) + '</p>';
    if (outcome.status !== 'syntax-error') {
      html += '<p class="redos-result-detail">These measurements cover only the inputs below in this browser’s JavaScript engine. A short successful run does not prove safety; a timeout includes worker scheduling time and does not prove exponential growth.</p>';
      if (analysis.issues.length) {
        html += '<div class="ha-section-label">Structural review hints</div><p class="redos-result-detail">Simple source-text checks can flag harmless or escaped constructions. They do not classify safety.</p><ul class="redos-explain">';
        analysis.issues.forEach(function (issue) { html += '<li><strong>' + esc(issue.type) + '.</strong> ' + esc(issue.detail) + '</li>'; });
        html += '</ul>';
      }
    }
    if (outcome.results.length) {
      html += '<div class="redos-table-wrap"><table class="redos-table"><thead><tr><th>Sample</th><th>Length</th><th>Time</th><th>Matched</th></tr></thead><tbody>';
      outcome.results.forEach(function (sample) {
        html += '<tr><th>' + esc(sample.label) + '</th><td>' + sample.input.length + '</td><td>' + (sample.timeout ? '250 ms budget exceeded' : sample.duration.toFixed(3) + ' ms') + '</td><td>' + (sample.timeout ? 'Unknown' : sample.matched ? 'Yes' : 'No') + '</td></tr>';
      });
      html += '</tbody></table></div><details class="redos-attack-string"><summary>Exact sample inputs (JSON strings)</summary>';
      outcome.results.forEach(function (sample) { html += '<div class="redos-attack-label">' + esc(sample.label) + '</div><code class="redos-attack-value">' + esc(JSON.stringify(sample.input)) + '</code>'; });
      html += '</details>';
    }
    resultEl.innerHTML = html + '</div>';
  }

  function runTest() {
    cancelRun();
    var pattern = patternEl.value;
    if (!pattern) { patternEl.focus(); return; }
    resultEl.style.display = '';
    if (pattern.length > 2048 || !repeatEl.value || repeatEl.value.length > 8 || suffixEl.value.length > 16 || flagsEl.value.length > 16) {
      resultEl.textContent = 'Use a pattern up to 2,048 characters, repeat text of 1–8 characters, and flags and suffix up to 16 characters each.';
      return;
    }
    var thisRun = runId;
    var analysis = analyzePattern(pattern);
    var samples = buildSamples(repeatEl.value, suffixEl.value);
    btnTest.disabled = true;
    btnTest.textContent = 'Testing…';
    resultEl.textContent = 'Starting isolated timing. Clear cancels the test.';
    activeRun = runSamples(pattern, flagsEl.value.trim(), samples, function (done, total) {
      if (thisRun === runId) resultEl.textContent = 'Testing in worker: ' + done + ' of ' + total + ' samples completed. Clear cancels the test.';
    });
    activeRun.promise.then(function (outcome) {
      if (thisRun !== runId || outcome.status === 'cancelled') return;
      activeRun = null;
      btnTest.disabled = false;
      btnTest.textContent = 'Test for ReDoS';
      renderResult(analysis, outcome);
    });
  }

  btnTest.addEventListener('click', runTest);
  patternEl.addEventListener('keydown', function (e) { if (e.key === 'Enter') runTest(); });

  btnExamples.addEventListener('click', function () {
    examplesEl.style.display = examplesEl.style.display === 'none' ? '' : 'none';
  });

  btnClear.addEventListener('click', function () {
    cancelRun();
    patternEl.value = '';
    resultEl.style.display = 'none';
  });

  [patternEl, flagsEl, repeatEl, suffixEl].forEach(function (input) {
    input.addEventListener('input', function () { cancelRun(); resultEl.style.display = 'none'; });
  });

  document.querySelectorAll('.redos-ex').forEach(function (btn) {
    btn.addEventListener('click', function () {
      patternEl.value = this.getAttribute('data-pattern');
      flagsEl.value = '';
      repeatEl.value = patternEl.value.indexOf('\\d') !== -1 ? '1' : 'a';
      suffixEl.value = '!';
      examplesEl.style.display = 'none';
      runTest();
    });
  });
})();
</script>
