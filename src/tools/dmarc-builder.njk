<script>
(function () {
  // Tab switching
  var tabs = Array.prototype.slice.call(document.querySelectorAll('.dm-tab'));
  var panels = {
    dmarc: document.getElementById('dm-panel-dmarc'),
    spf:   document.getElementById('dm-panel-spf'),
    dkim:  document.getElementById('dm-panel-dkim')
  };

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      tabs.forEach(function (t) {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      var which = tab.getAttribute('data-tab');
      Object.keys(panels).forEach(function (k) {
        panels[k].style.display = k === which ? '' : 'none';
      });
    });
  });

  // --- DMARC ---
  var dmDomain  = document.getElementById('dm-domain');
  var dmPolicy  = document.getElementById('dm-policy');
  var dmPct     = document.getElementById('dm-pct');
  var dmRua     = document.getElementById('dm-rua');
  var dmRuf     = document.getElementById('dm-ruf');
  var dmSp      = document.getElementById('dm-sp');
  var dmAdkim   = document.getElementById('dm-adkim');
  var dmAspf    = document.getElementById('dm-aspf');
  var dmNameEl  = document.getElementById('dm-dmarc-name');
  var dmOutput  = document.getElementById('dm-dmarc-output');
  var dmCopyBtn = document.getElementById('dm-dmarc-copy');

  function buildDMARC() {
    var domain = dmDomain.value.trim() || 'example.com';
    dmNameEl.textContent = '_dmarc.' + domain;
    var parts = ['v=DMARC1', 'p=' + dmPolicy.value];
    var pct = parseInt(dmPct.value, 10);
    if (!isNaN(pct) && pct !== 100) parts.push('pct=' + pct);
    var rua = dmRua.value.trim();
    if (rua) parts.push('rua=' + rua);
    var ruf = dmRuf.value.trim();
    if (ruf) parts.push('ruf=' + ruf);
    if (dmSp.value) parts.push('sp=' + dmSp.value);
    if (dmAdkim.value) parts.push('adkim=' + dmAdkim.value);
    if (dmAspf.value) parts.push('aspf=' + dmAspf.value);
    dmOutput.textContent = parts.join('; ');
  }

  [dmDomain, dmPolicy, dmPct, dmRua, dmRuf, dmSp, dmAdkim, dmAspf].forEach(function (el) {
    el.addEventListener('input', buildDMARC);
  });
  buildDMARC();

  // --- SPF ---
  var spfDomainEl   = document.getElementById('spf-domain');
  var spfQualifier  = document.getElementById('spf-qualifier');
  var spfAll        = document.getElementById('spf-all');
  var spfMechsEl    = document.getElementById('spf-mechanisms');
  var spfAddBtn     = document.getElementById('spf-add-mech-btn');
  var spfNameEl     = document.getElementById('dm-spf-name');
  var spfOutput     = document.getElementById('dm-spf-output');
  var spfCopyBtn    = document.getElementById('dm-spf-copy');

  var MECH_TYPES = ['ip4', 'ip6', 'include', 'a', 'mx', 'ptr', 'exists'];

  function buildSPF() {
    var domain = spfDomainEl.value.trim() || 'example.com';
    spfNameEl.textContent = domain;
    var parts = ['v=spf1'];
    var rows = spfMechsEl.querySelectorAll('.dm-mech-row');
    rows.forEach(function (row) {
      var qual = row.querySelector('.spf-mech-qual');
      var type = row.querySelector('.spf-mech-type');
      var val  = row.querySelector('.spf-mech-val');
      if (!qual || !type) return;
      var q = qual.value;
      var t = type.value;
      var v = val ? val.value.trim() : '';
      var prefix = q === '+' ? '' : q;
      if (t === 'a' || t === 'mx' || t === 'ptr') {
        parts.push(prefix + t + (v ? ':' + v : ''));
      } else if (v) {
        parts.push(prefix + t + ':' + v);
      }
    });
    parts.push(spfAll.value);
    spfOutput.textContent = parts.join(' ');
  }

  function addMechRow(defaults) {
    defaults = defaults || {};
    var row = document.createElement('div');
    row.className = 'dm-mech-row';

    var qual = document.createElement('select');
    qual.className = 'spf-mech-qual';
    qual.style.maxWidth = '100px';
    var quals = [{v:'+',l:'+ Pass'},{v:'~',l:'~ SoftFail'},{v:'-',l:'- HardFail'},{v:'?',l:'? Neutral'}];
    quals.forEach(function (q) {
      var opt = document.createElement('option');
      opt.value = q.v;
      opt.textContent = q.l;
      if (defaults.qual === q.v) opt.selected = true;
      qual.appendChild(opt);
    });

    var type = document.createElement('select');
    type.className = 'spf-mech-type';
    type.style.maxWidth = '110px';
    MECH_TYPES.forEach(function (m) {
      var opt = document.createElement('option');
      opt.value = m;
      opt.textContent = m;
      if (defaults.type === m) opt.selected = true;
      type.appendChild(opt);
    });

    var val = document.createElement('input');
    val.type = 'text';
    val.className = 'spf-mech-val';
    val.placeholder = 'value (IP, domain...)';
    val.value = defaults.value || '';
    val.spellcheck = false;

    var rm = document.createElement('button');
    rm.className = 'dm-mech-remove';
    rm.type = 'button';
    rm.textContent = '×';
    rm.setAttribute('aria-label', 'Remove mechanism');
    rm.addEventListener('click', function () {
      spfMechsEl.removeChild(row);
      buildSPF();
    });

    [qual, type, val].forEach(function (el) { el.addEventListener('change', buildSPF); el.addEventListener('input', buildSPF); });

    row.appendChild(qual);
    row.appendChild(type);
    row.appendChild(val);
    row.appendChild(rm);
    spfMechsEl.appendChild(row);
    buildSPF();
  }

  spfAddBtn.addEventListener('click', function () { addMechRow(); });
  spfDomainEl.addEventListener('input', buildSPF);
  spfQualifier.addEventListener('change', buildSPF);
  spfAll.addEventListener('change', buildSPF);
  // Add default mechanisms
  addMechRow({ qual: '+', type: 'mx', value: '' });
  addMechRow({ qual: '+', type: 'include', value: '' });
  buildSPF();

  // --- DKIM ---
  var dkimDomain  = document.getElementById('dkim-domain');
  var dkimSelector= document.getElementById('dkim-selector');
  var dkimPubkey  = document.getElementById('dkim-pubkey');
  var dkimNameEl  = document.getElementById('dm-dkim-name');
  var dkimOutput  = document.getElementById('dm-dkim-output');
  var dkimCopyBtn = document.getElementById('dm-dkim-copy');

  function buildDKIM() {
    var domain = dkimDomain.value.trim() || 'example.com';
    var sel = dkimSelector.value.trim() || 'default';
    dkimNameEl.textContent = sel + '._domainkey.' + domain;
    var key = dkimPubkey.value.trim().replace(/\s+/g, '');
    var parts = ['v=DKIM1', 'k=rsa'];
    if (key) parts.push('p=' + key);
    else parts.push('p=YOUR_PUBLIC_KEY_HERE');
    dkimOutput.textContent = parts.join('; ');
  }

  [dkimDomain, dkimSelector, dkimPubkey].forEach(function (el) { el.addEventListener('input', buildDKIM); });
  buildDKIM();

  // Copy buttons
  function makeCopier(btn, getter) {
    btn.addEventListener('click', function () {
      var text = getter();
      if (!text) return;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () {
          btn.textContent = 'Copied!';
          setTimeout(function () { btn.textContent = 'Copy'; }, 2000);
        });
      } else {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.style.cssText = 'position:fixed;opacity:0;';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); btn.textContent = 'Copied!'; } catch(e) { btn.textContent = 'Failed'; }
        document.body.removeChild(ta);
        setTimeout(function () { btn.textContent = 'Copy'; }, 2000);
      }
    });
  }
  makeCopier(dmCopyBtn,   function () { return dmOutput.textContent; });
  makeCopier(spfCopyBtn,  function () { return spfOutput.textContent; });
  makeCopier(dkimCopyBtn, function () { return dkimOutput.textContent; });
})();
</script>
