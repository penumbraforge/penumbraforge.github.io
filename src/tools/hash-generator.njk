  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.style.display = '';
  }
  function hideError() {
    errorEl.textContent = '';
    errorEl.style.display = 'none';
  }

  function hashText(text) {
    if (!text) {
      outputEl.textContent = '';
      hideError();
      return;
    }
    if (currentAlgo === 'MD5') {
      outputEl.textContent = md5(text);
      hideError();
      return;
    }
    var encoder = new TextEncoder();
    var data = encoder.encode(text);
    crypto.subtle.digest(currentAlgo, data).then(function (buf) {
      outputEl.textContent = bufToHex(buf);
      hideError();
    }).catch(function (err) {
      showError('Hash error: ' + err.message);
    });
  }

  function hashBytes(bytes, fileName) {
    if (currentAlgo === 'MD5') {
      outputEl.textContent = md5FromBytes(bytes);
      hideError();
      return;
    }
    crypto.subtle.digest(currentAlgo, bytes).then(function (buf) {
      outputEl.textContent = bufToHex(buf);
      hideError();
    }).catch(function (err) {
      showError('Hash error: ' + err.message);
    });
  }

  function processFile(file) {
    fileInfo.textContent = file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB)';
    var reader = new FileReader();
    reader.onload = function (e) {
      fileBytes = new Uint8Array(e.target.result);
      hashBytes(fileBytes, file.name);
    };
    reader.readAsArrayBuffer(file);
  }

  inputEl.addEventListener('input', function () {
    fileBytes = null;
    fileInfo.textContent = '';
    hashText(inputEl.value);
  });

  // Algorithm toggle
  var algoBtns = Array.prototype.slice.call(document.querySelectorAll('.tool-option[data-algo]'));
  algoBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      algoBtns.forEach(function (b) {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      currentAlgo = btn.getAttribute('data-algo');
      if (fileBytes) {
        hashBytes(fileBytes, '');
      } else {
        hashText(inputEl.value);
      }
    });
  });

  // File drop zone
  dropZone.addEventListener('click', function () { fileInput.click(); });
  dropZone.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
  });

  fileInput.addEventListener('change', function () {
    if (fileInput.files && fileInput.files[0]) {
      inputEl.value = '';
      processFile(fileInput.files[0]);
    }
  });

  dropZone.addEventListener('dragover', function (e) {
    e.preventDefault();
    dropZone.style.borderColor = 'var(--accent, #3b82f6)';
  });
  dropZone.addEventListener('dragleave', function () {
    dropZone.style.borderColor = '';
  });
  dropZone.addEventListener('drop', function (e) {
    e.preventDefault();
    dropZone.style.borderColor = '';
    var file = e.dataTransfer.files[0];
    if (file) {
      inputEl.value = '';
      processFile(file);
    }
  });

  // Compare
  compareBtn.addEventListener('click', function () {
    var a = compareAEl.value.trim().toLowerCase();
    var b = compareBEl.value.trim().toLowerCase();
    if (!a || !b) {
      compareRes.textContent = 'Enter both hashes to compare.';
      compareRes.style.color = '';
      compareRes.style.display = '';
      return;
    }
    if (a === b) {
      compareRes.textContent = 'Match — hashes are identical.';
      compareRes.style.color = '#22c55e';
    } else {
      compareRes.textContent = 'Mismatch — hashes differ.';
      compareRes.style.color = '#ef4444';
    }
    compareRes.style.display = '';
  });

  copyBtn.addEventListener('click', function () {
    var text = outputEl.textContent;
    if (!text) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () {
        copyBtn.textContent = 'Copied!';
        setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
      }).catch(function () {
        copyBtn.textContent = 'Failed';
        setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
      });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try {
        document.execCommand('copy');
        copyBtn.textContent = 'Copied!';
      } catch (e) {
        copyBtn.textContent = 'Failed';
      }
      document.body.removeChild(ta);
      setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
    }
  });

  // ---- Agent I/O + URL-invoke (window.PF from /js/tool-io.js) ----
  if (window.PF) {
    var mo = new MutationObserver(function () {
      var out = outputEl.textContent;
      if (out) PF.ready({ output: out, data: { algorithm: currentAlgo, input: fileBytes ? '(file)' : inputEl.value } });
    });
    mo.observe(outputEl, { childList: true, characterData: true, subtree: true });
    var p = PF.input();
    if (p.in != null) {
      inputEl.value = p.in;
      if (p.algo) { var ab = document.querySelector('.tool-option[data-algo="' + p.algo + '"]'); if (ab) ab.click(); }
      hashText(inputEl.value);
    }
  }
})();
</script>
