---
toolSlug: hash-generator
permalink: /tools/hash-generator/
---

<div class="tool-row">
  <div class="tool-options" role="group" aria-label="Hash algorithm">
    <button class="tool-option active" data-algo="SHA-256" aria-pressed="true">SHA-256</button>
    <button class="tool-option" data-algo="SHA-512" aria-pressed="false">SHA-512</button>
    <button class="tool-option" data-algo="SHA-1" aria-pressed="false">SHA-1 <span style="font-size:0.75em; color:#f97316;" title="Deprecated for security use">(deprecated)</span></button>
    <button class="tool-option" data-algo="MD5" aria-pressed="false">MD5 <span style="font-size:0.75em; color:#ef4444;" title="Cryptographically broken">(broken)</span></button>
  </div>
</div>

<div class="tool-group">
  <label for="hash-input">Text input</label>
  <textarea id="hash-input" rows="6" placeholder="Enter text to hash..." spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
</div>

<div class="tool-group">
  <label>File input</label>
  <div id="drop-zone" style="border:2px dashed var(--border); border-radius:8px; padding:1.5rem; text-align:center; cursor:pointer; transition:border-color 0.2s; user-select:none;" role="button" tabindex="0" aria-label="Drop file or click to upload">
    <span id="drop-label">Drop a file here or <u>click to browse</u></span>
    <input type="file" id="file-input" style="display:none;" aria-hidden="true">
  </div>
  <div id="file-info" style="margin-top:0.4rem; font-size:0.875rem; color:var(--text-3);"></div>
</div>

<div id="hash-error" style="display:none;" role="alert" aria-live="polite" class="tool-error"></div>

<div class="output-area">
  <button class="btn btn--copy" id="btn-copy" aria-label="Copy hash">Copy</button>
  <pre id="hash-output" aria-label="Hash output" style="word-break:break-all; white-space:pre-wrap;"></pre>
</div>

<hr style="margin:1.5rem 0; border:none; border-top:1px solid var(--border);">

<details>
  <summary style="cursor:pointer; font-weight:600; margin-bottom:0.75rem;">Compare hashes</summary>
  <div style="margin-top:0.75rem;">
    <div class="tool-group">
      <label for="hash-compare-a">Hash A</label>
      <input type="text" id="hash-compare-a" placeholder="Paste first hash..." spellcheck="false" autocomplete="off" style="font-family:var(--font-mono);">
    </div>
    <div class="tool-group">
      <label for="hash-compare-b">Hash B</label>
      <input type="text" id="hash-compare-b" placeholder="Paste second hash..." spellcheck="false" autocomplete="off" style="font-family:var(--font-mono);">
    </div>
    <div class="tool-row">
      <button class="btn" id="btn-compare">Compare</button>
    </div>
    <div id="compare-result" role="alert" aria-live="polite" style="margin-top:0.75rem; font-weight:600; display:none;"></div>
  </div>
</details>

