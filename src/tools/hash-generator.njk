    function strToUtf8Bin(str) {
      var encoder = new TextEncoder();
      var utf8 = encoder.encode(str);
      var output = new Array(Math.ceil(utf8.length / 4));
      for (var i = 0; i < output.length; i++) output[i] = 0;
      for (var i = 0; i < utf8.length; i++) {
        output[i >> 2] |= utf8[i] << ((i % 4) * 8);
      }
      return output;
    }
    function binToHex(binArr) {
