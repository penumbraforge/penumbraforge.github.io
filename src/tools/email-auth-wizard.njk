</style>

<script>
(function () {
  'use strict';

  /* ── Tab switching ── */
  var tabs = Array.prototype.slice.call(document.querySelectorAll('.ew-tab'));
  var panels = {
    spf:    document.getElementById('ew-panel-spf'),
    dkim:   document.getElementById('ew-panel-dkim'),
    dmarc:  document.getElementById('ew-panel-dmarc'),
    deploy: document.getElementById('ew-panel-deploy')
  };

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      tabs.forEach(function (t) {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      var which = tab.getAttribute('data-tab');
      Object.keys(panels).forEach(function (k) {
        panels[k].style.display = k === which ? '' : 'none';
      });
    });
  });

  /* ── Copy helper ── */
  function makeCopier(btn, getter) {
    btn.addEventListener('click', function () {
      var text = getter();
      if (!text) return;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () {
          btn.textContent = 'Copied!';
          setTimeout(function () { btn.textContent = 'Copy'; }, 2000);
        });
      } else {
        var ta = document.createElement('textarea');
        ta.value = text; ta.style.cssText = 'position:fixed;opacity:0;';
        document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); btn.textContent = 'Copied!'; } catch (e) { btn.textContent = 'Failed'; }
        document.body.removeChild(ta);
        setTimeout(function () { btn.textContent = 'Copy'; }, 2000);
      }
    });
  }

  /* ═══════════════ SPF ═══════════════ */
  var spfDomainEl       = document.getElementById('ew-spf-domain');
  var spfAllEl          = document.getElementById('ew-spf-all');
  var spfIpsEl          = document.getElementById('ew-spf-ips');
  var spfCustomIncEl    = document.getElementById('ew-spf-custom-includes');
  var spfRecordNameEl   = document.getElementById('ew-spf-record-name');
  var spfOutputEl       = document.getElementById('ew-spf-output');
  var spfCopyBtn        = document.getElementById('ew-spf-copy');
  var spfLookupWarnEl   = document.getElementById('ew-spf-lookup-warning');
  var spfExplainEl      = document.getElementById('ew-spf-explain');

  var providerCheckboxes = Array.prototype.slice.call(document.querySelectorAll('.ew-provider-check input[type="checkbox"]'));

  function buildSPF() {
    var domain = spfDomainEl.value.trim() || 'example.com';
    spfRecordNameEl.textContent = domain;

    var parts = ['v=spf1'];
    var directLookupTerms = 0;
    var explanations = [];

    // Provider checkboxes
    providerCheckboxes.forEach(function (cb) {
      if (!cb.checked) return;
      var include = cb.getAttribute('data-include');
      var mech = cb.getAttribute('data-mech');
      if (include) {
        parts.push('include:' + include);
        directLookupTerms += 1;
        explanations.push({ tag: 'include:' + include, desc: 'Adds ' + cb.parentElement.querySelector('.ew-provider-name').textContent + ' through one direct include. Recursive evaluation of that provider\'s current SPF records may require additional DNS lookups.' });
      } else if (mech) {
        parts.push(mech);
        directLookupTerms += 1;
        explanations.push({ tag: mech, desc: mech === 'mx' ? 'Authorizes the IP addresses of your MX (mail exchange) records.' : 'Authorizes the IP address of your domain\'s A record.' });
      }
    });

    // Custom includes
    var customIncludes = spfCustomIncEl.value.trim();
    if (customIncludes) {
      customIncludes.split(/[,\s]+/).forEach(function (inc) {
        inc = inc.trim();
        if (inc) {
          parts.push('include:' + inc);
          directLookupTerms += 1;
          explanations.push({ tag: 'include:' + inc, desc: 'Adds one direct include. Recursive evaluation of that domain\'s current SPF record may require additional DNS lookups.' });
        }
      });
    }

    // Custom IPs
    var ips = spfIpsEl.value.trim();
    if (ips) {
      ips.split(/[,\s]+/).forEach(function (ip) {
        ip = ip.trim();
        if (!ip) return;
        if (ip.indexOf(':') >= 0) {
          parts.push('ip6:' + ip);
          explanations.push({ tag: 'ip6:' + ip, desc: 'Authorizes this IPv6 address or range. Does not count toward the 10-lookup limit.' });
        } else {
          parts.push('ip4:' + ip);
          explanations.push({ tag: 'ip4:' + ip, desc: 'Authorizes this IPv4 address or CIDR range. Does not count toward the 10-lookup limit.' });
        }
      });
    }

    // All mechanism
    var allMech = spfAllEl.value;
    parts.push(allMech);
    var allDesc = {
      '-all': 'Returns SPF Fail for sources not authorized above; the receiving system decides how to handle that result.',
      '~all': 'Returns SPF SoftFail for other sources; the receiving system decides how to handle that result.',
      '?all': 'Returns SPF Neutral for other sources; this expresses no pass/fail policy.'
    };
    explanations.push({ tag: allMech, desc: allDesc[allMech] || '' });

    spfOutputEl.textContent = parts.join(' ');

    // Lookup warning
    if (directLookupTerms > 10) {
      spfLookupWarnEl.className = 'ew-lookup-warning ew-lookup-warning--danger';
      spfLookupWarnEl.innerHTML = '<strong>Direct terms already exceed 10:</strong> the generated record contains ' + directLookupTerms + ' direct lookup-triggering mechanisms before recursively evaluating include chains. Resolve the live DNS graph with an SPF evaluator before publishing.';
      spfLookupWarnEl.style.display = '';
    } else if (directLookupTerms >= 8) {
      spfLookupWarnEl.className = 'ew-lookup-warning ew-lookup-warning--warn';
      spfLookupWarnEl.innerHTML = '<strong>High direct count:</strong> ' + directLookupTerms + ' lookup-triggering mechanisms appear in this generated record. Included records can add more; this page does not resolve DNS recursively or calculate the RFC evaluation total.';
      spfLookupWarnEl.style.display = '';
    } else if (directLookupTerms > 0) {
      spfLookupWarnEl.className = 'ew-lookup-warning ew-lookup-warning--ok';
      spfLookupWarnEl.innerHTML = directLookupTerms + ' direct lookup-triggering mechanism' + (directLookupTerms !== 1 ? 's' : '') + ' in the generated record. Actual SPF evaluation can be higher because include and redirect chains are recursive and DNS data changes.';
      spfLookupWarnEl.style.display = '';
    } else {
      spfLookupWarnEl.style.display = 'none';
    }

    // Explanations
    var html = '';
    if (explanations.length > 0) {
      explanations.forEach(function (e) {
        html += '<div class="ew-explain-item"><span class="ew-explain-tag">' + escapeHtml(e.tag) + '</span><span>' + escapeHtml(e.desc) + '</span></div>';
      });
    }
    spfExplainEl.innerHTML = html;
  }

  // Wire up SPF events
  spfDomainEl.addEventListener('input', buildSPF);
  spfAllEl.addEventListener('change', buildSPF);
  spfIpsEl.addEventListener('input', buildSPF);
  spfCustomIncEl.addEventListener('input', buildSPF);
  providerCheckboxes.forEach(function (cb) {
    cb.addEventListener('change', buildSPF);
  });
  buildSPF();
  makeCopier(spfCopyBtn, function () { return spfOutputEl.textContent; });

  /* ═══════════════ DKIM ═══════════════ */
  var dkimDomainEl   = document.getElementById('ew-dkim-domain');
  var dkimSelectorEl = document.getElementById('ew-dkim-selector');
  var dkimPubkeyEl   = document.getElementById('ew-dkim-pubkey');
  var dkimNameEl     = document.getElementById('ew-dkim-record-name');
  var dkimOutputEl   = document.getElementById('ew-dkim-output');
  var dkimCopyBtn    = document.getElementById('ew-dkim-copy');

  function buildDKIM() {
    var domain = dkimDomainEl.value.trim() || 'example.com';
    var selector = dkimSelectorEl.value.trim() || 'default';
    dkimNameEl.textContent = selector + '._domainkey.' + domain;
    var key = dkimPubkeyEl.value.trim().replace(/\s+/g, '');
    var parts = ['v=DKIM1', 'k=rsa'];
    if (key) parts.push('p=' + key);
    else parts.push('p=YOUR_PUBLIC_KEY_HERE');
    dkimOutputEl.textContent = parts.join('; ');
  }

  [dkimDomainEl, dkimSelectorEl, dkimPubkeyEl].forEach(function (el) {
    el.addEventListener('input', buildDKIM);
  });
  buildDKIM();
  makeCopier(dkimCopyBtn, function () { return dkimOutputEl.textContent; });

  /* ═══════════════ DMARC ═══════════════ */
  var dmarcDomainEl  = document.getElementById('ew-dmarc-domain');
  var dmarcPolicyEl  = document.getElementById('ew-dmarc-policy');
  var dmarcSpEl      = document.getElementById('ew-dmarc-sp');
  var dmarcPctEl     = document.getElementById('ew-dmarc-pct');
  var dmarcPctValEl  = document.getElementById('ew-dmarc-pct-val');
  var dmarcRuaEl     = document.getElementById('ew-dmarc-rua');
  var dmarcRufEl     = document.getElementById('ew-dmarc-ruf');
  var dmarcAdkimEl   = document.getElementById('ew-dmarc-adkim');
  var dmarcAspfEl    = document.getElementById('ew-dmarc-aspf');
  var dmarcNameEl    = document.getElementById('ew-dmarc-record-name');
  var dmarcOutputEl  = document.getElementById('ew-dmarc-output');
  var dmarcCopyBtn   = document.getElementById('ew-dmarc-copy');
  var dmarcExplainEl = document.getElementById('ew-dmarc-explain');

  function buildDMARC() {
    var domain = dmarcDomainEl.value.trim() || 'example.com';
    dmarcNameEl.textContent = '_dmarc.' + domain;

    var parts = ['v=DMARC1'];
    var explanations = [];

    // Policy
    parts.push('p=' + dmarcPolicyEl.value);
    var policyDescs = {
      none: 'Monitor only. Receiving servers take no action on failing emails. Use this to collect data before enforcing.',
      quarantine: 'Send failing emails to the spam/junk folder.',
      reject: 'Reject failing emails outright. The strongest and recommended setting once you have verified all legitimate senders.'
    };
    explanations.push({ tag: 'p=' + dmarcPolicyEl.value, desc: policyDescs[dmarcPolicyEl.value] });

    // Subdomain policy
    if (dmarcSpEl.value) {
      parts.push('sp=' + dmarcSpEl.value);
      explanations.push({ tag: 'sp=' + dmarcSpEl.value, desc: 'Override the policy for subdomains. Useful when subdomains have different email requirements.' });
    }

    // Percentage
    var pct = parseInt(dmarcPctEl.value, 10);
    dmarcPctValEl.textContent = pct + '%';
    if (!isNaN(pct) && pct !== 100) {
      parts.push('pct=' + pct);
      explanations.push({ tag: 'pct=' + pct, desc: 'Apply the policy to ' + pct + '% of messages. Useful for gradual rollout.' });
    }

    // Aggregate reports
    var rua = dmarcRuaEl.value.trim();
    if (rua) {
      var ruaVal = rua.indexOf('mailto:') === 0 ? rua : 'mailto:' + rua;
      parts.push('rua=' + ruaVal);
      explanations.push({ tag: 'rua=' + ruaVal, desc: 'Daily aggregate XML reports sent to this address. Essential for monitoring.' });
    }

    // Forensic reports
    var ruf = dmarcRufEl.value.trim();
    if (ruf) {
      var rufVal = ruf.indexOf('mailto:') === 0 ? ruf : 'mailto:' + ruf;
      parts.push('ruf=' + rufVal);
      explanations.push({ tag: 'ruf=' + rufVal, desc: 'Individual failure (forensic) reports. Many ISPs no longer send these.' });
    }

    // Alignment
    var adkim = dmarcAdkimEl.value;
    parts.push('adkim=' + adkim);
    explanations.push({ tag: 'adkim=' + adkim, desc: adkim === 's' ? 'Strict DKIM alignment: the DKIM signing domain must exactly match the From domain.' : 'Relaxed DKIM alignment: subdomains of the From domain are allowed.' });

    var aspf = dmarcAspfEl.value;
    parts.push('aspf=' + aspf);
    explanations.push({ tag: 'aspf=' + aspf, desc: aspf === 's' ? 'Strict SPF alignment: the Return-Path domain must exactly match the From domain.' : 'Relaxed SPF alignment: subdomains of the From domain are allowed.' });

    dmarcOutputEl.textContent = parts.join('; ');

    // Explanations
    var html = '';
    explanations.forEach(function (e) {
      html += '<div class="ew-explain-item"><span class="ew-explain-tag">' + escapeHtml(e.tag) + '</span><span>' + escapeHtml(e.desc) + '</span></div>';
    });
    dmarcExplainEl.innerHTML = html;
  }

  [dmarcDomainEl, dmarcPolicyEl, dmarcSpEl, dmarcPctEl, dmarcRuaEl, dmarcRufEl, dmarcAdkimEl, dmarcAspfEl].forEach(function (el) {
    el.addEventListener('input', buildDMARC);
    el.addEventListener('change', buildDMARC);
  });
  buildDMARC();
  makeCopier(dmarcCopyBtn, function () { return dmarcOutputEl.textContent; });

  /* ── HTML escape ── */
  function escapeHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
})();
</script>
