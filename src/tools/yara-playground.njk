---
toolSlug: yara-playground
permalink: /tools/yara-playground/
---

<div class="yp-layout">
  <!-- Left: Editor panel -->
  <div class="yp-panel yp-panel--editor">
    <div class="yp-panel-header">
      <span class="yp-panel-title">Rule Editor</span>
      <div class="yp-header-actions">
        <select id="yp-template-select" class="yp-select" title="Load a template">
          <option value="">Load template…</option>
          <option value="generic">Generic File Detection</option>
          <option value="pe_header">PE Header Check</option>
          <option value="doc_macro">Document Macro</option>
          <option value="ransomware_note">Ransomware Note</option>
          <option value="webshell">Webshell Patterns</option>
          <option value="packed_binary">Packed Binary</option>
          <option value="crypto_miner">Crypto Miner</option>
          <option value="phishing_kit">Phishing Kit</option>
          <option value="suspicious_script">Suspicious Script</option>
          <option value="lateral_movement">Lateral Movement</option>
          <option value="custom">Custom Template</option>
        </select>
        <button class="btn yp-btn-sm" id="yp-validate-btn">Validate</button>
      </div>
    </div>
    <textarea id="yp-editor" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" placeholder="Write or paste a YARA rule here, or load a template above…"></textarea>
    <div id="yp-validate-result" class="yp-validate-result" style="display:none;"></div>
    <div class="yp-editor-actions">
      <button class="btn btn--primary" id="yp-analyze-btn">Analyze Rule</button>
      <button class="btn yp-btn-sm" id="yp-copy-btn">Copy Rule</button>
      <button class="btn yp-btn-sm" id="yp-download-btn">Download .yar</button>
      <button class="btn yp-btn-sm" id="yp-clear-btn">Clear</button>
    </div>
  </div>

  <!-- Right: Analysis + Test panel -->
  <div class="yp-panel yp-panel--right">

    <!-- Hex String Builder -->
    <div class="yp-section">
      <div class="yp-section-title">Hex String Builder</div>
      <div class="yp-hex-row">
        <input type="text" id="yp-hex-input" class="yp-input" placeholder="ASCII string or hex (e.g. MZ or 4D5A)" spellcheck="false" autocomplete="off">
        <button class="btn yp-btn-sm" id="yp-hex-to-ascii-btn">Hex → ASCII</button>
        <button class="btn yp-btn-sm" id="yp-ascii-to-hex-btn">ASCII → Hex</button>
      </div>
      <div id="yp-hex-result" class="yp-hex-result" style="display:none;"></div>
    </div>

    <!-- Rule Analyzer -->
    <div class="yp-section" id="yp-analyzer-section" style="display:none;">
      <div class="yp-section-title">Rule Analysis</div>
      <div id="yp-analyzer-content"></div>
    </div>

    <!-- Test Mode -->
    <div class="yp-section">
      <div class="yp-section-title">
        Pattern Test
        <span class="yp-approx-badge">approximate — not full YARA semantics</span>
      </div>
      <textarea id="yp-test-input" rows="6" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" placeholder="Paste hex dump or ASCII text to test rule string patterns against…"></textarea>
      <div class="yp-test-actions">
        <button class="btn btn--primary yp-btn-sm" id="yp-test-btn">Test Patterns</button>
        <button class="btn yp-btn-sm" id="yp-test-example-btn">Load Example</button>
        <button class="btn yp-btn-sm" id="yp-test-clear-btn">Clear</button>
      </div>
      <div id="yp-test-result" style="display:none;"></div>
    </div>

  </div>
</div>

