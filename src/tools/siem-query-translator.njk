      else funcStr = a.func + '(' + mapField(a.field, fromLang, 'kql') + ')';

      if (a.by && a.by.length) {
        var byFields = a.by.map(function(b) { return mapField(b, fromLang, 'kql'); });
        lines.push('| summarize ' + funcStr + ' by ' + byFields.join(', '));
      } else {
        lines.push('| summarize ' + funcStr);
      }
    });

    if (ir.sort) {
      var sf = mapField(ir.sort.field, fromLang, 'kql');
      lines.push('| sort by ' + sf + ' ' + ir.sort.order);
    }

    if (ir.limit) {
      lines.push('| take ' + ir.limit);
    }

    if (ir.tableFields.length) {
      var tf = ir.tableFields.map(function(f) { return mapField(f, fromLang, 'kql'); });
      lines.push('| project ' + tf.join(', '));
    }

    ir.renames.forEach(function(r) {
      lines.push('| project-rename ' + r.newField + ' = ' + r.oldField);
    });

    ir.rawUnsupported.forEach(function(u) {
      lines.push('// UNSUPPORTED: ' + u);
    });

    return lines.join('\n');
  }

  function emitESQL(ir, fromLang) {
    var lines = [];

    var source = ir.index || 'logs-*';
    lines.push('FROM ' + source);

    ir.conditions.forEach(function(c) {
      var f = mapField(c.field, fromLang, 'esql');
      var v = c.value;
      var isNum = /^\d+$/.test(v);

      if (c.op === 'eq') lines.push('| WHERE ' + f + ' == ' + (isNum ? v : '"' + v + '"'));
      else if (c.op === 'neq') lines.push('| WHERE ' + f + ' != ' + (isNum ? v : '"' + v + '"'));
      else if (c.op === 'gt') lines.push('| WHERE ' + f + ' > ' + v);
      else if (c.op === 'lt') lines.push('| WHERE ' + f + ' < ' + v);
      else if (c.op === 'gte') lines.push('| WHERE ' + f + ' >= ' + v);
      else if (c.op === 'lte') lines.push('| WHERE ' + f + ' <= ' + v);
      else if (c.op === 'contains') lines.push('| WHERE ' + f + ' LIKE "*' + v + '*"');
      else if (c.op === 'startswith') lines.push('| WHERE ' + f + ' LIKE "' + v + '*"');
      else if (c.op === 'endswith') lines.push('| WHERE ' + f + ' LIKE "*' + v + '"');
      else if (c.op === 'wildcard') lines.push('| WHERE ' + f + ' LIKE "' + v + '"');
      else if (c.op === 'regex') lines.push('| WHERE ' + f + ' RLIKE "' + v + '"');
    });

    ir.evals.forEach(function(e) {
      lines.push('| EVAL ' + e.newField + ' = ' + e.expr);
    });

    ir.aggregations.forEach(function(a) {
      var funcStr;
      var alias = a.alias || a.func;
      if (a.func === 'count') funcStr = alias + ' = COUNT(*)';
      else if (a.func === 'dc') funcStr = alias + ' = COUNT_DISTINCT(' + mapField(a.field, fromLang, 'esql') + ')';
      else funcStr = alias + ' = ' + a.func.toUpperCase() + '(' + mapField(a.field, fromLang, 'esql') + ')';

      if (a.by && a.by.length) {
        var byFields = a.by.map(function(b) { return mapField(b, fromLang, 'esql'); });
        lines.push('| STATS ' + funcStr + ' BY ' + byFields.join(', '));
      } else {
        lines.push('| STATS ' + funcStr);
      }
    });

    if (ir.sort) {
      var sf = mapField(ir.sort.field, fromLang, 'esql');
      lines.push('| SORT ' + sf + ' ' + ir.sort.order.toUpperCase());
    }

    if (ir.limit) {
      lines.push('| LIMIT ' + ir.limit);
    }

    if (ir.tableFields.length) {
      var tf = ir.tableFields.map(function(f) { return mapField(f, fromLang, 'esql'); });
      lines.push('| KEEP ' + tf.join(', '));
    }

    ir.renames.forEach(function(r) {
      lines.push('| RENAME ' + r.oldField + ' AS ' + r.newField);
    });

    ir.rawUnsupported.forEach(function(u) {
      lines.push('// UNSUPPORTED: ' + u);
    });

    return lines.join('\n');
  }

  function emitSigma(ir, fromLang) {
    var lines = [];
    lines.push('title: Translated Detection Rule');
    lines.push('status: test');
    lines.push('description: Auto-translated from ' + getLangLabel(fromLang));
    lines.push('logsource:');

    var category = ir.sourceCategory || 'process_creation';
    lines.push('    category: ' + category);
    lines.push('    product: windows');

    lines.push('detection:');
    lines.push('    selection:');

    if (ir.conditions.length === 0) {
      lines.push('        # No conditions extracted');
    }

    ir.conditions.forEach(function(c) {
      var f = mapField(c.field, fromLang, 'sigma');
      var v = c.value;

      if (c.op === 'eq' && !c.negate) {
        lines.push('        ' + f + ': \'' + v + '\'');
      } else if (c.op === 'contains') {
        lines.push('        ' + f + '|contains: \'' + v + '\'');
      } else if (c.op === 'endswith') {
        lines.push('        ' + f + '|endswith: \'' + v + '\'');
      } else if (c.op === 'startswith') {
        lines.push('        ' + f + '|startswith: \'' + v + '\'');
      } else if (c.op === 'regex') {
        lines.push('        ' + f + '|re: \'' + v + '\'');
      } else if (c.op === 'neq') {
        // Sigma uses filter for negation
        lines.push('        # Negation: ' + f + ' != ' + v + ' (see filter block below)');
        if (!ir._hasFilter) {
          ir._hasFilter = true;
          ir._filterConditions = ir._filterConditions || [];
        }
        ir._filterConditions = ir._filterConditions || [];
        ir._filterConditions.push({ field: f, value: v });
      } else {
        // gt, lt, gte, lte — Sigma doesn't natively support comparison operators
        lines.push('        # ' + f + ' ' + c.op + ' ' + v + ' — Sigma does not support comparison operators natively');
        ir.caveats.push('Sigma does not support numeric comparisons (<code>' + c.op + '</code>) — field <code>' + escapeHTML(f) + '</code> requires post-processing or a custom backend modifier.');
      }
    });

    if (ir._hasFilter && ir._filterConditions && ir._filterConditions.length) {
      lines.push('    filter:');
      ir._filterConditions.forEach(function(fc) {
        lines.push('        ' + fc.field + ': \'' + fc.value + '\'');
      });
      lines.push('    condition: selection and not filter');
    } else {
      lines.push('    condition: selection');
    }

    // Sigma doesn't support aggregations, sort, limit natively — add as comments
    if (ir.aggregations.length) {
      lines.push('# NOTE: Aggregations cannot be expressed in Sigma YAML.');
      lines.push('# Original aggregation:');
      ir.aggregations.forEach(function(a) {
        var byStr = a.by && a.by.length ? ' by ' + a.by.join(', ') : '';
        lines.push('#   ' + a.func + '(' + a.field + ')' + byStr);
      });
      ir.caveats.push('Sigma YAML does not support aggregations, sorting, or limits. These must be handled by the Sigma backend or in a separate correlation rule.');
    }

    if (ir.sort) {
      lines.push('# Original sort: ' + ir.sort.field + ' ' + ir.sort.order);
    }
    if (ir.limit) {
      lines.push('# Original limit: ' + ir.limit);
    }

    lines.push('level: medium');

    ir.rawUnsupported.forEach(function(u) {
      lines.push('# UNSUPPORTED: ' + u);
    });

    return lines.join('\n');
  }

  function emitSumo(ir, fromLang) {
    var parts = [];
    var search = [];

    if (ir.sourceCategory) {
      search.push('_sourceCategory=' + ir.sourceCategory);
    } else if (ir.index) {
      search.push('_sourceCategory=' + ir.index);
    }

    var whereConditions = [];
    ir.conditions.forEach(function(c) {
      var f = mapField(c.field, fromLang, 'sumo');
      var v = c.value;

      if (c.op === 'eq' && !c.negate) {
        // Simple conditions can go in the search expression
        search.push(f + '=' + quoteIfNeeded(v));
      } else if (c.op === 'neq') {
        whereConditions.push(f + ' != "' + v + '"');
      } else if (c.op === 'contains') {
        whereConditions.push(f + ' contains "' + v + '"');
      } else if (c.op === 'startswith') {
        whereConditions.push(f + ' matches "' + v + '*"');
      } else if (c.op === 'endswith') {
        whereConditions.push(f + ' matches "*' + v + '"');
      } else {
        var opStr = { gt: '>', lt: '<', gte: '>=', lte: '<=' }[c.op] || '=';
        whereConditions.push(f + ' ' + opStr + ' ' + v);
      }
    });

    parts.push(search.join(' ') || '*');

    whereConditions.forEach(function(w) {
      parts.push('where ' + w);
    });

    ir.evals.forEach(function(e) {
      ir.caveats.push('Sumo Logic eval/calculated fields may need manual adjustment: <code>' + escapeHTML(e.newField + '=' + e.expr) + '</code>');
    });

    ir.aggregations.forEach(function(a) {
      if (a.func === 'count') {
        if (a.by && a.by.length) {
          var byFields = a.by.map(function(b) { return mapField(b, fromLang, 'sumo'); });
          parts.push('count by ' + byFields.join(', '));
        } else {
          parts.push('count');
        }
      } else if (a.func === 'dc') {
        var dcBy = a.by && a.by.length ? ' by ' + a.by.map(function(b) { return mapField(b, fromLang, 'sumo'); }).join(', ') : '';
        parts.push('count_distinct(' + mapField(a.field, fromLang, 'sumo') + ')' + dcBy);
      } else {
        var aggBy = a.by && a.by.length ? ' by ' + a.by.map(function(b) { return mapField(b, fromLang, 'sumo'); }).join(', ') : '';
        parts.push(a.func + '(' + mapField(a.field, fromLang, 'sumo') + ')' + aggBy);
      }
    });

    if (ir.sort) {
      var sf = mapField(ir.sort.field, fromLang, 'sumo');
      parts.push('sort by ' + sf + ' ' + ir.sort.order);
    }

    if (ir.limit) {
      parts.push('limit ' + ir.limit);
    }

    if (ir.tableFields.length) {
      var tf = ir.tableFields.map(function(f) { return mapField(f, fromLang, 'sumo'); });
      parts.push('fields ' + tf.join(', '));
    }

    ir.rawUnsupported.forEach(function(u) {
      parts.push('/* UNSUPPORTED: ' + u + ' */');
    });

    return parts.join('\n| ');
  }

  /* ─── Helpers ──────────────────────────────────────────────── */

  function splitByPipe(text) {
    // Split by | that is not inside quotes
    var segments = [];
    var current = '';
    var inDouble = false;
    var inSingle = false;

    for (var i = 0; i < text.length; i++) {
      var ch = text[i];
      if (ch === '"' && !inSingle) inDouble = !inDouble;
      else if (ch === "'" && !inDouble) inSingle = !inSingle;

      if (ch === '|' && !inDouble && !inSingle) {
        segments.push(current);
        current = '';
      } else if (ch === '\n' && !inDouble && !inSingle) {
        // Newlines outside quotes act as whitespace
        current += ' ';
      } else {
        current += ch;
      }
    }
    if (current.trim()) segments.push(current);
    return segments;
  }

  function quoteIfNeeded(val) {
    if (/\s/.test(val) || /[,|;]/.test(val)) return '"' + val + '"';
    return val;
  }

  function escapeHTML(str) {
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function getLangLabel(lang) {
    var labels = { spl: 'Splunk SPL', kql: 'KQL (Sentinel)', esql: 'ES|QL (Elastic)', sigma: 'Sigma YAML', sumo: 'Sumo Logic' };
    return labels[lang] || lang;
  }

  /* ─── Syntax Highlighting ──────────────────────────────────── */
  function highlightOutput(text, lang) {
    var escaped = escapeHTML(text);

    if (lang === 'spl') {
      // Keywords
      escaped = escaped.replace(/\b(index|sourcetype|stats|where|search|sort|head|table|eval|rename|AS|by|count|sum|avg|min|max|dc|values|list|NOT)\b/g, '<span class="sq-kw">$1</span>');
      // Pipe
      escaped = escaped.replace(/\| /g, '<span class="sq-pipe">| </span>');
      // Strings
      escaped = escaped.replace(/(&quot;[^&]*?&quot;)/g, '<span class="sq-str">$1</span>');
      // Numbers
      escaped = escaped.replace(/\b(\d+)\b/g, '<span class="sq-num">$1</span>');
      // Operators
      escaped = escaped.replace(/(!=|&gt;=|&lt;=|&gt;|&lt;|=)/g, '<span class="sq-op">$1</span>');
    } else if (lang === 'kql') {
      escaped = escaped.replace(/\b(where|summarize|sort|take|project|extend|order|limit|count|dcount|sum|avg|min|max|by|contains|endswith|startswith|matches|regex|not|and|or)\b/gi, '<span class="sq-kw">$1</span>');
      escaped = escaped.replace(/\| /g, '<span class="sq-pipe">| </span>');
      escaped = escaped.replace(/(&quot;[^&]*?&quot;)/g, '<span class="sq-str">$1</span>');
      escaped = escaped.replace(/\b(\d+)\b/g, '<span class="sq-num">$1</span>');
      escaped = escaped.replace(/(==|!=|&gt;=|&lt;=|&gt;|&lt;)/g, '<span class="sq-op">$1</span>');
    } else if (lang === 'esql') {
      escaped = escaped.replace(/\b(FROM|WHERE|STATS|SORT|LIMIT|KEEP|EVAL|RENAME|AS|BY|COUNT|COUNT_DISTINCT|SUM|AVG|MIN|MAX|LIKE|RLIKE|NOT|AND|OR|ASC|DESC)\b/g, '<span class="sq-kw">$1</span>');
      escaped = escaped.replace(/\| /g, '<span class="sq-pipe">| </span>');
      escaped = escaped.replace(/(&quot;[^&]*?&quot;)/g, '<span class="sq-str">$1</span>');
      escaped = escaped.replace(/\b(\d+)\b/g, '<span class="sq-num">$1</span>');
      escaped = escaped.replace(/(==|!=|&gt;=|&lt;=|&gt;|&lt;)/g, '<span class="sq-op">$1</span>');
    } else if (lang === 'sigma') {
      // YAML highlighting
      escaped = escaped.replace(/^(title|status|description|logsource|detection|selection\w*|filter|condition|level|category|product|service):/gm, '<span class="sq-kw">$1</span>:');
      escaped = escaped.replace(/(\|contains|\|endswith|\|startswith|\|re):/g, '<span class="sq-op">$1</span>:');
      escaped = escaped.replace(/(&#39;[^&]*?&#39;|&quot;[^&]*?&quot;)/g, '<span class="sq-str">$1</span>');
      // Use sq-str for single quotes too since we may have &apos;
      escaped = escaped.replace(/'([^']*?)'/g, '<span class="sq-str">\'$1\'</span>');
      escaped = escaped.replace(/^(#.*)$/gm, '<span class="sq-comment">$1</span>');
    } else if (lang === 'sumo') {
      escaped = escaped.replace(/\b(_sourceCategory|where|count|count_distinct|sum|avg|min|max|sort|limit|fields|by|contains|matches|and|or|not)\b/gi, '<span class="sq-kw">$1</span>');
      escaped = escaped.replace(/\| /g, '<span class="sq-pipe">| </span>');
      escaped = escaped.replace(/(&quot;[^&]*?&quot;)/g, '<span class="sq-str">$1</span>');
      escaped = escaped.replace(/\b(\d+)\b/g, '<span class="sq-num">$1</span>');
      escaped = escaped.replace(/(!=|&gt;=|&lt;=|&gt;|&lt;|=)/g, '<span class="sq-op">$1</span>');
    }

    // Highlight unsupported markers
    escaped = escaped.replace(/(\/\*\s*UNSUPPORTED:.*?\*\/|\/\/\s*UNSUPPORTED:.*)/g, '<span class="sq-unsupported">$1</span>');

    return escaped;
  }

  /* ─── Main translate function ──────────────────────────────── */
  function translate() {
    var src = srcLang.value;
    var tgt = tgtLang.value;
    var input = inputEl.value.trim();

    if (!input) {
      outputSec.style.display = 'none';
      emptyEl.style.display = '';
      return;
    }

    if (src === tgt) {
      outputSec.style.display = 'none';
      emptyEl.style.display = '';
      emptyEl.textContent = 'Source and target languages must be different.';
      return;
    }

    // Parse
    var ir;
    switch (src) {
      case 'spl':   ir = parseSPL(input);   break;
      case 'kql':   ir = parseKQL(input);   break;
      case 'esql':  ir = parseESQL(input);  break;
      case 'sigma': ir = parseSigma(input); break;
      case 'sumo':  ir = parseSumo(input);  break;
      default:      ir = createIR();
    }

    // Add structural caveats
    if (tgt === 'sigma') {
      if (ir.aggregations.length || ir.sort || ir.limit) {
        // already added by emitSigma
      }
    }
    if (src === 'sigma' && (tgt === 'spl' || tgt === 'kql' || tgt === 'esql' || tgt === 'sumo')) {
      if (!ir.conditions.length) {
        ir.caveats.push('Sigma rule had no extractable field conditions — the translated query may be incomplete. Check the original YAML structure.');
      }
    }

    // Emit
    var output;
    switch (tgt) {
      case 'spl':   output = emitSPL(ir, src);   break;
      case 'kql':   output = emitKQL(ir, src);   break;
      case 'esql':  output = emitESQL(ir, src);  break;
      case 'sigma': output = emitSigma(ir, src); break;
      case 'sumo':  output = emitSumo(ir, src);  break;
      default:      output = '// Unknown target language';
    }

    // Display
    emptyEl.style.display = 'none';
    outputSec.style.display = '';
    outputLabel.textContent = 'Translated to ' + getLangLabel(tgt);

    // Syntax highlight the output
    outputEl.innerHTML = highlightOutput(output, tgt);

    // Store raw text for copy
    outputEl.setAttribute('data-raw', output);

    // Caveats
    if (ir.caveats.length) {
      caveatsSec.style.display = '';
      while (caveatsList.firstChild) caveatsList.removeChild(caveatsList.firstChild);
      // Deduplicate
      var seen = {};
      ir.caveats.forEach(function(c) {
        if (seen[c]) return;
        seen[c] = true;
        var li = document.createElement('li');
        li.innerHTML = c;
        caveatsList.appendChild(li);
      });
    } else {
      caveatsSec.style.display = 'none';
    }
  }

  /* ─── Example queries ──────────────────────────────────────── */
  var EXAMPLES = {
    spl: 'index=auth sourcetype=syslog action=login_failed\n| stats count by src_ip, user\n| where count > 5\n| sort -count\n| head 20',
    kql: 'SecurityEvent\n| where EventID == 4688\n| where NewProcessName endswith "powershell.exe"\n| where CommandLine contains "-enc"\n| summarize count() by Computer, Account\n| sort by count_ desc',
    esql: 'FROM logs-*\n| WHERE event.code == 4688\n| WHERE process.name LIKE "*powershell.exe"\n| WHERE process.command_line LIKE "*-enc*"\n| STATS count = COUNT(*) BY host.name, user.name\n| SORT count DESC\n| LIMIT 50',
    sigma: 'title: Encoded PowerShell Execution\nstatus: test\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        EventID: \'4688\'\n        Image|endswith: \'powershell.exe\'\n        CommandLine|contains: \'-enc\'\n    condition: selection\nlevel: high',
    sumo: '_sourceCategory=syslog\n| where event_action = "login_failed"\n| count by source_ip, user\n| sort by _count desc\n| limit 20'
  };

  /* ─── Event handlers ───────────────────────────────────────── */
  translateBtn.addEventListener('click', translate);

  swapBtn.addEventListener('click', function() {
    var tmp = srcLang.value;
    srcLang.value = tgtLang.value;
    tgtLang.value = tmp;
    // If there's output, re-translate
    if (inputEl.value.trim()) translate();
  });

  exampleBtn.addEventListener('click', function() {
    inputEl.value = EXAMPLES[srcLang.value] || EXAMPLES.spl;
    translate();
  });

  clearBtn.addEventListener('click', function() {
    inputEl.value = '';
    outputSec.style.display = 'none';
    caveatsSec.style.display = 'none';
    emptyEl.style.display = '';
    emptyEl.textContent = 'Select your source and target languages, paste a query, and click "Translate".';
  });

  copyBtn.addEventListener('click', function() {
    var raw = outputEl.getAttribute('data-raw') || outputEl.textContent;
    navigator.clipboard.writeText(raw).then(function() {
      var origText = copyBtn.innerHTML;
      copyBtn.textContent = 'Copied!';
      setTimeout(function() { copyBtn.innerHTML = origText; }, 1500);
    });
  });

  // Keyboard shortcut: Ctrl/Cmd + Enter to translate
  inputEl.addEventListener('keydown', function(e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      translate();
    }
  });

  // Ensure source != target
  srcLang.addEventListener('change', function() {
    if (srcLang.value === tgtLang.value) {
      // Pick next available
      var opts = ['spl','kql','esql','sigma','sumo'];
      for (var i = 0; i < opts.length; i++) {
        if (opts[i] !== srcLang.value) { tgtLang.value = opts[i]; break; }
      }
    }
  });
  tgtLang.addEventListener('change', function() {
    if (tgtLang.value === srcLang.value) {
      var opts = ['spl','kql','esql','sigma','sumo'];
      for (var i = 0; i < opts.length; i++) {
        if (opts[i] !== tgtLang.value) { srcLang.value = opts[i]; break; }
      }
    }
  });

})();
</script>
