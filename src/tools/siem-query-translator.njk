---
toolSlug: siem-query-translator
permalink: /tools/siem-query-translator/
---

<div class="tool-group">
  <div class="sq-lang-row">
    <div class="sq-lang-col">
      <label for="sq-source-lang">Source Language</label>
      <select id="sq-source-lang">
        <option value="spl">Splunk SPL</option>
        <option value="kql">KQL (Sentinel)</option>
        <option value="esql">ES|QL (Elastic)</option>
        <option value="sigma">Sigma YAML</option>
        <option value="sumo">Sumo Logic</option>
      </select>
    </div>
    <button class="btn sq-swap-btn" id="sq-swap-btn" title="Swap languages">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
      Swap
    </button>
    <div class="sq-lang-col">
      <label for="sq-target-lang">Target Language</label>
      <select id="sq-target-lang">
        <option value="kql">KQL (Sentinel)</option>
        <option value="spl">Splunk SPL</option>
        <option value="esql">ES|QL (Elastic)</option>
        <option value="sigma">Sigma YAML</option>
        <option value="sumo">Sumo Logic</option>
      </select>
    </div>
  </div>
</div>

<div class="tool-group">
  <label for="sq-input">Paste your query</label>
  <textarea id="sq-input" rows="10" placeholder="Paste a detection query in the selected source language..." spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
</div>

<div class="tool-row">
  <button class="btn btn--primary" id="sq-translate-btn">Translate</button>
  <button class="btn" id="sq-example-btn">Try Example</button>
  <button class="btn" id="sq-clear-btn">Clear</button>
</div>

<div id="sq-output-section" style="display:none;">
  <div class="tool-group">
    <div class="sq-output-header">
      <label id="sq-output-label">Translated Query</label>
      <button class="btn sq-copy-btn" id="sq-copy-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        Copy
      </button>
    </div>
    <pre id="sq-output" class="sq-code-block"></pre>
  </div>

  <div id="sq-caveats-section" style="display:none;">
    <div class="sq-caveats">
      <div class="sq-caveats-title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        Conversion Notes
      </div>
      <ul id="sq-caveats-list"></ul>
    </div>
  </div>

  <div id="sq-field-map-section">
    <div class="sq-field-map-title">Field Mapping Reference</div>
    <div class="sq-table-wrap">
      <table class="sq-field-table" id="sq-field-table">
        <thead>
          <tr>
            <th>Concept</th>
            <th>Splunk SPL</th>
            <th>KQL (Sentinel)</th>
            <th>ES|QL</th>
            <th>Sigma</th>
            <th>Sumo Logic</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Source IP</td><td>src_ip</td><td>SourceIP</td><td>source.ip</td><td>src_ip</td><td>source_ip</td></tr>
          <tr><td>Dest IP</td><td>dest_ip</td><td>DestinationIP</td><td>destination.ip</td><td>dst_ip</td><td>dest_ip</td></tr>
          <tr><td>Username</td><td>user</td><td>Account</td><td>user.name</td><td>user</td><td>user</td></tr>
          <tr><td>Hostname</td><td>host</td><td>Computer</td><td>host.name</td><td>ComputerName</td><td>_sourceHost</td></tr>
          <tr><td>Action</td><td>action</td><td>EventAction</td><td>event.action</td><td>action</td><td>event_action</td></tr>
          <tr><td>Event ID</td><td>EventCode</td><td>EventID</td><td>event.code</td><td>EventID</td><td>event_id</td></tr>
          <tr><td>Process Name</td><td>process_name</td><td>NewProcessName</td><td>process.name</td><td>Image</td><td>process_name</td></tr>
          <tr><td>Command Line</td><td>process</td><td>CommandLine</td><td>process.command_line</td><td>CommandLine</td><td>command_line</td></tr>
          <tr><td>Severity</td><td>severity</td><td>EventSeverity</td><td>event.severity</td><td>level</td><td>severity</td></tr>
          <tr><td>Count</td><td>count</td><td>count_</td><td>count</td><td>&mdash;</td><td>_count</td></tr>
          <tr><td>Wildcard</td><td>field=*val*</td><td>field contains</td><td>field LIKE</td><td>field|contains</td><td>field contains</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div id="sq-empty" class="sq-empty-msg">Select your source and target languages, paste a query, and click "Translate".</div>

<style>
