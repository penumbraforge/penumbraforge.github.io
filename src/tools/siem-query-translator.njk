<script>
(function () {
  'use strict';

  /* ─── DOM refs ──────────────────────────────────────────────── */
  var srcLang    = document.getElementById('sq-source-lang');
  var tgtLang    = document.getElementById('sq-target-lang');
  var swapBtn    = document.getElementById('sq-swap-btn');
  var inputEl    = document.getElementById('sq-input');
  var translateBtn = document.getElementById('sq-translate-btn');
  var exampleBtn = document.getElementById('sq-example-btn');
  var clearBtn   = document.getElementById('sq-clear-btn');
  var outputSec  = document.getElementById('sq-output-section');
  var outputEl   = document.getElementById('sq-output');
  var outputLabel= document.getElementById('sq-output-label');
  var copyBtn    = document.getElementById('sq-copy-btn');
  var caveatsSec = document.getElementById('sq-caveats-section');
  var caveatsList= document.getElementById('sq-caveats-list');
  var emptyEl    = document.getElementById('sq-empty');

  /* ─── Field mapping ─────────────────────────────────────────── */
  var FIELD_MAP = {
    // concept: { spl, kql, esql, sigma, sumo }
    'source_ip':    { spl: 'src_ip',       kql: 'SourceIP',        esql: 'source.ip',            sigma: 'src_ip',       sumo: 'source_ip' },
    'dest_ip':      { spl: 'dest_ip',      kql: 'DestinationIP',   esql: 'destination.ip',       sigma: 'dst_ip',       sumo: 'dest_ip' },
    'username':     { spl: 'user',         kql: 'Account',         esql: 'user.name',            sigma: 'user',         sumo: 'user' },
    'hostname':     { spl: 'host',         kql: 'Computer',        esql: 'host.name',            sigma: 'ComputerName', sumo: '_sourceHost' },
    'action':       { spl: 'action',       kql: 'EventAction',     esql: 'event.action',         sigma: 'action',       sumo: 'event_action' },
    'event_id':     { spl: 'EventCode',    kql: 'EventID',         esql: 'event.code',           sigma: 'EventID',      sumo: 'event_id' },
    'process_name': { spl: 'process_name', kql: 'NewProcessName',  esql: 'process.name',         sigma: 'Image',        sumo: 'process_name' },
    'command_line': { spl: 'process',      kql: 'CommandLine',     esql: 'process.command_line',  sigma: 'CommandLine',  sumo: 'command_line' },
    'severity':     { spl: 'severity',     kql: 'EventSeverity',   esql: 'event.severity',       sigma: 'level',        sumo: 'severity' },
    'source_category': { spl: 'sourcetype', kql: 'Category',      esql: 'event.category',       sigma: 'category',     sumo: '_sourceCategory' }
  };

  /* Build reverse maps: from a given language's field name -> concept key */
  var REVERSE_MAP = {};
  ['spl','kql','esql','sigma','sumo'].forEach(function(lang) {
    REVERSE_MAP[lang] = {};
    Object.keys(FIELD_MAP).forEach(function(concept) {
      var fieldName = FIELD_MAP[concept][lang];
      if (fieldName) REVERSE_MAP[lang][fieldName.toLowerCase()] = concept;
    });
  });

  function mapField(fieldName, fromLang, toLang) {
    var lower = fieldName.toLowerCase();
    var concept = REVERSE_MAP[fromLang] && REVERSE_MAP[fromLang][lower];
    if (concept && FIELD_MAP[concept][toLang]) {
      return FIELD_MAP[concept][toLang];
    }
    return fieldName; // pass through unmapped
  }

  /* ─── Intermediate Representation ──────────────────────────── */
  function createIR() {
    return {
      source: '',
      table: '',
      index: '',
      sourceCategory: '',
      conditions: [],     // { field, op, value, negate }
      aggregations: [],   // { func, field, by }
      evals: [],          // { newField, expr }
      renames: [],        // { oldField, newField }
      tableFields: [],    // fields to display
      sort: null,         // { field, order }
      limit: null,
      logic: 'AND',
      rawUnsupported: [], // lines that couldn't be parsed
      caveats: []
    };
  }

  /* ─── SPL Parser ───────────────────────────────────────────── */
  function parseSPL(text) {
    var ir = createIR();
    ir.source = text.trim();

    // Split by pipe, but respect quoted strings
    var segments = splitByPipe(text);

    segments.forEach(function(seg, idx) {
      seg = seg.trim();
      if (!seg) return;

      if (idx === 0) {
        // First segment: index/sourcetype + field=value conditions
        parseSPLSearch(seg, ir);
        return;
      }

      var lower = seg.toLowerCase();

      // stats
      var statsMatch = seg.match(/^stats\s+(count|sum|avg|min|max|dc|values|list)(?:\(([^)]*)\))?\s+(?:by|BY)\s+(.+)/i);
      if (statsMatch) {
        var func = statsMatch[1].toLowerCase();
        var aggField = statsMatch[2] || '*';
        var byFields = statsMatch[3].split(/\s*,\s*/);
        ir.aggregations.push({ func: func, field: aggField.trim(), by: byFields.map(function(b){return b.trim();}) });
        return;
      }

      // stats count without by
      var statsNoBy = seg.match(/^stats\s+(count|sum|avg|min|max|dc)(?:\(([^)]*)\))?$/i);
      if (statsNoBy) {
        ir.aggregations.push({ func: statsNoBy[1].toLowerCase(), field: statsNoBy[2] ? statsNoBy[2].trim() : '*', by: [] });
        return;
      }

      // where
      var whereMatch = seg.match(/^where\s+(.+)/i);
      if (whereMatch) {
        parseSPLWhere(whereMatch[1].trim(), ir);
        return;
      }

      // search
      var searchMatch = seg.match(/^search\s+(.+)/i);
      if (searchMatch) {
        parseSPLSearch(searchMatch[1].trim(), ir);
        return;
      }

      // sort
      var sortMatch = seg.match(/^sort\s+(-|\+)?(.+)/i);
      if (sortMatch) {
        var sortOrder = sortMatch[1] === '-' ? 'desc' : 'asc';
        var sortField = sortMatch[2].trim().split(/\s*,\s*/)[0].replace(/^[+-]/, '');
        ir.sort = { field: sortField, order: sortOrder };
        return;
      }

      // head / limit
      var headMatch = seg.match(/^head\s+(\d+)/i);
      if (headMatch) {
        ir.limit = parseInt(headMatch[1], 10);
        return;
      }

      // table
      var tableMatch = seg.match(/^table\s+(.+)/i);
      if (tableMatch) {
        ir.tableFields = tableMatch[1].split(/\s*,\s*/).map(function(f){return f.trim();});
        return;
      }

      // eval
      var evalMatch = seg.match(/^eval\s+(\w+)\s*=\s*(.+)/i);
      if (evalMatch) {
        ir.evals.push({ newField: evalMatch[1], expr: evalMatch[2].trim() });
        ir.caveats.push('SPL <code>eval</code> expression <code>' + escapeHTML(evalMatch[1] + '=' + evalMatch[2].trim()) + '</code> may need manual translation — computed fields vary across SIEM platforms.');
        return;
      }

      // rename
      var renameMatch = seg.match(/^rename\s+(\S+)\s+(?:as|AS)\s+(\S+)/i);
      if (renameMatch) {
        ir.renames.push({ oldField: renameMatch[1], newField: renameMatch[2] });
        return;
      }

      // Unrecognized
      ir.rawUnsupported.push(seg);
      ir.caveats.push('Unsupported SPL command: <code>' + escapeHTML(seg.split(/\s/)[0]) + '</code> — manual review needed.');
    });

    return ir;
  }

  function parseSPLSearch(text, ir) {
    // Extract index=X and sourcetype=Y
    var indexMatch = text.match(/index\s*=\s*("([^"]+)"|(\S+))/i);
    if (indexMatch) ir.index = indexMatch[2] || indexMatch[3];

    var stMatch = text.match(/sourcetype\s*=\s*("([^"]+)"|(\S+))/i);
    if (stMatch) ir.sourceCategory = stMatch[2] || stMatch[3];

    // Extract field=value pairs (handling quoted values)
    var remaining = text
      .replace(/index\s*=\s*("([^"]+)"|\S+)/gi, '')
      .replace(/sourcetype\s*=\s*("([^"]+)"|\S+)/gi, '')
      .trim();

    // Parse remaining key=value or key!=value or key="value" with wildcards
    var kvRegex = /(\w[\w.]*)\s*(!=|=)\s*("([^"]+)"|(\S+))/g;
    var m;
    while ((m = kvRegex.exec(remaining)) !== null) {
      var field = m[1];
      var operator = m[2];
      var value = m[4] !== undefined ? m[4] : m[5];
      var negate = operator === '!=';

      var op = 'eq';
      // Check for wildcard patterns
      if (value.indexOf('*') !== -1) {
        if (value.charAt(0) === '*' && value.charAt(value.length - 1) === '*') {
          op = 'contains';
          value = value.replace(/^\*|\*$/g, '');
        } else if (value.charAt(0) === '*') {
          op = 'endswith';
          value = value.replace(/^\*/, '');
        } else if (value.charAt(value.length - 1) === '*') {
          op = 'startswith';
          value = value.replace(/\*$/, '');
        } else {
          op = 'wildcard';
          // keep value as-is
        }
      }

      ir.conditions.push({ field: field, op: op, value: value, negate: negate });
    }
  }

  function parseSPLWhere(text, ir) {
    // Handle: field > N, field < N, field >= N, field <= N, field = "val", field != "val"
    // Also handle: field LIKE "%val%", NOT prefix
    var negate = false;
    var cleaned = text.trim();
    if (/^NOT\s+/i.test(cleaned)) {
      negate = true;
      cleaned = cleaned.replace(/^NOT\s+/i, '');
    }

    var compMatch = cleaned.match(/^(\w[\w.]*)\s*(>=|<=|!=|>|<|=|==)\s*("([^"]+)"|'([^']+)'|(\S+))/);
    if (compMatch) {
      var field = compMatch[1];
      var rawOp = compMatch[2];
      var value = compMatch[4] !== undefined ? compMatch[4] : (compMatch[5] !== undefined ? compMatch[5] : compMatch[6]);

      var opMap = { '=': 'eq', '==': 'eq', '!=': 'neq', '>': 'gt', '<': 'lt', '>=': 'gte', '<=': 'lte' };
      var op = opMap[rawOp] || 'eq';
      if (negate && op === 'eq') op = 'neq';
      else if (negate && op === 'neq') op = 'eq';

      ir.conditions.push({ field: field, op: op, value: value, negate: false });
      return;
    }

    // Handle: field LIKE "%val%"
    var likeMatch = cleaned.match(/^(\w[\w.]*)\s+LIKE\s+"([^"]+)"/i);
    if (likeMatch) {
      var lv = likeMatch[2];
      var lop = 'contains';
      if (lv.charAt(0) === '%' && lv.charAt(lv.length - 1) === '%') {
        lv = lv.replace(/^%|%$/g, '');
        lop = 'contains';
      }
      ir.conditions.push({ field: likeMatch[1], op: lop, value: lv, negate: negate });
      return;
    }

    // Fallback — treat as unsupported
    ir.rawUnsupported.push('where ' + text);
