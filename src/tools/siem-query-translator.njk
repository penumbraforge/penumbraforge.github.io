    whereConditions.forEach(function(w) {
      parts.push('where ' + w);
    });

    ir.evals.forEach(function(e) {
      parts.push('eval ' + e.newField + '=' + e.expr);
    });

    ir.renames.forEach(function(r) {
      parts.push('rename ' + r.oldField + ' AS ' + r.newField);
