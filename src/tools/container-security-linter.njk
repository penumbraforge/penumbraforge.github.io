---
toolSlug: container-security-linter
permalink: /tools/container-security-linter/
---

<div class="tool-group">
  <div class="csl-type-bar" id="csl-type-bar">
    <span class="csl-type-label" id="csl-type-label">Paste a Kubernetes YAML, Dockerfile, or docker-compose.yml</span>
  </div>
  <textarea id="csl-input" rows="16" placeholder="apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-app
spec:
  ..." spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
</div>

<div class="tool-row">
  <button class="btn btn--primary" id="csl-lint-btn">Lint</button>
  <button class="btn" id="csl-example-btn">Try Example</button>
  <button class="btn" id="csl-clear-btn">Clear</button>
  <div id="csl-summary" style="margin-left:auto;font-size:0.875rem;color:var(--text-3,#888);align-self:center;"></div>
</div>

<div id="csl-score-area" style="display:none;">
  <div class="csl-score-card">
    <div class="csl-score-ring" id="csl-score-ring">
      <svg viewBox="0 0 120 120" width="100" height="100">
        <circle cx="60" cy="60" r="52" fill="none" stroke="var(--border,#2a2a3a)" stroke-width="8"/>
        <circle id="csl-score-circle" cx="60" cy="60" r="52" fill="none" stroke="#4ade80" stroke-width="8"
                stroke-linecap="round" stroke-dasharray="327" stroke-dashoffset="327"
                transform="rotate(-90 60 60)"/>
        <text x="60" y="60" text-anchor="middle" dominant-baseline="central"
              font-size="28" font-weight="700" fill="var(--text-1,#e2e8f0)" id="csl-score-text">0</text>
        <text x="60" y="80" text-anchor="middle" font-size="12" fill="var(--text-3,#888)" id="csl-score-grade"></text>
      </svg>
    </div>
    <div class="csl-score-breakdown">
      <div class="csl-score-meta" id="csl-score-meta"></div>
      <button class="btn btn--primary" id="csl-fix-btn" style="display:none;">Generate Fixed Version</button>
    </div>
  </div>
</div>

<div id="csl-results" style="display:none;">
  <div id="csl-findings"></div>
</div>

<div id="csl-fixed-area" style="display:none;">
  <div class="csl-fixed-header">
    <strong>Fixed Version</strong>
    <button class="btn btn--copy" id="csl-fixed-copy">Copy</button>
  </div>
  <pre id="csl-fixed-output" class="csl-fixed-pre"></pre>
</div>

<div id="csl-clean" style="display:none;" class="csl-clean-msg">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
  No security issues found. Your configuration looks solid.
</div>

<div id="csl-empty" class="csl-empty-msg">Paste a Kubernetes manifest, Dockerfile, or docker-compose.yml above and click "Lint".</div>

<style>
  .csl-type-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-3,#888);
  }
  .csl-type-label { font-weight: 600; }
  .csl-type-detected { color: #818cf8; }

  .csl-score-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem;
    background: var(--surface-1,#1a1a2e);
    border: 1px solid var(--border,#2a2a3a);
    border-radius: 8px;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .csl-score-breakdown { flex: 1; min-width: 200px; }
  .csl-score-meta {
    font-size: 0.875rem;
    color: var(--text-2,#94a3b8);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .csl-score-meta strong { color: var(--text-1,#e2e8f0); }

  .csl-finding {
    border: 1px solid var(--border,#2a2a3a);
    border-radius: 8px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }
  .csl-finding--critical { border-left: 3px solid #dc2626; }
  .csl-finding--high { border-left: 3px solid #ef4444; }
  .csl-finding--medium { border-left: 3px solid #f97316; }
  .csl-finding--low { border-left: 3px solid #eab308; }

  .csl-finding-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.875rem;
    background: var(--surface-1,#1a1a2e);
    flex-wrap: wrap;
    cursor: pointer;
    user-select: none;
  }
  .csl-finding-type { font-size: 0.875rem; font-weight: 700; color: var(--text-1,#e2e8f0); flex: 1; min-width: 0; }
  .csl-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }
  .csl-badge--critical { background: rgba(220,38,38,0.18); color: #f87171; border: 1px solid rgba(220,38,38,0.35); }
  .csl-badge--high { background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.3); }
  .csl-badge--medium { background: rgba(249,115,22,0.12); color: #fb923c; border: 1px solid rgba(249,115,22,0.3); }
  .csl-badge--low { background: rgba(234,179,8,0.1); color: #fbbf24; border: 1px solid rgba(234,179,8,0.3); }
  .csl-line-num {
    font-size: 0.75rem;
    font-family: var(--font-mono,monospace);
    color: var(--text-3,#888);
    flex-shrink: 0;
  }

  .csl-finding-body { padding: 0.75rem 0.875rem; }
  .csl-match-pre {
    font-size: 0.8125rem;
    font-family: var(--font-mono,monospace);
    background: var(--surface-0,#0f0f1a);
    border-radius: 4px;
    padding: 0.5rem 0.75rem;
    margin: 0 0 0.6rem;
    white-space: pre-wrap;
    word-break: break-all;
    color: var(--text-1,#e2e8f0);
    border: 1px solid var(--border,#2a2a3a);
  }
  .csl-explanation {
    font-size: 0.8125rem;
    color: var(--text-2,#94a3b8);
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }
  .csl-explanation strong { color: var(--text-1,#e2e8f0); }
  .csl-fix-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #4ade80;
    margin-bottom: 0.25rem;
  }
  .csl-fix-pre {
    font-size: 0.8125rem;
    font-family: var(--font-mono,monospace);
    background: rgba(34,197,94,0.06);
    border: 1px solid rgba(34,197,94,0.2);
    border-radius: 4px;
    padding: 0.5rem 0.75rem;
    margin: 0;
    white-space: pre-wrap;
    word-break: break-all;
    color: #86efac;
  }

  .csl-fixed-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    color: var(--text-1,#e2e8f0);
  }
  .csl-fixed-pre {
    font-size: 0.8125rem;
    font-family: var(--font-mono,monospace);
    background: var(--surface-0,#0f0f1a);
    border: 1px solid var(--border,#2a2a3a);
    border-radius: 8px;
    padding: 1rem;
    white-space: pre-wrap;
    word-break: break-all;
    color: var(--text-1,#e2e8f0);
    max-height: 600px;
    overflow: auto;
  }
  .csl-clean-msg {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    background: rgba(34,197,94,0.07);
    border: 1px solid rgba(34,197,94,0.2);
    border-radius: 8px;
    color: #4ade80;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .csl-empty-msg { text-align: center; padding: 2.5rem; color: var(--text-3,#888); font-size: 0.9rem; }

  @media (max-width: 640px) {
    .csl-score-card {
      flex-direction: column;
      gap: 0.75rem;
      padding: 1rem;
      align-items: flex-start;
    }
    .csl-score-breakdown {
      min-width: 0;
      width: 100%;
    }
    .csl-finding-header {
      padding: 0.5rem 0.625rem;
      min-height: 44px;
      gap: 0.5rem;
    }
    .csl-finding-body {
      padding: 0.6rem 0.625rem;
    }
    .csl-match-pre {
      font-size: 0.75rem;
      padding: 0.4rem 0.6rem;
      overflow-x: auto;
    }
    .csl-fix-pre {
      font-size: 0.75rem;
      padding: 0.4rem 0.6rem;
      overflow-x: auto;
    }
    .csl-fixed-pre {
      font-size: 0.75rem;
      padding: 0.75rem;
      overflow-x: auto;
    }
    .csl-fixed-header {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .csl-empty-msg {
      padding: 1.5rem;
    }
  }
</style>

<script>
(function () {
  /* ── DOM refs ── */
  var inputEl    = document.getElementById('csl-input');
  var lintBtn    = document.getElementById('csl-lint-btn');
  var exampleBtn = document.getElementById('csl-example-btn');
  var clearBtn   = document.getElementById('csl-clear-btn');
  var summaryEl  = document.getElementById('csl-summary');
  var typeLabel  = document.getElementById('csl-type-label');
  var scoreArea  = document.getElementById('csl-score-area');
  var scoreCircle= document.getElementById('csl-score-circle');
  var scoreText  = document.getElementById('csl-score-text');
  var scoreGrade = document.getElementById('csl-score-grade');
  var scoreMeta  = document.getElementById('csl-score-meta');
  var fixBtn     = document.getElementById('csl-fix-btn');
  var resultsEl  = document.getElementById('csl-results');
  var findingsEl = document.getElementById('csl-findings');
  var cleanEl    = document.getElementById('csl-clean');
  var emptyEl    = document.getElementById('csl-empty');
  var fixedArea  = document.getElementById('csl-fixed-area');
  var fixedOut   = document.getElementById('csl-fixed-output');
  var fixedCopy  = document.getElementById('csl-fixed-copy');

  /* ── Type detection ── */
  function detectType(text) {
    var t = text.trim();
    if (/^(FROM|ARG)\s/m.test(t)) return 'dockerfile';
    if (/^(version\s*:|services\s*:)/m.test(t) && /services\s*:/m.test(t)) return 'compose';
    if (/apiVersion\s*:/m.test(t) || /kind\s*:/m.test(t)) return 'kubernetes';
    if (/^(FROM|COPY|RUN|CMD|ENTRYPOINT|EXPOSE|ENV|WORKDIR|ADD|LABEL|HEALTHCHECK|USER|ONBUILD|SHELL|STOPSIGNAL)\s/m.test(t)) return 'dockerfile';
    return 'unknown';
  }

  /* ── Minimal YAML parser (line-based, handles indentation) ── */
  function getIndent(line) { var m = line.match(/^(\s*)/); return m ? m[1].length : 0; }

  /* ── Example insecure K8s deployment ── */
  var EXAMPLE = [
    'apiVersion: apps/v1',
    'kind: Deployment',
    'metadata:',
    '  name: insecure-app',
    '  namespace: default',
    'spec:',
    '  replicas: 3',
    '  selector:',
    '    matchLabels:',
    '      app: insecure-app',
    '  template:',
    '    metadata:',
    '      labels:',
    '        app: insecure-app',
    '    spec:',
    '      hostNetwork: true',
    '      hostPID: true',
    '      automountServiceAccountToken: true',
    '      containers:',
    '        - name: web',
    '          image: nginx',
    '          ports:',
    '            - containerPort: 80',
    '          env:',
    '            - name: DB_PASSWORD',
    '              value: "supersecret123"',
    '            - name: API_KEY',
    '              value: "sk-prod-abc123xyz"',
    '          securityContext:',
    '            privileged: true',
    '            capabilities:',
    '              add:',
    '                - SYS_ADMIN',
    '                - NET_ADMIN',
    '          volumeMounts:',
    '            - name: host-fs',
    '              mountPath: /host',
    '        - name: sidecar',
    '          image: redis:latest',
    '      volumes:',
    '        - name: host-fs',
    '          hostPath:',
    '            path: /'
  ].join('\n');

  /* ═══════════════════════════════════════════════════════════════
     KUBERNETES RULES
     ═══════════════════════════════════════════════════════════════ */
  var K8S_RULES = [
    /* ── CRITICAL ── */
    {
      id: 'k8s-privileged',
      name: 'Privileged container',
      severity: 'critical',
      test: function (lines) {
        var r = [];
        lines.forEach(function (l, i) {
          if (/^\s*privileged\s*:\s*true/i.test(l))
            r.push({ line: i + 1, text: l, explanation: 'A privileged container has full access to the host kernel. An attacker inside can escape to the host trivially.', fix: '            privileged: false' });
        });
        return r;
      }
    },
    {
      id: 'k8s-hostpid',
      name: 'Host PID namespace enabled',
      severity: 'critical',
      test: function (lines) {
        var r = [];
        lines.forEach(function (l, i) {
          if (/^\s*hostPID\s*:\s*true/i.test(l))
            r.push({ line: i + 1, text: l, explanation: 'Sharing the host PID namespace lets the container see and signal all host processes, enabling container escape.', fix: '      hostPID: false' });
        });
        return r;
      }
    },
    {
      id: 'k8s-hostnetwork',
      name: 'Host network enabled',
      severity: 'critical',
      test: function (lines) {
        var r = [];
        lines.forEach(function (l, i) {
          if (/^\s*hostNetwork\s*:\s*true/i.test(l))
            r.push({ line: i + 1, text: l, explanation: 'Host networking bypasses network isolation. The container can sniff traffic and bind to any host port.', fix: '      hostNetwork: false' });
        });
        return r;
      }
    },
    {
      id: 'k8s-dangerous-caps',
      name: 'Dangerous capability added',
      severity: 'critical',
      test: function (lines) {
        var dangerous = ['SYS_ADMIN', 'NET_ADMIN', 'SYS_PTRACE', 'DAC_OVERRIDE', 'NET_RAW', 'SYS_MODULE', 'SYS_RAWIO', 'MKNOD', 'AUDIT_WRITE'];
        var inAdd = false;
        var r = [];
        lines.forEach(function (l, i) {
          if (/^\s*add\s*:/i.test(l)) { inAdd = true; return; }
          if (inAdd && /^\s*-\s/.test(l)) {
            var cap = l.replace(/^\s*-\s*["']?/, '').replace(/["']?\s*$/, '').trim();
            if (dangerous.indexOf(cap) !== -1)
              r.push({ line: i + 1, text: l, explanation: cap + ' grants near-root capabilities and is frequently abused for container escape.', fix: '                # Remove ' + cap + ' — drop ALL instead' });
          } else if (inAdd && !/^\s*#/.test(l) && l.trim() !== '') {
            inAdd = false;
          }
        });
        return r;
      }
    },

    /* ── HIGH ── */
    {
      id: 'k8s-run-as-root',
      name: 'Container may run as root',
      severity: 'high',
      test: function (lines) {
        var text = lines.join('\n');
        var hasRunAsNonRoot = /runAsNonRoot\s*:\s*true/i.test(text);
        var hasRunAsUser = /runAsUser\s*:\s*[1-9]/i.test(text);
        if (!hasRunAsNonRoot && !hasRunAsUser) {
          var containerLine = -1;
          lines.forEach(function (l, i) { if (/^\s*containers\s*:/.test(l) && containerLine === -1) containerLine = i; });
          if (containerLine !== -1)
            return [{ line: containerLine + 1, text: lines[containerLine], explanation: 'No runAsNonRoot or runAsUser is set. Containers will default to running as root (UID 0), which vastly increases the impact of any exploit.', fix: '          securityContext:\n            runAsNonRoot: true\n            runAsUser: 1000' }];
        }
        return [];
      }
    },
    {
      id: 'k8s-no-resource-limits',
      name: 'No resource limits set',
      severity: 'high',
      test: function (lines) {
        var text = lines.join('\n');
        if (!/resources\s*:/i.test(text) || !/limits\s*:/i.test(text)) {
          var containerLine = -1;
          lines.forEach(function (l, i) { if (/^\s*-\s*name\s*:/.test(l) && containerLine === -1) containerLine = i; });
          if (containerLine !== -1)
            return [{ line: containerLine + 1, text: lines[containerLine], explanation: 'Without resource limits, a compromised container can consume all host CPU/memory, causing denial of service across the node.', fix: '          resources:\n            limits:\n              cpu: "500m"\n              memory: "256Mi"\n            requests:\n              cpu: "100m"\n              memory: "128Mi"' }];
        }
        return [];
      }
    },
    {
      id: 'k8s-no-resource-requests',
      name: 'No resource requests set',
      severity: 'high',
      test: function (lines) {
        var text = lines.join('\n');
        if (/resources\s*:/i.test(text) && /limits\s*:/i.test(text) && !/requests\s*:/i.test(text)) {
          var resourceLine = -1;
          lines.forEach(function (l, i) { if (/^\s*resources\s*:/.test(l) && resourceLine === -1) resourceLine = i; });
          if (resourceLine !== -1)
            return [{ line: resourceLine + 1, text: lines[resourceLine], explanation: 'Resource requests ensure the scheduler places the pod appropriately. Without them, pods may be scheduled on over-committed nodes.', fix: '            requests:\n              cpu: "100m"\n              memory: "128Mi"' }];
        }
        return [];
      }
    },
    {
      id: 'k8s-hostpath',
      name: 'HostPath volume mount',
      severity: 'high',
      test: function (lines) {
        var r = [];
        lines.forEach(function (l, i) {
          if (/^\s*hostPath\s*:/i.test(l))
            r.push({ line: i + 1, text: l, explanation: 'HostPath mounts expose the host filesystem to the container. A compromised container can read/write host files, steal credentials, or tamper with binaries.', fix: '          # Replace hostPath with emptyDir, PVC, or configMap\n          emptyDir: {}' });
        });
        return r;
      }
    },
    {
      id: 'k8s-secrets-in-env',
      name: 'Secret as plain env value',
      severity: 'high',
      test: function (lines) {
        var secretPatterns = /(?:password|secret|key|token|api_key|db_pass|credentials|auth)/i;
        var r = [];
        for (var i = 0; i < lines.length; i++) {
          if (/^\s*-\s*name\s*:/.test(lines[i])) {
            var envName = lines[i].replace(/^\s*-\s*name\s*:\s*["']?/, '').replace(/["']?\s*$/, '').trim();
            if (secretPatterns.test(envName) && i + 1 < lines.length && /^\s*value\s*:/.test(lines[i + 1])) {
              r.push({ line: i + 2, text: lines[i] + '\n' + lines[i + 1], explanation: 'Secret "' + envName + '" is set as a plain text value. Anyone with pod read access can see it. Use a Kubernetes Secret with secretKeyRef instead.', fix: '            - name: ' + envName + '\n              valueFrom:\n                secretKeyRef:\n                  name: my-secret\n                  key: ' + envName.toLowerCase() });
            }
          }
        }
        return r;
      }
    },
    {
      id: 'k8s-image-latest',
      name: 'Image uses :latest or no tag',
      severity: 'high',
      test: function (lines) {
        var r = [];
        lines.forEach(function (l, i) {
          if (/^\s*image\s*:/.test(l)) {
            var img = l.replace(/^\s*image\s*:\s*["']?/, '').replace(/["']?\s*$/, '').trim();
            if (/:latest\s*$/.test(img) || (img.indexOf(':') === -1 && img.indexOf('@') === -1))
              r.push({ line: i + 1, text: l, explanation: 'Using :latest or an untagged image means you cannot guarantee what code is running. Pin images to a specific digest or semver tag.', fix: '          image: ' + img.replace(/:latest$/, '') + ':1.25.4  # Pin to specific version' });
          }
        });
        return r;
      }
    },
    {
      id: 'k8s-no-readonly-rootfs',
      name: 'Missing readOnlyRootFilesystem',
      severity: 'high',
      test: function (lines) {
        var text = lines.join('\n');
        if (!/readOnlyRootFilesystem\s*:\s*true/i.test(text)) {
          var scLine = -1;
          lines.forEach(function (l, i) { if (/^\s*securityContext\s*:/.test(l)) scLine = i; });
          if (scLine !== -1)
            return [{ line: scLine + 1, text: lines[scLine], explanation: 'Without a read-only root filesystem, an attacker can write malware, modify binaries, or plant backdoors inside the container.', fix: '            readOnlyRootFilesystem: true' }];
          var containerLine = -1;
          lines.forEach(function (l, i) { if (/^\s*containers\s*:/.test(l) && containerLine === -1) containerLine = i; });
          if (containerLine !== -1)
            return [{ line: containerLine + 1, text: lines[containerLine], explanation: 'Without a read-only root filesystem, an attacker can write malware, modify binaries, or plant backdoors inside the container.', fix: '          securityContext:\n            readOnlyRootFilesystem: true' }];
        }
        return [];
      }
    },

    /* ── MEDIUM ── */
    {
      id: 'k8s-no-security-context',
      name: 'Missing securityContext entirely',
      severity: 'medium',
      test: function (lines) {
        var text = lines.join('\n');
        if (!/securityContext\s*:/i.test(text)) {
          var containerLine = -1;
          lines.forEach(function (l, i) { if (/^\s*containers\s*:/.test(l) && containerLine === -1) containerLine = i; });
          if (containerLine !== -1)
            return [{ line: containerLine + 1, text: lines[containerLine], explanation: 'No securityContext is defined at all. This means all security defaults are inherited, which typically means root, full capabilities, and writable filesystem.', fix: '          securityContext:\n            runAsNonRoot: true\n            runAsUser: 1000\n            readOnlyRootFilesystem: true\n            allowPrivilegeEscalation: false\n            capabilities:\n              drop:\n                - ALL' }];
        }
        return [];
      }
    },
    {
      id: 'k8s-no-drop-all',
      name: 'Capabilities not dropped',
      severity: 'medium',
      test: function (lines) {
        var text = lines.join('\n');
        if (/securityContext\s*:/i.test(text) && !/drop\s*:\s*\n\s*-\s*["']?ALL["']?/i.test(text) && !/drop\s*:\s*\[\s*["']?ALL["']?\s*\]/i.test(text)) {
          var scLine = -1;
          lines.forEach(function (l, i) { if (/^\s*securityContext\s*:/.test(l)) scLine = i; });
          if (scLine !== -1)
            return [{ line: scLine + 1, text: lines[scLine], explanation: 'Linux capabilities are not explicitly dropped. Best practice is to drop ALL and add back only the specific capabilities your app needs.', fix: '            capabilities:\n              drop:\n                - ALL' }];
        }
        return [];
      }
    },
    {
      id: 'k8s-no-probes',
      name: 'No liveness or readiness probes',
      severity: 'medium',
      test: function (lines) {
        var text = lines.join('\n');
        var r = [];
        if (!/livenessProbe\s*:/i.test(text)) {
          var containerLine = -1;
          lines.forEach(function (l, i) { if (/^\s*-\s*name\s*:/.test(l) && containerLine === -1) containerLine = i; });
          if (containerLine !== -1)
