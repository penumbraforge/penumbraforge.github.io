      });

      // Append USER instruction if missing
      if (!hasUser) {
        result.push('');
        result.push('# Run as non-root user');
        result.push('RUN addgroup -S appgroup && adduser -S appuser -G appgroup');
        result.push('USER appuser');
      }

      // Append HEALTHCHECK if missing
      if (!hasHealthcheck) {
        result.push('');
        result.push('HEALTHCHECK --interval=30s --timeout=5s --retries=3 \\');
        result.push('  CMD wget -qO- http://localhost:8080/healthz || exit 1');
      }

      return result.join('\n');
    }

    if (type === 'compose') {
      var result = [];
      lines.forEach(function (l) {
        // Fix privileged
        if (/^\s*privileged\s*:\s*true/i.test(l)) {
          result.push(l.replace(/true/i, 'false'));
          return;
        }
        // Fix network_mode: host
        if (/^\s*network_mode\s*:\s*["']?host["']?/i.test(l)) {
          result.push(l.replace(/["']?host["']?/i, 'bridge'));
          return;
        }
        // Fix docker.sock mount
        if (/\/var\/run\/docker\.sock/i.test(l)) {
          result.push('      # docker.sock mount removed for security');
          return;
        }
        result.push(l);
      });
      return result.join('\n');
    }

    return text;
  }

  /* ── Main lint function ── */
  function lint() {
    var text = inputEl.value;
    if (!text.trim()) {
      resetUI();
      emptyEl.style.display = '';
      return;
    }

    var type = detectType(text);
    var lines = text.split('\n');
    var rules;

    if (type === 'kubernetes') {
      typeLabel.innerHTML = 'Detected: <span class="csl-type-detected">Kubernetes YAML</span>';
      rules = K8S_RULES;
    } else if (type === 'dockerfile') {
      typeLabel.innerHTML = 'Detected: <span class="csl-type-detected">Dockerfile</span>';
      rules = DOCKERFILE_RULES;
    } else if (type === 'compose') {
      typeLabel.innerHTML = 'Detected: <span class="csl-type-detected">docker-compose.yml</span>';
      rules = COMPOSE_RULES;
    } else {
      typeLabel.innerHTML = 'Detected: <span class="csl-type-detected">Unknown — trying all rules</span>';
      rules = K8S_RULES.concat(DOCKERFILE_RULES).concat(COMPOSE_RULES);
    }

    var findings = [];
    rules.forEach(function (rule) {
      var matches = rule.test(lines);
      matches.forEach(function (m) {
        findings.push({
          id: rule.id,
          name: rule.name,
          severity: rule.severity,
          line: m.line,
          text: m.text,
          explanation: m.explanation,
          fix: m.fix
        });
      });
    });

    // Deduplicate by id + line
    var seen = {};
    findings = findings.filter(function (f) {
      var key = f.id + ':' + f.line;
      if (seen[key]) return false;
      seen[key] = true;
      return true;
    });

    // Sort: critical first, then high, medium, low
    var sevOrder = { critical: 0, high: 1, medium: 2, low: 3 };
    findings.sort(function (a, b) { return (sevOrder[a.severity] || 9) - (sevOrder[b.severity] || 9); });

    lastFindings = findings;
    lastType = type;
    lastInput = text;

    emptyEl.style.display = 'none';
    fixedArea.style.display = 'none';

    if (findings.length === 0) {
      resultsEl.style.display = 'none';
      scoreArea.style.display = 'none';
      cleanEl.style.display = '';
      summaryEl.textContent = rules.length + ' rules checked';
      fixBtn.style.display = 'none';
      return;
    }

    cleanEl.style.display = 'none';
    resultsEl.style.display = '';
    scoreArea.style.display = '';

    /* ── Score ── */
    var score = calculateScore(findings);
    var grade = scoreGradeLabel(score);
    var color = scoreColor(score);
    var dashOffset = 327 - (327 * score / 100);
    scoreCircle.setAttribute('stroke', color);
    scoreCircle.setAttribute('stroke-dashoffset', dashOffset);
    scoreText.textContent = score;
    scoreGrade.textContent = grade;

    var crit = findings.filter(function (f) { return f.severity === 'critical'; }).length;
    var high = findings.filter(function (f) { return f.severity === 'high'; }).length;
    var med  = findings.filter(function (f) { return f.severity === 'medium'; }).length;
    var low  = findings.filter(function (f) { return f.severity === 'low'; }).length;
    var parts = [];
    if (crit) parts.push('<strong>' + crit + '</strong> critical');
    if (high) parts.push('<strong>' + high + '</strong> high');
    if (med)  parts.push('<strong>' + med  + '</strong> medium');
    if (low)  parts.push('<strong>' + low  + '</strong> low');
    scoreMeta.innerHTML = parts.join(' &middot; ') + '<br>' + rules.length + ' rules checked against ' + type;

    summaryEl.textContent = findings.length + ' finding' + (findings.length !== 1 ? 's' : '') + ' — score: ' + score + '/100';

    fixBtn.style.display = '';

    /* ── Render findings ── */
    while (findingsEl.firstChild) findingsEl.removeChild(findingsEl.firstChild);

    findings.forEach(function (f) {
      var card = document.createElement('div');
      card.className = 'csl-finding csl-finding--' + f.severity;

      var header = document.createElement('div');
      header.className = 'csl-finding-header';

      var typeSpan = document.createElement('span');
      typeSpan.className = 'csl-finding-type';
      typeSpan.textContent = f.name;

      var lineSpan = document.createElement('span');
      lineSpan.className = 'csl-line-num';
      lineSpan.textContent = f.text === '(document-level)' ? 'Global' : 'Line ' + f.line;

      var badge = document.createElement('span');
      badge.className = 'csl-badge csl-badge--' + f.severity;
      badge.textContent = f.severity;

      header.appendChild(typeSpan);
      header.appendChild(lineSpan);
      header.appendChild(badge);

      var body = document.createElement('div');
      body.className = 'csl-finding-body';

      if (f.text && f.text !== '(document-level)') {
        var pre = document.createElement('pre');
        pre.className = 'csl-match-pre';
        pre.textContent = f.text;
        body.appendChild(pre);
      }

      var expl = document.createElement('div');
      expl.className = 'csl-explanation';
      var explStrong = document.createElement('strong');
      explStrong.textContent = 'Why: ';
      expl.appendChild(explStrong);
      expl.appendChild(document.createTextNode(f.explanation));
      body.appendChild(expl);

      if (f.fix) {
        var fixLabel = document.createElement('div');
        fixLabel.className = 'csl-fix-label';
        fixLabel.textContent = 'Fix';
        body.appendChild(fixLabel);

        var fixPre = document.createElement('pre');
        fixPre.className = 'csl-fix-pre';
        fixPre.textContent = f.fix;
        body.appendChild(fixPre);
      }

      card.appendChild(header);
      card.appendChild(body);
      findingsEl.appendChild(card);
    });
  }

  function resetUI() {
    resultsEl.style.display = 'none';
    scoreArea.style.display = 'none';
    cleanEl.style.display = 'none';
    emptyEl.style.display = 'none';
    fixedArea.style.display = 'none';
    summaryEl.textContent = '';
    typeLabel.textContent = 'Paste a Kubernetes YAML, Dockerfile, or docker-compose.yml';
    fixBtn.style.display = 'none';
    while (findingsEl.firstChild) findingsEl.removeChild(findingsEl.firstChild);
  }

  /* ── Event listeners ── */
  lintBtn.addEventListener('click', lint);

  var debounceTimer = null;
  inputEl.addEventListener('input', function () {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(lint, 600);
  });

  exampleBtn.addEventListener('click', function () {
    inputEl.value = EXAMPLE;
    lint();
  });

  clearBtn.addEventListener('click', function () {
    inputEl.value = '';
    resetUI();
    emptyEl.style.display = '';
  });

  fixBtn.addEventListener('click', function () {
    var fixed = generateFixed();
    fixedOut.textContent = fixed;
    fixedArea.style.display = '';
    fixedArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  fixedCopy.addEventListener('click', function () {
    navigator.clipboard.writeText(fixedOut.textContent).then(function () {
      fixedCopy.textContent = 'Copied';
      setTimeout(function () { fixedCopy.textContent = 'Copy'; }, 1500);
    });
  });
})();
</script>
