---
toolSlug: word-counter
permalink: /tools/word-counter/
---

<style>
  /* Map legacy --color-* names (used by markup + script-set inline styles)
     onto the workbench palette so nothing falls back to the old indigo/slate. */
  .wc-tool {
    --color-accent: var(--accent);
    --color-muted: var(--slate);
    --color-surface-2: var(--surface-2);
    --color-border: var(--wb-line);
    --color-border-subtle: color-mix(in oklab, var(--wb-line) 55%, transparent);
  }

  /* ---- Top split: source text | headline metrics ---- */
  .wc-split { align-items: stretch; margin-top: 2px; }
  .wc-input-cell { display: flex; flex-direction: column; margin: 0; }
  .wc-input-cell textarea { flex: 1 1 auto; }

  .wc-hero {
    display: flex; flex-direction: column; justify-content: center; gap: 22px;
    padding: 26px 28px;
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--accent) 6%, transparent), transparent 62%),
      #06060d;
    border: 1px solid var(--wb-line);
    border-radius: 6px;
    box-shadow: inset 0 1px 0 color-mix(in oklab, #fff 5%, transparent);
  }
  .wc-hero-num {
    font-family: var(--font-display), var(--font-sans);
    font-size: clamp(42px, 6vw, 60px); font-weight: 600; line-height: 1;
    letter-spacing: -0.025em; color: var(--wb-ink);
    font-variant-numeric: tabular-nums;
  }
  .wc-hero-cap {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 2.5px;
    text-transform: uppercase; color: var(--slate); margin-top: 9px;
  }
  .wc-hero-rule { height: 1px; background: linear-gradient(90deg, var(--wb-line), transparent); }
  .wc-hero-aside { display: flex; gap: 30px; flex-wrap: wrap; }
  .wc-hero-mv {
    font-family: var(--font-mono); font-size: 19px; font-weight: 500;
    color: var(--wb-ink); letter-spacing: -0.01em; line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .wc-hero-ml {
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 1.5px;
    text-transform: uppercase; color: var(--slate); margin-top: 7px;
  }

  /* ---- Secondary stat grid ---- */
  .wc-stats-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
    gap: 10px; margin-top: 14px;
  }
  .wc-stat {
    background: #06060d; border: 1px solid var(--wb-line); border-radius: 6px;
    padding: 15px 16px; transition: border-color 220ms var(--wb-ease);
  }
  .wc-stat:hover { border-color: var(--wb-line-bright); }
  .wc-stat-val {
    font-family: var(--font-mono); font-size: 20px; font-weight: 500;
    color: var(--wb-ink); line-height: 1; font-variant-numeric: tabular-nums;
  }
  .wc-stat-label {
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 1.5px;
    text-transform: uppercase; color: var(--slate); margin-top: 9px;
  }

  /* ---- Extra: readability + frequency ---- */
  .wc-extra { display: grid; gap: 14px; margin-top: 22px; }
  .wc-panel-body { padding: 18px 20px; }
  .wc-bar-note { text-transform: none; letter-spacing: 0.3px; font-size: 10px; color: var(--text-3); }

  .wc-read-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); gap: 20px;
  }
  .wc-read-val {
    font-family: var(--font-mono); font-size: 17px; font-weight: 500;
    color: var(--accent); line-height: 1.15; font-variant-numeric: tabular-nums;
  }
  .wc-read-label {
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 1.5px;
    text-transform: uppercase; color: var(--slate); margin-top: 8px;
  }

  .wc-words-body { padding: 14px 18px 8px; }
  .wc-freq-table { width: 100%; border-collapse: collapse; font-family: var(--font-mono); font-size: 12.5px; }
  .wc-freq-table th {
    text-align: left; padding: 4px 10px 10px; font-size: 9px; letter-spacing: 1.5px;
    text-transform: uppercase; color: var(--slate); font-weight: 400;
    border-bottom: 1px solid var(--wb-line);
  }
  .wc-freq-table td {
    padding: 9px 10px; color: var(--text-1);
    border-bottom: 1px solid color-mix(in oklab, var(--wb-line) 55%, transparent);
  }
  .wc-freq-table tbody tr { transition: background 150ms; }
  .wc-freq-table tbody tr:hover { background: color-mix(in oklab, var(--accent) 5%, transparent); }
  .wc-freq-table tbody tr:last-child td { border-bottom: 0; }
  .wc-freq-bar {
    height: 8px; border-radius: 4px;
    background: linear-gradient(90deg, color-mix(in oklab, var(--accent) 45%, transparent), var(--accent));
    box-shadow: 0 0 10px -3px color-mix(in oklab, var(--accent) 70%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .wc-extra { animation: wc-reveal 340ms var(--wb-ease); }
    @keyframes wc-reveal { from { opacity: 0; transform: translateY(6px); } }
  }
</style>

<div class="wc-tool">
  <div class="wb-split wc-split">
    <div class="tool-group wc-input-cell">
      <label for="wc-input">Your text</label>
      <textarea id="wc-input" rows="12" placeholder="Start typing or paste your text here to see word count, reading time, and more…" spellcheck="true"></textarea>
    </div>

    <div class="wc-hero" aria-label="Primary metrics">
      <div class="wc-hero-primary">
        <div class="wc-hero-num" id="wc-words">0</div>
        <div class="wc-hero-cap">Words</div>
      </div>
      <div class="wc-hero-rule" aria-hidden="true"></div>
      <div class="wc-hero-aside">
        <div class="wc-hero-metric">
          <div class="wc-hero-mv" id="wc-read-time">0 min</div>
          <div class="wc-hero-ml">Reading &middot; 200 wpm</div>
        </div>
        <div class="wc-hero-metric">
          <div class="wc-hero-mv" id="wc-speak-time">0 min</div>
          <div class="wc-hero-ml">Speaking &middot; 130 wpm</div>
        </div>
      </div>
    </div>
  </div>

  <div class="wc-stats-grid" id="wc-stats">
    <div class="wc-stat"><div class="wc-stat-val" id="wc-chars">0</div><div class="wc-stat-label">Characters</div></div>
    <div class="wc-stat"><div class="wc-stat-val" id="wc-chars-nospace">0</div><div class="wc-stat-label">No spaces</div></div>
    <div class="wc-stat"><div class="wc-stat-val" id="wc-sentences">0</div><div class="wc-stat-label">Sentences</div></div>
    <div class="wc-stat"><div class="wc-stat-val" id="wc-paragraphs">0</div><div class="wc-stat-label">Paragraphs</div></div>
    <div class="wc-stat"><div class="wc-stat-val" id="wc-lines">0</div><div class="wc-stat-label">Lines</div></div>
  </div>

  <div id="wc-extra" class="wc-extra" style="display:none;">
    <div class="wb-panel">
      <div class="wb-panel-bar"><span>Readability</span><span class="wc-bar-note">Flesch&ndash;Kincaid</span></div>
      <div class="wc-panel-body wc-read-grid">
        <div class="wc-read-cell"><div class="wc-read-val" id="wc-fk-grade">&mdash;</div><div class="wc-read-label">Grade level</div></div>
        <div class="wc-read-cell"><div class="wc-read-val" id="wc-fk-score">&mdash;</div><div class="wc-read-label">Reading ease</div></div>
        <div class="wc-read-cell"><div class="wc-read-val" id="wc-fk-level">&mdash;</div><div class="wc-read-label">Difficulty</div></div>
        <div class="wc-read-cell"><div class="wc-read-val" id="wc-unique">&mdash;</div><div class="wc-read-label">Unique words</div></div>
      </div>
    </div>

    <div class="wb-panel">
      <div class="wb-panel-bar"><span>Most frequent words</span><span class="wc-bar-note">excludes stop-words</span></div>
      <div class="wc-panel-body wc-words-body">
        <table class="wc-freq-table" id="wc-freq-table" aria-label="Top word frequencies"></table>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var inputEl  = document.getElementById('wc-input');
  var extraEl  = document.getElementById('wc-extra');
  var freqTable = document.getElementById('wc-freq-table');

  var els = {
    words:       document.getElementById('wc-words'),
    chars:       document.getElementById('wc-chars'),
    charsNS:     document.getElementById('wc-chars-nospace'),
    sentences:   document.getElementById('wc-sentences'),
    paragraphs:  document.getElementById('wc-paragraphs'),
    lines:       document.getElementById('wc-lines'),
    readTime:    document.getElementById('wc-read-time'),
    speakTime:   document.getElementById('wc-speak-time'),
    fkGrade:     document.getElementById('wc-fk-grade'),
    fkScore:     document.getElementById('wc-fk-score'),
    fkLevel:     document.getElementById('wc-fk-level'),
    unique:      document.getElementById('wc-unique'),
  };

  var STOP_WORDS = new Set(['a','an','the','and','or','but','in','on','at','to','for','of','with','by','from','is','are','was','were','be','been','being','have','has','had','do','does','did','will','would','could','should','may','might','shall','that','this','these','those','it','its','i','you','he','she','we','they','as','if','so','not','no']);

  function countSyllables(word) {
    word = word.toLowerCase().replace(/[^a-z]/g, '');
    if (!word) return 0;
    if (word.length <= 3) return 1;
    word = word.replace(/(?:[^laeiouy]es|ed|[^laeiouy]e)$/, '');
    word = word.replace(/^y/, '');
    var m = word.match(/[aeiouy]{1,2}/g);
    return m ? m.length : 1;
  }

  function formatTime(words, wpm) {
    var mins = words / wpm;
    if (mins < 1) return Math.round(mins * 60) + ' sec';
    if (mins < 60) return Math.ceil(mins) + ' min';
    return Math.floor(mins / 60) + 'h ' + Math.round(mins % 60) + 'm';
  }

  function fkLevel(score) {
    if (score >= 90) return 'Very Easy';
    if (score >= 80) return 'Easy';
    if (score >= 70) return 'Fairly Easy';
    if (score >= 60) return 'Standard';
    if (score >= 50) return 'Fairly Hard';
    if (score >= 30) return 'Difficult';
    return 'Very Confusing';
  }

  function analyze() {
    var text = inputEl.value;

    var chars      = text.length;
    var charsNS    = text.replace(/\s/g, '').length;
    var lines      = text === '' ? 0 : text.split('\n').length;
    var paragraphs = text.trim() === '' ? 0 : text.trim().split(/\n\s*\n/).filter(function (p) { return p.trim().length > 0; }).length;
    var wordArr    = text.trim() === '' ? [] : text.trim().split(/\s+/).filter(Boolean);
    var words      = wordArr.length;
    var sentences  = text.trim() === '' ? 0 : (text.match(/[.!?]+(\s|$)/g) || []).length;

    els.words.textContent      = words.toLocaleString();
    els.chars.textContent      = chars.toLocaleString();
    els.charsNS.textContent    = charsNS.toLocaleString();
    els.sentences.textContent  = sentences;
    els.paragraphs.textContent = paragraphs;
    els.lines.textContent      = lines.toLocaleString();
    els.readTime.textContent   = words > 0 ? formatTime(words, 200) : '0 sec';
    els.speakTime.textContent  = words > 0 ? formatTime(words, 130) : '0 sec';

    if (words < 3) {
      extraEl.style.display = 'none';
      els.fkGrade.textContent = '—';
      els.fkScore.textContent = '—';
      els.fkLevel.textContent = '—';
      els.unique.textContent  = '—';
      return;
    }

    extraEl.style.display = '';

    // Word frequency
    var freq = {};
    var uniqueWords = new Set();
    var totalSyllables = 0;
    wordArr.forEach(function (w) {
      var clean = w.toLowerCase().replace(/[^a-z']/g, '');
      if (!clean) return;
      uniqueWords.add(clean);
      totalSyllables += countSyllables(clean);
      if (STOP_WORDS.has(clean)) return;
      freq[clean] = (freq[clean] || 0) + 1;
    });

    els.unique.textContent = uniqueWords.size;

    var freqArr = Object.keys(freq).map(function (w) { return { word: w, count: freq[w] }; });
    freqArr.sort(function (a, b) { return b.count - a.count; });
    var top10 = freqArr.slice(0, 10);
    var maxCount = top10.length ? top10[0].count : 1;

    while (freqTable.firstChild) freqTable.removeChild(freqTable.firstChild);
    var thead = document.createElement('thead');
    var hrow = document.createElement('tr');
    ['#', 'Word', 'Count', 'Frequency'].forEach(function (h) {
      var th = document.createElement('th');
      th.textContent = h;
      hrow.appendChild(th);
    });
    thead.appendChild(hrow);
    freqTable.appendChild(thead);

    var tbody = document.createElement('tbody');
    top10.forEach(function (item, idx) {
      var tr = document.createElement('tr');
      var tdRank = document.createElement('td');
      tdRank.style.color = 'var(--color-muted,#94a3b8)';
      tdRank.textContent = idx + 1;
      var tdWord = document.createElement('td');
      tdWord.style.fontFamily = 'var(--font-mono,monospace)';
      tdWord.style.fontWeight = '600';
      tdWord.textContent = item.word;
      var tdCount = document.createElement('td');
      tdCount.textContent = item.count;
      var tdBar = document.createElement('td');
      tdBar.style.width = '120px';
      var bar = document.createElement('div');
      bar.className = 'wc-freq-bar';
      bar.style.width = Math.round(item.count / maxCount * 100) + '%';
      tdBar.appendChild(bar);
      tr.appendChild(tdRank); tr.appendChild(tdWord); tr.appendChild(tdCount); tr.appendChild(tdBar);
      tbody.appendChild(tr);
    });
    freqTable.appendChild(tbody);

    // Flesch-Kincaid
    var avgSyllPerWord = words > 0 ? totalSyllables / words : 0;
    var avgWordPerSent = sentences > 0 ? words / sentences : words;
    var fkScore = 206.835 - (1.015 * avgWordPerSent) - (84.6 * avgSyllPerWord);
    fkScore = Math.max(0, Math.min(100, Math.round(fkScore * 10) / 10));
    var fkGrade = (0.39 * avgWordPerSent) + (11.8 * avgSyllPerWord) - 15.59;
    fkGrade = Math.max(1, Math.round(fkGrade * 10) / 10);

    els.fkScore.textContent = fkScore;
    els.fkGrade.textContent = 'Grade ' + fkGrade;
    els.fkLevel.textContent = fkLevel(fkScore);
  }

  inputEl.addEventListener('input', analyze);
  analyze();
})();
</script>
