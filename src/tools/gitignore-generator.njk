---
toolSlug: gitignore-generator
permalink: /tools/gitignore-generator/
---

<div class="tool-row" style="gap:16px; align-items:flex-start; flex-wrap:wrap;">
  <div style="flex:0 0 280px; min-width:220px;">
    <div class="tool-group" style="margin-bottom:10px;">
      <label for="gi-search">Search templates</label>
      <input type="text" id="gi-search" placeholder="e.g. node, python, jetbrains..." autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" />
    </div>
    <div id="gi-template-list" role="list" aria-label="Available .gitignore templates"></div>
  </div>
  <div style="flex:1; min-width:240px;">
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
      <label style="margin:0;">Selected templates</label>
      <button class="btn" id="gi-clear-all" style="font-size:11px; padding:3px 8px;">Clear all</button>
    </div>
    <div id="gi-selected" style="min-height:36px; display:flex; flex-wrap:wrap; gap:6px; margin-bottom:12px; padding:6px; border:1px solid var(--border); border-radius:4px; background:var(--surface-0);"></div>

    <div class="output-area" style="margin-top:0;">
      <button class="btn btn--copy" id="gi-copy" aria-label="Copy .gitignore">Copy</button>
      <button class="btn" id="gi-download" style="right:80px; position:absolute;" aria-label="Download .gitignore">Download</button>
      <pre id="gi-output" aria-label=".gitignore output" style="font-size:11px; max-height:480px; overflow:auto;"></pre>
    </div>
    <div id="gi-stats" style="font-family:var(--font-sans); font-size:12px; color:var(--text-3); margin-top:8px;"></div>
  </div>
</div>

<style>
  .gi-group {
    margin-bottom: 12px;
  }
  .gi-group-label {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-3);
    padding: 0 2px;
    margin-bottom: 4px;
  }
  .gi-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 8px;
    border-radius: 4px;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text-1);
    transition: background 0.1s;
    user-select: none;
  }
  .gi-item:hover { background: var(--surface-1); }
  .gi-item.selected { background: rgba(var(--accent-rgb,91,141,184),0.12); color: var(--accent); }
  .gi-item-check {
    width: 14px;
    height: 14px;
    border: 1.5px solid var(--border);
    border-radius: 3px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    transition: all 0.1s;
  }
  .gi-item.selected .gi-item-check {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }
  .gi-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px 3px 10px;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 20px;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--text-1);
    cursor: default;
  }
  .gi-chip-remove {
    background: none;
    border: none;
    color: var(--text-3);
    cursor: pointer;
    padding: 0;
    font-size: 14px;
    line-height: 1;
    display: flex;
    align-items: center;
    transition: color 0.1s;
  }
  .gi-chip-remove:hover { color: var(--text-1); }

  .output-area { position: relative; }
</style>

