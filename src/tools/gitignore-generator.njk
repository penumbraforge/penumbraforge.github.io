  var DEFAULTS = [
    "# Common defaults",
    ".env",
    ".env.*",
    "!.env.example",
    "*.log",
    "*.tmp",
    "*.temp",
    ".DS_Store",
    "Thumbs.db",
    "*.orig",
    "*.bak",
    "*.swp",
    ".idea/",
    ".vscode/",
    "coverage/",
    "dist/",
    "build/"
  ];

  var selected = {};
  var searchEl   = document.getElementById("gi-search");
  var listEl     = document.getElementById("gi-template-list");
  var selectedEl = document.getElementById("gi-selected");
  var outputEl   = document.getElementById("gi-output");
  var statsEl    = document.getElementById("gi-stats");
  var copyBtn    = document.getElementById("gi-copy");
  var dlBtn      = document.getElementById("gi-download");
  var clearBtn   = document.getElementById("gi-clear-all");

  // ── Build template list ───────────────────────────────────────────────────
  function buildList(filter) {
    filter = (filter || "").toLowerCase().trim();
    while (listEl.firstChild) listEl.removeChild(listEl.firstChild);

    var anyVisible = false;

    Object.keys(TEMPLATES).forEach(function (groupName) {
      var group = TEMPLATES[groupName];
      var items = Object.keys(group).filter(function (name) {
        return !filter || name.toLowerCase().indexOf(filter) !== -1;
      });
      if (!items.length) return;
      anyVisible = true;

      var groupDiv = document.createElement("div");
      groupDiv.className = "gi-group";

      var labelEl = document.createElement("div");
      labelEl.className = "gi-group-label";
      labelEl.textContent = groupName;
      groupDiv.appendChild(labelEl);

      items.forEach(function (name) {
        var item = document.createElement("div");
        item.className = "gi-item" + (selected[name] ? " selected" : "");
        item.setAttribute("role", "listitem");
        item.setAttribute("tabindex", "0");
        item.setAttribute("aria-selected", selected[name] ? "true" : "false");

        var check = document.createElement("span");
        check.className = "gi-item-check";
        check.textContent = selected[name] ? "\u2713" : "";
        item.appendChild(check);

        var nameEl = document.createElement("span");
        nameEl.textContent = name;
        item.appendChild(nameEl);

        function toggle() {
          if (selected[name]) {
            delete selected[name];
          } else {
            selected[name] = true;
          }
          buildList(searchEl.value);
          updateSelected();
          generate();
        }

        item.addEventListener("click", toggle);
        item.addEventListener("keydown", function (e) {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toggle(); }
        });

        groupDiv.appendChild(item);
      });

      listEl.appendChild(groupDiv);
    });

    if (!anyVisible && filter) {
      var none = document.createElement("div");
      none.style.cssText = "font-family:var(--font-sans);font-size:13px;color:var(--text-3);padding:8px;";
      none.textContent = "No templates match \"" + filter + "\"";
      listEl.appendChild(none);
    }
  }

  // ── Update chips ──────────────────────────────────────────────────────────
  function updateSelected() {
    while (selectedEl.firstChild) selectedEl.removeChild(selectedEl.firstChild);
    var keys = Object.keys(selected);
    if (!keys.length) {
      var hint = document.createElement("span");
      hint.style.cssText = "font-family:var(--font-sans);font-size:12px;color:var(--text-3);padding:2px 4px;";
      hint.textContent = "Select templates on the left to get started";
      selectedEl.appendChild(hint);
      return;
    }
    keys.forEach(function (name) {
      var chip = document.createElement("span");
      chip.className = "gi-chip";

      var label = document.createElement("span");
      label.textContent = name;
      chip.appendChild(label);

      var rm = document.createElement("button");
      rm.className = "gi-chip-remove";
      rm.setAttribute("aria-label", "Remove " + name);
      rm.textContent = "\u00d7";
      rm.addEventListener("click", function () {
        delete selected[name];
        buildList(searchEl.value);
        updateSelected();
        generate();
      });
      chip.appendChild(rm);
      selectedEl.appendChild(chip);
    });
  }

  // ── Generate .gitignore ───────────────────────────────────────────────────
  function generate() {
    var keys = Object.keys(selected);
    if (!keys.length) {
      outputEl.textContent = "# Select templates above to generate your .gitignore\n\n" + DEFAULTS.join("\n");
      updateStats(DEFAULTS.length - 1, 0, 0);
      return;
    }

    var all = [].concat(DEFAULTS);

    keys.forEach(function (name) {
      for (var g in TEMPLATES) {
        if (TEMPLATES[g][name]) {
          all = all.concat(["", ""]).concat(TEMPLATES[g][name]);
          break;
        }
      }
    });

    // Deduplicate non-comment, non-empty lines
    var seen = {};
    var result = [];
    var lastWasBlank = false;

    all.forEach(function (line) {
      if (line === "") {
        if (!lastWasBlank) result.push("");
        lastWasBlank = true;
        return;
      }
      lastWasBlank = false;

      if (line.startsWith("#")) {
        result.push(line);
        return;
      }

      if (!seen[line]) {
        seen[line] = true;
        result.push(line);
      }
    });

    // Trim trailing blanks
    while (result.length && result[result.length - 1] === "") result.pop();

    var text = result.join("\n");
    outputEl.textContent = text;

    var patterns = result.filter(function (l) { return l && !l.startsWith("#"); }).length;
    var dupes = all.filter(function (l) { return l && !l.startsWith("#"); }).length - patterns;
    updateStats(patterns, result.filter(function (l) { return l.startsWith("#"); }).length, dupes);
  }

  function updateStats(patterns, comments, dupes) {
    statsEl.textContent = patterns + " patterns, " + comments + " comments" + (dupes > 0 ? ", " + dupes + " duplicates removed" : "");
  }

  // ── Copy / Download ───────────────────────────────────────────────────────
  function copyText(text, btn) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () {
        btn.textContent = "Copied!";
        setTimeout(function () { btn.textContent = btn === copyBtn ? "Copy" : "Download"; }, 2000);
      });
    } else {
      var ta = document.createElement("textarea");
      ta.value = text;
      ta.style.cssText = "position:fixed;opacity:0";
      document.body.appendChild(ta);
      ta.focus(); ta.select();
      try { document.execCommand("copy"); btn.textContent = "Copied!"; } catch (e) {}
      document.body.removeChild(ta);
      setTimeout(function () { btn.textContent = "Copy"; }, 2000);
    }
  }

  copyBtn.addEventListener("click", function () {
    var text = outputEl.textContent;
    if (!text) return;
    copyText(text, copyBtn);
  });

  dlBtn.addEventListener("click", function () {
    var text = outputEl.textContent;
    if (!text) return;
    var blob = new Blob([text], { type: "text/plain" });
    var url = URL.createObjectURL(blob);
    var a = document.createElement("a");
    a.href = url;
    a.download = ".gitignore";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    dlBtn.textContent = "Downloaded!";
    setTimeout(function () { dlBtn.textContent = "Download"; }, 2000);
  });

  clearBtn.addEventListener("click", function () {
    selected = {};
    buildList(searchEl.value);
    updateSelected();
    generate();
  });

  searchEl.addEventListener("input", function () {
    buildList(searchEl.value);
  });

  // ── Init ──────────────────────────────────────────────────────────────────
  buildList("");
  updateSelected();
  generate();
})();
</script>
