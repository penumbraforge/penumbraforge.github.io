---
toolSlug: epoch-converter
permalink: /tools/epoch-converter/
---

<style>
  #ec-wrap .ec-grid { display: grid; gap: 0; }
  #ec-wrap .ec-row { display: grid; grid-template-columns: 128px 1fr; align-items: baseline; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--wb-line); }
  #ec-wrap .ec-row:last-child { border-bottom: 0; }
  #ec-wrap .ec-key { font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--slate); }
  #ec-wrap .ec-val { font-family: var(--font-mono); font-size: 13px; color: var(--wb-ink); background: none; border: 0; padding: 0; margin: 0; text-align: left; cursor: pointer; word-break: break-all; transition: color 160ms; }
  #ec-wrap .ec-val:hover, #ec-wrap .ec-val:focus-visible { color: var(--accent); outline: none; }
  #ec-wrap .ec-val::after { content: "copy"; font-family: var(--font-mono); font-size: 9px; letter-spacing: 1px; text-transform: uppercase; color: var(--text-3); margin-left: 10px; opacity: 0; transition: opacity 160ms; }
  #ec-wrap .ec-val:hover::after, #ec-wrap .ec-val:focus-visible::after { opacity: 1; }
  #ec-wrap .ec-val.copied { color: var(--sage); }
  #ec-wrap .ec-val.copied::after { content: "copied"; color: var(--sage); opacity: 1; }
  #ec-wrap .ec-rel { font-family: var(--font-mono); font-size: 13px; color: var(--wb-ink); }

  #ec-wrap .ec-tz-list { display: grid; }
  #ec-wrap .ec-tz-row { display: grid; grid-template-columns: 1fr auto auto; gap: 12px; align-items: baseline; padding: 9px 13px; border-bottom: 1px solid var(--wb-line); font-family: var(--font-mono); font-size: 12px; }
  #ec-wrap .ec-tz-row:last-child { border-bottom: 0; }
  #ec-wrap .ec-tz-zone { color: var(--text-2); }
  #ec-wrap .ec-tz-zone.is-local { color: var(--accent); }
  #ec-wrap .ec-tz-zone .tag { font-size: 9px; letter-spacing: 1px; text-transform: uppercase; color: var(--sage); margin-left: 8px; }
  #ec-wrap .ec-tz-time { color: var(--wb-ink); text-align: right; white-space: nowrap; }
  #ec-wrap .ec-tz-off { color: var(--text-3); font-size: 10.5px; min-width: 72px; text-align: right; white-space: nowrap; }

  #ec-wrap .ec-now { display: flex; align-items: center; gap: 10px 12px; flex-wrap: wrap; margin-top: 22px; padding: 12px 16px; border: 1px solid var(--wb-line); border-radius: 4px; background: color-mix(in oklab, var(--accent) 4%, transparent); font-family: var(--font-mono); font-size: 12px; color: var(--text-2); }
  #ec-wrap .ec-now-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--sage); box-shadow: 0 0 8px 1px color-mix(in oklab, var(--sage) 60%, transparent); animation: ec-pulse 2s ease-in-out infinite; flex-shrink: 0; }
  @keyframes ec-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
  #ec-wrap .ec-now-label { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--slate); }
  #ec-wrap .ec-now-val { font-family: var(--font-mono); font-size: 13px; color: var(--wb-ink); background: none; border: 0; padding: 0; cursor: pointer; transition: color 160ms; }
  #ec-wrap .ec-now-val:hover, #ec-wrap .ec-now-val:focus-visible { color: var(--accent); outline: none; }
  #ec-wrap .ec-now-unit { color: var(--text-3); font-size: 11px; }
  #ec-wrap .ec-now-sep { color: var(--wb-line-bright); }

  #ec-wrap .ec-reverse-out { margin-top: 14px; display: flex; gap: 28px; flex-wrap: wrap; }
  #ec-wrap .ec-reverse-out .ec-key { display: block; margin-bottom: 5px; }
  #ec-wrap .ec-hint { font-family: var(--font-mono); font-size: 10.5px; color: var(--text-3); margin-top: 10px; letter-spacing: .3px; }
  #ec-wrap .ec-divider { border: 0; border-top: 1px solid var(--wb-line); margin: 26px 0 4px; }

  @media (prefers-reduced-motion: reduce) { #ec-wrap .ec-now-dot { animation: none; } }
  @media (max-width: 520px) {
    #ec-wrap .ec-row { grid-template-columns: 96px 1fr; }
    #ec-wrap .ec-tz-row { grid-template-columns: 1fr auto; }
    #ec-wrap .ec-tz-off { display: none; }
  }
</style>

<div id="ec-wrap">
  <div class="tool-group">
    <label for="epoch-input">Timestamp or date</label>
    <div class="tool-row" style="gap: 8px;">
      <input type="text" id="epoch-input" placeholder="1700000000, 1700000000000, or 2023-11-14T22:13:20Z" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off" style="flex: 1; min-width: 220px;">
      <button class="btn" id="btn-now" type="button">Now</button>
      <button class="btn" id="btn-example" type="button">Example</button>
    </div>
    <div class="tool-options" role="group" aria-label="Interpret a number as" style="margin-top: 10px;">
      <button class="tool-option active" data-unit="auto" type="button" aria-pressed="true">Auto-detect</button>
      <button class="tool-option" data-unit="s" type="button" aria-pressed="false">Seconds</button>
      <button class="tool-option" data-unit="ms" type="button" aria-pressed="false">Milliseconds</button>
    </div>
  </div>

  <div id="epoch-error" class="tool-error" role="alert" aria-live="assertive" style="display: none;"></div>

  <div id="epoch-results" style="display: none;">
    <div class="output-area">
      <button class="btn btn--copy" id="btn-copy" type="button" aria-label="Copy all conversions">Copy</button>
      <div class="ec-grid" id="result-rows" aria-live="polite"></div>
    </div>
    <p class="ec-hint">Click any value to copy it.</p>

    <div class="wb-panel" id="ec-tz-panel" style="margin-top: 16px;">
      <div class="wb-panel-bar">
        <span>Across time zones</span>
        <span class="wb-badge wb-badge--local">local · <span id="ec-local-tz">—</span></span>
      </div>
      <div class="ec-tz-list" id="ec-tz-list"></div>
    </div>
  </div>

  <div class="ec-now" id="ec-now">
    <span class="ec-now-dot" aria-hidden="true"></span>
    <span class="ec-now-label">Now</span>
    <button class="ec-now-val" id="ec-now-s" type="button" title="Load current time">—</button>
    <span class="ec-now-unit">s</span>
    <span class="ec-now-sep" aria-hidden="true">·</span>
    <span class="ec-now-val" id="ec-now-ms" style="cursor: default;">—</span>
    <span class="ec-now-unit">ms</span>
  </div>

  <hr class="ec-divider" aria-hidden="true">

  <div class="tool-group" style="margin-top: 18px;">
    <label for="ec-date">Reverse · pick a date &amp; time (your local zone)</label>
    <input type="datetime-local" id="ec-date" step="1" style="width: 100%;">
    <div class="ec-reverse-out" id="ec-reverse-out" style="display: none;">
      <div>
        <span class="ec-key">Unix seconds</span>
        <button class="ec-val" id="rev-sec" type="button" aria-label="Copy unix seconds">—</button>
      </div>
      <div>
        <span class="ec-key">Unix millis</span>
        <button class="ec-val" id="rev-ms" type="button" aria-label="Copy unix milliseconds">—</button>
      </div>
    </div>
  </div>
</div>

<script type="module">
  import { epoch } from '/js/tools-lib.js';

  var epochInput = document.getElementById('epoch-input');
  var errorEl    = document.getElementById('epoch-error');
  var resultsEl  = document.getElementById('epoch-results');
  var rowsEl     = document.getElementById('result-rows');
  var copyBtn    = document.getElementById('btn-copy');
  var nowBtn     = document.getElementById('btn-now');
  var exampleBtn = document.getElementById('btn-example');
  var unitBtns   = Array.prototype.slice.call(document.querySelectorAll('.tool-option[data-unit]'));
  var tzPanel    = document.getElementById('ec-tz-panel');
  var tzListEl   = document.getElementById('ec-tz-list');
  var localTzEl  = document.getElementById('ec-local-tz');
  var nowSecEl   = document.getElementById('ec-now-s');
  var nowMsEl    = document.getElementById('ec-now-ms');
  var dateEl     = document.getElementById('ec-date');
  var revOut     = document.getElementById('ec-reverse-out');
  var revSecEl   = document.getElementById('rev-sec');
  var revMsEl    = document.getElementById('rev-ms');

  var unit = 'auto';
  var currentMs = null;      // last successfully rendered instant
  var lastOutput = '';       // plain-text block for the top copy button
  var syncing = false;       // guards the input <-> date-picker sync loop

  var localTZ = 'UTC';
  try { localTZ = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'; } catch (e) {}
  localTzEl.textContent = localTZ;

  var RTF = null;
  try { RTF = new Intl.RelativeTimeFormat(undefined, { numeric: 'always' }); } catch (e) {}

  var ZONES = ['UTC', 'America/Los_Angeles', 'America/New_York', 'Europe/London', 'Europe/Berlin', 'Asia/Kolkata', 'Asia/Tokyo', 'Australia/Sydney'];

  function pad(n) { return n < 10 ? '0' + n : '' + n; }

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.style.display = '';
    resultsEl.style.display = 'none';
    currentMs = null;
  }
  function hideError() {
    errorEl.textContent = '';
    errorEl.style.display = 'none';
  }

  function relative(ms) {
    var diff = ms - Date.now();          // positive => future
    var abs = Math.abs(diff);
    if (abs < 1000) return 'just now';
    var units = [
      ['year', 31536000000], ['month', 2592000000], ['day', 86400000],
      ['hour', 3600000], ['minute', 60000], ['second', 1000]
    ];
    for (var i = 0; i < units.length; i++) {
      if (abs >= units[i][1] || units[i][0] === 'second') {
        var val = Math.round(diff / units[i][1]);
        if (RTF) return RTF.format(val, units[i][0]);
        var word = Math.abs(val) === 1 ? units[i][0] : units[i][0] + 's';
        return val < 0 ? Math.abs(val) + ' ' + word + ' ago' : 'in ' + val + ' ' + word;
      }
    }
    return '';
  }

  function localString(d) {
    try {
      return new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'medium' }).format(d);
    } catch (e) {
      return d.toString();
    }
  }

  function toLocalInput(d) {
    return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) +
      'T' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
  }

  function copyText(text, onOk) {
    if (!text && text !== 0) return;
    text = String(text);
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(onOk, function () { fallbackCopy(text, onOk); });
    } else {
      fallbackCopy(text, onOk);
    }
  }
  function fallbackCopy(text, onOk) {
    var ta = document.createElement('textarea');
    ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.focus(); ta.select();
    try { document.execCommand('copy'); if (onOk) onOk(); } catch (e) {}
    document.body.removeChild(ta);
  }
  function flash(btn) {
    btn.classList.add('copied');
    clearTimeout(btn._t);
    btn._t = setTimeout(function () { btn.classList.remove('copied'); }, 1400);
  }

  function valueButton(key, value) {
    var b = document.createElement('button');
    b.type = 'button';
    b.className = 'ec-val';
    b.textContent = value;
    b.setAttribute('aria-label', 'Copy ' + key);
    b.addEventListener('click', function () { copyText(value, function () { flash(b); }); });
    return b;
  }

  function addRow(key, node) {
    var row = document.createElement('div');
    row.className = 'ec-row';
    var k = document.createElement('span');
    k.className = 'ec-key';
    k.textContent = key;
    row.appendChild(k);
    row.appendChild(node);
    rowsEl.appendChild(row);
  }

  function buildTimezones(ms) {
    tzListEl.textContent = '';
    var zones = ZONES.slice();
    if (zones.indexOf(localTZ) === -1) zones.unshift(localTZ);
    var d = new Date(ms);
    zones.forEach(function (zone) {
      var timeStr, offStr = '';
      try {
        timeStr = new Intl.DateTimeFormat('en-US', { timeZone: zone, weekday: 'short', month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).format(d);
        var parts = new Intl.DateTimeFormat('en-US', { timeZone: zone, timeZoneName: 'shortOffset' }).formatToParts(d);
        for (var i = 0; i < parts.length; i++) { if (parts[i].type === 'timeZoneName') offStr = parts[i].value; }
      } catch (e) { return; }
      var row = document.createElement('div');
      row.className = 'ec-tz-row';
      var z = document.createElement('span');
      z.className = 'ec-tz-zone' + (zone === localTZ ? ' is-local' : '');
      z.textContent = zone;
      if (zone === localTZ) { var tag = document.createElement('span'); tag.className = 'tag'; tag.textContent = 'you'; z.appendChild(tag); }
      var t = document.createElement('span'); t.className = 'ec-tz-time'; t.textContent = timeStr;
      var o = document.createElement('span'); o.className = 'ec-tz-off'; o.textContent = offStr;
      row.appendChild(z); row.appendChild(t); row.appendChild(o);
      tzListEl.appendChild(row);
    });
  }

  function render(ms, d, iso, interpretedAs, raw) {
    hideError();
    currentMs = ms;
    var unixSeconds = Math.floor(ms / 1000);
    var utc = d.toUTCString();
    var local = localString(d);
    var rel = relative(ms);

    rowsEl.textContent = '';
    addRow('Input', valueButton('Input', raw + '  →  ' + interpretedAs));
    addRow('ISO 8601', valueButton('ISO 8601', iso));
    addRow('UTC', valueButton('UTC', utc));
    addRow('Local', valueButton('Local', local + '  (' + localTZ + ')'));
    addRow('Unix seconds', valueButton('Unix seconds', String(unixSeconds)));
    addRow('Unix millis', valueButton('Unix millis', String(ms)));

    var relSpan = document.createElement('span');
    relSpan.className = 'ec-rel';
    relSpan.id = 'ec-rel-val';
    relSpan.textContent = rel;
    addRow('Relative', relSpan);

    buildTimezones(ms);
    resultsEl.style.display = '';

    // keep the reverse date-picker in sync (without re-triggering conversion)
    syncing = true;
    dateEl.value = toLocalInput(d);
    syncing = false;
    showReverse(ms);

    lastOutput =
      'Input:        ' + raw + '  (' + interpretedAs + ')\n' +
      'ISO 8601:     ' + iso + '\n' +
      'UTC:          ' + utc + '\n' +
      'Local:        ' + local + '  (' + localTZ + ')\n' +
      'Unix seconds: ' + unixSeconds + '\n' +
      'Unix millis:  ' + ms + '\n' +
      'Relative:     ' + rel;

    publish({
      input: raw,
      interpretedAs: interpretedAs,
      iso: iso,
      utc: utc,
      local: local,
      localTimeZone: localTZ,
      unixSeconds: unixSeconds,
      unixMillis: ms,
      relative: rel
    });
  }

  function publish(data) {
    if (!window.PF) return;
    PF.ready({ output: lastOutput, data: data });
  }

  function convert() {
    var raw = epochInput.value;
    var v = String(raw).trim();
    if (!v) { hideError(); resultsEl.style.display = 'none'; currentMs = null; return; }

    var ms, interpretedAs;
    try {
      if (unit === 's' || unit === 'ms') {
        if (!/^[+-]?(\d+\.?\d*|\.\d+)$/.test(v)) {
          throw new Error('Enter a numeric value for ' + (unit === 's' ? 'seconds' : 'milliseconds') + ' mode.');
        }
        var n = parseFloat(v);
        ms = unit === 'ms' ? n : n * 1000;
        interpretedAs = unit === 's' ? 'unix seconds' : 'unix milliseconds';
      } else {
        var res = epoch(v);           // shared brain — identical to URL/MCP results
        ms = res.unixMillis;
        interpretedAs = /^\d+$/.test(v) ? (v.length >= 13 ? 'unix milliseconds' : 'unix seconds') : 'date string';
      }
      ms = Math.round(ms);
      var d = new Date(ms);
      var iso = d.toISOString();       // throws RangeError when out of range
      render(ms, d, iso, interpretedAs, v);
    } catch (e) {
      var m = e && e.message ? e.message : 'Could not parse that input.';
      if (/invalid time value|out of range/i.test(m)) m = 'Timestamp is out of the representable date range.';
      showError(m);
      if (window.PF) PF.fail(m);
    }
  }

  function showReverse(ms) {
    revOut.style.display = '';
    var secs = Math.floor(ms / 1000);
    revSecEl.textContent = String(secs);
    revMsEl.textContent = String(ms);
  }

  // ---- events ----
  epochInput.addEventListener('input', convert);

  nowBtn.addEventListener('click', function () {
    var now = Date.now();
    epochInput.value = unit === 'ms' ? String(now) : String(Math.floor(now / 1000));
    convert();
  });

  exampleBtn.addEventListener('click', function () {
    setUnit('auto');
    epochInput.value = '1700000000';
    convert();
    epochInput.focus();
  });

  function setUnit(u) {
    if (u === unit) return;
    unit = u;
    unitBtns.forEach(function (b) {
      var on = b.getAttribute('data-unit') === u;
      b.classList.toggle('active', on);
      b.setAttribute('aria-pressed', String(on));
    });
  }

  unitBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      setUnit(btn.getAttribute('data-unit'));
      convert();
    });
  });

  dateEl.addEventListener('input', function () {
    if (syncing) return;
    var raw = dateEl.value;
    if (!raw) { revOut.style.display = 'none'; return; }
    var d = new Date(raw);              // parsed in local time
    if (isNaN(d.getTime())) { revOut.style.display = 'none'; return; }
    var ms = d.getTime();
    epochInput.value = unit === 'ms' ? String(ms) : String(Math.floor(ms / 1000));
    convert();
  });

  revSecEl.addEventListener('click', function () { copyText(revSecEl.textContent, function () { flash(revSecEl); }); });
  revMsEl.addEventListener('click', function () { copyText(revMsEl.textContent, function () { flash(revMsEl); }); });

  copyBtn.addEventListener('click', function () {
    if (!lastOutput) return;
    copyText(lastOutput, function () {
      copyBtn.classList.add('copied');
      copyBtn.textContent = 'Copied';
      setTimeout(function () { copyBtn.classList.remove('copied'); copyBtn.textContent = 'Copy'; }, 1600);
    });
  });

  nowSecEl.addEventListener('click', function () {
    setUnit('auto');
    epochInput.value = String(Math.floor(Date.now() / 1000));
    convert();
  });

  // ---- live 'now' ticker + relative refresh ----
  function tick() {
    var now = Date.now();
    nowSecEl.textContent = String(Math.floor(now / 1000));
    nowMsEl.textContent = String(now);
    if (currentMs !== null) {
      var relEl = document.getElementById('ec-rel-val');
      if (relEl) relEl.textContent = relative(currentMs);
    }
  }
  tick();
  setInterval(tick, 1000);

  // ---- agent I/O + URL invoke ----
  if (window.PF) {
    var p = PF.input();
    if (p.unit === 's' || p.unit === 'ms' || p.unit === 'auto') setUnit(p.unit);
    if (p.in != null && String(p.in).trim() !== '') {
      epochInput.value = p.in;
      convert();
    } else {
      // demo instantly with the current time
      epochInput.value = String(Math.floor(Date.now() / 1000));
      convert();
    }
  } else {
    epochInput.value = String(Math.floor(Date.now() / 1000));
    convert();
  }
</script>
