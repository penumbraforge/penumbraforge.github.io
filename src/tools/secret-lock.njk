---
toolSlug: secret-lock
permalink: /tools/secret-lock/
---

<div class="sv" data-slug="secret-lock">

  <div class="sv-tabrow">
    <div class="tool-options" role="tablist" aria-label="Vault mode" id="sv-tabs">
      <button class="tool-option active" role="tab" data-tab="encrypt" aria-selected="true" aria-controls="sv-panel-encrypt" id="sv-tab-encrypt" type="button">Encrypt</button>
      <button class="tool-option" role="tab" data-tab="decrypt" aria-selected="false" aria-controls="sv-panel-decrypt" id="sv-tab-decrypt" type="button">Decrypt</button>
    </div>
    <button class="sv-example" id="sv-example" type="button">Load example</button>
  </div>

  <!-- ============ ENCRYPT ============ -->
  <div id="sv-panel-encrypt" class="sv-panel" role="tabpanel" aria-labelledby="sv-tab-encrypt">

    <div class="tool-group">
      <label for="sv-plain">Secret to encrypt</label>
      <textarea id="sv-plain" rows="5" placeholder="Paste the text you want to lock — API keys, passwords, recovery codes, private notes…" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
    </div>

    <div class="tool-group">
      <label>…or lock a file</label>
      <div id="sv-drop-enc" class="sv-drop" role="button" tabindex="0" aria-label="Drop a file to encrypt, or click to browse">
        <span id="sv-drop-enc-label">Drop a file here or <u>click to browse</u> <span class="sv-drop-sub">— up to 25 MB, any type</span></span>
        <input type="file" id="sv-file-enc" hidden aria-hidden="true">
      </div>
      <div id="sv-file-info" class="sv-file-info" aria-live="polite"></div>
    </div>

    <div class="tool-group">
      <label for="sv-enc-pass">Passphrase</label>
      <div class="sv-passrow">
        <input type="password" id="sv-enc-pass" placeholder="A strong passphrase — the only thing that can unlock this" autocomplete="new-password" spellcheck="false">
        <button class="sv-eye" id="sv-enc-eye" type="button" aria-pressed="false" aria-label="Show passphrase">show</button>
      </div>
      <div class="sv-strength" aria-live="polite">
        <div class="sv-meter" id="sv-meter" data-level="0" role="img" aria-label="Passphrase strength">
          <span class="sv-pip"></span><span class="sv-pip"></span><span class="sv-pip"></span><span class="sv-pip"></span>
        </div>
        <div class="sv-strength-txt">
          <span class="sv-verdict lvl-0" id="sv-verdict">enter a passphrase</span>
          <span class="sv-sep" id="sv-strength-sep" hidden>·</span>
          <span id="sv-bits-wrap" hidden><b id="sv-bits">0</b> bits est.</span>
        </div>
      </div>
      <p class="sv-passnote">There is no recovery. If you lose this passphrase, the data is gone for good — that is the point.</p>
    </div>

    <details class="sv-adv">
      <summary>Advanced — key derivation</summary>
      <div class="sv-adv-body">
        <label for="sv-iter">PBKDF2 iterations (SHA-256)</label>
        <select id="sv-iter">
          <option value="600000" selected>600,000 — OWASP 2023 minimum</option>
          <option value="1000000">1,000,000 — hardened</option>
          <option value="1300000">1,300,000 — paranoid</option>
        </select>
        <p class="sv-adv-hint">Higher counts slow every guess an attacker makes — and slow your own unlock a little. The count is written into the blob header, so decryption always uses the right value automatically.</p>
      </div>
    </details>

    <div class="tool-row">
      <button class="btn btn--primary" id="sv-enc-btn" type="button">Encrypt</button>
      <span class="sv-hint">AES-256-GCM · random salt + IV per message</span>
    </div>

    <div id="sv-enc-error" class="tool-error" role="alert" aria-live="polite" style="display:none;"></div>

    <div class="output-area" id="sv-enc-out-area" hidden>
      <div class="sv-out-actions">
        <button class="btn btn--copy" id="sv-enc-copy" type="button" aria-label="Copy encrypted blob">Copy</button>
        <button class="btn" id="sv-enc-download" type="button" aria-label="Download encrypted blob">Download</button>
      </div>
      <pre id="sv-enc-out" aria-label="Encrypted blob"></pre>
    </div>
  </div>

  <!-- ============ DECRYPT ============ -->
  <div id="sv-panel-decrypt" class="sv-panel" role="tabpanel" aria-labelledby="sv-tab-decrypt" hidden>

    <div class="tool-group">
      <label for="sv-blob">Encrypted blob</label>
      <textarea id="sv-blob" rows="5" placeholder="Paste the base64 blob produced by Encrypt…" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
      <div id="sv-drop-dec" class="sv-drop sv-drop--slim" role="button" tabindex="0" aria-label="Drop a vault file to decrypt, or click to browse">
        <span>Drop a <code>.vault</code> file here or <u>click to browse</u></span>
        <input type="file" id="sv-file-dec" hidden aria-hidden="true">
      </div>
    </div>

    <div id="sv-header" class="sv-header" role="status" aria-live="polite" hidden></div>

    <div class="tool-group">
      <label for="sv-dec-pass">Passphrase</label>
      <div class="sv-passrow">
        <input type="password" id="sv-dec-pass" placeholder="The passphrase used to encrypt this blob" autocomplete="off" spellcheck="false">
        <button class="sv-eye" id="sv-dec-eye" type="button" aria-pressed="false" aria-label="Show passphrase">show</button>
      </div>
    </div>

    <div class="tool-row">
      <button class="btn btn--primary" id="sv-dec-btn" type="button">Decrypt</button>
    </div>

    <div id="sv-dec-error" class="tool-error" role="alert" aria-live="polite" style="display:none;"></div>

    <div class="output-area" id="sv-dec-out-area" hidden>
      <div class="sv-out-actions">
        <button class="btn btn--copy" id="sv-dec-copy" type="button" aria-label="Copy recovered secret">Copy</button>
        <button class="btn" id="sv-dec-download" type="button" aria-label="Download recovered data">Download</button>
      </div>
      <pre id="sv-dec-out" aria-label="Recovered secret"></pre>
      <div id="sv-dec-file" class="sv-dec-file" hidden></div>
    </div>
  </div>

  <div class="sv-crypto-note">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="4" y="11" width="16" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
    <div>
      <strong>What this does, exactly.</strong> Your passphrase is stretched into a 256-bit key with <b>PBKDF2-HMAC-SHA256</b> (600,000 iterations by default) over a fresh random 16-byte salt, then used to encrypt with <b>AES-256-GCM</b> and a random 12-byte IV. The output is a self-describing base64 blob — version, KDF, iteration count, salt and IV are packed in the header, so Decrypt configures itself. GCM authenticates the data: a wrong passphrase or a single flipped byte fails cleanly instead of returning garbage. Everything happens in this tab via the WebCrypto API. Nothing is uploaded, and the passphrase is never stored.
    </div>
  </div>

</div>

<style>
  .sv-tabrow { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
  .sv-example {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.4px;
    color: var(--text-2); background: none; border: 1px solid var(--wb-line);
    border-radius: 2px; padding: 8px 13px; cursor: pointer;
    transition: border-color 160ms, color 160ms;
  }
  .sv-example:hover { border-color: var(--accent); color: var(--wb-ink); }

  .sv-panel { min-height: 60px; }

  .sv-drop {
    border: 1px dashed var(--wb-line-bright); border-radius: 4px;
    padding: 18px; text-align: center; cursor: pointer; user-select: none;
    color: var(--text-2); font-size: 13px; transition: border-color 180ms, background 180ms;
  }
  .sv-drop:hover, .sv-drop:focus-visible { border-color: var(--accent); background: color-mix(in oklab, var(--accent) 5%, transparent); outline: none; }
  .sv-drop.is-drag { border-color: var(--accent); background: color-mix(in oklab, var(--accent) 10%, transparent); color: var(--wb-ink); }
  .sv-drop u { color: var(--accent); text-decoration: none; border-bottom: 1px solid color-mix(in oklab, var(--accent) 50%, transparent); }
  .sv-drop code { font-family: var(--font-mono); font-size: 12px; color: var(--accent); }
  .sv-drop-sub { color: var(--text-3); font-size: 11.5px; }
  .sv-drop--slim { margin-top: 10px; padding: 11px; font-size: 12px; }
  .sv-file-info { margin-top: 8px; font-family: var(--font-mono); font-size: 12px; color: var(--sage); }
  .sv-file-info .sv-clear { margin-left: 10px; color: var(--text-3); cursor: pointer; border: 0; background: none; font-family: var(--font-mono); font-size: 11px; text-decoration: underline; }

  .sv-passrow { display: flex; gap: 8px; align-items: stretch; }
  .sv-passrow input { flex: 1; }
  .sv-eye {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.4px;
    color: var(--text-2); background: #06060d; border: 1px solid var(--wb-line);
    border-radius: 3px; padding: 0 14px; cursor: pointer; min-width: 58px;
    transition: border-color 160ms, color 160ms;
  }
  .sv-eye:hover { border-color: var(--accent); color: var(--wb-ink); }
  .sv-eye[aria-pressed="true"] { color: var(--accent); border-color: color-mix(in oklab, var(--accent) 45%, transparent); }

  .sv-strength { margin-top: 12px; display: flex; flex-direction: column; gap: 8px; }
  .sv-meter { display: flex; gap: 5px; }
  .sv-pip { height: 5px; flex: 1; border-radius: 2px; background: var(--surface-2); border: 1px solid var(--wb-line); transition: background 200ms, border-color 200ms, box-shadow 200ms; }
  .sv-meter[data-level="1"] .sv-pip:nth-child(-n+1) { background: #e06c6c; border-color: #e06c6c; }
  .sv-meter[data-level="2"] .sv-pip:nth-child(-n+2) { background: #e0a458; border-color: #e0a458; }
  .sv-meter[data-level="3"] .sv-pip:nth-child(-n+3) { background: var(--sage); border-color: var(--sage); }
  .sv-meter[data-level="4"] .sv-pip:nth-child(-n+4) { background: var(--sage); border-color: var(--sage); box-shadow: 0 0 9px color-mix(in oklab, var(--sage) 45%, transparent); }
  .sv-strength-txt { font-family: var(--font-mono); font-size: 11.5px; color: var(--text-3); display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; }
  .sv-strength-txt b { color: var(--text-1); font-weight: 500; }
  .sv-verdict { font-weight: 600; text-transform: uppercase; letter-spacing: 1.1px; font-size: 10.5px; }
  .sv-verdict.lvl-0 { color: var(--text-3); }
  .sv-verdict.lvl-1 { color: #e06c6c; }
  .sv-verdict.lvl-2 { color: #e0a458; }
  .sv-verdict.lvl-3, .sv-verdict.lvl-4 { color: var(--sage); }
  .sv-sep { color: var(--wb-line); }
  .sv-passnote { margin-top: 10px; font-size: 12px; line-height: 1.5; color: var(--text-3); }

  .sv-adv { margin-top: 18px; border: 1px solid var(--wb-line); border-radius: 4px; overflow: hidden; }
  .sv-adv > summary { cursor: pointer; padding: 11px 14px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: var(--slate); list-style: none; }
  .sv-adv > summary::-webkit-details-marker { display: none; }
  .sv-adv > summary::before { content: "+ "; color: var(--accent); }
  .sv-adv[open] > summary::before { content: "− "; }
  .sv-adv-body { padding: 4px 14px 16px; display: flex; flex-direction: column; gap: 8px; }
  .sv-adv-body select { max-width: 340px; }
  .sv-adv-hint { font-size: 12px; line-height: 1.55; color: var(--text-3); }

  .sv .tool-row { margin-top: 18px; align-items: center; gap: 14px; }
  .sv-hint { font-family: var(--font-mono); font-size: 11px; color: var(--text-3); }

  .sv .output-area { margin-top: 16px; position: relative; }
  .sv-out-actions { display: flex; gap: 8px; position: absolute; top: 10px; right: 10px; z-index: 2; }
  .sv .output-area pre { white-space: pre-wrap; word-break: break-all; margin: 0; padding-right: 130px; min-height: 22px; }
  #sv-dec-out:empty { display: none; }

  .sv-header {
    margin: 4px 0 16px; padding: 11px 14px; border: 1px solid var(--wb-line);
    border-left: 2px solid var(--accent); border-radius: 3px; background: color-mix(in oklab, var(--accent) 5%, transparent);
    font-family: var(--font-mono); font-size: 11.5px; color: var(--text-2); line-height: 1.7;
  }
  .sv-header b { color: var(--accent); font-weight: 500; }
  .sv-header.is-bad { border-left-color: #e8a87c; background: color-mix(in oklab, #e8a87c 6%, transparent); color: #e8a87c; }

  .sv-dec-file { margin-top: 4px; font-family: var(--font-mono); font-size: 13px; color: var(--wb-ink); }
  .sv-dec-file b { color: var(--sage); }

  .sv-crypto-note {
    margin-top: 24px; display: flex; gap: 13px; align-items: flex-start;
    padding: 15px 17px; border: 1px solid var(--wb-line); border-radius: 4px;
    background: color-mix(in oklab, var(--surface-1) 60%, transparent);
  }
  .sv-crypto-note svg { flex-shrink: 0; width: 20px; height: 20px; color: var(--accent); margin-top: 1px; }
  .sv-crypto-note div { font-size: 12.5px; line-height: 1.65; color: var(--text-2); }
  .sv-crypto-note strong { color: var(--wb-ink); font-weight: 600; }
  .sv-crypto-note b { color: var(--text-1); font-weight: 500; }
</style>

<script type="module">
  import { bytesToB64, b64ToBytes, strToBytes, bytesToStr } from '/js/tools-lib.js';

  "use strict";

  // ---------- self-describing blob format (PFV1) ----------
  var MAGIC = [0x50, 0x46, 0x56, 0x31];        // "PFV1"
  var KDF_PBKDF2_SHA256 = 0x01;
  var CIPHER_AES256GCM = 0x01;
  var OWASP_ITERATIONS = 600000;
  var PT_TEXT = 0x00, PT_FILE = 0x01;
  var MAX_BYTES = 25 * 1024 * 1024;
  var subtle = window.crypto.subtle;

  function u32be(n) { return [(n >>> 24) & 255, (n >>> 16) & 255, (n >>> 8) & 255, n & 255]; }
  function readU32be(b, o) { return (b[o] * 0x1000000) + (b[o + 1] << 16) + (b[o + 2] << 8) + b[o + 3]; }
  function u16be(n) { return [(n >>> 8) & 255, n & 255]; }
  function readU16be(b, o) { return (b[o] << 8) + b[o + 1]; }

  function deriveKey(passphrase, salt, iterations) {
    return subtle.importKey('raw', strToBytes(passphrase), { name: 'PBKDF2' }, false, ['deriveKey'])
      .then(function (baseKey) {
        return subtle.deriveKey(
          { name: 'PBKDF2', salt: salt, iterations: iterations, hash: 'SHA-256' },
          baseKey,
          { name: 'AES-GCM', length: 256 },
          false,
          ['encrypt', 'decrypt']
        );
      });
  }

  function buildEnvelope(type, name, payload) {
    var nameBytes = type === PT_FILE ? strToBytes(name || '') : new Uint8Array(0);
    var head = type === PT_FILE ? 1 + 2 + nameBytes.length : 1;
    var env = new Uint8Array(head + payload.length);
    env[0] = type;
    var off = 1;
    if (type === PT_FILE) { env.set(u16be(nameBytes.length), 1); env.set(nameBytes, 3); off = 3 + nameBytes.length; }
    env.set(payload, off);
    return env;
  }
  function parseEnvelope(env) {
    if (env[0] === PT_FILE) {
      var nameLen = readU16be(env, 1);
      return { type: 'file', filename: bytesToStr(env.subarray(3, 3 + nameLen)), payload: env.subarray(3 + nameLen) };
    }
    return { type: 'text', filename: null, payload: env.subarray(1) };
  }

  function encryptBytes(payload, type, name, passphrase, iterations) {
    iterations = iterations || OWASP_ITERATIONS;
    var salt = window.crypto.getRandomValues(new Uint8Array(16));
    var iv = window.crypto.getRandomValues(new Uint8Array(12));
    return deriveKey(passphrase, salt, iterations).then(function (key) {
      var env = buildEnvelope(type, name, payload);
      return subtle.encrypt({ name: 'AES-GCM', iv: iv }, key, env);
    }).then(function (ctBuf) {
      var ct = new Uint8Array(ctBuf);
      var header = [].concat(MAGIC, [KDF_PBKDF2_SHA256, CIPHER_AES256GCM], u32be(iterations), [salt.length], Array.from(salt), [iv.length], Array.from(iv));
      var out = new Uint8Array(header.length + ct.length);
      out.set(header, 0);
      out.set(ct, header.length);
      return bytesToB64(out);
    });
  }

  function parseHeader(bytes) {
    if (bytes.length < 12) throw new Error('This is too short to be a vault blob.');
    for (var i = 0; i < 4; i++) if (bytes[i] !== MAGIC[i]) throw new Error('This is not a Secret Vault blob.');
    if (bytes[4] !== KDF_PBKDF2_SHA256) throw new Error('Unsupported key-derivation id (' + bytes[4] + ').');
    if (bytes[5] !== CIPHER_AES256GCM) throw new Error('Unsupported cipher id (' + bytes[5] + ').');
    var iterations = readU32be(bytes, 6);
    var saltLen = bytes[10];
    var o = 11;
    if (o + saltLen + 1 > bytes.length) throw new Error('Blob header is truncated (salt).');
    var salt = bytes.subarray(o, o + saltLen); o += saltLen;
    var ivLen = bytes[o]; o += 1;
    if (o + ivLen > bytes.length) throw new Error('Blob header is truncated (IV).');
    var iv = bytes.subarray(o, o + ivLen); o += ivLen;
    return { version: 1, kdf: 'PBKDF2-HMAC-SHA256', cipher: 'AES-256-GCM', iterations: iterations, saltLen: saltLen, ivLen: ivLen, salt: salt, iv: iv, ciphertext: bytes.subarray(o) };
  }
  function parseHeaderSafe(blobStr) {
    try { return parseHeader(b64ToBytes(blobStr)); } catch (e) { return null; }
  }

  function decryptBlob(blobStr, passphrase) {
    var h = parseHeader(b64ToBytes(blobStr));
    return deriveKey(passphrase, h.salt, h.iterations).then(function (key) {
      return subtle.decrypt({ name: 'AES-GCM', iv: h.iv }, key, h.ciphertext);
    }).then(function (plainBuf) {
      var env = parseEnvelope(new Uint8Array(plainBuf));
      return { header: h, type: env.type, filename: env.filename, payload: env.payload };
    }, function () {
      throw new Error('WRONG_PASSPHRASE');
    });
  }

  // ---------- shared UI helpers ----------
  function $(id) { return document.getElementById(id); }
  function fmtInt(n) { return n.toLocaleString('en-US'); }
  function fmtBytes(n) { return n < 1024 ? n + ' B' : n < 1048576 ? (n / 1024).toFixed(1) + ' KB' : (n / 1048576).toFixed(2) + ' MB'; }

  function copyText(text, btn) {
    if (!text) return;
    var done = function (ok) {
      btn.textContent = ok ? 'Copied!' : 'Failed';
      btn.classList.toggle('copied', ok);
      setTimeout(function () { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2000);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () { done(true); }, function () { done(false); });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.focus(); ta.select();
      var ok = false; try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      document.body.removeChild(ta); done(ok);
    }
  }
  function downloadBytes(bytes, filename, mime) {
    var blob = new Blob([bytes], { type: mime || 'application/octet-stream' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url; a.download = filename;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
  }
  function setEye(input, btn) {
    btn.addEventListener('click', function () {
      var show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      btn.textContent = show ? 'hide' : 'show';
      btn.setAttribute('aria-pressed', show ? 'true' : 'false');
      btn.setAttribute('aria-label', show ? 'Hide passphrase' : 'Show passphrase');
    });
  }

  // ---------- passphrase strength (honest, rough estimate) ----------
  function estimateStrength(pw) {
    if (!pw) return { bits: 0, level: 0, label: 'enter a passphrase' };
    var pool = 0;
    if (/[a-z]/.test(pw)) pool += 26;
    if (/[A-Z]/.test(pw)) pool += 26;
    if (/[0-9]/.test(pw)) pool += 10;
    if (/[^a-zA-Z0-9]/.test(pw)) pool += 33;
    var bits = Math.round(pw.length * Math.log2(pool || 1));
    var distinct = 0, seen = {};
    for (var i = 0; i < pw.length; i++) { if (!seen[pw[i]]) { seen[pw[i]] = 1; distinct++; } }
    if (distinct <= 4 && pw.length > 6) bits = Math.min(bits, distinct * 8); // penalise repetition
    var level = bits < 40 ? 1 : bits < 64 ? 2 : bits < 80 ? 3 : 4;
    var label = bits < 40 ? 'weak' : bits < 64 ? 'fair' : bits < 80 ? 'strong' : 'very strong';
    return { bits: bits, level: level, label: label };
  }

  // ---------- tab switching ----------
  var tabBtns = Array.prototype.slice.call(document.querySelectorAll('#sv-tabs [data-tab]'));
  var panels = { encrypt: $('sv-panel-encrypt'), decrypt: $('sv-panel-decrypt') };
  var activeTab = 'encrypt';
  function switchTab(key) {
    activeTab = key;
    tabBtns.forEach(function (b) {
      var on = b.getAttribute('data-tab') === key;
      b.classList.toggle('active', on);
      b.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    Object.keys(panels).forEach(function (k) { panels[k].hidden = (k !== key); });
  }
  tabBtns.forEach(function (b) { b.addEventListener('click', function () { switchTab(b.getAttribute('data-tab')); }); });

  // ---------- ENCRYPT ----------
  var plainEl = $('sv-plain');
  var dropEnc = $('sv-drop-enc'), fileEncInput = $('sv-file-enc'), fileInfoEl = $('sv-file-info');
  var encPass = $('sv-enc-pass'), encEye = $('sv-enc-eye');
  var meterEl = $('sv-meter'), verdictEl = $('sv-verdict'), bitsEl = $('sv-bits'), bitsWrap = $('sv-bits-wrap'), strengthSep = $('sv-strength-sep');
  var iterEl = $('sv-iter');
  var encBtn = $('sv-enc-btn'), encErr = $('sv-enc-error');
  var encOutArea = $('sv-enc-out-area'), encOut = $('sv-enc-out'), encCopy = $('sv-enc-copy'), encDownload = $('sv-enc-download');

  var pendingFile = null; // { name, bytes }
  var lastBlob = '';

  setEye(encPass, encEye);

  function paintStrength() {
    var s = estimateStrength(encPass.value);
    meterEl.setAttribute('data-level', String(s.level));
    verdictEl.textContent = s.label;
    verdictEl.className = 'sv-verdict lvl-' + s.level;
    var has = s.level > 0;
    strengthSep.hidden = !has; bitsWrap.hidden = !has;
    if (has) bitsEl.textContent = String(s.bits);
  }
  encPass.addEventListener('input', paintStrength);

  function setFile(file) {
    if (file.size > MAX_BYTES) { showEncErr('That file is ' + fmtBytes(file.size) + ' — the limit is 25 MB.'); return; }
    var reader = new FileReader();
    reader.onload = function (e) {
      pendingFile = { name: file.name, bytes: new Uint8Array(e.target.result) };
      plainEl.value = '';
      fileInfoEl.textContent = '';
      var span = document.createElement('span');
      span.textContent = 'File ready: ' + file.name + ' (' + fmtBytes(file.size) + ')';
      var clear = document.createElement('button');
      clear.className = 'sv-clear'; clear.type = 'button'; clear.textContent = 'remove';
      clear.addEventListener('click', clearFile);
      fileInfoEl.appendChild(span); fileInfoEl.appendChild(clear);
      hideEncErr();
    };
    reader.onerror = function () { showEncErr('Could not read that file.'); };
    reader.readAsArrayBuffer(file);
  }
  function clearFile() { pendingFile = null; fileInfoEl.textContent = ''; fileEncInput.value = ''; }

  function wireDrop(zone, input, onFile) {
    zone.addEventListener('click', function () { input.click(); });
    zone.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); } });
    input.addEventListener('change', function () { if (input.files && input.files[0]) onFile(input.files[0]); });
    zone.addEventListener('dragover', function (e) { e.preventDefault(); zone.classList.add('is-drag'); });
    zone.addEventListener('dragleave', function () { zone.classList.remove('is-drag'); });
    zone.addEventListener('drop', function (e) { e.preventDefault(); zone.classList.remove('is-drag'); if (e.dataTransfer.files && e.dataTransfer.files[0]) onFile(e.dataTransfer.files[0]); });
  }
  wireDrop(dropEnc, fileEncInput, setFile);

  function showEncErr(msg) { encErr.textContent = msg; encErr.style.display = ''; }
  function hideEncErr() { encErr.textContent = ''; encErr.style.display = 'none'; }

  function runEncrypt() {
    hideEncErr();
    var pass = encPass.value;
    var hasText = plainEl.value.length > 0;
    if (!pendingFile && !hasText) { showEncErr('Enter some text or drop a file to encrypt.'); return; }
    if (!pass) { showEncErr('Enter a passphrase.'); return; }

    var iterations = parseInt(iterEl.value, 10) || OWASP_ITERATIONS;
    var payload, type, name;
    if (pendingFile) { payload = pendingFile.bytes; type = PT_FILE; name = pendingFile.name; }
    else { payload = strToBytes(plainEl.value); type = PT_TEXT; name = null; }

    encBtn.disabled = true; encBtn.textContent = 'Encrypting…';
    encryptBytes(payload, type, name, pass, iterations).then(function (blob) {
      lastBlob = blob;
      encOut.textContent = blob;
      encOutArea.hidden = false;
      encBtn.disabled = false; encBtn.textContent = 'Encrypt';
      if (window.PF) PF.ready({
        output: blob,
        data: { mode: 'encrypt', cipher: 'AES-256-GCM', kdf: 'PBKDF2-HMAC-SHA256', iterations: iterations, payloadType: type === PT_FILE ? 'file' : 'text', payloadBytes: payload.length, blobChars: blob.length }
      });
    }).catch(function (err) {
      showEncErr('Encryption failed: ' + (err.message || err));
      encBtn.disabled = false; encBtn.textContent = 'Encrypt';
      if (window.PF) PF.fail(err.message || String(err));
    });
  }
  encBtn.addEventListener('click', runEncrypt);
  plainEl.addEventListener('input', function () { if (plainEl.value && pendingFile) clearFile(); });
  plainEl.addEventListener('keydown', function (e) { if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); runEncrypt(); } });
  encCopy.addEventListener('click', function () { copyText(lastBlob, encCopy); });
  encDownload.addEventListener('click', function () { if (lastBlob) downloadBytes(strToBytes(lastBlob), 'secret.vault', 'text/plain'); });

  // ---------- DECRYPT ----------
  var blobEl = $('sv-blob');
  var dropDec = $('sv-drop-dec'), fileDecInput = $('sv-file-dec');
  var headerEl = $('sv-header');
  var decPass = $('sv-dec-pass'), decEye = $('sv-dec-eye');
  var decBtn = $('sv-dec-btn'), decErr = $('sv-dec-error');
  var decOutArea = $('sv-dec-out-area'), decOut = $('sv-dec-out'), decFileEl = $('sv-dec-file');
  var decCopy = $('sv-dec-copy'), decDownload = $('sv-dec-download');

  var lastPlainText = '';   // recovered text (for copy)
  var lastRecovered = null; // { type, filename, payload }

  setEye(decPass, decEye);

  function paintHeader() {
    var v = blobEl.value.trim();
    if (!v) { headerEl.hidden = true; return; }
    var h = parseHeaderSafe(v);
    headerEl.hidden = false;
    headerEl.textContent = '';
    if (!h) {
      headerEl.classList.add('is-bad');
      headerEl.textContent = 'Not a recognized Secret Vault blob yet — paste the full base64 output.';
      return;
    }
    headerEl.classList.remove('is-bad');
    var parts = [
      ['Vault v' + h.version, ' '],
      [h.cipher, ' · '],
      [h.kdf, ' · '],
      [fmtInt(h.iterations) + ' iterations', ' · '],
      ['salt ' + h.saltLen + 'B, IV ' + h.ivLen + 'B', ' · ']
    ];
    var lead = document.createElement('span');
    lead.textContent = 'Detected from header: ';
    headerEl.appendChild(lead);
    parts.forEach(function (p, i) {
      if (i > 0) headerEl.appendChild(document.createTextNode(p[1]));
      var b = document.createElement('b'); b.textContent = p[0]; headerEl.appendChild(b);
    });
  }
  blobEl.addEventListener('input', paintHeader);

  wireDrop(dropDec, fileDecInput, function (file) {
    if (file.size > MAX_BYTES) { showDecErr('That file is too large.'); return; }
    var reader = new FileReader();
    reader.onload = function (e) { blobEl.value = String(e.target.result).trim(); paintHeader(); };
    reader.onerror = function () { showDecErr('Could not read that file.'); };
    reader.readAsText(file);
  });

  function showDecErr(msg) { decErr.textContent = msg; decErr.style.display = ''; }
  function hideDecErr() { decErr.textContent = ''; decErr.style.display = 'none'; }

  function runDecrypt() {
    hideDecErr();
    decOutArea.hidden = true; decOut.textContent = ''; decFileEl.hidden = true; decFileEl.textContent = '';
    var blob = blobEl.value.trim();
    var pass = decPass.value;
    if (!blob) { showDecErr('Paste the encrypted blob to decrypt.'); return; }
    if (!pass) { showDecErr('Enter the passphrase.'); return; }

    decBtn.disabled = true; decBtn.textContent = 'Decrypting…';
    decryptBlob(blob, pass).then(function (res) {
      lastRecovered = res;
      decOutArea.hidden = false;
      if (res.type === 'file') {
        lastPlainText = '';
        decOut.textContent = '';
        var name = res.filename || 'recovered.bin';
        decFileEl.hidden = false;
        var lead = document.createElement('span'); lead.textContent = 'Recovered file: ';
        var strong = document.createElement('b'); strong.textContent = name + ' (' + fmtBytes(res.payload.length) + ')';
        decFileEl.appendChild(lead); decFileEl.appendChild(strong);
        decCopy.style.display = 'none';
      } else {
        decCopy.style.display = '';
        lastPlainText = bytesToStr(res.payload);
        decOut.textContent = lastPlainText; // textContent — never innerHTML of recovered data
      }
      decBtn.disabled = false; decBtn.textContent = 'Decrypt';
      // Honest choice: publish only non-sensitive status/metadata to the agent surface,
      // never the recovered plaintext (it stays in this tab only).
      if (window.PF) PF.ready({
        output: res.type === 'file'
          ? 'Decrypted a file: ' + (res.filename || 'recovered.bin') + ' (' + res.payload.length + ' bytes).'
          : 'Decrypted ' + res.payload.length + ' bytes of text successfully.',
        data: { mode: 'decrypt', ok: true, payloadType: res.type, filename: res.filename, payloadBytes: res.payload.length, cipher: res.header.cipher, kdf: res.header.kdf, iterations: res.header.iterations }
      });
    }).catch(function (err) {
      decBtn.disabled = false; decBtn.textContent = 'Decrypt';
      var msg = err.message === 'WRONG_PASSPHRASE'
        ? 'Could not decrypt — wrong passphrase, or the blob was altered.'
        : (err.message || String(err));
      showDecErr(msg);
      if (window.PF) PF.fail(msg);
    });
  }
  decBtn.addEventListener('click', runDecrypt);
  decCopy.addEventListener('click', function () { copyText(lastPlainText, decCopy); });
  decDownload.addEventListener('click', function () {
    if (!lastRecovered) return;
    if (lastRecovered.type === 'file') downloadBytes(lastRecovered.payload, lastRecovered.filename || 'recovered.bin', 'application/octet-stream');
    else downloadBytes(strToBytes(lastPlainText), 'decrypted.txt', 'text/plain');
  });

  // ---------- Load example (contextual to the active tab, demos instantly) ----------
  var EX_TEXT = 'AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY';
  var EX_PASS = 'moon-lantern-quartz-echo-7';
  $('sv-example').addEventListener('click', function () {
    if (activeTab === 'encrypt') {
      clearFile();
      plainEl.value = EX_TEXT;
      encPass.value = EX_PASS;
      paintStrength();
      runEncrypt();
    } else {
      decPass.value = EX_PASS;
      // Generate a fresh blob live so the demo shows a true round trip.
      encryptBytes(strToBytes(EX_TEXT), PT_TEXT, null, EX_PASS, OWASP_ITERATIONS).then(function (blob) {
        blobEl.value = blob;
        paintHeader();
        runDecrypt();
      });
    }
  });

  // ---------- Agent I/O (window.PF from /js/tool-io.js) ----------
  // Encryption is not URL-safe to auto-run (a passphrase must never ride in a URL),
  // so there is no auto-invoke. We still publish a machine-readable ready status.
  paintStrength();
  if (window.PF) {
    PF.ready({
      output: 'Secret Vault ready. Choose Encrypt or Decrypt. AES-256-GCM with PBKDF2-HMAC-SHA256 (600,000 iterations); everything runs locally, nothing is uploaded, and encryption is never auto-invoked from a URL.',
      data: { modes: ['encrypt', 'decrypt'], cipher: 'AES-256-GCM', kdf: 'PBKDF2-HMAC-SHA256', defaultIterations: OWASP_ITERATIONS, blobFormat: 'PFV1 (base64: magic+kdf+cipher+iterations+salt+iv+ciphertext)', autoInvoke: false }
    });
  }
</script>
