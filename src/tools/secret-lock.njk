---
toolSlug: secret-lock
permalink: /tools/secret-lock/
---

<div class="tool-group">
  <label for="sl-secret">Your secret</label>
  <textarea id="sl-secret" rows="6" placeholder="Paste the text you want to encrypt — API keys, passwords, credentials, notes..." spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
</div>

<div class="tool-group">
  <label for="sl-passphrase">Passphrase</label>
  <input type="password" id="sl-passphrase" placeholder="Choose a strong passphrase known only to you and your recipient" autocomplete="new-password" spellcheck="false">
</div>

<div class="tool-row">
  <button class="btn btn--primary" id="btn-encrypt">Encrypt</button>
</div>

<div id="sl-error" style="display:none;" role="alert" aria-live="polite" class="tool-error"></div>

<div class="output-area">
  <button class="btn btn--copy" id="btn-copy" aria-label="Copy ciphertext">Copy</button>
  <pre id="sl-output" aria-label="Encrypted ciphertext"></pre>
</div>

<p style="margin:0.75rem 0 0; font-size:0.8125rem; color:var(--text-3);">
  Decrypt this ciphertext using <a href="/tools/view-lock/" style="color:var(--accent);">View Lock</a> — enter the ciphertext and the same passphrase.
</p>

<hr>

<div>
  <h2 style="font-size:1rem; font-weight:700; margin:0 0 1rem;">Related tools in this workflow</h2>
  <div class="tool-related-grid">
    <a href="/tools/view-lock/" class="tool-related-card">
      <h4>View Lock</h4>
      <p>Decrypt a Secret Lock ciphertext</p>
    </a>
    <a href="/tools/one-time-secret/" class="tool-related-card">
      <h4>One-Time Secret</h4>
      <p>Burn-after-reading secret links</p>
    </a>
    <a href="/tools/password-generator/" class="tool-related-card">
      <h4>Password Generator</h4>
      <p>Generate a strong passphrase first</p>
    </a>
  </div>
</div>

<script>
(function () {
  var secretEl  = document.getElementById('sl-secret');
  var phraseEl  = document.getElementById('sl-passphrase');
  var encryptBtn = document.getElementById('btn-encrypt');
  var outputEl  = document.getElementById('sl-output');
  var errorEl   = document.getElementById('sl-error');
  var copyBtn   = document.getElementById('btn-copy');

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.style.display = '';
    outputEl.textContent = '';
  }

  function hideError() {
    errorEl.textContent = '';
    errorEl.style.display = 'none';
  }

  function bufToBase64(buf) {
    var bytes = new Uint8Array(buf);
    var binary = '';
    for (var i = 0; i < bytes.length; i++) {
      binary += String.fromCharCode(bytes[i]);
    }
    return btoa(binary);
  }

  function encrypt() {
    var secret = secretEl.value;
    var passphrase = phraseEl.value;

    if (!secret) {
      showError('Enter the secret text you want to encrypt.');
      return;
    }
    if (!passphrase) {
      showError('Enter a passphrase.');
      return;
    }

    hideError();
    encryptBtn.disabled = true;
    encryptBtn.textContent = 'Encrypting\u2026';

    var encoder = new TextEncoder();
    var salt = window.crypto.getRandomValues(new Uint8Array(16));
    var iv   = window.crypto.getRandomValues(new Uint8Array(12));

    window.crypto.subtle.importKey(
      'raw',
      encoder.encode(passphrase),
      { name: 'PBKDF2' },
      false,
      ['deriveKey']
    ).then(function (baseKey) {
      return window.crypto.subtle.deriveKey(
        {
          name: 'PBKDF2',
          salt: salt,
          iterations: 100000,
          hash: 'SHA-256'
        },
        baseKey,
        { name: 'AES-GCM', length: 256 },
        false,
        ['encrypt']
      );
    }).then(function (aesKey) {
      return window.crypto.subtle.encrypt(
        { name: 'AES-GCM', iv: iv },
        aesKey,
        encoder.encode(secret)
      );
    }).then(function (ciphertext) {
      // Output format: base64(salt[16] + iv[12] + ciphertext+tag)
      var combined = new Uint8Array(16 + 12 + ciphertext.byteLength);
      combined.set(salt, 0);
      combined.set(iv, 16);
      combined.set(new Uint8Array(ciphertext), 28);
      outputEl.textContent = bufToBase64(combined.buffer);
      encryptBtn.disabled = false;
      encryptBtn.textContent = 'Encrypt';
    }).catch(function (err) {
      showError('Encryption failed: ' + (err.message || err));
      encryptBtn.disabled = false;
      encryptBtn.textContent = 'Encrypt';
    });
  }

  encryptBtn.addEventListener('click', encrypt);

  // Allow Ctrl+Enter / Cmd+Enter inside the textarea to trigger encryption
  secretEl.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
      e.preventDefault();
      encrypt();
    }
  });

  copyBtn.addEventListener('click', function () {
    var text = outputEl.textContent;
    if (!text) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () {
        copyBtn.textContent = 'Copied!';
        setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
      }).catch(function () {
        copyBtn.textContent = 'Failed';
        setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
      });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try {
        document.execCommand('copy');
        copyBtn.textContent = 'Copied!';
      } catch (e) {
        copyBtn.textContent = 'Failed';
      }
      document.body.removeChild(ta);
      setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
    }
  });
})();
</script>
