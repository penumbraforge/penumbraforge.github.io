---
toolSlug: password-generator
permalink: /tools/password-generator/
---

<div class="pwgen" data-slug="password-generator">

  <div class="tool-row" style="margin-bottom:16px;">
    <div class="tool-options" role="group" aria-label="Generator mode">
      <button class="tool-option active" data-mode="password" aria-pressed="true">Password</button>
      <button class="tool-option" data-mode="passphrase" aria-pressed="false">Passphrase</button>
    </div>
  </div>

  <div class="output-area">
    <button class="btn btn--copy" id="pw-copy" aria-label="Copy generated secret">Copy</button>
    <div id="pw-out" class="pw-out" role="status" aria-live="polite" aria-label="Generated secret"></div>
  </div>

  <div class="pw-strength">
    <div class="pw-meter" id="pw-meter" data-level="0" role="img" aria-label="Strength meter">
      <span class="pw-pip"></span><span class="pw-pip"></span><span class="pw-pip"></span><span class="pw-pip"></span>
    </div>
    <div class="pw-stats" aria-live="polite">
      <span class="pw-verdict lvl-0" id="pw-verdict">&mdash;</span>
      <span class="pw-dot">·</span>
      <span><b id="pw-bits">0</b> bits entropy</span>
      <span class="pw-dot">·</span>
      <span>offline crack time <b id="pw-crack" title="Attacker at ~10^11 guesses/sec (fast offline hash)">&mdash;</b></span>
    </div>
  </div>

  <div class="tool-row" style="margin-top:16px; margin-bottom:6px;">
    <button class="btn btn--primary" id="pw-regen" type="button">&#8635; Regenerate</button>
    <span class="pw-hint">Generated locally with <code>crypto.getRandomValues</code> &mdash; nothing is transmitted.</span>
  </div>

  <div id="pw-error" class="tool-error" role="alert" aria-live="polite" style="display:none;"></div>

  <hr>

  <!-- ============ PASSWORD CONTROLS ============ -->
  <div id="pw-panel-password">
    <div class="tool-group">
      <label for="pw-len">Length &mdash; <span id="pw-len-val">20</span> characters</label>
      <input type="range" id="pw-len" min="8" max="128" value="20" step="1"
             aria-valuemin="8" aria-valuemax="128" aria-valuenow="20">
    </div>
    <div class="tool-group">
      <label>Character sets</label>
      <div class="tool-row pw-sets" role="group" aria-label="Character sets">
        <button class="tool-option active" data-set="upper"   aria-pressed="true">A&ndash;Z</button>
        <button class="tool-option active" data-set="lower"   aria-pressed="true">a&ndash;z</button>
        <button class="tool-option active" data-set="digits"  aria-pressed="true">0&ndash;9</button>
        <button class="tool-option active" data-set="symbols" aria-pressed="true">!@#$</button>
      </div>
    </div>
  </div>

  <!-- ============ PASSPHRASE CONTROLS ============ -->
  <div id="pw-panel-passphrase" hidden>
    <div class="tool-group">
      <label for="pw-words">Words &mdash; <span id="pw-words-val">6</span></label>
      <input type="range" id="pw-words" min="3" max="12" value="6" step="1"
             aria-valuemin="3" aria-valuemax="12" aria-valuenow="6">
    </div>
    <div class="tool-group">
      <label>Separator</label>
      <div class="tool-options pw-seps" role="group" aria-label="Word separator">
        <button class="tool-option active" data-sep="-" aria-pressed="true">dash</button>
        <button class="tool-option" data-sep="." aria-pressed="false">dot</button>
        <button class="tool-option" data-sep=" " aria-pressed="false">space</button>
        <button class="tool-option" data-sep="_" aria-pressed="false">under</button>
        <button class="tool-option" data-sep="#" aria-pressed="false">digit</button>
      </div>
    </div>
    <div class="tool-group">
      <label>Style</label>
      <div class="tool-row">
        <button class="tool-option" id="pw-cap" data-on="0" aria-pressed="false" type="button">Capitalize words</button>
      </div>
    </div>
  </div>

</div>

<style>
  .pwgen .pw-out {
    font-family: var(--font-mono); font-size: 20px; line-height: 1.55;
    letter-spacing: 0.5px; word-break: break-all; white-space: pre-wrap;
    min-height: 30px; padding-right: 58px; user-select: all; -webkit-user-select: all;
  }
  .pwgen .pw-c-alpha { color: var(--text-1); }
  .pwgen .pw-c-num   { color: var(--accent-strong); }
  .pwgen .pw-c-sym   { color: #e0a458; }
  .pwgen .pw-c-space { color: var(--text-3); }

  .pwgen .pw-strength { margin-top: 14px; display: flex; flex-direction: column; gap: 9px; }
  .pwgen .pw-meter { display: flex; gap: 5px; }
  .pwgen .pw-pip {
    height: 6px; flex: 1; border-radius: 2px;
    background: var(--surface-2); border: 1px solid var(--wb-line);
    transition: background 200ms, border-color 200ms, box-shadow 200ms;
  }
  .pwgen .pw-meter[data-level="1"] .pw-pip:nth-child(-n+1) { background: #e06c6c; border-color: #e06c6c; }
  .pwgen .pw-meter[data-level="2"] .pw-pip:nth-child(-n+2) { background: #e0a458; border-color: #e0a458; }
  .pwgen .pw-meter[data-level="3"] .pw-pip:nth-child(-n+3) { background: var(--sage); border-color: var(--sage); }
  .pwgen .pw-meter[data-level="4"] .pw-pip:nth-child(-n+4) {
    background: var(--sage); border-color: var(--sage);
    box-shadow: 0 0 9px color-mix(in oklab, var(--sage) 45%, transparent);
  }

  .pwgen .pw-stats {
    font-family: var(--font-mono); font-size: 11.5px; color: var(--text-3);
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px;
  }
  .pwgen .pw-stats b { color: var(--text-1); font-weight: 500; }
  .pwgen .pw-dot { color: var(--wb-line); }
  .pwgen .pw-verdict { font-weight: 600; text-transform: uppercase; letter-spacing: 1.2px; font-size: 10.5px; }
  .pwgen .pw-verdict.lvl-0 { color: var(--text-3); }
  .pwgen .pw-verdict.lvl-1 { color: #e06c6c; }
  .pwgen .pw-verdict.lvl-2 { color: #e0a458; }
  .pwgen .pw-verdict.lvl-3,
  .pwgen .pw-verdict.lvl-4 { color: var(--sage); }

  .pwgen .pw-hint { font-family: var(--font-mono); font-size: 11px; color: var(--text-3); line-height: 1.5; }
  .pwgen .pw-hint code { color: var(--slate); font-size: 11px; }

  .pwgen input[type="range"] {
    -webkit-appearance: none; appearance: none; width: 100%; height: 4px;
    border-radius: 3px; background: var(--surface-2); border: 1px solid var(--wb-line);
    outline: none; cursor: pointer; padding: 0;
  }
  .pwgen input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none; width: 16px; height: 16px;
    border-radius: 50%; background: var(--accent); border: 2px solid #06060d;
    cursor: pointer; box-shadow: 0 0 0 1px var(--wb-line-bright);
  }
  .pwgen input[type="range"]::-moz-range-thumb {
    width: 16px; height: 16px; border-radius: 50%; background: var(--accent);
    border: 2px solid #06060d; cursor: pointer;
  }
  .pwgen input[type="range"]:focus-visible { box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 12%, transparent); }
  .pwgen .pw-sets .tool-option { min-width: 66px; text-align: center; }
</style>

<script type="module">
  import { password } from '/js/tools-lib.js';

  // ---- ~230-word diceware list (deduped at runtime; short, memorable, safe) ----
  var WORDLIST = (
    'able acid acorn acre agile amber anchor angle ankle apple apron arbor arch arrow ash ' +
    'aster atlas atom aura autumn azure bacon badge bagel bamboo band barn basil basin bay ' +
    'beach beam bean bear beetle bell berry birch bison black blade blaze bloom blue boat ' +
    'bold bolt bone bonus book boot bottle boulder bow bramble branch brass brave bread brick ' +
    'brief brisk broom brush bubble buffer bugle bulb burst cabin cable cactus cake calm camel ' +
    'candle cane canyon cape carbon card cargo carrot cave cedar cell chalk charm cherry chess ' +
    'chime cider cinder cliff cloak cloud clover coal coast cobalt cocoa comet coral cork cove ' +
    'coyote crane crate crest crow crown crystal cube dagger daisy dawn deck deer delta denim ' +
    'desert diamond dice diode dock dome donut dove dragon dune dusk eagle earth ebony echo ember ' +
    'emerald ether fable falcon fern ferry fiber flame flint flora fog forest fossil frost ' +
    'galaxy garden gecko gem geode ginger glacier glass globe glow gold granite grape grid grove ' +
    'gulf harbor harp hawk hazel heron hive honey ivory jade jasper jet jungle kelp kite koala ' +
    'lagoon lantern lark laurel lava leaf ledge lemon lily linen lion lotus lumen lunar lyric ' +
    'magnet maple marble marsh meadow melon meteor mint mist moon moss motet mule myth nebula ' +
    'nectar needle nickel nimbus noble nomad north nova oak oasis ocean olive onyx opal orbit ' +
    'orchid otter oxide palm panda pearl pebble pepper pine pixel plum pond poplar prism pulse ' +
    'quartz quest quill radar raft rain raven reef relay resin ridge rift river robin rocket rose ' +
    'ruby rune saddle sage sail salt sand sapphire scarf sequoia shadow shale shell shore signal ' +
    'silk silver siren sky slate sled sloth smoke snow solar sonar spark spice spire spruce star ' +
    'steel stone storm summit surf swan swift sword talon tango teak tempo thorn tide tiger timber ' +
    'topaz torch totem tower trail tulip tundra turtle umber unity urban vale valley vapor vault ' +
    'velvet vertex vine violet vivid vortex walnut wave wharf wheat whisk widget willow wind wing ' +
    'wolf wombat wren yarn yeti zephyr zinc zone'
  ).trim().split(/\s+/);
  var WORDS = [];
  (function () { var seen = {}; for (var i = 0; i < WORDLIST.length; i++) { var w = WORDLIST[i]; if (!seen[w]) { seen[w] = 1; WORDS.push(w); } } })();

  // ---- DOM ----
  var outEl     = document.getElementById('pw-out');
  var copyBtn   = document.getElementById('pw-copy');
  var regenBtn  = document.getElementById('pw-regen');
  var errorEl   = document.getElementById('pw-error');
  var meterEl   = document.getElementById('pw-meter');
  var verdictEl = document.getElementById('pw-verdict');
  var bitsEl    = document.getElementById('pw-bits');
  var crackEl   = document.getElementById('pw-crack');

  var lenEl     = document.getElementById('pw-len');
  var lenValEl  = document.getElementById('pw-len-val');
  var wordsEl   = document.getElementById('pw-words');
  var wordsValEl= document.getElementById('pw-words-val');
  var capBtn    = document.getElementById('pw-cap');

  var panelPass   = document.getElementById('pw-panel-password');
  var panelPhrase = document.getElementById('pw-panel-passphrase');

  // ---- state ----
  var mode  = 'password';
  var len   = 20;
  var sets  = { upper: true, lower: true, digits: true, symbols: true };
  var words = 6;
  var sep   = '-';
  var cap   = false;
  var currentSecret = '';

  // ---- helpers ----
  function clamp(n, lo, hi) { return Math.max(lo, Math.min(hi, n)); }
  function truthy(v) { v = String(v).toLowerCase(); return v === '1' || v === 'true' || v === 'on' || v === 'yes'; }

  // unbiased random integer in [0, n) via rejection sampling
  function randInt(n) {
    if (n <= 0) return 0;
    var max = Math.floor(0x100000000 / n) * n;
    var a = new Uint32Array(1), r;
    do { crypto.getRandomValues(a); r = a[0]; } while (r >= max);
    return r % n;
  }

  function strengthOf(bits) {
    if (bits < 50)  return { label: 'weak', level: 1 };
    if (bits < 80)  return { label: 'fair', level: 2 };
    if (bits < 120) return { label: 'strong', level: 3 };
    return { label: 'very strong', level: 4 };
  }

  var LOG10_2 = Math.LN2 / Math.LN10; // 0.30103
  // Average offline crack time. avg guesses = 2^(bits-1); attacker = 1e11 guesses/sec.
  function crackTime(bits) {
    if (!isFinite(bits) || bits <= 1) return 'instant';
    var log10s = (bits - 1) * LOG10_2 - 11; // log10 of seconds
    if (log10s < -0.3) return 'instant';     // < ~0.5s
    var YEAR = 31557600;
    var log10years = log10s - Math.log10(YEAR);
    if (log10years >= 6) {
      var exp = Math.floor(log10years);
      var mant = Math.pow(10, log10years - exp);
      mant = Math.round(mant * 10) / 10;
      if (mant >= 10) { mant /= 10; exp++; }
      return mant + ' × 10^' + exp + ' years';
    }
    var steps = [
      { u: 'second', per: 1 }, { u: 'minute', per: 60 }, { u: 'hour', per: 3600 },
      { u: 'day', per: 86400 }, { u: 'month', per: 2629800 }, { u: 'year', per: YEAR }
    ];
    var chosen = steps[0];
    for (var i = 0; i < steps.length; i++) { if (log10s >= Math.log10(steps[i].per)) chosen = steps[i]; }
    var val = Math.pow(10, log10s - Math.log10(chosen.per));
    var rounded = val >= 100 ? Math.round(val) : Math.round(val * 10) / 10;
    var label = chosen.u + (rounded === 1 ? '' : 's');
    return rounded.toLocaleString('en-US') + ' ' + label;
  }

  function showError(msg) { errorEl.textContent = msg; errorEl.style.display = ''; }
  function hideError() { errorEl.textContent = ''; errorEl.style.display = 'none'; }

  // ---- generation ----
  function genPassword() {
    var opts = { length: len, upper: sets.upper, lower: sets.lower, digits: sets.digits, symbols: sets.symbols };
    var res = password(opts); // { output, length, entropyBits, strength } — the shared brain
    return {
      secret: res.output,
      bits: res.entropyBits,
      meta: { length: res.length, charsets: Object.keys(sets).filter(function (k) { return sets[k]; }) }
    };
  }

  function genPassphrase() {
    var n = WORDS.length, parts = [];
    for (var i = 0; i < words; i++) {
      var w = WORDS[randInt(n)];
      if (cap) w = w.charAt(0).toUpperCase() + w.slice(1);
      parts.push(w);
    }
    var out, bits = words * Math.log2(n);
    if (sep === '#') {
      out = parts[0];
      for (var j = 1; j < parts.length; j++) { out += String(randInt(10)) + parts[j]; }
      bits += (words - 1) * Math.log2(10); // random digit separators add real entropy
    } else {
      out = parts.join(sep);
    }
    return {
      secret: out,
      bits: Math.round(bits),
      meta: { words: words, wordlistSize: n, separator: sep === '#' ? 'random-digit' : (sep === ' ' ? 'space' : sep), capitalized: cap }
    };
  }

  function renderSecret(str) {
    outEl.textContent = '';
    if (!str) return;
    var frag = document.createDocumentFragment();
    for (var i = 0; i < str.length; i++) {
      var ch = str[i], cls;
      if (ch === ' ') cls = 'pw-c-space';
      else if (ch >= '0' && ch <= '9') cls = 'pw-c-num';
      else if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')) cls = 'pw-c-alpha';
      else cls = 'pw-c-sym';
      var span = document.createElement('span');
      span.className = cls;
      span.textContent = (ch === ' ') ? '·' : ch; // show middot for spaces; real value stays in currentSecret
      frag.appendChild(span);
    }
    outEl.appendChild(frag);
  }

  function generate() {
    hideError();
    var r;
    try {
      r = (mode === 'password') ? genPassword() : genPassphrase();
    } catch (e) {
      showError('Generation error: ' + e.message);
      if (window.PF) PF.fail(e.message);
      return;
    }
    currentSecret = r.secret;
    renderSecret(r.secret);
    var s = strengthOf(r.bits);
    meterEl.setAttribute('data-level', String(s.level));
    verdictEl.textContent = s.label;
    verdictEl.className = 'pw-verdict lvl-' + s.level;
    bitsEl.textContent = String(r.bits);
    crackEl.textContent = crackTime(r.bits);
    if (window.PF) {
      PF.ready({
        output: r.secret,
        data: Object.assign({ mode: mode, entropyBits: r.bits, strength: s.label, crackTime: crackTime(r.bits) }, r.meta)
      });
    }
  }

  // ---- mode switch ----
  function setMode(m) {
    mode = (m === 'passphrase') ? 'passphrase' : 'password';
    Array.prototype.forEach.call(document.querySelectorAll('.tool-option[data-mode]'), function (b) {
      var on = b.getAttribute('data-mode') === mode;
      b.classList.toggle('active', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    panelPass.hidden = (mode !== 'password');
    panelPhrase.hidden = (mode !== 'passphrase');
    copyBtn.setAttribute('aria-label', 'Copy generated ' + mode);
  }

  // ---- character-set toggles (multi-select, keep >=1 active) ----
  function setSetBtn(btn, on) {
    btn.classList.toggle('active', on);
    btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    sets[btn.getAttribute('data-set')] = on;
  }
  Array.prototype.forEach.call(document.querySelectorAll('.tool-option[data-set]'), function (btn) {
    btn.addEventListener('click', function () {
      var key = btn.getAttribute('data-set');
      var next = !sets[key];
      if (!next) {
        var active = Object.keys(sets).filter(function (k) { return sets[k]; });
        if (active.length <= 1) return; // never allow zero character sets
      }
      setSetBtn(btn, next);
      generate();
    });
  });

  // ---- separator toggles (single-select) ----
  Array.prototype.forEach.call(document.querySelectorAll('.tool-option[data-sep]'), function (btn) {
    btn.addEventListener('click', function () {
      Array.prototype.forEach.call(document.querySelectorAll('.tool-option[data-sep]'), function (b) {
        b.classList.remove('active'); b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active'); btn.setAttribute('aria-pressed', 'true');
      sep = btn.getAttribute('data-sep');
      generate();
    });
  });

  // ---- capitalize toggle ----
  capBtn.addEventListener('click', function () {
    cap = !cap;
    capBtn.classList.toggle('active', cap);
    capBtn.setAttribute('aria-pressed', cap ? 'true' : 'false');
    capBtn.setAttribute('data-on', cap ? '1' : '0');
    generate();
  });

  // ---- sliders ----
  lenEl.addEventListener('input', function () {
    len = clamp(parseInt(lenEl.value, 10) || 20, 8, 128);
    lenValEl.textContent = String(len);
    lenEl.setAttribute('aria-valuenow', String(len));
    generate();
  });
  wordsEl.addEventListener('input', function () {
    words = clamp(parseInt(wordsEl.value, 10) || 5, 3, 12);
    wordsValEl.textContent = String(words);
    wordsEl.setAttribute('aria-valuenow', String(words));
    generate();
  });

  // ---- mode buttons ----
  Array.prototype.forEach.call(document.querySelectorAll('.tool-option[data-mode]'), function (btn) {
    btn.addEventListener('click', function () { setMode(btn.getAttribute('data-mode')); generate(); });
  });

  regenBtn.addEventListener('click', generate);

  // ---- copy (copies the REAL secret, not the middot-rendered display) ----
  copyBtn.addEventListener('click', function () {
    if (!currentSecret) return;
    var done = function (ok) {
      copyBtn.textContent = ok ? 'Copied!' : 'Failed';
      copyBtn.classList.toggle('copied', ok);
      setTimeout(function () { copyBtn.textContent = 'Copy'; copyBtn.classList.remove('copied'); }, 2000);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(currentSecret).then(function () { done(true); }, function () { done(false); });
    } else {
      var ta = document.createElement('textarea');
      ta.value = currentSecret; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.focus(); ta.select();
      var ok = false; try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      document.body.removeChild(ta); done(ok);
    }
  });

  // ---- Agent I/O + URL-invoke (window.PF from /js/tool-io.js) ----
  function applyParams(p) {
    if (!p) return;
    if (p.mode === 'passphrase' || p.mode === 'phrase') setMode('passphrase');
    else if (p.mode === 'password') setMode('password');

    if (p.len != null) {
      var L = parseInt(p.len, 10);
      if (!isNaN(L)) { len = clamp(L, 8, 128); lenEl.value = String(len); lenValEl.textContent = String(len); lenEl.setAttribute('aria-valuenow', String(len)); }
    }
    ['upper', 'lower', 'digits', 'symbols'].forEach(function (k) {
      if (p[k] != null) {
        var btn = document.querySelector('.tool-option[data-set="' + k + '"]');
        if (btn) setSetBtn(btn, truthy(p[k]));
      }
    });
    // guard: at least one set must remain on
    if (!Object.keys(sets).some(function (k) { return sets[k]; })) {
      var lb = document.querySelector('.tool-option[data-set="lower"]');
      if (lb) setSetBtn(lb, true);
    }
    if (p.words != null) {
      var W = parseInt(p.words, 10);
      if (!isNaN(W)) { words = clamp(W, 3, 12); wordsEl.value = String(words); wordsValEl.textContent = String(words); wordsEl.setAttribute('aria-valuenow', String(words)); }
    }
    if (p.sep != null) {
      var sv = p.sep === 'space' ? ' ' : p.sep === 'digit' ? '#' : p.sep;
      var sb = document.querySelector('.tool-option[data-sep="' + sv + '"]');
      if (sb) sb.click();
    }
    if (p.cap != null) {
      var want = truthy(p.cap);
      if (want !== cap) capBtn.click();
    }
  }

  if (window.PF) { applyParams(PF.input()); }
  generate(); // always produce output on load (demos instantly + agent-ready)
</script>
