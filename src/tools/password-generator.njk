---
toolSlug: password-generator
permalink: /tools/password-generator/
---

<div class="tool-row">
  <div class="tool-group" style="flex:1;">
    <label for="pw-length">Length: <span id="pw-length-display">16</span></label>
    <input type="range" id="pw-length" min="8" max="128" value="16" style="width:100%;">
  </div>
</div>

<div class="tool-row">
  <div class="tool-group" style="flex:1;">
    <label>Character sets</label>
    <div style="display:flex; gap:1rem; flex-wrap:wrap; margin-top:0.4rem;">
      <label style="display:flex; align-items:center; gap:0.4rem; font-weight:normal; cursor:pointer;">
        <input type="checkbox" id="pw-upper" checked> Uppercase (A–Z)
      </label>
      <label style="display:flex; align-items:center; gap:0.4rem; font-weight:normal; cursor:pointer;">
        <input type="checkbox" id="pw-lower" checked> Lowercase (a–z)
      </label>
      <label style="display:flex; align-items:center; gap:0.4rem; font-weight:normal; cursor:pointer;">
        <input type="checkbox" id="pw-numbers" checked> Numbers (0–9)
      </label>
      <label style="display:flex; align-items:center; gap:0.4rem; font-weight:normal; cursor:pointer;">
        <input type="checkbox" id="pw-symbols" checked> Symbols (!@#$…)
      </label>
    </div>
  </div>
</div>

<div class="tool-row">
  <div class="tool-group" style="flex:1;">
    <label for="pw-exclude">Exclude characters</label>
    <input type="text" id="pw-exclude" placeholder="e.g. 0Ol1I" style="width:200px;" spellcheck="false" autocomplete="off">
  </div>
  <div class="tool-group" style="flex:1;">
    <label>Bulk mode</label>
    <div class="tool-options" role="group" aria-label="Bulk mode">
      <button class="tool-option active" data-bulk="1" aria-pressed="true">1</button>
      <button class="tool-option" data-bulk="5" aria-pressed="false">5</button>
      <button class="tool-option" data-bulk="10" aria-pressed="false">10</button>
    </div>
  </div>
</div>

<div class="tool-row">
  <button class="btn btn--primary" id="btn-generate">Generate</button>
</div>

<div id="pw-error" style="display:none;" role="alert" aria-live="polite" class="tool-error"></div>

<div class="output-area">
  <button class="btn btn--copy" id="btn-copy" aria-label="Copy password">Copy</button>
  <pre id="pw-output" aria-label="Generated password" style="word-break:break-all; white-space:pre-wrap;"></pre>
</div>

<div id="pw-meta" style="margin-top:0.75rem; display:none;">
  <div style="display:flex; align-items:center; gap:1rem; flex-wrap:wrap;">
    <span id="pw-entropy" style="font-size:0.875rem; color:var(--text-secondary, #6b7280);"></span>
    <span id="pw-strength-label" style="font-size:0.875rem; font-weight:600;"></span>
  </div>
  <div id="pw-strength-bar-wrap" style="margin-top:0.5rem; height:6px; background:var(--border, #e5e7eb); border-radius:3px; overflow:hidden;">
    <div id="pw-strength-bar" style="height:100%; width:0; border-radius:3px; transition:width 0.3s, background 0.3s;"></div>
  </div>
</div>

<script>
(function () {
  var UPPER   = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  var LOWER   = 'abcdefghijklmnopqrstuvwxyz';
  var NUMBERS = '0123456789';
  var SYMBOLS = '!@#$%^&*()-_=+[]{}|;:,.<>?/~`';

  var outputEl    = document.getElementById('pw-output');
  var errorEl     = document.getElementById('pw-error');
  var copyBtn     = document.getElementById('btn-copy');
  var genBtn      = document.getElementById('btn-generate');
  var lengthEl    = document.getElementById('pw-length');
  var lengthDisp  = document.getElementById('pw-length-display');
  var excludeEl   = document.getElementById('pw-exclude');
  var upperCb     = document.getElementById('pw-upper');
  var lowerCb     = document.getElementById('pw-lower');
  var numbersCb   = document.getElementById('pw-numbers');
  var symbolsCb   = document.getElementById('pw-symbols');
  var metaEl      = document.getElementById('pw-meta');
  var entropyEl   = document.getElementById('pw-entropy');
  var strengthLbl = document.getElementById('pw-strength-label');
  var strengthBar = document.getElementById('pw-strength-bar');

  var bulkCount = 1;

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.style.display = '';
  }

  function hideError() {
    errorEl.textContent = '';
    errorEl.style.display = 'none';
  }

  function buildCharset() {
    var exclude = excludeEl.value;
    var charset = '';
    if (upperCb.checked)   charset += UPPER;
    if (lowerCb.checked)   charset += LOWER;
    if (numbersCb.checked) charset += NUMBERS;
    if (symbolsCb.checked) charset += SYMBOLS;
    if (exclude) {
      var result = '';
      for (var i = 0; i < charset.length; i++) {
        if (exclude.indexOf(charset[i]) === -1) result += charset[i];
      }
      return result;
    }
    return charset;
  }

  function randomPassword(charset, length) {
    var bytes = new Uint32Array(length);
    crypto.getRandomValues(bytes);
    var result = '';
    for (var i = 0; i < length; i++) {
      result += charset[bytes[i] % charset.length];
    }
    return result;
  }

  function calcEntropy(charsetSize, length) {
    if (charsetSize <= 0) return 0;
    return Math.floor(length * Math.log2(charsetSize));
  }

  function strengthInfo(bits) {
    if (bits < 40)  return { label: 'Weak',   color: '#ef4444', pct: 20 };
    if (bits < 60)  return { label: 'Fair',   color: '#f97316', pct: 45 };
    if (bits < 80)  return { label: 'Good',   color: '#eab308', pct: 70 };
    return           { label: 'Strong', color: '#22c55e', pct: 100 };
  }

  function generate() {
    var length  = parseInt(lengthEl.value, 10);
    var charset = buildCharset();

    if (!charset) {
      showError('Select at least one character set.');
      outputEl.textContent = '';
      metaEl.style.display = 'none';
      return;
    }
    hideError();

    var lines = [];
    for (var i = 0; i < bulkCount; i++) {
      lines.push(randomPassword(charset, length));
    }
    outputEl.textContent = lines.join('\n');

    // Entropy & strength based on single password
    var bits  = calcEntropy(charset.length, length);
    var info  = strengthInfo(bits);
    entropyEl.textContent     = 'Entropy: ~' + bits + ' bits';
    strengthLbl.textContent   = info.label;
    strengthLbl.style.color   = info.color;
    strengthBar.style.width   = info.pct + '%';
    strengthBar.style.background = info.color;
    metaEl.style.display      = '';
  }

  lengthEl.addEventListener('input', function () {
    lengthDisp.textContent = lengthEl.value;
  });

  genBtn.addEventListener('click', generate);

  // Bulk toggle
  var bulkBtns = Array.prototype.slice.call(document.querySelectorAll('.tool-option[data-bulk]'));
  bulkBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      bulkBtns.forEach(function (b) {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      bulkCount = parseInt(btn.getAttribute('data-bulk'), 10);
    });
  });

  copyBtn.addEventListener('click', function () {
    var text = outputEl.textContent;
    if (!text) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () {
        copyBtn.textContent = 'Copied!';
        setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
      }).catch(function () {
        copyBtn.textContent = 'Failed';
        setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
      });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try {
        document.execCommand('copy');
        copyBtn.textContent = 'Copied!';
      } catch (e) {
        copyBtn.textContent = 'Failed';
      }
      document.body.removeChild(ta);
      setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
    }
  });

  generate();
})();
</script>
