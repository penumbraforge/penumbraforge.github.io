---
toolSlug: waf-rule-builder
permalink: /tools/waf-rule-builder/
---

<div class="tool-group">
  <label for="waf-rule-name">Rule name</label>
  <input type="text" id="waf-rule-name" placeholder="e.g. block-sqli-union" spellcheck="false" autocomplete="off" value="custom-waf-rule">
</div>

<div class="tool-group">
  <label for="waf-regex">Regex pattern</label>
  <textarea id="waf-regex" rows="3" placeholder="(?i)(union\s+(all\s+)?select|select\s+.*\s+from\s+)" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
  <div class="waf-regex-meta" id="waf-regex-meta"></div>
</div>

<div class="tool-row" style="flex-wrap:wrap;gap:0.5rem;">
  <div class="tool-group" style="margin-bottom:0;flex:0 0 auto;">
    <label for="waf-action" style="font-size:0.75rem;margin-bottom:2px;">Action</label>
    <select id="waf-action">
      <option value="block">Block</option>
      <option value="log">Log</option>
      <option value="challenge">Challenge</option>
    </select>
  </div>
  <div style="display:flex;gap:0.5rem;align-items:flex-end;flex:1;">
    <button class="btn btn--primary" id="waf-test-btn">Test Pattern</button>
    <button class="btn" id="waf-example-btn">Try Example</button>
    <button class="btn" id="waf-clear-btn">Clear</button>
  </div>
</div>

<div id="waf-score" style="display:none;" class="waf-score-bar"></div>

<div id="waf-results" style="display:none;">
  <div class="waf-results-tabs" id="waf-tabs">
    <button class="waf-tab waf-tab--active" data-tab="payloads">Payload Results</button>
    <button class="waf-tab" data-tab="falsepos">False Positives</button>
    <button class="waf-tab" data-tab="export">Export Rule</button>
  </div>

  <div id="waf-panel-payloads" class="waf-panel">
    <div class="waf-category-filters" id="waf-cat-filters"></div>
    <div id="waf-payload-list"></div>
  </div>

  <div id="waf-panel-falsepos" class="waf-panel" style="display:none;">
    <div id="waf-fp-list"></div>
  </div>

  <div id="waf-panel-export" class="waf-panel" style="display:none;">
    <div class="tool-group" style="margin-bottom:0.75rem;">
      <label for="waf-export-format" style="font-size:0.75rem;margin-bottom:2px;">Export format</label>
      <select id="waf-export-format">
        <option value="cloudflare">Cloudflare WAF (wirefilter)</option>
        <option value="aws">AWS WAF (JSON rule statement)</option>
        <option value="modsecurity">ModSecurity (SecRule)</option>
        <option value="nginx">nginx (location/if block)</option>
        <option value="apache">Apache (.htaccess RewriteRule)</option>
      </select>
    </div>
    <div class="waf-export-block" id="waf-export-block">
      <div class="waf-export-header">
        <span id="waf-export-label">Cloudflare WAF</span>
        <button class="btn waf-copy-btn" id="waf-copy-btn">Copy</button>
      </div>
      <pre id="waf-export-code" class="waf-export-pre"></pre>
    </div>
  </div>
</div>

<div id="waf-empty" class="waf-empty-msg">Enter a regex pattern above and click "Test Pattern" to see results against 110+ attack payloads.</div>

<hr style="margin:2rem 0;border:none;border-top:1px solid var(--border,#2a2a3a);">

<div class="waf-info-note">
  <strong>How it works</strong>
  Your regex is tested entirely in-browser against a curated library of real-world attack payloads across 6 categories. Nothing is sent to any server. Export the rule in your WAF's native format and deploy directly.
</div>

<style>
  .waf-regex-meta { font-size:0.75rem; color:var(--text-3,#888); margin-top:4px; }
  .waf-regex-meta.waf-regex-error { color:#f87171; }

  .waf-score-bar {
    display:flex; align-items:center; gap:1rem; flex-wrap:wrap;
    padding:0.875rem 1rem; margin-bottom:1rem;
    background:var(--surface-1,#1a1a2e); border:1px solid var(--border,#2a2a3a); border-radius:8px;
  }
  .waf-score-main { font-size:1.1rem; font-weight:700; color:var(--text-1,#e2e8f0); }
  .waf-score-breakdown { font-size:0.8125rem; color:var(--text-2,#94a3b8); }
  .waf-score-meter { flex:1; min-width:120px; height:6px; background:var(--surface-0,#0f0f1a); border-radius:3px; overflow:hidden; }
  .waf-score-fill { height:100%; border-radius:3px; transition:width 0.3s ease; }

  .waf-results-tabs { display:flex; gap:0; border-bottom:1px solid var(--border,#2a2a3a); margin-bottom:1rem; }
  .waf-tab {
    padding:0.5rem 1rem; font-size:0.8125rem; font-weight:600;
    background:none; border:none; border-bottom:2px solid transparent;
    color:var(--text-3,#888); cursor:pointer; transition:color 0.15s, border-color 0.15s;
  }
  .waf-tab:hover { color:var(--text-1,#e2e8f0); }
  .waf-tab--active { color:#818cf8; border-bottom-color:#818cf8; }

  .waf-category-filters { display:flex; flex-wrap:wrap; gap:0.375rem; margin-bottom:0.75rem; }
  .waf-cat-btn {
    font-size:0.7rem; font-weight:600; padding:3px 8px; border-radius:4px;
    border:1px solid var(--border,#2a2a3a); background:var(--surface-0,#0f0f1a);
    color:var(--text-2,#94a3b8); cursor:pointer; transition:all 0.15s;
    text-transform:uppercase; letter-spacing:0.04em;
  }
  .waf-cat-btn:hover { border-color:var(--text-3,#888); color:var(--text-1,#e2e8f0); }
  .waf-cat-btn--active { background:#818cf8; border-color:#818cf8; color:#fff; }

  .waf-payload-row {
    display:flex; align-items:flex-start; gap:0.625rem;
    padding:0.5rem 0.75rem; border-bottom:1px solid var(--border,#2a2a3a);
    font-size:0.8125rem; line-height:1.45;
  }
  .waf-payload-row:last-child { border-bottom:none; }
  .waf-payload-icon { flex-shrink:0; width:18px; text-align:center; font-weight:700; font-size:0.875rem; line-height:1.45; }
  .waf-payload-icon--match { color:#4ade80; }
  .waf-payload-icon--miss { color:#f87171; }
  .waf-payload-icon--fp { color:#fbbf24; }
  .waf-payload-icon--safe { color:#4ade80; }
  .waf-payload-body { flex:1; min-width:0; }
  .waf-payload-str {
    font-family:var(--font-mono,monospace); font-size:0.75rem;
    background:var(--surface-0,#0f0f1a); padding:2px 6px; border-radius:3px;
    display:inline-block; max-width:100%; overflow-x:auto; white-space:nowrap;
    color:var(--text-1,#e2e8f0); border:1px solid var(--border,#2a2a3a);
  }
  .waf-payload-desc { color:var(--text-3,#888); font-size:0.75rem; margin-top:2px; }
  .waf-payload-cat {
    flex-shrink:0; font-size:0.65rem; font-weight:700; padding:2px 6px;
    border-radius:3px; text-transform:uppercase; letter-spacing:0.04em;
    background:rgba(129,140,248,0.1); color:#a5b4fc; border:1px solid rgba(129,140,248,0.2);
  }

  .waf-export-block {
    border:1px solid var(--border,#2a2a3a); border-radius:8px; overflow:hidden;
  }
  .waf-export-header {
    display:flex; align-items:center; justify-content:space-between;
    padding:0.5rem 0.75rem; background:var(--surface-1,#1a1a2e);
    border-bottom:1px solid var(--border,#2a2a3a);
  }
  .waf-export-header span { font-size:0.8125rem; font-weight:600; color:var(--text-2,#94a3b8); }
  .waf-copy-btn { font-size:0.75rem; padding:3px 10px; }
  .waf-export-pre {
    margin:0; padding:1rem; font-size:0.8rem; line-height:1.55;
    font-family:var(--font-mono,monospace); background:var(--surface-0,#0f0f1a);
    color:var(--text-1,#e2e8f0); white-space:pre-wrap; word-break:break-all;
    max-height:400px; overflow-y:auto;
  }

  .waf-empty-msg { text-align:center; padding:2.5rem; color:var(--text-3,#888); font-size:0.9rem; }
  .waf-info-note {
    font-size:0.875rem; color:var(--text-2,#94a3b8); line-height:1.5;
    padding:1rem 1.25rem; background:var(--surface-1,#1a1a2e);
    border:1px solid var(--border,#2a2a3a); border-radius:8px;
  }
  .waf-info-note strong { color:var(--text-1,#e2e8f0); display:block; margin-bottom:0.25rem; }

  .waf-section-heading {
    font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em;
    color:var(--text-3,#888); padding:0.5rem 0.75rem; margin:0;
    background:var(--surface-1,#1a1a2e); border-bottom:1px solid var(--border,#2a2a3a);
    border-top:1px solid var(--border,#2a2a3a);
  }
  .waf-section-heading:first-child { border-top:none; }
</style>

