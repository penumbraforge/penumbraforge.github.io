<p class="mtg-intro">Compose SEO, Open Graph, and Twitter Card tags with a live search &amp; social preview. Text and tag generation stay in this page. If you enter an OG image URL, your browser requests that image directly from its host for the preview.</p>

<div class="mtg-sec">Basic SEO</div>
<div class="mtg-grid">
  <div class="mtg-field">
    <label class="mtg-label" for="mtg-title">Page Title</label>
    <input class="mtg-input" id="mtg-title" type="text" placeholder="My Awesome Page" maxlength="70">
  </div>
  <div class="mtg-field">
    <label class="mtg-label" for="mtg-desc">Meta Description</label>
    <input class="mtg-input" id="mtg-desc" type="text" placeholder="A brief page description (150-160 chars)" maxlength="160">
  </div>
  <div class="mtg-field">
    <label class="mtg-label" for="mtg-canonical">Canonical URL</label>
    <input class="mtg-input" id="mtg-canonical" type="url" placeholder="https://example.com/page">
  </div>
  <div class="mtg-field">
    <label class="mtg-label" for="mtg-author">Author</label>
    <input class="mtg-input" id="mtg-author" type="text" placeholder="Author name">
  </div>
  <div class="mtg-field">
    <label class="mtg-label" for="mtg-robots">Robots</label>
    <select class="mtg-input" id="mtg-robots">
      <option value="index, follow">index, follow</option>
      <option value="noindex, follow">noindex, follow</option>
      <option value="index, nofollow">index, nofollow</option>
      <option value="noindex, nofollow">noindex, nofollow</option>
    </select>
  </div>
  <div class="mtg-field">
    <label class="mtg-label" for="mtg-viewport">Viewport</label>
    <input class="mtg-input" id="mtg-viewport" type="text" value="width=device-width, initial-scale=1">
  </div>
</div>

<div class="mtg-sec">Open Graph &amp; Social</div>
<div class="mtg-grid">
  <div class="mtg-field">
    <label class="mtg-label" for="mtg-og-title">OG Title</label>
    <input class="mtg-input" id="mtg-og-title" type="text" placeholder="Social share title">
  </div>
  <div class="mtg-field">
    <label class="mtg-label" for="mtg-og-desc">OG Description</label>
    <input class="mtg-input" id="mtg-og-desc" type="text" placeholder="Social share description">
  </div>
  <div class="mtg-field">
    <label class="mtg-label" for="mtg-og-image">OG Image URL</label>
    <input class="mtg-input" id="mtg-og-image" type="url" placeholder="https://example.com/og-image.png">
  </div>
  <div class="mtg-field">
    <label class="mtg-label" for="mtg-og-type">OG Type</label>
    <select class="mtg-input" id="mtg-og-type">
      <option value="website">website</option>
      <option value="article">article</option>
      <option value="product">product</option>
      <option value="profile">profile</option>
    </select>
  </div>
  <div class="mtg-field">
    <label class="mtg-label" for="mtg-twitter-card">Twitter Card</label>
    <select class="mtg-input" id="mtg-twitter-card">
      <option value="summary_large_image">summary_large_image</option>
      <option value="summary">summary</option>
      <option value="app">app</option>
      <option value="player">player</option>
    </select>
  </div>
  <div class="mtg-field">
    <label class="mtg-label" for="mtg-twitter-site">Twitter @site</label>
    <input class="mtg-input" id="mtg-twitter-site" type="text" placeholder="@youraccount">
  </div>
</div>

<div class="mtg-io wb-split">
  <div class="wb-panel">
    <div class="wb-panel-bar"><span>Live Preview</span></div>
    <div class="mtg-preview-body">
      <div>
        <div class="mtg-preview-label">Google Search Result</div>
        <div class="google-preview" id="mtg-google-preview">
          <div class="g-url" id="mtg-g-url">example.com</div>
          <div class="g-title" id="mtg-g-title">Page Title</div>
          <div class="g-desc" id="mtg-g-desc">Page description will appear here.</div>
        </div>
      </div>
      <div>
        <div class="mtg-preview-label">Social Card (Twitter / Facebook)</div>
        <div class="card-preview" id="mtg-card-preview">
          <div class="card-image" id="mtg-card-image"><span style="opacity:0.7;">No image set</span></div>
          <div class="card-body">
            <div class="card-domain" id="mtg-card-domain">example.com</div>
            <div class="card-title" id="mtg-card-title">Social Title</div>
            <div class="card-desc" id="mtg-card-desc">Social description</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="wb-panel">
    <div class="wb-panel-bar">
      <span>Generated HTML</span>
      <button class="btn btn--copy" id="mtg-copy" type="button">Copy HTML</button>
    </div>
    <pre class="mtg-code" id="mtg-output" aria-label="Generated meta tags"></pre>
  </div>
</div>

<script>
(function () {
  var fields = {
    title:        document.getElementById('mtg-title'),
    desc:         document.getElementById('mtg-desc'),
    canonical:    document.getElementById('mtg-canonical'),
    author:       document.getElementById('mtg-author'),
    robots:       document.getElementById('mtg-robots'),
    viewport:     document.getElementById('mtg-viewport'),
    ogTitle:      document.getElementById('mtg-og-title'),
    ogDesc:       document.getElementById('mtg-og-desc'),
    ogImage:      document.getElementById('mtg-og-image'),
    ogType:       document.getElementById('mtg-og-type'),
    twitterCard:  document.getElementById('mtg-twitter-card'),
    twitterSite:  document.getElementById('mtg-twitter-site'),
  };
  var outputEl  = document.getElementById('mtg-output');
  var copyBtn   = document.getElementById('mtg-copy');
  var gUrl      = document.getElementById('mtg-g-url');
  var gTitle    = document.getElementById('mtg-g-title');
  var gDesc     = document.getElementById('mtg-g-desc');
  var cardImage = document.getElementById('mtg-card-image');
  var cardDomain = document.getElementById('mtg-card-domain');
  var cardTitle = document.getElementById('mtg-card-title');
  var cardDesc  = document.getElementById('mtg-card-desc');

  function esc(s) { return s.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function getDomain(url) {
    try { return new URL(url).hostname; } catch (e) { return url || 'example.com'; }
  }

  function generate() {
    var t   = fields.title.value.trim();
    var d   = fields.desc.value.trim();
    var can = fields.canonical.value.trim();
    var auth = fields.author.value.trim();
    var rob  = fields.robots.value;
    var vp   = fields.viewport.value.trim();
    var ogT  = fields.ogTitle.value.trim() || t;
    var ogD  = fields.ogDesc.value.trim() || d;
    var ogImg = fields.ogImage.value.trim();
    var ogType = fields.ogType.value;
    var twCard = fields.twitterCard.value;
    var twSite = fields.twitterSite.value.trim();

    var lines = ['<!-- Basic -->'];
    if (vp)   lines.push('<meta name="viewport" content="' + esc(vp) + '">');
    if (t)    lines.push('<title>' + esc(t) + '</title>');
    if (d)    lines.push('<meta name="description" content="' + esc(d) + '">');
    if (auth) lines.push('<meta name="author" content="' + esc(auth) + '">');
    if (rob)  lines.push('<meta name="robots" content="' + esc(rob) + '">');
    if (can)  lines.push('<link rel="canonical" href="' + esc(can) + '">');

    lines.push('');
    lines.push('<!-- Open Graph -->');
    lines.push('<meta property="og:type" content="' + esc(ogType) + '">');
    if (ogT)   lines.push('<meta property="og:title" content="' + esc(ogT) + '">');
    if (ogD)   lines.push('<meta property="og:description" content="' + esc(ogD) + '">');
    if (ogImg) lines.push('<meta property="og:image" content="' + esc(ogImg) + '">');
    if (can)   lines.push('<meta property="og:url" content="' + esc(can) + '">');

    lines.push('');
    lines.push('<!-- Twitter Card -->');
    lines.push('<meta name="twitter:card" content="' + esc(twCard) + '">');
    if (ogT)   lines.push('<meta name="twitter:title" content="' + esc(ogT) + '">');
    if (ogD)   lines.push('<meta name="twitter:description" content="' + esc(ogD) + '">');
    if (ogImg) lines.push('<meta name="twitter:image" content="' + esc(ogImg) + '">');
    if (twSite) lines.push('<meta name="twitter:site" content="' + esc(twSite) + '">');

    outputEl.textContent = lines.join('\n');

    // Update Google preview
    gTitle.textContent = t || 'Page Title';
    gDesc.textContent  = d || 'Page description will appear here.';
    gUrl.textContent   = can ? getDomain(can) : 'example.com';

    // Update card preview
    cardTitle.textContent  = ogT || 'Social Title';
    cardDesc.textContent   = ogD || 'Social description';
    cardDomain.textContent = can ? getDomain(can) : 'example.com';

    // Card image
    while (cardImage.firstChild) cardImage.removeChild(cardImage.firstChild);
    if (ogImg) {
      var img = document.createElement('img');
      img.src = ogImg;
      img.alt = '';
      img.onerror = function () {
        cardImage.removeChild(img);
        var span = document.createElement('span');
        span.style.opacity = '0.7';
        span.textContent = 'Image not found';
        cardImage.appendChild(span);
      };
      cardImage.appendChild(img);
    } else {
      var span = document.createElement('span');
      span.style.opacity = '0.7';
      span.textContent = 'No image set';
      cardImage.appendChild(span);
    }
  }

  Object.keys(fields).forEach(function (k) {
    fields[k].addEventListener('input', generate);
    fields[k].addEventListener('change', generate);
  });

  copyBtn.addEventListener('click', function () {
    var text = outputEl.textContent;
    if (!text) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () {
        copyBtn.textContent = 'Copied!';
        setTimeout(function () { copyBtn.textContent = 'Copy HTML'; }, 2000);
      });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text; ta.style.cssText = 'position:fixed;opacity:0;';
      document.body.appendChild(ta); ta.focus(); ta.select();
      try { document.execCommand('copy'); copyBtn.textContent = 'Copied!'; } catch (e) { copyBtn.textContent = 'Failed'; }
      document.body.removeChild(ta);
      setTimeout(function () { copyBtn.textContent = 'Copy HTML'; }, 2000);
    }
  });

  // Initial
  fields.title.value = 'My Awesome Page';
  fields.desc.value  = 'A great description of my page for search engines and social sharing.';
  fields.canonical.value = 'https://example.com/my-page';
  generate();
})();
</script>
