---
toolSlug: jwt-decoder
permalink: /tools/jwt-decoder/
---

<div class="jwt-grid">

  <div class="jwt-in">
    <div class="tool-group">
      <label for="jwt-input">Encoded token</label>
      <textarea id="jwt-input" rows="8" placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
    </div>

    <div class="wb-note jwt-trust">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10.5" width="16" height="10" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg>
      <p id="jwt-notice">Decoded <strong>entirely in your browser</strong> — nothing is uploaded. This reads the token; it does <strong>not</strong> verify the signature.</p>
    </div>
  </div>

  <div class="jwt-out">

    <div id="jwt-error" style="display:none;" role="alert" aria-live="polite" class="tool-error"></div>

    <div id="jwt-sections" style="display:none;">

      <div class="wb-panel jwt-panel jwt-panel--header">
        <div class="wb-panel-bar">
          <span class="jwt-bar-title"><i class="jwt-dot" aria-hidden="true"></i>Header</span>
          <button class="btn btn--copy" id="btn-copy-header" aria-label="Copy header JSON">Copy</button>
        </div>
        <pre id="jwt-header-output" aria-label="JWT header"></pre>
      </div>

      <div class="wb-panel jwt-panel jwt-panel--payload">
        <div class="wb-panel-bar">
          <span class="jwt-bar-title"><i class="jwt-dot" aria-hidden="true"></i>Payload</span>
          <button class="btn btn--copy" id="btn-copy-payload" aria-label="Copy payload JSON">Copy</button>
        </div>
        <pre id="jwt-payload-output" aria-label="JWT payload"></pre>
        <div id="jwt-claims" class="jwt-claims"></div>
      </div>

      <div class="wb-panel jwt-panel jwt-panel--signature">
        <div class="wb-panel-bar">
          <span class="jwt-bar-title"><i class="jwt-dot" aria-hidden="true"></i>Signature</span>
          <button class="btn btn--copy" id="btn-copy-sig" aria-label="Copy signature">Copy</button>
        </div>
        <pre id="jwt-sig-output" aria-label="JWT signature (raw base64url)"></pre>
      </div>

    </div>

    <div class="jwt-empty" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10"></path></svg>
      <span>Paste a token to reveal its header, payload &amp; signature.</span>
    </div>

  </div>

</div>

<style>
  /* ---------- Layout: encoded (input) | decoded (output) ---------- */
  .jwt-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 20px;
    align-items: start;
  }
  @media (max-width: 760px) {
    .jwt-grid { grid-template-columns: 1fr; }
  }
  @media (min-width: 761px) {
    .jwt-in { position: sticky; top: 84px; }
  }

  .jwt-grid .tool-group { margin-bottom: 16px; }
  .jwt-grid textarea { min-height: 208px; line-height: 1.65; }
  .jwt-trust { margin-top: 0; }

  /* ---------- Decoded panels ---------- */
  .jwt-panel { margin-bottom: 14px; }
  .jwt-panel:last-child { margin-bottom: 0; }

  .jwt-bar-title { display: inline-flex; align-items: center; }
  .jwt-dot {
    width: 7px; height: 7px; border-radius: 50%;
    margin-right: 9px; flex: 0 0 auto;
    box-shadow: 0 0 8px currentColor;
  }
  .jwt-panel--header    { box-shadow: inset 2px 0 0 color-mix(in oklab, #e0728f 55%, transparent); }
  .jwt-panel--payload   { box-shadow: inset 2px 0 0 color-mix(in oklab, var(--accent) 60%, transparent); }
  .jwt-panel--signature { box-shadow: inset 2px 0 0 color-mix(in oklab, var(--slate) 65%, transparent); }
  .jwt-panel--header    .jwt-dot { background: #e0728f; color: #e0728f; }
  .jwt-panel--payload   .jwt-dot { background: var(--accent); color: var(--accent); }
  .jwt-panel--signature .jwt-dot { background: var(--slate); color: var(--slate); }

  /* Compact copy button inside the panel bar (base .btn--copy is absolute) */
  .jwt-panel .wb-panel-bar .btn--copy {
    position: static;
    padding: 5px 12px;
    font-size: 10px;
    letter-spacing: 0.5px;
    border-radius: 3px;
  }

  /* JSON / signature body */
  .jwt-panel pre {
    margin: 0;
    padding: 15px 16px;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.65;
    color: #d7d2e6;
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 360px;
    overflow: auto;
  }
  .jwt-panel--signature pre {
    color: color-mix(in oklab, var(--slate) 55%, #d7d2e6);
    word-break: break-all;
  }

  /* ---------- Registered-claim chips ---------- */
  .jwt-claims {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    padding: 12px 14px;
    border-top: 1px solid var(--wb-line);
    background: color-mix(in oklab, var(--surface-1) 30%, transparent);
  }
  .jwt-claims:empty { display: none; }
  .jwt-claim {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2px;
    color: var(--text-2);
    background: color-mix(in oklab, var(--accent) 8%, transparent);
    border: 1px solid color-mix(in oklab, var(--accent) 22%, transparent);
    border-radius: 20px;
    padding: 4px 11px;
    white-space: nowrap;
  }
  .jwt-claim--expired {
    color: #e0728f;
    background: color-mix(in oklab, #e0728f 10%, transparent);
    border-color: color-mix(in oklab, #e0728f 32%, transparent);
  }
  .jwt-claim--valid {
    color: var(--sage);
    background: color-mix(in oklab, var(--sage) 10%, transparent);
    border-color: color-mix(in oklab, var(--sage) 30%, transparent);
  }

  /* ---------- Empty state (decoded column, before input) ---------- */
  .jwt-empty {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 220px;
    padding: 40px 24px;
    text-align: center;
    border: 1px dashed var(--wb-line);
    border-radius: 4px;
    color: var(--text-3);
    font-size: 13px;
    line-height: 1.6;
  }
  .jwt-empty svg {
    width: 26px; height: 26px;
    color: color-mix(in oklab, var(--accent) 55%, var(--slate));
    opacity: 0.7;
  }
  .jwt-empty span { max-width: 30ch; }
  .jwt-out:has(#jwt-error[style*="none"]):has(#jwt-sections[style*="none"]) .jwt-empty {
    display: flex;
  }
</style>

<script>
(function () {
  var inputEl        = document.getElementById('jwt-input');
  var errorEl        = document.getElementById('jwt-error');
  var sectionsEl     = document.getElementById('jwt-sections');
  var headerOut      = document.getElementById('jwt-header-output');
  var payloadOut     = document.getElementById('jwt-payload-output');
  var sigOut         = document.getElementById('jwt-sig-output');
  var claimsEl       = document.getElementById('jwt-claims');
  var copyHeaderBtn  = document.getElementById('btn-copy-header');
  var copyPayloadBtn = document.getElementById('btn-copy-payload');
  var copySigBtn     = document.getElementById('btn-copy-sig');

  function base64urlDecode(str) {
    // Pad to multiple of 4
    var padded = str.replace(/-/g, '+').replace(/_/g, '/');
    while (padded.length % 4 !== 0) {
      padded += '=';
    }
    try {
      return atob(padded);
    } catch (e) {
      throw new Error('Invalid base64url encoding');
    }
  }

  function base64urlDecodeJSON(str) {
    var raw = base64urlDecode(str);
    // Handle UTF-8 via percent encoding
    var decoded;
    try {
      decoded = decodeURIComponent(
        raw.split('').map(function (c) {
          return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
        }).join('')
      );
    } catch (e) {
      decoded = raw;
    }
    return JSON.parse(decoded);
  }

  function formatDate(ts) {
    try {
      return new Date(ts * 1000).toISOString().replace('T', ' ').replace('.000Z', ' UTC');
    } catch (e) {
      return String(ts);
    }
  }

  function renderClaims(payload) {
    // Clear existing
    while (claimsEl.firstChild) {
      claimsEl.removeChild(claimsEl.firstChild);
    }

    var now = Math.floor(Date.now() / 1000);

    function addClaim(text, modifier) {
      var span = document.createElement('span');
      span.className = 'jwt-claim' + (modifier ? ' jwt-claim--' + modifier : '');
      span.textContent = text;
      claimsEl.appendChild(span);
    }

    if (payload.iss !== undefined) {
      addClaim('iss: ' + payload.iss);
    }
    if (payload.sub !== undefined) {
      addClaim('sub: ' + payload.sub);
    }
    if (payload.iat !== undefined) {
      addClaim('iat: ' + formatDate(payload.iat));
    }
    if (payload.exp !== undefined) {
      var expDate = formatDate(payload.exp);
      if (payload.exp < now) {
        addClaim('exp: ' + expDate + ' — Expired', 'expired');
      } else {
        var secsLeft = payload.exp - now;
        var timeLeft;
        if (secsLeft < 60) {
          timeLeft = secsLeft + 's';
        } else if (secsLeft < 3600) {
          timeLeft = Math.floor(secsLeft / 60) + 'm';
        } else if (secsLeft < 86400) {
          timeLeft = Math.floor(secsLeft / 3600) + 'h';
        } else {
          timeLeft = Math.floor(secsLeft / 86400) + 'd';
        }
        addClaim('exp: ' + expDate + ' — Valid (expires in ' + timeLeft + ')', 'valid');
      }
    }
  }

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.style.display = '';
    sectionsEl.style.display = 'none';
  }

  function hideError() {
    errorEl.textContent = '';
    errorEl.style.display = 'none';
  }

  function decode() {
    var raw = inputEl.value.trim();

    if (!raw) {
      hideError();
      sectionsEl.style.display = 'none';
      headerOut.textContent = '';
      payloadOut.textContent = '';
      sigOut.textContent = '';
      while (claimsEl.firstChild) { claimsEl.removeChild(claimsEl.firstChild); }
      return;
    }

    var parts = raw.split('.');
    if (parts.length !== 3) {
      showError('Invalid JWT: expected 3 parts separated by dots, got ' + parts.length + '.');
      return;
    }

    var header, payload;

    try {
      header = base64urlDecodeJSON(parts[0]);
    } catch (e) {
      showError('Invalid JWT header: ' + e.message);
      return;
    }

    try {
      payload = base64urlDecodeJSON(parts[1]);
    } catch (e) {
      showError('Invalid JWT payload: ' + e.message);
      return;
    }

    hideError();
    sectionsEl.style.display = '';

    headerOut.textContent = JSON.stringify(header, null, 2);
    payloadOut.textContent = JSON.stringify(payload, null, 2);
    sigOut.textContent = parts[2];

    renderClaims(payload);
  }

  function copyText(text, btn, defaultLabel) {
    if (!text) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () {
        btn.textContent = 'Copied!';
        setTimeout(function () { btn.textContent = defaultLabel; }, 2000);
      }).catch(function () {
        btn.textContent = 'Failed';
        setTimeout(function () { btn.textContent = defaultLabel; }, 2000);
      });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try {
        document.execCommand('copy');
        btn.textContent = 'Copied!';
      } catch (e) {
        btn.textContent = 'Failed';
      }
      document.body.removeChild(ta);
      setTimeout(function () { btn.textContent = defaultLabel; }, 2000);
    }
  }

  copyHeaderBtn.addEventListener('click', function () {
    copyText(headerOut.textContent, copyHeaderBtn, 'Copy');
  });

  copyPayloadBtn.addEventListener('click', function () {
    copyText(payloadOut.textContent, copyPayloadBtn, 'Copy');
  });

  copySigBtn.addEventListener('click', function () {
    copyText(sigOut.textContent, copySigBtn, 'Copy');
  });

  inputEl.addEventListener('input', decode);
})();
</script>
