---
layout: base.njk
title: "Free Developer & Security Tools — No Tracking, No Accounts | Penumbra Forge"
description: "79 free online developer and security tools — AI security, detection engineering, DevSecOps, and more. No signup, no tracking. Your data never leaves your browser."
permalink: /tools/
---

<div class="tools-hub-page">
<header class="site-header" id="site-header">
  <div class="site-header-sidebar">
    <a href="/" class="site-header-brand" title="Penumbra Forge">
      <div class="site-header-orb" aria-hidden="true"><div class="site-header-orb-backlight"></div><div class="site-header-orb-corona"></div><div class="site-header-orb-glow"></div><div class="site-header-orb-edge"></div><div class="site-header-orb-shadow"></div></div>
          </a>
  </div>
  <button class="site-header-toggle" aria-label="Toggle menu"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="5" x2="17" y2="5"/><line x1="3" y1="10" x2="17" y2="10"/><line x1="3" y1="15" x2="17" y2="15"/></svg></button>
  <div class="site-header-main">
    <nav class="site-header-nav">
      <a href="/">Home</a>
      <a href="/tools/" class="active">Tools</a>
      <a href="/labs/">Labs</a>
        <a href="/blog/">Blog</a>
      <a href="/gate/">Gate</a>
      <a href="/librarian/">Librarian</a>
      <a href="https://github.com/penumbraforge" target="_blank" rel="noopener">GitHub</a>
    </nav>
  </div>
</header>

<div class="tools-layout">
  {% include "sidebar.njk" %}

  <main class="tools-content">
    <h1 class="tools-content-title">Tool Kits</h1>
    <p class="tools-content-subtitle">Free developer &amp; security tools. No accounts, no tracking, your data stays in your browser.</p>

    <div class="tools-mobile-search" id="tools-mobile-search">
      <input type="text" id="tools-search-input" placeholder="Search 79 tools..." autocomplete="off" spellcheck="false">
    </div>

    {# Featured section #}
    {% set featuredTools = [] %}
    {% for tool in tools %}{% if tool.featured %}{% set featuredTools = (featuredTools.push(tool), featuredTools) %}{% endif %}{% endfor %}
    {% if featuredTools.length > 0 %}
    <div class="featured-label">&#9733; Featured</div>
    <div class="featured-grid">
      {% for tool in featuredTools %}
      <a class="featured-card" href="/tools/{{ tool.slug }}/">
        <div class="featured-card-header">
          <h3>{{ tool.name }}</h3>
          {% if tool.badge == "worker" %}
          <span class="featured-card-badge badge-worker">cf worker</span>
          {% else %}
          <span class="featured-card-badge badge-new">new</span>
          {% endif %}
        </div>
        <p>{{ tool.longDescription }}</p>
        <span class="local-badge">
          {% if tool.badge == "local" %}runs in your browser{% elif tool.badge == "worker" %}scans via edge worker{% else %}{{ tool.badge }}{% endif %}
        </span>
      </a>
      {% endfor %}
    </div>
    {% endif %}

    {# Category sections #}
    {% set categoryOrder = [
      { key: "ai", label: "AI", icon: "◈" },
      { key: "security", label: "Security", icon: "◆" },
      { key: "intelligence", label: "Intelligence", icon: "+" },
      { key: "devops", label: "DevOps", icon: "⚙" },
      { key: "web", label: "Web", icon: "◎" },
      { key: "encoding", label: "Encoding", icon: "⟨⟩" },
      { key: "text", label: "Text", icon: "¶" }
    ] %}

    {% for cat in categoryOrder %}
    {% set catTools = [] %}
    {% for tool in tools %}{% if tool.category == cat.key and tool.status == "live" %}{% set catTools = (catTools.push(tool), catTools) %}{% endif %}{% endfor %}
    {% if catTools.length > 0 %}
    <div class="category-section" id="cat-{{ cat.key }}">
      <div class="category-header">
        <span class="category-icon" aria-hidden="true">{{ cat.icon }}</span>
        <span class="category-name">{{ cat.label }}</span>
        <span class="category-count">{{ catTools.length }} tools</span>
      </div>
      <div class="tools-sidebar-grid">
        {% for tool in catTools %}
        <a href="/tools/{{ tool.slug }}/" class="t-card" data-category="{{ tool.category }}" data-keywords="{{ tool.keywords | join(' ') }} {{ tool.name | lower }}">
          <div class="t-icon" aria-hidden="true">
            {% if tool.category == "ai" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a7 7 0 017 7c0 2.5-1.3 4.7-3.3 6L17 21H7l1.3-6A7 7 0 0112 2z"/><path d="M9 9h6M9 12h6"/></svg>{% elif tool.category == "security" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L3 7v6c0 5.25 3.75 10.1 9 11 5.25-.9 9-5.75 9-11V7l-9-5z"/></svg>{% elif tool.category == "encoding" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"/></svg>{% elif tool.category == "devops" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>{% elif tool.category == "web" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>{% elif tool.category == "text" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>{% elif tool.category == "intelligence" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/><path d="M11 8v6M8 11h6"/></svg>{% else %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{% endif %}
          </div>
          <h4>{{ tool.name }}</h4>
          <p>{{ tool.description }}</p>
          <span class="local-badge">
            {% if tool.badge == "local" %}runs in your browser{% elif tool.badge == "worker" %}scans via edge worker{% elif tool.badge == "cloud" %}cloud-assisted{% else %}{{ tool.badge }}{% endif %}
          </span>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}
    {% endfor %}
  </main>
</div>

{% include "sidebar-js.njk" %}

<script>
(function() {
  var isMobile = window.innerWidth <= 900;

  // Position search bar below the actual header
  var searchBar = document.getElementById('tools-mobile-search');
  var siteHeader = document.getElementById('site-header');
  if (searchBar && siteHeader && isMobile) {
    var headerH = siteHeader.offsetHeight;
    searchBar.style.top = headerH + 'px';
  }

  // Collapsible categories on mobile
  document.querySelectorAll('.category-header').forEach(function(header) {
    var grid = header.nextElementSibling;
    var section = header.closest('.category-section');

    // Add chevron indicator
    var chevron = document.createElement('span');
    chevron.className = 'category-chevron';
    chevron.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>';
    header.appendChild(chevron);

    // Collapse by default on mobile
    if (isMobile && grid) {
      grid.style.display = 'none';
      section.classList.add('collapsed');
    }

    header.addEventListener('click', function() {
      if (!grid) return;
      var isCollapsed = grid.style.display === 'none';
      grid.style.display = isCollapsed ? '' : 'none';
      section.classList.toggle('collapsed', !isCollapsed);
    });
  });

  // Search
  var searchInput = document.getElementById('tools-search-input');
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      var query = this.value.toLowerCase().trim();
      var cards = document.querySelectorAll('.t-card');
      var sections = document.querySelectorAll('.category-section');

      cards.forEach(function(card) {
        var keywords = (card.getAttribute('data-keywords') || '') + ' ' + card.textContent.toLowerCase();
        card.style.display = query && keywords.indexOf(query) === -1 ? 'none' : '';
      });

      // Show/hide sections based on whether they have visible cards
      sections.forEach(function(section) {
        var grid = section.querySelector('.tools-sidebar-grid');
        if (!grid) return;
        var visibleCards = grid.querySelectorAll('.t-card:not([style*="display: none"])');
        section.style.display = visibleCards.length === 0 && query ? 'none' : '';
        // When searching, expand all sections
        if (query) {
          grid.style.display = '';
          section.classList.remove('collapsed');
        } else if (isMobile) {
          grid.style.display = 'none';
          section.classList.add('collapsed');
        }
      });

      // Hide featured section when searching
      var featured = document.querySelector('.featured-grid');
      var featuredLabel = document.querySelector('.featured-label');
      if (featured) featured.style.display = query ? 'none' : '';
      if (featuredLabel) featuredLabel.style.display = query ? 'none' : '';
    });
  }
})();
</script>
</div>

<style>
  .tools-content-title {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 400;
    color: var(--text-1);
    margin-bottom: 6px;
    letter-spacing: -0.3px;
  }
  .tools-content-subtitle {
    color: var(--text-3);
    font-size: 14px;
    margin-bottom: 12px;
  }
</style>
