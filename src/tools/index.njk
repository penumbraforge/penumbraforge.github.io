---
layout: base.njk
title: "Free Developer & Security Tools — Run in Browser or via MCP | Penumbra Forge"
description: "77 privacy-first developer and security tools that run in your browser — plus local AI, an MCP server for agents, and a command bar you can talk to. No signup, no tracking."
permalink: /tools/
hideAtmosphere: true
---
<link rel="stylesheet" href="/css/tools.css?v={{ assetv }}">
<link rel="stylesheet" href="/css/tools-hub.css?v={{ assetv }}">

{% set cats = [
  { key: "ai", label: "Local AI" },
  { key: "security", label: "Security" },
  { key: "intelligence", label: "Intelligence" },
  { key: "media", label: "Media & Creative" },
  { key: "devops", label: "DevOps" },
  { key: "web", label: "Web & API" },
  { key: "encoding", label: "Encoding & Data" },
  { key: "text", label: "Text" }
] %}
{% set liveTools = [] %}
{% for tool in tools %}{% if tool.status == "live" %}{% set liveTools = (liveTools.push(tool), liveTools) %}{% endif %}{% endfor %}

{% macro icon(cat) %}{% if cat == "ai" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a7 7 0 017 7c0 2.5-1.3 4.7-3.3 6L17 21H7l1.3-6A7 7 0 0112 2z"/><path d="M9 9h6M9 12h6"/></svg>{% elif cat == "security" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L3 7v6c0 5.25 3.75 10.1 9 11 5.25-.9 9-5.75 9-11V7l-9-5z"/></svg>{% elif cat == "intelligence" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/><path d="M11 8v6M8 11h6"/></svg>{% elif cat == "media" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>{% elif cat == "devops" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>{% elif cat == "web" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>{% elif cat == "text" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8"/></svg>{% else %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"/></svg>{% endif %}{% endmacro %}

{% macro card(tool) %}
<a class="hub-card" href="/tools/{{ tool.slug }}/" data-cat="{{ tool.category }}" data-slug="{{ tool.slug }}" data-name="{{ tool.name }}" data-keywords="{{ (tool.keywords or []) | join(' ') }}"{% if tool.featured %} data-featured="1"{% endif %}{% if tool.isNew %} data-new="1"{% endif %} style="view-transition-name: t-{{ tool.slug }}">
  <button class="hub-star" data-slug="{{ tool.slug }}" aria-label="Pin" title="Pin">&#9733;</button>
  <div class="hub-card-top"><span class="hub-card-ic" aria-hidden="true">{{ icon(tool.category) }}</span><h4>{{ tool.name }}</h4></div>
  <p>{{ tool.description }}</p>
  <div class="hub-card-foot">
    {% if tool.isNew %}<span class="hub-tag hub-tag--new">new</span>{% endif %}
    {% if tool.category == "ai" %}<span class="hub-tag hub-tag--ai">local AI</span>{% elif tool.badge == "worker" %}<span class="hub-tag">edge</span>{% elif tool.badge == "cloud" %}<span class="hub-tag">cloud</span>{% else %}<span class="hub-tag hub-tag--local">browser</span>{% endif %}
  </div>
</a>
{% endmacro %}

<div class="wb-page">
  {% include "header.njk" %}

  <div class="hub" id="hub">
    <section class="hub-hero">
      <p class="hub-kick">The console</p>
      <h1>Tools that <em>run in your browser</em> — or on your agent.</h1>
      <p class="hub-lede">{{ liveTools.length }} privacy-first developer &amp; security tools, a local-AI suite, and an MCP server so your terminal AI can use them too. Nothing you enter is ever uploaded.</p>
      <div class="hub-searchwrap">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input type="search" class="hub-search" id="hubSearch" placeholder="Search {{ liveTools.length }} tools…" autocomplete="off" spellcheck="false" aria-label="Search tools">
        <button class="hub-run-hint" data-open-palette title="Open the command bar"><b>&#8984;K</b> to run</button>
      </div>
      <div class="hub-stats">
        <span class="hub-stat"><b>{{ liveTools.length }}</b> tools</span>
        <span class="hub-stat"><b>{{ stats.localTools }}</b> fully in-browser · <b>0</b> tracking</span>
        <span class="hub-stat"><b>{{ stats.mcpTools }}</b> callable over MCP</span>
      </div>
    </section>

    <div class="hub-body">
      <aside class="hub-rail" id="hubRail">
        <div class="hub-rail-group">
          <div class="hub-rail-label">Browse</div>
          <button class="hub-rail-item active" data-filter="all"><span class="tick" style="--cat:var(--accent)"></span>All tools <span class="n">{{ liveTools.length }}</span></button>
          <button class="hub-rail-item" data-filter="new"><span class="tick" style="--cat:var(--accent)"></span>New <span class="n" id="cntNew"></span></button>
          <button class="hub-rail-item" data-filter="featured"><span class="tick" style="--cat:var(--sage)"></span>Featured <span class="n" id="cntFeat"></span></button>
        </div>
        <div class="hub-rail-group">
          <div class="hub-rail-label">Categories</div>
          {% for c in cats %}{% set n = [] %}{% for t in liveTools %}{% if t.category == c.key %}{% set n = (n.push(t), n) %}{% endif %}{% endfor %}{% if n.length %}
          <button class="hub-rail-item" data-filter="cat:{{ c.key }}" data-cat="{{ c.key }}"><span class="tick"></span>{{ c.label }} <span class="n">{{ n.length }}</span></button>
          {% endif %}{% endfor %}
        </div>
        <div class="hub-rail-group">
          <div class="hub-rail-label">Collections</div>
          <button class="hub-rail-item" data-filter="col:ir"><span class="tick" style="--cat:oklch(75% 0.1 250)"></span>Incident Response</button>
          <button class="hub-rail-item" data-filter="col:keys"><span class="tick" style="--cat:oklch(75% 0.1 20)"></span>Keys &amp; Auth</button>
          <button class="hub-rail-item" data-filter="col:web"><span class="tick" style="--cat:oklch(75% 0.1 210)"></span>Web &amp; API</button>
        </div>
        <div class="hub-rail-group" id="railYours" style="display:none">
          <div class="hub-rail-label">Yours</div>
          <div id="railPinned"></div>
        </div>
        <div class="hub-rail-group">
          <div class="hub-rail-label">Agents</div>
          <a class="hub-rail-link" href="/tools/agents/">For AI agents <span class="arr">&rarr;</span></a>
          <a class="hub-rail-link" href="/llms.txt">llms.txt <span class="arr">&rarr;</span></a>
        </div>
      </aside>

      <main class="hub-main" id="hubMain">
        {# AI spotlight zone #}
        {% set aiTools = [] %}{% for t in liveTools %}{% if t.category == "ai" %}{% set aiTools = (aiTools.push(t), aiTools) %}{% endif %}{% endfor %}
        <section class="hub-ai-zone hub-section" data-section="ai">
          <div class="hub-section-h"><span class="lbl">Local AI</span><span class="hub-ai-badge">runs on your machine ✦</span><span class="rule"></span><span class="cnt">{{ aiTools.length }}</span></div>
          <div class="hub-grid">{% for t in aiTools %}{{ card(t) }}{% endfor %}</div>
        </section>

        {# other category sections #}
        {% for c in cats %}{% if c.key != "ai" %}
        {% set ct = [] %}{% for t in liveTools %}{% if t.category == c.key %}{% set ct = (ct.push(t), ct) %}{% endif %}{% endfor %}
        {% if ct.length %}
        <section class="hub-section" data-section="{{ c.key }}" id="sec-{{ c.key }}">
          <div class="hub-section-h"><span class="lbl">{{ c.label }}</span><span class="rule"></span><span class="cnt">{{ ct.length }}</span></div>
          <div class="hub-grid">{% for t in ct %}{{ card(t) }}{% endfor %}</div>
        </section>
        {% endif %}{% endif %}{% endfor %}

        <div class="hub-empty" id="hubEmpty" aria-live="polite"><p>Nothing matches that.</p><span>Try a broader term, or press <strong>&#8984;K</strong> to run a command.</span></div>
      </main>
    </div>
  </div>

  {% include "command-palette.njk" %}
</div>

<script>
(function () {
  var search = document.getElementById('hubSearch');
  var rail = document.getElementById('hubRail');
  var main = document.getElementById('hubMain');
  var empty = document.getElementById('hubEmpty');
  var cards = Array.prototype.slice.call(main.querySelectorAll('.hub-card'));
  var sections = Array.prototype.slice.call(main.querySelectorAll('.hub-section'));
  var COLLECTIONS = {
    ir: ['ir-timeline','ioc-workbench','log-parser','email-header-forensics','entropy-xray','yara-playground','sigma-rule-builder','siem-query-translator','ai-security-copilot'],
    keys: ['passkey-inspector','key-converter','jwt-decoder','jwt-attack','ssh-keygen','totp-generator','secrets-scanner','secret-lock','one-time-secret','hash-generator','password-generator'],
    web: ['cors-debugger','curl-converter','api-request-builder','header-analyzer','security-headers','site-score','jwt-decoder','url-encoder']
  };
  var filter = 'all';

  function get(k){ try { return JSON.parse(localStorage.getItem(k)||'[]'); } catch(e){ return []; } }
  function set(k,v){ try { localStorage.setItem(k, JSON.stringify(v)); } catch(e){} }

  document.getElementById('cntNew').textContent = cards.filter(function(c){return c.dataset.new;}).length;
  document.getElementById('cntFeat').textContent = cards.filter(function(c){return c.dataset.featured;}).length;

  function cardMatchesFilter(c){
    if (filter === 'all') return true;
    if (filter === 'new') return !!c.dataset.new;
    if (filter === 'featured') return !!c.dataset.featured;
    if (filter.indexOf('cat:') === 0) return c.dataset.cat === filter.slice(4);
    if (filter.indexOf('col:') === 0) return (COLLECTIONS[filter.slice(4)]||[]).indexOf(c.dataset.slug) !== -1;
    return true;
  }
  function apply(){
    var q = search.value.trim().toLowerCase();
    var shown = 0;
    cards.forEach(function(c){
      var okF = cardMatchesFilter(c);
      var hay = (c.dataset.name + ' ' + c.dataset.keywords + ' ' + c.dataset.cat).toLowerCase();
      var okQ = !q || hay.indexOf(q) !== -1;
      var vis = okF && okQ;
      c.style.display = vis ? '' : 'none';
      if (vis) shown++;
      // highlight
      var h4 = c.querySelector('h4');
      if (q && okQ) { var i = c.dataset.name.toLowerCase().indexOf(q); h4.innerHTML = i>=0 ? esc(c.dataset.name.slice(0,i))+'<mark>'+esc(c.dataset.name.slice(i,i+q.length))+'</mark>'+esc(c.dataset.name.slice(i+q.length)) : esc(c.dataset.name); }
      else h4.textContent = c.dataset.name;
    });
    sections.forEach(function(s){ var any = s.querySelectorAll('.hub-card:not([style*="display: none"])').length > 0; s.style.display = any ? '' : 'none'; });
    empty.style.display = shown === 0 ? 'block' : 'none';
  }
  function esc(s){ return String(s).replace(/[&<>]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c];}); }

  search.addEventListener('input', apply);
  search.addEventListener('keydown', function(e){ if(e.key==='Escape'){ search.value=''; apply(); } });

  rail.querySelectorAll('.hub-rail-item').forEach(function(b){
    b.addEventListener('click', function(){
      rail.querySelectorAll('.hub-rail-item').forEach(function(x){x.classList.remove('active');});
      b.classList.add('active'); filter = b.dataset.filter; apply();
      main.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });
  });

  // pins
  function renderPins(){
    var favs = get('pf:favs');
    cards.forEach(function(c){ c.querySelector('.hub-star').classList.toggle('on', favs.indexOf(c.dataset.slug)!==-1); });
    var yours = document.getElementById('railYours'), list = document.getElementById('railPinned');
    if (favs.length){ yours.style.display=''; list.innerHTML = favs.map(function(s){ var c=cards.find(function(x){return x.dataset.slug===s;}); return c?'<a class="hub-rail-link" href="/tools/'+s+'/">'+esc(c.dataset.name)+'</a>':''; }).join(''); }
    else yours.style.display='none';
  }
  main.querySelectorAll('.hub-star').forEach(function(star){
    star.addEventListener('click', function(e){ e.preventDefault(); e.stopPropagation();
      var favs = get('pf:favs'), s = star.dataset.slug, i = favs.indexOf(s);
      if (i===-1) favs.push(s); else favs.splice(i,1); set('pf:favs', favs); renderPins();
    });
  });
  renderPins();

  // URL ?cat= support
  var initCat = new URLSearchParams(location.search).get('cat');
  if (initCat){ var b = rail.querySelector('[data-filter="cat:'+initCat+'"]'); if(b) b.click(); }
})();
</script>
