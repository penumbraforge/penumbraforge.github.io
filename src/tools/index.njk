---
layout: base.njk
title: "Free Developer & Security Tools — No Tracking, No Accounts | Penumbra Forge"
description: "63 free online developer and security tools. JSON formatter, JWT decoder, hash generator, subnet calculator, and more. All client-side — your data never leaves your browser."
permalink: /tools/
---

<div class="tools-hub-page">
<header class="site-header">
  <div class="site-header-sidebar">
    <a href="/" class="site-header-brand" title="Penumbra Forge">
      <div class="site-header-orb" aria-hidden="true"><div class="site-header-orb-backlight"></div><div class="site-header-orb-corona"></div><div class="site-header-orb-glow"></div><div class="site-header-orb-edge"></div><div class="site-header-orb-shadow"></div></div>
          </a>
  </div>
  <div class="site-header-main">
    <nav class="site-header-nav">
      <a href="/">Home</a>
      <a href="/tools/" class="active">Tools</a>
      <a href="/labs/">Labs</a>
      <a href="/gate/">Gate</a>
      <a href="/librarian/">Librarian</a>
      <a href="https://github.com/penumbraforge" target="_blank" rel="noopener">GitHub</a>
    </nav>
  </div>
</header>

<div class="tools-layout">
  {% include "sidebar.njk" %}

  <main class="tools-content">
    <h1 class="tools-content-title">Tool Kits</h1>
    <p class="tools-content-subtitle">Free developer &amp; security tools. No accounts, no tracking, your data stays in your browser.</p>

    {# Featured section #}
    {% set featuredTools = [] %}
    {% for tool in tools %}{% if tool.featured %}{% set featuredTools = (featuredTools.push(tool), featuredTools) %}{% endif %}{% endfor %}
    {% if featuredTools.length > 0 %}
    <div class="featured-label">&#9733; Featured</div>
    <div class="featured-grid">
      {% for tool in featuredTools %}
      <a class="featured-card" href="/tools/{{ tool.slug }}/">
        <div class="featured-card-header">
          <h3>{{ tool.name }}</h3>
          {% if tool.badge == "worker" %}
          <span class="featured-card-badge badge-worker">cf worker</span>
          {% else %}
          <span class="featured-card-badge badge-new">new</span>
          {% endif %}
        </div>
        <p>{{ tool.longDescription }}</p>
        <span class="local-badge">
          {% if tool.badge == "local" %}runs in your browser{% elif tool.badge == "worker" %}scans via edge worker{% else %}{{ tool.badge }}{% endif %}
        </span>
      </a>
      {% endfor %}
    </div>
    {% endif %}

    {# Category sections #}
    {% set categoryOrder = [
      { key: "intelligence", label: "Intelligence", icon: "+" },
      { key: "security", label: "Security", icon: "◆" },
      { key: "encoding", label: "Encoding", icon: "⟨⟩" },
      { key: "devops", label: "DevOps", icon: "⚙" },
      { key: "web", label: "Web", icon: "◎" },
      { key: "text", label: "Text", icon: "¶" }
    ] %}

    {% for cat in categoryOrder %}
    {% set catTools = [] %}
    {% for tool in tools %}{% if tool.category == cat.key and tool.status == "live" %}{% set catTools = (catTools.push(tool), catTools) %}{% endif %}{% endfor %}
    {% if catTools.length > 0 %}
    <div class="category-section" id="cat-{{ cat.key }}">
      <div class="category-header">
        <span class="category-icon" aria-hidden="true">{{ cat.icon }}</span>
        <span class="category-name">{{ cat.label }}</span>
        <span class="category-count">{{ catTools.length }} tools</span>
      </div>
      <div class="tools-sidebar-grid">
        {% for tool in catTools %}
        <a href="/tools/{{ tool.slug }}/" class="t-card" data-category="{{ tool.category }}" data-keywords="{{ tool.keywords | join(' ') }} {{ tool.name | lower }}">
          <div class="t-icon" aria-hidden="true">
            {% if tool.category == "security" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L3 7v6c0 5.25 3.75 10.1 9 11 5.25-.9 9-5.75 9-11V7l-9-5z"/></svg>{% elif tool.category == "encoding" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"/></svg>{% elif tool.category == "devops" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>{% elif tool.category == "web" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>{% elif tool.category == "text" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>{% elif tool.category == "intelligence" %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/><path d="M11 8v6M8 11h6"/></svg>{% else %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{% endif %}
          </div>
          <h4>{{ tool.name }}</h4>
          <p>{{ tool.description }}</p>
          <span class="local-badge">
            {% if tool.badge == "local" %}runs in your browser{% elif tool.badge == "worker" %}scans via edge worker{% elif tool.badge == "cloud" %}cloud-assisted{% else %}{{ tool.badge }}{% endif %}
          </span>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}
    {% endfor %}
  </main>
</div>

{% include "sidebar-js.njk" %}
</div>

<style>
  .tools-content-title {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 400;
    color: var(--text-1);
    margin-bottom: 6px;
    letter-spacing: -0.3px;
  }
  .tools-content-subtitle {
    color: var(--text-3);
    font-size: 14px;
    margin-bottom: 32px;
  }
</style>
