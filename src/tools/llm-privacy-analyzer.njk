    border-radius: 8px; padding: 1rem 1.25rem; margin-top: 1rem;
  }
  .lpa-recs-title {
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--text-3,#888); margin-bottom: 0.75rem;
  }
  .lpa-rec {
    display: flex; align-items: flex-start; gap: 0.5rem;
    font-size: 0.8125rem; line-height: 1.6; color: var(--text-2,#94a3b8);
    margin-bottom: 0.5rem;
  }
  .lpa-rec:last-child { margin-bottom: 0; }
  .lpa-rec-icon { flex-shrink: 0; margin-top: 2px; }
  .lpa-rec-icon--fix { color: #f87171; }
  .lpa-rec-icon--warn { color: #fbbf24; }
  .lpa-rec-icon--tip { color: #38bdf8; }
  .lpa-rec strong { color: var(--text-1,#e2e8f0); }

  /* Tagline note */
  .lpa-tagline-note {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-3,#888);
    line-height: 1.5;
    padding: 0.75rem 1rem;
    background: var(--surface-1,#1a1a2e);
    border: 1px solid var(--border,#2a2a3a);
    border-radius: 8px;
  }

  /* Provider note */
  .lpa-provider-note {
    background: var(--surface-1,#1a1a2e); border: 1px solid var(--border,#2a2a3a);
    border-radius: 8px; padding: 1rem 1.25rem; margin-top: 0.75rem;
