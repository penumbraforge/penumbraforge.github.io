      height: 72px;
    }
    .lpa-score-ring svg {
      width: 72px;
      height: 72px;
    }
    .lpa-score-value {
      font-size: 1.2rem;
    }
    .lpa-score-title {
      font-size: 1rem;
    }
    .lpa-score-breakdown {
      gap: 0.5rem;
    }
    .lpa-score-stat {
      font-size: 0.75rem;
      padding: 3px 8px;
    }
    .lpa-flow {
      padding: 0.75rem;
    }
    .lpa-flow-diagram {
      font-size: 0.8rem;
      gap: 0.35rem;
    }
    .lpa-flow-box {
      padding: 4px 10px;
      font-size: 0.75rem;
    }
