---
toolSlug: llm-privacy-analyzer
permalink: /tools/llm-privacy-analyzer/
---

<div class="tool-group">
  <label for="lpa-input">Paste an LLM API request (JSON) to scan for sensitive data</label>
  <textarea id="lpa-input" rows="14" placeholder='{"model": "gpt-4", "messages": [{"role": "system", "content": "..."}, {"role": "user", "content": "..."}]}' spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
</div>

<div class="tool-row">
  <button class="btn btn--primary" id="lpa-scan-btn">Analyze</button>
  <button class="btn" id="lpa-example-btn">Try Example</button>
  <button class="btn" id="lpa-clear-btn">Clear</button>
  <div id="lpa-provider" style="margin-left:auto;font-size:0.8125rem;color:var(--text-3,#888);align-self:center;"></div>
</div>

<div id="lpa-results" style="display:none;">
  <div id="lpa-score-section"></div>
  <div id="lpa-flow-section"></div>
  <div id="lpa-findings"></div>
  <div id="lpa-recommendations"></div>
  <div id="lpa-provider-note"></div>
</div>

<div id="lpa-clean" style="display:none;" class="lpa-clean-msg">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
  No configured PII or secret patterns matched. Pattern matching can miss sensitive data; review manually before sending anything to an external API.
</div>

<div id="lpa-parse-error" style="display:none;" class="lpa-error-msg"></div>

<div id="lpa-empty" class="lpa-empty-msg">Paste an LLM API request above and click "Analyze".</div>

<hr style="margin:2rem 0;border:none;border-top:1px solid var(--border,#2a2a3a);">

<div class="lpa-tagline-note">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;margin-top:1px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
  The irony of sending your PII checker to a server is not lost on us — this runs 100% client-side.
</div>

<style>
  .lpa-empty-msg { text-align: center; padding: 2.5rem; color: var(--text-3,#888); font-size: 0.9rem; }
  .lpa-clean-msg {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 1rem 1.25rem;
    background: rgba(34,197,94,0.07); border: 1px solid rgba(34,197,94,0.2);
    border-radius: 8px; color: #4ade80; font-size: 0.9rem; font-weight: 600;
  }
  .lpa-error-msg {
    padding: 1rem 1.25rem; border-radius: 8px;
    background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.25);
    color: #f87171; font-size: 0.875rem; line-height: 1.5;
  }

  /* Score card */
  .lpa-score-card {
    display: flex; align-items: center; gap: 24px;
    padding: 24px; margin-bottom: 1rem; border-radius: 12px;
    border: 1px solid var(--border,#2a2a3a); background: var(--surface-1,#1a1a2e);
  }
  @media (max-width: 580px) { .lpa-score-card { flex-direction: column; text-align: center; } }
  .lpa-score-ring {
    position: relative; width: 96px; height: 96px; flex-shrink: 0;
  }
  .lpa-score-ring svg { width: 96px; height: 96px; transform: rotate(-90deg); }
  .lpa-score-ring-bg { fill: none; stroke: var(--border,#2a2a3a); stroke-width: 6; }
  .lpa-score-ring-fg { fill: none; stroke-width: 6; stroke-linecap: round; transition: stroke-dashoffset 0.6s ease; }
  .lpa-score-value {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
    font-size: 1.5rem; font-weight: 800; color: var(--text-1,#e2e8f0);
  }
  .lpa-score-meta { flex: 1; }
  .lpa-score-title { font-size: 1.1rem; font-weight: 700; color: var(--text-1,#e2e8f0); margin: 0 0 0.3rem; }
  .lpa-score-subtitle { font-size: 0.875rem; color: var(--text-2,#94a3b8); line-height: 1.5; margin: 0; }
  .lpa-score-breakdown { display: flex; gap: 1rem; margin-top: 0.75rem; flex-wrap: wrap; }
  .lpa-score-stat {
    font-size: 0.8125rem; font-weight: 600; padding: 4px 10px;
    border-radius: 6px; border: 1px solid var(--border,#2a2a3a);
    background: var(--surface-0,#0f0f1a);
  }
  .lpa-score-stat--critical { color: #f87171; border-color: rgba(239,68,68,0.3); }
  .lpa-score-stat--high { color: #fb923c; border-color: rgba(249,115,22,0.3); }
  .lpa-score-stat--medium { color: #fbbf24; border-color: rgba(234,179,8,0.3); }
  .lpa-score-stat--low { color: #38bdf8; border-color: rgba(56,189,248,0.3); }

  /* Data flow */
  .lpa-flow {
    background: var(--surface-1,#1a1a2e); border: 1px solid var(--border,#2a2a3a);
    border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: 1rem;
  }
  .lpa-flow-label {
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--text-3,#888); margin-bottom: 0.5rem;
  }
  .lpa-flow-diagram {
    display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
    font-size: 0.875rem; font-family: var(--font-mono,monospace);
  }
  .lpa-flow-box {
    padding: 6px 12px; border-radius: 6px; font-weight: 600;
    border: 1px solid var(--border,#2a2a3a);
  }
  .lpa-flow-you { background: rgba(99,102,241,0.12); color: #a5b4fc; border-color: rgba(99,102,241,0.3); }
  .lpa-flow-arrow { color: var(--text-3,#888); font-size: 1rem; }
  .lpa-flow-provider { background: rgba(244,114,182,0.12); color: #f472b6; border-color: rgba(244,114,182,0.3); }
  .lpa-flow-items {
    margin-top: 0.5rem; font-size: 0.8125rem; color: var(--text-2,#94a3b8); line-height: 1.6;
  }
  .lpa-flow-item-warn { color: #f87171; font-weight: 600; }

  /* Findings */
  .lpa-msg-section { margin-bottom: 0.75rem; }
  .lpa-msg-header {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.6rem 0.875rem; flex-wrap: wrap;
    background: var(--surface-1,#1a1a2e);
    border: 1px solid var(--border,#2a2a3a);
    border-radius: 8px 8px 0 0;
  }
  .lpa-msg-header--clean { border-radius: 8px; }
  .lpa-msg-role {
    font-size: 0.8125rem; font-weight: 700; padding: 2px 8px;
    border-radius: 4px; text-transform: uppercase; letter-spacing: 0.05em;
  }
  .lpa-msg-role--system { background: rgba(168,85,247,0.15); color: #c084fc; }
  .lpa-msg-role--user { background: rgba(99,102,241,0.15); color: #a5b4fc; }
  .lpa-msg-role--assistant { background: rgba(34,197,94,0.15); color: #4ade80; }
  .lpa-msg-role--tool { background: rgba(56,189,248,0.15); color: #38bdf8; }
  .lpa-msg-status { font-size: 0.8125rem; color: var(--text-3,#888); margin-left: auto; }
  .lpa-msg-status--warn { color: #f87171; font-weight: 600; }
  .lpa-msg-findings {
    border: 1px solid var(--border,#2a2a3a); border-top: none;
    border-radius: 0 0 8px 8px; overflow: hidden;
  }

  .lpa-finding {
    border-bottom: 1px solid var(--border,#2a2a3a);
    padding: 0.6rem 0.875rem;
  }
  .lpa-finding:last-child { border-bottom: none; }
  .lpa-finding-row {
    display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
  }
  .lpa-finding-type { font-size: 0.8125rem; font-weight: 600; color: var(--text-1,#e2e8f0); flex: 1; min-width: 0; }
  .lpa-badge {
    font-size: 0.7rem; font-weight: 700; padding: 2px 7px;
    border-radius: 4px; text-transform: uppercase; letter-spacing: 0.05em; flex-shrink: 0;
  }
  .lpa-badge--critical { background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.3); }
  .lpa-badge--high { background: rgba(249,115,22,0.12); color: #fb923c; border: 1px solid rgba(249,115,22,0.3); }
  .lpa-badge--medium { background: rgba(234,179,8,0.1); color: #fbbf24; border: 1px solid rgba(234,179,8,0.3); }
  .lpa-badge--low { background: rgba(56,189,248,0.1); color: #38bdf8; border: 1px solid rgba(56,189,248,0.3); }
  .lpa-finding-match {
    font-size: 0.8rem; font-family: var(--font-mono,monospace);
    background: var(--surface-0,#0f0f1a); border-radius: 4px;
