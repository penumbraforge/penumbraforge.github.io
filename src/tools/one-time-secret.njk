---
toolSlug: one-time-secret
permalink: /tools/one-time-secret/
---

<div class="tool-group">
  <label for="ots-input">Your secret</label>
  <textarea id="ots-input" rows="6" placeholder="Paste a password, API key, token, or any sensitive text..." spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
</div>

<div class="tool-row">
  <div class="tool-group" style="min-width:140px; margin-bottom:0;">
    <label for="ots-ttl">Expires after</label>
    <select id="ots-ttl">
      <option value="3600">1 hour</option>
      <option value="86400" selected>24 hours</option>
      <option value="259200">3 days</option>
      <option value="604800">7 days</option>
    </select>
  </div>
  <button class="btn btn--primary" id="ots-create">Create secret link</button>
</div>

<div id="ots-error" style="display:none;" role="alert" aria-live="polite" class="tool-error"></div>

<div id="ots-result" style="display:none;">
  <div class="output-area">
    <button class="btn btn--copy" id="ots-copy" aria-label="Copy secret link">Copy</button>
    <pre id="ots-output" style="word-break:break-all; white-space:pre-wrap;"></pre>
  </div>
  <p style="margin-top:12px; font-size:13px; color:var(--text-3); line-height:1.6;">
    This is <strong>best-effort burn-after-read</strong>, not a guaranteed one-read channel. The worker requests deletion after retrieval, but Cloudflare KV is eventually consistent, so concurrent or geographically separated requests may retrieve the value more than once before deletion propagates. The selected TTL is the final expiry. For passphrase protection, use <a href="/tools/secret-lock/" style="color:var(--accent);">Secret Lock</a> first and share only the ciphertext.
  </p>
</div>

<hr>

<details>
  <summary>How it works</summary>
  <div style="margin-top:12px; font-size:14px; line-height:1.7;">
    <p style="margin-bottom:12px;"><strong>1. Create</strong> — Your secret is sent to a Cloudflare Worker and stored in KV with a TTL. A unique 48-character ID is generated.</p>
    <p style="margin-bottom:12px;"><strong>2. Share</strong> — You get an unguessable retrieval URL. Anyone with it can request the stored value.</p>
    <p style="margin-bottom:12px;"><strong>3. Request deletion</strong> — After a successful retrieval, the worker asks KV to delete the key. Read and delete are separate operations; KV propagation can allow more than one successful request.</p>
    <p><strong>4. Expire</strong> — If nobody views the link, it expires automatically after the chosen TTL.</p>
  </div>
</details>

<hr>

<div>
  <strong>Related tools</strong>
  <div class="tool-related-grid" style="margin-top:12px;">
    <a href="/tools/secret-lock/" class="tool-related-card">
      <h4>Secret Lock</h4>
      <p>Encrypt secrets with a passphrase</p>
    </a>
    <a href="/tools/secret-lock/" class="tool-related-card">
      <h4>Secret Lock</h4>
      <p>Decrypt a locked ciphertext</p>
    </a>
    <a href="/tools/password-generator/" class="tool-related-card">
      <h4>Password Generator</h4>
      <p>Generate strong passwords</p>
    </a>
  </div>
</div>

<script>
(function() {
  var WORKER_URL = 'https://one-time-secret.penumbraforge.workers.dev';
  var input = document.getElementById('ots-input');
  var ttlSelect = document.getElementById('ots-ttl');
  var createBtn = document.getElementById('ots-create');
  var errorEl = document.getElementById('ots-error');
  var resultEl = document.getElementById('ots-result');
  var outputEl = document.getElementById('ots-output');
  var copyBtn = document.getElementById('ots-copy');

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.style.display = 'block';
    resultEl.style.display = 'none';
  }

  function clearError() {
    errorEl.style.display = 'none';
  }

  createBtn.addEventListener('click', async function() {
    clearError();
    var secret = input.value.trim();
    if (!secret) { showError('Enter a secret to share.'); return; }

    createBtn.disabled = true;
    createBtn.textContent = 'Creating...';

    try {
      var resp = await fetch(WORKER_URL + '/api/secrets', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ secret: secret, ttl: parseInt(ttlSelect.value) })
      });

      var data = await resp.json();

      if (!resp.ok) {
        showError(data.error || 'Failed to create secret.');
        return;
      }

      // Keep the bearer retrieval ID in the fragment so it is not sent in the
      // initial page request to the site/CDN. JavaScript sends it only to the
      // secret worker when the recipient opens the page.
      var viewUrl = window.location.origin + '/tools/one-time-secret/#view=' + data.id;
      outputEl.textContent = viewUrl;
      resultEl.style.display = 'block';
      input.value = '';
    } catch (e) {
      showError('Network error — could not reach the server.');
    } finally {
      createBtn.disabled = false;
      createBtn.textContent = 'Create secret link';
    }
  });

  copyBtn.addEventListener('click', function() {
    navigator.clipboard.writeText(outputEl.textContent).then(function() {
      copyBtn.textContent = 'Copied!';
      setTimeout(function() { copyBtn.textContent = 'Copy'; }, 2000);
    });
  });

  // View mode — the fragment is not included in the page's HTTP request.
  var params = new URLSearchParams(window.location.hash.slice(1));
  var viewId = params.get('view');

  if (viewId) {
    // Remove the bearer ID from the visible address/history entry once it has
    // been captured locally. The in-memory value is still used for this fetch.
    history.replaceState(null, '', window.location.pathname);
    // Replace the create UI with a view UI
    input.parentElement.parentElement.innerHTML =
      '<div style="text-align:center; padding:32px 0;">' +
      '<div style="font-size:14px; color:var(--text-3,#888); margin-bottom:16px;">Retrieving stored secret...</div>' +
      '<div id="ots-view-result"></div>' +
      '</div>';

    var viewResult = document.getElementById('ots-view-result');
    createBtn.parentElement.style.display = 'none';

    fetch(WORKER_URL + '/api/secrets/' + encodeURIComponent(viewId))
      .then(function(resp) { return resp.json().then(function(d) { return { ok: resp.ok, data: d }; }); })
      .then(function(r) {
        if (!r.ok) {
          viewResult.innerHTML =
            '<div style="padding:24px; background:rgba(239,68,68,0.06); border:1px solid rgba(239,68,68,0.2); border-radius:10px;">' +
            '<div style="font-size:16px; font-weight:600; color:#f87171; margin-bottom:8px;">Secret not found</div>' +
            '<div style="font-size:14px; color:var(--text-2,#999);">This secret has already been viewed or has expired.</div>' +
            '</div>';
        } else {
          viewResult.innerHTML =
            '<div style="padding:24px; background:rgba(107,207,143,0.06); border:1px solid rgba(107,207,143,0.2); border-radius:10px;">' +
            '<div style="font-size:12px; color:var(--text-3,#888); margin-bottom:8px; text-transform:uppercase; letter-spacing:1px;">Retrieved secret (deletion requested; propagation is not atomic)</div>' +
            '<pre id="ots-view-secret" style="word-break:break-all; white-space:pre-wrap; font-family:var(--font-mono,monospace); font-size:14px; color:var(--text-1,#e2e8f0); margin:12px 0 0; padding:0; background:none; border:none;"></pre>' +
            '<button class="btn" id="ots-view-copy" style="margin-top:16px;">Copy secret</button>' +
            '</div>';
          document.getElementById('ots-view-secret').textContent = r.data.secret;
          document.getElementById('ots-view-copy').addEventListener('click', function() {
            navigator.clipboard.writeText(r.data.secret).then(function() {
              document.getElementById('ots-view-copy').textContent = 'Copied!';
            });
          });
        }
      })
      .catch(function() {
        viewResult.innerHTML =
          '<div style="padding:24px; background:rgba(239,68,68,0.06); border:1px solid rgba(239,68,68,0.2); border-radius:10px;">' +
          '<div style="font-size:14px; color:#f87171;">Network error — could not reach the server.</div>' +
          '</div>';
      });
  }
})();
</script>
