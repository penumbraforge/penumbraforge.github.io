---
toolSlug: lorem-ipsum
permalink: /tools/lorem-ipsum/
---

<div class="tool-row" style="margin-bottom:1rem; gap:0.75rem; align-items:center; flex-wrap:wrap;">
  <div class="tool-options" role="group" aria-label="Unit">
    <button class="tool-option active" data-unit="paragraphs" aria-pressed="true">Paragraphs</button>
    <button class="tool-option" data-unit="sentences" aria-pressed="false">Sentences</button>
    <button class="tool-option" data-unit="words" aria-pressed="false">Words</button>
  </div>
  <div style="display:flex; align-items:center; gap:0.5rem; margin-left:auto;">
    <label for="li-count" style="font-size:0.85rem; white-space:nowrap;">Count:</label>
    <input id="li-count" type="number" min="1" max="100" value="5" style="width:70px; padding:0.35rem 0.5rem; background:var(--color-surface-2,#1e293b); border:1px solid var(--color-border,#334155); border-radius:4px; color:var(--color-text,#e2e8f0); font-size:0.85rem;">
  </div>
  <label style="font-size:0.85rem; display:flex; align-items:center; gap:0.4rem;">
    <input type="checkbox" id="li-classic" checked style="accent-color:var(--color-accent,#6366f1);">
    Start with "Lorem ipsum…"
  </label>
  <label style="font-size:0.85rem; display:flex; align-items:center; gap:0.4rem;">
    <input type="checkbox" id="li-html" style="accent-color:var(--color-accent,#6366f1);">
    Wrap in &lt;p&gt; tags
  </label>
</div>

<div style="margin-bottom:0.75rem; text-align:center;">
  <button class="btn btn--primary" id="li-generate">Generate</button>
</div>

<div class="output-area">
  <button class="btn btn--copy" id="li-copy">Copy</button>
  <div id="li-stats" style="font-size:0.78rem; color:var(--color-muted,#94a3b8); margin-bottom:0.5rem;"></div>
  <pre id="li-output" style="white-space:pre-wrap; word-break:break-word;"></pre>
</div>

<script>
(function () {
  var unitBtns  = Array.prototype.slice.call(document.querySelectorAll('.tool-option[data-unit]'));
  var countEl   = document.getElementById('li-count');
  var classicEl = document.getElementById('li-classic');
  var htmlEl    = document.getElementById('li-html');
  var genBtn    = document.getElementById('li-generate');
  var copyBtn   = document.getElementById('li-copy');
  var outputEl  = document.getElementById('li-output');
  var statsEl   = document.getElementById('li-stats');

  var currentUnit = 'paragraphs';

  var LOREM_WORDS = 'lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua ut enim ad minim veniam quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur excepteur sint occaecat cupidatat non proident sunt in culpa qui officia deserunt mollit anim id est laborum sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium totam rem aperiam eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt neque porro quisquam est qui dolorem ipsum quia dolor sit amet consectetur adipisci velit sed quia non numquam eius modi tempora incidunt ut labore et dolore magnam aliquam quaerat voluptatem ut enim ad minima veniam quis nostrum exercitationem ullam corporis suscipit laboriosam nisi ut aliquid ex ea commodi consequatur quis autem vel eum iure reprehenderit qui in ea voluptate velit esse quam nihil molestiae consequatur vel illum qui dolorem eum fugiat quo voluptas nulla pariatur'.split(' ');

  var LOREM_START = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.';

  var wordIdx = 0;
  function nextWord(capitalize) {
    var w = LOREM_WORDS[wordIdx % LOREM_WORDS.length];
    wordIdx++;
    return capitalize ? w.charAt(0).toUpperCase() + w.slice(1) : w;
  }

  function makeSentence(wordCount) {
    var count = wordCount || (5 + Math.floor(Math.random() * 12));
    var words = [];
    words.push(nextWord(true));
    for (var i = 1; i < count; i++) {
      var w = nextWord(false);
      // Occasionally add a comma
      if (i > 2 && i < count - 1 && Math.random() < 0.15) w += ',';
      words.push(w);
    }
    return words.join(' ') + '.';
  }

  function makeParagraph(sentenceCount) {
    var count = sentenceCount || (3 + Math.floor(Math.random() * 5));
    var sentences = [];
    for (var i = 0; i < count; i++) sentences.push(makeSentence());
    return sentences.join(' ');
  }

  function generate() {
    wordIdx = classicEl.checked ? 0 : Math.floor(Math.random() * LOREM_WORDS.length);
    var count = parseInt(countEl.value) || 5;
    count = Math.max(1, Math.min(count, currentUnit === 'words' ? 1000 : currentUnit === 'sentences' ? 100 : 20));
    var useHtml = htmlEl.checked;
    var result = '';
    var parts = [];

    if (currentUnit === 'paragraphs') {
      for (var i = 0; i < count; i++) {
        var para = (i === 0 && classicEl.checked) ? LOREM_START + ' ' + makeParagraph(2) : makeParagraph();
        parts.push(useHtml ? '<p>' + para + '</p>' : para);
      }
      result = parts.join(useHtml ? '\n' : '\n\n');
    } else if (currentUnit === 'sentences') {
      var sentences = [];
      for (var i = 0; i < count; i++) {
        sentences.push((i === 0 && classicEl.checked) ? LOREM_START : makeSentence());
      }
      result = sentences.join(' ');
      if (useHtml) result = '<p>' + result + '</p>';
    } else { // words
      var words = [];
      if (classicEl.checked) {
        var loremWords = LOREM_START.replace(/[.,]/g, '').split(' ');
        for (var j = 0; j < Math.min(count, loremWords.length); j++) words.push(loremWords[j]);
        for (var k = loremWords.length; k < count; k++) words.push(nextWord(false));
      } else {
        for (var l = 0; l < count; l++) words.push(nextWord(l === 0));
      }
      result = words.join(' ');
      if (useHtml) result = '<p>' + result + '</p>';
    }

    outputEl.textContent = result;

    // Stats
    var wordCount = result.replace(/<[^>]+>/g, '').split(/\s+/).filter(Boolean).length;
    var charCount = result.replace(/<[^>]+>/g, '').length;
    var paraCount = currentUnit === 'paragraphs' ? count : 1;
    statsEl.textContent = wordCount + ' words · ' + charCount + ' characters · ' + paraCount + ' paragraph' + (paraCount !== 1 ? 's' : '');
  }

  unitBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      currentUnit = btn.getAttribute('data-unit');
      unitBtns.forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active'); btn.setAttribute('aria-pressed', 'true');
      // Adjust max
      countEl.max = currentUnit === 'words' ? '1000' : currentUnit === 'sentences' ? '100' : '20';
      if (parseInt(countEl.value) > parseInt(countEl.max)) countEl.value = countEl.max;
      generate();
    });
  });

  countEl.addEventListener('input', generate);
  classicEl.addEventListener('change', generate);
  htmlEl.addEventListener('change', generate);
  genBtn.addEventListener('click', generate);

  copyBtn.addEventListener('click', function () {
    var text = outputEl.textContent;
    if (!text) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () {
        copyBtn.textContent = 'Copied!';
        setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
      });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text; ta.style.cssText = 'position:fixed;opacity:0;';
      document.body.appendChild(ta); ta.focus(); ta.select();
      try { document.execCommand('copy'); copyBtn.textContent = 'Copied!'; } catch (e) { copyBtn.textContent = 'Failed'; }
      document.body.removeChild(ta);
      setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
    }
  });

  generate();
})();
</script>
