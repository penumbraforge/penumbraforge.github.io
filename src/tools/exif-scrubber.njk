    if (report.makerNote) items.push({ t: 'Maker note (proprietary)', risk: true });
    if (report.thumbnail) items.push({ t: 'Embedded thumbnail', risk: false });
    if (report.xmp) items.push({ t: 'XMP' + (report.xmpGps ? ' (contains GPS)' : ''), risk: !!report.xmpGps });
    if (report.icc) items.push({ t: 'ICC colour profile', risk: false });
    if (report.iptc) items.push({ t: 'IPTC / Photoshop block', risk: false });
    if (report.comment) items.push({ t: 'JPEG comment', risk: false });
    if (report.pngTime) items.push({ t: 'PNG timestamp', risk: false });
