    var mime = current ? pickMime(outFmt, current.mime) : 'image/jpeg';
    qualityRow.classList.toggle('off', !isLossy(mime));
  }

  // ================= example generator =================
  // Draws a small scene on a canvas (canvas export has NO metadata), then splices
  // a hand-built EXIF APP1 segment (camera + lens + GPS) into the JPEG bytes.
  async function loadExample() {
    hideError();
    setStatus('Generating an example photo with embedded EXIF + GPS…', true);
    try {
      var w = 480, h = 320;
      var c = document.createElement('canvas'); c.width = w; c.height = h;
      var ctx = c.getContext('2d');
      var sky = ctx.createLinearGradient(0, 0, 0, h);
      sky.addColorStop(0, '#2a2350'); sky.addColorStop(0.6, '#7a5b8e'); sky.addColorStop(1, '#e0a458');
      ctx.fillStyle = sky; ctx.fillRect(0, 0, w, h);
      ctx.fillStyle = 'rgba(255,236,190,0.95)'; ctx.beginPath(); ctx.arc(w * 0.72, h * 0.34, 34, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#171226';
