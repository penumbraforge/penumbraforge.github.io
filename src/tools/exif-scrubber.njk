      ctx.lineTo(0, h * 0.72); ctx.lineTo(w * 0.22, h * 0.6); ctx.lineTo(w * 0.42, h * 0.74);
      ctx.lineTo(w * 0.63, h * 0.56); ctx.lineTo(w * 0.85, h * 0.7); ctx.lineTo(w, h * 0.62); ctx.lineTo(w, h);
      ctx.closePath(); ctx.fill();
      ctx.fillStyle = 'rgba(184,165,214,0.9)'; ctx.font = '12px monospace';
      ctx.fillText('penumbra forge — sample EXIF photo', 12, h - 14);

      var jpegBlob = await toBlob(c, 'image/jpeg', 0.9);
      if (!jpegBlob) throw new Error('canvas encode failed');
      var jpegBytes = new Uint8Array(await jpegBlob.arrayBuffer());
      var app1 = buildExifApp1();
      // insert APP1 right after SOI (first two bytes 0xFFD8)
      var out = new Uint8Array(2 + app1.length + (jpegBytes.length - 2));
      out.set(jpegBytes.subarray(0, 2), 0);
      out.set(app1, 2);
      out.set(jpegBytes.subarray(2), 2 + app1.length);
      var blob = new Blob([out], { type: 'image/jpeg' });
      fileInput.value = '';
      fileInfo.textContent = 'example-photo.jpg (' + fmtBytes(blob.size) + ')  ·  generated locally';
      await analyze(blob, 'example-photo.jpg');
    } catch (e) {
      showError('Could not generate the example in this browser.');
    }
  }

  // Build a little-endian TIFF (IFD0 + Exif SubIFD + GPS IFD) wrapped as an APP1 segment.
  function buildExifApp1() {
    var buf = new ArrayBuffer(4096);
    var dv = new DataView(buf);
    var u8 = new Uint8Array(buf);
    function strBytes(s) { var a = []; for (var i = 0; i < s.length; i++) a.push(s.charCodeAt(i) & 0xff); a.push(0); return a; }
    function encode(entry) {
      var t = entry.type, v = entry.val, bytes = [], count;
      if (t === 2) { bytes = strBytes(v); count = bytes.length; }
      else if (t === 3) { count = v.length; v.forEach(function (x) { bytes.push(x & 0xff, (x >> 8) & 0xff); }); }
      else if (t === 4) { count = v.length; v.forEach(function (x) { bytes.push(x & 0xff, (x >> 8) & 0xff, (x >> 16) & 0xff, (x >> 24) & 0xff); }); }
      else if (t === 1) { count = v.length; bytes = v.slice(); }
      else if (t === 5 || t === 10) { count = v.length; v.forEach(function (pair) { [pair[0], pair[1]].forEach(function (x) { bytes.push(x & 0xff, (x >> 8) & 0xff, (x >> 16) & 0xff, (x >> 24) & 0xff); }); }); }
      return { bytes: bytes, count: count };
    }
    function size(n) { return 2 + 12 * n + 4; }

    var ifd0 = [
      { tag: 0x010F, type: 2, val: 'Canon' },
      { tag: 0x0110, type: 2, val: 'Canon EOS 5D Mark IV' },
      { tag: 0x0112, type: 3, val: [1] },
      { tag: 0x011A, type: 5, val: [[72, 1]] },
      { tag: 0x011B, type: 5, val: [[72, 1]] },
      { tag: 0x0128, type: 3, val: [2] },
      { tag: 0x0131, type: 2, val: 'Adobe Photoshop 26.0 (Macintosh)' },
      { tag: 0x0132, type: 2, val: '2026:06:14 09:41:22' },
      { tag: 0x013B, type: 2, val: 'Jane Photographer' },
      { tag: 0x8298, type: 2, val: '© 2026 Jane Photographer' },
      { tag: 0x8769, type: 4, val: [0] },  // ExifOffset  (patched below)
      { tag: 0x8825, type: 4, val: [0] }   // GPSInfo     (patched below)
    ];
    var exif = [
      { tag: 0x829A, type: 5, val: [[1, 200]] },
      { tag: 0x829D, type: 5, val: [[28, 10]] },
      { tag: 0x8822, type: 3, val: [3] },
      { tag: 0x8827, type: 3, val: [100] },
      { tag: 0x9003, type: 2, val: '2026:06:14 09:41:22' },
      { tag: 0x9004, type: 2, val: '2026:06:14 09:41:22' },
      { tag: 0x9207, type: 3, val: [5] },
      { tag: 0x9209, type: 3, val: [16] },
      { tag: 0x920A, type: 5, val: [[50, 1]] },
      { tag: 0xA001, type: 3, val: [1] },
      { tag: 0xA402, type: 3, val: [0] },
      { tag: 0xA403, type: 3, val: [0] },
      { tag: 0xA405, type: 3, val: [50] },
      { tag: 0xA434, type: 2, val: 'EF24-70mm f/2.8L II USM' },
      { tag: 0xA435, type: 2, val: '000024011000771' }
    ];
    var gps = [
      { tag: 0x0000, type: 1, val: [2, 3, 0, 0] },
      { tag: 0x0001, type: 2, val: 'N' },
      { tag: 0x0002, type: 5, val: [[48, 1], [51, 1], [3024, 100]] },
      { tag: 0x0003, type: 2, val: 'E' },
      { tag: 0x0004, type: 5, val: [[2, 1], [17, 1], [4020, 100]] },
      { tag: 0x0005, type: 1, val: [0] },
      { tag: 0x0006, type: 5, val: [[33, 1]] },
      { tag: 0x001D, type: 2, val: '2026:06:14' }
    ];

    var ifd0Off = 8;
    var exifOff = ifd0Off + size(ifd0.length);
    var gpsOff = exifOff + size(exif.length);
    var dataStart = gpsOff + size(gps.length);
    ifd0[10].val = [exifOff];
    ifd0[11].val = [gpsOff];

    // TIFF header (little-endian "II")
    u8[0] = 0x49; u8[1] = 0x49; dv.setUint16(2, 42, true); dv.setUint32(4, ifd0Off, true);

    var dataPtr = dataStart;
    function writeIFD(offset, entries, next) {
      entries.sort(function (a, b) { return a.tag - b.tag; });
      dv.setUint16(offset, entries.length, true);
      var e = offset + 2;
      entries.forEach(function (entry) {
        var enc = encode(entry);
        dv.setUint16(e, entry.tag, true);
        dv.setUint16(e + 2, entry.type, true);
        dv.setUint32(e + 4, enc.count, true);
        if (enc.bytes.length <= 4) {
          for (var i = 0; i < 4; i++) u8[e + 8 + i] = i < enc.bytes.length ? enc.bytes[i] : 0;
        } else {
          dv.setUint32(e + 8, dataPtr, true);
          for (var j = 0; j < enc.bytes.length; j++) u8[dataPtr + j] = enc.bytes[j];
          dataPtr += enc.bytes.length; if (dataPtr & 1) dataPtr++;
        }
        e += 12;
      });
      dv.setUint32(e, next || 0, true);
    }
    writeIFD(ifd0Off, ifd0, 0);
    writeIFD(exifOff, exif, 0);
    writeIFD(gpsOff, gps, 0);

    var tiff = u8.subarray(0, dataPtr);
    var payloadLen = 6 + tiff.length;                 // "Exif\0\0" + TIFF
    var segLen = payloadLen + 2;                       // + length field
    var app1 = new Uint8Array(2 + segLen);
    app1[0] = 0xff; app1[1] = 0xe1;
    app1[2] = (segLen >> 8) & 0xff; app1[3] = segLen & 0xff;
    var exifSig = [0x45, 0x78, 0x69, 0x66, 0x00, 0x00];
    for (var k = 0; k < 6; k++) app1[4 + k] = exifSig[k];
    app1.set(tiff, 10);
    return app1;
  }

  // ================= clipboard + agent I/O =================
  function copyText(text, btn, label) {
    if (!text) return;
    var done = function (ok) { if (btn) { btn.textContent = ok ? 'Copied!' : 'Copy failed'; btn.classList.toggle('copied', ok); setTimeout(function () { btn.textContent = label; btn.classList.remove('copied'); }, 1800); } };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(function () { done(true); }, function () { done(false); });
    else { try { var ta = el('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta); done(true); } catch (e) { done(false); } }
  }

  function reportToJson(report) {
    var meta = {};
    report.rows.forEach(function (r) { (meta[r.group] = meta[r.group] || {})[r.label] = r.value; });
    return {
      format: report.format, bytes: report.size,
      hasExif: !!report.hasExif, hasGps: !!report.gps,
      gps: report.gps ? { lat: round(report.gps.lat, 6), lon: round(report.gps.lon, 6), altitude: report.gps.alt } : null,
      hasXmp: !!report.xmp, hasIcc: !!report.icc, hasThumbnail: !!report.thumbnail,
      makerNote: !!report.makerNote, tagCount: report.exifTagCount || 0, metadata: meta
    };
  }

  copyJsonEl.addEventListener('click', function () {
    if (!current) return;
    copyText(JSON.stringify(reportToJson(current.report), null, 2), copyJsonEl, 'Copy metadata JSON');
  });

  function publishResult(report, cleanBlob) {
    if (!window.PF) return;
    try {
      var summary;
      if (report.gps) summary = 'GPS location found: ' + round(report.gps.lat, 6) + ', ' + round(report.gps.lon, 6) + '. ' + (report.exifTagCount || 0) + ' EXIF tag(s).';
      else if (report.rows.length) summary = 'No GPS. ' + (report.exifTagCount || report.rows.length) + ' metadata field(s) found (' + report.format.toUpperCase() + ').';
      else summary = 'No embedded metadata found (' + report.format.toUpperCase() + ').';
      if (cleanBlob) summary += ' Clean copy: ' + fmtBytes(cleanBlob.size) + '.';
      PF.ready({ output: summary, data: reportToJson(report) });
    } catch (e) {}
  }

  // ================= wiring =================
  function handleFile(file) {
    if (!file) return;
    fileInfo.textContent = file.name + ' (' + fmtBytes(file.size) + ')';
    analyze(file, file.name);
  }

  dropZone.addEventListener('click', function () { fileInput.click(); });
  dropZone.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); } });
  fileInput.addEventListener('change', function () { if (fileInput.files && fileInput.files[0]) handleFile(fileInput.files[0]); });
  dropZone.addEventListener('dragover', function (e) { e.preventDefault(); dropZone.style.borderColor = 'var(--accent, #b8a5d6)'; dropZone.style.background = 'color-mix(in oklab, var(--accent) 5%, transparent)'; });
  dropZone.addEventListener('dragleave', function () { dropZone.style.borderColor = ''; dropZone.style.background = ''; });
  dropZone.addEventListener('drop', function (e) {
    e.preventDefault(); dropZone.style.borderColor = ''; dropZone.style.background = '';
    var file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
    if (file) handleFile(file);
  });

  exampleBtn.addEventListener('click', function () { loadExample(); });
  stripBtn.addEventListener('click', function () { strip(); });

  Array.prototype.slice.call(fmtOpts.querySelectorAll('.tool-option')).forEach(function (btn) {
    btn.addEventListener('click', function () {
      fmtOpts.querySelectorAll('.tool-option').forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active'); btn.setAttribute('aria-pressed', 'true');
      outFmt = btn.getAttribute('data-fmt');
      updateQualityRow();
    });
  });
  qualityEl.addEventListener('input', function () { qualityVal.textContent = qualityEl.value; });

  // ---- agent invoke: /tools/exif-scrubber/?example=1 loads the demo ----
  if (window.PF) {
    var p = PF.input();
    if (p.example != null || p.demo != null) loadExample();
  }
})();
</script>
