  // ================= analyze pipeline =================
  async function analyze(blob, name) {
    hideError();
    if (!blob) return;
    if (blob.size > MAX_BYTES) { showError('That file is ' + fmtBytes(blob.size) + '. This tool caps at 30 MB so everything stays fast and in-memory. Try a smaller image.'); return; }
    setStatus('Reading file…', true);
    var bytes;
    try { bytes = new Uint8Array(await blob.arrayBuffer()); }
    catch (e) { showError('Could not read that file.'); return; }

    var fmt = detectFormat(bytes);
    if (!fmt) { showError('That does not look like a JPEG, PNG or WebP image. Only those formats carry the metadata this tool reads.'); setStatus(''); return; }

