      cleanWrap.appendChild(img);

      var delta = current.report.size - blob.size;
      var pct = current.report.size ? Math.round(delta / current.report.size * 100) : 0;
      cleanSize.textContent = fmtBytes(blob.size) + (delta > 0 ? '  (−' + pct + '%)' : delta < 0 ? '  (+' + Math.abs(pct) + '%)' : '');

