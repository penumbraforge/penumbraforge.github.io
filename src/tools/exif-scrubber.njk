  async function strip() {
    if (!current) return;
    hideError();
    var mime = pickMime(outFmt, current.mime);
    var quality = isLossy(mime) ? parseInt(qualityEl.value, 10) / 100 : undefined;
    setStatus('Re-encoding a clean copy…', true);
    stripBtn.disabled = true;
    try {
      var bitmap;
      try { bitmap = await createImageBitmap(current.blob, { imageOrientation: 'from-image' }); }
      catch (e) { bitmap = await createImageBitmap(current.blob); }
      var canvas = document.createElement('canvas');
      canvas.width = bitmap.width; canvas.height = bitmap.height;
      var ctx = canvas.getContext('2d');
