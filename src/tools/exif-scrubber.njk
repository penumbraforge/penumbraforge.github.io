    var kind, title, msg;
    if (report.gps) {
      kind = 'danger'; title = 'This photo reveals a GPS location';
      msg = 'Embedded coordinates pinpoint where this image was captured. Anyone you share the original with can read them. Strip the metadata before posting it anywhere public.';
    } else if (hasRisk || report.makerNote) {
      kind = 'warn'; title = 'This photo carries identifying metadata';
      msg = 'It includes device, owner or serial information that can tie the file back to you or your equipment. Consider stripping it before sharing.';
    } else if (report.rows.length || report.xmp || report.icc || report.comment || report.pngText) {
      kind = 'warn'; title = 'This photo contains embedded metadata';
      msg = 'Camera settings, timestamps and software details are baked in. No GPS was found, but you can still remove everything below.';
    } else {
      kind = 'ok'; title = 'No embedded metadata found';
      msg = 'This image is already clean — no EXIF, GPS, XMP or text chunks were detected. You can still re-encode a fresh copy if you like.';
    }
