---
toolSlug: exif-scrubber
permalink: /tools/exif-scrubber/
---

<style>
  .exif-tool .exif-controls-row { display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-top:12px; }
  .exif-tool .exif-hint { font-family:var(--font-mono); font-size:11px; letter-spacing:.4px; color:var(--text-3); }
  .exif-tool .exif-status { font-family:var(--font-mono); font-size:12px; color:var(--text-2); min-height:1em; margin-top:14px; }
  .exif-tool .exif-status.busy::after { content:"\2026"; }

  .exif-tool .exif-empty {
    margin-top:18px; padding:34px 24px; text-align:center;
    border:1px dashed var(--wb-line); border-radius:6px;
    background:color-mix(in oklab, var(--accent) 3%, transparent);
  }
  .exif-tool .exif-empty svg { width:40px; height:40px; color:color-mix(in oklab,var(--accent) 70%, var(--slate)); margin-bottom:10px; }
  .exif-tool .exif-empty h3 { font-family:var(--font-sans); font-weight:500; font-size:16px; color:var(--wb-ink); margin-bottom:6px; }
  .exif-tool .exif-empty p { font-size:13px; line-height:1.65; color:var(--text-3); max-width:52ch; margin:0 auto; }

  #exif-result { margin-top:20px; }

  .exif-tool .exif-verdict {
    display:flex; gap:14px; align-items:flex-start;
    padding:16px 18px; border-radius:4px; border:1px solid var(--wb-line); margin-bottom:18px;
  }
  .exif-tool .exif-verdict .ic { flex-shrink:0; width:22px; height:22px; margin-top:1px; }
  .exif-tool .exif-verdict h3 { font-family:var(--font-sans); font-weight:600; font-size:15px; color:var(--wb-ink); margin-bottom:4px; letter-spacing:-.01em; }
  .exif-tool .exif-verdict p { font-size:13px; line-height:1.6; color:var(--text-2); }
  .exif-tool .exif-verdict--danger { border-color:color-mix(in oklab,#e5765f 48%,transparent); background:color-mix(in oklab,#e5765f 8%,transparent); }
  .exif-tool .exif-verdict--danger .ic { color:#e5765f; }
  .exif-tool .exif-verdict--warn { border-color:color-mix(in oklab,#e0a458 42%,transparent); background:color-mix(in oklab,#e0a458 7%,transparent); }
  .exif-tool .exif-verdict--warn .ic { color:#e0a458; }
  .exif-tool .exif-verdict--ok { border-color:color-mix(in oklab,var(--sage) 38%,transparent); background:color-mix(in oklab,var(--sage) 6%,transparent); }
  .exif-tool .exif-verdict--ok .ic { color:var(--sage); }

  .exif-tool .exif-gps { margin-top:12px; padding:12px 14px; border:1px solid color-mix(in oklab,#e5765f 38%,transparent); border-radius:3px; background:color-mix(in oklab,#e5765f 6%,transparent); }
  .exif-tool .exif-gps .lbl { font-family:var(--font-mono); font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#e5765f; }
  .exif-tool .exif-gps .coord { font-family:var(--font-mono); font-size:17px; color:var(--wb-ink); margin:5px 0; user-select:all; }
  .exif-tool .exif-gps .sub { font-family:var(--font-mono); font-size:11.5px; color:var(--text-2); }
  .exif-tool .exif-gps .btn { margin-top:9px; }

  .exif-tool .exif-previews { margin-bottom:18px; }
  .exif-tool .exif-canvaswrap {
    display:flex; align-items:center; justify-content:center; padding:14px; min-height:150px;
    background-color:#0a0a12;
    background-image:linear-gradient(45deg,#12121c 25%,transparent 25%),linear-gradient(-45deg,#12121c 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#12121c 75%),linear-gradient(-45deg,transparent 75%,#12121c 75%);
    background-size:16px 16px; background-position:0 0,0 8px,8px -8px,-8px 0;
  }
  .exif-tool .exif-canvaswrap img { max-width:100%; max-height:300px; display:block; border-radius:2px; box-shadow:0 8px 30px -12px rgba(0,0,0,.8); }
  .exif-tool .exif-cleanhint { font-family:var(--font-mono); font-size:11.5px; color:var(--text-3); text-align:center; line-height:1.7; }

  .exif-tool .exif-strip-row { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .exif-tool .exif-quality-row { margin:14px 0 4px; }
  .exif-tool .exif-quality-row label { display:block; }
  .exif-tool .exif-quality-row input[type=range] { width:100%; max-width:340px; accent-color:var(--accent); }
  .exif-tool .exif-quality-row.off { opacity:.4; pointer-events:none; }
  .exif-tool .exif-actions .tool-row { display:flex; gap:12px; flex-wrap:wrap; align-items:center; margin-top:12px; }

  .exif-tool .exif-removed { margin-top:22px; }
  .exif-tool .exif-removed .rlabel { font-family:var(--font-mono); font-size:10px; letter-spacing:2px; text-transform:uppercase; color:var(--slate); margin-bottom:10px; }
  .exif-tool .exif-chips { display:flex; flex-wrap:wrap; gap:8px; }
  .exif-tool .exif-chip { display:inline-flex; align-items:center; gap:6px; font-family:var(--font-mono); font-size:11px; padding:5px 10px; border-radius:2px; border:1px solid var(--wb-line); color:var(--text-2); }
  .exif-tool .exif-chip.risk { color:#e5765f; border-color:color-mix(in oklab,#e5765f 38%,transparent); background:color-mix(in oklab,#e5765f 6%,transparent); }
  .exif-tool .exif-chip.none { color:var(--sage); border-color:color-mix(in oklab,var(--sage) 32%,transparent); }

  .exif-tool .exif-group { margin-top:24px; }
  .exif-tool .exif-group > h4 { font-family:var(--font-mono); font-size:10.5px; letter-spacing:2px; text-transform:uppercase; color:var(--slate); margin-bottom:9px; display:flex; align-items:center; gap:10px; }
  .exif-tool .exif-group > h4::after { content:""; flex:1; height:1px; background:linear-gradient(90deg,var(--wb-line),transparent); }
  .exif-tool table.exif-table { width:100%; border-collapse:collapse; font-size:12.5px; }
  .exif-tool table.exif-table td { padding:8px 10px; border-bottom:1px solid color-mix(in oklab,var(--border) 55%,transparent); vertical-align:top; }
  .exif-tool table.exif-table tr:last-child td { border-bottom:0; }
  .exif-tool table.exif-table td.k { font-family:var(--font-mono); color:var(--slate); white-space:nowrap; width:40%; }
  .exif-tool table.exif-table td.v { font-family:var(--font-mono); color:var(--text-1); word-break:break-word; }
  .exif-tool table.exif-table tr.risk td.k { color:#e5765f; }
  .exif-tool .risk-tag { display:inline-block; margin-left:8px; font-size:9.5px; letter-spacing:.6px; text-transform:uppercase; color:#e5765f; border:1px solid color-mix(in oklab,#e5765f 40%,transparent); border-radius:2px; padding:1px 5px; vertical-align:1px; }

  #exif-raw-wrap { margin-top:22px; }
  #exif-raw-wrap summary { cursor:pointer; font-family:var(--font-mono); font-size:11px; letter-spacing:.5px; color:var(--text-2); }
  #exif-raw-wrap pre { margin-top:12px; max-height:280px; overflow:auto; white-space:pre-wrap; word-break:break-word; font-size:11px; line-height:1.6; color:var(--text-2); }
</style>

<div class="exif-tool">
  <div class="tool-group">
    <label>Image file</label>
    <div id="drop-zone" style="border:2px dashed var(--border); border-radius:8px; padding:1.6rem; text-align:center; cursor:pointer; transition:border-color .2s, background .2s; user-select:none;" role="button" tabindex="0" aria-label="Drop an image or click to browse">
      <span id="drop-label">Drop a JPEG, PNG or WebP here or <u>click to browse</u></span>
      <input type="file" id="file-input" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" style="display:none;" aria-hidden="true">
    </div>
    <div id="file-info" style="margin-top:.45rem; font-size:.85rem; color:var(--text-3); font-family:var(--font-mono);"></div>
    <div class="exif-controls-row">
      <button class="btn" id="btn-example" type="button">Load example photo</button>
      <span class="exif-hint">JPEG &middot; PNG &middot; WebP &middot; up to 30&nbsp;MB &middot; nothing is uploaded</span>
    </div>
  </div>

  <div id="exif-status" class="exif-status" role="status" aria-live="polite"></div>
  <div id="exif-error" class="tool-error" role="alert" aria-live="assertive" style="display:none;"></div>

  <div id="exif-empty" class="exif-empty">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.6"/><path d="M21 15l-5-5L5 21"/></svg>
    <h3>Drop a photo to inspect its hidden metadata</h3>
    <p>Cameras and phones bake data into your photos &mdash; exact GPS location, device model, serial numbers and timestamps. This tool reads all of it <strong>on your device</strong>, then lets you download a clean copy with every trace removed. No upload, ever.</p>
  </div>

  <div id="exif-result" hidden>
    <div id="exif-verdict"></div>

    <div class="wb-split exif-previews">
      <div class="wb-panel">
        <div class="wb-panel-bar"><span>Original</span><span id="orig-size" class="wb-badge">&mdash;</span></div>
        <div class="exif-canvaswrap"><img id="orig-img" alt="Original image preview"></div>
      </div>
      <div class="wb-panel">
        <div class="wb-panel-bar"><span>Cleaned</span><span id="clean-size" class="wb-badge wb-badge--local">&mdash;</span></div>
        <div class="exif-canvaswrap" id="clean-wrap"><div class="exif-cleanhint">Strip metadata below<br>to preview the clean copy</div></div>
      </div>
    </div>

    <div class="exif-actions">
      <div class="exif-strip-row">
        <button class="btn btn--primary" id="btn-strip" type="button">Strip all metadata</button>
        <div class="tool-options" id="fmt-opts" role="group" aria-label="Output format">
          <button class="tool-option active" data-fmt="orig" type="button" aria-pressed="true">Same format</button>
          <button class="tool-option" data-fmt="image/jpeg" type="button" aria-pressed="false">JPEG</button>
          <button class="tool-option" data-fmt="image/png" type="button" aria-pressed="false">PNG</button>
          <button class="tool-option" data-fmt="image/webp" type="button" aria-pressed="false">WebP</button>
        </div>
      </div>
      <div class="exif-quality-row" id="quality-row">
        <label for="quality">Quality (JPEG / WebP) &mdash; <span id="quality-val">92</span></label>
        <input type="range" id="quality" min="40" max="100" value="92">
      </div>
      <div class="tool-row">
        <a class="btn btn--primary" id="btn-download" hidden download>Download clean image</a>
        <button class="btn btn--copy" id="btn-copy-json" type="button">Copy metadata JSON</button>
      </div>
    </div>

    <div id="exif-removed"></div>
    <div id="exif-meta"></div>

    <details id="exif-raw-wrap" hidden>
      <summary>Raw XMP / text payload</summary>
      <pre id="exif-raw"></pre>
    </details>
  </div>
</div>

<script>
(function () {
  "use strict";
  var MAX_BYTES = 30 * 1024 * 1024;

  var dropZone   = document.getElementById('drop-zone');
  var fileInput  = document.getElementById('file-input');
  var fileInfo   = document.getElementById('file-info');
  var exampleBtn = document.getElementById('btn-example');
  var statusEl   = document.getElementById('exif-status');
  var errorEl    = document.getElementById('exif-error');
  var emptyEl    = document.getElementById('exif-empty');
  var resultEl   = document.getElementById('exif-result');
  var verdictEl  = document.getElementById('exif-verdict');
  var origImg    = document.getElementById('orig-img');
  var origSize   = document.getElementById('orig-size');
  var cleanSize  = document.getElementById('clean-size');
  var cleanWrap  = document.getElementById('clean-wrap');
  var stripBtn   = document.getElementById('btn-strip');
  var fmtOpts    = document.getElementById('fmt-opts');
  var qualityRow = document.getElementById('quality-row');
  var qualityEl  = document.getElementById('quality');
  var qualityVal = document.getElementById('quality-val');
  var downloadEl = document.getElementById('btn-download');
  var copyJsonEl = document.getElementById('btn-copy-json');
  var removedEl  = document.getElementById('exif-removed');
  var metaEl     = document.getElementById('exif-meta');
  var rawWrap    = document.getElementById('exif-raw-wrap');
  var rawEl      = document.getElementById('exif-raw');

  var current = null;      // { blob, name, mime, report }
  var origUrl = null, cleanUrl = null, outFmt = 'orig';

  // ---------- tiny DOM helpers (all user text via textContent) ----------
  function el(tag, cls, txt) { var e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; }
  function setStatus(msg, busy) { statusEl.textContent = msg || ''; statusEl.classList.toggle('busy', !!busy); }
  function showError(msg) { errorEl.textContent = msg; errorEl.style.display = ''; setStatus(''); }
  function hideError() { errorEl.textContent = ''; errorEl.style.display = 'none'; }
  function fmtBytes(n) {
    if (n == null) return '—';
    if (n < 1024) return n + ' B';
    if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
    return (n / (1024 * 1024)).toFixed(2) + ' MB';
  }
  function round(x, p) { var f = Math.pow(10, p || 0); return Math.round(x * f) / f; }

  // ================= EXIF / TIFF parsing =================
  var TYPE_SIZE = { 1:1, 2:1, 3:2, 4:4, 5:8, 6:1, 7:1, 8:2, 9:4, 10:8, 11:4, 12:8 };
  var TAGS = {
    0x0100:'ImageWidth',0x0101:'ImageHeight',0x0102:'BitsPerSample',0x010E:'ImageDescription',
    0x010F:'Make',0x0110:'Model',0x0112:'Orientation',0x011A:'XResolution',0x011B:'YResolution',
    0x0128:'ResolutionUnit',0x0131:'Software',0x0132:'ModifyDate',0x013B:'Artist',
    0x8298:'Copyright',0x8769:'ExifOffset',0x8825:'GPSInfo',
    0x829A:'ExposureTime',0x829D:'FNumber',0x8822:'ExposureProgram',0x8827:'ISO',
    0x9003:'DateTimeOriginal',0x9004:'DateTimeDigitized',0x9010:'OffsetTime',
    0x9201:'ShutterSpeedValue',0x9202:'ApertureValue',0x9204:'ExposureCompensation',
    0x9207:'MeteringMode',0x9208:'LightSource',0x9209:'Flash',0x920A:'FocalLength',
    0x9291:'SubSecTimeOriginal',0xA001:'ColorSpace',0xA002:'ExifImageWidth',0xA003:'ExifImageHeight',
    0xA402:'ExposureMode',0xA403:'WhiteBalance',0xA404:'DigitalZoomRatio',
    0xA405:'FocalLengthIn35mmFormat',0xA406:'SceneCaptureType',
    0xA430:'CameraOwnerName',0xA431:'BodySerialNumber',0xA432:'LensInfo',
    0xA433:'LensMake',0xA434:'LensModel',0xA435:'LensSerialNumber',0x927C:'MakerNote'
  };
  var GPS_TAGS = {
    0x0000:'GPSVersionID',0x0001:'GPSLatitudeRef',0x0002:'GPSLatitude',0x0003:'GPSLongitudeRef',
    0x0004:'GPSLongitude',0x0005:'GPSAltitudeRef',0x0006:'GPSAltitude',0x0007:'GPSTimeStamp',
    0x0008:'GPSSatellites',0x0009:'GPSStatus',0x0010:'GPSImgDirectionRef',0x0011:'GPSImgDirection',
    0x0012:'GPSMapDatum',0x001B:'GPSProcessingMethod',0x001D:'GPSDateStamp'
  };
  var ENUM = {
    Orientation: { 1:'Normal', 2:'Mirror horizontal', 3:'Rotate 180°', 4:'Mirror vertical', 5:'Mirror + rotate 270° CW', 6:'Rotate 90° CW', 7:'Mirror + rotate 90° CW', 8:'Rotate 270° CW' },
    ResolutionUnit: { 1:'None', 2:'inches', 3:'cm' },
    ExposureProgram: { 0:'Not defined', 1:'Manual', 2:'Program AE', 3:'Aperture-priority', 4:'Shutter-priority', 5:'Creative', 6:'Action', 7:'Portrait', 8:'Landscape' },
    MeteringMode: { 0:'Unknown', 1:'Average', 2:'Center-weighted', 3:'Spot', 4:'Multi-spot', 5:'Multi-segment', 6:'Partial', 255:'Other' },
    WhiteBalance: { 0:'Auto', 1:'Manual' },
    ExposureMode: { 0:'Auto', 1:'Manual', 2:'Auto bracket' },
    ColorSpace: { 1:'sRGB', 2:'Adobe RGB', 65535:'Uncalibrated' },
    SceneCaptureType: { 0:'Standard', 1:'Landscape', 2:'Portrait', 3:'Night' },
    LightSource: { 0:'Unknown', 1:'Daylight', 2:'Fluorescent', 3:'Tungsten', 4:'Flash', 9:'Fine weather', 10:'Cloudy', 11:'Shade' },
    Flash: { 0:'No flash', 1:'Fired', 5:'Fired, no return', 7:'Fired, return detected', 9:'On, fired', 13:'On, no return', 15:'On, return', 16:'Off, did not fire', 24:'Auto, did not fire', 25:'Auto, fired', 29:'Auto, fired, no return', 31:'Auto, fired, return' }
  };
  var GROUP = {
    Make:'Camera', Model:'Camera', LensMake:'Camera', LensModel:'Camera', LensInfo:'Camera',
    BodySerialNumber:'Camera', LensSerialNumber:'Camera', CameraOwnerName:'Camera', Artist:'Camera',
    Copyright:'Camera', MakerNote:'Camera', Software:'Software',
    ExposureTime:'Exposure', FNumber:'Exposure', ISO:'Exposure', FocalLength:'Exposure',
    FocalLengthIn35mmFormat:'Exposure', ExposureProgram:'Exposure', ExposureMode:'Exposure',
    ExposureCompensation:'Exposure', MeteringMode:'Exposure', Flash:'Exposure', WhiteBalance:'Exposure',
    ApertureValue:'Exposure', ShutterSpeedValue:'Exposure', SceneCaptureType:'Exposure',
    ColorSpace:'Exposure', DigitalZoomRatio:'Exposure', LightSource:'Exposure',
    DateTimeOriginal:'Timestamps', DateTimeDigitized:'Timestamps', ModifyDate:'Timestamps',
    OffsetTime:'Timestamps', SubSecTimeOriginal:'Timestamps',
    ImageDescription:'Image', ExifImageWidth:'Image', ExifImageHeight:'Image', Orientation:'Image',
    ImageWidth:'Image', ImageHeight:'Image', XResolution:'Image', YResolution:'Image',
    ResolutionUnit:'Image', BitsPerSample:'Image'
  };
  var RISK = { BodySerialNumber:1, LensSerialNumber:1, CameraOwnerName:1, Artist:1, MakerNote:1 };
  var SKIP = { ExifOffset:1, GPSInfo:1 };
  var GROUP_ORDER = ['Location', 'Camera', 'Exposure', 'Timestamps', 'Software', 'Image', 'Other'];

  function latin1(bytes, off, len) {
    var s = '';
    for (var i = 0; i < len; i++) { var b = bytes[off + i]; if (b === 0) break; s += String.fromCharCode(b); }
    return s.replace(/[␀-]+$/, '').trim();
  }
  function utf8(bytes) { try { return new TextDecoder('utf-8', { fatal: false }).decode(bytes); } catch (e) { return latin1(bytes, 0, bytes.length); } }

  // Read one IFD. dv is a DataView based at the TIFF header (offset 0 == TIFF start).
  function parseIFD(dv, bytes, base, ifdOff, little, tagMap, out) {
    if (ifdOff < 0 || ifdOff + 2 > dv.byteLength) return 0;
    var n = dv.getUint16(ifdOff, little);
    if (n > 512) return 0; // sanity
    var entryBase = ifdOff + 2;
    for (var i = 0; i < n; i++) {
      var e = entryBase + i * 12;
      if (e + 12 > dv.byteLength) break;
      var tag = dv.getUint16(e, little);
      var type = dv.getUint16(e + 2, little);
      var count = dv.getUint32(e + 4, little);
      var comp = TYPE_SIZE[type]; if (!comp) continue;
      var byteLen = comp * count;
      if (byteLen > 4 * 1024 * 1024) continue;
      var valOff = byteLen <= 4 ? e + 8 : dv.getUint32(e + 8, little);
      if (valOff < 0 || valOff + byteLen > dv.byteLength) continue;
      out.push({ tag: tag, name: tagMap[tag], type: type, count: count, values: readValues(dv, bytes, base, valOff, type, count, little) });
    }
    var nextOff = entryBase + n * 12;
    return nextOff + 4 <= dv.byteLength ? dv.getUint32(nextOff, little) : 0;
  }

  function readValues(dv, bytes, base, off, type, count, little) {
    if (type === 2) return latin1(bytes, base + off, count);            // ASCII
    if (type === 7 || type === 1 || type === 6) {                        // BYTE / UNDEFINED
      var arr = []; for (var i = 0; i < Math.min(count, 64); i++) arr.push(bytes[base + off + i]); return arr;
    }
    var vals = [];
    for (var j = 0; j < count && j < 64; j++) {
      if (type === 3) vals.push(dv.getUint16(off + j * 2, little));
      else if (type === 8) vals.push(dv.getInt16(off + j * 2, little));
      else if (type === 4) vals.push(dv.getUint32(off + j * 4, little));
      else if (type === 9) vals.push(dv.getInt32(off + j * 4, little));
      else if (type === 5) vals.push([dv.getUint32(off + j * 8, little), dv.getUint32(off + j * 8 + 4, little)]);
      else if (type === 10) vals.push([dv.getInt32(off + j * 8, little), dv.getInt32(off + j * 8 + 4, little)]);
      else if (type === 11) vals.push(dv.getFloat32(off + j * 4, little));
      else if (type === 12) vals.push(dv.getFloat64(off + j * 8, little));
    }
    return vals;
  }

  function ratio(p) { return Array.isArray(p) ? (p[1] ? p[0] / p[1] : p[0]) : p; }

  function formatValue(name, type, values) {
    if (type === 2) return String(values);
    var v0 = Array.isArray(values) ? values[0] : values;
    var r = ratio(v0);
    switch (name) {
      case 'ExposureTime': if (r > 0 && r < 1) return '1/' + Math.round(1 / r) + ' s'; return round(r, 3) + ' s';
      case 'ShutterSpeedValue': { var st = Math.pow(2, -r); return st < 1 ? '1/' + Math.round(1 / st) + ' s' : round(st, 1) + ' s'; }
      case 'FNumber': return 'f/' + round(r, 2);
      case 'ApertureValue': return 'f/' + round(Math.pow(2, r / 2), 2);
      case 'FocalLength': return round(r, 1) + ' mm';
      case 'FocalLengthIn35mmFormat': return v0 + ' mm';
      case 'ExposureCompensation': return (r > 0 ? '+' : '') + round(r, 2) + ' EV';
      case 'DigitalZoomRatio': return round(r, 2) + '×';
      case 'GPSAltitude': return round(r, 1) + ' m';
      case 'XResolution': case 'YResolution': return round(r, 0) + '';
      case 'GPSImgDirection': return round(r, 1) + '°';
      case 'ISO': return String(v0);
    }
    if (ENUM[name]) { var m = ENUM[name][v0]; return m != null ? m : String(v0); }
    if (type === 5 || type === 10) return String(round(r, 4));
    if (Array.isArray(values)) return values.map(function (x) { return Array.isArray(x) ? (x[1] ? round(x[0] / x[1], 3) : x[0]) : x; }).join(', ');
    return String(values);
  }

  // Parse a full EXIF TIFF block starting at `tiffStart` within bytes.
  function parseExifTiff(bytes, tiffStart, report) {
    try {
      if (tiffStart + 8 > bytes.length) return;
      var dv = new DataView(bytes.buffer, bytes.byteOffset + tiffStart, bytes.byteLength - tiffStart);
      var bo = dv.getUint16(0, false);
      var little = bo === 0x4949; if (!little && bo !== 0x4d4d) return;
      if (dv.getUint16(2, little) !== 42) return;
      var ifd0 = dv.getUint32(4, little);
      var view = new Uint8Array(bytes.buffer, bytes.byteOffset + tiffStart, bytes.byteLength - tiffStart);

      var ifd0Entries = [];
