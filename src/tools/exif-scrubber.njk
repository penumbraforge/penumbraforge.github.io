    current = { blob: blob, name: name || ('image.' + (fmt === 'jpeg' ? 'jpg' : fmt)), mime: blob.type || ('image/' + (fmt === 'jpeg' ? 'jpeg' : fmt)), report: report };
    setStatus('');
    render(report, blob);
    publishResult(report);
  }

  // ================= rendering =================
  function render(report, blob) {
    emptyEl.hidden = true;
    resultEl.hidden = false;

    // original preview
    if (origUrl) URL.revokeObjectURL(origUrl);
    origUrl = URL.createObjectURL(blob);
    origImg.src = origUrl;
    origSize.textContent = fmtBytes(report.size);

    // reset clean panel
    resetClean();

    renderVerdict(report);
    renderRemoved(report);
    renderMeta(report);
    renderRaw(report);
    updateQualityRow();
  }

  function iconFor(kind) {
