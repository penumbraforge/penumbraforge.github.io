<script>
(function () {
  var titleEl     = document.getElementById('srb-title');
  var descEl      = document.getElementById('srb-description');
  var statusEl    = document.getElementById('srb-status');
  var levelEl     = document.getElementById('srb-level');
  var authorEl    = document.getElementById('srb-author');
  var dateEl      = document.getElementById('srb-date');
  var tagsEl      = document.getElementById('srb-tags');
  var tagChipsEl  = document.getElementById('srb-tag-chips');
  var lsCatEl     = document.getElementById('srb-ls-category');
  var lsProdEl    = document.getElementById('srb-ls-product');
  var lsSvcEl     = document.getElementById('srb-ls-service');
  var condEl      = document.getElementById('srb-condition-expr');
  var falseposEl  = document.getElementById('srb-falsepos');
  var groupsEl    = document.getElementById('srb-detection-groups');
  var addGroupBtn = document.getElementById('srb-add-group-btn');
  var generateBtn = document.getElementById('srb-generate-btn');
  var exampleBtn  = document.getElementById('srb-example-btn');
  var clearBtn    = document.getElementById('srb-clear-btn');
  var errorEl     = document.getElementById('srb-error');
  var yamlPre     = document.getElementById('srb-yaml-preview');
  var exportSel   = document.getElementById('srb-export-select');
  var copyYamlBtn = document.getElementById('srb-copy-yaml-btn');
  var downloadBtn = document.getElementById('srb-download-btn');
  var exportOutput= document.getElementById('srb-export-output');
  var exportLabel = document.getElementById('srb-export-label');
  var exportPre   = document.getElementById('srb-export-pre');
  var copyExportBtn = document.getElementById('srb-copy-export-btn');

  var groupCounter = 0;
  var lastYaml = '';

  // ─── Group management ─────────────────────────────────────────────────────
  function addGroup(opts) {
    opts = opts || {};
    groupCounter++;
    var gId = 'grp' + groupCounter;
    var name = opts.name || ('selection' + (groupCounter > 1 ? groupCounter : ''));
    var logic = opts.logic || 'OR';

    var div = document.createElement('div');
    div.className = 'srb-group';
    div.dataset.gid = gId;

    var header = document.createElement('div');
    header.className = 'srb-group-header';

    var nameInput = document.createElement('input');
    nameInput.type = 'text';
    nameInput.className = 'srb-group-name-input';
    nameInput.value = name;
    nameInput.placeholder = 'selection';
    nameInput.spellcheck = false;
    nameInput.title = 'Detection key name (used in condition)';

    var logicSel = document.createElement('select');
    logicSel.className = 'srb-group-logic';
    logicSel.title = 'Field matching logic within this group';
    ['OR', 'AND', 'ALL'].forEach(function (v) {
      var o = document.createElement('option');
      o.value = v;
      o.textContent = v;
      if (v === logic) o.selected = true;
      logicSel.appendChild(o);
    });

    var logicHint = document.createElement('span');
    logicHint.className = 'srb-hint';
    logicHint.textContent = 'within group';

    var removeGrp = document.createElement('button');
    removeGrp.className = 'srb-group-remove';
    removeGrp.textContent = '✕';
    removeGrp.title = 'Remove group';
    removeGrp.addEventListener('click', function () {
      div.parentNode.removeChild(div);
    });

    header.appendChild(nameInput);
    header.appendChild(logicSel);
    header.appendChild(logicHint);
    header.appendChild(removeGrp);

    var body = document.createElement('div');
    body.className = 'srb-group-body';

    var kvList = document.createElement('div');
    kvList.className = 'srb-kv-list';
    body.appendChild(kvList);

    var addRowBtn = document.createElement('button');
    addRowBtn.className = 'btn srb-btn-sm srb-add-row-btn';
    addRowBtn.textContent = '+ Add Field';
    addRowBtn.addEventListener('click', function () { addKvRow(kvList); });
    body.appendChild(addRowBtn);

    div.appendChild(header);
    div.appendChild(body);
    groupsEl.appendChild(div);

    // Pre-populate rows
    var rows = opts.rows || [{ key: '', mod: 'contains', val: '' }];
    rows.forEach(function (r) { addKvRow(kvList, r); });
  }

  function addKvRow(list, opts) {
    opts = opts || {};
    var row = document.createElement('div');
    row.className = 'srb-kv-row';

    var keyInput = document.createElement('input');
    keyInput.type = 'text';
    keyInput.className = 'srb-kv-key';
    keyInput.placeholder = 'FieldName';
    keyInput.value = opts.key || '';
    keyInput.spellcheck = false;
    keyInput.autocomplete = 'off';
    keyInput.title = 'Log field name';

    var modSel = document.createElement('select');
    modSel.className = 'srb-kv-modifier';
    modSel.title = 'Value modifier';
    ['contains', 'startswith', 'endswith', 'contains|all', 're', 'base64', '='].forEach(function (m) {
      var o = document.createElement('option');
      o.value = m;
      o.textContent = m;
      if (m === (opts.mod || 'contains')) o.selected = true;
      modSel.appendChild(o);
    });

    var valInput = document.createElement('input');
    valInput.type = 'text';
    valInput.className = 'srb-kv-val';
    valInput.placeholder = 'value';
    valInput.value = opts.val || '';
    valInput.spellcheck = false;
    valInput.autocomplete = 'off';
    valInput.title = 'Detection value';

    var removeRow = document.createElement('button');
    removeRow.className = 'srb-kv-remove';
    removeRow.textContent = '✕';
    removeRow.title = 'Remove row';
    removeRow.addEventListener('click', function () {
      row.parentNode.removeChild(row);
    });

    row.appendChild(keyInput);
    row.appendChild(modSel);
    row.appendChild(valInput);
    row.appendChild(removeRow);
    list.appendChild(row);
  }

  addGroupBtn.addEventListener('click', function () { addGroup(); });

  // Initialize with one empty group
  addGroup({ name: 'selection', logic: 'OR', rows: [{ key: '', mod: 'contains', val: '' }] });
  condEl.value = 'selection';

  // ─── Tag chips ────────────────────────────────────────────────────────────
  tagsEl.addEventListener('input', function () { renderTagChips(); });

  function renderTagChips() {
    tagChipsEl.innerHTML = '';
    var raw = tagsEl.value;
    if (!raw.trim()) return;
    raw.split(',').forEach(function (t) {
      var trimmed = t.trim();
      if (!trimmed) return;
      var span = document.createElement('span');
      span.className = 'srb-chip';
      span.textContent = 'attack.' + trimmed.toLowerCase();
      tagChipsEl.appendChild(span);
    });
  }

  // ─── YAML builder ─────────────────────────────────────────────────────────
  function indentLines(text, spaces) {
    return text.split('\n').map(function (l) { return ' '.repeat(spaces) + l; }).join('\n');
  }

  function yamlStr(s) {
    if (!s) return "''";
    // Quote if contains special YAML chars
    if (/[:#\[\]{},|>&*!'"?@`]/.test(s) || s.trim() !== s) {
      return "'" + s.replace(/'/g, "''") + "'";
    }
    return s;
  }

  function collectDetection() {
    var groups = groupsEl.querySelectorAll('.srb-group');
    var result = {};

    groups.forEach(function (grp) {
      var gName = grp.querySelector('.srb-group-name-input').value.trim() || 'selection';
      var logic = grp.querySelector('.srb-group-logic').value;
      var rows = grp.querySelectorAll('.srb-kv-row');

      // Group fields by key+modifier
      var fields = {};
      rows.forEach(function (row) {
        var key = row.querySelector('.srb-kv-key').value.trim();
        var mod = row.querySelector('.srb-kv-modifier').value;
        var val = row.querySelector('.srb-kv-val').value;
        if (!key || !val) return;

        var fieldKey = mod === '=' ? key : key + '|' + mod;
        if (!fields[fieldKey]) fields[fieldKey] = [];
        // Support pipe-separated multiple values in val input
        val.split('|').forEach(function (v) {
          var trimmed = v.trim();
          if (trimmed) fields[fieldKey].push(trimmed);
        });
      });

      result[gName] = { fields: fields, logic: logic };
    });

    return result;
  }

  function buildDetectionYaml(detection, condition) {
    var lines = ['detection:'];
    var groupKeys = Object.keys(detection);

    groupKeys.forEach(function (gName) {
      var grp = detection[gName];
      lines.push('  ' + gName + ':');
      var fieldKeys = Object.keys(grp.fields);
      if (!fieldKeys.length) return;

      if (grp.logic === 'AND') {
        // AND: list of maps
        fieldKeys.forEach(function (fk) {
          var vals = grp.fields[fk];
          lines.push('    - ' + fk + ':');
          vals.forEach(function (v) { lines.push('        - ' + yamlStr(v)); });
        });
      } else {
        // OR / ALL: map of lists
        fieldKeys.forEach(function (fk) {
          var vals = grp.fields[fk];
          if (vals.length === 1) {
            lines.push('    ' + fk + ': ' + yamlStr(vals[0]));
          } else {
            lines.push('    ' + fk + ':');
            vals.forEach(function (v) { lines.push('      - ' + yamlStr(v)); });
          }
        });
      }
    });

    if (condition) {
      lines.push('  condition: ' + condition);
    }
    return lines.join('\n');
  }

  function buildYaml() {
    var title = titleEl.value.trim();
    var status = statusEl.value;
    var level = levelEl.value;
    var desc = descEl.value.trim();
    var author = authorEl.value.trim();
    var date = dateEl.value.trim();
    var tagsRaw = tagsEl.value.trim();
    var lsCat = lsCatEl.value;
    var lsProd = lsProdEl.value;
    var lsSvc = lsSvcEl.value;
    var condition = condEl.value.trim();
    var falsepos = falseposEl.value.trim();

    // Validation
    var errors = [];
    if (!title) errors.push('Title is required.');
    if (!condition) errors.push('Condition is required.');
    if (!lsCat && !lsProd && !lsSvc) errors.push('At least one logsource field (category, product, or service) is required.');

    if (errors.length) {
      return { ok: false, errors: errors };
    }

    var lines = ['title: ' + yamlStr(title)];
    if (status) lines.push('status: ' + status);
    if (desc) {
      if (desc.indexOf('\n') !== -1 || desc.length > 70) {
        lines.push('description: |');
        lines.push(indentLines(desc, 2));
      } else {
        lines.push('description: ' + yamlStr(desc));
      }
    }
    if (author) lines.push('author: ' + yamlStr(author));
    if (date) lines.push('date: ' + date);

    // Tags
    var tags = [];
    if (tagsRaw) {
      tagsRaw.split(',').forEach(function (t) {
        var trimmed = t.trim();
        if (trimmed) tags.push('attack.' + trimmed.toLowerCase());
      });
    }
    if (tags.length) {
      lines.push('tags:');
      tags.forEach(function (tag) { lines.push('  - ' + tag); });
    }

    // Logsource
    lines.push('logsource:');
    if (lsCat) lines.push('  category: ' + lsCat);
    if (lsProd) lines.push('  product: ' + lsProd);
    if (lsSvc) lines.push('  service: ' + lsSvc);

    // Detection
    var det = collectDetection();
    lines.push(buildDetectionYaml(det, condition));

    // False positives
    if (falsepos) {
      lines.push('falsepositives:');
      falsepos.split('\n').forEach(function (fp) {
        var trimmed = fp.trim();
        if (trimmed) lines.push('  - ' + yamlStr(trimmed));
      });
    }

    // Level
    if (level) lines.push('level: ' + level);

    return { ok: true, yaml: lines.join('\n') };
  }

  // ─── SIEM export ──────────────────────────────────────────────────────────
  // Simplified translators based on Sigma detection structure
  function exportToSplunk(det, condition) {
    var parts = [];
    Object.keys(det).forEach(function (gName) {
      var grp = det[gName];
      var fieldParts = [];
      Object.keys(grp.fields).forEach(function (fk) {
        var vals = grp.fields[fk];
        // Extract field name (strip modifier suffix)
        var field = fk.split('|')[0];
        var mod = fk.includes('|') ? fk.split('|')[1] : 'contains';
        var valExprs = vals.map(function (v) {
          if (mod === 'startswith') return field + '="' + v + '*"';
          if (mod === 'endswith')   return field + '="*' + v + '"';
          if (mod === 're')          return 'match(' + field + ', "' + v.replace(/"/g, '\\"') + '")';
          if (mod === '=')           return field + '="' + v.replace(/"/g, '\\"') + '"';
          return field + '="*' + v + '*"';
        });
        fieldParts.push(valExprs.length === 1 ? valExprs[0] : '(' + valExprs.join(' OR ') + ')');
      });
      if (fieldParts.length) {
        parts.push('(selection=' + gName + ' AND (' + fieldParts.join(grp.logic === 'AND' ? ' AND ' : ' OR ') + '))');
      }
    });
    if (!parts.length) return '| search *  /* no detection fields — add field/value rows */';
    return '| search ' + parts.join(' OR ');
  }

  function exportToKql(det, condition) {
    var lines = [];
    Object.keys(det).forEach(function (gName) {
      var grp = det[gName];
      var fieldParts = [];
      Object.keys(grp.fields).forEach(function (fk) {
        var vals = grp.fields[fk];
        var field = fk.split('|')[0];
        var mod = fk.includes('|') ? fk.split('|')[1] : 'contains';
        var valExprs = vals.map(function (v) {
          if (mod === 'startswith') return field + ' startswith "' + v.replace(/"/g, '\\"') + '"';
          if (mod === 'endswith')   return field + ' endswith "' + v.replace(/"/g, '\\"') + '"';
          if (mod === 're')          return field + ' matches regex "' + v.replace(/"/g, '\\"') + '"';
          if (mod === '=')           return field + ' == "' + v.replace(/"/g, '\\"') + '"';
          return field + ' contains "' + v.replace(/"/g, '\\"') + '"';
        });
        fieldParts.push(valExprs.length === 1 ? valExprs[0] : '(' + valExprs.join(grp.logic === 'AND' ? '\n    and ' : '\n    or ') + ')');
      });
      if (fieldParts.length) {
        lines.push('// ' + gName);
        lines.push('| where ' + fieldParts.join(grp.logic === 'AND' ? '\n    and ' : '\n    or '));
      }
    });
    if (!lines.length) return 'SecurityEvent\n| where *  // no detection fields — add field/value rows';
    return 'SecurityEvent\n' + lines.join('\n');
  }

  function exportToEsql(det, condition) {
    var lines = [];
    Object.keys(det).forEach(function (gName) {
      var grp = det[gName];
      var fieldParts = [];
      Object.keys(grp.fields).forEach(function (fk) {
        var vals = grp.fields[fk];
        var field = fk.split('|')[0];
        var mod = fk.includes('|') ? fk.split('|')[1] : 'contains';
        var valExprs = vals.map(function (v) {
          if (mod === 'startswith') return field + ' LIKE "' + v.replace(/"/g, '\\"') + '%"';
          if (mod === 'endswith')   return field + ' LIKE "%' + v.replace(/"/g, '\\"') + '"';
          if (mod === 're')          return field + ' RLIKE "' + v.replace(/"/g, '\\"') + '"';
          if (mod === '=')           return field + ' == "' + v.replace(/"/g, '\\"') + '"';
          return field + ' LIKE "%' + v.replace(/"/g, '\\"') + '%"';
        });
        fieldParts.push(valExprs.length === 1 ? valExprs[0] : '(' + valExprs.join(grp.logic === 'AND' ? ' AND ' : ' OR ') + ')');
      });
      if (fieldParts.length) {
        lines.push('  // ' + gName + ': ' + fieldParts.join(grp.logic === 'AND' ? ' AND ' : ' OR '));
      }
    });
    if (!lines.length) return 'FROM logs-*\n| WHERE true  // no detection fields — add field/value rows';
    return 'FROM logs-*\n| WHERE\n' + lines.join(' OR\n');
  }

  // ─── Generate button ──────────────────────────────────────────────────────
  generateBtn.addEventListener('click', function () {
    errorEl.style.display = 'none';
    errorEl.textContent = '';
    var result = buildYaml();
    if (!result.ok) {
      errorEl.textContent = result.errors.join(' ');
      errorEl.style.display = '';
      return;
    }
    lastYaml = result.yaml;
    yamlPre.textContent = lastYaml;
    exportOutput.style.display = 'none';
    exportSel.value = '';
  });

  // ─── Live auto-update (debounced) ─────────────────────────────────────────
  var updateTimer = null;
  function scheduleUpdate() {
    clearTimeout(updateTimer);
    updateTimer = setTimeout(function () {
      var result = buildYaml();
      if (result.ok) {
        lastYaml = result.yaml;
        yamlPre.textContent = lastYaml;
      }
    }, 300);
  }

  [titleEl, descEl, statusEl, levelEl, authorEl, dateEl, tagsEl,
   lsCatEl, lsProdEl, lsSvcEl, condEl, falseposEl].forEach(function (el) {
    el.addEventListener('input', scheduleUpdate);
    el.addEventListener('change', scheduleUpdate);
  });

  groupsEl.addEventListener('input', scheduleUpdate);
  groupsEl.addEventListener('change', scheduleUpdate);

  // ─── Export selector ──────────────────────────────────────────────────────
  exportSel.addEventListener('change', function () {
    var fmt = exportSel.value;
    if (!fmt) { exportOutput.style.display = 'none'; return; }
    if (!lastYaml) {
      var gen = buildYaml();
      if (!gen.ok) { exportOutput.style.display = 'none'; return; }
      lastYaml = gen.yaml;
      yamlPre.textContent = lastYaml;
    }

    var det = collectDetection();
    var condition = condEl.value.trim();
    var query = '';
    var labelText = '';

    if (fmt === 'splunk') { query = exportToSplunk(det, condition); labelText = 'Splunk SPL'; }
    else if (fmt === 'kql') { query = exportToKql(det, condition); labelText = 'KQL (Microsoft Sentinel)'; }
    else if (fmt === 'esql') { query = exportToEsql(det, condition); labelText = 'ES|QL (Elastic)'; }

    exportLabel.textContent = labelText;
    exportPre.textContent = query;
    exportOutput.style.display = '';
  });

  // ─── Copy / Download ──────────────────────────────────────────────────────
  copyYamlBtn.addEventListener('click', function () {
    if (!lastYaml) {
      var gen = buildYaml();
      if (!gen.ok) return;
      lastYaml = gen.yaml;
    }
    navigator.clipboard.writeText(lastYaml).then(function () {
      var orig = copyYamlBtn.textContent;
      copyYamlBtn.textContent = 'Copied!';
      setTimeout(function () { copyYamlBtn.textContent = orig; }, 1500);
    });
  });

  copyExportBtn.addEventListener('click', function () {
    var text = exportPre.textContent;
    if (!text) return;
    navigator.clipboard.writeText(text).then(function () {
      var orig = copyExportBtn.textContent;
      copyExportBtn.textContent = 'Copied!';
      setTimeout(function () { copyExportBtn.textContent = orig; }, 1500);
    });
  });

  downloadBtn.addEventListener('click', function () {
    if (!lastYaml) {
      var gen = buildYaml();
      if (!gen.ok) return;
      lastYaml = gen.yaml;
    }
    var rawTitle = titleEl.value.trim() || 'sigma-rule';
    var filename = rawTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') + '.yml';
    var blob = new Blob([lastYaml], { type: 'text/yaml' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  // ─── Example ──────────────────────────────────────────────────────────────
  exampleBtn.addEventListener('click', function () {
    // Clear existing groups
    while (groupsEl.firstChild) groupsEl.removeChild(groupsEl.firstChild);
    groupCounter = 0;

    titleEl.value = 'Suspicious PowerShell Execution';
    descEl.value = 'Detects suspicious PowerShell commands that use encoded commands, bypass execution policy, or download and execute content.';
    statusEl.value = 'experimental';
    levelEl.value = 'high';
    authorEl.value = 'Penumbra Forge';
    dateEl.value = '2026/03/27';
    tagsEl.value = 'T1059.001, T1027.010, T1105';
    lsCatEl.value = 'process_creation';
    lsProdEl.value = 'windows';
    lsSvcEl.value = 'sysmon';
    condEl.value = 'selection and not filter';
    falseposEl.value = 'Legitimate admin scripts\nSoftware deployment tools (SCCM, PDQ Deploy)';

    renderTagChips();

    addGroup({
      name: 'selection',
      logic: 'OR',
      rows: [
        { key: 'CommandLine|contains', mod: 'contains', val: '-EncodedCommand' },
        { key: 'CommandLine|contains', mod: 'contains', val: '-ExecutionPolicy Bypass' },
        { key: 'CommandLine|contains', mod: 'contains', val: 'DownloadString' },
        { key: 'CommandLine|contains', mod: 'contains', val: 'IEX(' }
      ]
    });

    addGroup({
      name: 'filter',
      logic: 'OR',
      rows: [
        { key: 'Image|endswith', mod: 'endswith', val: '\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe' }
      ]
    });

    var gen = buildYaml();
    if (gen.ok) {
      lastYaml = gen.yaml;
      yamlPre.textContent = lastYaml;
    }
    errorEl.style.display = 'none';
    exportOutput.style.display = 'none';
    exportSel.value = '';
  });

  // ─── Clear ────────────────────────────────────────────────────────────────
  clearBtn.addEventListener('click', function () {
    titleEl.value = '';
    descEl.value = '';
    statusEl.value = 'experimental';
    levelEl.value = 'medium';
    authorEl.value = '';
    dateEl.value = '';
    tagsEl.value = '';
    tagChipsEl.innerHTML = '';
    lsCatEl.value = '';
    lsProdEl.value = '';
    lsSvcEl.value = '';
    condEl.value = 'selection';
    falseposEl.value = '';
    while (groupsEl.firstChild) groupsEl.removeChild(groupsEl.firstChild);
    groupCounter = 0;
    addGroup({ name: 'selection', logic: 'OR', rows: [{ key: '', mod: 'contains', val: '' }] });
    lastYaml = '';
    yamlPre.textContent = '— fill in the form and click "Generate YAML" —';
    errorEl.style.display = 'none';
    exportOutput.style.display = 'none';
    exportSel.value = '';
  });

  // Trigger initial preview render with blank state
  scheduleUpdate();
})();
</script>
