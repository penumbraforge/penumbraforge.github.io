---
toolSlug: sigma-rule-builder
permalink: /tools/sigma-rule-builder/
---

<div class="srb-layout">
  <!-- Left: Form panel -->
  <div class="srb-panel srb-panel--form">

    <!-- Metadata -->
    <div class="srb-section">
      <div class="srb-section-title">Metadata</div>
      <div class="srb-field-row">
        <div class="srb-field srb-field--wide">
          <label for="srb-title">Title</label>
          <input type="text" id="srb-title" class="srb-input" placeholder="Suspicious PowerShell Execution" spellcheck="false" autocomplete="off">
        </div>
      </div>
      <div class="srb-field-row">
        <div class="srb-field srb-field--wide">
          <label for="srb-description">Description</label>
          <textarea id="srb-description" class="srb-textarea srb-textarea--sm" placeholder="Detects…" rows="2" spellcheck="false"></textarea>
        </div>
      </div>
      <div class="srb-field-row">
        <div class="srb-field">
          <label for="srb-status">Status</label>
          <select id="srb-status" class="srb-select">
            <option value="experimental">experimental</option>
            <option value="test">test</option>
            <option value="stable">stable</option>
            <option value="deprecated">deprecated</option>
          </select>
        </div>
        <div class="srb-field">
          <label for="srb-level">Level</label>
          <select id="srb-level" class="srb-select">
            <option value="informational">informational</option>
            <option value="low">low</option>
            <option value="medium" selected>medium</option>
            <option value="high">high</option>
            <option value="critical">critical</option>
          </select>
        </div>
      </div>
      <div class="srb-field-row">
        <div class="srb-field">
          <label for="srb-author">Author</label>
          <input type="text" id="srb-author" class="srb-input" placeholder="analyst" spellcheck="false" autocomplete="off">
        </div>
        <div class="srb-field">
          <label for="srb-date">Date</label>
          <input type="text" id="srb-date" class="srb-input" placeholder="2026/03/27" spellcheck="false" autocomplete="off">
        </div>
      </div>
      <div class="srb-field-row">
        <div class="srb-field srb-field--wide">
          <label for="srb-tags">MITRE ATT&amp;CK Tags <span class="srb-hint">(comma-separated: T1566, T1059.001)</span></label>
          <input type="text" id="srb-tags" class="srb-input" placeholder="T1566, T1059.001, T1071" spellcheck="false" autocomplete="off">
          <div class="srb-tag-chips" id="srb-tag-chips"></div>
        </div>
      </div>
    </div>

    <!-- Logsource -->
    <div class="srb-section">
      <div class="srb-section-title">Logsource</div>
      <div class="srb-field-row">
        <div class="srb-field">
          <label for="srb-ls-category">Category</label>
          <select id="srb-ls-category" class="srb-select">
            <option value="">— none —</option>
            <option value="process_creation">process_creation</option>
            <option value="network_connection">network_connection</option>
            <option value="file_event">file_event</option>
            <option value="registry_event">registry_event</option>
            <option value="dns_query">dns_query</option>
            <option value="image_load">image_load</option>
            <option value="pipe_created">pipe_created</option>
            <option value="driver_load">driver_load</option>
            <option value="web">web</option>
          </select>
        </div>
        <div class="srb-field">
          <label for="srb-ls-product">Product</label>
          <select id="srb-ls-product" class="srb-select">
            <option value="">— none —</option>
            <option value="windows">windows</option>
            <option value="linux">linux</option>
            <option value="macos">macos</option>
            <option value="aws">aws</option>
            <option value="azure">azure</option>
            <option value="gcp">gcp</option>
          </select>
        </div>
        <div class="srb-field">
          <label for="srb-ls-service">Service</label>
          <select id="srb-ls-service" class="srb-select">
            <option value="">— none —</option>
            <option value="sysmon">sysmon</option>
            <option value="security">security</option>
            <option value="system">system</option>
            <option value="powershell">powershell</option>
            <option value="application">application</option>
            <option value="bits-client">bits-client</option>
            <option value="taskscheduler">taskscheduler</option>
            <option value="windefend">windefend</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Detection -->
    <div class="srb-section">
      <div class="srb-section-title">
        Detection
        <button class="btn srb-btn-sm" id="srb-add-group-btn">+ Add Group</button>
      </div>
      <div id="srb-detection-groups"></div>
      <div class="srb-condition-row">
        <label for="srb-condition-expr">Condition</label>
        <input type="text" id="srb-condition-expr" class="srb-input" placeholder="selection" spellcheck="false" autocomplete="off">
        <span class="srb-hint">e.g. selection or (selection1 and not filter)</span>
      </div>
    </div>

    <!-- False Positives -->
    <div class="srb-section">
      <div class="srb-section-title">False Positives</div>
      <textarea id="srb-falsepos" class="srb-textarea" rows="3" placeholder="One entry per line, e.g.&#10;Legitimate admin scripts&#10;Software deployment tools" spellcheck="false"></textarea>
    </div>

    <div class="srb-actions">
      <button class="btn btn--primary" id="srb-generate-btn">Generate YAML</button>
      <button class="btn srb-btn-sm" id="srb-example-btn">Try Example</button>
      <button class="btn srb-btn-sm" id="srb-clear-btn">Clear</button>
      <div id="srb-error" class="srb-error-msg" style="display:none;"></div>
    </div>
  </div>

  <!-- Right: YAML preview + Export -->
  <div class="srb-panel srb-panel--preview">
    <div class="srb-panel-header">
      <span class="srb-panel-title">YAML Preview</span>
      <div class="srb-preview-actions">
        <select id="srb-export-select" class="srb-select srb-select--sm">
          <option value="">Export to SIEM…</option>
          <option value="splunk">Splunk SPL</option>
          <option value="kql">KQL (Sentinel)</option>
          <option value="esql">ES|QL (Elastic)</option>
        </select>
        <button class="btn srb-btn-sm" id="srb-copy-yaml-btn">Copy YAML</button>
        <button class="btn srb-btn-sm" id="srb-download-btn">Download .yml</button>
      </div>
    </div>
    <pre id="srb-yaml-preview" class="srb-yaml-pre">— fill in the form and click "Generate YAML" —</pre>
    <div id="srb-export-output" style="display:none;">
      <div class="srb-export-header">
        <span id="srb-export-label" class="srb-export-label"></span>
        <button class="btn srb-btn-sm" id="srb-copy-export-btn">Copy</button>
      </div>
      <pre id="srb-export-pre" class="srb-yaml-pre srb-yaml-pre--export"></pre>
    </div>
  </div>
</div>

<style>
