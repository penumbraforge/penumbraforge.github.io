    background: var(--surface-0,#0f0f1a);
    border: 1px solid var(--border,#2a2a3a);
    border-radius: 6px;
    color: var(--text-1,#e2e8f0);
    font-family: var(--font-mono,monospace);
    font-size: 0.8rem;
    padding: 0.75rem;
    resize: vertical;
  }

  /* ── openssl command cards ── */
  .scd-cmd-card {
    border: 1px solid var(--border,#2a2a3a);
    border-radius: 7px;
    margin-bottom: 0.625rem;
