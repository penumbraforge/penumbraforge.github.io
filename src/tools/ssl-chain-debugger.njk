    word-break: break-all;
    background: none;
    padding: 0;
  }
  .scd-copy-btn { flex-shrink: 0; font-size: 0.75rem; padding: 3px 10px; }

  /* ── Hostname tab inputs ── */
  .scd-host-input {
    width: 100%;
    box-sizing: border-box;
    background: var(--surface-1,#1a1a2e);
    border: 1px solid var(--border,#2a2a3a);
    border-radius: 6px;
    color: var(--text-1,#e2e8f0);
