---
toolSlug: ssl-chain-debugger
permalink: /tools/ssl-chain-debugger/
---

<div id="scd-tabs" class="scd-tabs">
  <button class="scd-tab scd-tab--active" data-tab="chain">Analyze Chain</button>
  <button class="scd-tab" data-tab="hostname">Check Hostname</button>
</div>

<!-- ── Chain Analyzer tab ── -->
<div id="scd-tab-chain" class="scd-tab-panel">
  <div class="tool-group">
    <label for="scd-input">Paste PEM certificates (leaf first, root last — or in any order)</label>
    <textarea id="scd-input" rows="14" placeholder="-----BEGIN CERTIFICATE-----&#10;MIIFazCC...&#10;-----END CERTIFICATE-----&#10;-----BEGIN CERTIFICATE-----&#10;..." spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
  </div>

  <div class="tool-row">
    <button class="btn btn--primary" id="scd-analyze-btn">Analyze Chain</button>
    <button class="btn" id="scd-example-btn">Try Example</button>
    <button class="btn" id="scd-clear-btn">Clear</button>
    <button class="btn" id="scd-fix-btn" style="display:none;">Fix Chain Order</button>
    <div id="scd-summary" style="margin-left:auto;font-size:0.875rem;color:var(--text-3,#888);align-self:center;"></div>
  </div>

  <div id="scd-empty" class="scd-empty-msg">Paste PEM certificates above and click "Analyze Chain".</div>

  <div id="scd-results" style="display:none;">
    <!-- Issues panel -->
    <div id="scd-issues-panel" style="display:none;">
      <div class="scd-section-label">Issues Found</div>
      <div id="scd-issues-list"></div>
    </div>

    <!-- Chain diagram -->
    <div class="scd-section-label" style="margin-top:1.25rem;">Certificate Chain</div>
    <div id="scd-chain-diagram"></div>

    <!-- Fixed PEM output -->
    <div id="scd-fixed-output" style="display:none;">
      <div class="scd-section-label" style="margin-top:1.25rem;">Reordered Chain (Leaf &rarr; Root)</div>
      <textarea id="scd-fixed-pem" class="scd-pem-out" rows="10" readonly></textarea>
      <div class="tool-row" style="margin-top:0.5rem;">
        <button class="btn" id="scd-copy-fixed-btn">Copy PEM</button>
        <button class="btn" id="scd-hide-fixed-btn">Hide</button>
      </div>
    </div>
  </div>

  <!-- openssl reference -->
  <hr style="margin:2rem 0;border:none;border-top:1px solid var(--border,#2a2a3a);">
  <div class="scd-section-label">Common openssl Commands</div>
  <div id="scd-cmds-list">
    <div class="scd-cmd-card">
      <div class="scd-cmd-title">View certificate details from a file</div>
      <div class="scd-cmd-row">
        <code class="scd-cmd-code">openssl x509 -in cert.pem -text -noout</code>
        <button class="btn scd-copy-btn" data-cmd="openssl x509 -in cert.pem -text -noout">Copy</button>
      </div>
    </div>
    <div class="scd-cmd-card">
      <div class="scd-cmd-title">Verify chain file (bundle) against a root CA store</div>
      <div class="scd-cmd-row">
        <code class="scd-cmd-code">openssl verify -CAfile ca-bundle.pem cert.pem</code>
        <button class="btn scd-copy-btn" data-cmd="openssl verify -CAfile ca-bundle.pem cert.pem">Copy</button>
      </div>
    </div>
    <div class="scd-cmd-card">
      <div class="scd-cmd-title">Check that cert and private key match (modulus hash)</div>
      <div class="scd-cmd-row">
        <code class="scd-cmd-code">openssl x509 -noout -modulus -in cert.pem | openssl md5
openssl rsa  -noout -modulus -in key.pem  | openssl md5</code>
        <button class="btn scd-copy-btn" data-cmd="openssl x509 -noout -modulus -in cert.pem | openssl md5&#10;openssl rsa  -noout -modulus -in key.pem  | openssl md5">Copy</button>
      </div>
    </div>
    <div class="scd-cmd-card">
      <div class="scd-cmd-title">Show expiry date only</div>
      <div class="scd-cmd-row">
        <code class="scd-cmd-code">openssl x509 -enddate -noout -in cert.pem</code>
        <button class="btn scd-copy-btn" data-cmd="openssl x509 -enddate -noout -in cert.pem">Copy</button>
      </div>
    </div>
    <div class="scd-cmd-card">
      <div class="scd-cmd-title">Extract all certs from a bundle into separate files</div>
      <div class="scd-cmd-row">
        <code class="scd-cmd-code">awk '/BEGIN CERT/{n++} {print > "cert-" n ".pem"}' bundle.pem</code>
        <button class="btn scd-copy-btn" data-cmd="awk '/BEGIN CERT/{n++} {print > &quot;cert-&quot; n &quot;.pem&quot;}' bundle.pem">Copy</button>
      </div>
    </div>
    <div class="scd-cmd-card">
      <div class="scd-cmd-title">Check CRL / OCSP stapling from a live server</div>
      <div class="scd-cmd-row">
        <code class="scd-cmd-code">openssl s_client -connect example.com:443 -status 2&gt;&amp;1 | grep -i ocsp</code>
        <button class="btn scd-copy-btn" data-cmd="openssl s_client -connect example.com:443 -status 2>&amp;1 | grep -i ocsp">Copy</button>
      </div>
    </div>
    <div class="scd-cmd-card">
      <div class="scd-cmd-title">Convert DER to PEM</div>
      <div class="scd-cmd-row">
        <code class="scd-cmd-code">openssl x509 -inform DER -in cert.der -out cert.pem</code>
        <button class="btn scd-copy-btn" data-cmd="openssl x509 -inform DER -in cert.der -out cert.pem">Copy</button>
      </div>
    </div>
    <div class="scd-cmd-card">
      <div class="scd-cmd-title">Export full chain from a PKCS#12 (.p12 / .pfx) file</div>
      <div class="scd-cmd-row">
        <code class="scd-cmd-code">openssl pkcs12 -in bundle.p12 -nokeys -out chain.pem</code>
        <button class="btn scd-copy-btn" data-cmd="openssl pkcs12 -in bundle.p12 -nokeys -out chain.pem">Copy</button>
      </div>
    </div>
  </div>
</div>

<!-- ── Check Hostname tab ── -->
<div id="scd-tab-hostname" class="scd-tab-panel" style="display:none;">
  <div class="tool-group">
    <label for="scd-host-input">Hostname or IP address</label>
    <input type="text" id="scd-host-input" class="scd-host-input" placeholder="example.com" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
  </div>
  <div class="tool-row" style="gap:0.75rem;align-items:center;flex-wrap:wrap;">
    <label style="font-size:0.875rem;color:var(--text-2,#94a3b8);">Port</label>
    <input type="number" id="scd-port-input" class="scd-port-input" value="443" min="1" max="65535">
    <label style="font-size:0.875rem;color:var(--text-2,#94a3b8);">Protocol</label>
    <select id="scd-proto-select" class="scd-select">
      <option value="">HTTPS (default)</option>
      <option value="-starttls smtp">SMTP STARTTLS</option>
      <option value="-starttls imap">IMAP STARTTLS</option>
      <option value="-starttls ftp">FTP STARTTLS</option>
      <option value="-starttls ldap">LDAP STARTTLS</option>
    </select>
    <button class="btn btn--primary" id="scd-gen-cmd-btn">Generate Commands</button>
  </div>

  <div id="scd-host-empty" class="scd-empty-msg">Enter a hostname above and click "Generate Commands".</div>
  <div id="scd-host-results" style="display:none;">
    <div class="scd-section-label" style="margin-top:1.25rem;">openssl Commands for <span id="scd-host-display"></span></div>
    <p style="font-size:0.875rem;color:var(--text-2,#94a3b8);margin:0.5rem 0 1rem;">Run these in your terminal &mdash; they connect to the live server, which cannot be done from the browser.</p>
    <div id="scd-host-cmds"></div>
  </div>
</div>

<style>
  /* ── Tabs ── */
  .scd-tabs {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border,#2a2a3a);
  }
  .scd-tab {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-2,#94a3b8);
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    margin-bottom: -1px;
    transition: color 0.15s, border-color 0.15s;
  }
  .scd-tab:hover { color: var(--text-1,#e2e8f0); }
  .scd-tab--active { color: #818cf8; border-bottom-color: #818cf8; }

  /* ── Section labels ── */
  .scd-section-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3,#888);
    margin-bottom: 0.75rem;
  }

  /* ── Empty / placeholder ── */
  .scd-empty-msg {
    text-align: center;
    padding: 2.5rem;
    color: var(--text-3,#888);
    font-size: 0.9rem;
  }

  /* ── Issue cards ── */
  .scd-issue {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    border-radius: 7px;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .scd-issue--error   { background: rgba(239,68,68,0.1);  border: 1px solid rgba(239,68,68,0.25);  color: #fca5a5; }
  .scd-issue--warning { background: rgba(234,179,8,0.08); border: 1px solid rgba(234,179,8,0.22);  color: #fde68a; }
  .scd-issue--info    { background: rgba(99,102,241,0.08);border: 1px solid rgba(99,102,241,0.22); color: #a5b4fc; }
  .scd-issue-icon { font-size: 1rem; flex-shrink: 0; margin-top: 0.05rem; }
  .scd-issue-text strong { display: block; font-weight: 700; margin-bottom: 0.15rem; }

  /* ── Chain diagram ── */
  .scd-chain { display: flex; flex-direction: column; gap: 0; }
  .scd-cert-wrap { display: flex; flex-direction: column; align-items: stretch; }
  .scd-cert-card {
    border: 1px solid var(--border,#2a2a3a);
    border-radius: 8px;
    overflow: hidden;
  }
  .scd-cert-card--leaf         { border-left: 3px solid #4ade80; }
  .scd-cert-card--intermediate { border-left: 3px solid #818cf8; }
  .scd-cert-card--root         { border-left: 3px solid #f97316; }
  .scd-cert-card--unknown      { border-left: 3px solid #6b7280; }
  .scd-cert-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.875rem;
    background: var(--surface-1,#1a1a2e);
    cursor: pointer;
    user-select: none;
  }
  .scd-cert-header:hover { background: var(--surface-2,#1e1e30); }
  .scd-cert-role {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }
  .scd-role--leaf         { background: rgba(74,222,128,0.12); color: #4ade80; border: 1px solid rgba(74,222,128,0.3); }
  .scd-role--intermediate { background: rgba(129,140,248,0.12); color: #818cf8; border: 1px solid rgba(129,140,248,0.3); }
  .scd-role--root         { background: rgba(249,115,22,0.12);  color: #fb923c; border: 1px solid rgba(249,115,22,0.3); }
  .scd-role--unknown      { background: rgba(107,114,128,0.12); color: #9ca3af; border: 1px solid rgba(107,114,128,0.3); }
  .scd-cert-cn {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-1,#e2e8f0);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .scd-cert-expiry {
    font-size: 0.75rem;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .scd-expiry--ok      { color: #4ade80; }
  .scd-expiry--soon    { color: #fbbf24; }
  .scd-expiry--expired { color: #f87171; }
  .scd-cert-chevron {
    color: var(--text-3,#888);
    font-size: 0.75rem;
    flex-shrink: 0;
    transition: transform 0.2s;
  }
  .scd-cert-chevron--open { transform: rotate(90deg); }
  .scd-cert-body {
    padding: 0.875rem;
    background: var(--surface-0,#0f0f1a);
    border-top: 1px solid var(--border,#2a2a3a);
    display: none;
  }
  .scd-cert-body--open { display: block; }
  .scd-cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.5rem 1.5rem;
    font-size: 0.8125rem;
  }
  .scd-field-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3,#888);
    margin-bottom: 0.2rem;
  }
  .scd-field-value {
    color: var(--text-1,#e2e8f0);
    word-break: break-all;
    font-family: var(--font-mono,monospace);
    font-size: 0.8rem;
  }
  .scd-field-value--warn { color: #fbbf24; }
  .scd-field-value--err  { color: #f87171; }
  .scd-sans-list {
    display: flex;
