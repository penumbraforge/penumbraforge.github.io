<script>
(function () {
  var inputEl   = document.getElementById('ehf-input');
  var analyzeBtn = document.getElementById('ehf-analyze-btn');
  var exampleBtn = document.getElementById('ehf-example-btn');
  var clearBtn  = document.getElementById('ehf-clear-btn');
  var resultsEl = document.getElementById('ehf-results');
  var emptyEl   = document.getElementById('ehf-empty');
  var assessEl  = document.getElementById('ehf-assessment');
  var authEl    = document.getElementById('ehf-auth');
  var timelineEl= document.getElementById('ehf-timeline');
  var iocsEl    = document.getElementById('ehf-iocs');
  var rawEl     = document.getElementById('ehf-raw');

  /* ── Example phishing email headers ── */
  var EXAMPLE_HEADERS = [
    'Return-Path: <bounce-9283742@promo-deals-store.xyz>',
    'Received: from mx.victim-corp.com (mx.victim-corp.com [198.51.100.25])',
