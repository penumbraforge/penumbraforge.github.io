---
toolSlug: email-header-forensics
permalink: /tools/email-header-forensics/
---

<div class="tool-group">
  <label for="ehf-input">Paste raw email headers</label>
  <p class="tool-hint">Copy from your email client: Gmail (Show Original), Outlook (View Message Source), or Thunderbird (View Source)</p>
  <textarea id="ehf-input" rows="14" placeholder="Received: from mail.sender.example (mail.sender.example [192.0.2.41])
        by mx.recipient.example with ESMTPS id abc123
        for <user@recipient.example>;
        Fri, 27 Mar 2026 10:15:30 -0700 (PDT)
Authentication-Results: mx.recipient.example;
       dkim=pass header.i=@sender.example;
       spf=pass (synthetic example)
From: Example Sender <sender@sender.example>
To: user@recipient.example
Subject: Meeting Tomorrow
..." spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
</div>

<div class="tool-row">
  <button class="btn btn--primary" id="ehf-analyze-btn">Analyze Headers</button>
  <button class="btn" id="ehf-example-btn">Try Example</button>
  <button class="btn" id="ehf-clear-btn">Clear</button>
</div>

<p class="tool-hint">The example is synthetic, using reserved .example domains and documentation IP addresses.</p>

<div id="ehf-empty" class="ehf-empty-msg">Paste email headers above and click "Analyze Headers".</div>

<div id="ehf-results" style="display:none;">

  <!-- Message overview -->
  <div id="ehf-assessment" class="ehf-section"></div>

  <!-- Authentication Results -->
  <div id="ehf-auth" class="ehf-section"></div>

  <!-- Hop Timeline -->
  <div id="ehf-timeline" class="ehf-section"></div>

  <!-- IOC Extraction -->
  <div id="ehf-iocs" class="ehf-section"></div>

  <!-- Raw Parsed View -->
  <div id="ehf-raw" class="ehf-section"></div>

</div>

<style>
  .ehf-empty-msg { text-align: center; padding: 2.5rem; color: var(--text-3,#888); font-size: 0.9rem; }

  .ehf-section {
    margin-bottom: 1.25rem;
  }
  .ehf-section-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-1,#e2e8f0);
    margin-bottom: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border,#2a2a3a);
  }

  /* Message overview */
  .ehf-verdict {
    border-radius: 8px;
    padding: 1.25rem;
    margin-bottom: 0.75rem;
    border: 1px solid var(--border,#2a2a3a);
  }
  .ehf-overview-counts { color: var(--text-2); font-size: 0.8125rem; margin-bottom: 0.75rem; }
  .ehf-overview-list { display: grid; grid-template-columns: minmax(80px, auto) 1fr; gap: 0.5rem 1rem; font-size: 0.8125rem; }
  .ehf-overview-list dt { color: var(--text-3); }
  .ehf-overview-list dd { margin: 0; overflow-wrap: anywhere; }
  .ehf-auth-record { border-top: 1px solid var(--border); padding: 1rem 0; }
  .ehf-auth-record h3 { font-size: 0.875rem; margin: 0 0 0.5rem; }
  .ehf-auth-source { font-size: 0.8125rem; overflow-wrap: anywhere; margin-bottom: 0.75rem; }
  .ehf-auth-raw { margin-top: 0.75rem; font-size: 0.8125rem; }
  .ehf-auth-raw pre { white-space: pre-wrap; overflow-wrap: anywhere; margin-top: 0.5rem; }
  .ehf-auth-caveat { color: var(--text-2); font-size: 0.8125rem; line-height: 1.6; margin-bottom: 1rem; }

  /* Auth cards */
  .ehf-auth-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
  }
  .ehf-auth-card {
    border: 1px solid var(--border,#2a2a3a);
    border-radius: 8px;
    padding: 0.875rem 1rem;
    background: var(--surface-1,#1a1a2e);
  }
  .ehf-auth-proto {
    font-size: 0.75rem;
