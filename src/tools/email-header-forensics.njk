    font-size: 1rem;
    font-weight: 800;
    margin-bottom: 0.35rem;
  }
  .ehf-auth-pass { color: #4ade80; }
  .ehf-auth-fail { color: #f87171; }
  .ehf-auth-softfail { color: #fbbf24; }
  .ehf-auth-none { color: var(--text-3,#888); }
  .ehf-auth-neutral { color: var(--text-3,#888); }
  .ehf-auth-detail {
