---
toolSlug: pii-secrets-redactor
permalink: /tools/pii-secrets-redactor/
---

<div class="tool-group">
  <label for="psr-input">Paste logs, configs, error reports, JSON, or any text to redact</label>
  <textarea id="psr-input" rows="12" placeholder="Paste log output, config files, JSON payloads, error reports, Slack messages..." spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
</div>

<div class="tool-row" style="flex-wrap:wrap;gap:0.5rem;">
  <button class="btn btn--primary" id="psr-redact-btn">Redact</button>
  <button class="btn" id="psr-example-btn">Try example</button>
  <button class="btn" id="psr-clear-btn">Clear</button>
  <div class="psr-toggles" style="margin-left:auto;display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
    <label class="psr-toggle psr-toggle--pii"><input type="checkbox" id="psr-t-pii" checked><span>PII</span></label>
    <label class="psr-toggle psr-toggle--secrets"><input type="checkbox" id="psr-t-secrets" checked><span>Secrets</span></label>
    <label class="psr-toggle psr-toggle--ips"><input type="checkbox" id="psr-t-ips" checked><span>IPs</span></label>
    <label class="psr-toggle psr-toggle--custom"><input type="checkbox" id="psr-t-custom"><span>Custom</span></label>
  </div>
</div>

<div id="psr-custom-row" style="display:none;margin-top:0.5rem;">
  <div class="tool-group" style="margin-bottom:0;">
    <label for="psr-custom-input">Custom patterns (one regex per line)</label>
    <textarea id="psr-custom-input" rows="3" placeholder="e.g. ACME-\d{6}&#10;project-[a-z]+-\d+" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
  </div>
</div>

<div id="psr-summary" style="display:none;"></div>

<div id="psr-output" style="display:none;">
  <div class="psr-output-toolbar">
    <div class="psr-view-toggle">
      <button class="btn psr-view-btn psr-view-btn--active" id="psr-view-side">Side by side</button>
      <button class="btn psr-view-btn" id="psr-view-stack">Stacked</button>
    </div>
    <button class="btn btn--primary" id="psr-copy-btn">Copy Redacted</button>
  </div>
  <div class="psr-panels psr-panels--side" id="psr-panels">
    <div class="psr-panel">
      <div class="psr-panel-label">Original</div>
      <pre class="psr-panel-pre" id="psr-original"></pre>
    </div>
    <div class="psr-panel">
      <div class="psr-panel-label">Redacted</div>
      <pre class="psr-panel-pre" id="psr-redacted"></pre>
    </div>
  </div>
</div>

<div id="psr-map" style="display:none;">
  <button class="btn psr-map-toggle" id="psr-map-btn">Redaction map <span class="psr-map-arrow">&#9654;</span></button>
  <div id="psr-map-body" style="display:none;">
    <table class="psr-map-table">
      <thead><tr><th>Original</th><th>Replacement</th><th>Type</th></tr></thead>
      <tbody id="psr-map-tbody"></tbody>
    </table>
  </div>
</div>

<div id="psr-empty" class="psr-empty-msg">Paste content above and click "Redact".</div>

<style>
  /* Toggles */
  .psr-toggle {
    display:inline-flex;align-items:center;gap:0.35rem;
    font-size:0.8125rem;font-weight:600;
    padding:4px 10px;border-radius:6px;cursor:pointer;
    border:1px solid var(--border,#2a2a3a);
    background:var(--surface-1,#1a1a2e);
    color:var(--text-2,#94a3b8);
    transition:background 0.15s,border-color 0.15s,color 0.15s;
    user-select:none;
  }
  .psr-toggle input{display:none;}
  .psr-toggle:has(input:checked){background:rgba(99,102,241,0.15);border-color:rgba(99,102,241,0.4);color:#a5b4fc;}
  .psr-toggle--pii:has(input:checked){background:rgba(244,114,182,0.12);border-color:rgba(244,114,182,0.4);color:#f472b6;}
  .psr-toggle--secrets:has(input:checked){background:rgba(239,68,68,0.12);border-color:rgba(239,68,68,0.4);color:#f87171;}
  .psr-toggle--ips:has(input:checked){background:rgba(56,189,248,0.12);border-color:rgba(56,189,248,0.4);color:#38bdf8;}
  .psr-toggle--custom:has(input:checked){background:rgba(168,85,247,0.12);border-color:rgba(168,85,247,0.4);color:#c084fc;}

  /* Summary */
  #psr-summary {
    padding:0.75rem 1rem;border-radius:8px;font-size:0.875rem;font-weight:600;
    margin-top:0.75rem;
    background:rgba(99,102,241,0.08);border:1px solid rgba(99,102,241,0.2);color:#a5b4fc;
    line-height:1.5;
  }
  #psr-summary .psr-summary-count{color:#818cf8;font-weight:700;}

  /* Output toolbar */
  .psr-output-toolbar {
    display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;flex-wrap:wrap;
  }
  .psr-view-toggle{display:flex;gap:0;}
  .psr-view-btn{border-radius:0;border:1px solid var(--border,#2a2a3a);font-size:0.75rem;padding:5px 12px;}
  .psr-view-btn:first-child{border-radius:6px 0 0 6px;}
  .psr-view-btn:last-child{border-radius:0 6px 6px 0;border-left:none;}
  .psr-view-btn--active{background:rgba(99,102,241,0.15);border-color:rgba(99,102,241,0.4);color:#a5b4fc;}

  /* Panels */
  .psr-panels--side{display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;}
  .psr-panels--stack{display:flex;flex-direction:column;gap:0.75rem;}
  @media(max-width:700px){.psr-panels--side{grid-template-columns:1fr;}}
  .psr-panel{border:1px solid var(--border,#2a2a3a);border-radius:8px;overflow:hidden;}
  .psr-panel-label{
    font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;
    padding:0.5rem 0.75rem;background:var(--surface-1,#1a1a2e);color:var(--text-3,#888);
    border-bottom:1px solid var(--border,#2a2a3a);
  }
  .psr-panel-pre {
    font-size:0.8125rem;font-family:var(--font-mono,monospace);
    padding:0.75rem;margin:0;white-space:pre-wrap;word-break:break-all;
    color:var(--text-1,#e2e8f0);min-height:6rem;max-height:28rem;overflow:auto;
    line-height:1.6;background:var(--surface-0,#0f0f1a);
  }

  /* Highlight spans in original */
  .psr-hl-pii{background:rgba(244,114,182,0.2);border-bottom:2px solid #f472b6;border-radius:2px;padding:0 1px;}
  .psr-hl-secret{background:rgba(239,68,68,0.2);border-bottom:2px solid #ef4444;border-radius:2px;padding:0 1px;}
  .psr-hl-ip{background:rgba(56,189,248,0.2);border-bottom:2px solid #38bdf8;border-radius:2px;padding:0 1px;}
  .psr-hl-custom{background:rgba(168,85,247,0.2);border-bottom:2px solid #a855f7;border-radius:2px;padding:0 1px;}

  /* Replacement tags in redacted */
  .psr-tag-pii{color:#f472b6;font-weight:700;}
  .psr-tag-secret{color:#f87171;font-weight:700;}
  .psr-tag-ip{color:#38bdf8;font-weight:700;}
  .psr-tag-custom{color:#c084fc;font-weight:700;}

  /* Map */
  .psr-map-toggle {
    margin-top:0.75rem;font-size:0.8125rem;display:flex;align-items:center;gap:0.5rem;
    cursor:pointer;background:none;border:1px solid var(--border,#2a2a3a);border-radius:6px;
    padding:0.5rem 0.75rem;color:var(--text-2,#94a3b8);font-weight:600;
  }
  .psr-map-arrow{font-size:0.625rem;transition:transform 0.2s;}
  .psr-map-toggle.psr-map-open .psr-map-arrow{transform:rotate(90deg);}
  .psr-map-table {
    width:100%;border-collapse:collapse;margin-top:0.5rem;font-size:0.8125rem;
    font-family:var(--font-mono,monospace);
  }
  .psr-map-table th {
    text-align:left;padding:0.5rem 0.75rem;
    background:var(--surface-1,#1a1a2e);color:var(--text-3,#888);
    font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;
    border-bottom:1px solid var(--border,#2a2a3a);
  }
  .psr-map-table td {
    padding:0.4rem 0.75rem;border-bottom:1px solid var(--border,#2a2a3a);
    color:var(--text-1,#e2e8f0);word-break:break-all;
  }
  .psr-map-table tr:last-child td{border-bottom:none;}
  .psr-map-table td:first-child{max-width:320px;overflow:hidden;text-overflow:ellipsis;}
  #psr-map-body{border:1px solid var(--border,#2a2a3a);border-radius:8px;overflow:hidden;max-height:20rem;overflow-y:auto;}

  /* Empty msg */
  .psr-empty-msg{text-align:center;padding:2.5rem;color:var(--text-3,#888);font-size:0.9rem;}
</style>

<script>
(function () {
  'use strict';

  /* ── DOM refs ── */
  var inputEl     = document.getElementById('psr-input');
  var redactBtn   = document.getElementById('psr-redact-btn');
  var exampleBtn  = document.getElementById('psr-example-btn');
  var clearBtn    = document.getElementById('psr-clear-btn');
  var copyBtn     = document.getElementById('psr-copy-btn');
  var summaryEl   = document.getElementById('psr-summary');
  var outputEl    = document.getElementById('psr-output');
  var originalEl  = document.getElementById('psr-original');
  var redactedEl  = document.getElementById('psr-redacted');
  var panelsEl    = document.getElementById('psr-panels');
  var emptyEl     = document.getElementById('psr-empty');
  var mapEl       = document.getElementById('psr-map');
  var mapBtn      = document.getElementById('psr-map-btn');
  var mapBody     = document.getElementById('psr-map-body');
  var mapTbody    = document.getElementById('psr-map-tbody');
  var viewSideBtn = document.getElementById('psr-view-side');
  var viewStackBtn= document.getElementById('psr-view-stack');
  var tPii        = document.getElementById('psr-t-pii');
  var tSecrets    = document.getElementById('psr-t-secrets');
  var tIps        = document.getElementById('psr-t-ips');
  var tCustom     = document.getElementById('psr-t-custom');
  var customRow   = document.getElementById('psr-custom-row');
  var customInput = document.getElementById('psr-custom-input');

  /* ── Show/hide custom patterns row ── */
  tCustom.addEventListener('change', function () {
    customRow.style.display = tCustom.checked ? '' : 'none';
  });

  /* ── Detection patterns ── */
  /* Category: 'pii' | 'secret' | 'ip' */
  var PATTERNS = [
    /* ── PII ── */
    { id:'email', cat:'pii', label:'Email', re:/\b[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}\b/g, prefix:'EMAIL' },
    { id:'ssn', cat:'pii', label:'SSN', re:/\b\d{3}-\d{2}-\d{4}\b/g, prefix:'SSN' },
    { id:'ssn-nospace', cat:'pii', label:'SSN', re:/\b\d{9}\b/g, prefix:'SSN', validator: function(m){ return /^(?!000|666|9)\d{3}(?!00)\d{2}(?!0000)\d{4}$/.test(m); } },
    { id:'phone-us', cat:'pii', label:'Phone', re:/(?:\+?1[\s.-]?)?\(?\d{3}\)?[\s.-]\d{3}[\s.-]\d{4}\b/g, prefix:'PHONE' },
    { id:'phone-intl', cat:'pii', label:'Phone', re:/\+[1-9]\d{6,14}\b/g, prefix:'PHONE' },
    { id:'credit-card', cat:'pii', label:'Credit Card', re:/\b(?:4\d{3}|5[1-5]\d{2}|3[47]\d{2}|6(?:011|5\d{2}))[- ]?\d{4}[- ]?\d{4}[- ]?\d{1,4}\b/g, prefix:'CC', validator: luhnCheck },
    { id:'name-label', cat:'pii', label:'Name', re:/(?:(?:name|user|author|owner|contact|requester|assignee|customer)\s*[:=]\s*)["']?([A-Z][a-z]+(?:\s+[A-Z][a-z]+){1,3})["']?/gi, prefix:'NAME', group:1 },
    { id:'street-address', cat:'pii', label:'Address', re:/\b\d{1,6}\s+[A-Z][a-z]+(?:\s+[A-Z]?[a-z]+){0,3}\s+(?:St|Street|Ave|Avenue|Blvd|Boulevard|Rd|Road|Dr|Drive|Ln|Lane|Ct|Court|Pl|Place|Way|Cir|Circle)\.?\b/gi, prefix:'ADDR' },
    { id:'dob', cat:'pii', label:'Date of Birth', re:/(?:(?:dob|date.?of.?birth|birth.?date|birthday)\s*[:=]\s*)["']?(\d{1,2}[\/\-]\d{1,2}[\/\-]\d{2,4}|\d{4}[\/\-]\d{1,2}[\/\-]\d{1,2})["']?/gi, prefix:'DOB', group:1 },
    { id:'passport', cat:'pii', label:'Passport', re:/(?:passport\s*(?:#|no|number|num)?\s*[:=]\s*)["']?([A-Z0-9]{6,12})["']?/gi, prefix:'PASSPORT', group:1 },
    { id:'dl-number', cat:'pii', label:'Driver License', re:/(?:(?:driver'?s?\s*)?license\s*(?:#|no|number|num)?\s*[:=]\s*)["']?([A-Z0-9\-]{5,15})["']?/gi, prefix:'DL', group:1 },
    { id:'iban', cat:'pii', label:'IBAN', re:/\b[A-Z]{2}\d{2}[A-Z0-9]{4}\d{7}(?:[A-Z0-9]?){0,16}\b/g, prefix:'IBAN' },
    { id:'mrn', cat:'pii', label:'Medical Record', re:/(?:(?:mrn|medical.?record|patient.?id)\s*[:=]\s*)["']?([A-Z0-9\-]{4,20})["']?/gi, prefix:'MRN', group:1 },

    /* ── Secrets ── */
    { id:'aws-access', cat:'secret', label:'AWS Key', re:/\bAKIA[0-9A-Z]{16}\b/g, prefix:'AWS-KEY' },
    { id:'aws-secret', cat:'secret', label:'AWS Secret', re:/(?:aws[_\-\s]?secret[_\-\s]?(?:access[_\-\s]?)?key|AWS_SECRET_ACCESS_KEY)\s*[=:]\s*["']?([A-Za-z0-9\/+=]{40})["']?/gi, prefix:'AWS-SECRET', group:1 },
    { id:'github-token', cat:'secret', label:'GitHub Token', re:/\b(ghp_[A-Za-z0-9]{36}|gho_[A-Za-z0-9]{36}|ghs_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{82})\b/g, prefix:'GH-TOKEN' },
    { id:'gitlab-token', cat:'secret', label:'GitLab Token', re:/\b(glpat-[A-Za-z0-9\-_]{20,})\b/g, prefix:'GL-TOKEN' },
    { id:'slack-token', cat:'secret', label:'Slack Token', re:/\b(xoxb-[0-9A-Za-z\-]+|xoxp-[0-9A-Za-z\-]+|xoxa-[0-9A-Za-z\-]+|xoxs-[0-9A-Za-z\-]+)\b/g, prefix:'SLACK-TOKEN' },
    { id:'google-api', cat:'secret', label:'Google API Key', re:/\bAIza[0-9A-Za-z\-_]{35}\b/g, prefix:'GOOG-KEY' },
    { id:'stripe-key', cat:'secret', label:'Stripe Key', re:/\b(sk_live_[0-9A-Za-z]{24,}|pk_live_[0-9A-Za-z]{24,}|rk_live_[0-9A-Za-z]{24,})\b/g, prefix:'STRIPE-KEY' },
    { id:'stripe-test', cat:'secret', label:'Stripe Test Key', re:/\b(sk_test_[0-9A-Za-z]{24,}|pk_test_[0-9A-Za-z]{24,})\b/g, prefix:'STRIPE-TEST' },
    { id:'sendgrid', cat:'secret', label:'SendGrid Key', re:/\bSG\.[A-Za-z0-9\-_]{22,}\.[A-Za-z0-9\-_]{43,}\b/g, prefix:'SG-KEY' },
    { id:'openai', cat:'secret', label:'OpenAI Key', re:/\b(sk-proj-[A-Za-z0-9\-_]{40,}|sk-[A-Za-z0-9]{20,})\b/g, prefix:'OPENAI-KEY' },
    { id:'anthropic', cat:'secret', label:'Anthropic Key', re:/\bsk-ant-[A-Za-z0-9\-_]{40,}\b/g, prefix:'ANTH-KEY' },
    { id:'private-key', cat:'secret', label:'Private Key', re:/-----BEGIN\s+(?:RSA |EC |OPENSSH |DSA |ENCRYPTED )?PRIVATE KEY-----[\s\S]*?-----END\s+(?:RSA |EC |OPENSSH |DSA |ENCRYPTED )?PRIVATE KEY-----/g, prefix:'PRIV-KEY' },
    { id:'private-key-begin', cat:'secret', label:'Private Key Header', re:/-----BEGIN\s+(?:RSA |EC |OPENSSH |DSA |ENCRYPTED )?PRIVATE KEY-----/g, prefix:'PRIV-KEY-HDR' },
    { id:'jwt', cat:'secret', label:'JWT', re:/\beyJ[A-Za-z0-9\-_]{10,}\.[A-Za-z0-9\-_]{10,}\.[A-Za-z0-9\-_]{10,}\b/g, prefix:'JWT' },
    { id:'bearer', cat:'secret', label:'Bearer Token', re:/(?:Bearer\s+)([A-Za-z0-9\-_.~+\/]{20,})/gi, prefix:'BEARER', group:1 },
    { id:'basic-auth', cat:'secret', label:'Basic Auth', re:/(?:Basic\s+)([A-Za-z0-9+\/=]{10,})/gi, prefix:'BASIC-AUTH', group:1 },
    { id:'db-conn', cat:'secret', label:'DB Connection', re:/(?:postgres|postgresql|mysql|mongodb|mongodb\+srv|redis|amqp|amqps):\/\/[^\s"'<>]+/gi, prefix:'DB-CONN' },
    { id:'http-auth-url', cat:'secret', label:'Auth URL', re:/https?:\/\/[^:@\s"']{1,100}:[^@\s"']{1,100}@[a-zA-Z0-9\-\.]+[^\s"']*/g, prefix:'AUTH-URL' },
    { id:'twilio-sid', cat:'secret', label:'Twilio SID', re:/\bAC[a-f0-9]{32}\b/g, prefix:'TWILIO-SID' },
    { id:'npm-token', cat:'secret', label:'npm Token', re:/\bnpm_[A-Za-z0-9]{36}\b/g, prefix:'NPM-TOKEN' },
    { id:'pypi-token', cat:'secret', label:'PyPI Token', re:/\bpypi-[A-Za-z0-9\-_]{100,}\b/g, prefix:'PYPI-TOKEN' },
    { id:'discord-token', cat:'secret', label:'Discord Token', re:/\b[MN][A-Za-z0-9]{23,}\.[A-Za-z0-9\-_]{6}\.[A-Za-z0-9\-_]{27,}\b/g, prefix:'DISC-TOKEN' },
    { id:'discord-webhook', cat:'secret', label:'Discord Webhook', re:/https:\/\/discord(?:app)?\.com\/api\/webhooks\/[0-9]+\/[A-Za-z0-9\-_]+/g, prefix:'DISC-HOOK' },
    { id:'mailgun', cat:'secret', label:'Mailgun Key', re:/\bkey-[0-9a-z]{32}\b/g, prefix:'MAILGUN-KEY' },
    { id:'digitalocean', cat:'secret', label:'DO Token', re:/\bdop_v1_[a-f0-9]{64}\b/g, prefix:'DO-TOKEN' },
    { id:'vercel', cat:'secret', label:'Vercel Token', re:/\bvercel_[A-Za-z0-9]{24,}\b/gi, prefix:'VERCEL-TOKEN' },
    { id:'linear', cat:'secret', label:'Linear Key', re:/\blin_api_[A-Za-z0-9]{40,}\b/g, prefix:'LINEAR-KEY' },
    { id:'azure-conn', cat:'secret', label:'Azure Connection', re:/DefaultEndpointsProtocol=https?;AccountName=[^;]+;AccountKey=[A-Za-z0-9+\/=]{60,}[^\s"']*/g, prefix:'AZURE-CONN' },
    { id:'datadog', cat:'secret', label:'Datadog Key', re:/dd(?:og)?[_\-]?api[_\-]?key.*?[=:]\s*["']?[a-f0-9]{32,40}\b/gi, prefix:'DD-KEY' },
    { id:'heroku', cat:'secret', label:'Heroku Key', re:/[hH]eroku.*?[=:]\s*["']?[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b/g, prefix:'HEROKU-KEY' },
    { id:'cloudflare', cat:'secret', label:'CF Token', re:/(?:cloudflare|cf)[_\-\s]?(?:api[_\-\s]?)?token.*?[=:]\s*["']?[A-Za-z0-9_\-]{40}\b/gi, prefix:'CF-TOKEN' },
    { id:'shopify', cat:'secret', label:'Shopify Token', re:/\bshpat_[a-fA-F0-9]{32}\b/g, prefix:'SHOP-TOKEN' },
    { id:'shopify-secret', cat:'secret', label:'Shopify Secret', re:/\bshpss_[a-fA-F0-9]{32}\b/g, prefix:'SHOP-SECRET' },
    { id:'square-token', cat:'secret', label:'Square Token', re:/\bsq0atp-[A-Za-z0-9\-_]{22}\b/g, prefix:'SQ-TOKEN' },
    { id:'square-secret', cat:'secret', label:'Square Secret', re:/\bsq0csp-[A-Za-z0-9\-_]{43}\b/g, prefix:'SQ-SECRET' },
    { id:'telegram', cat:'secret', label:'Telegram Token', re:/\b\d{8,10}:[A-Za-z0-9_-]{35}\b/g, prefix:'TELE-TOKEN' },
    { id:'hashicorp-vault', cat:'secret', label:'Vault Token', re:/\b(hvs\.[A-Za-z0-9]{24,}|s\.[A-Za-z0-9]{24,})\b/g, prefix:'VAULT-TOKEN' },
    { id:'gcp-service-account', cat:'secret', label:'GCP Service Account', re:/\b[a-z0-9\-]+@[a-z0-9\-]+\.iam\.gserviceaccount\.com\b/g, prefix:'GCP-SA' },
    { id:'firebase', cat:'secret', label:'Firebase Key', re:/\bAAAA[A-Za-z0-9_\-]{7}:[A-Za-z0-9_\-]{140}\b/g, prefix:'FIREBASE-KEY' },
    { id:'supabase-url', cat:'secret', label:'Supabase URL', re:/https:\/\/[a-z]{20}\.supabase\.co\b/g, prefix:'SUPA-URL' },
    { id:'netlify', cat:'secret', label:'Netlify Token', re:/\bnfl_[A-Za-z0-9\-_]{36,}\b/g, prefix:'NETLIFY-TOKEN' },
    { id:'mapbox', cat:'secret', label:'Mapbox Token', re:/\bsk\.[A-Za-z0-9]{10,}\.[A-Za-z0-9\-_]{20,}\b/g, prefix:'MAPBOX-TOKEN' },
    { id:'password-assign', cat:'secret', label:'Password', re:/(?:password|passwd|pwd)\s*[=:]\s*["']([^"'\s]{4,})["']/gi, prefix:'PASSWORD', group:1 },
    { id:'generic-secret', cat:'secret', label:'Generic Secret', re:/(?:api[_\-]?key|api[_\-]?secret|app[_\-]?secret|client[_\-]?secret|auth[_\-]?token|access[_\-]?token|secret[_\-]?key)\s*[=:]\s*["']?([A-Za-z0-9\/+=_\-]{16,})["']?/gi, prefix:'SECRET', group:1 },
    { id:'env-secret', cat:'secret', label:'Env Secret', re:/\b[A-Z_]*(SECRET|TOKEN|KEY|PASSWORD|PASS|PWD|AUTH|CREDENTIAL)[A-Z_]*\s*[=:]\s*["']?([^\s"']{8,})/g, prefix:'ENV-SECRET', group:2 },

    /* ── IPs ── */
    { id:'ipv4', cat:'ip', label:'IPv4', re:/\b(?:(?:25[0-5]|2[0-4]\d|[01]?\d?\d)\.){3}(?:25[0-5]|2[0-4]\d|[01]?\d?\d)\b/g, prefix:'IP', validator: function(m){ return !/^(?:0\.0\.0\.0|127\.0\.0\.1|255\.255\.255\.255|10\.\d+\.\d+\.\d+|172\.(?:1[6-9]|2\d|3[01])\.\d+\.\d+|192\.168\.\d+\.\d+)$/.test(m) || true; /* redact all including private */ } },
    { id:'ipv6', cat:'ip', label:'IPv6', re:/\b(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\b|\b(?:[0-9a-fA-F]{1,4}:){1,7}:\b|\b(?:[0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}\b|\b::(?:[fF]{4}:)?(?:(?:25[0-5]|2[0-4]\d|[01]?\d?\d)\.){3}(?:25[0-5]|2[0-4]\d|[01]?\d?\d)\b|\b(?:[0-9a-fA-F]{1,4}:){1,5}(?::[0-9a-fA-F]{1,4}){1,2}\b/g, prefix:'IPV6' }
  ];

  /* ── Luhn check for credit cards ── */
  function luhnCheck(num) {
    var digits = num.replace(/[\s-]/g, '');
    if (digits.length < 13 || digits.length > 19) return false;
    var sum = 0;
    var alt = false;
    for (var i = digits.length - 1; i >= 0; i--) {
      var n = parseInt(digits[i], 10);
      if (alt) { n *= 2; if (n > 9) n -= 9; }
      sum += n;
      alt = !alt;
    }
    return sum % 10 === 0;
  }

  /* ── Consistent pseudonymization ── */
  function createMapper() {
    var maps = {};    // keyed by prefix, e.g. maps['EMAIL'] = { 'real@example.com': 1, ... }
    var counters = {}; // keyed by prefix

    return {
      map: function (value, prefix) {
        if (!maps[prefix]) { maps[prefix] = {}; counters[prefix] = 0; }
        if (maps[prefix][value] === undefined) {
          counters[prefix]++;
          maps[prefix][value] = counters[prefix];
        }
        return '[' + prefix + '-' + maps[prefix][value] + ']';
      },
      getAll: function () {
        var result = [];
        Object.keys(maps).forEach(function (prefix) {
          Object.keys(maps[prefix]).forEach(function (val) {
            result.push({ original: val, replacement: '[' + prefix + '-' + maps[prefix][val] + ']', type: prefix });
          });
        });
        return result;
      }
    };
  }

  /* ── Build the example at runtime ── */
  function buildExample() {
    var pad20 = 'aBcDeFgHiJkLmNoPqRsT';
    var hex32 = 'abcdef1234567890abcdef1234567890';
    return [
      '# Server error log — 2026-03-27 incident',
      '',
      '2026-03-27T14:32:01Z [ERROR] Authentication failed for user: jane.doe' + '@acme-corp.com',
      '  from IP: 203.0.113.42, forwarded-for: 198.51.100.7',
      '  user-agent: Mozilla/5.0 (X11; Linux x86_64)',
      '  SSN on file: 123-45-6789',
      '  phone: (555) 867-5309',
      '  credit card ending: 4532-0158-3679-2841',
      '  name: John Smith',
      '  address: 1234 Elm Street, Springfield',
      '',
      '2026-03-27T14:32:02Z [ERROR] DB connection string exposed:',
      '  DATABASE_URL=postgres://admin:s3cr3t' + 'P@ss@db.acme-corp.com:5432/production',
      '',
      '2026-03-27T14:32:03Z [WARN] Credentials found in config:',
      '  AWS_ACCESS_' + 'KEY_ID=AKIA' + 'IOSFODNN7EXAMPLE',
      '  GITHUB_TOKEN=' + 'ghp_' + pad20 + pad20.slice(0, 16),
      '  SLACK_BOT_TOKEN=' + 'xoxb-111111111111-222222222-' + pad20,
      '  STRIPE_KEY=' + 'sk_l' + 'ive_51HaBcDeFgHiJkLmNoPqRsTuVwXyZ1234',
      '  password="hunter2' + 'secret"',
      '',
      '2026-03-27T14:32:04Z [INFO] Request from admin@' + 'internal.acme-corp.com (203.0.113.42)',
      '  Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.dozjgNryP4J3jVmNHl0w5N_XgL0n3I9PlFUP0THsR8U',
      '  Authorization: Basic dXNlcjpwYXNzd29yZDEyMzQ1',
      '',
      '# Same IP and email appear again — redaction should be consistent:',
      '2026-03-27T14:32:10Z [ERROR] Rate limit exceeded for jane.doe' + '@acme-corp.com from 203.0.113.42'
    ].join('\n');
  }
  var EXAMPLE_TEXT = buildExample();

  /* ── Core redaction engine ── */
  function redact() {
    var text = inputEl.value;
    if (!text.trim()) {
      outputEl.style.display = 'none';
      summaryEl.style.display = 'none';
      mapEl.style.display = 'none';
      emptyEl.style.display = '';
      return;
    }

    var enabledCats = {};
    if (tPii.checked)     enabledCats.pii = true;
    if (tSecrets.checked) enabledCats.secret = true;
    if (tIps.checked)     enabledCats.ip = true;

    /* Collect all matches with positions */
    var matches = []; // { start, end, value, cat, prefix, label }

    PATTERNS.forEach(function (p) {
      if (!enabledCats[p.cat]) return;
      var re = new RegExp(p.re.source, p.re.flags);
      var m;
      while ((m = re.exec(text)) !== null) {
        var value = p.group ? (m[p.group] || m[0]) : m[0];
        var start = p.group ? (m.index + m[0].indexOf(value)) : m.index;
        if (start < m.index) start = m.index; // safety
        var end = start + value.length;

        /* Run validator if present */
        if (p.validator && !p.validator(value)) continue;

        matches.push({ start: start, end: end, value: value, cat: p.cat, prefix: p.prefix, label: p.label });

        if (m.index === re.lastIndex) re.lastIndex++;
      }
    });

    /* Custom patterns */
    if (tCustom.checked && customInput.value.trim()) {
      var lines = customInput.value.trim().split('\n');
      lines.forEach(function (line, idx) {
        line = line.trim();
        if (!line) return;
        try {
          var cre = new RegExp(line, 'gi');
          var cm;
          while ((cm = cre.exec(text)) !== null) {
            matches.push({ start: cm.index, end: cm.index + cm[0].length, value: cm[0], cat: 'custom', prefix: 'CUSTOM-' + (idx + 1), label: 'Custom #' + (idx + 1) });
            if (cm.index === cre.lastIndex) cre.lastIndex++;
          }
        } catch (e) { /* skip bad regex */ }
      });
    }

    /* Sort by start position, longest first for overlaps */
    matches.sort(function (a, b) { return a.start - b.start || b.end - a.end; });

    /* Remove overlapping matches (keep first/longest) */
    var filtered = [];
    var lastEnd = -1;
    matches.forEach(function (m) {
      if (m.start >= lastEnd) {
        filtered.push(m);
        lastEnd = m.end;
      }
    });
    matches = filtered;

    if (matches.length === 0) {
      emptyEl.style.display = 'none';
      outputEl.style.display = 'none';
      mapEl.style.display = 'none';
      summaryEl.style.display = '';
      summaryEl.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px;margin-right:6px;"><polyline points="20 6 9 17 4 12"/></svg>No sensitive data detected. Always review manually.';
      summaryEl.style.background = 'rgba(34,197,94,0.07)';
      summaryEl.style.borderColor = 'rgba(34,197,94,0.2)';
      summaryEl.style.color = '#4ade80';
      return;
    }

    /* Build pseudonymization mapper */
    var mapper = createMapper();

    /* Build original (highlighted) and redacted text */
    var origParts = [];
    var redactParts = [];
    var redactPlain = []; // plain text for copy
    var pos = 0;

    matches.forEach(function (m) {
      /* Text before this match */
      if (m.start > pos) {
        var before = escHtml(text.substring(pos, m.start));
        origParts.push(before);
        redactParts.push(before);
        redactPlain.push(text.substring(pos, m.start));
      }

      var hlClass = 'psr-hl-' + (m.cat === 'secret' ? 'secret' : m.cat === 'ip' ? 'ip' : m.cat === 'custom' ? 'custom' : 'pii');
      var tagClass = 'psr-tag-' + (m.cat === 'secret' ? 'secret' : m.cat === 'ip' ? 'ip' : m.cat === 'custom' ? 'custom' : 'pii');

      origParts.push('<span class="' + hlClass + '">' + escHtml(m.value) + '</span>');

      var replacement = mapper.map(m.value, m.prefix);
      redactParts.push('<span class="' + tagClass + '">' + escHtml(replacement) + '</span>');
      redactPlain.push(replacement);

      pos = m.end;
    });

    /* Remaining text */
    if (pos < text.length) {
      var tail = escHtml(text.substring(pos));
      origParts.push(tail);
      redactParts.push(tail);
      redactPlain.push(text.substring(pos));
    }

    /* Render */
    emptyEl.style.display = 'none';
    outputEl.style.display = '';
    originalEl.innerHTML = origParts.join('');
    redactedEl.innerHTML = redactParts.join('');

    /* Store plain redacted for copy */
    redactedEl.dataset.plain = redactPlain.join('');

    /* Summary */
    var counts = {};
    matches.forEach(function (m) {
      counts[m.label] = (counts[m.label] || 0) + 1;
    });
    var summaryParts = [];
    Object.keys(counts).forEach(function (k) {
      summaryParts.push(counts[k] + ' ' + k + (counts[k] > 1 ? 's' : ''));
    });
    summaryEl.style.display = '';
    summaryEl.style.background = 'rgba(99,102,241,0.08)';
    summaryEl.style.borderColor = 'rgba(99,102,241,0.2)';
    summaryEl.style.color = '#a5b4fc';
    summaryEl.innerHTML = 'Redacted <span class="psr-summary-count">' + matches.length + '</span> item' + (matches.length !== 1 ? 's' : '') + ': ' + summaryParts.join(', ');

    /* Redaction map */
    var allMaps = mapper.getAll();
    if (allMaps.length > 0) {
      mapEl.style.display = '';
      while (mapTbody.firstChild) mapTbody.removeChild(mapTbody.firstChild);
      allMaps.forEach(function (entry) {
        var tr = document.createElement('tr');
        var td1 = document.createElement('td');
        td1.textContent = truncate(entry.original, 80);
        td1.title = entry.original;
        var td2 = document.createElement('td');
        td2.textContent = entry.replacement;
        var td3 = document.createElement('td');
        td3.textContent = entry.type;
        td3.style.color = 'var(--text-3,#888)';
        td3.style.fontSize = '0.75rem';
        tr.appendChild(td1);
        tr.appendChild(td2);
        tr.appendChild(td3);
        mapTbody.appendChild(tr);
      });
    } else {
      mapEl.style.display = 'none';
    }
  }

  /* ── Utilities ── */
  function escHtml(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function truncate(s, n) {
    return s.length > n ? s.substring(0, n) + '\u2026' : s;
  }

  /* ── Event listeners ── */
  redactBtn.addEventListener('click', redact);

  exampleBtn.addEventListener('click', function () {
    inputEl.value = EXAMPLE_TEXT;
    redact();
  });

  clearBtn.addEventListener('click', function () {
    inputEl.value = '';
    outputEl.style.display = 'none';
    summaryEl.style.display = 'none';
    mapEl.style.display = 'none';
    emptyEl.style.display = '';
    mapBody.style.display = 'none';
    mapBtn.classList.remove('psr-map-open');
  });

  copyBtn.addEventListener('click', function () {
    var plain = redactedEl.dataset.plain || '';
    if (!plain) return;
    navigator.clipboard.writeText(plain).then(function () {
      var orig = copyBtn.textContent;
      copyBtn.textContent = 'Copied!';
      setTimeout(function () { copyBtn.textContent = orig; }, 1500);
    });
  });

  /* View toggle */
  viewSideBtn.addEventListener('click', function () {
    panelsEl.className = 'psr-panels psr-panels--side';
    viewSideBtn.classList.add('psr-view-btn--active');
    viewStackBtn.classList.remove('psr-view-btn--active');
  });
  viewStackBtn.addEventListener('click', function () {
    panelsEl.className = 'psr-panels psr-panels--stack';
    viewStackBtn.classList.add('psr-view-btn--active');
    viewSideBtn.classList.remove('psr-view-btn--active');
  });

  /* Redaction map toggle */
  mapBtn.addEventListener('click', function () {
    var open = mapBody.style.display !== 'none';
    mapBody.style.display = open ? 'none' : '';
    mapBtn.classList.toggle('psr-map-open', !open);
  });
})();
</script>