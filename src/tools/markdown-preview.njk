---
toolSlug: markdown-preview
permalink: /tools/markdown-preview/
---

<style>
  .md-split { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
  @media (max-width:680px) { .md-split { grid-template-columns:1fr; } }
  .md-editor-pane { display:flex; flex-direction:column; }
  .md-preview-pane { border:1px solid var(--color-border,#334155); border-radius:6px; overflow:auto; padding:1.25rem 1.5rem; background:var(--color-surface,#0f172a); min-height:24rem; max-height:60vh; }
  #md-input { flex:1; resize:vertical; min-height:24rem; max-height:60vh; }
  /* GitHub-like markdown styles */
  .md-preview-pane h1 { font-size:2em; font-weight:700; margin:0.5em 0 0.3em; border-bottom:1px solid var(--color-border,#334155); padding-bottom:0.2em; }
  .md-preview-pane h2 { font-size:1.5em; font-weight:600; margin:0.8em 0 0.3em; border-bottom:1px solid var(--color-border,#334155); padding-bottom:0.2em; }
  .md-preview-pane h3 { font-size:1.25em; font-weight:600; margin:0.8em 0 0.2em; }
  .md-preview-pane h4, .md-preview-pane h5, .md-preview-pane h6 { font-size:1em; font-weight:600; margin:0.6em 0 0.2em; }
  .md-preview-pane p { margin:0.5em 0 0.8em; line-height:1.65; }
  .md-preview-pane ul, .md-preview-pane ol { padding-left:1.5em; margin:0.5em 0; }
  .md-preview-pane li { margin:0.2em 0; line-height:1.6; }
  .md-preview-pane blockquote { border-left:4px solid var(--color-accent,#6366f1); padding:0.2em 1em; margin:0.8em 0; color:var(--color-muted,#94a3b8); }
  .md-preview-pane code { background:rgba(99,102,241,0.1); padding:0.1em 0.35em; border-radius:3px; font-family:var(--font-mono,monospace); font-size:0.88em; }
  .md-preview-pane pre { background:var(--color-surface-2,#1e293b); border-radius:6px; padding:1em; overflow-x:auto; margin:0.8em 0; }
  .md-preview-pane pre code { background:none; padding:0; font-size:0.85em; }
  .md-preview-pane table { border-collapse:collapse; margin:0.8em 0; width:100%; }
  .md-preview-pane th, .md-preview-pane td { border:1px solid var(--color-border,#334155); padding:0.4em 0.7em; }
  .md-preview-pane th { background:var(--color-surface-2,#1e293b); font-weight:600; }
  .md-preview-pane hr { border:none; border-top:1px solid var(--color-border,#334155); margin:1.2em 0; }
  .md-preview-pane a { color:var(--color-accent,#6366f1); }
  .md-preview-pane img { max-width:100%; border-radius:4px; }
  .md-preview-pane del { color:var(--color-muted,#94a3b8); text-decoration:line-through; }
  .md-preview-pane input[type=checkbox] { margin-right:0.4em; }
  .md-toolbar { display:flex; gap:0.4rem; flex-wrap:wrap; margin-bottom:0.5rem; }
  .md-toolbar button { font-size:0.8rem; padding:0.2rem 0.5rem; background:var(--color-surface-2,#1e293b); border:1px solid var(--color-border,#334155); border-radius:4px; cursor:pointer; color:var(--color-text,#e2e8f0); }
  .md-toolbar button:hover { background:var(--color-surface-3,#334155); }
</style>

<div class="tool-row" style="margin-bottom:0.75rem; gap:0.5rem; align-items:center; flex-wrap:wrap;">
  <div class="tool-options" role="group" aria-label="View mode">
    <button class="tool-option active" data-view="split" aria-pressed="true">Split</button>
    <button class="tool-option" data-view="edit" aria-pressed="false">Editor only</button>
    <button class="tool-option" data-view="preview" aria-pressed="false">Preview only</button>
  </div>
  <button class="btn btn--copy" id="md-copy" style="margin-left:auto;">Copy MD</button>
  <button class="btn" id="md-copy-html">Copy HTML</button>
</div>

<div class="md-toolbar">
  <button data-cmd="bold" title="Bold"><b>B</b></button>
  <button data-cmd="italic" title="Italic"><i>I</i></button>
  <button data-cmd="strikethrough" title="Strikethrough"><s>S</s></button>
  <button data-cmd="h1" title="Heading 1">H1</button>
  <button data-cmd="h2" title="Heading 2">H2</button>
  <button data-cmd="h3" title="Heading 3">H3</button>
  <button data-cmd="code" title="Inline code">&lt;/&gt;</button>
  <button data-cmd="codeblock" title="Code block">&#9633; block</button>
  <button data-cmd="link" title="Link">Link</button>
  <button data-cmd="ul" title="Bullet list">• List</button>
  <button data-cmd="ol" title="Numbered list">1. List</button>
  <button data-cmd="quote" title="Blockquote">" Quote</button>
  <button data-cmd="table" title="Table">Table</button>
  <button data-cmd="hr" title="Horizontal rule">—</button>
</div>

<div class="md-split" id="md-split">
  <div class="md-editor-pane" id="md-editor-pane">
    <label for="md-input" style="font-size:0.8rem; color:var(--color-muted,#888); margin-bottom:0.3rem;">Markdown</label>
    <textarea id="md-input" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"
      placeholder="# Hello World&#10;&#10;Type your **markdown** here and see it rendered live.&#10;&#10;- Supports GFM tables, task lists, strikethrough&#10;- Code blocks with syntax highlighting placeholders&#10;&#10;> Blockquotes too!"></textarea>
  </div>
  <div class="md-preview-pane" id="md-preview" aria-label="Rendered markdown preview" aria-live="polite"></div>
</div>

<script>
(function () {
  var inputEl   = document.getElementById('md-input');
  var previewEl = document.getElementById('md-preview');
  var copyMdBtn = document.getElementById('md-copy');
  var copyHtmlBtn = document.getElementById('md-copy-html');
  var splitEl   = document.getElementById('md-split');
  var editorPane = document.getElementById('md-editor-pane');
  var viewBtns  = Array.prototype.slice.call(document.querySelectorAll('.tool-option[data-view]'));

  /* ---- Markdown → HTML renderer ---- */
  function mdToHtml(md) {
    var lines = md.split('\n');
    var out = [];
    var i = 0;

    while (i < lines.length) {
      var line = lines[i];

      // Fenced code block
      if (/^```/.test(line)) {
        var lang = line.slice(3).trim();
        var codeLines = [];
        i++;
        while (i < lines.length && !/^```/.test(lines[i])) {
          codeLines.push(lines[i]);
          i++;
        }
        i++;
        out.push('<pre><code class="language-' + esc(lang) + '">' + esc(codeLines.join('\n')) + '</code></pre>');
        continue;
      }

      // Setext headings (=== and ---)
      if (i + 1 < lines.length && /^={3,}\s*$/.test(lines[i + 1])) {
        out.push('<h1>' + inline(line) + '</h1>');
        i += 2; continue;
      }
      if (i + 1 < lines.length && /^-{3,}\s*$/.test(lines[i + 1]) && line.trim() !== '') {
        out.push('<h2>' + inline(line) + '</h2>');
        i += 2; continue;
      }

      // ATX headings
      var hm = line.match(/^(#{1,6})\s+(.*?)(?:\s+#+\s*)?$/);
      if (hm) {
        var level = hm[1].length;
        out.push('<h' + level + '>' + inline(hm[2]) + '</h' + level + '>');
        i++; continue;
      }

      // HR
      if (/^(\*{3,}|-{3,}|_{3,})\s*$/.test(line)) {
        out.push('<hr>'); i++; continue;
      }

      // Blockquote
      if (/^>\s?/.test(line)) {
        var bqLines = [];
        while (i < lines.length && /^>\s?/.test(lines[i])) {
          bqLines.push(lines[i].replace(/^>\s?/, ''));
          i++;
        }
        out.push('<blockquote>' + mdToHtml(bqLines.join('\n')) + '</blockquote>');
        continue;
      }

      // Table
      if (/\|/.test(line) && i + 1 < lines.length && /^[\s|:\-]+$/.test(lines[i + 1])) {
        var tRows = [];
        var headers = line.split('|').filter(function (c) { return c.trim() !== ''; });
        var alignRow = lines[i + 1].split('|').filter(function (c) { return c.trim() !== ''; });
        var aligns = alignRow.map(function (c) {
          if (/^:\-+:$/.test(c.trim())) return 'center';
          if (/^\-+:$/.test(c.trim())) return 'right';
          return 'left';
        });
        i += 2;
        var thead = '<thead><tr>' + headers.map(function (h, idx) {
          return '<th style="text-align:' + (aligns[idx] || 'left') + '">' + inline(h.trim()) + '</th>';
        }).join('') + '</tr></thead>';
        var tbodyRows = [];
        while (i < lines.length && /\|/.test(lines[i]) && lines[i].trim() !== '') {
          var cells = lines[i].split('|').filter(function (c) { return c.trim() !== ''; });
          tbodyRows.push('<tr>' + cells.map(function (c, idx) {
            return '<td style="text-align:' + (aligns[idx] || 'left') + '">' + inline(c.trim()) + '</td>';
          }).join('') + '</tr>');
          i++;
        }
        out.push('<table>' + thead + '<tbody>' + tbodyRows.join('') + '</tbody></table>');
        continue;
      }

      // Task list / unordered list
      if (/^(\s*)([-*+])\s+/.test(line)) {
        var ulLines = [];
        var baseIndent = line.match(/^(\s*)/)[1].length;
        while (i < lines.length && (/^(\s*)([-*+])\s+/.test(lines[i]) || /^(\s{2,}|\t)/.test(lines[i]))) {
          ulLines.push(lines[i]);
          i++;
        }
        out.push(buildList(ulLines, 'ul'));
        continue;
      }

      // Ordered list
      if (/^\s*\d+\.\s+/.test(line)) {
        var olLines = [];
        while (i < lines.length && (/^\s*\d+\.\s+/.test(lines[i]) || /^(\s{2,}|\t)/.test(lines[i]))) {
          olLines.push(lines[i]);
          i++;
        }
        out.push(buildList(olLines, 'ol'));
        continue;
      }

      // Blank line
      if (line.trim() === '') { out.push(''); i++; continue; }

      // Paragraph
      var paraLines = [];
      while (i < lines.length && lines[i].trim() !== '' &&
             !/^#{1,6}\s/.test(lines[i]) && !/^>\s?/.test(lines[i]) &&
             !/^(\*{3,}|-{3,}|_{3,})\s*$/.test(lines[i]) &&
             !/^```/.test(lines[i]) && !/^\s*([-*+])\s+/.test(lines[i]) &&
             !/^\s*\d+\.\s+/.test(lines[i]) && !/\|/.test(lines[i])) {
        paraLines.push(lines[i]);
        i++;
      }
      if (paraLines.length) {
        out.push('<p>' + inline(paraLines.join('\n').replace(/  \n/g, '<br>').replace(/\n/g, ' ')) + '</p>');
      }
    }

    return out.join('\n');
  }

  function buildList(lines, tag) {
    var html = '<' + tag + '>';
    var i = 0;
    while (i < lines.length) {
      var line = lines[i];
      var m = line.match(/^(\s*)([-*+]|\d+\.)\s+(.*)/);
      if (!m) { i++; continue; }
      var content = m[3];
      // Task list
      var taskM = content.match(/^\[([ xX])\]\s+(.*)/);
      if (taskM) {
        var checked = taskM[1].toLowerCase() === 'x' ? ' checked' : '';
        html += '<li><input type="checkbox" disabled' + checked + '> ' + inline(taskM[2]) + '</li>';
      } else {
        html += '<li>' + inline(content) + '</li>';
      }
      i++;
    }
    html += '</' + tag + '>';
    return html;
  }

  function inline(text) {
    // Code spans (process first to avoid nesting issues)
    text = text.replace(/`([^`]+)`/g, function (_, code) { return '<code>' + esc(code) + '</code>'; });
    // Images
    text = text.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, function (_, alt, src) {
      return '<img src="' + esc(src) + '" alt="' + esc(alt) + '">';
    });
    // Links
    text = text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, function (_, txt, href) {
      return '<a href="' + esc(href) + '" target="_blank" rel="noopener">' + txt + '</a>';
    });
    // Autolinks
    text = text.replace(/&lt;(https?:\/\/[^&]+)&gt;/g, function (_, url) {
      return '<a href="' + url + '" target="_blank" rel="noopener">' + url + '</a>';
    });
    // Bold+italic
    text = text.replace(/\*{3}([^*]+)\*{3}/g, '<strong><em>$1</em></strong>');
    text = text.replace(/_{3}([^_]+)_{3}/g, '<strong><em>$1</em></strong>');
    // Bold
    text = text.replace(/\*{2}([^*]+)\*{2}/g, '<strong>$1</strong>');
    text = text.replace(/_{2}([^_]+)_{2}/g, '<strong>$1</strong>');
    // Italic
    text = text.replace(/\*([^*\n]+)\*/g, '<em>$1</em>');
    text = text.replace(/_([^_\n]+)_/g, '<em>$1</em>');
    // Strikethrough
    text = text.replace(/~~([^~]+)~~/g, '<del>$1</del>');
    return text;
  }

  function esc(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  var renderTimer;
  function render() {
    clearTimeout(renderTimer);
    renderTimer = setTimeout(function () {
      var html = mdToHtml(inputEl.value);
      // Use DOM to set innerHTML of preview (this is our own generated HTML from parsed MD, not user raw input)
      previewEl.innerHTML = html;
    }, 50);
  }

  inputEl.addEventListener('input', render);

  // Toolbar commands
  document.querySelector('.md-toolbar').addEventListener('click', function (e) {
    var btn = e.target.closest('[data-cmd]');
    if (!btn) return;
    var cmd = btn.getAttribute('data-cmd');
    var start = inputEl.selectionStart;
    var end   = inputEl.selectionEnd;
    var sel   = inputEl.value.slice(start, end);
    var before = inputEl.value.slice(0, start);
    var after  = inputEl.value.slice(end);
    var insert = '';
    var cursorOffset = 0;

    var cmds = {
      bold:          { wrap: ['**', '**'], placeholder: 'bold text' },
      italic:        { wrap: ['*', '*'], placeholder: 'italic text' },
      strikethrough: { wrap: ['~~', '~~'], placeholder: 'strikethrough' },
      code:          { wrap: ['`', '`'], placeholder: 'code' },
    };

    if (cmds[cmd]) {
      var c = cmds[cmd];
      var content = sel || c.placeholder;
      insert = c.wrap[0] + content + c.wrap[1];
      cursorOffset = c.wrap[0].length;
    } else if (cmd === 'h1') { insert = '# ' + (sel || 'Heading 1'); cursorOffset = 2; }
    else if (cmd === 'h2') { insert = '## ' + (sel || 'Heading 2'); cursorOffset = 3; }
    else if (cmd === 'h3') { insert = '### ' + (sel || 'Heading 3'); cursorOffset = 4; }
    else if (cmd === 'codeblock') {
      insert = '```\n' + (sel || 'code here') + '\n```';
      cursorOffset = 4;
    } else if (cmd === 'link') {
      insert = '[' + (sel || 'link text') + '](https://example.com)';
      cursorOffset = 1;
    } else if (cmd === 'ul') {
      insert = '- ' + (sel || 'item');
    } else if (cmd === 'ol') {
      insert = '1. ' + (sel || 'item');
    } else if (cmd === 'quote') {
      insert = '> ' + (sel || 'blockquote');
    } else if (cmd === 'table') {
      insert = '| Header 1 | Header 2 | Header 3 |\n| --- | --- | --- |\n| Cell 1 | Cell 2 | Cell 3 |';
    } else if (cmd === 'hr') {
      insert = '\n---\n';
    }

    inputEl.value = before + insert + after;
    inputEl.focus();
    if (cmd === 'link') {
      // Select the link text portion: either the original selection or the placeholder "link text"
      var linkTextStart = start + 1; // after opening '['
      var linkText = sel || 'link text';
      inputEl.setSelectionRange(linkTextStart, linkTextStart + linkText.length);
    } else if (sel) {
      inputEl.setSelectionRange(start, start + insert.length);
    } else {
      inputEl.setSelectionRange(start + cursorOffset, start + cursorOffset + (cmds[cmd] ? insert.length - cmds[cmd].wrap[0].length - cmds[cmd].wrap[1].length : insert.length - cursorOffset));
    }
    render();
  });

  // View mode toggle
  viewBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var view = btn.getAttribute('data-view');
      viewBtns.forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active'); btn.setAttribute('aria-pressed', 'true');
      if (view === 'split') {
        splitEl.style.gridTemplateColumns = '1fr 1fr';
        editorPane.style.display = '';
        previewEl.style.display = '';
      } else if (view === 'edit') {
        splitEl.style.gridTemplateColumns = '1fr';
        editorPane.style.display = '';
        previewEl.style.display = 'none';
      } else {
        splitEl.style.gridTemplateColumns = '1fr';
        editorPane.style.display = 'none';
        previewEl.style.display = '';
      }
    });
  });

  copyMdBtn.addEventListener('click', function () {
    var text = inputEl.value;
    if (!text) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () {
        copyMdBtn.textContent = 'Copied!';
        setTimeout(function () { copyMdBtn.textContent = 'Copy MD'; }, 2000);
      });
    }
  });

  copyHtmlBtn.addEventListener('click', function () {
    var html = mdToHtml(inputEl.value);
    if (!html) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(html).then(function () {
        copyHtmlBtn.textContent = 'Copied!';
        setTimeout(function () { copyHtmlBtn.textContent = 'Copy HTML'; }, 2000);
      });
    }
  });

  // Initial sample
  inputEl.value = '# Welcome to Markdown Preview\n\nType your **markdown** here and see it rendered _live_.\n\n## Features\n\n- ~~Strikethrough~~\n- **Bold** and *italic*\n- `inline code`\n- [Links](https://example.com)\n- Task lists and tables\n\n## Code Block\n\n```javascript\nconst greet = (name) => `Hello, ${name}!`;\nconsole.log(greet("World"));\n```\n\n## Table\n\n| Name | Value | Status |\n| --- | :---: | ---: |\n| Alpha | 42 | Active |\n| Beta | 7 | Pending |\n\n> Blockquotes work too!\n\n### Task List\n\n- [x] Parse headings\n- [x] Render tables\n- [ ] More features';
  render();
})();
</script>
