---
toolSlug: ai-cost-calculator
permalink: /tools/ai-cost-calculator/
---

<div class="acc-mode-row">
  <button class="acc-mode-btn acc-mode-btn--active" data-mode="tokens" id="acc-mode-tokens">By Tokens</button>
  <button class="acc-mode-btn" data-mode="text" id="acc-mode-text">By Text</button>
  <button class="acc-mode-btn" data-mode="monthly" id="acc-mode-monthly">Monthly Estimate</button>
</div>

<!-- By Tokens mode -->
<div id="acc-panel-tokens" class="acc-panel">
  <div class="acc-inputs-row">
    <div class="acc-input-group">
      <label for="acc-input-tokens">Input tokens</label>
      <input type="number" id="acc-input-tokens" class="acc-num-input" value="1000" min="0" step="100" placeholder="1000">
    </div>
    <div class="acc-input-group">
      <label for="acc-output-tokens">Output tokens</label>
      <input type="number" id="acc-output-tokens" class="acc-num-input" value="500" min="0" step="100" placeholder="500">
    </div>
    <div class="acc-input-group">
      <label for="acc-requests">Requests</label>
      <input type="number" id="acc-requests" class="acc-num-input" value="1" min="1" step="1" placeholder="1">
    </div>
  </div>
</div>

<!-- By Text mode -->
<div id="acc-panel-text" class="acc-panel" style="display:none;">
  <div class="tool-group">
    <label for="acc-text-input">Paste a sample prompt to estimate token count</label>
    <textarea id="acc-text-input" rows="6" placeholder="Paste your prompt or a representative sample here..." spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
  </div>
  <div class="acc-inputs-row">
    <div class="acc-input-group">
      <label for="acc-text-output-ratio">Output / input ratio</label>
      <select id="acc-text-output-ratio" class="acc-select">
        <option value="0.5">0.5x (shorter responses)</option>
        <option value="1" selected>1x (similar length)</option>
        <option value="2">2x (longer responses)</option>
        <option value="4">4x (much longer)</option>
      </select>
    </div>
    <div class="acc-input-group">
      <label for="acc-text-requests">Requests</label>
      <input type="number" id="acc-text-requests" class="acc-num-input" value="1" min="1" step="1">
    </div>
    <div class="acc-token-estimate" id="acc-token-estimate" style="display:none;">
      <span class="acc-token-label">Estimated tokens</span>
      <span id="acc-token-count">—</span> input &nbsp;/&nbsp; <span id="acc-token-out-count">—</span> output
    </div>
  </div>
</div>

<!-- Monthly Estimate mode -->
<div id="acc-panel-monthly" class="acc-panel" style="display:none;">
  <div class="acc-inputs-row">
    <div class="acc-input-group">
      <label for="acc-monthly-rpd">Requests / day</label>
      <input type="number" id="acc-monthly-rpd" class="acc-num-input" value="1000" min="1" step="100">
    </div>
    <div class="acc-input-group">
      <label for="acc-monthly-input">Avg input tokens</label>
      <input type="number" id="acc-monthly-input" class="acc-num-input" value="500" min="0" step="100">
    </div>
    <div class="acc-input-group">
      <label for="acc-monthly-output">Avg output tokens</label>
      <input type="number" id="acc-monthly-output" class="acc-num-input" value="200" min="0" step="100">
    </div>
  </div>
  <p class="acc-hint">Calculates cost for 30 days at the given daily volume.</p>
</div>

<!-- Model selector -->
<div class="acc-models-section">
  <div class="acc-models-header">
    <span class="acc-models-label">Models to compare</span>
    <div class="acc-models-actions">
      <button class="acc-link-btn" id="acc-select-all">Select all</button>
      <button class="acc-link-btn" id="acc-select-none">Clear</button>
    </div>
  </div>
  <div class="acc-models-grid" id="acc-models-grid"></div>
</div>

<div class="tool-row" style="margin-bottom:0;">
  <button class="btn btn--primary" id="acc-calc-btn">Calculate costs</button>
  <button class="btn" id="acc-reset-btn">Reset</button>
  <div id="acc-calc-summary" style="margin-left:auto;font-size:0.875rem;color:var(--text-3,#888);align-self:center;"></div>
</div>

<!-- Results -->
<div id="acc-results" style="display:none;">

  <div class="acc-results-header">
    <h3 style="margin:0;font-size:1rem;color:var(--text-1,#e2e8f0);">Cost Comparison</h3>
    <span class="acc-results-sub" id="acc-results-sub"></span>
  </div>

  <!-- Table -->
  <div class="acc-table-wrap">
    <table class="acc-table" id="acc-table">
      <thead>
        <tr>
          <th>Model</th>
          <th>Provider</th>
          <th class="acc-col-num">Input cost</th>
          <th class="acc-col-num">Output cost</th>
          <th class="acc-col-num">Total</th>
          <th class="acc-col-num">vs. most expensive</th>
        </tr>
      </thead>
      <tbody id="acc-tbody"></tbody>
    </table>
  </div>

  <!-- Bar chart -->
  <div class="acc-chart-section">
    <div class="acc-chart-label">Relative cost (scaled to most expensive)</div>
    <div id="acc-chart-bars"></div>
  </div>

  <!-- Optimization tips -->
  <div class="acc-tips-section" id="acc-tips-section">
    <div class="acc-tips-title">Optimization suggestions</div>
    <div id="acc-tips-list"></div>
  </div>

  <!-- Monthly projection -->
  <div class="acc-projection-section" id="acc-projection-section" style="display:none;">
    <div class="acc-tips-title">Monthly projection</div>
    <div id="acc-projection-list"></div>
  </div>

</div>

<div id="acc-empty" class="acc-empty-msg">Select models and click "Calculate costs" to see the comparison.</div>

<hr style="margin:2rem 0;border:none;border-top:1px solid var(--border,#2a2a3a);">
<p class="acc-pricing-note">Prices as of March 2026 per million tokens. Verify current pricing on provider sites before making budget decisions. Open-source models (Llama) show a $0 self-hosted cost; actual API provider rates will vary.</p>

