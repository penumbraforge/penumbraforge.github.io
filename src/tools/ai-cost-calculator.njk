    { id: 'mistral-large',         name: 'mistral-large',         provider: 'Mistral',   providerKey: 'mistral',   inputPer1M: 2,     outputPer1M: 6,     defaultOn: false, capability: 2, opensource: false },
    { id: 'codestral',             name: 'codestral',             provider: 'Mistral',   providerKey: 'mistral',   inputPer1M: 0.30,  outputPer1M: 0.90,  defaultOn: false, capability: 1, opensource: false },
    { id: 'llama-4-maverick',      name: 'llama-4-maverick',      provider: 'Meta',      providerKey: 'meta',      inputPer1M: 0,     outputPer1M: 0,     defaultOn: false, capability: 2, opensource: true }
  ];

  var currentMode = 'tokens';
  var els = {
    panelTokens:     document.getElementById('acc-panel-tokens'),
    panelText:       document.getElementById('acc-panel-text'),
    panelMonthly:    document.getElementById('acc-panel-monthly'),
    inputTokens:     document.getElementById('acc-input-tokens'),
    outputTokens:    document.getElementById('acc-output-tokens'),
    requests:        document.getElementById('acc-requests'),
    textInput:       document.getElementById('acc-text-input'),
    textRatio:       document.getElementById('acc-text-output-ratio'),
    textRequests:    document.getElementById('acc-text-requests'),
    tokenEstimate:   document.getElementById('acc-token-estimate'),
    tokenCount:      document.getElementById('acc-token-count'),
    tokenOutCount:   document.getElementById('acc-token-out-count'),
    monthlyRpd:      document.getElementById('acc-monthly-rpd'),
    monthlyInput:    document.getElementById('acc-monthly-input'),
    monthlyOutput:   document.getElementById('acc-monthly-output'),
    modelsGrid:      document.getElementById('acc-models-grid'),
    calcBtn:         document.getElementById('acc-calc-btn'),
    resetBtn:        document.getElementById('acc-reset-btn'),
    calcSummary:     document.getElementById('acc-calc-summary'),
    results:         document.getElementById('acc-results'),
    resultsSub:      document.getElementById('acc-results-sub'),
    tbody:           document.getElementById('acc-tbody'),
    chartBars:       document.getElementById('acc-chart-bars'),
    tipsSection:     document.getElementById('acc-tips-section'),
    tipsList:        document.getElementById('acc-tips-list'),
    projSection:     document.getElementById('acc-projection-section'),
    projList:        document.getElementById('acc-projection-list'),
    emptyMsg:        document.getElementById('acc-empty'),
    selectAll:       document.getElementById('acc-select-all'),
    selectNone:      document.getElementById('acc-select-none')
  };

  // ── Build model checkboxes ──────────────────────────────────────────────────
  MODELS.forEach(function (m) {
    var item = document.createElement('label');
    item.className = 'acc-model-item' + (m.defaultOn ? ' acc-model-item--checked' : '');
    item.setAttribute('for', 'acc-cb-' + m.id);

    var cb = document.createElement('input');
    cb.type = 'checkbox';
    cb.id = 'acc-cb-' + m.id;
    cb.checked = m.defaultOn;
    cb.setAttribute('data-model-id', m.id);

    var info = document.createElement('div');
    info.className = 'acc-model-info';

    var nameRow = document.createElement('div');
    nameRow.style.display = 'flex';
    nameRow.style.alignItems = 'center';

    var nameSpan = document.createElement('span');
    nameSpan.className = 'acc-model-name';
    nameSpan.textContent = m.name;

    var badge = document.createElement('span');
    badge.className = 'acc-model-badge acc-model-badge--' + m.providerKey;
    badge.textContent = m.provider;

    nameRow.appendChild(nameSpan);
    nameRow.appendChild(badge);

    var meta = document.createElement('div');
    meta.className = 'acc-model-meta';
    if (m.opensource) {
      meta.textContent = '$0 self-hosted (open source)';
    } else {
      meta.textContent = '$' + fmt(m.inputPer1M) + ' / $' + fmt(m.outputPer1M) + ' per 1M tokens';
    }

    info.appendChild(nameRow);
    info.appendChild(meta);
    item.appendChild(cb);
    item.appendChild(info);
    els.modelsGrid.appendChild(item);

    cb.addEventListener('change', function () {
      item.classList.toggle('acc-model-item--checked', cb.checked);
    });
  });

  // ── Mode switching ──────────────────────────────────────────────────────────
  document.querySelectorAll('.acc-mode-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.acc-mode-btn').forEach(function (b) {
        b.classList.remove('acc-mode-btn--active');
      });
      btn.classList.add('acc-mode-btn--active');
      currentMode = btn.getAttribute('data-mode');
      els.panelTokens.style.display  = currentMode === 'tokens'  ? '' : 'none';
      els.panelText.style.display    = currentMode === 'text'    ? '' : 'none';
      els.panelMonthly.style.display = currentMode === 'monthly' ? '' : 'none';
    });
  });

  // ── Token estimation from text ─────────────────────────────────────────────
  function estimateTokens(text) {
    // ~4 chars per token for English; count words as rough approximation
    return Math.max(1, Math.round(text.length / 4));
  }

  var textDebounce = null;
  els.textInput.addEventListener('input', function () {
    clearTimeout(textDebounce);
    textDebounce = setTimeout(function () {
      var text = els.textInput.value;
      if (!text.trim()) {
        els.tokenEstimate.style.display = 'none';
        return;
      }
      var inTok = estimateTokens(text);
      var ratio = parseFloat(els.textRatio.value) || 1;
      var outTok = Math.round(inTok * ratio);
      els.tokenCount.textContent = inTok.toLocaleString();
      els.tokenOutCount.textContent = outTok.toLocaleString();
      els.tokenEstimate.style.display = '';
    }, 200);
  });
  els.textRatio.addEventListener('change', function () {
    if (els.textInput.value.trim()) {
      els.textInput.dispatchEvent(new Event('input'));
    }
  });

  // ── Helpers ─────────────────────────────────────────────────────────────────
  function fmt(n) {
    if (n === 0) return '0';
    if (n < 0.01) return n.toFixed(4);
    if (n < 1) return n.toFixed(2);
    if (n < 100) return n.toFixed(4);
    return n.toFixed(2);
  }

  function fmtCost(n) {
    if (n === 0) return '$0.00';
    if (n < 0.0001) return '<$0.0001';
    if (n < 0.01) return '$' + n.toFixed(6);
    if (n < 1) return '$' + n.toFixed(4);
    if (n < 100) return '$' + n.toFixed(4);
    return '$' + n.toFixed(2);
  }

  function getCheckedModels() {
    var result = [];
    document.querySelectorAll('#acc-models-grid input[type="checkbox"]').forEach(function (cb) {
      if (cb.checked) {
        var id = cb.getAttribute('data-model-id');
        for (var i = 0; i < MODELS.length; i++) {
          if (MODELS[i].id === id) { result.push(MODELS[i]); break; }
        }
      }
    });
    return result;
  }

  function getUsage() {
    var inTok, outTok, requests, isMonthly = false;
    if (currentMode === 'tokens') {
      inTok    = parseFloat(els.inputTokens.value)  || 0;
      outTok   = parseFloat(els.outputTokens.value) || 0;
      requests = parseFloat(els.requests.value)     || 1;
    } else if (currentMode === 'text') {
      var text = els.textInput.value;
      inTok    = text.trim() ? estimateTokens(text) : 0;
      var ratio = parseFloat(els.textRatio.value) || 1;
      outTok   = Math.round(inTok * ratio);
      requests = parseFloat(els.textRequests.value) || 1;
    } else {
      var rpd    = parseFloat(els.monthlyRpd.value)    || 0;
      inTok      = parseFloat(els.monthlyInput.value)  || 0;
      outTok     = parseFloat(els.monthlyOutput.value) || 0;
      requests   = rpd * 30;
      isMonthly  = true;
    }
    return { inTok: inTok, outTok: outTok, requests: requests, isMonthly: isMonthly };
  }

  function calcCost(model, usage) {
    var inCost  = (model.inputPer1M  / 1e6) * usage.inTok  * usage.requests;
    var outCost = (model.outputPer1M / 1e6) * usage.outTok * usage.requests;
    return { inCost: inCost, outCost: outCost, total: inCost + outCost };
  }

  // ── Select all / none ───────────────────────────────────────────────────────
  els.selectAll.addEventListener('click', function () {
    document.querySelectorAll('#acc-models-grid input[type="checkbox"]').forEach(function (cb) {
      cb.checked = true;
      cb.closest('.acc-model-item').classList.add('acc-model-item--checked');
    });
  });
  els.selectNone.addEventListener('click', function () {
    document.querySelectorAll('#acc-models-grid input[type="checkbox"]').forEach(function (cb) {
      cb.checked = false;
      cb.closest('.acc-model-item').classList.remove('acc-model-item--checked');
    });
  });

  // ── Calculate ───────────────────────────────────────────────────────────────
  els.calcBtn.addEventListener('click', calculate);

  // Recalculate on any input change (debounced)
  var calcDebounce = null;
  function scheduleCalc() {
    clearTimeout(calcDebounce);
    calcDebounce = setTimeout(calculate, 400);
  }
  [els.inputTokens, els.outputTokens, els.requests,
   els.textInput, els.textRatio, els.textRequests,
   els.monthlyRpd, els.monthlyInput, els.monthlyOutput].forEach(function (el) {
    el.addEventListener('input', scheduleCalc);
    el.addEventListener('change', scheduleCalc);
  });
  document.querySelectorAll('#acc-models-grid input[type="checkbox"]').forEach(function (cb) {
    cb.addEventListener('change', scheduleCalc);
  });

  function calculate() {
    var models = getCheckedModels();
    if (!models.length) {
      els.calcSummary.textContent = 'Select at least one model.';
      els.results.style.display = 'none';
      els.emptyMsg.style.display = '';
      return;
    }

    var usage = getUsage();
    if (usage.inTok === 0 && usage.outTok === 0) {
      els.calcSummary.textContent = 'Enter token counts above.';
      els.results.style.display = 'none';
      els.emptyMsg.style.display = '';
      return;
    }

    var rows = models.map(function (m) {
      var costs = calcCost(m, usage);
      return { model: m, inCost: costs.inCost, outCost: costs.outCost, total: costs.total };
    });

    // Sort cheapest first; open-source ($0) sorts by capability tier then name
    rows.sort(function (a, b) {
      if (a.total !== b.total) return a.total - b.total;
      return a.model.name.localeCompare(b.model.name);
    });

    var maxTotal = rows[rows.length - 1].total;
    var minTotal = rows[0].total;

    // ── Summary text ───────────────────────────────────────────────────────────
    var totalInputTokens  = usage.inTok  * usage.requests;
    var totalOutputTokens = usage.outTok * usage.requests;
    els.calcSummary.textContent =
      totalInputTokens.toLocaleString() + ' input + ' +
      totalOutputTokens.toLocaleString() + ' output tokens' +
      (usage.requests > 1 ? ' (' + Math.round(usage.requests).toLocaleString() + ' requests)' : '');

    // ── Table ─────────────────────────────────────────────────────────────────
    while (els.tbody.firstChild) els.tbody.removeChild(els.tbody.firstChild);

    rows.forEach(function (row, i) {
      var tr = document.createElement('tr');

      // Rank cell
      var tdModel = document.createElement('td');
      tdModel.className = 'acc-td-model';
      var rankSpan = document.createElement('span');
      rankSpan.className = 'acc-rank-badge ' + (i === 0 ? 'acc-rank-1' : i === 1 ? 'acc-rank-2' : 'acc-rank-n');
      rankSpan.textContent = i + 1;
      tdModel.appendChild(rankSpan);
      tdModel.appendChild(document.createTextNode(row.model.name));
      if (row.model.opensource) {
        var freeBadge = document.createElement('span');
        freeBadge.className = 'acc-free-badge';
        freeBadge.textContent = 'open source';
        tdModel.appendChild(freeBadge);
      }

      var tdProvider = document.createElement('td');
      tdProvider.className = 'acc-td-provider';
      var provBadge = document.createElement('span');
      provBadge.className = 'acc-model-badge acc-model-badge--' + row.model.providerKey;
      provBadge.textContent = row.model.provider;
      tdProvider.appendChild(provBadge);

      var tdIn = document.createElement('td');
      tdIn.className = 'acc-td-num';
      tdIn.textContent = row.model.opensource ? '—' : fmtCost(row.inCost);

      var tdOut = document.createElement('td');
      tdOut.className = 'acc-td-num';
      tdOut.textContent = row.model.opensource ? '—' : fmtCost(row.outCost);

      var tdTotal = document.createElement('td');
      tdTotal.className = 'acc-td-num';
      tdTotal.style.fontWeight = '700';
      tdTotal.textContent = row.model.opensource ? '$0 (self-hosted)' : fmtCost(row.total);

      var tdSavings = document.createElement('td');
      tdSavings.className = 'acc-td-savings';
      if (maxTotal === 0 || row.model.opensource) {
        tdSavings.innerHTML = '<span class="acc-savings-none">—</span>';
      } else if (i === rows.length - 1) {
        tdSavings.innerHTML = '<span class="acc-savings-none">baseline</span>';
      } else {
        var pct = maxTotal > 0 ? Math.round(((maxTotal - row.total) / maxTotal) * 100) : 0;
        tdSavings.innerHTML = '<span class="acc-savings-good">-' + pct + '%</span>';
      }

      tr.appendChild(tdModel);
      tr.appendChild(tdProvider);
      tr.appendChild(tdIn);
      tr.appendChild(tdOut);
      tr.appendChild(tdTotal);
      tr.appendChild(tdSavings);
      els.tbody.appendChild(tr);
    });

    // ── Bar chart ─────────────────────────────────────────────────────────────
    while (els.chartBars.firstChild) els.chartBars.removeChild(els.chartBars.firstChild);

    var nonZeroMax = 0;
    rows.forEach(function (r) { if (r.total > nonZeroMax) nonZeroMax = r.total; });

    rows.forEach(function (row, i) {
      var div = document.createElement('div');
      div.className = 'acc-bar-row';

      var name = document.createElement('div');
      name.className = 'acc-bar-name';
      name.textContent = row.model.name;
      name.title = row.model.name;

      var track = document.createElement('div');
      track.className = 'acc-bar-track';

      var fill = document.createElement('div');
      fill.className = 'acc-bar-fill' + (i === 0 ? ' acc-bar-fill--best' : '');
      var pct = nonZeroMax > 0 ? Math.max(2, (row.total / nonZeroMax) * 100) : 2;
      if (row.model.opensource && nonZeroMax > 0) pct = 2;
      fill.style.width = pct + '%';

      var val = document.createElement('div');
      val.className = 'acc-bar-val';
      val.textContent = row.model.opensource ? '$0*' : fmtCost(row.total);

      track.appendChild(fill);
      div.appendChild(name);
      div.appendChild(track);
      div.appendChild(val);
      els.chartBars.appendChild(div);
    });

    // ── Optimization tips ─────────────────────────────────────────────────────
    while (els.tipsList.firstChild) els.tipsList.removeChild(els.tipsList.firstChild);

    var tips = [];

    // Cheapest vs most expensive
    var paidRows = rows.filter(function (r) { return !r.model.opensource && r.total > 0; });
    if (paidRows.length >= 2) {
      var cheapest  = paidRows[0];
      var priciest  = paidRows[paidRows.length - 1];
      var savingsPct = Math.round(((priciest.total - cheapest.total) / priciest.total) * 100);
      if (savingsPct > 10) {
        tips.push('Switching from <strong>' + priciest.model.name + '</strong> to <strong>' + cheapest.model.name + '</strong> saves <strong>' + savingsPct + '%</strong> on this workload.');
      }
    }

    // Flag if a premium model's output cost is dominating
    rows.forEach(function (row) {
      if (!row.model.opensource && row.outCost > row.inCost * 3 && row.total > 0.001) {
        tips.push('For <strong>' + row.model.name + '</strong>, output tokens drive ' + Math.round((row.outCost / row.total) * 100) + '% of cost. Reduce response length with tighter prompts or <code>max_tokens</code> to cut spend.');
      }
    });

    // Flash/mini alternatives for premium models
    var premiumMap = {
      'claude-opus-4-6':  'claude-haiku-4-5',
      'claude-sonnet-4-6':'claude-haiku-4-5',
      'o3':               'o4-mini',
      'gpt-4.1':          'gpt-4.1-mini',
      'gemini-2.5-pro':   'gemini-2.5-flash'
    };
    var checkedIds = rows.map(function (r) { return r.model.id; });
    rows.forEach(function (row) {
      var alt = premiumMap[row.model.id];
      if (alt && checkedIds.indexOf(alt) === -1) {
        tips.push('<strong>' + alt + '</strong> is a cheaper alternative to <strong>' + row.model.name + '</strong> worth comparing — add it to the model list above.');
      }
    });

    // Open source hint
    var hasOpenSource = rows.some(function (r) { return r.model.opensource; });
    if (!hasOpenSource) {
      tips.push('Self-hosted open-source models like <strong>Llama 4 Maverick</strong> have $0 API cost at scale, though inference infrastructure adds operational overhead. Enable it above to include in the comparison.');
    }

    if (!tips.length) {
      tips.push('Your current model selection looks well-optimized for this workload.');
    }

    tips.forEach(function (t) {
      var div = document.createElement('div');
      div.className = 'acc-tip';
      var icon = document.createElement('span');
      icon.className = 'acc-tip-icon';
      icon.textContent = '›';
      div.appendChild(icon);
      var text = document.createElement('span');
      text.innerHTML = t;
      div.appendChild(text);
      els.tipsList.appendChild(div);
    });

    // ── Monthly projection (for tokens / text modes) ───────────────────────────
    if (!usage.isMonthly && rows.length > 0) {
      while (els.projList.firstChild) els.projList.removeChild(els.projList.firstChild);

      var dailyReqs   = usage.requests;
      var monthlyReqs = dailyReqs * 30;

      var projRows = rows.slice(0, Math.min(4, rows.length));
      projRows.forEach(function (row) {
        var monthlyCost = (row.model.inputPer1M  / 1e6) * usage.inTok  * monthlyReqs
                        + (row.model.outputPer1M / 1e6) * usage.outTok * monthlyReqs;

        var div = document.createElement('div');
        div.className = 'acc-proj-row';

        var nm = document.createElement('span');
        nm.className = 'acc-proj-name';
        nm.textContent = row.model.name;

        var vl = document.createElement('span');
        vl.className = 'acc-proj-val';
        vl.textContent = row.model.opensource ? '$0 / mo (self-hosted)' : fmtCost(monthlyCost) + ' / mo';

        div.appendChild(nm);
        div.appendChild(vl);
        els.projList.appendChild(div);
      });

      var note = document.createElement('p');
      note.style.cssText = 'font-size:0.75rem;color:var(--text-3,#888);margin:0.625rem 0 0;';
      note.textContent = 'Projection assumes ' + Math.round(dailyReqs).toLocaleString() + ' requests/day × 30 days with the same token counts.';
      els.projList.appendChild(note);

      els.projSection.style.display = '';
    } else {
      els.projSection.style.display = 'none';
    }

    // ── Results sub-label ─────────────────────────────────────────────────────
    var labelParts = [];
    if (usage.inTok)  labelParts.push(usage.inTok.toLocaleString()  + ' input tokens');
    if (usage.outTok) labelParts.push(usage.outTok.toLocaleString() + ' output tokens');
    if (usage.requests !== 1) labelParts.push(Math.round(usage.requests).toLocaleString() + ' requests');
    els.resultsSub.textContent = labelParts.join(' · ');

    // ── Show/hide ─────────────────────────────────────────────────────────────
    els.results.style.display  = '';
    els.emptyMsg.style.display = 'none';
  }

  // ── Reset ──────────────────────────────────────────────────────────────────
  els.resetBtn.addEventListener('click', function () {
    els.inputTokens.value  = '1000';
    els.outputTokens.value = '500';
    els.requests.value     = '1';
    els.textInput.value    = '';
    els.textRatio.value    = '1';
    els.textRequests.value = '1';
    els.monthlyRpd.value   = '1000';
    els.monthlyInput.value = '500';
    els.monthlyOutput.value= '200';
    els.tokenEstimate.style.display = 'none';
    els.results.style.display       = 'none';
    els.emptyMsg.style.display      = '';
    els.calcSummary.textContent     = '';
    document.querySelectorAll('#acc-models-grid input[type="checkbox"]').forEach(function (cb) {
      var id = cb.getAttribute('data-model-id');
      for (var i = 0; i < MODELS.length; i++) {
        if (MODELS[i].id === id) {
          cb.checked = MODELS[i].defaultOn;
          cb.closest('.acc-model-item').classList.toggle('acc-model-item--checked', MODELS[i].defaultOn);
          break;
        }
      }
    });
  });

  // Initial calculation on load
  calculate();
})();
</script>
