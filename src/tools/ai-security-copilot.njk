---
toolSlug: ai-security-copilot
permalink: /tools/ai-security-copilot/
---
{% raw %}
<style>
  .sec-toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .sec-toolbar-r { display: flex; gap: 8px; }
  .sec-hint { font-size: 12px; line-height: 1.55; color: var(--text-3); margin: 8px 2px 18px; }
  .sec-hint kbd { font-family: var(--font-mono); font-size: 10.5px; background: color-mix(in oklab, var(--accent) 10%, transparent); border: 1px solid var(--wb-line); border-radius: 3px; padding: 1px 5px; color: var(--text-2); }
  .sec-run { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 14px; }
  .sec-detected { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.5px; color: var(--accent); border: 1px solid var(--wb-line-bright); padding: 4px 9px; border-radius: 2px; }
  .sec-section { margin-top: 22px; }
  .sec-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
  .sec-head-l { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 2px; text-transform: uppercase; color: var(--slate); }
  .sec-head-l em { font-style: normal; color: var(--text-3); letter-spacing: 0.5px; text-transform: none; font-size: 11px; }
  .sec-ai { min-height: 60px; white-space: pre-wrap; }
  #secFactsBody { white-space: normal; }
  .sec-grid { display: grid; grid-template-columns: auto 1fr; gap: 5px 16px; font-family: var(--font-mono); font-size: 12px; margin: 2px 0 6px; }
  .sec-grid dt { color: var(--slate); white-space: nowrap; }
  .sec-grid dd { color: var(--text-1); word-break: break-word; }
  .sec-sub { font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--slate); margin: 16px 0 7px; }
  .sec-list { list-style: none; display: flex; flex-direction: column; gap: 6px; margin: 4px 0; padding: 0; }
  .sec-list li { font-family: var(--font-mono); font-size: 12px; display: flex; gap: 9px; align-items: baseline; line-height: 1.5; color: var(--text-1); }
  .sec-chip { font-family: var(--font-mono); font-size: 9px; letter-spacing: 1px; text-transform: uppercase; padding: 2px 6px; border-radius: 2px; border: 1px solid; flex-shrink: 0; min-width: 52px; text-align: center; }
  .sev-critical { color: #e8736b; border-color: color-mix(in oklab, #e8736b 42%, transparent); background: color-mix(in oklab, #e8736b 9%, transparent); }
  .sev-high { color: #e8a87c; border-color: color-mix(in oklab, #e8a87c 42%, transparent); background: color-mix(in oklab, #e8a87c 8%, transparent); }
  .sev-medium { color: #d8b45c; border-color: color-mix(in oklab, #d8b45c 42%, transparent); background: color-mix(in oklab, #d8b45c 8%, transparent); }
  .sev-low { color: var(--sage); border-color: color-mix(in oklab, var(--sage) 35%, transparent); background: color-mix(in oklab, var(--sage) 7%, transparent); }
  .sev-info { color: var(--text-3); border-color: var(--wb-line); }
  .sec-ok { color: var(--sage); border-color: color-mix(in oklab, var(--sage) 35%, transparent); background: color-mix(in oklab, var(--sage) 7%, transparent); }
  .sec-miss { color: #e8a87c; border-color: color-mix(in oklab, #e8a87c 42%, transparent); background: color-mix(in oklab, #e8a87c 8%, transparent); }
  .sec-mono { white-space: pre-wrap; word-break: break-word; font-family: var(--font-mono); font-size: 11.5px; color: var(--text-1); line-height: 1.7; background: color-mix(in oklab, var(--accent) 4%, transparent); border: 1px solid var(--wb-line); border-radius: 3px; padding: 10px 12px; margin-top: 2px; }
</style>

<div class="sec-copilot">
  <label for="secInput">Artifact to analyze</label>

  <div class="sec-toolbar">
    <div class="tool-options" role="tablist" id="secTypes" aria-label="Input type">
      <button class="tool-option active" type="button" role="tab" aria-selected="true" data-type="auto">Auto</button>
      <button class="tool-option" type="button" role="tab" aria-selected="false" data-type="headers">Headers</button>
      <button class="tool-option" type="button" role="tab" aria-selected="false" data-type="jwt">JWT</button>
      <button class="tool-option" type="button" role="tab" aria-selected="false" data-type="cert">TLS cert</button>
      <button class="tool-option" type="button" role="tab" aria-selected="false" data-type="config">Config</button>
      <button class="tool-option" type="button" role="tab" aria-selected="false" data-type="csp">CSP</button>
    </div>
    <div class="sec-toolbar-r">
      <button class="btn" id="secExample" type="button">Load example</button>
      <button class="btn" id="secClear" type="button">Clear</button>
    </div>
  </div>

  <textarea id="secInput" rows="10" spellcheck="false" autocapitalize="off" autocorrect="off"
    aria-describedby="secHint"
    placeholder="Paste HTTP response headers, a JWT, a TLS certificate (PEM), a config/.env file, or a Content-Security-Policy…"></textarea>
  <p id="secHint" class="sec-hint">
    A security analyst that runs on your machine. Deterministic facts are computed locally in your browser
    first (JWT decode, header inventory, certificate parse, CSP audit, secret scan); the AI on your chosen
    engine then reasons on top. Nothing is uploaded. <kbd>&#8984;</kbd>/<kbd>Ctrl</kbd>+<kbd>Enter</kbd> to run.
  </p>

  <div class="sec-run">
    <button class="btn btn--primary" id="secRun" type="button">Analyze</button>
    <button class="btn" id="secStop" type="button" hidden>Stop</button>
    <span class="ai-status" id="secStatus" aria-live="polite"></span>
    <span class="sec-detected" id="secDetected" hidden></span>
  </div>

  <section class="sec-section" id="secFacts" hidden>
    <div class="sec-head">
      <span class="sec-head-l">Deterministic facts <em>· computed locally, no AI</em></span>
      <button class="btn btn--copy" id="secCopyFacts" type="button">Copy</button>
    </div>
    <div class="output-area" id="secFactsBody" aria-live="polite"></div>
  </section>

  <section class="sec-section" id="secAiSection" hidden>
    <div class="sec-head">
      <span class="sec-head-l">AI assessment <em>· runs on your engine</em></span>
      <button class="btn btn--copy" id="secCopyAi" type="button">Copy</button>
    </div>
    <div class="output-area sec-ai" id="secAiOut" aria-live="polite"></div>
  </section>
</div>

<script>
(function () {
  if (!window.PenumbraAIUI) return;
  var $ = function (id) { return document.getElementById(id); };
  function el(tag, cls, txt) { var e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; }
  function trunc(s, n) { s = String(s); return s.length > n ? s.slice(0, n) + '…' : s; }

  var input = $('secInput'), typesWrap = $('secTypes'), runBtn = $('secRun'), stopBtn = $('secStop'),
      statusEl = $('secStatus'), detectedEl = $('secDetected'), factsPanel = $('secFacts'),
      factsBody = $('secFactsBody'), aiSection = $('secAiSection'), aiOut = $('secAiOut'),
      exampleBtn = $('secExample'), clearBtn = $('secClear'),
      copyFactsBtn = $('secCopyFacts'), copyAiBtn = $('secCopyAi');

  var selType = 'auto';
  var lastFactsText = '';

  /* ---------- type selector ---------- */
  typesWrap.addEventListener('click', function (e) {
    var b = e.target.closest('[data-type]'); if (!b) return;
    selType = b.dataset.type;
    typesWrap.querySelectorAll('.tool-option').forEach(function (o) {
      var on = o === b; o.classList.toggle('active', on); o.setAttribute('aria-selected', String(on));
    });
  });

  /* ================= deterministic helpers ================= */
  function b64urlToStr(s) {
    s = s.replace(/-/g, '+').replace(/_/g, '/'); while (s.length % 4) s += '=';
    var bin = atob(s);
    try {
      return decodeURIComponent(Array.prototype.map.call(bin, function (c) {
        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
      }).join(''));
    } catch (e) { return bin; }
  }
  function b64urlEnc(str) {
    return btoa(unescape(encodeURIComponent(str))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }
  function nowSec() { return Math.floor(Date.now() / 1000); }
  function rel(sec) {
    var diff = sec - nowSec(), a = Math.abs(diff), u;
    if (a < 3600) u = Math.round(a / 60) + 'm';
    else if (a < 86400) u = Math.round(a / 3600) + 'h';
    else u = Math.round(a / 86400) + 'd';
    return diff < 0 ? u + ' ago' : 'in ' + u;
  }
  function fmtTs(sec) {
    var d = new Date(sec * 1000); if (isNaN(d.getTime())) return String(sec);
    return d.toISOString().replace(/\.\d{3}Z$/, 'Z') + ' (' + rel(sec) + ')';
  }

  /* ================= JWT ================= */
  function analyzeJWT(text) {
    var parts = text.trim().split('.');
    if (parts.length < 2) throw new Error('Not a JWT — expected header.payload.signature.');
    var header = JSON.parse(b64urlToStr(parts[0]));
    var payload = JSON.parse(b64urlToStr(parts[1]));
    var findings = [], now = nowSec();
    var alg = (header.alg == null ? '' : String(header.alg));
    if (/^none$/i.test(alg)) findings.push({ sev: 'critical', msg: 'alg = "none" — the token is unsigned. Anyone can forge claims. Reject "none" server-side.' });
    else if (/^HS/i.test(alg)) findings.push({ sev: 'medium', msg: 'alg = ' + alg + ' (HMAC/symmetric). If a verifier also accepts RS*/ES*, this enables algorithm-confusion key attacks. Pin the expected algorithm and never trust the header.' });
    if (!alg) findings.push({ sev: 'high', msg: 'No alg in header — verification behavior is undefined.' });
    if (payload.exp == null) findings.push({ sev: 'high', msg: 'No exp claim — the token never expires. Add a short expiry.' });
    else if (payload.exp < now) findings.push({ sev: 'medium', msg: 'Token is expired (exp ' + fmtTs(payload.exp) + ').' });
    else if (payload.exp - (payload.iat || now) > 604800) findings.push({ sev: 'low', msg: 'Long lifetime (~' + Math.round((payload.exp - (payload.iat || now)) / 3600) + 'h). Prefer short-lived access tokens with refresh.' });
    if (payload.nbf != null && payload.nbf > now) findings.push({ sev: 'info', msg: 'Not yet valid (nbf ' + fmtTs(payload.nbf) + ').' });
    if (payload.iat == null) findings.push({ sev: 'low', msg: 'No iat claim — token age cannot be evaluated.' });
    if (!payload.iss) findings.push({ sev: 'low', msg: 'No iss (issuer) claim — issuer validation is harder.' });
    if (!payload.aud) findings.push({ sev: 'low', msg: 'No aud (audience) claim — token may be replayable across services.' });
    var sensitive = Object.keys(payload).filter(function (k) { return /pass|secret|ssn|social|credit|card|cvv|pwd|private|api[_-]?key/i.test(k); });
    if (sensitive.length) findings.push({ sev: 'high', msg: 'Payload may carry sensitive fields (' + sensitive.join(', ') + '). JWT payloads are base64, NOT encrypted — anyone can read them.' });
    if (!findings.length) findings.push({ sev: 'info', msg: 'No obvious JWT issues in the deterministic pass.' });

    var kv = [['alg', alg || '(none)'], ['typ', header.typ || '—'], ['kid', header.kid || '—']];
    if (payload.iss) kv.push(['iss', String(payload.iss)]);
    if (payload.sub) kv.push(['sub', String(payload.sub)]);
    if (payload.aud) kv.push(['aud', Array.isArray(payload.aud) ? payload.aud.join(', ') : String(payload.aud)]);
    if (payload.iat != null) kv.push(['iat', fmtTs(payload.iat)]);
    if (payload.nbf != null) kv.push(['nbf', fmtTs(payload.nbf)]);
    if (payload.exp != null) kv.push(['exp', fmtTs(payload.exp)]);
    kv.push(['signature', parts[2] ? trunc(parts[2], 24) + ' (' + parts[2].length + ' chars, NOT verified here)' : '(empty — unsigned)']);

    return {
      label: 'JSON Web Token', kv: kv, findings: findings,
      blocks: [
        { title: 'Decoded header', text: JSON.stringify(header, null, 2) },
        { title: 'Decoded payload', text: JSON.stringify(payload, null, 2) }
      ]
    };
  }

  /* ================= HTTP headers ================= */
  function analyzeHeaders(text) {
    var lines = text.split(/\r?\n/), map = {}, statusLine = null;
    lines.forEach(function (l) {
      l = l.trim(); if (!l) return;
      if (/^HTTP\/[\d.]+/i.test(l)) { statusLine = l; return; }
      var i = l.indexOf(':'); if (i < 1) return;
      var name = l.slice(0, i).trim(), val = l.slice(i + 1).trim(), key = name.toLowerCase();
      if (map[key] != null) map[key] += '\n' + val; else map[key] = val;
    });
    var SEC = [
      ['strict-transport-security', 'HSTS — forces HTTPS'],
      ['content-security-policy', 'CSP — mitigates XSS/injection'],
      ['x-content-type-options', 'nosniff — blocks MIME sniffing'],
      ['x-frame-options', 'Legacy clickjacking defense'],
      ['referrer-policy', 'Controls Referer leakage'],
      ['permissions-policy', 'Restricts powerful browser features'],
      ['cross-origin-opener-policy', 'COOP — process isolation'],
      ['cross-origin-resource-policy', 'CORP — blocks cross-origin embeds'],
      ['cross-origin-embedder-policy', 'COEP — cross-origin isolation']
    ];
    var present = [], missing = [], findings = [];
    SEC.forEach(function (h) {
      if (map[h[0]] != null) present.push([h[0], map[h[0]]]); else missing.push(h[0] + ' — ' + h[1]);
    });
    if (map['strict-transport-security'] == null) findings.push({ sev: 'high', msg: 'No HSTS — connections can be downgraded to HTTP (SSL stripping). Add: Strict-Transport-Security: max-age=31536000; includeSubDomains.' });
    else {
      var hsts = map['strict-transport-security'], m = hsts.match(/max-age\s*=\s*(\d+)/i), age = m ? +m[1] : 0;
      if (age < 15552000) findings.push({ sev: 'medium', msg: 'HSTS max-age is ' + age + 's (< 180 days). Use max-age=31536000 with includeSubDomains; preload.' });
      if (!/includeSubDomains/i.test(hsts)) findings.push({ sev: 'low', msg: 'HSTS lacks includeSubDomains — subdomains stay downgradeable.' });
    }
    if (map['content-security-policy'] == null) findings.push({ sev: 'high', msg: 'No Content-Security-Policy — the primary XSS mitigation is absent.' });
    if (map['x-content-type-options'] == null || !/nosniff/i.test(map['x-content-type-options'] || '')) findings.push({ sev: 'medium', msg: 'X-Content-Type-Options: nosniff missing — browsers may MIME-sniff responses.' });
    var hasFrameAncestors = map['content-security-policy'] != null && /frame-ancestors/i.test(map['content-security-policy']);
    if (map['x-frame-options'] == null && !hasFrameAncestors) findings.push({ sev: 'medium', msg: 'No clickjacking protection — set CSP frame-ancestors or X-Frame-Options.' });
    if (map['referrer-policy'] == null) findings.push({ sev: 'low', msg: 'No Referrer-Policy — full URLs may leak via the Referer header.' });
    ['server', 'x-powered-by', 'x-aspnet-version', 'x-aspnetmvc-version', 'x-runtime'].forEach(function (k) {
      if (map[k] != null) findings.push({ sev: 'low', msg: 'Information disclosure: ' + k + ': ' + trunc(map[k], 60) + ' reveals stack/version details.' });
    });
    if (map['set-cookie'] != null) {
      map['set-cookie'].split('\n').forEach(function (c) {
        var name = ((c.split('=')[0] || 'cookie').trim());
        if (!/;\s*Secure/i.test(c)) findings.push({ sev: 'medium', msg: 'Cookie "' + name + '" missing Secure — can be sent over plain HTTP.' });
        if (!/;\s*HttpOnly/i.test(c)) findings.push({ sev: 'medium', msg: 'Cookie "' + name + '" missing HttpOnly — readable by JavaScript (XSS theft).' });
        if (!/;\s*SameSite/i.test(c)) findings.push({ sev: 'low', msg: 'Cookie "' + name + '" missing SameSite — CSRF exposure.' });
      });
    }
    if ((map['access-control-allow-origin'] || '') === '*') findings.push({ sev: 'medium', msg: 'Access-Control-Allow-Origin: * exposes the resource to every origin.' });
    if (!findings.length) findings.push({ sev: 'info', msg: 'No obvious header issues in the deterministic pass.' });
    return { label: 'HTTP response headers', kv: statusLine ? [['status', statusLine]] : [], present: present, missing: missing, findings: findings };
  }

  /* ================= CSP ================= */
  function analyzeCSP(text) {
    var raw = text.trim().replace(/^content-security-policy(-report-only)?\s*:/i, '').trim();
    var reportOnly = /content-security-policy-report-only/i.test(text);
    var dirs = {}, order = [];
    raw.split(';').forEach(function (seg) {
      seg = seg.trim(); if (!seg) return;
      var sp = seg.split(/\s+/), name = sp.shift().toLowerCase();
      dirs[name] = sp; if (order.indexOf(name) < 0) order.push(name);
    });
    function has(d) { return dirs[d] != null; }
    function srcHas(d, tok) { return (dirs[d] || []).some(function (s) { return s.toLowerCase() === tok; }); }
    var findings = [];
    if (!has('default-src') && !has('script-src')) findings.push({ sev: 'high', msg: 'No default-src or script-src — the policy barely restricts script execution.' });
    ['script-src', 'default-src', 'script-src-elem'].forEach(function (d) {
      if (srcHas(d, "'unsafe-inline'")) findings.push({ sev: 'high', msg: d + " allows 'unsafe-inline' — inline scripts run, defeating the main XSS protection. Use nonces or hashes." });
      if (srcHas(d, "'unsafe-eval'")) findings.push({ sev: 'high', msg: d + " allows 'unsafe-eval' — eval()/new Function() are permitted." });
    });
    Object.keys(dirs).forEach(function (d) {
      if (/-src$/.test(d) && (dirs[d] || []).indexOf('*') >= 0) findings.push({ sev: 'high', msg: d + ' uses a wildcard * source — any host can load resources.' });
      (dirs[d] || []).forEach(function (s) {
        if (/^http:/i.test(s)) findings.push({ sev: 'medium', msg: d + ' includes an http: source (' + s + ') — mixed content / MITM risk.' });
        if (/^data:/i.test(s) && /script/.test(d)) findings.push({ sev: 'high', msg: d + ' allows data: — enables attacker-controlled script payloads.' });
      });
    });
    if (!srcHas('object-src', "'none'") && !srcHas('default-src', "'none'")) findings.push({ sev: 'medium', msg: "object-src 'none' not set — legacy plugin injection surface remains." });
    if (!has('frame-ancestors')) findings.push({ sev: 'medium', msg: 'No frame-ancestors — CSP does not restrict clickjacking.' });
    if (!has('base-uri')) findings.push({ sev: 'low', msg: 'No base-uri — a <base> injection can hijack relative URLs.' });
    if (!has('report-uri') && !has('report-to')) findings.push({ sev: 'low', msg: 'No reporting (report-to / report-uri) — violations go unnoticed.' });
    if (reportOnly) findings.push({ sev: 'info', msg: 'Report-Only mode — this policy is NOT enforced by the browser.' });
    if (!findings.length) findings.push({ sev: 'info', msg: 'No obvious CSP weaknesses in the deterministic pass.' });
    var kv = order.map(function (d) { return [d, (dirs[d].join(' ') || '(no value)')]; });
    return { label: 'Content-Security-Policy', kv: kv, findings: findings };
  }

  /* ================= config / secret scan ================= */
  function redact(line) {
    return line.replace(/(['"=:]\s*)([^\s'"]{3})([^\s'"]{4,})/g, function (m, pre, keep, rest) {
      return pre + keep + '•'.repeat(Math.min(rest.length, 8));
    });
  }
  function analyzeConfig(text) {
    var lines = text.split(/\r?\n/), findings = [], hits = 0;
    var RULES = [
      [/AKIA[0-9A-Z]{16}/, 'AWS access key ID', 'critical'],
      [/aws_secret_access_key\s*[=:]\s*\S{20,}/i, 'AWS secret access key', 'critical'],
      [/-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----/, 'private key material', 'critical'],
      [/gh[pousr]_[A-Za-z0-9]{20,}/, 'GitHub token', 'critical'],
      [/xox[baprs]-[A-Za-z0-9-]{10,}/, 'Slack token', 'critical'],
      [/\bsk-[A-Za-z0-9]{20,}/, 'API secret key (sk-…)', 'critical'],
      [/(secret|password|passwd|pwd|token|api[_-]?key|access[_-]?key|private[_-]?key|client[_-]?secret)\s*[=:]\s*['"]?[^\s'"]{6,}/i, 'hardcoded credential', 'high'],
      [/(postgres(?:ql)?|mysql|mongodb(?:\+srv)?|redis|amqp):\/\/[^:\s\/]+:[^@\s]+@/i, 'connection string with inline password', 'high']
    ];
    lines.forEach(function (l, i) {
      RULES.forEach(function (r) {
        if (r[0].test(l)) { hits++; findings.push({ sev: r[2], msg: 'Line ' + (i + 1) + ': ' + r[1] + ' — ' + trunc(redact(l.trim()), 96) }); }
      });
    });
    if (/debug\s*[=:]\s*(true|1|on|yes)\b/i.test(text)) findings.push({ sev: 'medium', msg: 'Debug mode appears enabled — verbose errors/stack traces can leak internals in production.' });
    if (/(ssl[_-]?verify|verify[_-]?ssl|tls[_-]?verify|verify)\s*[=:]\s*(false|0|no|off|none)\b/i.test(text)) findings.push({ sev: 'high', msg: 'TLS/SSL verification appears disabled — enables man-in-the-middle interception.' });
    if (/(allowed_hosts|cors_?origins?|access-control-allow-origin)\s*[=:][^\n]*\*/i.test(text)) findings.push({ sev: 'medium', msg: 'Wildcard host / CORS allowlist detected — tighten to explicit origins.' });
    if (/\b0\.0\.0\.0\b/.test(text)) findings.push({ sev: 'low', msg: 'Service bound to 0.0.0.0 — confirm it is not unintentionally reachable from the public internet.' });
    if (!findings.length) findings.push({ sev: 'info', msg: 'No hardcoded secrets or risky patterns found in the deterministic pass.' });
    return { label: 'Configuration file', kv: [['lines scanned', String(lines.length)], ['secret matches', String(hits)]], findings: findings };
  }

  /* ================= TLS certificate (ASN.1 DER) ================= */
  var OID_NAMES = {
    '2.5.4.3': 'CN', '2.5.4.6': 'C', '2.5.4.7': 'L', '2.5.4.8': 'ST', '2.5.4.10': 'O', '2.5.4.11': 'OU',
    '1.2.840.113549.1.1.1': 'RSA', '1.2.840.10045.2.1': 'EC',
    '1.2.840.113549.1.1.4': 'md5WithRSA', '1.2.840.113549.1.1.5': 'sha1WithRSA',
    '1.2.840.113549.1.1.11': 'sha256WithRSA', '1.2.840.113549.1.1.12': 'sha384WithRSA',
    '1.2.840.113549.1.1.13': 'sha512WithRSA', '1.2.840.113549.1.1.10': 'RSASSA-PSS',
    '1.2.840.10045.4.3.2': 'ecdsa-with-SHA256', '1.2.840.10045.4.3.3': 'ecdsa-with-SHA384',
    '1.2.840.10045.4.3.4': 'ecdsa-with-SHA512'
  };
  var CURVES = { '1.2.840.10045.3.1.7': 'P-256', '1.3.132.0.34': 'P-384', '1.3.132.0.35': 'P-521' };

  function pemToBytes(pem) {
    var m = pem.match(/-----BEGIN CERTIFICATE-----([\s\S]*?)-----END CERTIFICATE-----/);
    if (!m) throw new Error('No PEM CERTIFICATE block found.');
    var b64 = m[1].replace(/[^A-Za-z0-9+/=]/g, ''), bin = atob(b64), out = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
    return out;
  }
