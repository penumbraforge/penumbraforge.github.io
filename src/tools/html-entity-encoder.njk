---
toolSlug: html-entity-encoder
permalink: /tools/html-entity-encoder/
---

<div class="tool-row" style="margin-bottom:1rem; gap:0.75rem; align-items:center; flex-wrap:wrap;">
  <div class="tool-options" role="group" aria-label="Mode">
    <button class="tool-option active" data-mode="encode" aria-pressed="true">Encode</button>
    <button class="tool-option" data-mode="decode" aria-pressed="false">Decode</button>
  </div>
  <div class="tool-options" role="group" aria-label="Entity style">
    <button class="tool-option active" data-style="named" aria-pressed="true">Named (&amp;amp;)</button>
    <button class="tool-option" data-style="decimal" aria-pressed="false">Decimal (&amp;#38;)</button>
    <button class="tool-option" data-style="hex" aria-pressed="false">Hex (&amp;#x26;)</button>
  </div>
</div>

<div class="tool-group">
  <label for="he-input" id="he-label">Text to encode</label>
  <textarea id="he-input" rows="8" placeholder="Enter text with HTML special characters like < > & &quot; '…" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
</div>

<div class="output-area">
  <button class="btn btn--copy" id="he-copy" aria-label="Copy output">Copy</button>
  <pre id="he-output" aria-label="Encoded/decoded output"></pre>
</div>

<details style="margin-top:1.5rem;">
  <summary style="cursor:pointer; font-size:0.9rem; font-weight:600; color:var(--color-text,#e2e8f0); padding:0.5rem 0;">Common HTML Entity Reference</summary>
  <div id="he-table-container" style="margin-top:0.75rem; overflow-x:auto;"></div>
</details>

<script>
(function () {
  var inputEl  = document.getElementById('he-input');
  var outputEl = document.getElementById('he-output');
  var copyBtn  = document.getElementById('he-copy');
  var labelEl  = document.getElementById('he-label');
  var tableDiv = document.getElementById('he-table-container');
  var modeBtns  = Array.prototype.slice.call(document.querySelectorAll('.tool-option[data-mode]'));
  var styleBtns = Array.prototype.slice.call(document.querySelectorAll('.tool-option[data-style]'));

  var currentMode  = 'encode';
  var currentStyle = 'named';

  var NAMED_MAP = {
    '&': 'amp', '<': 'lt', '>': 'gt', '"': 'quot', "'": 'apos',
    '\u00A0': 'nbsp', '\u00A9': 'copy', '\u00AE': 'reg', '\u2122': 'trade',
    '\u20AC': 'euro', '\u00A3': 'pound', '\u00A5': 'yen', '\u00A2': 'cent',
    '\u2665': 'hearts', '\u2660': 'spades', '\u2663': 'clubs', '\u2666': 'diams',
    '\u2014': 'mdash', '\u2013': 'ndash', '\u2026': 'hellip',
    '\u201C': 'ldquo', '\u201D': 'rdquo', '\u2018': 'lsquo', '\u2019': 'rsquo',
    '\u00E9': 'eacute', '\u00E8': 'egrave', '\u00EA': 'ecirc', '\u00EB': 'euml',
    '\u00E0': 'agrave', '\u00E1': 'aacute', '\u00E2': 'acirc', '\u00E4': 'auml',
    '\u00F6': 'ouml', '\u00FC': 'uuml', '\u00F1': 'ntilde',
    '\u00BF': 'iquest', '\u00A1': 'iexcl',
    '\u00BD': 'frac12', '\u00BC': 'frac14', '\u00BE': 'frac34',
    '\u00B0': 'deg', '\u00B1': 'plusmn', '\u00D7': 'times', '\u00F7': 'divide',
    '\u03B1': 'alpha', '\u03B2': 'beta', '\u03B3': 'gamma', '\u03B4': 'delta',
    '\u03C0': 'pi', '\u03A3': 'Sigma', '\u03C3': 'sigma', '\u03A9': 'Omega'
  };

  // Reverse map for decoding
  var NAMED_DECODE = {};
  Object.keys(NAMED_MAP).forEach(function (ch) { NAMED_DECODE[NAMED_MAP[ch]] = ch; });

  function encodeEntities(text) {
    var result = '';
    for (var i = 0; i < text.length; i++) {
      var ch = text[i];
      var code = text.charCodeAt(i);
      // Always encode these unsafe chars
      var mustEncode = ch === '&' || ch === '<' || ch === '>' || ch === '"' || ch === "'";
      // Optionally encode non-ASCII
      var nonAscii = code > 127;

      if (mustEncode || nonAscii) {
        if (currentStyle === 'named' && NAMED_MAP[ch]) {
          result += '&' + NAMED_MAP[ch] + ';';
        } else if (currentStyle === 'decimal') {
          result += '&#' + code + ';';
        } else if (currentStyle === 'hex') {
          result += '&#x' + code.toString(16).toUpperCase() + ';';
        } else {
          result += '&' + (NAMED_MAP[ch] || '#' + code) + ';';
        }
      } else {
        result += ch;
      }
    }
    return result;
  }

  function decodeEntities(text) {
    return text.replace(/&([a-zA-Z][a-zA-Z0-9]*);/g, function (match, name) {
      if (NAMED_DECODE[name] !== undefined) return NAMED_DECODE[name];
      return match;
    }).replace(/&#([0-9]+);/g, function (match, num) {
      return String.fromCharCode(parseInt(num, 10));
    }).replace(/&#[xX]([0-9a-fA-F]+);/g, function (match, hex) {
      return String.fromCharCode(parseInt(hex, 16));
    });
  }

  function convert() {
    var raw = inputEl.value;
    if (!raw) { outputEl.textContent = ''; return; }
    outputEl.textContent = currentMode === 'encode' ? encodeEntities(raw) : decodeEntities(raw);
  }

  modeBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      currentMode = btn.getAttribute('data-mode');
      modeBtns.forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active'); btn.setAttribute('aria-pressed', 'true');
      labelEl.textContent = currentMode === 'encode' ? 'Text to encode' : 'HTML to decode';
      inputEl.placeholder = currentMode === 'encode'
        ? 'Enter text with HTML special characters like < > & " \'…'
        : 'Paste HTML with entities like &amp;amp; &amp;lt; &amp;gt;…';
      convert();
    });
  });

  styleBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      currentStyle = btn.getAttribute('data-style');
      styleBtns.forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active'); btn.setAttribute('aria-pressed', 'true');
      convert();
    });
  });

  inputEl.addEventListener('input', convert);

  copyBtn.addEventListener('click', function () {
    var text = outputEl.textContent;
    if (!text) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () {
        copyBtn.textContent = 'Copied!';
        setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
      });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text; ta.style.cssText = 'position:fixed;opacity:0;';
      document.body.appendChild(ta); ta.focus(); ta.select();
      try { document.execCommand('copy'); copyBtn.textContent = 'Copied!'; } catch (e) { copyBtn.textContent = 'Failed'; }
      document.body.removeChild(ta);
      setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
    }
  });

  /* Build reference table */
  (function buildTable() {
    var refs = [
      ['&', '&amp;', '&#38;', '&#x26;', 'Ampersand'],
      ['<', '&lt;', '&#60;', '&#x3C;', 'Less-than'],
      ['>', '&gt;', '&#62;', '&#x3E;', 'Greater-than'],
      ['"', '&quot;', '&#34;', '&#x22;', 'Double quote'],
      ["'", '&apos;', '&#39;', '&#x27;', 'Single quote / apostrophe'],
      ['\u00A0', '&nbsp;', '&#160;', '&#xA0;', 'Non-breaking space'],
      ['\u00A9', '&copy;', '&#169;', '&#xA9;', 'Copyright'],
      ['\u00AE', '&reg;', '&#174;', '&#xAE;', 'Registered trademark'],
      ['\u2122', '&trade;', '&#8482;', '&#x2122;', 'Trademark'],
      ['\u20AC', '&euro;', '&#8364;', '&#x20AC;', 'Euro sign'],
      ['\u00A3', '&pound;', '&#163;', '&#xA3;', 'Pound sign'],
      ['\u2014', '&mdash;', '&#8212;', '&#x2014;', 'Em dash'],
      ['\u2013', '&ndash;', '&#8211;', '&#x2013;', 'En dash'],
      ['\u2026', '&hellip;', '&#8230;', '&#x2026;', 'Ellipsis'],
      ['\u201C', '&ldquo;', '&#8220;', '&#x201C;', 'Left double quote'],
      ['\u201D', '&rdquo;', '&#8221;', '&#x201D;', 'Right double quote'],
      ['\u00B0', '&deg;', '&#176;', '&#xB0;', 'Degree sign'],
      ['\u00D7', '&times;', '&#215;', '&#xD7;', 'Multiplication sign'],
      ['\u00F7', '&divide;', '&#247;', '&#xF7;', 'Division sign'],
      ['\u03C0', '&pi;', '&#960;', '&#x3C0;', 'Greek pi'],
    ];

    var table = document.createElement('table');
    table.style.cssText = 'border-collapse:collapse; font-size:0.82rem; width:100%; font-family:var(--font-mono,monospace);';

    var thead = document.createElement('thead');
    var hrow = document.createElement('tr');
    ['Char', 'Named', 'Decimal', 'Hex', 'Description'].forEach(function (h) {
      var th = document.createElement('th');
      th.textContent = h;
      th.style.cssText = 'text-align:left; padding:0.4rem 0.6rem; border-bottom:1px solid var(--color-border,#334155); color:var(--color-muted,#94a3b8); font-weight:600;';
      hrow.appendChild(th);
    });
    thead.appendChild(hrow);
    table.appendChild(thead);

    var tbody = document.createElement('tbody');
    refs.forEach(function (row) {
      var tr = document.createElement('tr');
      row.forEach(function (cell, ci) {
        var td = document.createElement('td');
        td.textContent = cell;
        td.style.cssText = 'padding:0.3rem 0.6rem; border-bottom:1px solid var(--color-border-subtle,#1e293b);' + (ci === 4 ? 'font-family:inherit; color:var(--color-muted,#94a3b8);' : '');
        tr.appendChild(td);
      });
      tbody.appendChild(tr);
    });
    table.appendChild(tbody);
    tableDiv.appendChild(table);
  })();
})();
</script>
