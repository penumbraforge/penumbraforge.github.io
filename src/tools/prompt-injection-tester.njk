<div class="tool-group">
  <label for="pit-input">Paste your LLM system prompt</label>
  <textarea id="pit-input" rows="12" placeholder="You are a helpful assistant that...&#10;&#10;Paste a system prompt to check it for configured defense-language patterns across ten categories. No model behavior is tested." spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
</div>

<div class="tool-row">
  <button class="btn btn--primary" id="pit-scan-btn">Review defense language</button>
  <button class="btn" id="pit-example-btn">Try Example</button>
  <button class="btn" id="pit-clear-btn">Clear</button>
</div>

<p style="font-size:0.8125rem;color:var(--text-3,#888);line-height:1.55;">This is a static phrase-matching checklist. It does not send attacks to a model, observe model behavior, or establish that a prompt is resistant or vulnerable.</p>

<div id="pit-results" style="display:none;">
  <div id="pit-score-section"></div>
  <div id="pit-categories"></div>
  <div id="pit-hardening"></div>
</div>

<div id="pit-empty" class="pit-empty-msg">Paste a system prompt above and click “Review defense language.”</div>

