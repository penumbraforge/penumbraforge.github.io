      patterns: [
        /tool\s+(output|results?|responses?)\s+(as\s+)?(untrusted|data)/i,
        /mcp|model\s+context\s+protocol/i,
        /do\s+not\s+follow.*(tool|agent|mcp|rag|retriev)/i,
        /inter.agent|cross.agent|pipeline/i,
        /memory\s+(poisoning|injection|tampering)/i
      ],
      weight: 8
    },
    multiTurnDefense: {
      label: 'Multi-turn escalation defense',
      patterns: [
        /each\s+(message|request|turn)\s+(is|should\s+be)\s+(evaluated|assessed|judged)\s+independently/i,
        /previous\s+(messages?|turns?|conversation)\s+(do\s+not|cannot)/i,
        /maintain.*(guidelines|rules|restrictions).*(across|throughout|every)/i,
        /conversation\s+history\s+(does\s+not|cannot)\s+(grant|provide|override)/i
      ],
      weight: 6
    }
  };

  /* ════════════════════════════════════════════════════════════════════
     ANALYSIS FUNCTIONS
     ════════════════════════════════════════════════════════════════════ */

  function analyzePrompt(prompt) {
    var promptLower = prompt.toLowerCase();
    var totalInjections = 0;
    var totalDefended = 0;
    var totalPartial = 0;
    var totalVulnerable = 0;

    /* Detect defenses present in the prompt */
    var detectedDefenses = {};
    var defenseScore = 0;
    var maxDefenseScore = 0;

    Object.keys(DEFENSE_PATTERNS).forEach(function (key) {
      var def = DEFENSE_PATTERNS[key];
      maxDefenseScore += def.weight;
      var found = def.patterns.some(function (re) { return re.test(prompt); });
      detectedDefenses[key] = found;
      if (found) defenseScore += def.weight;
    });

    /* Analyze each category */
    var categoryResults = CATEGORIES.map(function (cat) {
      var defenseHits = 0;
      var totalKeywords = cat.defenseKeywords.length;
      cat.defenseKeywords.forEach(function (re) {
        if (re.test(prompt)) defenseHits++;
      });

      var defenseRatio = totalKeywords > 0 ? defenseHits / totalKeywords : 0;
      var status;
      if (defenseRatio >= 0.3) {
        status = 'defended';
      } else if (defenseRatio > 0) {
        status = 'partial';
      } else {
        status = 'vulnerable';
      }

      /* Also check for generic defenses that apply broadly */
      if (status === 'vulnerable') {
        if (detectedDefenses.overrideResistance && (cat.id === 'direct-override' || cat.id === 'delimiter-escape')) {
          status = 'partial';
        }
        if (detectedDefenses.refusalInstructions && cat.id === 'extraction') {
          status = 'partial';
        }
        if (detectedDefenses.roleClarity && cat.id === 'roleplay-persona') {
          status = 'partial';
        }
        if (detectedDefenses.toolRestrictions && cat.id === 'tool-function') {
          status = 'partial';
        }
        if (detectedDefenses.indirectDefense && cat.id === 'indirect-injection') {
          status = 'partial';
        }
        if (detectedDefenses.agenticDefense && cat.id === 'agentic-2026') {
          status = 'partial';
        }
        if (detectedDefenses.multiTurnDefense && cat.id === 'multi-turn') {
          status = 'partial';
        }
        if (detectedDefenses.encodingDefense && cat.id === 'encoding-bypass') {
          status = 'partial';
        }
      }

      /* Evaluate individual injections */
      var injectionResults = cat.injections.map(function (inj) {
        var injStatus = status;

        /* Refine per-injection status based on specific keyword matches */
        if (status === 'defended') {
          injStatus = 'defended';
        } else if (status === 'partial') {
          /* Check if this specific injection type has any defense */
          var injLower = inj.text.toLowerCase();
          var hasSpecificDefense = cat.defenseKeywords.some(function (re) {
            return re.test(prompt);
          });
          injStatus = hasSpecificDefense ? 'partial' : 'vulnerable';
        }

        return {
          text: inj.text,
          severity: inj.severity,
          status: injStatus
        };
      });

      var catCounts = { defended: 0, partial: 0, vulnerable: 0 };
      injectionResults.forEach(function (r) { catCounts[r.status]++; });

      totalInjections += cat.injections.length;
      totalDefended += catCounts.defended;
      totalPartial += catCounts.partial;
      totalVulnerable += catCounts.vulnerable;

      return {
        id: cat.id,
        name: cat.name,
        description: cat.description,
        status: status,
        injections: injectionResults,
        counts: catCounts,
        recommendation: cat.recommendation
      };
    });

    /* Calculate overall score (0-100) */
    var rawScore = 0;
    categoryResults.forEach(function (cat) {
      if (cat.status === 'defended') rawScore += 10;
      else if (cat.status === 'partial') rawScore += 4;
    });

    /* Bonus for detected defenses */
    var defenseBonus = Math.round((defenseScore / maxDefenseScore) * 10);
    rawScore = Math.min(100, rawScore + defenseBonus);

    /* Letter grade */
    var grade;
    if (rawScore >= 90) grade = 'A';
    else if (rawScore >= 80) grade = 'A-';
    else if (rawScore >= 70) grade = 'B';
    else if (rawScore >= 60) grade = 'B-';
    else if (rawScore >= 50) grade = 'C';
    else if (rawScore >= 40) grade = 'C-';
    else if (rawScore >= 30) grade = 'D';
    else if (rawScore >= 20) grade = 'D-';
    else grade = 'F';

    return {
      score: rawScore,
      grade: grade,
      categories: categoryResults,
      totals: {
        injections: totalInjections,
        defended: totalDefended,
        partial: totalPartial,
        vulnerable: totalVulnerable
      },
      detectedDefenses: detectedDefenses
    };
  }

  /* ════════════════════════════════════════════════════════════════════
     RENDER FUNCTIONS
     ════════════════════════════════════════════════════════════════════ */

  function esc(s) {
    var d = document.createElement('div');
    d.appendChild(document.createTextNode(s || ''));
    return d.innerHTML;
  }

  function scoreColor(score) {
    if (score >= 70) return '#4ade80';
    if (score >= 40) return '#fbbf24';
    return '#f87171';
  }

  function renderScore(result) {
    var color = scoreColor(result.score);
    var circumference = 2 * Math.PI * 40;
    var offset = circumference - (result.score / 100) * circumference;

    var defendedCats = result.categories.filter(function (c) { return c.status === 'defended'; }).length;
    var partialCats = result.categories.filter(function (c) { return c.status === 'partial'; }).length;
    var vulnCats = result.categories.filter(function (c) { return c.status === 'vulnerable'; }).length;

    var html = '<div class="pit-score-card">' +
      '<div class="pit-grade-ring">' +
        '<svg viewBox="0 0 96 96">' +
          '<circle class="pit-grade-ring-bg" cx="48" cy="48" r="40"/>' +
          '<circle class="pit-grade-ring-fg" cx="48" cy="48" r="40" stroke="' + color + '" stroke-dasharray="' + circumference + '" stroke-dashoffset="' + offset + '"/>' +
        '</svg>' +
        '<div class="pit-grade-letter" style="color:' + color + '">' + result.score + '</div>' +
      '</div>' +
      '<div class="pit-score-details">' +
        '<div class="pit-score-title">Configured phrase-match score: ' + result.score + '/100</div>' +
        '<div class="pit-score-subtitle">' + result.totals.injections + ' bundled injection shapes represented across ' + result.categories.length + ' categories; none were run against a model</div>' +
        '<div class="pit-score-bar-outer"><div class="pit-score-bar-inner" style="width:' + result.score + '%;background:' + color + '"></div></div>' +
        '<div class="pit-score-breakdown">' +
          '<span class="pit-score-stat pit-stat-def">' + defendedCats + ' configured phrase matches</span>' +
          '<span class="pit-score-stat pit-stat-part">' + partialCats + ' partial phrase matches</span>' +
          '<span class="pit-score-stat pit-stat-vuln">' + vulnCats + ' no configured phrase match</span>' +
        '</div>' +
      '</div>' +
    '</div>';

    scoreEl.innerHTML = html;
  }

  function renderCategories(result) {
    var html = '';

    result.categories.forEach(function (cat, ci) {
      var statusLabel = cat.status === 'defended' ? 'Configured phrases matched' : cat.status === 'partial' ? 'Partial phrase match' : 'No configured phrase match';
      var totalInCat = cat.injections.length;

      html += '<div class="pit-cat-card pit-cat-card--' + cat.status + '" id="pit-cat-' + ci + '">' +
        '<div class="pit-cat-header" data-pit-toggle role="button" tabindex="0" aria-expanded="false">' +
          '<span class="pit-cat-name">' + esc(cat.name) + '</span>' +
          '<span class="pit-cat-count">' + totalInCat + ' bundled shapes</span>' +
          '<span class="pit-badge pit-badge--' + cat.status + '">' + statusLabel + '</span>' +
          '<span class="pit-cat-chevron">&#x203a;</span>' +
        '</div>' +
        '<div class="pit-cat-detail">' +
          '<div style="font-size:12px;color:var(--text-3,#888);margin-bottom:12px;line-height:1.5;">' + esc(cat.description) + '</div>';

      /* Show sample injections — up to 5 for vulnerable, 3 for partial, 2 for defended */
      var showCount = cat.status === 'vulnerable' ? 5 : cat.status === 'partial' ? 3 : 2;
      var shown = cat.injections.slice(0, showCount);

      shown.forEach(function (inj) {
        var statusClass = 'pit-example-status--' + (inj.status === 'defended' ? 'defended' : inj.status === 'partial' ? 'partial' : 'vuln');
        var statusText = inj.status === 'defended' ? 'Phrase match' : inj.status === 'partial' ? 'Partial phrase match' : 'No phrase match';
        html += '<div class="pit-injection-example">' +
          '<span class="pit-example-status ' + statusClass + '">' + statusText + '</span>' +
          esc(inj.text) +
        '</div>';
      });

      if (cat.injections.length > showCount) {
        html += '<div style="font-size:11px;color:var(--text-3,#888);margin-bottom:12px;font-family:var(--font-mono,monospace);">+ ' + (cat.injections.length - showCount) + ' more techniques in this category</div>';
      }

      html += '<div class="pit-cat-recommendation">' +
        '<strong>Recommendation</strong>' +
        esc(cat.recommendation) +
      '</div>';

      html += '</div></div>';
    });

    catsEl.innerHTML = html;

    /* Auto-expand vulnerable categories */
    result.categories.forEach(function (cat, ci) {
      if (cat.status === 'vulnerable') {
        var el = document.getElementById('pit-cat-' + ci);
        if (el) {
          el.classList.add('open');
          var header = el.querySelector('[data-pit-toggle]');
          if (header) header.setAttribute('aria-expanded', 'true');
        }
      }
    });
  }

  function toggleCategory(header) {
    var card = header.closest('.pit-cat-card');
    if (!card) return;
    var open = card.classList.toggle('open');
    header.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  catsEl.addEventListener('click', function (event) {
    var header = event.target.closest('[data-pit-toggle]');
    if (header && catsEl.contains(header)) toggleCategory(header);
  });

  catsEl.addEventListener('keydown', function (event) {
    if (event.key !== 'Enter' && event.key !== ' ') return;
    var header = event.target.closest('[data-pit-toggle]');
    if (!header || !catsEl.contains(header)) return;
    event.preventDefault();
    toggleCategory(header);
  });

  function renderHardening(result) {
    var vulnerableCats = result.categories.filter(function (c) { return c.status !== 'defended'; });

    if (vulnerableCats.length === 0) {
      hardenEl.innerHTML = '<div class="pit-hardening-section"><div class="pit-hardening-header"><span class="pit-hardening-title">Defense-language checklist</span></div><div class="pit-hardening-body"><div style="text-align:center;padding:20px;color:var(--text-3,#888);font-size:13px;">Configured phrases matched in every category. No live model behavior was tested, so this is not evidence of prompt-injection resistance.</div></div></div>';
      return;
    }

    var additions = [];
    additions.push('# DEFENSE-LANGUAGE IDEAS');
    additions.push('# Review and adapt these clauses for your system and threat model.\n');

    vulnerableCats.forEach(function (cat) {
      additions.push('## ' + cat.name + ' language');
      additions.push(cat.recommendation.replace(/^Add [^:]+:\s*/i, ''));
      additions.push('');
    });

    /* Add general hardening that applies broadly */
    var hasGeneral = false;
    if (!result.detectedDefenses.roleClarity) {
      if (!hasGeneral) { additions.push('## General Hardening'); hasGeneral = true; }
      additions.push('Define your role explicitly: "You are [ROLE] and you must always act as [ROLE]."');
    }
    if (!result.detectedDefenses.outputConstraints) {
      if (!hasGeneral) { additions.push('## General Hardening'); hasGeneral = true; }
      additions.push('Constrain output format: "Always respond in [FORMAT]. Do not deviate from this format."');
    }

    var hardeningText = additions.join('\n');

    hardenEl.innerHTML = '<div class="pit-hardening-section">' +
      '<div class="pit-hardening-header">' +
        '<span class="pit-hardening-title">Defense-language suggestions</span>' +
        '<button class="pit-copy-btn" id="pit-copy-hardening">Copy to clipboard</button>' +
      '</div>' +
      '<div class="pit-hardening-body">' +
        '<pre class="pit-hardening-block" id="pit-hardening-text">' + esc(hardeningText) + '</pre>' +
        '<div class="pit-hardening-note">These are wording ideas for categories where configured phrases did not fully match. They may clarify intended behavior, but they do not establish runtime resistance.</div>' +
      '</div>' +
    '</div>';

    document.getElementById('pit-copy-hardening').addEventListener('click', function () {
      var textEl = document.getElementById('pit-hardening-text');
      navigator.clipboard.writeText(textEl.textContent).then(function () {
        var btn = document.getElementById('pit-copy-hardening');
        btn.textContent = 'Copied';
        setTimeout(function () { btn.textContent = 'Copy to clipboard'; }, 1500);
      });
    });
  }

  /* ════════════════════════════════════════════════════════════════════
     MAIN SCAN HANDLER
     ════════════════════════════════════════════════════════════════════ */

  function runScan() {
    var prompt = inputEl.value.trim();
    if (!prompt) { inputEl.focus(); return; }

    emptyEl.style.display = 'none';
    resultsEl.style.display = '';

    var result = analyzePrompt(prompt);

    renderScore(result);
    renderCategories(result);
    renderHardening(result);

    /* Smooth scroll to results */
    scoreEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  /* ════════════════════════════════════════════════════════════════════
     EXAMPLE SYSTEM PROMPT
     ════════════════════════════════════════════════════════════════════ */

  var EXAMPLE_PROMPT = [
    'You are a helpful customer support assistant for Acme Corp.',
    'You help users with questions about our products, billing, and account management.',
    '',
    'Guidelines:',
    '- Always be polite and professional.',
    '- If you do not know the answer, say so honestly.',
    '- Do not make up product features or pricing.',
    '- Refer users to human support for complex billing disputes.',
    '- You can process returns for orders under $100.',
    '',
    'Available tools:',
    '- lookup_order(order_id): Look up order details',
    '- process_return(order_id, reason): Initiate a return',
    '- check_inventory(product_id): Check product availability',
    '',
    'Respond in a friendly, concise manner. Use markdown formatting for product lists.'
  ].join('\n');

  /* ════════════════════════════════════════════════════════════════════
     EVENT HANDLERS
     ════════════════════════════════════════════════════════════════════ */

  scanBtn.addEventListener('click', runScan);

  exampleBtn.addEventListener('click', function () {
    inputEl.value = EXAMPLE_PROMPT;
    runScan();
  });

  clearBtn.addEventListener('click', function () {
    inputEl.value = '';
    resultsEl.style.display = 'none';
    emptyEl.style.display = '';
    scoreEl.innerHTML = '';
    catsEl.innerHTML = '';
    hardenEl.innerHTML = '';
  });
})();
</script>
