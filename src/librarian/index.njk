        </thead>
        <tbody>
          <tr>
            <td>MCP_LIBRARIAN_HOME</td>
            <td><code>~/.mcp-librarian</code></td>
            <td>Base directory for skills, keys, index, and exports.</td>
          </tr>
          <tr>
            <td>MCP_LIBRARIAN_LOG_LEVEL</td>
            <td><code>info</code></td>
            <td>Logging verbosity. One of <code>debug</code>, <code>info</code>, <code>warn</code>, <code>error</code>.</td>
          </tr>
          <tr>
            <td>MCP_LIBRARIAN_RATE_LIMIT</td>
            <td><code>200</code></td>
            <td>Maximum tool requests per minute before rate limiting kicks in.</td>
          </tr>
          <tr>
            <td>MCP_LIBRARIAN_SKILLS_REPO</td>
            <td><code>penumbraforge/mcp-librarian-skills</code></td>
