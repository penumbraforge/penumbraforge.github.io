layout: lab-workspace-v2.njk
permalink: /labs/red/xss-shopstack/
labCode: "RED-01"
labTitle: "Reflected XSS — ShopStack"
labDifficulty: "beginner"
labDescription: "ShopStack's search reflects user input without sanitization. Demonstrate impact by exfiltrating the admin session token."
targetUrl: "https://lab-xss.penumbraforge.workers.dev"
targetHost: "shopstack.lab.penumbraforge.com"
workerUrl: "https://lab-xss.penumbraforge.workers.dev"
---

<!-- Mission Brief Content -->
<div class="ws-mission-header">Operation: Glass Storefront</div>
<div class="ws-mission-narrative">
  ShopStack is a growing e-commerce platform processing ~2K orders/day. A bug bounty researcher reported a potential reflection issue in their search but couldn't demonstrate impact.
  <br><br>
  You've been retained to prove exploitability and demonstrate business impact. The client needs a PoC that shows real data exposure — not just an alert box.
</div>

<div class="ws-mission-goal">
  <div class="ws-mission-goal-label">Primary Objective</div>
  <div class="ws-mission-goal-text">Exfiltrate the admin session token via reflected XSS in the search endpoint</div>
</div>

<div class="ws-mission-goal ws-mission-goal-bonus">
  <div class="ws-mission-goal-label">Bonus</div>
  <div class="ws-mission-goal-text">Achieve execution without &lt;script&gt; tags (bypasses common filters)</div>
</div>

<div class="ws-mission-intel-section">
  <div class="ws-intel-item">
    <div class="ws-intel-label">Target</div>
    <div class="ws-intel-value">shopstack.lab.penumbraforge.com</div>
  </div>
  <div class="ws-intel-item">
    <div class="ws-intel-label">Scope</div>
    <div class="ws-intel-value">Search endpoint only — /search?q=</div>
  </div>
  <div class="ws-intel-item">
    <div class="ws-intel-label">Rules of Engagement</div>
    <div class="ws-intel-value">No DoS. No SQLi (out of scope). XSS vectors only.</div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  'use strict';

  var Labs = window.PenumbraLabs;

  // NOTE: Red team procedural randomization (target app content, defenses,
  // response tokens) will be handled by Worker-side randomization in a
  // future update. The procedural engine is primarily for blue team
  // evidence corpora.
  var workerUrl = '{{ workerUrl }}';

  // ── Scenario Definition ──
  var scenario = {
    id: 'red-xss-shopstack',
    type: 'red',
    title: 'Reflected XSS — ShopStack',
    difficulty: 'beginner',
    estimatedTime: 15,
    xpReward: 100,
    skills: ['injection-reflected-xss'],
    unlocks: ['blue-investigate-shopstack'],
    optimalActions: 6,
    techniqueChecks: [
      { id: 'recon-curl', check: function(log) { return log.some(function(a) { return a.type === 'terminal' && a.command === 'curl' && a.url && a.url.indexOf('/search') !== -1; }); }, points: 25 },
      { id: 'used-repeater', check: function(log) { return log.some(function(a) { return a.type === 'repeater'; }); }, points: 25 },
      { id: 'js-executed', check: function(log) { return log.some(function(a) { return a.type === 'iframe_message' && a.message && a.message.type === 'xss-fired'; }); }, points: 25 },
      { id: 'cookie-accessed', check: function(log) { return log.some(function(a) { return a.type === 'iframe_message' && a.message && a.message.type === 'cookie-accessed'; }); }, points: 25 }
    ],

    stateGraph: {
      states: {
        'start':     { transitions: { 'recon': 'probing' } },
        'probing':   { transitions: { 'html_inject': 'injecting' } },
        'injecting': { transitions: { 'js_exec': 'executing' } },
        'executing': { transitions: { 'cookie_exfil': 'complete' } },
        'complete':  { terminal: true }
      },
      initialState: 'start'
    },

    validationRules: {
      'recon': {
        trigger: 'terminal_or_repeater',
        condition: function(action) {
          return action.response && action.response.status === 200 &&
                 action.url && action.url.indexOf('/search') !== -1;
        }
      },
      'html_inject': {
        trigger: 'terminal_or_repeater',
        condition: function(action) {
          var q = action.query || '';
          return (/<[a-z]/i).test(q) && action.response &&
                 action.response.body && action.response.body.indexOf(q) !== -1;
        }
      },
      'js_exec': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'xss-fired' && msg.executed === true;
        }
      },
      'cookie_exfil': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'cookie-accessed' && msg.value &&
                 msg.value.indexOf('session=') !== -1;
        }
      }
    },

    nudges: {
      'start': {
        delay: 90,
        text: 'Try exploring the target app in the browser view. What does the search function do with your input?'
      },
      'probing': {
        delay: 120,
        text: 'The search reflects your input in the page. What happens if you include HTML characters like angle brackets?'
      },
      'injecting': {
        delay: 120,
        text: 'HTML renders in the page. Can you make JavaScript execute? Think about event handlers like onerror.'
      },
      'executing': {
        delay: 90,
        text: 'JavaScript runs in the page context. Now access document.cookie to prove data exfiltration is possible.'
      }
    },

    objectives: [
      { id: 'recon', title: 'Reconnaissance' },
      { id: 'html_inject', title: 'HTML Injection' },
      { id: 'js_exec', title: 'JavaScript Execution' },
      { id: 'cookie_exfil', title: 'Cookie Exfiltration' }
    ]
  };

  // ── Initialize Panel System ──
  Labs.PanelSystem.init({
    container: document.getElementById('workspace'),
    panels: [
      { id: 'panel-mission', minWidth: 220, defaultWidth: 280 },
      { id: 'panel-tools', flex: true },
      { id: 'panel-browser', minWidth: 320, defaultWidth: 480 }
    ]
  });

  // ── Initialize Simulation Engine ──
  var sim = Labs.Simulation.init({
    scenario: scenario,
    bridge: Labs.SimulationBridge,
    onStateChange: function(fromState, toState, action) {
      // Find the objective that matches the transition
      var obj = scenario.objectives.find(function(o) { return o.id === toState; }) ||
                scenario.objectives.find(function(o) { return o.id === fromState; });
      var label = obj ? obj.title : toState;
      Labs.Toast.show(label + ' — confirmed', 'success');

      // Update status bar detection indicator
      updateDetection(toState);

      // Update request count
      updateRequestCount();

      // Add intel to Intel panel
      addIntel(toState, action);
    },
    onComplete: function() {
      var elapsed = Labs.Timer.stop();
      var scoringData = {
        actionsLog: sim.getActionsLog(),
        nudgesShown: sim._nudgeRef ? sim._nudgeRef._shownCount || 0 : 0,
        nudgesDismissed: sim._nudgeRef ? sim._nudgeRef._dismissCount || 0 : 0,
        evidenceFound: 4,  // all 4 states reached
        totalEvidence: 4
      };
      var result = Labs.SimulationBridge.onLabComplete(scenario.id, scenario, elapsed, scoringData);
      showCompletion(result, elapsed);
    }
  });

  // ── Initialize Terminal ──
  Labs.Terminal.init({
    container: document.getElementById('tool-terminal'),
    workerUrl: workerUrl,
    onAction: function(action) {
      sim.dispatch(action);
      requestCount++;
      updateRequestCount();
    }
  });

  // ── Initialize Repeater ──
  Labs.Repeater.init({
    container: document.getElementById('tool-repeater'),
    workerUrl: workerUrl,
    onAction: function(action) {
      sim.dispatch(action);
      requestCount++;
      updateRequestCount();
    }
  });

  // ── Initialize Decoder & Notes ──
  Labs.Decoder.init({ container: document.getElementById('tool-decoder') });
  Labs.Notes.init({ container: document.getElementById('tool-notes'), labId: scenario.id });

  // ── Listen for iframe messages ──
  window.addEventListener('message', function(e) {
    if (!e.data || !e.data.type) return;

    if (e.data.type === 'xss-fired' || e.data.type === 'cookie-accessed') {
      sim.dispatch({ type: 'iframe_message', message: e.data });
    }

    // Update browser URL bar when iframe navigates
    if (e.data.type === 'shopstack-nav' && e.data.url) {
      var urlDisplay = document.getElementById('ws-url-display');
      if (urlDisplay) {
        // Show clean URL without protocol
        var clean = e.data.url.replace(/^https?:\/\//, '');
        urlDisplay.value = clean;
      }
    }
  });

  // ── Start Timer ──
  Labs.Timer.start(function(elapsed) {
    var el = document.getElementById('lab-timer');
    if (el) el.textContent = Labs.Timer.format(elapsed);
  });

  // ── State helpers ──
  var requestCount = 0;

  function updateRequestCount() {
    var el = document.getElementById('ws-request-count');
    if (el) el.textContent = 'Requests: ' + requestCount;
  }

  function updateDetection(state) {
    var el = document.getElementById('ws-detection');
    if (!el) return;
    var labels = {
      'probing': '● Reflection Detected',
      'injecting': '● HTML Injection Confirmed',
      'executing': '● XSS Execution Confirmed',
      'complete': '● Session Token Exfiltrated'
    };
    el.textContent = labels[state] || '';
    el.style.color = state === 'complete' ? '#ef4444' : '#f59e0b';
  }

  function addIntel(state, action) {
    var panel = document.getElementById('intel-panel');
    if (!panel) return;

    // Clear empty message on first intel
    var empty = panel.querySelector('.ws-mission-empty');
    if (empty) empty.remove();

    var intel = {
      'probing': { label: 'Reflection Point', value: 'Search endpoint reflects user input in <strong> tag without encoding' },
      'injecting': { label: 'Injection Confirmed', value: 'HTML markup renders in page context — innerHTML used without sanitization' },
      'executing': { label: 'JavaScript Execution', value: 'Event handlers fire in page context — no CSP, no XSS protection header' },
      'complete': { label: 'Data Exfiltration', value: 'document.cookie accessible — session token: eyJhZG1pbiI6ZmFsc2UsInVzZXIiOiJndWVzdCJ9' }
    };

    var info = intel[state];
    if (!info) return;

    var div = document.createElement('div');
    div.className = 'ws-intel-item';
    div.innerHTML = '<div class="ws-intel-label">' + info.label + '</div>' +
                    '<div class="ws-intel-value">' + info.value + '</div>';
    panel.appendChild(div);
  }

  function showCompletion(result, elapsed) {
    // Update completion overlay with scoring data
    document.getElementById('complete-time').textContent = Labs.Timer.format(elapsed);
    document.getElementById('complete-score').textContent = result.scoring ? result.scoring.composite : 100;
    document.getElementById('complete-xp').textContent = '+' + (result.scoring ? result.scoring.xp : result.xp);
    document.getElementById('complete-level').textContent = 'Level ' + result.level + ' — ' + Labs.Xp.titleForLevel(result.level);

    // Show unlock
    if (scenario.unlocks && scenario.unlocks.length > 0) {
      var unlockEl = document.getElementById('complete-unlock');
      if (unlockEl) {
        unlockEl.style.display = '';
        unlockEl.textContent = 'Blue Team Investigation →';
        unlockEl.href = '/labs/blue/investigate-shopstack/';
      }
    }

    document.getElementById('lab-complete-overlay').classList.add('visible');

    // Render debrief in the debrief tab
    var debriefPanel = document.getElementById('debrief-panel');
    if (debriefPanel && Labs.Debrief) {
      debriefPanel.style.display = '';
      Labs.Debrief.render({
        container: debriefPanel,
        scoring: result.scoring,
        elapsed: elapsed,
        scenario: scenario,
        debriefContent: {
          analysis: '<div class="debrief-card"><h3>Vulnerability: CWE-79 — Reflected Cross-Site Scripting</h3><p>ShopStack\'s search endpoint reflects user input via <code>innerHTML</code> without encoding. The query parameter <code>q</code> is inserted directly into the HTML response, allowing injected JavaScript to execute in the victim\'s browser context.</p><p>This vulnerability allows an attacker to steal session cookies, modify page content, redirect users, or perform actions on behalf of authenticated users.</p></div>',

          framework: '<div class="debrief-card"><h3>MITRE ATT&CK Mapping</h3><p><strong>T1189</strong> — Drive-by Compromise: Initial access via malicious link to XSS payload</p><p><strong>T1539</strong> — Steal Web Session Cookie: Exfiltration of session tokens via JavaScript</p><p><strong>T1078</strong> — Valid Accounts: Attacker uses stolen sessions to access victim accounts</p></div><div class="debrief-card"><h3>OWASP Top 10</h3><p><strong>A03:2021</strong> — Injection: User input reflected without sanitization</p></div>',

          code: '<div class="debrief-section-title">Vulnerable Code</div><div class="debrief-code"><span class="vuln">res.send(`&lt;h2&gt;Results for: ${query}&lt;/h2&gt;`);</span>\n// User input interpolated directly into HTML\n// No encoding, no sanitization, no CSP</div><div class="debrief-section-title" style="margin-top:16px;">The Fix</div><div class="debrief-code"><span class="fix">const safe = query\n  .replace(/&amp;/g, \'&amp;amp;\')\n  .replace(/&lt;/g, \'&amp;lt;\')\n  .replace(/&gt;/g, \'&amp;gt;\')\n  .replace(/"/g, \'&amp;quot;\');\nres.send(`&lt;h2&gt;Results for: ${safe}&lt;/h2&gt;`);</span></div>',

          crossPerspective: {
            title: 'What a Defender Sees',
            description: 'From the SOC\'s perspective, this attack shows up as WAF alerts for XSS signatures, followed by suspicious outbound connections to an unknown domain, then session tokens appearing from geographically impossible locations. The WAF was in monitor-only mode — it detected the attack but didn\'t block it.',
            linkText: 'Try the Blue Team Investigation →',
            linkHref: '/labs/blue/investigate-shopstack/'
          }
        }
      });
    }

    // Update mission status
    var statusEl = document.getElementById('ws-mission-status');
    if (statusEl) {
      statusEl.textContent = '✓ Mission Complete';
      statusEl.style.color = '#4ade80';
    }
  }
});
</script>
