labCode: "RED-05"
labTitle: "Race Condition — Double Spend"
labDifficulty: "advanced"
labDescription: "GiftRush's redemption system checks balance and deducts in separate operations. Exploit the TOCTOU window."
targetUrl: "https://lab-race.penumbraforge.workers.dev"
targetHost: "giftrush.lab.penumbraforge.com"
workerUrl: "https://lab-race.penumbraforge.workers.dev"
