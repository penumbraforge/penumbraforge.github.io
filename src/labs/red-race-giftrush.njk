<!-- Mission Brief Content -->
<div class="ws-mission-header">Operation: Gift Heist</div>
<div class="ws-mission-narrative">
  GiftRush is a gift card marketplace with instant balance redemption. A fraud analyst noticed occasional negative balances in customer accounts — something that should be impossible given the balance check in the redemption flow.
  <br><br>
  Your objective: confirm the TOCTOU race condition in the redemption endpoint, exploit it by sending concurrent requests, and achieve a double spend that drives the balance negative.
</div>

<div class="ws-mission-goal">
  <div class="ws-mission-goal-label">Primary Objective</div>
  <div class="ws-mission-goal-text">Double-spend a gift card by exploiting the race condition between balance check and deduction</div>
</div>

<div class="ws-mission-goal ws-mission-goal-bonus">
  <div class="ws-mission-goal-label">Bonus</div>
  <div class="ws-mission-goal-text">Achieve a triple spend — three successful deductions from a single balance</div>
</div>

<div class="ws-mission-intel-section">
  <div class="ws-intel-item">
    <div class="ws-intel-label">Target</div>
    <div class="ws-intel-value">giftrush.lab.penumbraforge.com</div>
  </div>
  <div class="ws-intel-item">
    <div class="ws-intel-label">Scope</div>
    <div class="ws-intel-value">Redemption endpoint — /redeem, /balance</div>
  </div>
  <div class="ws-intel-item">
    <div class="ws-intel-label">Rules of Engagement</div>
    <div class="ws-intel-value">No DoS beyond concurrent requests. Target the timing flaw only.</div>
  </div>
</div>

<script>
(function() {
  'use strict';

  var Labs = window.PenumbraLabs;

  // NOTE: Red team procedural randomization (target app content, defenses,
  // response tokens) will be handled by Worker-side randomization in a
  // future update. The procedural engine is primarily for blue team
  // evidence corpora.
  var workerUrl = '{{ workerUrl }}';

  // ── Scenario Definition ──
  var scenario = {
    id: 'red-race-giftrush',
    type: 'red',
    title: 'Race Condition — Double Spend',
    difficulty: 'advanced',
    estimatedTime: 20,
    xpReward: 200,
    skills: ['race-condition-toctou'],
    unlocks: ['blue-investigate-giftrush'],
    optimalActions: 6,
    techniqueChecks: [
      { id: 'studied-flow', check: function(log) { return log.some(function(a) { return a.type === 'iframe_message' && a.message && a.message.action === 'balance'; }); }, points: 25 },
      { id: 'normal-redemption', check: function(log) { return log.some(function(a) { return a.type === 'iframe_message' && a.message && a.message.action === 'redeem' && !a.message.concurrent; }); }, points: 25 },
      { id: 'concurrent-sent', check: function(log) { return log.some(function(a) { return a.type === 'iframe_message' && a.message && a.message.concurrent === true; }); }, points: 25 },
      { id: 'double-spend', check: function(log) { return log.some(function(a) { return a.type === 'iframe_message' && a.message && a.message.doubleSpend === true; }); }, points: 25 }
    ],

    stateGraph: {
      states: {
        'start':           { transitions: { 'recon': 'recon' } },
        'recon':           { transitions: { 'timing_identified': 'timing_identified' } },
        'timing_identified': { transitions: { 'race_attempted': 'race_attempted' } },
        'race_attempted':  { transitions: { 'double_spend': 'double_spend' } },
        'double_spend':    { transitions: { 'complete': 'complete' } },
        'complete':        { terminal: true }
      },
      initialState: 'start'
    },

    validationRules: {
      'recon': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'race-result' && msg.action === 'balance';
        }
      },
      'timing_identified': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'race-result' && msg.action === 'redeem' && !msg.concurrent;
        }
      },
      'race_attempted': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'race-result' && msg.concurrent === true;
        }
      },
      'double_spend': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'race-result' && msg.doubleSpend === true;
        }
      },
      'complete': {
        trigger: 'auto',
        condition: function() { return true; }
      }
    },

    nudges: {
      'start': {
        delay: 90,
        text: 'Start by checking your gift card balance. Understand the redemption flow before exploiting it.'
      },
      'recon': {
        delay: 120,
        text: 'Try a normal redemption to see how the balance updates. Notice the two-step process: check balance, then deduct. What happens if multiple requests hit during the gap?'
      },
      'timing_identified': {
        delay: 120,
        text: 'The check and deduct are separate operations with no locking. Use concurrent requests to hit the balance check simultaneously — before any deduction occurs.'
      },
      'race_attempted': {
        delay: 90,
        text: 'Concurrent requests sent. Did the balance go negative? If not, try again with more requests or tighter timing.'
      }
    },

    objectives: [
      { id: 'recon', title: 'Reconnaissance' },
      { id: 'timing_identified', title: 'Timing Identified' },
      { id: 'race_attempted', title: 'Race Attempted' },
      { id: 'double_spend', title: 'Double Spend' }
    ]
  };

  // ── Initialize Panel System ──
  Labs.PanelSystem.init({
    container: document.getElementById('workspace'),
    panels: [
      { id: 'panel-mission', minWidth: 220, defaultWidth: 280 },
      { id: 'panel-tools', flex: true },
      { id: 'panel-browser', minWidth: 320, defaultWidth: 480 }
    ]
  });

  // ── Initialize Simulation Engine ──
  var sim = Labs.Simulation.init({
    scenario: scenario,
    bridge: Labs.SimulationBridge,
    onStateChange: function(fromState, toState, action) {
      var obj = scenario.objectives.find(function(o) { return o.id === toState; }) ||
                scenario.objectives.find(function(o) { return o.id === fromState; });
      var label = obj ? obj.title : toState;
      Labs.Toast.show(label + ' — confirmed', 'success');

      updateDetection(toState);
      updateRequestCount();
      addIntel(toState, action);
    },
    onComplete: function() {
      var elapsed = Labs.Timer.stop();
      var scoringData = {
        actionsLog: sim.getActionsLog(),
        nudgesShown: sim._nudgeRef ? sim._nudgeRef._shownCount || 0 : 0,
        nudgesDismissed: sim._nudgeRef ? sim._nudgeRef._dismissCount || 0 : 0,
        evidenceFound: 4,
        totalEvidence: 4
      };
      var result = Labs.SimulationBridge.onLabComplete(scenario.id, scenario, elapsed, scoringData);
      showCompletion(result, elapsed);
    }
  });

  // ── Initialize Terminal ──
  Labs.Terminal.init({
    container: document.getElementById('tool-terminal'),
    workerUrl: workerUrl,
    onAction: function(action) {
      sim.dispatch(action);
      requestCount++;
      updateRequestCount();
    }
  });

  // ── Initialize Repeater ──
  Labs.Repeater.init({
    container: document.getElementById('tool-repeater'),
    workerUrl: workerUrl,
    onAction: function(action) {
      sim.dispatch(action);
      requestCount++;
      updateRequestCount();
    }
  });

  // ── Initialize Decoder & Notes ──
  Labs.Decoder.init({ container: document.getElementById('tool-decoder') });
  Labs.Notes.init({ container: document.getElementById('tool-notes'), labId: scenario.id });

  // ── Listen for iframe messages ──
  window.addEventListener('message', function(e) {
    if (!e.data || !e.data.type) return;

    if (e.data.type === 'race-result') {
      sim.dispatch({ type: 'iframe_message', message: e.data });
    }

    if (e.data.type === 'giftrush-nav' && e.data.url) {
      var urlDisplay = document.getElementById('ws-url-display');
      if (urlDisplay) {
        var clean = e.data.url.replace(/^https?:\/\//, '');
        urlDisplay.value = clean;
      }
    }
  });

  // ── Start Timer ──
  Labs.Timer.start(function(elapsed) {
    var el = document.getElementById('lab-timer');
    if (el) el.textContent = Labs.Timer.format(elapsed);
  });

  // ── State helpers ──
  var requestCount = 0;

  function updateRequestCount() {
    var el = document.getElementById('ws-request-count');
    if (el) el.textContent = 'Requests: ' + requestCount;
  }

  function updateDetection(state) {
    var el = document.getElementById('ws-detection');
    if (!el) return;
    var labels = {
      'recon': '● Balance Checked',
      'timing_identified': '● TOCTOU Window Identified',
      'race_attempted': '● Concurrent Requests Sent',
      'double_spend': '● Double Spend Confirmed',
      'complete': '● Balance Driven Negative'
    };
    el.textContent = labels[state] || '';
    el.style.color = state === 'complete' || state === 'double_spend' ? '#ef4444' : '#f59e0b';
  }

  function addIntel(state, action) {
    var panel = document.getElementById('intel-panel');
    if (!panel) return;

    var empty = panel.querySelector('.ws-mission-empty');
    if (empty) empty.remove();

    var intel = {
      'recon': { label: 'Redemption Flow', value: 'Two-step process observed: GET /balance reads current value, POST /redeem deducts. Separate operations.' },
      'timing_identified': { label: 'TOCTOU Window', value: 'Balance check (read) and deduction (write) are not atomic — no database lock between them' },
      'race_attempted': { label: 'Concurrent Attack', value: 'Multiple simultaneous requests all passed the balance check before any deduction was written' },
      'double_spend': { label: 'Double Spend', value: 'Balance went negative — value was spent multiple times from a single balance. Race condition confirmed.' }
    };

    var info = intel[state];
    if (!info) return;

    var div = document.createElement('div');
    div.className = 'ws-intel-item';
    div.innerHTML = '<div class="ws-intel-label">' + info.label + '</div>' +
                    '<div class="ws-intel-value">' + info.value + '</div>';
    panel.appendChild(div);
  }

  function showCompletion(result, elapsed) {
    document.getElementById('complete-time').textContent = Labs.Timer.format(elapsed);
    document.getElementById('complete-score').textContent = result.scoring ? result.scoring.composite : 100;
    document.getElementById('complete-xp').textContent = '+' + (result.scoring ? result.scoring.xp : result.xp);
    document.getElementById('complete-level').textContent = 'Level ' + result.level + ' — ' + Labs.Xp.titleForLevel(result.level);

    if (scenario.unlocks && scenario.unlocks.length > 0) {
      var unlockEl = document.getElementById('complete-unlock');
      if (unlockEl) {
        unlockEl.style.display = '';
        unlockEl.textContent = 'Blue Team Investigation →';
        unlockEl.href = '/labs/blue/investigate-giftrush/';
      }
    }

    document.getElementById('lab-complete-overlay').classList.add('visible');

    var debriefPanel = document.getElementById('debrief-panel');
    if (debriefPanel && Labs.Debrief) {
      debriefPanel.style.display = '';
      Labs.Debrief.render({
        container: debriefPanel,
        scoring: result.scoring,
        elapsed: elapsed,
        scenario: scenario,
        debriefContent: {
          analysis: '<div class="debrief-card"><h3>Vulnerability: CWE-362 — Race Condition (TOCTOU)</h3><p>GiftRush\'s redemption endpoint performs a two-step operation: (1) read the balance and verify it is sufficient, then (2) calculate and write the new balance. Between these operations, no lock is held — so concurrent requests all read the same original balance, all pass the check, and all perform a deduction.</p><p>The result: value is spent that doesn\'t exist. A $50 card can be redeemed for $100+ if enough concurrent requests land in the TOCTOU window.</p></div>',

          framework: '<div class="debrief-card"><h3>MITRE ATT&CK Mapping</h3><p><strong>T1499</strong> — Endpoint Denial of Service: Application logic abuse via concurrent requests</p><p><strong>T1499.004</strong> — Application or System Exploitation: Exploiting TOCTOU to create fraudulent transactions</p></div><div class="debrief-card"><h3>OWASP Top 10</h3><p><strong>A04:2021</strong> — Insecure Design: Application lacks atomic operations for critical financial logic</p></div>',

          code: '<div class="debrief-section-title">Vulnerable Code</div><div class="debrief-code"><span class="vuln">// Step 1: Check balance (Time of Check)\nconst card = await db.getCard(cardId);\nif (card.balance &lt; amount) return 400;\n\n// Gap — no lock held here\n\n// Step 2: Deduct (Time of Use)\nawait db.updateBalance(cardId, card.balance - amount);</span></div><div class="debrief-section-title" style="margin-top:16px;">The Fix</div><div class="debrief-code"><span class="fix">// Atomic: check and deduct in one statement\nconst result = await db.query(\n  \'UPDATE cards SET balance = balance - ?\n   WHERE id = ? AND balance &gt;= ?\',\n  [amount, cardId, amount]\n);\nif (result.affectedRows === 0) return 400;</span>\n// Also: SELECT ... FOR UPDATE, idempotency keys</div>',

          crossPerspective: {
            title: 'What a Defender Sees',
            description: 'From the SOC\'s perspective, this attack appears as a burst of identical POST /redeem requests arriving within milliseconds of each other — far faster than any human interaction. The transaction log shows multiple successful deductions from the same starting balance, and the final balance is negative. Monitoring: alert on concurrent identical requests to financial endpoints, enforce idempotency keys, and audit for negative balances.',
            linkText: 'Try the Blue Team Investigation →',
            linkHref: '/labs/blue/investigate-giftrush/'
          }
        }
      });
    }

    var statusEl = document.getElementById('ws-mission-status');
    if (statusEl) {
      statusEl.textContent = '✓ Mission Complete';
      statusEl.style.color = '#4ade80';
    }
  }
})();
</script>
