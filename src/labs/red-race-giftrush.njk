{% block labScript %}
<script>
(function() {
  var LAB_CONFIG = {
    id: 'red-race-giftrush',
    type: 'red',
    title: 'Race Condition',
    target: 'GiftRush',
    difficulty: 'advanced',
    estimatedTime: 20,
    xpReward: 200,
    hintCost: [10, 25, 50],
    skills: ['race-condition-toctou'],
    unlocks: ['blue-investigate-giftrush'],
    objectives: [
      { id: 'recon', step: 1, title: 'Reconnaissance' },
      { id: 'redeem', step: 2, title: 'Normal Redemption' },
      { id: 'race', step: 3, title: 'Concurrent Requests' },
      { id: 'exploit', step: 4, title: 'Double Spend' },
    ],
  };

  var Engine = PenumbraLabs.Engine;
  var ServerLogs = PenumbraLabs.ServerLogs;

  Engine.init(LAB_CONFIG);
  ServerLogs.init('server-logs');
  ServerLogs.add('info', 'GiftRush API server started on port 3000');
  ServerLogs.add('info', 'Gift card database connected — 1 card loaded ($50.00 balance)');

  var iframe = document.getElementById('lab-target');
  var httpReq = document.getElementById('http-req');
  var httpResp = document.getElementById('http-resp');

  /* Listen for postMessage from the lab iframe */
  window.addEventListener('message', function(event) {
    var data;
    try {
      data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
    } catch(e) { return; }

    if (!data || data.type !== 'race-result') return;

    var action = data.action || '';
    var balance = data.balance;
    var doubleSpend = data.doubleSpend || false;
    var concurrent = data.concurrent || false;
    var requestCount = data.requestCount || 1;
    var statusCode = data.statusCode || 200;

    /* Update HTTP inspector */
    if (action === 'balance') {
      httpReq.innerHTML = '<span class="lab-http-method">GET</span> /balance HTTP/1.1\n' +
        '<span class="lab-http-hname">Host:</span> <span class="lab-http-hval">giftrush.com</span>\n' +
        '<span class="lab-http-hname">Cookie:</span> <span class="lab-http-hval">session=user_12345</span>';

      httpResp.innerHTML = 'HTTP/1.1 <span class="lab-http-status">200 OK</span>\n' +
        '<span class="lab-http-hname">Content-Type:</span> <span class="lab-http-hval">application/json</span>\n\n' +
        '{ <span class="lab-http-hname">"balance":</span> <span class="lab-http-hval">' + balance + '</span> }';

      ServerLogs.add('info', 'GET /balance — $' + balance + '.00');
      Engine.tryCompleteObjective('recon');
    }

    if (action === 'redeem') {
      httpReq.innerHTML = '<span class="lab-http-method">POST</span> /redeem HTTP/1.1\n' +
        '<span class="lab-http-hname">Host:</span> <span class="lab-http-hval">giftrush.com</span>\n' +
        '<span class="lab-http-hname">Content-Type:</span> <span class="lab-http-hval">application/json</span>\n\n' +
        '{ <span class="lab-http-hname">"amount":</span> <span class="lab-http-hval">' + (data.amount || 10) + '</span> }' +
        (concurrent ? '\n\n<span class="lab-http-hval" style="color:#e8b84d;">x' + requestCount + ' concurrent requests</span>' : '');

      httpResp.innerHTML = 'HTTP/1.1 <span class="lab-http-status">' + statusCode + ' OK</span>\n' +
        '<span class="lab-http-hname">Content-Type:</span> <span class="lab-http-hval">application/json</span>\n\n' +
        '{ <span class="lab-http-hname">"newBalance":</span> <span class="lab-http-hval">' + balance + '</span> }';

      if (!concurrent) {
        ServerLogs.add('info', 'POST /redeem — $' + (data.amount || 10) + ' deducted, balance: $' + balance);
        Engine.tryCompleteObjective('redeem');
      }

      if (concurrent) {
        Engine.tryCompleteObjective('race');
        ServerLogs.add('warn', requestCount + ' concurrent POST /redeem requests received');

        for (var i = 0; i < requestCount; i++) {
          ServerLogs.add('info', 'Request ' + (i + 1) + '/' + requestCount + ': balance check passed (read: $' + (data.originalBalance || 50) + ')');
        }
        ServerLogs.add('err', 'All ' + requestCount + ' requests passed balance check before any deduction');
      }

      /* Objective 4: Exploit — balance went negative */
      if (doubleSpend) {
        setTimeout(function() {
          Engine.tryCompleteObjective('exploit');
          ServerLogs.add('critical', 'Double spend confirmed — balance: $' + balance + ' (negative!)');
          ServerLogs.add('critical', 'TOCTOU race condition exploited — check and deduction are not atomic');
        }, 500);
      }
    }
  });

  /* Hint reveals */
  document.querySelectorAll('.lab-hint').forEach(function(hint, idx) {
    hint.addEventListener('click', function() {
      if (!this.classList.contains('revealed')) {
        this.classList.add('revealed');
        Engine.revealHint(idx);
      }
    });
  });

  /* Restore previous progress */
  var progress = Engine.getProgress();
  progress.objectivesCompleted.forEach(function(objId) {
    var el = document.getElementById('obj-' + objId);
    if (el) {
      el.classList.remove('current');
      el.classList.add('completed');
      el.querySelector('.lab-obj-check').textContent = '\u2713';
    }
  });

  /* Mark current objective */
  var foundCurrent = false;
  LAB_CONFIG.objectives.forEach(function(obj) {
    var el = document.getElementById('obj-' + obj.id);
    if (!el) return;
    if (progress.objectivesCompleted.indexOf(obj.id) === -1 && !foundCurrent) {
      el.classList.add('current');
      foundCurrent = true;
    }
  });

  /* Restore revealed hints */
  progress.hintsUsed.forEach(function(idx) {
    var hint = document.getElementById('hint-' + idx);
    if (hint) hint.classList.add('revealed');
  });

  function escHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
})();
</script>
