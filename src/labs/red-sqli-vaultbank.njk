labCode: "RED-02"
labTitle: "SQL Injection — VaultBank"
labDifficulty: "intermediate"
labDescription: "VaultBank's customer lookup concatenates user input into SQL queries. Extract admin credentials from the database."
targetUrl: "https://lab-sqli.penumbraforge.workers.dev"
targetHost: "vaultbank.lab.penumbraforge.com"
workerUrl: "https://lab-sqli.penumbraforge.workers.dev"
---

<!-- Mission Brief Content -->
<div class="ws-mission-header">Operation: Vault Cracker</div>
<div class="ws-mission-narrative">
  VaultBank is a financial services platform processing thousands of customer lookups daily. A support engineer reported "weird database errors" when certain inputs are entered into the account search. Your team has been retained to confirm SQL injection and demonstrate real impact.
  <br><br>
  The client needs proof that sensitive data can be extracted — not just that the query breaks. Show them an admin password hash from the database.
</div>

<div class="ws-mission-goal">
  <div class="ws-mission-goal-label">Primary Objective</div>
  <div class="ws-mission-goal-text">Extract the admin password hash from the users table via SQL injection in the lookup endpoint</div>
</div>

<div class="ws-mission-goal ws-mission-goal-bonus">
  <div class="ws-mission-goal-label">Bonus</div>
  <div class="ws-mission-goal-text">Achieve UNION-based data extraction without using OR 1=1</div>
</div>

<div class="ws-mission-intel-section">
  <div class="ws-intel-item">
    <div class="ws-intel-label">Target</div>
    <div class="ws-intel-value">vaultbank.lab.penumbraforge.com</div>
  </div>
  <div class="ws-intel-item">
    <div class="ws-intel-label">Scope</div>
    <div class="ws-intel-value">Customer lookup endpoint — /lookup?name=</div>
  </div>
  <div class="ws-intel-item">
    <div class="ws-intel-label">Rules of Engagement</div>
    <div class="ws-intel-value">No DoS. No data destruction. Read-only extraction only.</div>
  </div>
</div>

<script>
(function() {
  'use strict';

  var Labs = window.PenumbraLabs;

  // NOTE: Red team procedural randomization (target app content, defenses,
  // response tokens) will be handled by Worker-side randomization in a
  // future update. The procedural engine is primarily for blue team
  // evidence corpora.
  var workerUrl = '{{ workerUrl }}';

  // ── Scenario Definition ──
  var scenario = {
    id: 'red-sqli-vaultbank',
    type: 'red',
    title: 'SQL Injection — VaultBank',
    difficulty: 'intermediate',
    estimatedTime: 15,
    xpReward: 150,
    skills: ['injection-sqli'],
    unlocks: ['blue-investigate-vaultbank'],
    optimalActions: 6,
    techniqueChecks: [
      { id: 'recon-curl', check: function(log) { return log.some(function(a) { return a.type === 'terminal' && a.command === 'curl' && a.url && a.url.indexOf('/lookup') !== -1; }); }, points: 25 },
      { id: 'used-repeater', check: function(log) { return log.some(function(a) { return a.type === 'repeater'; }); }, points: 25 },
      { id: 'union-query', check: function(log) { return log.some(function(a) { return a.type === 'terminal_or_repeater' && a.query && /union\s+select/i.test(a.query); }); }, points: 25 },
      { id: 'data-extracted', check: function(log) { return log.some(function(a) { return a.type === 'iframe_message' && a.message && a.message.type === 'sql-result' && /password_hash|admin/i.test(JSON.stringify(a.message.rows || [])); }); }, points: 25 }
    ],

    stateGraph: {
      states: {
        'start':                { transitions: { 'recon': 'probing' } },
        'probing':              { transitions: { 'injection_confirmed': 'injection_confirmed' } },
        'injection_confirmed':  { transitions: { 'data_extracted': 'data_extracted' } },
        'data_extracted':       { transitions: { 'complete': 'complete' } },
        'complete':             { terminal: true }
      },
      initialState: 'start'
    },

    validationRules: {
      'recon': {
        trigger: 'terminal_or_repeater',
        condition: function(action) {
          return action.response && action.response.status === 200 &&
                 action.url && action.url.indexOf('/lookup') !== -1;
        }
      },
      'injection_confirmed': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return (msg.type === 'sql-error' || msg.type === 'sql-result') &&
                 msg.rows && msg.rows.length > 1;
        }
      },
      'data_extracted': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'sql-result' &&
                 /password_hash|admin/i.test(JSON.stringify(msg.rows || []));
        }
      },
      'complete': {
        trigger: 'auto',
        condition: function() { return true; }
      }
    },

    nudges: {
      'start': {
        delay: 90,
        text: 'Try exploring the lookup page. What happens when you search for a customer name?'
      },
      'probing': {
        delay: 120,
        text: 'The search works. Now try injecting a single quote (\') into the search. Does the application return a database error?'
      },
      'injection_confirmed': {
        delay: 120,
        text: 'SQL injection is confirmed. Use UNION SELECT to determine the column count and extract data from the users table.'
      },
      'data_extracted': {
        delay: 60,
        text: 'You have the admin hash. Mission complete.'
      }
    },

    objectives: [
      { id: 'recon', title: 'Reconnaissance' },
      { id: 'injection_confirmed', title: 'Injection Confirmed' },
      { id: 'data_extracted', title: 'Credential Extraction' },
      { id: 'complete', title: 'Mission Complete' }
    ]
  };

  // ── Initialize Panel System ──
  Labs.PanelSystem.init({
    container: document.getElementById('workspace'),
    panels: [
      { id: 'panel-mission', minWidth: 220, defaultWidth: 280 },
      { id: 'panel-tools', flex: true },
      { id: 'panel-browser', minWidth: 320, defaultWidth: 480 }
    ]
  });

  // ── Initialize Simulation Engine ──
  var sim = Labs.Simulation.init({
    scenario: scenario,
    bridge: Labs.SimulationBridge,
    onStateChange: function(fromState, toState, action) {
      var obj = scenario.objectives.find(function(o) { return o.id === toState; }) ||
                scenario.objectives.find(function(o) { return o.id === fromState; });
      var label = obj ? obj.title : toState;
      Labs.Toast.show(label + ' — confirmed', 'success');

      updateDetection(toState);
      updateRequestCount();
      addIntel(toState, action);
    },
    onComplete: function() {
      var elapsed = Labs.Timer.stop();
      var scoringData = {
        actionsLog: sim.getActionsLog(),
        nudgesShown: sim._nudgeRef ? sim._nudgeRef._shownCount || 0 : 0,
        nudgesDismissed: sim._nudgeRef ? sim._nudgeRef._dismissCount || 0 : 0,
        evidenceFound: 4,
        totalEvidence: 4
      };
      var result = Labs.SimulationBridge.onLabComplete(scenario.id, scenario, elapsed, scoringData);
      showCompletion(result, elapsed);
    }
  });

  // ── Initialize Terminal ──
  Labs.Terminal.init({
    container: document.getElementById('tool-terminal'),
    workerUrl: workerUrl,
    onAction: function(action) {
      sim.dispatch(action);
      requestCount++;
      updateRequestCount();
    }
  });

  // ── Initialize Repeater ──
  Labs.Repeater.init({
    container: document.getElementById('tool-repeater'),
    workerUrl: workerUrl,
    onAction: function(action) {
      sim.dispatch(action);
      requestCount++;
      updateRequestCount();
    }
  });

  // ── Initialize Decoder & Notes ──
  Labs.Decoder.init({ container: document.getElementById('tool-decoder') });
  Labs.Notes.init({ container: document.getElementById('tool-notes'), labId: scenario.id });

  // ── Listen for iframe messages ──
  window.addEventListener('message', function(e) {
    if (!e.data || !e.data.type) return;

    if (e.data.type === 'sql-result' || e.data.type === 'sql-error') {
      sim.dispatch({ type: 'iframe_message', message: e.data });
    }

    if (e.data.type === 'vaultbank-nav' && e.data.url) {
      var urlDisplay = document.getElementById('ws-url-display');
      if (urlDisplay) {
        var clean = e.data.url.replace(/^https?:\/\//, '');
        urlDisplay.value = clean;
      }
    }
  });

  // ── Start Timer ──
  Labs.Timer.start(function(elapsed) {
    var el = document.getElementById('lab-timer');
    if (el) el.textContent = Labs.Timer.format(elapsed);
  });

  // ── State helpers ──
  var requestCount = 0;

  function updateRequestCount() {
    var el = document.getElementById('ws-request-count');
    if (el) el.textContent = 'Requests: ' + requestCount;
  }

  function updateDetection(state) {
    var el = document.getElementById('ws-detection');
    if (!el) return;
    var labels = {
      'probing': '● Search Endpoint Probed',
      'injection_confirmed': '● SQL Injection Confirmed',
      'data_extracted': '● Admin Credentials Extracted',
      'complete': '● Users Table Dumped'
    };
    el.textContent = labels[state] || '';
    el.style.color = state === 'complete' ? '#ef4444' : '#f59e0b';
  }

  function addIntel(state, action) {
    var panel = document.getElementById('intel-panel');
    if (!panel) return;

    var empty = panel.querySelector('.ws-mission-empty');
    if (empty) empty.remove();

    var intel = {
      'probing': { label: 'Injection Point', value: 'Customer lookup concatenates input into SQL query without parameterization' },
      'injection_confirmed': { label: 'Injection Confirmed', value: 'Single quote triggers SQL syntax error — input interpreted as SQL code' },
      'data_extracted': { label: 'Data Extracted', value: 'UNION SELECT pulled admin password hash from users table' },
      'complete': { label: 'Mission Complete', value: 'Full credential extraction achieved — admin:$2b$10$kR8...hash exposed' }
    };

    var info = intel[state];
    if (!info) return;

    var div = document.createElement('div');
    div.className = 'ws-intel-item';
    div.innerHTML = '<div class="ws-intel-label">' + info.label + '</div>' +
                    '<div class="ws-intel-value">' + info.value + '</div>';
    panel.appendChild(div);
  }

  function showCompletion(result, elapsed) {
    document.getElementById('complete-time').textContent = Labs.Timer.format(elapsed);
    document.getElementById('complete-score').textContent = result.scoring ? result.scoring.composite : 100;
    document.getElementById('complete-xp').textContent = '+' + (result.scoring ? result.scoring.xp : result.xp);
    document.getElementById('complete-level').textContent = 'Level ' + result.level + ' — ' + Labs.Xp.titleForLevel(result.level);

    if (scenario.unlocks && scenario.unlocks.length > 0) {
      var unlockEl = document.getElementById('complete-unlock');
      if (unlockEl) {
        unlockEl.style.display = '';
        unlockEl.textContent = 'Blue Team Investigation →';
        unlockEl.href = '/labs/blue/investigate-vaultbank/';
      }
    }

    document.getElementById('lab-complete-overlay').classList.add('visible');

    var debriefPanel = document.getElementById('debrief-panel');
    if (debriefPanel && Labs.Debrief) {
      debriefPanel.style.display = '';
      Labs.Debrief.render({
        container: debriefPanel,
        scoring: result.scoring,
        elapsed: elapsed,
        scenario: scenario,
        debriefContent: {
          analysis: '<div class="debrief-card"><h3>Vulnerability: CWE-89 — SQL Injection</h3><p>VaultBank\'s customer lookup endpoint concatenates user input directly into a SQL query string using string interpolation. The <code>name</code> parameter is inserted into a <code>WHERE LIKE</code> clause without parameterization, allowing an attacker to break out of the intended query, inject arbitrary SQL, and extract data from any table in the database.</p><p>This vulnerability allows full read access to the database — customer records, admin credentials, and schema metadata. With write access, an attacker could modify or delete data entirely.</p></div>',

          framework: '<div class="debrief-card"><h3>MITRE ATT&CK Mapping</h3><p><strong>T1190</strong> — Exploit Public-Facing Application: SQL injection in customer-facing lookup endpoint</p><p><strong>T1005</strong> — Data from Local System: Extraction of credentials and customer data from the database</p></div><div class="debrief-card"><h3>OWASP Top 10</h3><p><strong>A03:2021</strong> — Injection: User input concatenated directly into SQL query without parameterization</p></div>',

          code: '<div class="debrief-section-title">Vulnerable Code</div><div class="debrief-code"><span class="vuln">const query = "SELECT * FROM customers WHERE name LIKE \'%" + input + "%\'";</span>\n// User input concatenated directly into SQL string\n// No parameterization, no input validation</div><div class="debrief-section-title" style="margin-top:16px;">The Fix</div><div class="debrief-code"><span class="fix">const query = "SELECT * FROM customers WHERE name LIKE ?";\nconst param = \'%\' + input + \'%\';\ndb.all(query, [param], callback);</span>\n// Parameterized query — input treated as data, never as code\n// Also: use an ORM, apply least-privilege DB accounts</div>',

          crossPerspective: {
            title: 'What a Defender Sees',
            description: 'From the SOC\'s perspective, this attack generates anomalous database query patterns — UNION SELECT keywords in access logs, increased query execution times, and responses containing data from tables not normally queried by the application. A well-tuned WAF would flag SQL keywords in input parameters, and database activity monitoring would alert on cross-table queries from the application service account.',
            linkText: 'Try the Blue Team Investigation →',
            linkHref: '/labs/blue/investigate-vaultbank/'
          }
        }
      });
    }

    var statusEl = document.getElementById('ws-mission-status');
    if (statusEl) {
      statusEl.textContent = '✓ Mission Complete';
      statusEl.style.color = '#4ade80';
    }
  }
})();
</script>
