<script>
(function() {
  var LAB_CONFIG = {
    id: 'red-sqli-vaultbank',
    type: 'red',
    title: 'SQL Injection',
    target: 'VaultBank',
    difficulty: 'intermediate',
    estimatedTime: 15,
    xpReward: 150,
    hintCost: [10, 25, 50],
    skills: ['injection-sqli'],
    unlocks: ['blue-investigate-vaultbank'],
    objectives: [
      { id: 'recon', step: 1, title: 'Reconnaissance' },
      { id: 'inject', step: 2, title: 'Error-Based Detection' },
      { id: 'union', step: 3, title: 'UNION Column Count' },
      { id: 'extract', step: 4, title: 'Credential Extraction' },
      { id: 'schema', step: 5, title: 'Schema Dump' },
    ],
  };

  var Engine = PenumbraLabs.Engine;
  var ServerLogs = PenumbraLabs.ServerLogs;

  Engine.init(LAB_CONFIG);
  ServerLogs.init('server-logs');
  ServerLogs.add('info', 'VaultBank API server started on port 3000');
  ServerLogs.add('info', 'SQLite database connected — customers table loaded');

  var iframe = document.getElementById('lab-target');
  var httpReq = document.getElementById('http-req');
  var httpResp = document.getElementById('http-resp');

  /* Listen for postMessage from the lab iframe */
  window.addEventListener('message', function(event) {
    var data;
    try {
      data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
    } catch(e) { return; }

    if (!data || !data.type) return;

    if (data.type === 'sql-result') {
      var query = data.query || '';

      /* Update HTTP inspector */
      httpReq.innerHTML = '<span class="lab-http-method">GET</span> /lookup?name=' + escHtml(query).substring(0, 60) + ' HTTP/1.1\n' +
        '<span class="lab-http-hname">Host:</span> <span class="lab-http-hval">vaultbank-enterprise.com</span>\n' +
        '<span class="lab-http-hname">Cookie:</span> <span class="lab-http-hval">session=eyJyb2xlIjoiY3VzdG9tZXIifQ</span>\n' +
        '<span class="lab-http-hname">User-Agent:</span> <span class="lab-http-hval">Mozilla/5.0</span>';

      httpResp.innerHTML = 'HTTP/1.1 <span class="lab-http-status">200 OK</span>\n' +
        '<span class="lab-http-hname">Content-Type:</span> <span class="lab-http-hval">application/json</span>\n' +
        '<span class="lab-http-hname">X-Powered-By:</span> <span class="lab-http-hval">Express</span>\n\n' +
        '<span class="lab-http-hval">' + escHtml(JSON.stringify(data.rows || []).substring(0, 200)) + '</span>';

      ServerLogs.add('info', 'GET /lookup?name=' + query.substring(0, 40) + ' — 200');

      /* Objective 1: Recon — any successful search */
      Engine.tryCompleteObjective('recon');

      /* Objective 3: UNION — contains UNION SELECT */
      if (/union\s+select/i.test(query)) {
        Engine.tryCompleteObjective('union');
        ServerLogs.add('warn', 'UNION SELECT detected — query structure modified');
      }

      /* Objective 4: Extract — results contain users table data */
      var rowStr = JSON.stringify(data.rows || []);
      if (/password_hash|admin/i.test(rowStr) && /union\s+select/i.test(query)) {
        Engine.tryCompleteObjective('extract');
        ServerLogs.add('err', 'Sensitive data extracted from users table — admin credentials exposed');
      }

      /* Objective 5: Schema — sqlite_master or schema dump */
      if (/sqlite_master/i.test(query) || /information_schema/i.test(query)) {
        Engine.tryCompleteObjective('schema');
        ServerLogs.add('critical', 'Database schema dumped via sqlite_master');
      }
    }

    if (data.type === 'sql-error') {
      var errorQuery = data.query || '';

      httpReq.innerHTML = '<span class="lab-http-method">GET</span> /lookup?name=' + escHtml(errorQuery).substring(0, 60) + ' HTTP/1.1\n' +
        '<span class="lab-http-hname">Host:</span> <span class="lab-http-hval">vaultbank-enterprise.com</span>\n' +
        '<span class="lab-http-hname">User-Agent:</span> <span class="lab-http-hval">Mozilla/5.0</span>';

      httpResp.innerHTML = 'HTTP/1.1 <span class="lab-http-status" style="color:#ff6b6b;">500 Internal Server Error</span>\n' +
        '<span class="lab-http-hname">Content-Type:</span> <span class="lab-http-hval">application/json</span>\n\n' +
        '<span class="lab-http-hval" style="color:#ff6b6b;">' + escHtml(data.error || 'SQL syntax error') + '</span>';

      ServerLogs.add('err', 'SQL Error: ' + (data.error || 'syntax error').substring(0, 60));

      /* Objective 2: Inject — single quote triggers SQL error */
      if (/['"]/.test(errorQuery)) {
        Engine.tryCompleteObjective('inject');
        ServerLogs.add('warn', 'SQL syntax error triggered by special character injection');
      }
    }
  });

  /* Hint reveals */
  document.querySelectorAll('.lab-hint').forEach(function(hint, idx) {
    hint.addEventListener('click', function() {
      if (!this.classList.contains('revealed')) {
        this.classList.add('revealed');
        Engine.revealHint(idx);
      }
    });
  });

  /* Restore previous progress */
  var progress = Engine.getProgress();
  progress.objectivesCompleted.forEach(function(objId) {
    var el = document.getElementById('obj-' + objId);
    if (el) {
      el.classList.remove('current');
      el.classList.add('completed');
      el.querySelector('.lab-obj-check').textContent = '\u2713';
    }
  });

  /* Mark current objective */
  var foundCurrent = false;
  LAB_CONFIG.objectives.forEach(function(obj) {
    var el = document.getElementById('obj-' + obj.id);
    if (!el) return;
    if (progress.objectivesCompleted.indexOf(obj.id) === -1 && !foundCurrent) {
      el.classList.add('current');
      foundCurrent = true;
    }
  });

  /* Restore revealed hints */
  progress.hintsUsed.forEach(function(idx) {
    var hint = document.getElementById('hint-' + idx);
    if (hint) hint.classList.add('revealed');
  });

  function escHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
})();
</script>
