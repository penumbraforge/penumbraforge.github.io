    { time: '02:11:03', source: 'web', level: 'info', msg: '<span class="ip">98.22.156.71</span> GET <span class="path">/</span> 200 — Safari/17 — Chicago, US' },
    { time: '02:14:17', source: 'web', level: 'info', msg: '<span class="ip">185.220.101.34</span> GET <span class="path">/search?q=keyboard</span> 200 — python-requests/2.31 — Moscow, RU', suspicious: true },
    { time: '02:14:22', source: 'web', level: 'info', msg: '<span class="ip">185.220.101.34</span> GET <span class="path">/search?q=monitor</span> 200 — python-requests/2.31 — Moscow, RU', suspicious: true },
    { time: '02:15:01', source: 'web', level: 'info', msg: '<span class="ip">98.22.156.71</span> GET <span class="path">/search?q=headphones</span> 200 — Safari/17' },
