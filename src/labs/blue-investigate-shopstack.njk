<div class="soc-case-header">INC-2024-0847</div>
<div class="soc-case-id">ShopStack Customer Data Exposure</div>
<div class="soc-case-narrative">
  At 14:23 UTC, the WAF flagged anomalous request patterns against ShopStack's search endpoint. Initial triage suggests a reflected XSS attack may have been used to exfiltrate session tokens.
  <br><br>
  Your SOC lead has assigned you to investigate. Determine the full attack timeline, identify all compromised assets, and prepare containment recommendations.
</div>

<div class="soc-case-goal">
  <div class="soc-case-goal-label">Objective 1</div>
  <div class="soc-case-goal-text">Reconstruct the full attack timeline from first probe to data exfiltration</div>
</div>
<div class="soc-case-goal">
  <div class="soc-case-goal-label">Objective 2</div>
  <div class="soc-case-goal-text">Identify all compromised accounts and sessions</div>
</div>
<div class="soc-case-goal">
  <div class="soc-case-goal-label">Objective 3</div>
  <div class="soc-case-goal-text">Recommend containment and remediation actions</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  'use strict';

  var Labs = window.PenumbraLabs;

  // ── Scenario Definition ──
  var scenario = {
    id: 'blue-investigate-shopstack',
    type: 'blue',
    title: 'Investigate ShopStack Breach',
    difficulty: 'intermediate',
    estimatedTime: 25,
    xpReward: 250,
    skills: ['investigation-breach', 'investigation-log-analysis', 'investigation-timeline'],
    unlocks: [],
    optimalActions: 12,
    techniqueChecks: [
      { id: 'searched-siem', check: function(log) { return log.some(function(a) { return a.type === 'siem_action'; }); }, points: 20 },
      { id: 'pivoted-ip', check: function(log) { return log.some(function(a) { return a.type === 'siem_action' && a.action === 'pivot'; }); }, points: 20 },
      { id: 'used-ioc', check: function(log) { return log.some(function(a) { return a.type === 'ioc_lookup'; }); }, points: 20 },
      { id: 'built-timeline', check: function(log) { return log.some(function(a) { return a.type === 'timeline_action'; }); }, points: 20 },
      { id: 'submitted-containment', check: function(log) { return log.some(function(a) { return a.type === 'containment_action'; }); }, points: 20 }
    ],

    // Investigation state machine — multiple valid paths
    // States represent evidence discoveries. Multiple transitions can lead to the same state.
    stateGraph: {
      states: {
        'start': { transitions: {
          'found_xss': 'xss_discovered',
          'found_recon': 'recon_discovered',
          'found_hijack': 'hijack_discovered',
          'found_exfil': 'exfil_discovered'
        }},
        'xss_discovered': { transitions: {
          'found_recon': 'multiple_evidence',
          'found_hijack': 'multiple_evidence',
          'found_exfil': 'multiple_evidence',
          'found_export': 'multiple_evidence'
        }},
        'recon_discovered': { transitions: {
          'found_xss': 'multiple_evidence',
          'found_hijack': 'multiple_evidence',
          'found_exfil': 'multiple_evidence',
          'found_export': 'multiple_evidence'
        }},
        'hijack_discovered': { transitions: {
          'found_xss': 'multiple_evidence',
          'found_recon': 'multiple_evidence',
          'found_exfil': 'multiple_evidence',
          'found_export': 'multiple_evidence'
        }},
        'exfil_discovered': { transitions: {
          'found_xss': 'multiple_evidence',
          'found_recon': 'multiple_evidence',
          'found_hijack': 'multiple_evidence',
          'found_export': 'multiple_evidence'
        }},
        'multiple_evidence': { transitions: {
          'found_xss': 'multiple_evidence',
          'found_recon': 'multiple_evidence',
          'found_hijack': 'multiple_evidence',
          'found_exfil': 'multiple_evidence',
          'found_export': 'multiple_evidence',
          'timeline_complete': 'investigation_complete',
          'report_submitted': 'investigation_complete'
        }},
        'investigation_complete': { terminal: true }
      },
      initialState: 'start'
    },

    // Validation: evidence is discovered through SIEM actions
    validationRules: {
      'found_xss': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'xss-payload';
        }
      },
      'found_recon': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'recon';
        }
      },
      'found_hijack': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'session-hijack';
        }
      },
      'found_exfil': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'exfil-domain';
        }
      },
      'found_export': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'data-export';
        }
      },
      'timeline_complete': {
        trigger: 'timeline_action',
        condition: function(action) {
          return action.type === 'timeline_add' &&
                 Labs.Timeline.getEvents().length >= 5;
        }
      },
      'report_submitted': {
        trigger: 'containment_action',
        condition: function(action) {
          return action.type === 'containment_submit' && action.score >= 60;
        }
      }
    },

    nudges: {
      'start': {
        delay: 120,
        text: 'Start by filtering the SIEM for critical severity events. What stands out?'
      },
      'xss_discovered': {
        delay: 180,
        text: 'You found the XSS payload. Can you trace what happened before and after? Try pivoting on the attacker IP.'
      },
      'recon_discovered': {
        delay: 180,
        text: 'You found the recon phase. What did the attacker do after discovering the vulnerability?'
      },
      'multiple_evidence': {
        delay: 240,
        text: 'Good progress. Have you checked the auth logs and DNS for evidence of session hijacking and data exfiltration?'
      }
    },

    objectives: [
      { id: 'found_xss', title: 'XSS Attack Identified' },
      { id: 'found_recon', title: 'Recon Phase Discovered' },
      { id: 'found_hijack', title: 'Session Hijack Confirmed' },
      { id: 'found_exfil', title: 'Exfiltration Channel Found' },
      { id: 'found_export', title: 'Data Export Detected' },
      { id: 'timeline_complete', title: 'Timeline Built' },
      { id: 'report_submitted', title: 'Containment Plan Submitted' }
    ],

    // Evidence pieces for the evidence tracker (8 total)
    evidencePieces: [
      { id: 'recon', label: 'Attacker reconnaissance activity' },
      { id: 'xss-payload', label: 'XSS payload delivery' },
      { id: 'admin-session', label: 'Admin session compromised' },
      { id: 'session-hijack', label: 'User sessions hijacked' },
      { id: 'data-export', label: 'Customer data exported' },
      { id: 'exfil-domain', label: 'Exfiltration domain identified' },
      { id: 'waf-bypass', label: 'WAF in monitor-only mode' },
      { id: 'attack-timeline', label: 'Full attack timeline reconstructed' }
    ],

    // Known IOCs for the IOC Lookup tool
    knownIOCs: {
      '198.51.100.47': {
        type: 'IPv4', reputation: 'Malicious', score: 92,
        geo: 'Bucharest, Romania', asn: 'AS9009 M247 Ltd',
        firstSeen: '2024-01-15', lastSeen: '2024-03-15',
        associations: ['Scanning activity', 'Web exploitation', 'Credential theft'],
        tags: ['scanner', 'web-attacker', 'eastern-europe']
      },
      'evil-collector.example.com': {
        type: 'Domain', reputation: 'Malicious', score: 98,
        geo: 'Moscow, Russia', asn: 'AS48666',
        firstSeen: '2024-03-10', lastSeen: '2024-03-15',
        associations: ['Data exfiltration', 'XSS callback', 'Phishing infrastructure'],
        tags: ['exfil', 'c2', 'newly-registered']
      },
      '203.0.113.99': {
        type: 'IPv4', reputation: 'Suspicious', score: 67,
        geo: 'Moscow, Russia', asn: 'AS48666',
        firstSeen: '2024-02-28', lastSeen: '2024-03-15',
        associations: ['Hosting provider', 'Mixed traffic'],
        tags: ['hosting', 'vps']
      }
    },

    // Expected containment actions
    expectedActions: ['revoke-sessions', 'block-ip', 'enable-waf', 'reset-passwords', 'notify-customers']
  };

  // ── Initialize Panel System ──
  Labs.PanelSystem.init({
    container: document.getElementById('workspace'),
    panels: [
      { id: 'panel-casefile', minWidth: 220, defaultWidth: 280 },
      { id: 'panel-siem', flex: true },
      { id: 'panel-tools', minWidth: 280, defaultWidth: 340 }
    ]
  });

  // ── Get Evidence Corpus ──
  var corpus = Labs.EvidenceCorpus.get('blue-investigate-shopstack');

  // Apply procedural randomization so evidence differs each run
  if (Labs.Procedural) {
    var tpl = Labs.EvidenceCorpus.getTemplate('blue-investigate-shopstack');
    if (tpl) {
      corpus = Labs.Procedural.apply(corpus, tpl);

      // Rebuild knownIOCs from the randomized corpus so IOC Lookup
      // matches the IPs/domains the analyst actually sees.
      var attackerIp = null;
      var exfilIp = null;
      for (var _i = 0; _i < corpus.length; _i++) {
        if (corpus[_i].evidenceId === 'recon' && corpus[_i].detail && corpus[_i].detail.srcIp) {
          attackerIp = corpus[_i].detail.srcIp;
        }
        if (corpus[_i].evidenceId === 'exfil-domain' && corpus[_i].detail && corpus[_i].detail.dstIp) {
          exfilIp = corpus[_i].detail.dstIp;
        }
      }
      if (attackerIp && attackerIp !== '198.51.100.47') {
        scenario.knownIOCs[attackerIp] = scenario.knownIOCs['198.51.100.47'];
        delete scenario.knownIOCs['198.51.100.47'];
      }
      if (exfilIp && exfilIp !== '203.0.113.99') {
        scenario.knownIOCs[exfilIp] = scenario.knownIOCs['203.0.113.99'];
        delete scenario.knownIOCs['203.0.113.99'];
      }
      // Update the exfil domain IOC key if the domain was randomized
      var exfilDomain = null;
      for (var _j = 0; _j < corpus.length; _j++) {
        if (corpus[_j].evidenceId === 'exfil-domain' && corpus[_j].detail && corpus[_j].detail.domain) {
          exfilDomain = corpus[_j].detail.domain;
          break;
        }
      }
      if (exfilDomain && exfilDomain !== 'evil-collector.example.com') {
        scenario.knownIOCs[exfilDomain] = scenario.knownIOCs['evil-collector.example.com'];
        delete scenario.knownIOCs['evil-collector.example.com'];
      }
    }
  }

  // ── Track evidence discoveries ──
  var discoveredEvidence = {};
  var totalEvidence = scenario.evidencePieces.length;

  function updateEvidenceTracker(evidenceId) {
    if (discoveredEvidence[evidenceId]) return;
    discoveredEvidence[evidenceId] = true;

    // Update the evidence panel
    var panel = document.getElementById('evidence-panel');
    if (panel) {
      // Find the undiscovered slot and mark it discovered
      var items = panel.querySelectorAll('.soc-evidence-item');
      items.forEach(function(item) {
        if (item.getAttribute('data-evidence-id') === evidenceId) {
          item.classList.remove('undiscovered');
          item.classList.add('discovered');
          var icon = item.querySelector('.soc-evidence-icon');
          if (icon) icon.textContent = '\u2713';
        }
      });
    }

    // Update status bar
    var count = Object.keys(discoveredEvidence).length;
    var el = document.getElementById('soc-evidence-count');
    if (el) el.textContent = 'Evidence: ' + count + '/' + totalEvidence;
  }

  // ── Initialize Simulation Engine ──
  var sim = Labs.Simulation.init({
    scenario: scenario,
    bridge: Labs.SimulationBridge,
    onStateChange: function(fromState, toState, action) {
      Labs.Toast.show('Evidence discovered', 'success');

      // Track evidence from SIEM actions
      if (action && action.entry && action.entry.evidenceId) {
        updateEvidenceTracker(action.entry.evidenceId);
      }

      // Update event count
      var el = document.getElementById('soc-event-count');
      if (el) el.textContent = 'Events: ' + corpus.length;
    },
    onComplete: function() {
      var elapsed = Labs.Timer.stop();
      var evidenceCount = Object.keys(discoveredEvidence).length;
      var scoringData = {
        actionsLog: sim.getActionsLog(),
        nudgesShown: sim._nudgeRef ? sim._nudgeRef._shownCount || 0 : 0,
        nudgesDismissed: sim._nudgeRef ? sim._nudgeRef._dismissCount || 0 : 0,
        evidenceFound: evidenceCount,
        totalEvidence: totalEvidence
      };
      var result = Labs.SimulationBridge.onLabComplete(scenario.id, scenario, elapsed, scoringData);
      showCompletion(result, elapsed);
    }
  });

  // ── Initialize SIEM ──
  Labs.SIEM.init({
    container: document.getElementById('tool-siem'),
    evidenceCorpus: corpus,
    onAction: function(action) {
      // Dispatch to simulation engine
      sim.dispatch({ type: 'siem_action', action: action.action, entry: action.entry });

      // Handle specific actions
      if (action.action === 'timeline') {
        // Pin to timeline
        Labs.Timeline.addEvent({
          timestamp: action.entry.timestamp,
          title: action.entry.summary.replace(/<[^>]+>/g, '').substring(0, 80),
          description: action.entry.source.toUpperCase() + ' \u2014 ' + action.entry.severity,
          severity: action.entry.severity,
          sources: [action.entry.source],
          userDiscovered: true
        });
      }
      if (action.action === 'ioc_lookup' && action.entry.detail) {
        // Switch to IOC tab and lookup
        var iocTab = document.querySelector('[data-right-tool="ioc"]');
        if (iocTab) iocTab.click();
        Labs.IOCLookup.lookup(action.entry.detail.srcIp);
      }
      if (action.action === 'evidence' && action.entry.evidenceId) {
        updateEvidenceTracker(action.entry.evidenceId);
      }
    }
  });

  // ── Initialize source-filtered SIEM views ──
  // Firewall, Auth, DNS tabs show the same corpus filtered by source
  ['firewall', 'auth', 'dns'].forEach(function(source) {
    var container = document.getElementById('tool-' + source);
    if (container) {
      var sourceMap = { firewall: 'fw', auth: 'auth', dns: 'dns' };
      var filtered = corpus.filter(function(e) { return e.source === sourceMap[source]; });
      Labs.SIEM.init({
        container: container,
        evidenceCorpus: filtered,
        onAction: function(action) {
          sim.dispatch({ type: 'siem_action', action: action.action, entry: action.entry });
          if (action.action === 'evidence' && action.entry.evidenceId) {
            updateEvidenceTracker(action.entry.evidenceId);
          }
        }
      });
    }
  });

  // ── Initialize Timeline ──
  Labs.Timeline.init({
    container: document.getElementById('tool-timeline'),
    onAction: function(action) {
      sim.dispatch({ type: 'timeline_action', type: action.type, event: action.event });
      if (Labs.Timeline.getEvents().length >= 5) {
        updateEvidenceTracker('attack-timeline');
      }
    }
  });

  // ── Initialize IOC Lookup ──
  Labs.IOCLookup.init({
    container: document.getElementById('tool-ioc'),
    knownIOCs: scenario.knownIOCs,
    onAction: function(action) {
      sim.dispatch(action);
    }
  });

  // ── Initialize Actions ──
  Labs.SOCActions.init({
    container: document.getElementById('tool-actions'),
    expectedActions: scenario.expectedActions,
    onAction: function(action) {
      sim.dispatch({ type: 'containment_action', type: action.type, score: action.score, selected: action.selected });
    }
  });

  // ── Start Timer ──
  Labs.Timer.start(function(elapsed) {
    var el = document.getElementById('lab-timer');
    if (el) el.textContent = Labs.Timer.format(elapsed);
  });

  // ── Update level display ──
  var profile = Labs.Progress.getProfile();
  var levelEl = document.getElementById('soc-level');
  if (levelEl) levelEl.textContent = 'Level ' + profile.level + ' \u00b7 ' + Labs.Xp.titleForLevel(profile.level);

  // ── Update event count ──
  var evtEl = document.getElementById('soc-event-count');
  if (evtEl) evtEl.textContent = 'Events: ' + corpus.length;

  // ── Completion handler ──
  function showCompletion(result, elapsed) {
    // Update completion overlay with scoring data
    document.getElementById('complete-time').textContent = Labs.Timer.format(elapsed);
    document.getElementById('complete-score').textContent = result.scoring ? result.scoring.composite : 100;
    document.getElementById('complete-xp').textContent = '+' + (result.scoring ? result.scoring.xp : result.xp);
    document.getElementById('complete-level').textContent = 'Level ' + result.level + ' \u2014 ' + Labs.Xp.titleForLevel(result.level);

    // Show unlock if applicable
    if (scenario.unlocks && scenario.unlocks.length > 0) {
      var unlockEl = document.getElementById('complete-unlock');
      if (unlockEl) {
        unlockEl.style.display = '';
      }
    }

    document.getElementById('lab-complete-overlay').classList.add('visible');

    // Render debrief in the report tab
    var reportPanel = document.getElementById('report-panel');
    if (reportPanel && Labs.Debrief) {
      reportPanel.style.display = '';

      // Build evidence summary HTML
      var evidenceHtml = '<div class="debrief-evidence">';
      scenario.evidencePieces.forEach(function(piece) {
        var found = !!discoveredEvidence[piece.id];
        evidenceHtml += '<div class="debrief-evidence-item ' + (found ? 'found' : 'missed') + '">' +
          (found ? '\u2713 ' : '\u2717 ') + piece.label + '</div>';
      });
      evidenceHtml += '</div>';

      Labs.Debrief.render({
        container: reportPanel,
        scoring: result.scoring,
        elapsed: elapsed,
        scenario: scenario,
        debriefContent: {
          analysis: '<div class="debrief-card"><h3>Incident: XSS to Session Hijack to Data Export</h3><p>The attacker conducted reconnaissance against ShopStack\'s search endpoint, identified a reflected XSS vulnerability, and crafted a payload that exfiltrated admin session tokens to an external domain (<code>evil-collector.example.com</code>).</p><p>Using the stolen session, the attacker accessed the admin panel from a different IP (203.0.113.99), exported customer data including emails and order history, then covered tracks by clearing access logs.</p></div>' + '<div class="debrief-card"><h3>Evidence Summary</h3>' + evidenceHtml + '</div>',

          framework: '<div class="debrief-card"><h3>NIST Incident Response Framework</h3><p><strong>1. Preparation</strong> — WAF was deployed but in monitor-only mode. No XSS-specific detection rules were active.</p><p><strong>2. Detection & Analysis</strong> — WAF alerts triggered at 14:23 UTC. SIEM correlation identified the attack chain within the log data.</p><p><strong>3. Containment</strong> — Compromised sessions should be revoked immediately. Attacker IP 198.51.100.47 and exfil domain should be blocked.</p><p><strong>4. Eradication</strong> — The vulnerable search endpoint must be patched with proper output encoding. WAF should be switched to blocking mode.</p><p><strong>5. Recovery</strong> — Reset all admin passwords. Audit all actions taken during the compromised session window. Notify affected customers.</p><p><strong>6. Lessons Learned</strong> — WAF in monitor-only mode provided visibility but no protection. Output encoding should be enforced at the framework level, not per-endpoint.</p></div>',

          code: '<div class="debrief-section-title">Attack Chain</div><div class="debrief-code"><span class="vuln">14:23 — Recon: GET /search?q=test (198.51.100.47)\n14:24 — Probe: GET /search?q=&lt;b&gt;test&lt;/b&gt;\n14:25 — Payload: GET /search?q=&lt;img src=x onerror=...&gt;\n14:26 — Exfil: POST evil-collector.example.com/collect\n14:31 — Hijack: Admin panel access from 203.0.113.99\n14:35 — Export: GET /admin/export/customers.csv</span></div><div class="debrief-section-title" style="margin-top:16px;">Key Indicators of Compromise</div><div class="debrief-code"><span class="fix">IP: 198.51.100.47 (attacker source)\nIP: 203.0.113.99 (session hijack source)\nDomain: evil-collector.example.com (exfil)\nPayload: &lt;img src=x onerror=fetch(...)&gt;\nSession: eyJhZG1pbiI6ZmFsc2V9</span></div>',

          crossPerspective: {
            title: 'What the Attacker Did',
            description: 'From the attacker\'s perspective, this was a straightforward reflected XSS exploitation. They probed the search endpoint, confirmed HTML reflection, escalated to JavaScript execution via an event handler, then used fetch() to exfiltrate document.cookie to their collection server. The lack of CSP and HttpOnly flags made this trivial.',
            linkText: 'Try the Red Team Attack \u2192',
            linkHref: '/labs/red/xss-shopstack/'
          }
        }
      });
    }

    // Update mission status
    var statusEl = document.getElementById('soc-mission-status');
    if (statusEl) {
      statusEl.textContent = '\u2713 Incident Resolved';
      statusEl.style.color = '#4ade80';
    }
  }
});
</script>
