      Engine.tryCompleteObjective('attacker');
      addEvidence('Correctly identified attacker IP: 185.220.101.34');
    } else if (ip) {
      Toast.show('Incorrect IP — look for the reconnaissance pattern', 'error');
      addEvidence('Submitted incorrect attacker IP: ' + ip);
    }

    // Check attack vector
    if (vector.indexOf('xss') !== -1 || vector.indexOf('cross-site') !== -1 || vector.indexOf('injection') !== -1) {
      Engine.tryCompleteObjective('vector');
      addEvidence('Correctly identified attack vector: XSS');
    } else if (vector) {
      Toast.show('Not quite — look at what was injected in the search queries', 'error');
    }

    // Check affected count
    if (affected === '3') {
      Engine.tryCompleteObjective('affected');
      addEvidence('Correctly identified 3 affected users');
    } else if (affected) {
      Toast.show('Check the session exfiltration logs again', 'error');
    }

    // If all objectives complete, show debrief
    var progress = Engine.getProgress();
    if (progress.objectivesCompleted.length >= 4) {
      document.getElementById('log-viewer').style.display = 'none';
      document.getElementById('siem-header').style.display = 'none';
      document.querySelector('.siem-summary').style.display = 'none';
      var debrief = document.getElementById('blue-debrief');
      debrief.style.display = '';
      debrief.style.flex = '1';
      debrief.style.overflowY = 'auto';
    }
  });

  // Initial render
  renderLogs();
})();
</script>
