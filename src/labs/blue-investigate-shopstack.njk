    { time: '05:45:15', source: 'web', level: 'critical', msg: '<span class="ip">91.215.85.17</span> GET <span class="path">/account/orders</span> 200 — using <span class="hl">stolen session sess_c41b</span> (james.wong)', suspicious: true },
