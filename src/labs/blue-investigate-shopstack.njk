    { time: '04:39:03', source: 'waf', level: 'critical', msg: 'Outbound connection — <span class="session">sess_e7f3</span> (lisa.chen) exfiltrated to <span class="hl">evil.ru</span>', suspicious: true },
    { time: '05:15:22', source: 'auth', level: 'critical', msg: 'Session <span class="session">sess_8f2a</span> used from <span class="hl">NEW IP: 91.215.85.17</span> (Bucharest, RO) — <span class="hl">original IP: 72.44.128.90 (New York)</span>', suspicious: true },
    { time: '05:15:30', source: 'web', level: 'critical', msg: '<span class="ip">91.215.85.17</span> GET <span class="path">/account/orders</span> 200 — using <span class="hl">stolen session sess_8f2a</span> (sarah.martinez)', suspicious: true },
