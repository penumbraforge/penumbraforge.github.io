    var log = LOGS[idx];
    if (timelineEntries.indexOf(idx) !== -1) return;
    timelineEntries.push(idx);
    timelineEntries.sort(function(a, b) { return a - b; });

    var container = document.getElementById('timeline-entries');
    var empty = document.getElementById('timeline-empty');
    if (empty) empty.remove();

    // Rebuild timeline
    var html = '';
    timelineEntries.forEach(function(tidx) {
      var tlog = LOGS[tidx];
      html += '<div class="tl-entry">' +
        '<span class="tl-time">' + tlog.time + '</span>' +
        '<span class="tl-text">' + tlog.msg.replace(/<[^>]+>/g, '').substring(0, 120) + '</span>' +
