      '<span class="rk">Message-ID:</span> <span class="rd">&lt;5a8c3f1e.evil-phish.ru@localhost&gt;</span>\n' +
      '<span class="rk">MIME-Version:</span> <span class="rv">1.0</span>\n' +
      '<span class="rk">Content-Type:</span> <span class="rv">text/html; charset=UTF-8</span>\n' +
      '<span class="rk">X-Mailer:</span> <span class="rd">GoPhish v0.12.1</span>\n' +
      '<span class="rk">X-Priority:</span> <span class="rv">1 (High)</span>' +
    '</div>' +

    '<div class="ph-email-client" style="margin-top:16px;">' +
      '<div class="ph-email-body">' +
        '<div style="text-align:center;margin-bottom:20px;">' +
          '<div style="font-size:36px;margin-bottom:8px;">&#x1f512;</div>' +
          '<div style="font-family:var(--font-display);font-size:18px;color:var(--text-1);">Password Expiration Notice</div>' +
        '</div>' +
        '<p>Dear Employee,</p>' +
        '<p>Your corporate network password is set to <strong style="color:var(--text-1);">expire in 24 hours</strong>. To maintain uninterrupted access to company resources, you must reset your password immediately.</p>' +
        '<p>Failure to reset your password will result in account lockout and you will need to contact the IT Help Desk to restore access.</p>' +
        '<div style="text-align:center;margin:24px 0;">' +
          '<span class="ph-cta-btn">&#x1f510; Reset Password Now</span>' +
        '</div>' +
        '<p style="font-size:11px;color:var(--muted);">If the button above does not work, copy and paste the following link into your browser:</p>' +
        '<span class="ph-obfuscated" id="payload-b64">' + PAYLOAD_B64 + '</span>' +
        '<p style="font-size:11px;color:var(--muted);margin-top:16px;">This is an automated message from the IT Security Team.<br>Meridian Corporation | 1200 Enterprise Blvd, Suite 400<br>Do not reply to this email.</p>' +
      '</div>' +
    '</div>';
  }

  function buildRecipientsTab() {
    var html = '<div style="font-family:var(--font-mono);font-size:9px;text-transform:uppercase;letter-spacing:1.5px;color:var(--text-3);margin-bottom:12px;">Recipient Activity Log</div>' +
      '<div style="margin-bottom:12px;display:flex;gap:16px;font-family:var(--font-mono);font-size:11px;">' +
        '<span style="color:var(--text-3);">Total: <span style="color:var(--text-1);">12</span></span>' +
        '<span style="color:var(--text-3);">Delivered: <span style="color:var(--text-1);">12</span></span>' +
        '<span style="color:#e8b84d;">Opened: <span style="color:var(--text-1);">8</span></span>' +
        '<span style="color:#eb5757;">Clicked: <span style="color:var(--text-1);">?</span></span>' +
      '</div>' +
      '<table class="ph-recipients-table"><thead><tr>' +
        '<th>Name</th><th>Email</th><th>Dept</th><th>Status</th><th>Time</th>' +
      '</tr></thead><tbody>';

    RECIPIENTS.forEach(function(r) {
      var statusClass = 'ph-status-' + r.status;
      var statusLabel = r.status.charAt(0).toUpperCase() + r.status.slice(1);
      html += '<tr>' +
        '<td>' + escHtml(r.name) + '</td>' +
        '<td style="font-family:var(--font-mono);font-size:10px;">' + escHtml(r.email) + '</td>' +
        '<td>' + r.dept + '</td>' +
        '<td><span class="ph-status-badge ' + statusClass + '">' + statusLabel + '</span></td>' +
        '<td style="font-family:var(--font-mono);font-size:10px;color:var(--muted);">' + (r.time || '—') + '</td>' +
      '</tr>';
    });

    html += '</tbody></table>';
    return html;
  }

  function buildIndicatorsTab() {
    return '<div class="ph-indicator-group">' +
      '<div class="ph-indicator-label">Network Indicators</div>' +
      '<div class="ph-indicator-item">' +
        '<span class="ph-indicator-type" style="color:#eb5757;background:rgba(235,87,87,0.1);">IP</span>' +
        '<span class="ph-indicator-value">91.234.56.78</span>' +
        '<span style="font-size:10px;color:var(--muted);">Sending server</span>' +
      '</div>' +
      '<div class="ph-indicator-item">' +
        '<span class="ph-indicator-type" style="color:#e8b84d;background:rgba(232,184,77,0.1);">Domain</span>' +
        '<span class="ph-indicator-value">evil-phish.ru</span>' +
        '<span style="font-size:10px;color:var(--muted);">Registered 2026-03-19</span>' +
      '</div>' +
      '<div class="ph-indicator-item">' +
        '<span class="ph-indicator-type" style="color:#e8b84d;background:rgba(232,184,77,0.1);">Domain</span>' +
        '<span class="ph-indicator-value">meridian-corp-login.evil-phish.ru</span>' +
        '<span style="font-size:10px;color:var(--muted);">Credential harvesting page</span>' +
      '</div>' +
    '</div>' +

    '<div class="ph-indicator-group">' +
      '<div class="ph-indicator-label">Email Indicators</div>' +
      '<div class="ph-indicator-item">' +
        '<span class="ph-indicator-type" style="color:var(--accent);background:rgba(184,165,214,0.1);">Header</span>' +
        '<span class="ph-indicator-value">X-Mailer: GoPhish v0.12.1</span>' +
        '<span style="font-size:10px;color:var(--muted);">Phishing framework</span>' +
      '</div>' +
      '<div class="ph-indicator-item">' +
        '<span class="ph-indicator-type" style="color:var(--accent);background:rgba(184,165,214,0.1);">Header</span>' +
        '<span class="ph-indicator-value">Message-ID contains evil-phish.ru</span>' +
        '<span style="font-size:10px;color:var(--muted);">Sender mismatch</span>' +
      '</div>' +
    '</div>' +

    '<div class="ph-indicator-group">' +
      '<div class="ph-indicator-label">Base64 Decoder Tool</div>' +
      '<div class="ph-decode-tool">' +
        '<div class="ph-decode-label">Input (Base64)</div>' +
        '<input type="text" class="ph-decode-input" id="decode-input" placeholder="Paste Base64 string here..." autocomplete="off">' +
        '<div class="ph-decode-label">Decoded Output</div>' +
        '<div class="ph-decode-output" id="decode-output">—</div>' +
      '</div>' +
    '</div>';
  }

  var tabs = { email: buildEmailTab, recipients: buildRecipientsTab, indicators: buildIndicatorsTab };
  var contentEl = document.getElementById('ph-content');
  var currentTab = 'email';

  function showTab(tabName) {
    currentTab = tabName;
    contentEl.innerHTML = tabs[tabName]();
    document.querySelectorAll('.ph-tab').forEach(function(t) {
      t.classList.toggle('active', t.getAttribute('data-ph-tab') === tabName);
    });

    // Reattach handlers after render
    if (tabName === 'email') {
      var hdrBtn = document.getElementById('btn-show-headers');
      if (hdrBtn) {
        hdrBtn.addEventListener('click', function() {
          var hdrs = document.getElementById('raw-headers');
          headersVisible = !headersVisible;
          hdrs.classList.toggle('visible', headersVisible);
          this.textContent = headersVisible ? 'Hide Full Headers' : 'Show Full Headers';
          addEvidence('Viewed full email headers');
        });
      }
    }

    if (tabName === 'indicators') {
      var decodeInput = document.getElementById('decode-input');
      var decodeOutput = document.getElementById('decode-output');
      if (decodeInput) {
        decodeInput.addEventListener('input', function() {
          var val = this.value.trim();
          if (!val) { decodeOutput.textContent = '\u2014'; return; }
          try {
            var decoded = atob(val);
            decodeOutput.textContent = decoded;
            decodeOutput.style.color = 'var(--sage)';

            // Check if they decoded the payload
            if (decoded === PAYLOAD_DECODED) {
              Engine.tryCompleteObjective('decode');
              addEvidence('Decoded payload URL: ' + decoded);
              Toast.show('Payload decoded!', 'success');
            }
          } catch(e) {
            decodeOutput.textContent = 'Invalid Base64';
            decodeOutput.style.color = '#eb5757';
          }
        });
      }
    }
  }

  // Tab click handlers
  document.querySelectorAll('.ph-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      showTab(this.getAttribute('data-ph-tab'));
    });
  });

  // Initial render
  showTab('email');

  function addEvidence(text) {
    var log = document.getElementById('evidence-log');
    if (log.querySelector('.evidence-empty')) log.innerHTML = '';
    var elapsed = PenumbraLabs.Timer.getElapsed();
    var time = PenumbraLabs.Timer.format(elapsed);
    log.innerHTML += '<div class="evidence-item"><div class="evidence-item-time">' + time + '</div><div class="evidence-item-text">' + text + '</div></div>';
  }

  // Submit findings
  document.getElementById('btn-submit').addEventListener('click', function() {
    var sender = document.getElementById('answer-sender').value.trim().toLowerCase();
    var url = document.getElementById('answer-url').value.trim().toLowerCase();
    var clicks = document.getElementById('answer-clicks').value.trim();

    var allCorrect = true;

    // Check sender
    if (sender === 'mail.evil-phish.ru' || sender === 'evil-phish.ru') {
      Engine.tryCompleteObjective('sender');
      addEvidence('Correctly identified sending server: ' + sender);
    } else if (sender) {
      Toast.show('Incorrect sender — check the Received: headers (read bottom to top)', 'error');
      addEvidence('Submitted incorrect sender: ' + sender);
      allCorrect = false;
    } else {
      allCorrect = false;
    }

    // Check decoded URL
    if (url === PAYLOAD_DECODED || url === 'meridian-corp-login.evil-phish.ru/auth/login' || url.indexOf('evil-phish.ru') !== -1) {
      Engine.tryCompleteObjective('decode');
      addEvidence('Correctly identified payload URL');
    } else if (url) {
      Toast.show('That URL doesn\'t look right — try decoding the Base64 string from the email body', 'error');
      addEvidence('Submitted incorrect URL: ' + url);
      allCorrect = false;
    } else {
      allCorrect = false;
    }

    // Check click count
    if (clicks === '4') {
      Engine.tryCompleteObjective('clicks');
      addEvidence('Correctly identified 4 users who clicked');
    } else if (clicks) {
      Toast.show('Check the Recipients tab — count only users with "Clicked" status', 'error');
      addEvidence('Submitted incorrect click count: ' + clicks);
      allCorrect = false;
    } else {
      allCorrect = false;
    }

    // Final submit objective
    var progress = Engine.getProgress();
    if (progress.objectivesCompleted.length >= 3 || (allCorrect && sender && url && clicks)) {
      Engine.tryCompleteObjective('submit');

      // Show debrief
      contentEl.style.display = 'none';
      document.getElementById('siem-header').style.display = 'none';
      document.querySelector('.siem-summary').style.display = 'none';
      document.querySelectorAll('.ph-tab').forEach(function(t) { t.parentElement.style.display = 'none'; });
      var debrief = document.getElementById('blue-debrief');
      debrief.style.display = '';
      debrief.style.flex = '1';
      debrief.style.overflowY = 'auto';
    }
  });

  function escHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
})();
</script>
