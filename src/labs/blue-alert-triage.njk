<div class="soc-case-header">INC-2024-0901</div>
<div class="soc-case-id">Brute Force Login Attempt Detected</div>
<div class="soc-case-narrative">
  At 02:14 UTC, the authentication gateway flagged 847 failed login attempts against the VPN from a single external IP. Your SOC queue has 80 unacknowledged alerts from the past shift. Most are noise — your job is to find the real attack.
  <br><br>
  Classify each alert as a true positive, false positive, or misconfigured rule. Identify the brute force attack, dismiss the noise, and flag the rules that need tuning.
</div>

<div class="soc-case-goal">
  <div class="soc-case-goal-label">Objective 1</div>
  <div class="soc-case-goal-text">Identify the real brute force attack in the alert queue</div>
</div>
<div class="soc-case-goal">
  <div class="soc-case-goal-label">Objective 2</div>
  <div class="soc-case-goal-text">Classify false positives correctly</div>
</div>
<div class="soc-case-goal">
  <div class="soc-case-goal-label">Objective 3</div>
  <div class="soc-case-goal-text">Find the misconfigured rule generating unnecessary alerts</div>
</div>

<script>
(function() {
  'use strict';

  var Labs = window.PenumbraLabs;

  // ── Scenario Definition ──
  var scenario = {
    id: 'blue-alert-triage',
    type: 'blue',
    title: 'Alert Triage',
    difficulty: 'beginner',
    estimatedTime: 15,
    xpReward: 150,
    skills: ['triage-alert-classification', 'triage-false-positive-tuning'],
    unlocks: [],
    optimalActions: 8,
    techniqueChecks: [
      { id: 'searched-siem', check: function(log) { return log.some(function(a) { return a.type === 'siem_action'; }); }, points: 20 },
      { id: 'pivoted-ip', check: function(log) { return log.some(function(a) { return a.type === 'siem_action' && a.action === 'pivot'; }); }, points: 20 },
      { id: 'used-ioc', check: function(log) { return log.some(function(a) { return a.type === 'ioc_lookup'; }); }, points: 20 },
      { id: 'built-timeline', check: function(log) { return log.some(function(a) { return a.type === 'timeline_action'; }); }, points: 20 },
      { id: 'submitted-containment', check: function(log) { return log.some(function(a) { return a.type === 'containment_action'; }); }, points: 20 }
    ],

    stateGraph: {
      states: {
        'start': { transitions: {
          'found_brute_force': 'brute_force_found',
          'found_false_positive': 'false_positive_found',
          'found_misconfig': 'misconfig_found'
        }},
        'brute_force_found': { transitions: {
          'found_false_positive': 'multiple_evidence',
          'found_misconfig': 'multiple_evidence',
          'found_brute_force': 'brute_force_found'
        }},
        'false_positive_found': { transitions: {
          'found_brute_force': 'multiple_evidence',
          'found_misconfig': 'multiple_evidence',
          'found_false_positive': 'false_positive_found'
        }},
        'misconfig_found': { transitions: {
          'found_brute_force': 'multiple_evidence',
          'found_false_positive': 'multiple_evidence',
          'found_misconfig': 'misconfig_found'
        }},
        'multiple_evidence': { transitions: {
          'found_brute_force': 'multiple_evidence',
          'found_false_positive': 'multiple_evidence',
          'found_misconfig': 'multiple_evidence',
          'classified_all': 'all_classified',
          'report_submitted': 'all_classified'
        }},
        'all_classified': { transitions: {
          'report_submitted': 'complete'
        }},
        'complete': { terminal: true }
      },
      initialState: 'start'
    },

    validationRules: {
      'found_brute_force': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'brute-force';
        }
      },
      'found_false_positive': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'vuln-scan-fp';
        }
      },
      'found_misconfig': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'dlp-misconfig';
        }
      },
      'classified_all': {
        trigger: 'timeline_action',
        condition: function(action) {
          return action.type === 'timeline_add' &&
                 Labs.Timeline.getEvents().length >= 3;
        }
      },
      'report_submitted': {
        trigger: 'containment_action',
        condition: function(action) {
          return action.type === 'containment_submit' && action.score >= 60;
        }
      }
    },

    nudges: {
      'start': {
        delay: 90,
        text: 'Start by filtering the SIEM for critical severity events. What stands out from the noise?'
      },
      'brute_force_found': {
        delay: 120,
        text: 'Good, you found the brute force. Now look at the other alerts — which are routine and which need rule tuning?'
      },
      'multiple_evidence': {
        delay: 180,
        text: 'You have identified multiple alert types. Pin key events to the timeline and submit your containment actions.'
      }
    },

    objectives: [
      { id: 'found_brute_force', title: 'Brute Force Attack Identified' },
      { id: 'found_false_positive', title: 'False Positive Classified' },
      { id: 'found_misconfig', title: 'Misconfigured Rule Found' },
      { id: 'classified_all', title: 'All Alert Types Classified' },
      { id: 'report_submitted', title: 'Containment Plan Submitted' }
    ],

    evidencePieces: [
      { id: 'brute-force', label: 'Brute force attack from 185.220.101.34' },
      { id: 'vuln-scan-fp', label: 'Vulnerability scanner false positive' },
      { id: 'dlp-misconfig', label: 'DLP rule misconfiguration (backup traffic)' },
      { id: 'impossible-travel', label: 'Impossible travel — credential compromise' },
      { id: 'c2-dns', label: 'Emotet C2 DNS query detected' },
      { id: 'alert-classification', label: 'All alerts correctly classified' }
    ],

    knownIOCs: {
      '185.220.101.34': {
        type: 'IPv4', reputation: 'Malicious', score: 95,
        geo: 'Moscow, Russia', asn: 'AS9009 M247 Ltd',
        firstSeen: '2024-01-10', lastSeen: '2024-03-22',
        associations: ['Credential stuffing', 'Brute force', 'Tor exit node'],
        tags: ['brute-force', 'tor-exit', 'eastern-europe']
      },
      '51.15.42.198': {
        type: 'IPv4', reputation: 'Suspicious', score: 72,
        geo: 'London, UK', asn: 'AS12876 Scaleway',
        firstSeen: '2024-02-18', lastSeen: '2024-03-22',
        associations: ['VPS hosting', 'Mixed traffic', 'Credential abuse'],
        tags: ['vps', 'hosting', 'suspicious']
      },
      'update.microsofft-security.com': {
        type: 'Domain', reputation: 'Malicious', score: 97,
        geo: 'Unknown', asn: 'AS48666',
        firstSeen: '2026-03-18', lastSeen: '2026-03-22',
        associations: ['Emotet C2', 'Typosquatting', 'Malware distribution'],
        tags: ['c2', 'emotet', 'typosquat']
      }
    },

    expectedActions: ['block-ip', 'reset-passwords', 'enable-mfa']
  };

  // ── Initialize Panel System ──
  Labs.PanelSystem.init({
    container: document.getElementById('workspace'),
    panels: [
      { id: 'panel-casefile', minWidth: 220, defaultWidth: 280 },
      { id: 'panel-siem', flex: true },
      { id: 'panel-tools', minWidth: 280, defaultWidth: 340 }
    ]
  });

  // ── Get Evidence Corpus ──
  var corpus = Labs.EvidenceCorpus.get('blue-alert-triage');

  // Apply procedural randomization so evidence differs each run
  if (Labs.Procedural) {
    var tpl = Labs.EvidenceCorpus.getTemplate('blue-alert-triage');
    if (tpl) {
      corpus = Labs.Procedural.apply(corpus, tpl);

      // Rebuild knownIOCs from randomized corpus
      var attackerIp = null;
      for (var _i = 0; _i < corpus.length; _i++) {
        if (corpus[_i].evidenceId === 'brute-force' && corpus[_i].detail && corpus[_i].detail.srcIp) {
          attackerIp = corpus[_i].detail.srcIp;
          break;
        }
      }
      if (attackerIp && attackerIp !== '45.33.32.100') {
        scenario.knownIOCs[attackerIp] = scenario.knownIOCs['185.220.101.34'] || {
          type: 'IPv4', reputation: 'Malicious', score: 95,
          geo: 'Moscow, Russia', asn: 'AS9009 M247 Ltd',
          firstSeen: '2024-01-10', lastSeen: '2024-03-22',
          associations: ['Credential stuffing', 'Brute force', 'Tor exit node'],
          tags: ['brute-force', 'tor-exit', 'eastern-europe']
        };
        delete scenario.knownIOCs['185.220.101.34'];
      }
    }
  }

  // ── Track evidence discoveries ──
  var discoveredEvidence = {};
  var totalEvidence = scenario.evidencePieces.length;

  function updateEvidenceTracker(evidenceId) {
    if (discoveredEvidence[evidenceId]) return;
    discoveredEvidence[evidenceId] = true;

    var panel = document.getElementById('evidence-panel');
    if (panel) {
      var items = panel.querySelectorAll('.soc-evidence-item');
      items.forEach(function(item) {
        if (item.getAttribute('data-evidence-id') === evidenceId) {
          item.classList.remove('undiscovered');
          item.classList.add('discovered');
          var icon = item.querySelector('.soc-evidence-icon');
          if (icon) icon.textContent = '\u2713';
        }
      });
    }

    var count = Object.keys(discoveredEvidence).length;
    var el = document.getElementById('soc-evidence-count');
    if (el) el.textContent = 'Evidence: ' + count + '/' + totalEvidence;
  }

  // ── Initialize Simulation Engine ──
  var sim = Labs.Simulation.init({
    scenario: scenario,
    bridge: Labs.SimulationBridge,
    onStateChange: function(fromState, toState, action) {
      Labs.Toast.show('Evidence discovered', 'success');

      if (action && action.entry && action.entry.evidenceId) {
        updateEvidenceTracker(action.entry.evidenceId);
      }

      var el = document.getElementById('soc-event-count');
      if (el) el.textContent = 'Events: ' + corpus.length;
    },
    onComplete: function() {
      var elapsed = Labs.Timer.stop();
      var evidenceCount = Object.keys(discoveredEvidence).length;
      var scoringData = {
        actionsLog: sim.getActionsLog(),
        nudgesShown: sim._nudgeRef ? sim._nudgeRef._shownCount || 0 : 0,
        nudgesDismissed: sim._nudgeRef ? sim._nudgeRef._dismissCount || 0 : 0,
        evidenceFound: evidenceCount,
        totalEvidence: totalEvidence
      };
      var result = Labs.SimulationBridge.onLabComplete(scenario.id, scenario, elapsed, scoringData);
      showCompletion(result, elapsed);
    }
  });

  // ── Initialize SIEM ──
  Labs.SIEM.init({
    container: document.getElementById('tool-siem'),
    evidenceCorpus: corpus,
    onAction: function(action) {
      sim.dispatch({ type: 'siem_action', action: action.action, entry: action.entry });

      if (action.action === 'timeline') {
        Labs.Timeline.addEvent({
          timestamp: action.entry.timestamp,
          title: action.entry.summary.replace(/<[^>]+>/g, '').substring(0, 80),
          description: action.entry.source.toUpperCase() + ' \u2014 ' + action.entry.severity,
          severity: action.entry.severity,
          sources: [action.entry.source],
          userDiscovered: true
        });
      }
      if (action.action === 'ioc_lookup' && action.entry.detail) {
        var iocTab = document.querySelector('[data-right-tool="ioc"]');
        if (iocTab) iocTab.click();
        Labs.IOCLookup.lookup(action.entry.detail.srcIp);
      }
      if (action.action === 'evidence' && action.entry.evidenceId) {
        updateEvidenceTracker(action.entry.evidenceId);
      }
    }
  });

  // ── Initialize source-filtered SIEM views ──
  ['firewall', 'auth', 'dns'].forEach(function(source) {
    var container = document.getElementById('tool-' + source);
    if (container) {
      var sourceMap = { firewall: 'fw', auth: 'auth', dns: 'dns' };
      var filtered = corpus.filter(function(e) { return e.source === sourceMap[source]; });
      Labs.SIEM.init({
        container: container,
        evidenceCorpus: filtered,
        onAction: function(action) {
          sim.dispatch({ type: 'siem_action', action: action.action, entry: action.entry });
          if (action.action === 'evidence' && action.entry.evidenceId) {
            updateEvidenceTracker(action.entry.evidenceId);
          }
        }
      });
    }
  });

  // ── Initialize Timeline ──
  Labs.Timeline.init({
    container: document.getElementById('tool-timeline'),
    onAction: function(action) {
      sim.dispatch({ type: 'timeline_action', type: action.type, event: action.event });
      if (Labs.Timeline.getEvents().length >= 3) {
        updateEvidenceTracker('alert-classification');
      }
    }
  });

  // ── Initialize IOC Lookup ──
  Labs.IOCLookup.init({
    container: document.getElementById('tool-ioc'),
    knownIOCs: scenario.knownIOCs,
    onAction: function(action) {
      sim.dispatch(action);
    }
  });

  // ── Initialize Actions ──
  Labs.SOCActions.init({
    container: document.getElementById('tool-actions'),
    expectedActions: scenario.expectedActions,
    onAction: function(action) {
      sim.dispatch({ type: 'containment_action', type: action.type, score: action.score, selected: action.selected });
    }
  });

  // ── Start Timer ──
  Labs.Timer.start(function(elapsed) {
    var el = document.getElementById('lab-timer');
    if (el) el.textContent = Labs.Timer.format(elapsed);
  });

  // ── Update level display ──
  var profile = Labs.Progress.getProfile();
  var levelEl = document.getElementById('soc-level');
  if (levelEl) levelEl.textContent = 'Level ' + profile.level + ' \u00b7 ' + Labs.Xp.titleForLevel(profile.level);

  // ── Update event count ──
  var evtEl = document.getElementById('soc-event-count');
  if (evtEl) evtEl.textContent = 'Events: ' + corpus.length;

  // ── Completion handler ──
  function showCompletion(result, elapsed) {
    document.getElementById('complete-time').textContent = Labs.Timer.format(elapsed);
    document.getElementById('complete-score').textContent = result.scoring ? result.scoring.composite : 100;
    document.getElementById('complete-xp').textContent = '+' + (result.scoring ? result.scoring.xp : result.xp);
    document.getElementById('complete-level').textContent = 'Level ' + result.level + ' \u2014 ' + Labs.Xp.titleForLevel(result.level);

    if (scenario.unlocks && scenario.unlocks.length > 0) {
      var unlockEl = document.getElementById('complete-unlock');
      if (unlockEl) {
        unlockEl.style.display = '';
      }
    }

    document.getElementById('lab-complete-overlay').classList.add('visible');

    var reportPanel = document.getElementById('report-panel');
    if (reportPanel && Labs.Debrief) {
      reportPanel.style.display = '';

      var evidenceHtml = '<div class="debrief-evidence">';
      scenario.evidencePieces.forEach(function(piece) {
        var found = !!discoveredEvidence[piece.id];
        evidenceHtml += '<div class="debrief-evidence-item ' + (found ? 'found' : 'missed') + '">' +
          (found ? '\u2713 ' : '\u2717 ') + piece.label + '</div>';
      });
      evidenceHtml += '</div>';

      Labs.Debrief.render({
        container: reportPanel,
        scoring: result.scoring,
        elapsed: elapsed,
        scenario: scenario,
        debriefContent: {
          analysis: '<div class="debrief-card"><h3>Incident: Brute Force Against VPN Gateway</h3><p>The attacker at <code>185.220.101.34</code> (Moscow, known Tor exit node) launched an automated credential stuffing attack against the VPN gateway, targeting executive accounts (CEO, CFO, CTO, admin). 847 attempts in 12 minutes using <code>python-requests</code> indicates an automated tool.</p><p>Meanwhile, the impossible travel alert for <code>sarah.martinez</code> revealed a separate credential compromise — a login from London using <code>curl</code> 4 minutes after a legitimate New York session. The DNS query to <code>update.microsofft-security.com</code> (typosquatted) confirmed an Emotet-infected workstation.</p></div>' + '<div class="debrief-card"><h3>Evidence Summary</h3>' + evidenceHtml + '</div>',

          framework: '<div class="debrief-card"><h3>Alert Classification Methodology</h3><p><strong>True Positives</strong> — Unusual source IPs, impossible travel, off-hours activity, known-bad indicators, automated user agents (python-requests, curl), deviation from baseline behavior.</p><p><strong>False Positives</strong> — Scheduled vulnerability scans from known internal scanners, routine health checks, expected geographic access patterns, maintenance windows with documented change tickets.</p><p><strong>Misconfigured Rules</strong> — Alerts triggering on legitimate traffic because thresholds are too low, exclusions are missing, or rule logic does not account for normal operations (e.g., DLP alerting on scheduled cloud backups).</p></div>' + '<div class="debrief-card"><h3>False Positive Tuning</h3><p><strong>Vulnerability scanner exclusion:</strong> Add <code>vuln-scanner-01.meridian.local</code> to the port scan rule source exclusion list. Better: exclude by asset tag rather than hostname.</p><p><strong>DLP backup exclusion:</strong> Add <code>34.102.44.0/24</code> (cloud backup range) and process <code>db-backup-agent</code> to the DLP rule exclusion list.</p><p><strong>Brute force threshold:</strong> Current rule triggered at 847 attempts. Consider lowering to 50 attempts in 5 minutes for faster detection of real attacks.</p></div>',

          code: '<div class="debrief-section-title">Alert Classification Summary</div><div class="debrief-code"><span class="vuln">ALT-4821 [CRITICAL] Brute Force — TRUE POSITIVE\n  Source: 185.220.101.34 (Moscow) python-requests\n  Target: ceo, cfo, cto, admin accounts\n  Action: Block IP, reset passwords, enable MFA\n\nALT-4822 [HIGH] Port Scan — FALSE POSITIVE\n  Source: vuln-scanner-01 (scheduled weekly scan)\n  Action: Add scanner to exclusion list\n\nALT-4823 [MEDIUM] Impossible Travel — TRUE POSITIVE\n  User: sarah.martinez — NY then London in 4 min\n  Second device: curl (not browser)\n  Action: Reset password, revoke sessions\n\nALT-4824 [HIGH] Data Exfil — MISCONFIGURED RULE\n  Source: db-backup-agent to cloud provider\n  Action: Tune DLP rule to exclude backup traffic\n\nALT-4825 [LOW] DNS C2 Query — TRUE POSITIVE\n  Domain: update.microsofft-security.com (Emotet)\n  Action: Isolate workstation, investigate</span></div>',

          crossPerspective: {
            title: 'What the Attacker Did',
            description: 'From the attacker\'s perspective, the brute force was a blunt instrument — automated credential stuffing using a leaked password list. The real danger was the separate credential compromise (sarah.martinez) and the Emotet infection, which represent more sophisticated and stealthy attack vectors that could easily be missed in a noisy alert queue.',
            linkText: 'Try the Red Team Attack \u2192',
            linkHref: '/labs/red/brute-force/'
          }
        }
      });
    }

    var statusEl = document.getElementById('soc-mission-status');
    if (statusEl) {
      statusEl.textContent = '\u2713 Incident Resolved';
      statusEl.style.color = '#4ade80';
    }
  }
})();
</script>
