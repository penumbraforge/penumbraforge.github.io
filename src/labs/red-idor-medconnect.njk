---
layout: lab-workspace-v2.njk
permalink: /labs/red/idor-medconnect/
labCode: "RED-06"
labTitle: "IDOR — Patient Record Access"
labDifficulty: "beginner"
labDescription: "MedConnect's patient portal has no authorization on its API. Access other patients' records by changing the ID."
targetUrl: "https://lab-idor.penumbraforge.workers.dev"
targetHost: "medconnect.lab.penumbraforge.com"
workerUrl: "https://lab-idor.penumbraforge.workers.dev"
---

<!-- Mission Brief Content -->
<div class="ws-mission-header">Operation: Chart Breach</div>
<div class="ws-mission-narrative">
  MedConnect Health Systems has engaged your team to audit their patient portal API. You have been given a physician account (Dr. Sarah Chen) with access to one patient (ID 1001). The API authenticates users but may not authorize individual data requests.
  <br><br>
  Your objective: determine whether the API enforces authorization on patient record access, enumerate accessible records, and find the VIP patient with unmasked sensitive data.
</div>

<div class="ws-mission-goal">
  <div class="ws-mission-goal-label">Primary Objective</div>
  <div class="ws-mission-goal-text">Access another patient's medical records by changing the ID in the API request</div>
</div>

<div class="ws-mission-goal ws-mission-goal-bonus">
  <div class="ws-mission-goal-label">Bonus</div>
  <div class="ws-mission-goal-text">Find the VIP patient with unmasked PII data</div>
</div>

<div class="ws-mission-intel-section">
  <div class="ws-intel-item">
    <div class="ws-intel-label">Target</div>
    <div class="ws-intel-value">medconnect.lab.penumbraforge.com</div>
  </div>
  <div class="ws-intel-item">
    <div class="ws-intel-label">Scope</div>
    <div class="ws-intel-value">Patient API — /api/patient/:id</div>
  </div>
  <div class="ws-intel-item">
    <div class="ws-intel-label">Rules of Engagement</div>
    <div class="ws-intel-value">No DoS. No data modification. Read-only access testing.</div>
  </div>
</div>

<script>
(function() {
  'use strict';

  var Labs = window.PenumbraLabs;

  // NOTE: Red team procedural randomization (target app content, defenses,
  // response tokens) will be handled by Worker-side randomization in a
  // future update. The procedural engine is primarily for blue team
  // evidence corpora.
  var workerUrl = '{{ workerUrl }}';

  // ── Scenario Definition ──
  var scenario = {
    id: 'red-idor-medconnect',
    type: 'red',
    title: 'IDOR — Patient Record Access',
    difficulty: 'beginner',
    estimatedTime: 10,
    xpReward: 100,
    skills: ['access-control-idor'],
    unlocks: ['blue-investigate-medconnect'],
    optimalActions: 5,
    techniqueChecks: [
      { id: 'explored-own', check: function(log) { return log.some(function(a) { return a.type === 'terminal' && a.command === 'curl' && a.url && /\/api\/patient\/1001/.test(a.url); }); }, points: 25 },
      { id: 'used-repeater', check: function(log) { return log.some(function(a) { return a.type === 'repeater'; }); }, points: 25 },
      { id: 'enumerated-ids', check: function(log) { return log.some(function(a) { return a.type === 'iframe_message' && a.message && a.message.patientId && a.message.patientId !== '1001'; }); }, points: 25 },
      { id: 'found-vip', check: function(log) { return log.some(function(a) { return a.type === 'iframe_message' && a.message && a.message.isVip === true; }); }, points: 25 }
    ],

    stateGraph: {
      states: {
        'start':               { transitions: { 'recon': 'recon' } },
        'recon':               { transitions: { 'id_discovered': 'id_discovered' } },
        'id_discovered':       { transitions: { 'unauthorized_access': 'unauthorized_access' } },
        'unauthorized_access': { transitions: { 'sensitive_data': 'sensitive_data' } },
        'sensitive_data':      { transitions: { 'complete': 'complete' } },
        'complete':            { terminal: true }
      },
      initialState: 'start'
    },

    validationRules: {
      'recon': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'idor-result' && msg.patientId === '1001';
        }
      },
      'id_discovered': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'idor-result' && msg.patientId && msg.patientId !== '1001';
        }
      },
      'unauthorized_access': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'idor-result' && msg.unauthorized === true;
        }
      },
      'sensitive_data': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'idor-result' && (msg.isVip === true || msg.unmaskedPii === true);
        }
      },
      'complete': {
        trigger: 'auto',
        condition: function() { return true; }
      }
    },

    nudges: {
      'start': {
        delay: 90,
        text: 'Start by loading your assigned patient record (ID 1001). Look at the URL structure — the patient ID is right there in the path.'
      },
      'recon': {
        delay: 120,
        text: 'You can see patient 1001. The IDs are sequential integers. What happens if you change 1001 to 1002 or 1003?'
      },
      'id_discovered': {
        delay: 120,
        text: 'You accessed another patient\'s record without any authorization error. Try more IDs — can you find a VIP patient? Check IDs around 1005.'
      },
      'unauthorized_access': {
        delay: 90,
        text: 'Almost there. Try appending ?fields=all to the URL to request unmasked sensitive data like SSN.'
      }
    },

    objectives: [
      { id: 'recon', title: 'Reconnaissance' },
      { id: 'id_discovered', title: 'ID Enumeration' },
      { id: 'unauthorized_access', title: 'Unauthorized Access' },
      { id: 'sensitive_data', title: 'Sensitive Data Exposed' }
    ]
  };

  // ── Initialize Panel System ──
  Labs.PanelSystem.init({
    container: document.getElementById('workspace'),
    panels: [
      { id: 'panel-mission', minWidth: 220, defaultWidth: 280 },
      { id: 'panel-tools', flex: true },
      { id: 'panel-browser', minWidth: 320, defaultWidth: 480 }
    ]
  });

  // ── Initialize Simulation Engine ──
  var sim = Labs.Simulation.init({
    scenario: scenario,
    bridge: Labs.SimulationBridge,
    onStateChange: function(fromState, toState, action) {
      var obj = scenario.objectives.find(function(o) { return o.id === toState; }) ||
                scenario.objectives.find(function(o) { return o.id === fromState; });
      var label = obj ? obj.title : toState;
      Labs.Toast.show(label + ' — confirmed', 'success');

      updateDetection(toState);
      updateRequestCount();
      addIntel(toState, action);
    },
    onComplete: function() {
      var elapsed = Labs.Timer.stop();
      var scoringData = {
        actionsLog: sim.getActionsLog(),
        nudgesShown: sim._nudgeRef ? sim._nudgeRef._shownCount || 0 : 0,
        nudgesDismissed: sim._nudgeRef ? sim._nudgeRef._dismissCount || 0 : 0,
        evidenceFound: 4,
        totalEvidence: 4
      };
      var result = Labs.SimulationBridge.onLabComplete(scenario.id, scenario, elapsed, scoringData);
      showCompletion(result, elapsed);
    }
  });

  // ── Initialize Terminal ──
  Labs.Terminal.init({
    container: document.getElementById('tool-terminal'),
    workerUrl: workerUrl,
    onAction: function(action) {
      sim.dispatch(action);
      requestCount++;
      updateRequestCount();
    }
  });

  // ── Initialize Repeater ──
  Labs.Repeater.init({
    container: document.getElementById('tool-repeater'),
    workerUrl: workerUrl,
    onAction: function(action) {
      sim.dispatch(action);
      requestCount++;
      updateRequestCount();
    }
  });

  // ── Initialize Decoder & Notes ──
  Labs.Decoder.init({ container: document.getElementById('tool-decoder') });
  Labs.Notes.init({ container: document.getElementById('tool-notes'), labId: scenario.id });

  // ── Listen for iframe messages ──
  window.addEventListener('message', function(e) {
    if (!e.data || !e.data.type) return;

    if (e.data.type === 'idor-result') {
      sim.dispatch({ type: 'iframe_message', message: e.data });
    }

    if (e.data.type === 'medconnect-nav' && e.data.url) {
      var urlDisplay = document.getElementById('ws-url-display');
      if (urlDisplay) {
        var clean = e.data.url.replace(/^https?:\/\//, '');
        urlDisplay.value = clean;
      }
    }
  });

  // ── Start Timer ──
  Labs.Timer.start(function(elapsed) {
    var el = document.getElementById('lab-timer');
    if (el) el.textContent = Labs.Timer.format(elapsed);
  });

  // ── State helpers ──
  var requestCount = 0;

  function updateRequestCount() {
    var el = document.getElementById('ws-request-count');
    if (el) el.textContent = 'Requests: ' + requestCount;
  }

  function updateDetection(state) {
    var el = document.getElementById('ws-detection');
    if (!el) return;
    var labels = {
      'recon': '● Own Patient Record Loaded',
      'id_discovered': '● Patient IDs Enumerated',
      'unauthorized_access': '● Unauthorized Record Accessed',
      'sensitive_data': '● VIP PII Data Exposed',
      'complete': '● Full IDOR Exploitation'
    };
    el.textContent = labels[state] || '';
    el.style.color = state === 'complete' || state === 'sensitive_data' ? '#ef4444' : '#f59e0b';
  }

  function addIntel(state, action) {
    var panel = document.getElementById('intel-panel');
    if (!panel) return;

    var empty = panel.querySelector('.ws-mission-empty');
    if (empty) empty.remove();

    var intel = {
      'recon': { label: 'API Structure', value: 'GET /api/patient/:id returns patient record. IDs are sequential integers — easily guessable.' },
      'id_discovered': { label: 'ID Enumeration', value: 'Changing the patient ID in the URL returns different patients — no 403 Forbidden response' },
      'unauthorized_access': { label: 'No Authorization', value: 'API authenticates users but never checks if the user is authorized for the requested patient' },
      'sensitive_data': { label: 'VIP Data Exposed', value: 'VIP patient record found with unmasked SSN and full PII — ?fields=all bypasses data masking' }
    };

    var info = intel[state];
    if (!info) return;

    var div = document.createElement('div');
    div.className = 'ws-intel-item';
    div.innerHTML = '<div class="ws-intel-label">' + info.label + '</div>' +
                    '<div class="ws-intel-value">' + info.value + '</div>';
    panel.appendChild(div);
  }

  function showCompletion(result, elapsed) {
    document.getElementById('complete-time').textContent = Labs.Timer.format(elapsed);
    document.getElementById('complete-score').textContent = result.scoring ? result.scoring.composite : 100;
    document.getElementById('complete-xp').textContent = '+' + (result.scoring ? result.scoring.xp : result.xp);
    document.getElementById('complete-level').textContent = 'Level ' + result.level + ' — ' + Labs.Xp.titleForLevel(result.level);

    if (scenario.unlocks && scenario.unlocks.length > 0) {
      var unlockEl = document.getElementById('complete-unlock');
      if (unlockEl) {
        unlockEl.style.display = '';
        unlockEl.textContent = 'Blue Team Investigation →';
        unlockEl.href = '/labs/blue/investigate-medconnect/';
      }
    }

    document.getElementById('lab-complete-overlay').classList.add('visible');

    var debriefPanel = document.getElementById('debrief-panel');
    if (debriefPanel && Labs.Debrief) {
      debriefPanel.style.display = '';
      Labs.Debrief.render({
        container: debriefPanel,
        scoring: result.scoring,
        elapsed: elapsed,
        scenario: scenario,
        debriefContent: {
          analysis: '<div class="debrief-card"><h3>Vulnerability: CWE-639 — Authorization Bypass Through User-Controlled Key</h3><p>MedConnect\'s patient API uses the patient ID directly from the URL parameter to query the database. While the API requires authentication (it verifies you\'re logged in), it never checks authorization (it never verifies you\'re allowed to access that specific patient).</p><p>Any authenticated user — physician, nurse, billing clerk — can access any patient record by simply changing the ID. Sequential integer IDs make enumeration trivial. The <code>?fields=all</code> parameter exposes unmasked PII that should be protected by an additional access tier.</p></div>',

          framework: '<div class="debrief-card"><h3>MITRE ATT&CK Mapping</h3><p><strong>T1078</strong> — Valid Accounts: Attacker uses legitimate credentials to access unauthorized data</p><p><strong>T1530</strong> — Data from Cloud Storage Object: Enumeration and exfiltration of patient records</p></div><div class="debrief-card"><h3>OWASP Top 10</h3><p><strong>A01:2021</strong> — Broken Access Control: Missing server-side authorization on data access</p></div>',

          code: '<div class="debrief-section-title">Vulnerable Code</div><div class="debrief-code"><span class="vuln">router.get(\'/api/patient/:id\', (req, res) =&gt; {\n  const patient = db.getPatient(req.params.id);\n  // No authorization check!\n  return res.json(patient);\n});</span></div><div class="debrief-section-title" style="margin-top:16px;">The Fix</div><div class="debrief-code"><span class="fix">router.get(\'/api/patient/:id\', (req, res) =&gt; {\n  const patient = db.getPatient(req.params.id);\n  const allowed = db.getAssignedPatients(req.user.id);\n  if (!allowed.includes(patient.id)) {\n    return res.status(403).json({ error: \'Access denied\' });\n  }\n  return res.json(patient);\n});</span>\n// Also: use UUIDs, log access for audit trail</div>',

          crossPerspective: {
            title: 'What a Defender Sees',
            description: 'From the SOC\'s perspective, this attack appears as a single authenticated session making sequential API requests to patient records it was never assigned to. Access logs show a pattern: /api/patient/1001, /api/patient/1002, /api/patient/1003 — a clear enumeration pattern. In healthcare, this is a HIPAA breach that triggers mandatory notification. The defense: server-side authorization checks, access logging with anomaly detection, and UUIDs instead of sequential IDs.',
            linkText: 'Try the Blue Team Investigation →',
            linkHref: '/labs/blue/investigate-medconnect/'
          }
        }
      });
    }

    var statusEl = document.getElementById('ws-mission-status');
    if (statusEl) {
      statusEl.textContent = '✓ Mission Complete';
      statusEl.style.color = '#4ade80';
    }
  }
})();
</script>
