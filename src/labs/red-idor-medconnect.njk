      age: 56,
      gender: 'Female',
      bloodType: 'AB+',
      physician: 'Dr. Michael Torres',
      department: 'Oncology',
      diagnosis: 'Stage II Breast Cancer',
      admitDate: '2026-02-28',
      status: 'Active',
      ssn: '***-**-8843',
      ssnFull: '276-51-8843',
      insurance: 'Medicare Part B',
      medications: ['Tamoxifen 20mg — once daily', 'Ondansetron 8mg — as needed', 'Dexamethasone 4mg — with chemo'],
      notes: 'Completing third cycle of chemotherapy. Tumor response favorable on latest imaging. Tolerating treatment well.'
    },
    1005: {
      id: 1005,
      name: 'Robert J. Harrington III',
      dob: '1960-01-12',
      age: 66,
      gender: 'Male',
      bloodType: 'O-',
      physician: 'Dr. Catherine Wells',
      department: 'Executive Health',
      diagnosis: 'Coronary Artery Disease, Hypertension, Hyperlipidemia',
      admitDate: '2026-03-10',
      status: 'VIP — Active',
      ssn: '***-**-0001',
      ssnFull: '078-05-0001',
      insurance: 'Private — Harrington Trust',
      medications: ['Clopidogrel 75mg — once daily', 'Atorvastatin 80mg — once daily', 'Amlodipine 10mg — once daily', 'Aspirin 81mg — once daily'],
      notes: 'CEO of Harrington Capital Group. Three-vessel coronary disease. Drug-eluting stent placed LAD 2026-03-12. Recovery uneventful. Strictly confidential per hospital administration.',
      vip: true
    }
  };

  var LAB_CONFIG = {
    id: 'red-idor-medconnect',
    type: 'red',
    title: 'IDOR',
    target: 'MedConnect',
    difficulty: 'beginner',
    estimatedTime: 10,
    xpReward: 100,
    hintCost: [10, 25, 50],
    skills: ['access-control-idor'],
    unlocks: [],
    objectives: [
      { id: 'recon', step: 1, title: 'View assigned patient' },
      { id: 'access', step: 2, title: 'Access unauthorized record' },
      { id: 'vip', step: 3, title: 'Find VIP record' },
      { id: 'exfiltrate', step: 4, title: 'Access sensitive fields' },
    ],
  };

  var Engine = PenumbraLabs.Engine;
  var ServerLogs = PenumbraLabs.ServerLogs;

  Engine.init(LAB_CONFIG);
  ServerLogs.init('server-logs');
  ServerLogs.add('info', 'MedConnect Patient Portal started on port 443');
  ServerLogs.add('info', 'Database connected — 5 patient records loaded');
  ServerLogs.add('info', 'Auth: Dr. Sarah Chen authenticated — session mc_sess_dr_chen_7f2a');

  var httpReq = document.getElementById('http-req');
  var httpResp = document.getElementById('http-resp');
  var urlInput = document.getElementById('mc-url-input');
  var goBtn = document.getElementById('mc-go-btn');
  var appEl = document.getElementById('mc-app');
  var currentPatientId = null;
  var showAllFields = false;

  function parseUrl(url) {
    var idMatch = url.match(/\/api\/patient\/(\d+)/);
    var fieldsAll = /[?&]fields=all/i.test(url);
    return {
      patientId: idMatch ? parseInt(idMatch[1], 10) : null,
      fieldsAll: fieldsAll
    };
  }

  function renderPatient(patient, showSensitive) {
    var isAssigned = patient.assigned === true;
    var isVip = patient.vip === true;
    var alertHtml = '';

    if (isAssigned) {
      alertHtml = '<div class="mc-alert mc-alert-success">&#x2705; Authorized — Patient assigned to your care team</div>';
    } else {
      alertHtml = '<div class="mc-alert mc-alert-warn">&#x26a0; Notice — This patient is not assigned to your care team</div>';
    }

    if (isVip) {
      alertHtml += '<div class="mc-alert mc-alert-danger">&#x1f6e1; CONFIDENTIAL — VIP patient record. Access is logged and audited.</div>';
    }

    var ssnValue = showSensitive ? '<span class="mc-sensitive">' + patient.ssnFull + '</span>' : '<span class="mc-masked">' + patient.ssn + '</span>';

    var medsHtml = patient.medications.map(function(med) {
      return '<div class="mc-med-item"><div class="mc-med-dot"></div>' + escHtml(med) + '</div>';
    }).join('');

    var vipBadge = isVip ? ' <span class="mc-vip-badge">&#x2B50; VIP</span>' : '';
    var statusColor = isVip ? '#e8b84d' : '#4caf8c';

    return '<div class="mc-body">' +
      alertHtml +
      '<div class="mc-patient-card">' +
        '<div class="mc-patient-header">' +
          '<div><div class="mc-patient-name">' + escHtml(patient.name) + vipBadge + '</div></div>' +
          '<div class="mc-patient-id-badge">MRN #' + patient.id + '</div>' +
        '</div>' +
        '<div class="mc-patient-body">' +
          '<div class="mc-field-grid">' +
            '<div class="mc-field"><div class="mc-field-label">Date of Birth</div><div class="mc-field-value">' + patient.dob + ' (Age ' + patient.age + ')</div></div>' +
            '<div class="mc-field"><div class="mc-field-label">Gender</div><div class="mc-field-value">' + patient.gender + '</div></div>' +
            '<div class="mc-field"><div class="mc-field-label">Blood Type</div><div class="mc-field-value">' + patient.bloodType + '</div></div>' +
            '<div class="mc-field"><div class="mc-field-label">Status</div><div class="mc-field-value" style="color:' + statusColor + ';">' + patient.status + '</div></div>' +
            '<div class="mc-field"><div class="mc-field-label">Primary Physician</div><div class="mc-field-value">' + escHtml(patient.physician) + '</div></div>' +
            '<div class="mc-field"><div class="mc-field-label">Department</div><div class="mc-field-value">' + escHtml(patient.department) + '</div></div>' +
            '<div class="mc-field"><div class="mc-field-label">Insurance</div><div class="mc-field-value">' + escHtml(patient.insurance) + '</div></div>' +
            '<div class="mc-field"><div class="mc-field-label">Admit Date</div><div class="mc-field-value">' + patient.admitDate + '</div></div>' +
          '</div>' +

          '<div class="mc-section-label">Diagnosis</div>' +
          '<div class="mc-field"><div class="mc-field-value">' + escHtml(patient.diagnosis) + '</div></div>' +

          '<div class="mc-section-label">Social Security Number</div>' +
          '<div class="mc-field"><div class="mc-field-value">' + ssnValue + '</div></div>' +

          '<div class="mc-section-label">Current Medications</div>' +
          '<div class="mc-medications">' + medsHtml + '</div>' +

          '<div class="mc-section-label">Clinical Notes</div>' +
          '<div class="mc-field"><div class="mc-field-value" style="line-height:1.7;font-size:12px;">' + escHtml(patient.notes) + '</div></div>' +
        '</div>' +
      '</div>' +
    '</div>';
  }

  function renderNotFound(id) {
    return '<div class="mc-body">' +
      '<div class="mc-error-card">' +
        '<div class="mc-error-code">404</div>' +
        '<div class="mc-error-msg">Patient #' + id + ' not found in the database</div>' +
      '</div>' +
    '</div>';
  }

  function renderPortalChrome(bodyHtml) {
    return '<div class="mc-header">' +
      '<div class="mc-brand">' +
        '<div class="mc-logo">&#x2695;</div>' +
        '<div class="mc-brand-name">MedConnect</div>' +
      '</div>' +
      '<div class="mc-user-info">' +
        '<span>Dr. Sarah Chen</span>' +
        '<div class="mc-user-avatar">SC</div>' +
      '</div>' +
    '</div>' +
    bodyHtml;
  }

  function navigate(url) {
    var parsed = parseUrl(url);
    showAllFields = parsed.fieldsAll;

    if (!parsed.patientId) {
      appEl.innerHTML = renderPortalChrome('<div class="mc-body"><div class="mc-alert mc-alert-info">Enter a patient ID in the URL bar above. Example: /api/patient/1001</div></div>');
      return;
    }

    var pid = parsed.patientId;
    var patient = PATIENTS[pid];

    // Update HTTP inspector
    var reqPath = '/api/patient/' + pid + (showAllFields ? '?fields=all' : '');
    httpReq.innerHTML = '<span class="lab-http-method">GET</span> ' + escHtml(reqPath) + ' HTTP/1.1\n' +
      '<span class="lab-http-hname">Host:</span> <span class="lab-http-hval">portal.medconnect.health</span>\n' +
      '<span class="lab-http-hname">Authorization:</span> <span class="lab-http-hval">Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9</span>\n' +
      '<span class="lab-http-hname">Cookie:</span> <span class="lab-http-hval">session=mc_sess_dr_chen_7f2a</span>';

    if (patient) {
      httpResp.innerHTML = 'HTTP/1.1 <span class="lab-http-status">200 OK</span>\n' +
        '<span class="lab-http-hname">Content-Type:</span> <span class="lab-http-hval">application/json</span>\n' +
        '<span class="lab-http-hname">X-Powered-By:</span> <span class="lab-http-hval">Express</span>\n' +
        '<span class="lab-http-hname">X-Request-ID:</span> <span class="lab-http-hval">req_' + Math.random().toString(36).substr(2, 8) + '</span>';

      ServerLogs.add('info', 'GET /api/patient/' + pid + (showAllFields ? '?fields=all' : '') + ' — 200');

      appEl.innerHTML = renderPortalChrome(renderPatient(patient, showAllFields));
      currentPatientId = pid;

      // Objective: View assigned patient
      if (pid === 1001) {
        Engine.tryCompleteObjective('recon');
      }

      // Objective: Access unauthorized record
      if (pid !== 1001) {
        Engine.tryCompleteObjective('access');
        ServerLogs.add('warn', 'Access to patient ' + pid + ' by Dr. Chen — NOT in assigned patient list');
      }

      // Objective: Find VIP
      if (pid === 1005) {
        Engine.tryCompleteObjective('vip');
        ServerLogs.add('warn', 'VIP record accessed — patient ' + pid + ' (' + patient.name + ')');
      }

      // Objective: fields=all
      if (showAllFields) {
        Engine.tryCompleteObjective('exfiltrate');
        ServerLogs.add('err', 'Sensitive fields returned — SSN unmasked for patient ' + pid + ': ' + patient.ssnFull);
      }
    } else {
      httpResp.innerHTML = 'HTTP/1.1 <span class="lab-http-status" style="color:#eb5757;">404 Not Found</span>\n' +
        '<span class="lab-http-hname">Content-Type:</span> <span class="lab-http-hval">application/json</span>';

      ServerLogs.add('info', 'GET /api/patient/' + pid + ' — 404');
      appEl.innerHTML = renderPortalChrome(renderNotFound(pid));
    }
  }

  // URL bar navigation
  goBtn.addEventListener('click', function() {
    navigate(urlInput.value.trim());
  });

  urlInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') navigate(this.value.trim());
  });

  // Initial load — patient 1001
  navigate('/api/patient/1001');

  // Hint reveals
  document.querySelectorAll('.lab-hint').forEach(function(hint, idx) {
    hint.addEventListener('click', function() {
      if (!this.classList.contains('revealed')) {
        this.classList.add('revealed');
        Engine.revealHint(idx);
      }
    });
  });

  // Restore previous progress
  var progress = Engine.getProgress();
  progress.objectivesCompleted.forEach(function(objId) {
    var el = document.getElementById('obj-' + objId);
    if (el) {
      el.classList.remove('current');
      el.classList.add('completed');
      el.querySelector('.lab-obj-check').textContent = '\u2713';
    }
  });

  var foundCurrent = false;
  LAB_CONFIG.objectives.forEach(function(obj) {
    var el = document.getElementById('obj-' + obj.id);
    if (!el) return;
    if (progress.objectivesCompleted.indexOf(obj.id) === -1 && !foundCurrent) {
      el.classList.add('current');
      foundCurrent = true;
    }
  });

  progress.hintsUsed.forEach(function(idx) {
    var hint = document.getElementById('hint-' + idx);
    if (hint) hint.classList.add('revealed');
  });

  function escHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
})();
</script>
