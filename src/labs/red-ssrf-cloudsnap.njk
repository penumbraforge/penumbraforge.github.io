layout: lab-workspace-v2.njk
permalink: /labs/red/ssrf-cloudsnap/
labCode: "RED-03"
labTitle: "SSRF — Cloud Metadata Theft"
labDifficulty: "intermediate"
labDescription: "CloudSnap's URL import fetches user-provided URLs server-side. Access internal services and steal cloud credentials."
targetUrl: "https://lab-ssrf.penumbraforge.workers.dev"
targetHost: "cloudsnap.lab.penumbraforge.com"
workerUrl: "https://lab-ssrf.penumbraforge.workers.dev"
---

<!-- Mission Brief Content -->
<div class="ws-mission-header">Operation: Cloud Hopper</div>
<div class="ws-mission-narrative">
  CloudSnap is a photo-sharing platform that lets users import images by URL. Their infrastructure runs on AWS EC2 instances with IAM roles attached. A security audit flagged the import endpoint as potentially vulnerable to server-side request forgery.
  <br><br>
  Your objective: confirm that the server-side fetch can be abused to reach internal services, then pivot to the cloud metadata endpoint and steal IAM credentials.
</div>

<div class="ws-mission-goal">
  <div class="ws-mission-goal-label">Primary Objective</div>
  <div class="ws-mission-goal-text">Access the AWS metadata endpoint (169.254.169.254) and steal IAM credentials via the import feature</div>
</div>

<div class="ws-mission-goal ws-mission-goal-bonus">
  <div class="ws-mission-goal-label">Bonus</div>
  <div class="ws-mission-goal-text">Access the internal admin panel at localhost/admin</div>
</div>

<div class="ws-mission-intel-section">
  <div class="ws-intel-item">
    <div class="ws-intel-label">Target</div>
    <div class="ws-intel-value">cloudsnap.lab.penumbraforge.com</div>
  </div>
  <div class="ws-intel-item">
    <div class="ws-intel-label">Scope</div>
    <div class="ws-intel-value">URL import endpoint — /import</div>
  </div>
  <div class="ws-intel-item">
    <div class="ws-intel-label">Rules of Engagement</div>
    <div class="ws-intel-value">No DoS. Read-only access. Do not modify internal services.</div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  'use strict';

  var Labs = window.PenumbraLabs;

  // NOTE: Red team procedural randomization (target app content, defenses,
  // response tokens) will be handled by Worker-side randomization in a
  // future update. The procedural engine is primarily for blue team
  // evidence corpora.
  var workerUrl = '{{ workerUrl }}';

  // ── Scenario Definition ──
  var scenario = {
    id: 'red-ssrf-cloudsnap',
    type: 'red',
    title: 'SSRF — Cloud Metadata Theft',
    difficulty: 'intermediate',
    estimatedTime: 15,
    xpReward: 150,
    skills: ['ssrf-cloud-metadata'],
    unlocks: ['blue-investigate-cloudsnap'],
    optimalActions: 7,
    techniqueChecks: [
      { id: 'tested-import', check: function(log) { return log.some(function(a) { return a.type === 'terminal' && a.command === 'curl' && a.url && a.url.indexOf('/import') !== -1; }); }, points: 25 },
      { id: 'used-repeater', check: function(log) { return log.some(function(a) { return a.type === 'repeater'; }); }, points: 25 },
      { id: 'reached-metadata', check: function(log) { return log.some(function(a) { return a.type === 'iframe_message' && a.message && a.message.hasMetadata; }); }, points: 25 },
      { id: 'stole-credentials', check: function(log) { return log.some(function(a) { return a.type === 'iframe_message' && a.message && a.message.hasCredentials; }); }, points: 25 }
    ],

    stateGraph: {
      states: {
        'start':              { transitions: { 'recon': 'recon' } },
        'recon':              { transitions: { 'ssrf_confirmed': 'ssrf_confirmed' } },
        'ssrf_confirmed':     { transitions: { 'metadata_accessed': 'metadata_accessed' } },
        'metadata_accessed':  { transitions: { 'credentials_stolen': 'credentials_stolen' } },
        'credentials_stolen': { transitions: { 'complete': 'complete' } },
        'complete':           { terminal: true }
      },
      initialState: 'start'
    },

    validationRules: {
      'recon': {
        trigger: 'terminal_or_repeater',
        condition: function(action) {
          return action.response && action.response.status === 200 &&
                 action.url && action.url.indexOf('/import') !== -1;
        }
      },
      'ssrf_confirmed': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'ssrf-result' && msg.isInternal === true;
        }
      },
      'metadata_accessed': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'ssrf-result' && msg.hasMetadata === true;
        }
      },
      'credentials_stolen': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'ssrf-result' && msg.hasCredentials === true;
        }
      },
      'complete': {
        trigger: 'auto',
        condition: function() { return true; }
      }
    },

    nudges: {
      'start': {
        delay: 90,
        text: 'Try importing an external image URL. The server fetches whatever URL you provide — what internal endpoints could the server reach?'
      },
      'recon': {
        delay: 120,
        text: 'The import works. Now try pointing the URL at an internal address like http://localhost or http://127.0.0.1. Does the server follow it?'
      },
      'ssrf_confirmed': {
        delay: 120,
        text: 'Internal access confirmed. AWS metadata lives at http://169.254.169.254/. Try reaching the IAM credentials endpoint.'
      },
      'metadata_accessed': {
        delay: 90,
        text: 'You reached the metadata service. Navigate deeper to /latest/meta-data/iam/security-credentials/ to extract the actual IAM keys.'
      }
    },

    objectives: [
      { id: 'recon', title: 'Reconnaissance' },
      { id: 'ssrf_confirmed', title: 'SSRF Confirmed' },
      { id: 'metadata_accessed', title: 'Metadata Accessed' },
      { id: 'credentials_stolen', title: 'Credentials Stolen' }
    ]
  };

  // ── Initialize Panel System ──
  Labs.PanelSystem.init({
    container: document.getElementById('workspace'),
    panels: [
      { id: 'panel-mission', minWidth: 200, defaultWidth: 240 },
      { id: 'panel-tools', flex: true },
      { id: 'panel-browser', minWidth: 400, defaultWidth: 600 }
    ]
  });

  // ── Initialize Simulation Engine ──
  var sim = Labs.Simulation.init({
    scenario: scenario,
    bridge: Labs.SimulationBridge,
    onStateChange: function(fromState, toState, action) {
      var obj = scenario.objectives.find(function(o) { return o.id === toState; }) ||
                scenario.objectives.find(function(o) { return o.id === fromState; });
      var label = obj ? obj.title : toState;
      Labs.Toast.show(label + ' — confirmed', 'success');

      updateDetection(toState);
      updateRequestCount();
      addIntel(toState, action);
    },
    onComplete: function() {
      var elapsed = Labs.Timer.stop();
      var scoringData = {
        actionsLog: sim.getActionsLog(),
        nudgesShown: sim._nudgeRef ? sim._nudgeRef._shownCount || 0 : 0,
        nudgesDismissed: sim._nudgeRef ? sim._nudgeRef._dismissCount || 0 : 0,
        evidenceFound: 4,
        totalEvidence: 4
      };
      var result = Labs.SimulationBridge.onLabComplete(scenario.id, scenario, elapsed, scoringData);
      showCompletion(result, elapsed);
    }
  });

  // ── Initialize Terminal ──
  Labs.Terminal.init({
    container: document.getElementById('tool-terminal'),
    workerUrl: workerUrl,
    onAction: function(action) {
      sim.dispatch(action);
      requestCount++;
      updateRequestCount();
    }
  });

  // ── Initialize Repeater ──
  Labs.Repeater.init({
    container: document.getElementById('tool-repeater'),
    workerUrl: workerUrl,
    onAction: function(action) {
      sim.dispatch(action);
      requestCount++;
      updateRequestCount();
    }
  });

  // ── Initialize Decoder & Notes ──
  Labs.Decoder.init({ container: document.getElementById('tool-decoder') });
  Labs.Notes.init({ container: document.getElementById('tool-notes'), labId: scenario.id });

  // ── Listen for iframe messages ──
  window.addEventListener('message', function(e) {
    if (!e.data || !e.data.type) return;

    if (e.data.type === 'ssrf-result') {
      sim.dispatch({ type: 'iframe_message', message: e.data });
    }

    if (e.data.type === 'cloudsnap-nav' && e.data.url) {
      var urlDisplay = document.getElementById('ws-url-display');
      if (urlDisplay) {
        var clean = e.data.url.replace(/^https?:\/\//, '');
        urlDisplay.value = clean;
      }
    }
  });

  // ── Start Timer ──
  Labs.Timer.start(function(elapsed) {
    var el = document.getElementById('lab-timer');
    if (el) el.textContent = Labs.Timer.format(elapsed);
  });

  // ── State helpers ──
  var requestCount = 0;

  function updateRequestCount() {
    var el = document.getElementById('ws-request-count');
    if (el) el.textContent = 'Requests: ' + requestCount;
  }

  function updateDetection(state) {
    var el = document.getElementById('ws-detection');
    if (!el) return;
    var labels = {
      'recon': '● Import Endpoint Probed',
      'ssrf_confirmed': '● Internal Access Confirmed',
      'metadata_accessed': '● Metadata Endpoint Reached',
      'credentials_stolen': '● IAM Credentials Stolen',
      'complete': '● Cloud Account Compromised'
    };
    el.textContent = labels[state] || '';
    el.style.color = state === 'complete' || state === 'credentials_stolen' ? '#ef4444' : '#f59e0b';
  }

  function addIntel(state, action) {
    var panel = document.getElementById('intel-panel');
    if (!panel) return;

    var empty = panel.querySelector('.ws-mission-empty');
    if (empty) empty.remove();

    var intel = {
      'recon': { label: 'URL Import Active', value: 'Server fetches arbitrary URLs via POST /import — no URL validation observed' },
      'ssrf_confirmed': { label: 'SSRF Confirmed', value: 'Server followed request to internal address — localhost/127.0.0.1 accessible' },
      'metadata_accessed': { label: 'Metadata Reached', value: '169.254.169.254 responded — cloud instance metadata service is accessible via SSRF' },
      'credentials_stolen': { label: 'Credentials Stolen', value: 'IAM role credentials extracted: AccessKeyId AKIA***, SecretAccessKey, and session Token' }
    };

    var info = intel[state];
    if (!info) return;

    var div = document.createElement('div');
    div.className = 'ws-intel-item';
    div.innerHTML = '<div class="ws-intel-label">' + info.label + '</div>' +
                    '<div class="ws-intel-value">' + info.value + '</div>';
    panel.appendChild(div);
  }

  function showCompletion(result, elapsed) {
    document.getElementById('complete-time').textContent = Labs.Timer.format(elapsed);
    document.getElementById('complete-score').textContent = result.scoring ? result.scoring.composite : 100;
    document.getElementById('complete-xp').textContent = '+' + (result.scoring ? result.scoring.xp : result.xp);
    document.getElementById('complete-level').textContent = 'Level ' + result.level + ' — ' + Labs.Xp.titleForLevel(result.level);

    if (scenario.unlocks && scenario.unlocks.length > 0) {
      var unlockEl = document.getElementById('complete-unlock');
      if (unlockEl) {
        unlockEl.style.display = '';
        unlockEl.textContent = 'Blue Team Investigation →';
        unlockEl.href = '/labs/blue/investigate-cloudsnap/';
      }
    }

    document.getElementById('lab-complete-overlay').classList.add('visible');

    var debriefPanel = document.getElementById('debrief-panel');
    if (debriefPanel && Labs.Debrief) {
      debriefPanel.style.display = '';
      Labs.Debrief.render({
        container: debriefPanel,
        scoring: result.scoring,
        elapsed: elapsed,
        scenario: scenario,
        debriefContent: {
          analysis: '<div class="debrief-card"><h3>Vulnerability: CWE-918 — Server-Side Request Forgery</h3><p>CloudSnap\'s URL import feature accepts any URL and fetches it server-side using <code>fetch()</code> without validation. Because the request originates from the server — not the user\'s browser — it can reach internal services, cloud metadata endpoints, and other resources not exposed to the internet.</p><p>The stolen IAM credentials grant the attacker direct access to cloud resources (S3 buckets, databases, secrets managers) without needing to compromise the application further.</p></div>',

          framework: '<div class="debrief-card"><h3>MITRE ATT&CK Mapping</h3><p><strong>T1190</strong> — Exploit Public-Facing Application: SSRF via URL import feature</p><p><strong>T1552.005</strong> — Cloud Instance Metadata API: Credential theft from 169.254.169.254</p><p><strong>T1078.004</strong> — Cloud Accounts: Lateral movement using stolen IAM credentials</p></div><div class="debrief-card"><h3>OWASP Top 10</h3><p><strong>A10:2021</strong> — Server-Side Request Forgery: Unvalidated server-side URL fetch</p></div>',

          code: '<div class="debrief-section-title">Vulnerable Code</div><div class="debrief-code"><span class="vuln">const response = await fetch(userUrl);</span>\n// userUrl comes directly from request body\n// No URL validation, no allowlist, no IP blocking</div><div class="debrief-section-title" style="margin-top:16px;">The Fix</div><div class="debrief-code"><span class="fix">const parsed = new URL(userUrl);\nif (!allowedHosts.includes(parsed.hostname)) {\n  return res.status(403).json({ error: \'Host not allowed\' });\n}\nconst ip = await dns.resolve(parsed.hostname);\nif (isPrivateIp(ip)) {\n  return res.status(403).json({ error: \'Internal blocked\' });\n}</span>\n// Also: disable redirects, enforce IMDSv2 on AWS</div>',

          crossPerspective: {
            title: 'What a Defender Sees',
            description: 'From the SOC\'s perspective, this attack generates outbound requests from the application server to the metadata endpoint (169.254.169.254) — an address that should never appear in application logs. VPC flow logs show internal traffic from the web tier to the metadata service, and CloudTrail reveals API calls using temporary credentials from an unexpected source IP. The defense: IMDSv2, URL allowlists, and egress filtering.',
            linkText: 'Try the Blue Team Investigation →',
            linkHref: '/labs/blue/investigate-cloudsnap/'
          }
        }
      });
    }

    var statusEl = document.getElementById('ws-mission-status');
    if (statusEl) {
      statusEl.textContent = '✓ Mission Complete';
      statusEl.style.color = '#4ade80';
    }
  }
});
</script>
