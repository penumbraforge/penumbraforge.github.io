<script>
(function() {
  var LAB_CONFIG = {
    id: 'red-ssrf-cloudsnap',
    type: 'red',
    title: 'SSRF',
    target: 'CloudSnap',
    difficulty: 'intermediate',
    estimatedTime: 15,
    xpReward: 150,
    hintCost: [10, 25, 50],
    skills: ['ssrf-cloud-metadata'],
    unlocks: ['blue-investigate-cloudsnap'],
    objectives: [
      { id: 'recon', step: 1, title: 'Reconnaissance' },
      { id: 'discover', step: 2, title: 'Internal Access' },
      { id: 'metadata', step: 3, title: 'Metadata Endpoint' },
      { id: 'credentials', step: 4, title: 'Credential Theft' },
    ],
  };

  var Engine = PenumbraLabs.Engine;
  var ServerLogs = PenumbraLabs.ServerLogs;

  Engine.init(LAB_CONFIG);
  ServerLogs.init('server-logs');
  ServerLogs.add('info', 'CloudSnap application server started on port 3000');
  ServerLogs.add('info', 'Image import service ready — accepting URLs');

  var iframe = document.getElementById('lab-target');
  var httpReq = document.getElementById('http-req');
  var httpResp = document.getElementById('http-resp');

  /* Listen for postMessage from the lab iframe */
  window.addEventListener('message', function(event) {
    var data;
    try {
      data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
    } catch(e) { return; }

    if (!data || data.type !== 'ssrf-result') return;

    var url = data.url || '';
    var isInternal = data.isInternal || false;
    var hasCredentials = data.hasCredentials || false;
    var hasMetadata = data.hasMetadata || false;
    var statusCode = data.statusCode || 200;

    /* Update HTTP inspector */
    httpReq.innerHTML = '<span class="lab-http-method">POST</span> /import HTTP/1.1\n' +
      '<span class="lab-http-hname">Host:</span> <span class="lab-http-hval">cloudsnap.io</span>\n' +
      '<span class="lab-http-hname">Content-Type:</span> <span class="lab-http-hval">application/json</span>\n\n' +
      '{ <span class="lab-http-hname">"url":</span> <span class="lab-http-hval">"' + escHtml(url).substring(0, 80) + '"</span> }';

    httpResp.innerHTML = 'HTTP/1.1 <span class="lab-http-status">' + statusCode + ' OK</span>\n' +
      '<span class="lab-http-hname">Content-Type:</span> <span class="lab-http-hval">application/json</span>\n\n' +
      '<span class="lab-http-hval">' + escHtml(JSON.stringify(data.body || {}).substring(0, 200)) + '</span>';

    ServerLogs.add('info', 'POST /import — fetching ' + url.substring(0, 50));

    /* Objective 1: Recon — any URL import */
    Engine.tryCompleteObjective('recon');

    /* Objective 2: Discover — internal URL (localhost, 127.0.0.1) */
    if (isInternal) {
      Engine.tryCompleteObjective('discover');
      ServerLogs.add('warn', 'Server-side fetch targeted internal address: ' + url.substring(0, 50));
    }

    /* Objective 3: Metadata — accessed metadata endpoint */
    if (hasMetadata) {
      Engine.tryCompleteObjective('metadata');
      ServerLogs.add('err', 'Internal metadata endpoint accessed via SSRF');
    }

    /* Objective 4: Credentials — extracted IAM credentials */
    if (hasCredentials) {
      setTimeout(function() {
        Engine.tryCompleteObjective('credentials');
        ServerLogs.add('critical', 'IAM credentials extracted — AccessKeyId: AKIA****************');
      }, 500);
    }
  });

  /* Hint reveals */
  document.querySelectorAll('.lab-hint').forEach(function(hint, idx) {
    hint.addEventListener('click', function() {
      if (!this.classList.contains('revealed')) {
        this.classList.add('revealed');
        Engine.revealHint(idx);
      }
    });
  });

  /* Restore previous progress */
  var progress = Engine.getProgress();
  progress.objectivesCompleted.forEach(function(objId) {
    var el = document.getElementById('obj-' + objId);
    if (el) {
      el.classList.remove('current');
      el.classList.add('completed');
      el.querySelector('.lab-obj-check').textContent = '\u2713';
    }
  });

  /* Mark current objective */
  var foundCurrent = false;
  LAB_CONFIG.objectives.forEach(function(obj) {
    var el = document.getElementById('obj-' + obj.id);
    if (!el) return;
    if (progress.objectivesCompleted.indexOf(obj.id) === -1 && !foundCurrent) {
      el.classList.add('current');
      foundCurrent = true;
    }
  });

  /* Restore revealed hints */
  progress.hintsUsed.forEach(function(idx) {
    var hint = document.getElementById('hint-' + idx);
    if (hint) hint.classList.add('revealed');
  });

  function escHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
})();
</script>
