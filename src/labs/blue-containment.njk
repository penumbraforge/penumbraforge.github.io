    objectives: [
      { id: 'patient-zero', step: 1, title: 'Identify patient zero' },
      { id: 'lateral', step: 2, title: 'Trace lateral movement' },
      { id: 'staging', step: 3, title: 'Stop the staging server' },
      { id: 'verify', step: 4, title: 'Verify containment' },
    ],
  };

  Engine.init(LAB_CONFIG);

  // Countdown timer (cosmetic)
  var countdownSeconds = 600;
  var countdownEl = document.getElementById('countdown-timer');
  var countdownInterval = setInterval(function() {
    countdownSeconds--;
    if (countdownSeconds <= 0) {
      countdownSeconds = 0;
      clearInterval(countdownInterval);
    }
    var m = Math.floor(countdownSeconds / 60);
    var s = countdownSeconds % 60;
    countdownEl.textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
    if (countdownSeconds <= 120) {
      countdownEl.style.color = '#eb5757';
      countdownEl.style.fontWeight = '500';
    }
  }, 1000);

  // Render host grid
  function renderGrid() {
    var grid = document.getElementById('host-grid');
    var html = '<div class="host-grid">';

    HOSTS.forEach(function(host, i) {
      var isIsolated = isolatedHosts[host.id];
      var statusClass = isIsolated ? 'status-isolated' : (host.infected ? 'status-infected' : 'status-clean');
      var dotClass = isIsolated ? 'dot-isolated' : (host.infected ? 'dot-infected' : 'dot-clean');
      var badgeClass = isIsolated ? 'badge-isolated' : (host.infected ? 'badge-infected' : 'badge-online');
      var badgeText = isIsolated ? 'ISOLATED' : (host.infected ? 'SUSPICIOUS' : 'ONLINE');

      html += '<div class="host-card ' + statusClass + '" id="card-' + host.id + '">' +
        '<div class="host-card-header" onclick="toggleHost(\'' + host.id + '\')">' +
          '<div class="host-status-dot ' + dotClass + '"></div>' +
          '<div class="host-info">' +
            '<div class="host-name">' + host.hostname + '</div>' +
            '<div class="host-meta">' +
              '<span class="host-ip">' + host.ip + '</span>' +
              '<span class="host-os-badge os-' + host.osClass + '">' + host.os + '</span>' +
            '</div>' +
          '</div>' +
          '<span class="host-status-badge ' + badgeClass + '">' + badgeText + '</span>' +
          '<span class="host-expand-icon">&#x203a;</span>' +
        '</div>' +
        '<div class="host-card-details">' +
          '<div class="host-detail-label">Running Processes</div>' +
          '<div class="host-process-list">';

      host.processes.forEach(function(proc) {
        html += '<div>' + proc + '</div>';
      });

      html += '</div>' +
          '<div class="host-detail-label">Active Network Connections</div>' +
          '<div class="host-conn-list">';

      host.connections.forEach(function(conn) {
        html += '<div class="' + (conn.suspicious ? 'conn-suspicious' : 'conn-normal') + '">' + conn.text + '</div>';
      });

      html += '</div>';

      if (!isIsolated) {
        html += '<button class="host-isolate-btn" onclick="event.stopPropagation();isolateHost(\'' + host.id + '\')">Isolate Host</button>';
      } else {
        html += '<button class="host-isolate-btn isolated">Isolated</button>';
      }

      html += '</div></div>';
    });

    html += '</div>';

    // Status log
    html += '<div class="status-log-container">' +
      '<div class="status-log-label">Containment Actions</div>' +
      '<div class="status-log" id="status-log">';

    if (statusLogEntries.length === 0) {
      html += '<div style="color:var(--muted);padding:8px 0;">No actions taken yet. Expand hosts to investigate, then isolate infected systems.</div>';
    } else {
      statusLogEntries.forEach(function(entry) {
        html += '<div class="status-log-entry">' +
          '<span class="slog-time">' + entry.time + '</span>' +
          '<span class="slog-msg ' + (entry.type || '') + '">' + entry.msg + '</span>' +
        '</div>';
      });
    }

    html += '</div></div>';
    grid.innerHTML = html;
  }

  // Toggle host card expansion
  window.toggleHost = function(hostId) {
    var card = document.getElementById('card-' + hostId);
    card.classList.toggle('expanded');
  };

  // Isolate host
  window.isolateHost = function(hostId) {
    if (isolatedHosts[hostId]) return;

    var host = HOSTS.find(function(h) { return h.id === hostId; });
    if (!host) return;

    var elapsed = PenumbraLabs.Timer.getElapsed();
    var time = PenumbraLabs.Timer.format(elapsed);

    if (!host.infected) {
      // False positive — isolating a clean host
      errorCount++;
      document.getElementById('errors-count').textContent = errorCount;

      statusLogEntries.push({
        time: time,
        msg: 'FALSE POSITIVE: ' + host.hostname + ' (' + host.ip + ') is clean. Isolating production hosts unnecessarily causes outages.',
        type: 'slog-error'
      });

      Toast.show('False positive! ' + host.hostname + ' is clean. Isolating production hosts unnecessarily causes outages.', 'error');
      addEvidence('ERROR: Attempted to isolate clean host ' + host.hostname + ' (' + host.ip + ')');
      renderGrid();
      return;
    }

    // Valid isolation
    isolatedHosts[hostId] = true;

    statusLogEntries.push({
      time: time,
      msg: 'ISOLATED: ' + host.hostname + ' (' + host.ip + ') — Network access revoked, host quarantined.',
      type: 'slog-success'
    });

    addEvidence('Isolated infected host: ' + host.hostname + ' (' + host.ip + ') — ' + host.role);
    Toast.show(host.hostname + ' isolated successfully', 'success');

    // Complete the relevant objective
    if (host.objectiveId) {
      Engine.tryCompleteObjective(host.objectiveId);
    }

    // Update counts
    updateCounts();
    renderGrid();

    // Check if all infected hosts are isolated
    var allContained = infectedIds.every(function(id) { return isolatedHosts[id]; });
    if (allContained) {
      statusLogEntries.push({
        time: PenumbraLabs.Timer.format(PenumbraLabs.Timer.getElapsed()),
        msg: 'CONTAINMENT COMPLETE: All infected hosts isolated. Domain controller is safe.',
        type: 'slog-success'
      });

      // Build the containment summary for debrief
      var summaryHtml = '<div style="display:flex;align-items:center;gap:20px;margin-bottom:20px;padding:20px;border-radius:10px;border:1px solid var(--border);background:var(--surface-1);">' +
        '<div style="font-family:var(--font-display);font-size:42px;color:var(--sage);">Contained</div>' +
        '<div style="flex:1;">' +
          '<div style="font-family:var(--font-display);font-size:16px;color:var(--text-1);margin-bottom:4px;">' + (errorCount === 0 ? 'Perfect containment — no false positives' : errorCount + ' false positive' + (errorCount > 1 ? 's' : '') + ' during containment') + '</div>' +
          '<div style="font-size:12px;color:var(--text-3);">3 infected hosts isolated, domain controller protected</div>' +
        '</div>' +
      '</div>';

      summaryHtml += '<div style="font-size:13px;color:var(--text-2);line-height:1.7;">';
      summaryHtml += '<p><strong>Attack path contained:</strong></p>';
      summaryHtml += '<div style="font-family:var(--font-mono);font-size:11px;color:var(--text-2);padding:12px;background:var(--surface-0);border-radius:8px;border:1px solid var(--border);margin:8px 0 16px;line-height:2;">';
      summaryHtml += 'WS-MKT-042 (patient zero)<br>';
      summaryHtml += '&nbsp;&nbsp;&nbsp;&#x2514;&#x2500;&#x2500; SMB &#x2500;&#x2500;> WS-FIN-017 (lateral movement)<br>';
      summaryHtml += '&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#x2514;&#x2500;&#x2500; SMB &#x2500;&#x2500;> SRV-FILE-01 (staging)<br>';
      summaryHtml += '&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#x2514;&#x2500;&#x2500; SMB &#x2500;&#x2500;> SRV-DC-01 (BLOCKED)';
      summaryHtml += '</div>';
      summaryHtml += '</div>';

      document.getElementById('containment-summary').innerHTML = summaryHtml;

      // Complete the verify objective
      Engine.tryCompleteObjective('verify');

      renderGrid();

      // Show debrief after a brief delay
      setTimeout(function() {
        document.getElementById('host-grid-container').style.display = 'none';
        document.getElementById('siem-header').style.display = 'none';
        var debrief = document.getElementById('blue-debrief');
        debrief.classList.add('visible');
        debrief.style.flex = '1';
        debrief.style.overflowY = 'auto';
        clearInterval(countdownInterval);
      }, 1500);
    }
  };

  function updateCounts() {
    var isolatedN = Object.keys(isolatedHosts).length;
    var infectedN = infectedIds.length;
    var cleanN = HOSTS.length - infectedN;

    document.getElementById('infected-count').textContent = infectedN - isolatedN;
    document.getElementById('isolated-count').textContent = isolatedN;
    document.getElementById('clean-count').textContent = cleanN;
    document.getElementById('progress-fill').style.width = (isolatedN / infectedN * 100) + '%';
    document.getElementById('progress-pct').textContent = isolatedN + '/' + infectedN + ' contained';
    document.getElementById('hosts-online').textContent = (HOSTS.length - isolatedN) + ' online';
  }

  function addEvidence(text) {
    var log = document.getElementById('evidence-log');
    if (log.querySelector('.evidence-empty')) log.innerHTML = '';
    var elapsed = PenumbraLabs.Timer.getElapsed();
    var time = PenumbraLabs.Timer.format(elapsed);
    log.innerHTML += '<div class="evidence-item"><div class="evidence-item-time">' + time + '</div><div class="evidence-item-text">' + text + '</div></div>';
  }

  // Initial render
  renderGrid();
  updateCounts();
})();
</script>