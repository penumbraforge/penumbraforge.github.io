<div class="soc-case-header">INC-2024-1187</div>
<div class="soc-case-id">Active Ransomware Incident</div>
<div class="soc-case-narrative">
  CRITICAL: Your EDR platform has flagged active lateral movement across the corporate network. Ransomware has been detected on at least one workstation. Telemetry shows it spreading via SMB and credential harvesting. The domain controller is the attacker's ultimate target.
  <br><br>
  Investigate in real-time. Identify the initial access vector, trace the lateral movement chain, and make containment decisions before the ransomware reaches the domain controller and encrypts the entire environment.
</div>

<div class="soc-case-goal">
  <div class="soc-case-goal-label">Objective 1</div>
  <div class="soc-case-goal-text">Identify the initial access vector (patient zero)</div>
</div>
<div class="soc-case-goal">
  <div class="soc-case-goal-label">Objective 2</div>
  <div class="soc-case-goal-text">Trace the lateral movement path across the network</div>
</div>
<div class="soc-case-goal">
  <div class="soc-case-goal-label">Objective 3</div>
  <div class="soc-case-goal-text">Contain the spread and preserve evidence for forensics</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  'use strict';

  var Labs = window.PenumbraLabs;

  // ── Scenario Definition ──
  var scenario = {
    id: 'blue-containment',
    type: 'blue',
    title: 'Active Containment',
    difficulty: 'advanced',
    estimatedTime: 30,
    xpReward: 350,
    skills: ['containment-lateral-movement', 'containment-host-isolation', 'investigation-ransomware'],
    unlocks: [],
    optimalActions: 16,
    techniqueChecks: [
      { id: 'searched-siem', check: function(log) { return log.some(function(a) { return a.type === 'siem_action'; }); }, points: 20 },
      { id: 'pivoted-ip', check: function(log) { return log.some(function(a) { return a.type === 'siem_action' && a.action === 'pivot'; }); }, points: 20 },
      { id: 'used-ioc', check: function(log) { return log.some(function(a) { return a.type === 'ioc_lookup'; }); }, points: 20 },
      { id: 'built-timeline', check: function(log) { return log.some(function(a) { return a.type === 'timeline_action'; }); }, points: 20 },
      { id: 'submitted-containment', check: function(log) { return log.some(function(a) { return a.type === 'containment_action'; }); }, points: 20 }
    ],

    stateGraph: {
      states: {
        'start': { transitions: {
          'found_initial_access': 'initial_access_found',
          'found_lateral': 'lateral_found',
          'found_privesc': 'privesc_found'
        }},
        'initial_access_found': { transitions: {
          'found_lateral': 'multiple_evidence',
          'found_privesc': 'multiple_evidence',
          'found_encryption': 'multiple_evidence'
        }},
        'lateral_found': { transitions: {
          'found_initial_access': 'multiple_evidence',
          'found_privesc': 'multiple_evidence',
          'found_encryption': 'multiple_evidence'
        }},
        'privesc_found': { transitions: {
          'found_initial_access': 'multiple_evidence',
          'found_lateral': 'multiple_evidence',
          'found_encryption': 'multiple_evidence'
        }},
        'multiple_evidence': { transitions: {
          'found_initial_access': 'multiple_evidence',
          'found_lateral': 'multiple_evidence',
          'found_privesc': 'multiple_evidence',
          'found_encryption': 'multiple_evidence',
          'contained': 'containment_achieved',
          'report_submitted': 'containment_achieved'
        }},
        'containment_achieved': { transitions: {
          'report_submitted': 'complete'
        }},
        'complete': { terminal: true }
      },
      initialState: 'start'
    },

    validationRules: {
      'found_initial_access': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'initial-access';
        }
      },
      'found_lateral': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'lateral-movement';
        }
      },
      'found_privesc': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'privilege-escalation';
        }
      },
      'found_encryption': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'encryption-staging';
        }
      },
      'contained': {
        trigger: 'timeline_action',
        condition: function(action) {
          return action.type === 'timeline_add' &&
                 Labs.Timeline.getEvents().length >= 6;
        }
      },
      'report_submitted': {
        trigger: 'containment_action',
        condition: function(action) {
          return action.type === 'containment_submit' && action.score >= 60;
        }
      }
    },

    nudges: {
      'start': {
        delay: 120,
        text: 'Filter for critical severity events. Look for RDP connections from external IPs and suspicious process executions.'
      },
      'initial_access_found': {
        delay: 180,
        text: 'You found patient zero. Now trace the lateral movement — look for SMB connections between workstations and credential harvesting tools.'
      },
      'multiple_evidence': {
        delay: 240,
        text: 'The attack chain is becoming clear. Check for ransomware staging activity: shadow copy deletion, bulk file encryption, and ransom note deployment.'
      }
    },

    objectives: [
      { id: 'found_initial_access', title: 'Initial Access Identified' },
      { id: 'found_lateral', title: 'Lateral Movement Traced' },
      { id: 'found_privesc', title: 'Privilege Escalation Discovered' },
      { id: 'found_encryption', title: 'Encryption Staging Detected' },
      { id: 'contained', title: 'Containment Timeline Built' },
      { id: 'report_submitted', title: 'Containment Plan Submitted' }
    ],

    evidencePieces: [
      { id: 'initial-access', label: 'RDP brute force from 91.215.85.17 (Moscow)' },
      { id: 'lateral-movement', label: 'SMB lateral movement via PsExec' },
      { id: 'privilege-escalation', label: 'Mimikatz credential harvesting on WS-MKT-042' },
      { id: 'c2-callback', label: 'C2 callback to 91.215.85.17:443' },
      { id: 'encryption-staging', label: 'Ransomware staged on SRV-FILE-01' },
      { id: 'shadow-delete', label: 'Volume shadow copies deleted (vssadmin)' },
      { id: 'dc-targeting', label: 'Domain controller targeted for GPO deployment' },
      { id: 'full-timeline', label: 'Full kill chain timeline reconstructed' }
    ],

    knownIOCs: {
      '91.215.85.17': {
        type: 'IPv4', reputation: 'Malicious', score: 97,
        geo: 'Moscow, Russia', asn: 'AS49505 Selectel',
        firstSeen: '2024-01-05', lastSeen: '2024-03-22',
        associations: ['RDP brute force', 'Ransomware deployment', 'C2 infrastructure'],
        tags: ['ransomware', 'rdp-attacker', 'conti-affiliate']
      },
      '185.141.63.92': {
        type: 'IPv4', reputation: 'Malicious', score: 91,
        geo: 'Chisinau, Moldova', asn: 'AS39798',
        firstSeen: '2024-02-20', lastSeen: '2024-03-22',
        associations: ['Data exfiltration', 'Ransomware staging', 'Double extortion'],
        tags: ['exfil', 'ransomware', 'moldova']
      },
      'update-service.darkside-ops.net': {
        type: 'Domain', reputation: 'Malicious', score: 99,
        geo: 'Unknown', asn: 'Various (fast-flux)',
        firstSeen: '2024-03-15', lastSeen: '2024-03-22',
        associations: ['Ransomware C2', 'Payload delivery', 'Fast-flux DNS'],
        tags: ['ransomware', 'c2', 'fast-flux']
      }
    },

    expectedActions: ['isolate-server', 'block-ip', 'revoke-sessions', 'preserve-evidence', 'notify-customers', 'law-enforcement']
  };

  // ── Initialize Panel System ──
  Labs.PanelSystem.init({
    container: document.getElementById('workspace'),
    panels: [
      { id: 'panel-casefile', minWidth: 220, defaultWidth: 280 },
      { id: 'panel-siem', flex: true },
      { id: 'panel-tools', minWidth: 280, defaultWidth: 340 }
    ]
  });

  // ── Get Evidence Corpus ──
  var corpus = Labs.EvidenceCorpus.get('blue-containment');

  // Apply procedural randomization so evidence differs each run
  if (Labs.Procedural) {
    var tpl = Labs.EvidenceCorpus.getTemplate('blue-containment');
    if (tpl) {
      corpus = Labs.Procedural.apply(corpus, tpl);

      // Rebuild knownIOCs from randomized corpus
      var attackerIp = null;
      var c2Ip = null;
      var c2Domain = null;
      for (var _i = 0; _i < corpus.length; _i++) {
        var _e = corpus[_i];
        if (_e.evidenceId === 'initial-access' && _e.detail && _e.detail.srcIp) {
          attackerIp = _e.detail.srcIp;
        }
        if (_e.evidenceId === 'c2-callback' && _e.detail && _e.detail.dstIp) {
          c2Ip = _e.detail.dstIp;
        }
        if (_e.evidenceId === 'c2-callback' && _e.detail && _e.detail.domain) {
          c2Domain = _e.detail.domain;
        }
      }
      if (attackerIp && attackerIp !== '185.141.63.22') {
        if (scenario.knownIOCs['91.215.85.17']) {
          scenario.knownIOCs[attackerIp] = scenario.knownIOCs['91.215.85.17'];
          delete scenario.knownIOCs['91.215.85.17'];
        }
      }
      if (c2Ip && c2Ip !== '91.240.118.200') {
        if (scenario.knownIOCs['185.141.63.92']) {
          scenario.knownIOCs[c2Ip] = scenario.knownIOCs['185.141.63.92'];
          delete scenario.knownIOCs['185.141.63.92'];
        }
      }
      if (c2Domain && c2Domain !== 'cdn-update.systemcheck.xyz') {
        if (scenario.knownIOCs['update-service.darkside-ops.net']) {
          scenario.knownIOCs[c2Domain] = scenario.knownIOCs['update-service.darkside-ops.net'];
          delete scenario.knownIOCs['update-service.darkside-ops.net'];
        }
      }
    }
  }

  // ── Track evidence discoveries ──
  var discoveredEvidence = {};
  var totalEvidence = scenario.evidencePieces.length;

  function updateEvidenceTracker(evidenceId) {
    if (discoveredEvidence[evidenceId]) return;
    discoveredEvidence[evidenceId] = true;

    var panel = document.getElementById('evidence-panel');
    if (panel) {
      var items = panel.querySelectorAll('.soc-evidence-item');
      items.forEach(function(item) {
        if (item.getAttribute('data-evidence-id') === evidenceId) {
          item.classList.remove('undiscovered');
          item.classList.add('discovered');
          var icon = item.querySelector('.soc-evidence-icon');
          if (icon) icon.textContent = '\u2713';
        }
      });
    }

    var count = Object.keys(discoveredEvidence).length;
    var el = document.getElementById('soc-evidence-count');
    if (el) el.textContent = 'Evidence: ' + count + '/' + totalEvidence;
  }

  // ── Initialize Simulation Engine ──
  var sim = Labs.Simulation.init({
    scenario: scenario,
    bridge: Labs.SimulationBridge,
    onStateChange: function(fromState, toState, action) {
      Labs.Toast.show('Evidence discovered', 'success');

      if (action && action.entry && action.entry.evidenceId) {
        updateEvidenceTracker(action.entry.evidenceId);
      }

      var el = document.getElementById('soc-event-count');
      if (el) el.textContent = 'Events: ' + corpus.length;
    },
    onComplete: function() {
      var elapsed = Labs.Timer.stop();
      var evidenceCount = Object.keys(discoveredEvidence).length;
      var scoringData = {
        actionsLog: sim.getActionsLog(),
        nudgesShown: sim._nudgeRef ? sim._nudgeRef._shownCount || 0 : 0,
        nudgesDismissed: sim._nudgeRef ? sim._nudgeRef._dismissCount || 0 : 0,
        evidenceFound: evidenceCount,
        totalEvidence: totalEvidence
      };
      var result = Labs.SimulationBridge.onLabComplete(scenario.id, scenario, elapsed, scoringData);
      showCompletion(result, elapsed);
    }
  });

  // ── Initialize SIEM ──
  Labs.SIEM.init({
    container: document.getElementById('tool-siem'),
    evidenceCorpus: corpus,
    onAction: function(action) {
      sim.dispatch({ type: 'siem_action', action: action.action, entry: action.entry });

      if (action.action === 'timeline') {
        Labs.Timeline.addEvent({
          timestamp: action.entry.timestamp,
          title: action.entry.summary.replace(/<[^>]+>/g, '').substring(0, 80),
          description: action.entry.source.toUpperCase() + ' \u2014 ' + action.entry.severity,
          severity: action.entry.severity,
          sources: [action.entry.source],
          userDiscovered: true
        });
      }
      if (action.action === 'ioc_lookup' && action.entry.detail) {
        var iocTab = document.querySelector('[data-right-tool="ioc"]');
        if (iocTab) iocTab.click();
        Labs.IOCLookup.lookup(action.entry.detail.srcIp);
      }
      if (action.action === 'evidence' && action.entry.evidenceId) {
        updateEvidenceTracker(action.entry.evidenceId);
      }
    }
  });

  // ── Initialize source-filtered SIEM views ──
  ['firewall', 'auth', 'dns'].forEach(function(source) {
    var container = document.getElementById('tool-' + source);
    if (container) {
      var sourceMap = { firewall: 'fw', auth: 'auth', dns: 'dns' };
      var filtered = corpus.filter(function(e) { return e.source === sourceMap[source]; });
      Labs.SIEM.init({
        container: container,
        evidenceCorpus: filtered,
        onAction: function(action) {
          sim.dispatch({ type: 'siem_action', action: action.action, entry: action.entry });
          if (action.action === 'evidence' && action.entry.evidenceId) {
            updateEvidenceTracker(action.entry.evidenceId);
          }
        }
      });
    }
  });

  // ── Initialize Timeline ──
  Labs.Timeline.init({
    container: document.getElementById('tool-timeline'),
    onAction: function(action) {
      sim.dispatch({ type: 'timeline_action', type: action.type, event: action.event });
      if (Labs.Timeline.getEvents().length >= 6) {
        updateEvidenceTracker('full-timeline');
      }
    }
  });

  // ── Initialize IOC Lookup ──
  Labs.IOCLookup.init({
    container: document.getElementById('tool-ioc'),
    knownIOCs: scenario.knownIOCs,
    onAction: function(action) {
      sim.dispatch(action);
    }
  });

  // ── Initialize Actions ──
  Labs.SOCActions.init({
    container: document.getElementById('tool-actions'),
    expectedActions: scenario.expectedActions,
    onAction: function(action) {
      sim.dispatch({ type: 'containment_action', type: action.type, score: action.score, selected: action.selected });
    }
  });

  // ── Start Timer ──
  Labs.Timer.start(function(elapsed) {
    var el = document.getElementById('lab-timer');
    if (el) el.textContent = Labs.Timer.format(elapsed);
  });

  // ── Update level display ──
  var profile = Labs.Progress.getProfile();
  var levelEl = document.getElementById('soc-level');
  if (levelEl) levelEl.textContent = 'Level ' + profile.level + ' \u00b7 ' + Labs.Xp.titleForLevel(profile.level);

  // ── Update event count ──
  var evtEl = document.getElementById('soc-event-count');
  if (evtEl) evtEl.textContent = 'Events: ' + corpus.length;

  // ── Completion handler ──
  function showCompletion(result, elapsed) {
    document.getElementById('complete-time').textContent = Labs.Timer.format(elapsed);
    document.getElementById('complete-score').textContent = result.scoring ? result.scoring.composite : 100;
    document.getElementById('complete-xp').textContent = '+' + (result.scoring ? result.scoring.xp : result.xp);
    document.getElementById('complete-level').textContent = 'Level ' + result.level + ' \u2014 ' + Labs.Xp.titleForLevel(result.level);

    if (scenario.unlocks && scenario.unlocks.length > 0) {
      var unlockEl = document.getElementById('complete-unlock');
      if (unlockEl) {
        unlockEl.style.display = '';
      }
    }

    document.getElementById('lab-complete-overlay').classList.add('visible');

    var reportPanel = document.getElementById('report-panel');
    if (reportPanel && Labs.Debrief) {
      reportPanel.style.display = '';

      var evidenceHtml = '<div class="debrief-evidence">';
      scenario.evidencePieces.forEach(function(piece) {
        var found = !!discoveredEvidence[piece.id];
        evidenceHtml += '<div class="debrief-evidence-item ' + (found ? 'found' : 'missed') + '">' +
          (found ? '\u2713 ' : '\u2717 ') + piece.label + '</div>';
      });
      evidenceHtml += '</div>';

      Labs.Debrief.render({
        container: reportPanel,
        scoring: result.scoring,
        elapsed: elapsed,
        scenario: scenario,
        debriefContent: {
          analysis: '<div class="debrief-card"><h3>Incident: Ransomware Kill Chain</h3><p>The attacker gained initial access via RDP brute force from <code>91.215.85.17</code> (Moscow) against WS-MKT-042. After establishing a foothold, they deployed Mimikatz to harvest credentials, then used PsExec to move laterally to WS-FIN-017 and SRV-FILE-01.</p><p>On SRV-FILE-01, the attacker staged ransomware payloads, deleted volume shadow copies (vssadmin), and began encrypting test files. The next target was SRV-DC-01 — deploying ransomware via Group Policy to all domain-joined machines.</p></div>' + '<div class="debrief-card"><h3>Attack Path</h3><div style="font-family:var(--font-mono);font-size:11px;line-height:2;padding:12px;background:var(--surface-0);border-radius:8px;border:1px solid var(--border);">WS-MKT-042 (patient zero \u2014 RDP brute force)<br>&nbsp;&nbsp;\u2514\u2500 SMB/PsExec \u2500> WS-FIN-017 (lateral movement)<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\u2514\u2500 SMB \u2500> SRV-FILE-01 (ransomware staging)<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\u2514\u2500 SMB \u2500> SRV-DC-01 (BLOCKED)</div></div>' + '<div class="debrief-card"><h3>Evidence Summary</h3>' + evidenceHtml + '</div>',

          framework: '<div class="debrief-card"><h3>NIST Incident Response Framework</h3><p><strong>1. Preparation</strong> — RDP was exposed to the internet without MFA. No network segmentation between workstations. Local admin passwords were shared across machines.</p><p><strong>2. Detection & Analysis</strong> — EDR flagged svchost.exe spawning powershell.exe. Lateral SMB connections between workstations confirmed spread. C2 callback to 91.215.85.17 identified.</p><p><strong>3. Containment</strong> — Isolate all infected hosts (WS-MKT-042, WS-FIN-017, SRV-FILE-01). Block attacker IPs at perimeter. Revoke all credentials used on compromised machines.</p><p><strong>4. Eradication</strong> — Reimage infected hosts. Remove RDP internet exposure. Deploy network micro-segmentation. Implement LAPS for local admin passwords.</p><p><strong>5. Recovery</strong> — Restore from known-good backups. Verify domain controller integrity. Reset all domain admin credentials.</p><p><strong>6. Lessons Learned</strong> — RDP exposure was the root cause. SMB signing would have prevented relay attacks. Least privilege would have contained lateral movement.</p></div>' + '<div class="debrief-card"><h3>Containment Decision Tree</h3><p><strong>Immediate (first 15 minutes):</strong> Isolate known-infected hosts. Block external C2 IPs. Disable compromised accounts.</p><p><strong>Short-term (first hour):</strong> Scan all hosts for IOCs. Check domain controller integrity. Preserve forensic images before reimaging.</p><p><strong>Assessment criteria:</strong> Isolate hosts showing: suspicious child processes (svchost spawning powershell), workstation-to-workstation SMB traffic, known-malicious process names (mimikatz, PsExec), or connections to blocked C2 addresses.</p><p><strong>Do NOT isolate:</strong> Clean hosts running normal processes with expected network connections. False isolations cause production outages and delay incident response.</p></div>',

          code: '<div class="debrief-section-title">Ransomware Kill Chain</div><div class="debrief-code"><span class="vuln">02:15 — RDP brute force begins from 91.215.85.17\n02:22 — RDP access achieved on WS-MKT-042\n02:25 — svchost.exe spawns powershell.exe (persistence)\n02:28 — mimikatz.exe deployed (credential harvesting)\n02:35 — PsExec lateral movement to WS-FIN-017\n02:40 — SMB connection to SRV-FILE-01\n02:45 — vssadmin delete shadows /all (shadow deletion)\n02:48 — rclone.exe data exfiltration to 185.141.63.92\n02:52 — Ransomware staging on SRV-FILE-01\n02:55 — SMB connection attempt to SRV-DC-01</span></div><div class="debrief-section-title" style="margin-top:16px;">Key Indicators of Compromise</div><div class="debrief-code"><span class="fix">IP: 91.215.85.17 (RDP brute force / C2)\nIP: 185.141.63.92 (data exfiltration)\nDomain: update-service.darkside-ops.net (C2)\nProcess: svchost.exe -> powershell.exe\nProcess: mimikatz.exe (credential harvesting)\nProcess: vssadmin.exe delete shadows /all\nProcess: rclone.exe --transfers 16</span></div>',

          crossPerspective: {
            title: 'What the Attacker Did',
            description: 'From the attacker\'s perspective, this was a standard ransomware playbook: gain initial access via exposed RDP, harvest credentials with Mimikatz, move laterally with PsExec, stage ransomware on file servers, delete shadow copies to prevent recovery, and attempt to deploy via Group Policy for maximum impact. The goal was double extortion: encrypt systems AND exfiltrate data for leverage.',
            linkText: 'Try the Red Team Attack \u2192',
            linkHref: '/labs/red/lateral-movement/'
          }
        }
      });
    }

    var statusEl = document.getElementById('soc-mission-status');
    if (statusEl) {
      statusEl.textContent = '\u2713 Incident Resolved';
      statusEl.style.color = '#4ade80';
    }
  }
});
</script>
