layout: lab-workspace-v2.njk
permalink: /labs/red/jwt-devportal/
labCode: "RED-04"
labTitle: "JWT Algorithm Confusion"
labDifficulty: "beginner"
labDescription: "DevPortal accepts JWTs without enforcing the signing algorithm. Forge an admin token to access restricted resources."
targetUrl: "https://lab-jwt.penumbraforge.workers.dev"
targetHost: "devportal.lab.penumbraforge.com"
workerUrl: "https://lab-jwt.penumbraforge.workers.dev"
---

<!-- Mission Brief Content -->
<div class="ws-mission-header">Operation: Token Forge</div>
<div class="ws-mission-narrative">
  DevPortal provides a developer API platform with role-based access control via JSON Web Tokens. A code review flagged that the JWT verification logic may not properly enforce the signing algorithm — it trusts whatever <code>alg</code> the token header specifies.
  <br><br>
  Your objective: obtain a valid JWT, decode it, forge a new token with admin privileges using the <code>alg:none</code> bypass, and access the admin panel.
</div>

<div class="ws-mission-goal">
  <div class="ws-mission-goal-label">Primary Objective</div>
  <div class="ws-mission-goal-text">Forge a JWT with admin privileges and access the admin-restricted endpoint</div>
</div>

<div class="ws-mission-goal ws-mission-goal-bonus">
  <div class="ws-mission-goal-label">Bonus</div>
  <div class="ws-mission-goal-text">Use alg:none with a completely empty signature</div>
</div>

<div class="ws-mission-intel-section">
  <div class="ws-intel-item">
    <div class="ws-intel-label">Target</div>
    <div class="ws-intel-value">devportal.lab.penumbraforge.com</div>
  </div>
  <div class="ws-intel-item">
    <div class="ws-intel-label">Scope</div>
    <div class="ws-intel-value">Auth endpoints — /auth/login, /admin</div>
  </div>
  <div class="ws-intel-item">
    <div class="ws-intel-label">Rules of Engagement</div>
    <div class="ws-intel-value">No DoS. No brute force. Token manipulation only.</div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  'use strict';

  var Labs = window.PenumbraLabs;

  // NOTE: Red team procedural randomization (target app content, defenses,
  // response tokens) will be handled by Worker-side randomization in a
  // future update. The procedural engine is primarily for blue team
  // evidence corpora.
  var workerUrl = '{{ workerUrl }}';

  // ── Scenario Definition ──
  var scenario = {
    id: 'red-jwt-devportal',
    type: 'red',
    title: 'JWT Algorithm Confusion',
    difficulty: 'beginner',
    estimatedTime: 10,
    xpReward: 100,
    skills: ['auth-jwt-bypass'],
    unlocks: ['blue-investigate-devportal'],
    optimalActions: 5,
    techniqueChecks: [
      { id: 'decoded-jwt', check: function(log) { return log.some(function(a) { return a.type === 'decoder' || (a.type === 'iframe_message' && a.message && a.message.action === 'decode'); }); }, points: 25 },
      { id: 'modified-alg', check: function(log) { return log.some(function(a) { return a.type === 'iframe_message' && a.message && a.message.algNone === true; }); }, points: 25 },
      { id: 'forged-admin', check: function(log) { return log.some(function(a) { return a.type === 'iframe_message' && a.message && a.message.isAdmin === true; }); }, points: 25 },
      { id: 'accessed-admin', check: function(log) { return log.some(function(a) { return a.type === 'iframe_message' && a.message && a.message.action === 'access' && a.message.isAdmin === true; }); }, points: 25 }
    ],

    stateGraph: {
      states: {
        'start':          { transitions: { 'token_obtained': 'token_obtained' } },
        'token_obtained': { transitions: { 'token_decoded': 'token_decoded' } },
        'token_decoded':  { transitions: { 'token_forged': 'token_forged' } },
        'token_forged':   { transitions: { 'admin_access': 'admin_access' } },
        'admin_access':   { transitions: { 'complete': 'complete' } },
        'complete':       { terminal: true }
      },
      initialState: 'start'
    },

    validationRules: {
      'token_obtained': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'jwt-result' && msg.action === 'login' && msg.token;
        }
      },
      'token_decoded': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'jwt-result' && msg.action === 'decode';
        }
      },
      'token_forged': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'jwt-result' && msg.algNone === true;
        }
      },
      'admin_access': {
        trigger: 'iframe_message',
        condition: function(msg) {
          return msg.type === 'jwt-result' && msg.isAdmin === true;
        }
      },
      'complete': {
        trigger: 'auto',
        condition: function() { return true; }
      }
    },

    nudges: {
      'start': {
        delay: 90,
        text: 'Start by logging in with valid credentials to receive a JWT. Check the login form in the browser view.'
      },
      'token_obtained': {
        delay: 120,
        text: 'You have a JWT. It has three Base64-encoded parts separated by dots. Use the Decoder tool to inspect the header — what algorithm does it specify?'
      },
      'token_decoded': {
        delay: 120,
        text: 'The header says RS256. The JWT spec includes an algorithm called "none" which means no signature. Can you change the alg claim and forge a new token?'
      },
      'token_forged': {
        delay: 90,
        text: 'Token forged with alg:none. Now modify the payload to set role:"admin" and use it to access the /admin endpoint.'
      }
    },

    objectives: [
      { id: 'token_obtained', title: 'Token Obtained' },
      { id: 'token_decoded', title: 'Token Decoded' },
      { id: 'token_forged', title: 'Token Forged' },
      { id: 'admin_access', title: 'Admin Access' }
    ]
  };

  // ── Initialize Panel System ──
  Labs.PanelSystem.init({
    container: document.getElementById('workspace'),
    panels: [
      { id: 'panel-mission', minWidth: 200, defaultWidth: 240 },
      { id: 'panel-tools', flex: true },
      { id: 'panel-browser', minWidth: 400, defaultWidth: 600 }
    ]
  });

  // ── Initialize Simulation Engine ──
  var sim = Labs.Simulation.init({
    scenario: scenario,
    bridge: Labs.SimulationBridge,
    onStateChange: function(fromState, toState, action) {
      var obj = scenario.objectives.find(function(o) { return o.id === toState; }) ||
                scenario.objectives.find(function(o) { return o.id === fromState; });
      var label = obj ? obj.title : toState;
      Labs.Toast.show(label + ' — confirmed', 'success');

      updateDetection(toState);
      updateRequestCount();
      addIntel(toState, action);
    },
    onComplete: function() {
      var elapsed = Labs.Timer.stop();
      var scoringData = {
        actionsLog: sim.getActionsLog(),
        nudgesShown: sim._nudgeRef ? sim._nudgeRef._shownCount || 0 : 0,
        nudgesDismissed: sim._nudgeRef ? sim._nudgeRef._dismissCount || 0 : 0,
        evidenceFound: 4,
        totalEvidence: 4
      };
      var result = Labs.SimulationBridge.onLabComplete(scenario.id, scenario, elapsed, scoringData);
      showCompletion(result, elapsed);
    }
  });

  // ── Initialize Terminal ──
  Labs.Terminal.init({
    container: document.getElementById('tool-terminal'),
    workerUrl: workerUrl,
    onAction: function(action) {
      sim.dispatch(action);
      requestCount++;
      updateRequestCount();
    }
  });

  // ── Initialize Repeater ──
  Labs.Repeater.init({
    container: document.getElementById('tool-repeater'),
    workerUrl: workerUrl,
    onAction: function(action) {
      sim.dispatch(action);
      requestCount++;
      updateRequestCount();
    }
  });

  // ── Initialize Decoder & Notes ──
  Labs.Decoder.init({ container: document.getElementById('tool-decoder') });
  Labs.Notes.init({ container: document.getElementById('tool-notes'), labId: scenario.id });

  // ── Listen for iframe messages ──
  window.addEventListener('message', function(e) {
    if (!e.data || !e.data.type) return;

    if (e.data.type === 'jwt-result') {
      sim.dispatch({ type: 'iframe_message', message: e.data });
    }

    if (e.data.type === 'devportal-nav' && e.data.url) {
      var urlDisplay = document.getElementById('ws-url-display');
      if (urlDisplay) {
        var clean = e.data.url.replace(/^https?:\/\//, '');
        urlDisplay.value = clean;
      }
    }
  });

  // ── Start Timer ──
  Labs.Timer.start(function(elapsed) {
    var el = document.getElementById('lab-timer');
    if (el) el.textContent = Labs.Timer.format(elapsed);
  });

  // ── State helpers ──
  var requestCount = 0;

  function updateRequestCount() {
    var el = document.getElementById('ws-request-count');
    if (el) el.textContent = 'Requests: ' + requestCount;
  }

  function updateDetection(state) {
    var el = document.getElementById('ws-detection');
    if (!el) return;
    var labels = {
      'token_obtained': '● JWT Obtained',
      'token_decoded': '● Token Structure Analyzed',
      'token_forged': '● alg:none Token Forged',
      'admin_access': '● Admin Panel Breached',
      'complete': '● Privilege Escalation Complete'
    };
    el.textContent = labels[state] || '';
    el.style.color = state === 'complete' || state === 'admin_access' ? '#ef4444' : '#f59e0b';
  }

  function addIntel(state, action) {
    var panel = document.getElementById('intel-panel');
    if (!panel) return;

    var empty = panel.querySelector('.ws-mission-empty');
    if (empty) empty.remove();

    var intel = {
      'token_obtained': { label: 'JWT Issued', value: 'Login returned RS256-signed JWT with user role in payload' },
      'token_decoded': { label: 'Token Analyzed', value: 'Header specifies alg:RS256, payload contains sub, username, and role claims' },
      'token_forged': { label: 'Token Forged', value: 'Server accepted JWT with alg:none — signature verification bypassed entirely' },
      'admin_access': { label: 'Admin Access', value: 'Forged token with role:admin granted access to restricted /admin endpoint' }
    };

    var info = intel[state];
    if (!info) return;

    var div = document.createElement('div');
    div.className = 'ws-intel-item';
    div.innerHTML = '<div class="ws-intel-label">' + info.label + '</div>' +
                    '<div class="ws-intel-value">' + info.value + '</div>';
    panel.appendChild(div);
  }

  function showCompletion(result, elapsed) {
    document.getElementById('complete-time').textContent = Labs.Timer.format(elapsed);
    document.getElementById('complete-score').textContent = result.scoring ? result.scoring.composite : 100;
    document.getElementById('complete-xp').textContent = '+' + (result.scoring ? result.scoring.xp : result.xp);
    document.getElementById('complete-level').textContent = 'Level ' + result.level + ' — ' + Labs.Xp.titleForLevel(result.level);

    if (scenario.unlocks && scenario.unlocks.length > 0) {
      var unlockEl = document.getElementById('complete-unlock');
      if (unlockEl) {
        unlockEl.style.display = '';
        unlockEl.textContent = 'Blue Team Investigation →';
        unlockEl.href = '/labs/blue/investigate-devportal/';
      }
    }

    document.getElementById('lab-complete-overlay').classList.add('visible');

    var debriefPanel = document.getElementById('debrief-panel');
    if (debriefPanel && Labs.Debrief) {
      debriefPanel.style.display = '';
      Labs.Debrief.render({
        container: debriefPanel,
        scoring: result.scoring,
        elapsed: elapsed,
        scenario: scenario,
        debriefContent: {
          analysis: '<div class="debrief-card"><h3>Vulnerability: CWE-327 — Use of Broken Cryptographic Algorithm</h3><p>DevPortal\'s JWT verification calls <code>jwt.verify(token, publicKey)</code> without specifying which algorithms are acceptable. The server trusts the <code>alg</code> header in the token itself, so an attacker can set it to <code>"none"</code> — which tells the library to skip signature verification entirely.</p><p>With no signature check, the attacker can modify the payload (changing role to admin) and the server accepts the forged token as valid. No private key knowledge required.</p></div>',

          framework: '<div class="debrief-card"><h3>MITRE ATT&CK Mapping</h3><p><strong>T1548</strong> — Abuse Elevation Control Mechanism: Forged JWT bypasses role-based access control</p><p><strong>T1078</strong> — Valid Accounts: Attacker assumes admin identity via forged token</p></div><div class="debrief-card"><h3>OWASP Top 10</h3><p><strong>A02:2021</strong> — Cryptographic Failures: JWT verification does not enforce signing algorithm</p></div><div class="debrief-card"><h3>CVE Reference</h3><p><strong>CVE-2015-9235</strong> — JWT alg:none signature bypass in jsonwebtoken library</p></div>',

          code: '<div class="debrief-section-title">Vulnerable Code</div><div class="debrief-code"><span class="vuln">const decoded = jwt.verify(token, publicKey);</span>\n// No algorithms option — trusts whatever alg the token specifies\n// alg:"none" = no signature required</div><div class="debrief-section-title" style="margin-top:16px;">The Fix</div><div class="debrief-code"><span class="fix">const decoded = jwt.verify(token, publicKey, {\n  algorithms: [\'RS256\'],  // Only accept RS256\n  issuer: \'devportal.io\',\n  audience: \'api.devportal.io\',\n});</span>\n// Rejects: alg:"none", alg:"HS256" with public key\n// Also: rotate signing keys, use short expiration</div>',

          crossPerspective: {
            title: 'What a Defender Sees',
            description: 'From the SOC\'s perspective, this attack appears as admin-level API calls originating from a user session that was never granted admin privileges. The JWT audit log shows a token with alg:none being accepted — something that should never happen in production. Auth logs reveal a role claim mismatch between the issued token and the one being presented. The defense: algorithm whitelist in jwt.verify(), plus anomaly detection on role escalation patterns.',
            linkText: 'Try the Blue Team Investigation →',
            linkHref: '/labs/blue/investigate-devportal/'
          }
        }
      });
    }

    var statusEl = document.getElementById('ws-mission-status');
    if (statusEl) {
      statusEl.textContent = '✓ Mission Complete';
      statusEl.style.color = '#4ade80';
    }
  }
});
</script>
