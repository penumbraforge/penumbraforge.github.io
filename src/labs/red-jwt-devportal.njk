<script>
(function() {
  var LAB_CONFIG = {
    id: 'red-jwt-devportal',
    type: 'red',
    title: 'JWT Algorithm Confusion',
    target: 'DevPortal',
    difficulty: 'beginner',
    estimatedTime: 10,
    xpReward: 100,
    hintCost: [10, 25, 50],
    skills: ['auth-jwt-bypass'],
    unlocks: ['blue-investigate-devportal'],
    objectives: [
      { id: 'authenticate', step: 1, title: 'Authentication' },
      { id: 'decode', step: 2, title: 'Token Inspection' },
      { id: 'forge', step: 3, title: 'Token Forgery' },
      { id: 'access', step: 4, title: 'Admin Access' },
    ],
  };

  var Engine = PenumbraLabs.Engine;
  var ServerLogs = PenumbraLabs.ServerLogs;

  Engine.init(LAB_CONFIG);
  ServerLogs.init('server-logs');
  ServerLogs.add('info', 'DevPortal API server started on port 3000');
  ServerLogs.add('info', 'JWT verification middleware loaded — RS256 public key ready');

  var iframe = document.getElementById('lab-target');
  var httpReq = document.getElementById('http-req');
  var httpResp = document.getElementById('http-resp');

  /* Listen for postMessage from the lab iframe */
  window.addEventListener('message', function(event) {
    var data;
    try {
      data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
    } catch(e) { return; }

    if (!data || data.type !== 'jwt-result') return;

    var action = data.action || '';
    var algNone = data.algNone || false;
    var isAdmin = data.isAdmin || false;
    var token = data.token || '';
    var statusCode = data.statusCode || 200;

    /* Update HTTP inspector */
    if (action === 'login') {
      httpReq.innerHTML = '<span class="lab-http-method">POST</span> /auth/login HTTP/1.1\n' +
        '<span class="lab-http-hname">Host:</span> <span class="lab-http-hval">api.devportal.io</span>\n' +
        '<span class="lab-http-hname">Content-Type:</span> <span class="lab-http-hval">application/json</span>\n\n' +
        '{ <span class="lab-http-hname">"username":</span> <span class="lab-http-hval">"' + escHtml(data.username || '') + '"</span> }';

      httpResp.innerHTML = 'HTTP/1.1 <span class="lab-http-status">200 OK</span>\n' +
        '<span class="lab-http-hname">Content-Type:</span> <span class="lab-http-hval">application/json</span>\n\n' +
        '{ <span class="lab-http-hname">"token":</span> <span class="lab-http-hval">"' + escHtml(token).substring(0, 80) + '..."</span> }';

      ServerLogs.add('info', 'POST /auth/login — user authenticated, JWT issued (RS256)');
      Engine.tryCompleteObjective('authenticate');
    }

    if (action === 'decode') {
      ServerLogs.add('info', 'JWT decoded — algorithm: ' + (data.algorithm || 'RS256'));
      Engine.tryCompleteObjective('decode');
    }

    if (action === 'verify' || action === 'access') {
      httpReq.innerHTML = '<span class="lab-http-method">GET</span> /admin HTTP/1.1\n' +
        '<span class="lab-http-hname">Host:</span> <span class="lab-http-hval">api.devportal.io</span>\n' +
        '<span class="lab-http-hname">Authorization:</span> <span class="lab-http-hval">' + escHtml(token).substring(0, 60) + '...</span>';

      httpResp.innerHTML = 'HTTP/1.1 <span class="lab-http-status">' + statusCode + (statusCode === 200 ? ' OK' : ' Forbidden') + '</span>\n' +
        '<span class="lab-http-hname">Content-Type:</span> <span class="lab-http-hval">application/json</span>\n\n' +
        '<span class="lab-http-hval">' + escHtml(JSON.stringify(data.body || {}).substring(0, 200)) + '</span>';

      /* Objective 3: Forge — alg:none token */
      if (algNone) {
        Engine.tryCompleteObjective('forge');
        ServerLogs.add('warn', 'JWT received with alg:"none" — signature verification skipped');
      }

      /* Objective 4: Access — admin panel with forged token */
      if (isAdmin) {
        setTimeout(function() {
          Engine.tryCompleteObjective('access');
          ServerLogs.add('critical', 'Admin panel accessed with forged JWT — role escalation confirmed');
        }, 500);
      }
    }
  });

  /* Hint reveals */
  document.querySelectorAll('.lab-hint').forEach(function(hint, idx) {
    hint.addEventListener('click', function() {
      if (!this.classList.contains('revealed')) {
        this.classList.add('revealed');
        Engine.revealHint(idx);
      }
    });
  });

  /* Restore previous progress */
  var progress = Engine.getProgress();
  progress.objectivesCompleted.forEach(function(objId) {
    var el = document.getElementById('obj-' + objId);
    if (el) {
      el.classList.remove('current');
      el.classList.add('completed');
      el.querySelector('.lab-obj-check').textContent = '\u2713';
    }
  });

  /* Mark current objective */
  var foundCurrent = false;
  LAB_CONFIG.objectives.forEach(function(obj) {
    var el = document.getElementById('obj-' + obj.id);
    if (!el) return;
    if (progress.objectivesCompleted.indexOf(obj.id) === -1 && !foundCurrent) {
      el.classList.add('current');
      foundCurrent = true;
    }
  });

  /* Restore revealed hints */
  progress.hintsUsed.forEach(function(idx) {
    var hint = document.getElementById('hint-' + idx);
    if (hint) hint.classList.add('revealed');
  });

  function escHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
})();
</script>
