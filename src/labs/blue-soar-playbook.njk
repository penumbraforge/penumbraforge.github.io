      subject: 'Team standup notes — March 22',
      sender: 'sarah.martinez@company.com',
      senderReputation: 2,
      urlOnBlocklist: false,
      domainAge: 4380,
      isPhishing: false,
      detail: 'Internal team email, legitimate sender'
    },
    {
      id: 'PHISH-005',
      subject: 'Urgent: Wire transfer approval needed',
      sender: 'cfo@company-finance.org',
      senderReputation: 78,
      urlOnBlocklist: false,
      domainAge: 12,
      isPhishing: true,
      detail: 'BEC attack impersonating CFO from lookalike domain'
    },
    {
      id: 'PHISH-006',
      subject: 'Your package is waiting — track delivery',
      sender: 'notify@fedex-tracking.info',
      senderReputation: 85,
      urlOnBlocklist: true,
      domainAge: 5,
      isPhishing: true,
      detail: 'Fake FedEx notification with credential harvesting link'
    },
    {
      id: 'PHISH-007',
      subject: 'GitHub Actions workflow failed',
      sender: 'noreply@github.com',
      senderReputation: 1,
      urlOnBlocklist: false,
      domainAge: 10227,
      isPhishing: false,
      detail: 'Legitimate GitHub CI/CD notification'
    },
    {
      id: 'PHISH-008',
      subject: 'Shared document: Budget 2026',
      sender: 'share@g00gle-docs.com',
      senderReputation: 91,
      urlOnBlocklist: true,
      domainAge: 2,
      isPhishing: true,
      detail: 'Typosquatted Google domain with phishing link'
    },
    {
      id: 'PHISH-009',
      subject: 'Benefits enrollment reminder',
      sender: 'hr@company.com',
      senderReputation: 3,
      urlOnBlocklist: false,
      domainAge: 4380,
      isPhishing: false,
      detail: 'Legitimate HR benefits enrollment email'
    },
    {
      id: 'PHISH-010',
      subject: 'Password expires in 24 hours — update now',
      sender: 'admin@it-helpdesk-portal.com',
      senderReputation: 80,
      urlOnBlocklist: true,
      domainAge: 14,
      isPhishing: true,
      detail: 'Credential harvesting page disguised as IT helpdesk'
    }
  ];

  // Playbook state
  var playbook = [
    { id: 'trigger', type: 'trigger', typeLabel: 'TRIGGER', typeClass: 'type-trigger', stepClass: 'step-trigger', name: 'New phishing alert received', logic: 'Fires on every new phishing alert', fixed: true }
  ];

  var phase = 'build'; // 'build' or 'test'

  // Render available actions
  function renderActions() {
    var container = document.getElementById('available-actions');
    var html = '';
    var currentCategory = '';
    var playbookIds = playbook.map(function(s) { return s.id; });

    AVAILABLE_ACTIONS.forEach(function(action) {
      if (action.category !== currentCategory) {
        var labels = { enrich: 'Enrichment', decision: 'Decision Logic', action: 'Response Actions' };
        html += '<div class="soar-section-divider">' + labels[action.category] + '</div>';
        currentCategory = action.category;
      }

      var added = playbookIds.indexOf(action.id) !== -1;
      // Check if decision step's required enrichment is in the playbook
      var missingReq = false;
      if (action.requires && playbookIds.indexOf(action.requires) === -1) {
        missingReq = true;
      }

      html += '<div class="soar-action-card' + (added || missingReq ? ' disabled' : '') + '"' +
        (!added && !missingReq ? ' onclick="addStep(\'' + action.id + '\')"' : '') +
        (missingReq ? ' title="Requires: ' + action.requires.replace('enrich-', 'Check ') + ' enrichment step first"' : '') +
        '>' +
        '<div class="soar-action-type ' + action.typeClass + '">' + action.typeLabel + '</div>' +
        '<div class="soar-action-name">' + action.name + (added ? ' (added)' : '') + (missingReq ? ' (needs enrichment)' : '') + '</div>' +
        '<div class="soar-action-desc">' + action.desc + '</div>' +
      '</div>';
    });

    container.innerHTML = html;
  }

  // Render playbook flow
  function renderFlow() {
    var container = document.getElementById('playbook-flow');
    var html = '';

    if (playbook.length === 0) {
      html = '<div class="flow-empty">Add actions from the left panel to build your playbook.</div>';
    } else {
      playbook.forEach(function(step, i) {
        if (i > 0) {
          html += '<div class="flow-connector"></div>';
        }
        html += '<div class="flow-step">' +
          '<div class="flow-step-card ' + step.stepClass + '">' +
            '<div class="flow-step-num">' + (i + 1) + '</div>' +
            '<div class="flow-step-info">' +
              '<div class="flow-step-type ' + step.typeClass + '">' + step.typeLabel + '</div>' +
              '<div class="flow-step-name">' + step.name + '</div>' +
              (step.logic ? '<div class="flow-step-logic">' + step.logic + '</div>' : '') +
            '</div>' +
            (step.fixed ? '' : '<button class="flow-step-remove" onclick="removeStep(' + i + ')" title="Remove step">&times;</button>') +
          '</div>' +
        '</div>';
      });
    }

    container.innerHTML = html;

    // Update counts
    var enrichCount = 0, decisionCount = 0, actionCount = 0;
    playbook.forEach(function(s) {
      if (s.type === 'enrich') enrichCount++;
      if (s.type === 'decision') decisionCount++;
      if (s.type === 'action-safe' || s.type === 'action-block') actionCount++;
    });

    document.getElementById('enrich-count').textContent = enrichCount;
    document.getElementById('decision-count').textContent = decisionCount;
    document.getElementById('action-count').textContent = actionCount;
    document.getElementById('step-count').textContent = playbook.length;

    // Check objectives
    if (enrichCount >= 2) {
      Engine.tryCompleteObjective('enrich');
    }
    if (decisionCount >= 2) {
      Engine.tryCompleteObjective('decisions');
    }

    // Check actions objective: need quarantine AND notify
    var hasQuarantine = playbook.some(function(s) { return s.id === 'action-quarantine'; });
    var hasNotify = playbook.some(function(s) { return s.id === 'action-notify'; });
    if (hasQuarantine && hasNotify) {
      Engine.tryCompleteObjective('actions');
    }

    // Enable test button if minimum viable playbook
    var canTest = enrichCount >= 1 && decisionCount >= 1 && actionCount >= 1;
    document.getElementById('btn-test').disabled = !canTest;

    if (canTest) {
      document.getElementById('progress-pct').textContent = 'Ready to test';
      document.getElementById('progress-fill').style.width = '75%';
    } else {
      var progress = ((enrichCount > 0 ? 1 : 0) + (decisionCount > 0 ? 1 : 0) + (actionCount > 0 ? 1 : 0)) / 3 * 75;
      document.getElementById('progress-fill').style.width = progress + '%';
      var needed = [];
      if (enrichCount === 0) needed.push('enrichment');
      if (decisionCount === 0) needed.push('decision');
      if (actionCount === 0) needed.push('action');
      document.getElementById('progress-pct').textContent = 'Need: ' + needed.join(', ');
    }
  }

  // Add step to playbook
  window.addStep = function(actionId) {
    if (phase !== 'build') return;
    var action = AVAILABLE_ACTIONS.find(function(a) { return a.id === actionId; });
    if (!action) return;

    // Check if already added
    if (playbook.some(function(s) { return s.id === actionId; })) return;

    // Check requirements
    if (action.requires && !playbook.some(function(s) { return s.id === action.requires; })) {
      Toast.show('Add the required enrichment step first', 'error');
      return;
    }

    playbook.push({
      id: action.id,
      type: action.type,
      typeLabel: action.typeLabel,
      typeClass: action.typeClass,
      stepClass: action.stepClass,
      name: action.name,
      logic: action.logic
    });

    addEvidence('Added playbook step: [' + action.typeLabel + '] ' + action.name);
    Toast.show('Added: ' + action.name, 'success');

    renderActions();
    renderFlow();
  };

  // Remove step from playbook
  window.removeStep = function(index) {
    if (phase !== 'build') return;
    if (index === 0) return; // Can't remove trigger

    var removed = playbook[index];

    // Check if removing an enrichment step that a decision depends on
    if (removed.type === 'enrich') {
      var dependentDecision = AVAILABLE_ACTIONS.find(function(a) {
        return a.requires === removed.id && playbook.some(function(s) { return s.id === a.id; });
      });
      if (dependentDecision) {
        // Also remove the dependent decision
        var depIdx = playbook.findIndex(function(s) { return s.id === dependentDecision.id; });
        if (depIdx > -1) {
          playbook.splice(depIdx, 1);
          if (depIdx < index) index--;
          Toast.show('Also removed dependent decision: ' + dependentDecision.name, 'info');
        }
      }
    }

    playbook.splice(index, 1);
    addEvidence('Removed playbook step: [' + removed.typeLabel + '] ' + removed.name);
    Toast.show('Removed: ' + removed.name, 'info');

    renderActions();
    renderFlow();
  };

  // Run playbook against a single alert
  function evaluateAlert(alert) {
    var hasSenderEnrich = playbook.some(function(s) { return s.id === 'enrich-sender'; });
    var hasUrlEnrich = playbook.some(function(s) { return s.id === 'enrich-url'; });
    var hasDomainEnrich = playbook.some(function(s) { return s.id === 'enrich-domain'; });

    var hasRepDecision = playbook.some(function(s) { return s.id === 'decision-reputation'; });
    var hasUrlDecision = playbook.some(function(s) { return s.id === 'decision-url'; });
    var hasDomainDecision = playbook.some(function(s) { return s.id === 'decision-domain'; });

    var hasQuarantine = playbook.some(function(s) { return s.id === 'action-quarantine'; });
    var hasBlockSender = playbook.some(function(s) { return s.id === 'action-block-sender'; });
    var hasNotify = playbook.some(function(s) { return s.id === 'action-notify'; });
    var hasTicket = playbook.some(function(s) { return s.id === 'action-ticket'; });
    var hasClose = playbook.some(function(s) { return s.id === 'action-close'; });
    var hasResetPw = playbook.some(function(s) { return s.id === 'action-reset-password'; });

    // Determine if playbook would flag this as malicious
    var flaggedMalicious = false;
    var flaggedSuspicious = false;
    var actions = [];

    // Check decision points in order they appear in playbook
    playbook.forEach(function(step) {
      if (step.id === 'decision-reputation' && hasSenderEnrich) {
        if (alert.senderReputation > 70) {
          flaggedMalicious = true;
        }
      }
      if (step.id === 'decision-url' && hasUrlEnrich) {
        if (alert.urlOnBlocklist) {
          flaggedMalicious = true;
        }
      }
      if (step.id === 'decision-domain' && hasDomainEnrich) {
        if (alert.domainAge < 30) {
          flaggedSuspicious = true;
        }
      }
    });

    // Determine actions taken
    if (flaggedMalicious) {
      if (hasQuarantine) actions.push('Quarantined');
      if (hasBlockSender) actions.push('Sender blocked');
      if (hasNotify) actions.push('User notified');
      if (hasResetPw) actions.push('Password reset');
      if (actions.length === 0) {
        if (hasTicket) actions.push('Ticket created');
        else actions.push('Flagged (no action defined)');
      }
    } else if (flaggedSuspicious) {
      if (hasTicket) actions.push('Ticket created');
      else if (hasQuarantine) actions.push('Quarantined');
      else actions.push('Flagged (no action defined)');
    } else {
      if (hasClose) actions.push('Closed as FP');
      else if (hasTicket) actions.push('Ticket created');
      else actions.push('No action taken');
    }

    // Determine correctness
    var playbookSaysPhishing = flaggedMalicious || flaggedSuspicious;
    var isCorrect = playbookSaysPhishing === alert.isPhishing;

    // Special case: if it's phishing and playbook flagged suspicious but didn't quarantine, still count as partially correct
    // (a ticket for a real phishing email is acceptable)
    if (alert.isPhishing && flaggedSuspicious && !flaggedMalicious && hasTicket) {
      isCorrect = true;
    }

    return {
      correct: isCorrect,
      verdict: playbookSaysPhishing ? 'MALICIOUS' : 'BENIGN',
      expectedVerdict: alert.isPhishing ? 'MALICIOUS' : 'BENIGN',
      actions: actions
    };
  }

  // Test playbook
  document.getElementById('btn-test').addEventListener('click', function() {
    if (phase === 'test') return;
    phase = 'test';

    document.getElementById('soar-mode').textContent = 'Testing';
    document.getElementById('phase-label').textContent = 'Running Alerts';

    addEvidence('Started playbook test with ' + TEST_ALERTS.length + ' alerts');

    // Switch views
    document.getElementById('builder-container').style.display = 'none';
    document.getElementById('test-container').style.display = '';

    // Run all alerts
    var correctCount = 0;
    var results = [];

    TEST_ALERTS.forEach(function(alert) {
      var result = evaluateAlert(alert);
      if (result.correct) correctCount++;
      results.push({ alert: alert, result: result });
    });

    var accuracy = Math.round((correctCount / TEST_ALERTS.length) * 100);

    // Render results
    var html = '';

    // Score bar
    var scoreColor = accuracy >= 80 ? 'var(--sage)' : accuracy >= 60 ? '#e8b84d' : '#eb5757';
    html += '<div class="test-score-bar">' +
      '<div class="test-score-num" style="color:' + scoreColor + ';">' + accuracy + '%</div>' +
      '<div class="test-score-detail">' +
        '<div class="test-score-label">' + (accuracy >= 80 ? 'Excellent accuracy' : accuracy >= 60 ? 'Decent — needs tuning' : 'Needs significant improvement') + '</div>' +
        '<div class="test-score-sub">' + correctCount + ' of ' + TEST_ALERTS.length + ' alerts handled correctly</div>' +
      '</div>' +
      (accuracy < 80 ? '<button class="siem-submit-btn" onclick="backToBuild()" style="flex-shrink:0;">Revise Playbook</button>' : '') +
    '</div>';

    html += '<div class="test-header">' +
      '<div class="test-header-title">Alert Stream Results</div>' +
      '<div class="test-header-sub">Each alert was processed through your playbook</div>' +
    '</div>';

    results.forEach(function(r) {
      html += '<div class="test-alert ' + (r.result.correct ? 'test-correct' : 'test-wrong') + '">' +
        '<div class="test-result-icon">' + (r.result.correct ? '&#x2705;' : '&#x274c;') + '</div>' +
        '<div class="test-alert-info">' +
          '<div class="test-alert-subject">' + r.alert.subject + '</div>' +
          '<div class="test-alert-meta">' +
            'From: ' + r.alert.sender + '<br>' +
            'Reputation: ' + r.alert.senderReputation + '/100 | ' +
            'URL blocklist: ' + (r.alert.urlOnBlocklist ? 'YES' : 'no') + ' | ' +
            'Domain age: ' + r.alert.domainAge + ' days' +
          '</div>' +
          '<div class="test-alert-meta" style="margin-top:4px;color:var(--text-3);">' + r.alert.detail + '</div>' +
        '</div>' +
        '<div class="test-alert-verdict">' +
          '<div class="test-verdict-playbook">Playbook: ' + r.result.verdict + '</div>' +
          '<div class="' + (r.result.correct ? 'test-verdict-correct' : 'test-verdict-wrong') + '">Actual: ' + r.result.expectedVerdict + '</div>' +
          '<div style="color:var(--text-3);margin-top:2px;">Actions: ' + r.result.actions.join(', ') + '</div>' +
        '</div>' +
      '</div>';
    });

    document.getElementById('test-results').innerHTML = html;

    addEvidence('Playbook test complete: ' + accuracy + '% accuracy (' + correctCount + '/' + TEST_ALERTS.length + ')');

    // Update summary bar
    document.getElementById('progress-fill').style.width = '100%';
    document.getElementById('progress-pct').textContent = accuracy + '% accuracy';

    // Update button
    var btn = document.getElementById('btn-test');
    if (accuracy >= 80) {
      btn.textContent = 'View Debrief';
      btn.disabled = false;
      btn.onclick = function() { showDebrief(accuracy, correctCount, results); };
      Engine.tryCompleteObjective('test');
    } else {
      btn.textContent = 'Revise Playbook';
      btn.disabled = false;
      btn.onclick = function() { backToBuild(); };
      Toast.show('Accuracy: ' + accuracy + '% — need 80% to pass. Revise your playbook.', 'error');
    }
  });

  // Go back to build phase
  window.backToBuild = function() {
    phase = 'build';
    document.getElementById('soar-mode').textContent = 'Design';
    document.getElementById('phase-label').textContent = 'Build Playbook';
    document.getElementById('builder-container').style.display = '';
    document.getElementById('test-container').style.display = 'none';

    var btn = document.getElementById('btn-test');
    btn.textContent = 'Test Playbook';
    btn.disabled = false;
    btn.onclick = null;

    renderActions();
    renderFlow();
    addEvidence('Returned to playbook builder for revision');
    Toast.show('Revise your playbook and test again', 'info');
  };

  // Show debrief
  function showDebrief(accuracy, correctCount, results) {
    // Build debrief results
    var debriefHtml = '<div style="display:flex;align-items:center;gap:20px;margin-bottom:20px;padding:20px;border-radius:10px;border:1px solid var(--border);background:var(--surface-1);">' +
      '<div style="font-family:var(--font-display);font-size:42px;color:var(--sage);">' + accuracy + '%</div>' +
      '<div style="flex:1;">' +
        '<div style="font-family:var(--font-display);font-size:16px;color:var(--text-1);margin-bottom:4px;">Playbook accuracy</div>' +
        '<div style="font-size:12px;color:var(--text-3);">' + correctCount + ' of ' + TEST_ALERTS.length + ' alerts handled correctly</div>' +
      '</div>' +
    '</div>';

    debriefHtml += '<div style="font-size:13px;color:var(--text-2);line-height:1.7;">';
    debriefHtml += '<p><strong>Your playbook contained ' + playbook.length + ' steps:</strong></p>';
    debriefHtml += '<div style="font-family:var(--font-mono);font-size:11px;color:var(--text-2);padding:12px;background:var(--surface-0);border-radius:8px;border:1px solid var(--border);margin:8px 0 16px;line-height:2;">';
    playbook.forEach(function(step, i) {
      debriefHtml += (i + 1) + '. [' + step.typeLabel + '] ' + step.name + '<br>';
    });
    debriefHtml += '</div>';

    // ROI calculation
    var autoHandled = Math.round(200 * accuracy / 100);
    var hoursSaved = Math.round(autoHandled * 15 / 60);
    debriefHtml += '<p><strong>Projected automation impact:</strong></p>';
    debriefHtml += '<p>At ' + accuracy + '% accuracy on 200 weekly alerts: ~' + autoHandled + ' alerts auto-handled, saving ~' + hoursSaved + ' analyst-hours per week.</p>';
    debriefHtml += '</div>';

    document.getElementById('debrief-results').innerHTML = debriefHtml;

    // Show debrief
    document.getElementById('test-container').style.display = 'none';
    document.getElementById('siem-header').style.display = 'none';
    var debrief = document.getElementById('blue-debrief');
    debrief.classList.add('visible');
    debrief.style.flex = '1';
    debrief.style.overflowY = 'auto';
  }

  function addEvidence(text) {
    var log = document.getElementById('evidence-log');
    if (log.querySelector('.evidence-empty')) log.innerHTML = '';
    var elapsed = PenumbraLabs.Timer.getElapsed();
    var time = PenumbraLabs.Timer.format(elapsed);
    log.innerHTML += '<div class="evidence-item"><div class="evidence-item-time">' + time + '</div><div class="evidence-item-text">' + text + '</div></div>';
  }

  // Initial render
  renderActions();
  renderFlow();
})();
</script>