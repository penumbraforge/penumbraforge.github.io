<div class="soc-case-header">INC-2024-1250</div>
<div class="soc-case-id">Recurring Automated Scanner Generating Alert Fatigue</div>
<div class="soc-case-narrative">
  Your SOC team is drowning. A recurring automated scanner is generating hundreds of alerts per week, and analysts are spending valuable time triaging repetitive noise. The CISO wants automation.
  <br><br>
  Investigate the alert stream to identify the scanning pattern, determine what triggers the alerts, find the right detection thresholds, and build an automated response playbook that reduces alert fatigue while still catching real threats.
</div>

<div class="soc-case-goal">
  <div class="soc-case-goal-label">Objective 1</div>
  <div class="soc-case-goal-text">Identify the recurring scanning pattern in the SIEM data</div>
</div>
<div class="soc-case-goal">
  <div class="soc-case-goal-label">Objective 2</div>
  <div class="soc-case-goal-text">Determine the automation triggers and threshold values</div>
</div>
<div class="soc-case-goal">
  <div class="soc-case-goal-label">Objective 3</div>
  <div class="soc-case-goal-text">Build the containment playbook with appropriate response actions</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  'use strict';

  var Labs = window.PenumbraLabs;

  // ── Scenario Definition ──
  var scenario = {
    id: 'blue-soar-playbook',
    type: 'blue',
    title: 'Build the Playbook',
    difficulty: 'advanced',
    estimatedTime: 25,
    xpReward: 350,
    skills: ['soar-playbook-design', 'soar-automation', 'triage-alert-fatigue'],
    unlocks: [],
    optimalActions: 14,
    techniqueChecks: [
      { id: 'searched-siem', check: function(log) { return log.some(function(a) { return a.type === 'siem_action'; }); }, points: 20 },
      { id: 'pivoted-ip', check: function(log) { return log.some(function(a) { return a.type === 'siem_action' && a.action === 'pivot'; }); }, points: 20 },
      { id: 'used-ioc', check: function(log) { return log.some(function(a) { return a.type === 'ioc_lookup'; }); }, points: 20 },
      { id: 'built-timeline', check: function(log) { return log.some(function(a) { return a.type === 'timeline_action'; }); }, points: 20 },
      { id: 'submitted-containment', check: function(log) { return log.some(function(a) { return a.type === 'containment_action'; }); }, points: 20 }
    ],

    stateGraph: {
      states: {
        'start': { transitions: {
          'found_pattern': 'pattern_found',
          'found_trigger': 'trigger_found',
          'found_threshold': 'threshold_found'
        }},
        'pattern_found': { transitions: {
          'found_trigger': 'multiple_evidence',
          'found_threshold': 'multiple_evidence',
          'found_pattern': 'pattern_found'
        }},
        'trigger_found': { transitions: {
          'found_pattern': 'multiple_evidence',
          'found_threshold': 'multiple_evidence',
          'found_trigger': 'trigger_found'
        }},
        'threshold_found': { transitions: {
          'found_pattern': 'multiple_evidence',
          'found_trigger': 'multiple_evidence',
          'found_threshold': 'threshold_found'
        }},
        'multiple_evidence': { transitions: {
          'found_pattern': 'multiple_evidence',
          'found_trigger': 'multiple_evidence',
          'found_threshold': 'multiple_evidence',
          'playbook_built': 'playbook_complete',
          'report_submitted': 'playbook_complete'
        }},
        'playbook_complete': { terminal: true }
      },
      initialState: 'start'
    },

    validationRules: {
      'found_pattern': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'scan-pattern';
        }
      },
      'found_trigger': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'alert-trigger';
        }
      },
      'found_threshold': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'threshold-value';
        }
      },
      'playbook_built': {
        trigger: 'timeline_action',
        condition: function(action) {
          return action.type === 'timeline_add' &&
                 Labs.Timeline.getEvents().length >= 4;
        }
      },
      'report_submitted': {
        trigger: 'containment_action',
        condition: function(action) {
          return action.type === 'containment_submit' && action.score >= 60;
        }
      }
    },

    nudges: {
      'start': {
        delay: 120,
        text: 'Start by filtering the SIEM for firewall events. Look for a source IP that appears repeatedly with the same scan pattern.'
      },
      'pattern_found': {
        delay: 180,
        text: 'Good, you found the scanner. Now determine what rule is triggering the alerts and what threshold would separate real threats from noise.'
      },
      'multiple_evidence': {
        delay: 240,
        text: 'You have the pattern and triggers. Build your playbook: pin key events to the timeline and submit your containment actions (block, WAF, preserve evidence).'
      }
    },

    objectives: [
      { id: 'found_pattern', title: 'Scanning Pattern Identified' },
      { id: 'found_trigger', title: 'Alert Trigger Determined' },
      { id: 'found_threshold', title: 'Threshold Value Found' },
      { id: 'playbook_built', title: 'Playbook Timeline Built' },
      { id: 'report_submitted', title: 'Playbook Actions Submitted' }
    ],

    evidencePieces: [
      { id: 'scan-pattern', label: 'Recurring scanner: 198.51.100.200 (weekly SYN scan)' },
      { id: 'alert-trigger', label: 'Port scan rule triggers at 100 ports/minute' },
      { id: 'threshold-value', label: 'Optimal threshold: 500 ports/5min with source exclusion' },
      { id: 'scanner-schedule', label: 'Scanner runs every Tuesday 03:00-03:30 UTC' },
      { id: 'real-scan', label: 'Actual malicious scan from 45.33.32.156 detected' },
      { id: 'playbook-design', label: 'Automated playbook with enrichment and thresholds' }
    ],

    knownIOCs: {
      '198.51.100.200': {
        type: 'IPv4', reputation: 'Benign', score: 8,
        geo: 'Portland, OR, USA', asn: 'AS15169 Google Cloud',
        firstSeen: '2023-06-15', lastSeen: '2026-03-22',
        associations: ['Vulnerability scanner', 'Qualys agent', 'Scheduled scan'],
        tags: ['scanner', 'internal-tool', 'benign']
      },
      '45.33.32.156': {
        type: 'IPv4', reputation: 'Malicious', score: 89,
        geo: 'Fremont, CA, USA', asn: 'AS63949 Linode',
        firstSeen: '2026-03-18', lastSeen: '2026-03-22',
        associations: ['Reconnaissance scanning', 'Nmap fingerprinting', 'Pre-attack enumeration'],
        tags: ['scanner', 'recon', 'suspicious']
      }
    },

    expectedActions: ['block-ip', 'enable-waf', 'preserve-evidence']
  };

  // ── Initialize Panel System ──
  Labs.PanelSystem.init({
    container: document.getElementById('workspace'),
    panels: [
      { id: 'panel-casefile', minWidth: 220, defaultWidth: 280 },
      { id: 'panel-siem', flex: true },
      { id: 'panel-tools', minWidth: 280, defaultWidth: 340 }
    ]
  });

  // ── Get Evidence Corpus ──
  var corpus = Labs.EvidenceCorpus.get('blue-soar-playbook');

  // Apply procedural randomization so evidence differs each run
  if (Labs.Procedural) {
    var tpl = Labs.EvidenceCorpus.getTemplate('blue-soar-playbook');
    if (tpl) {
      corpus = Labs.Procedural.apply(corpus, tpl);

      // Rebuild knownIOCs from randomized corpus.
      // The corpus scanner IP (originally 23.94.12.88) is randomized,
      // so we add the new IP to knownIOCs as malicious.
      var scannerIp = null;
      for (var _i = 0; _i < corpus.length; _i++) {
        if (corpus[_i].evidenceId === 'scan-pattern' && corpus[_i].detail && corpus[_i].detail.srcIp) {
          scannerIp = corpus[_i].detail.srcIp;
          break;
        }
      }
      if (scannerIp && scannerIp !== '23.94.12.88') {
        // Map the new scanner IP to the malicious IOC data
        scenario.knownIOCs[scannerIp] = {
          type: 'IPv4', reputation: 'Malicious', score: 89,
          geo: 'Fremont, CA, USA', asn: 'AS63949 Linode',
          firstSeen: '2026-03-18', lastSeen: '2026-03-22',
          associations: ['Reconnaissance scanning', 'Nmap fingerprinting', 'Pre-attack enumeration'],
          tags: ['scanner', 'recon', 'suspicious']
        };
      }
    }
  }

  // ── Track evidence discoveries ──
  var discoveredEvidence = {};
  var totalEvidence = scenario.evidencePieces.length;

  function updateEvidenceTracker(evidenceId) {
    if (discoveredEvidence[evidenceId]) return;
    discoveredEvidence[evidenceId] = true;

    var panel = document.getElementById('evidence-panel');
    if (panel) {
      var items = panel.querySelectorAll('.soc-evidence-item');
      items.forEach(function(item) {
        if (item.getAttribute('data-evidence-id') === evidenceId) {
          item.classList.remove('undiscovered');
          item.classList.add('discovered');
          var icon = item.querySelector('.soc-evidence-icon');
          if (icon) icon.textContent = '\u2713';
        }
      });
    }

    var count = Object.keys(discoveredEvidence).length;
    var el = document.getElementById('soc-evidence-count');
    if (el) el.textContent = 'Evidence: ' + count + '/' + totalEvidence;
  }

  // ── Initialize Simulation Engine ──
  var sim = Labs.Simulation.init({
    scenario: scenario,
    bridge: Labs.SimulationBridge,
    onStateChange: function(fromState, toState, action) {
      Labs.Toast.show('Evidence discovered', 'success');

      if (action && action.entry && action.entry.evidenceId) {
        updateEvidenceTracker(action.entry.evidenceId);
      }

      var el = document.getElementById('soc-event-count');
      if (el) el.textContent = 'Events: ' + corpus.length;
    },
    onComplete: function() {
      var elapsed = Labs.Timer.stop();
      var evidenceCount = Object.keys(discoveredEvidence).length;
      var scoringData = {
        actionsLog: sim.getActionsLog(),
        nudgesShown: sim._nudgeRef ? sim._nudgeRef._shownCount || 0 : 0,
        nudgesDismissed: sim._nudgeRef ? sim._nudgeRef._dismissCount || 0 : 0,
        evidenceFound: evidenceCount,
        totalEvidence: totalEvidence
      };
      var result = Labs.SimulationBridge.onLabComplete(scenario.id, scenario, elapsed, scoringData);
      showCompletion(result, elapsed);
    }
  });

  // ── Rename center tabs: SIEM -> Playbook Builder, Firewall -> SIEM ──
  var siemTabBtn = document.querySelector('#siem-tabs .soc-tool-tab[data-tool="siem"]');
  if (siemTabBtn) siemTabBtn.textContent = 'Playbook Builder';
  var fwTabBtn = document.querySelector('#siem-tabs .soc-tool-tab[data-tool="firewall"]');
  if (fwTabBtn) fwTabBtn.textContent = 'SIEM';

  // ── Initialize Playbook Builder as primary center tool ──
  Labs.PlaybookBuilder.init({
    container: document.getElementById('tool-siem'),
    onPlaybookSubmit: function(playbook) {
      // Score the playbook
      var hasTrigger = false, hasCondition = false, hasAction = false, hasEnrich = false;
      playbook.forEach(function(step) {
        if (step.category === 'Triggers')   hasTrigger = true;
        if (step.category === 'Conditions') hasCondition = true;
        if (step.category === 'Actions')    hasAction = true;
        if (step.category === 'Enrichment') hasEnrich = true;
      });
      var score = 0;
      if (hasTrigger)   score += 25;
      if (hasCondition) score += 25;
      if (hasAction)    score += 25;
      if (hasEnrich)    score += 25;

      sim.dispatch({ type: 'containment_action', type: 'containment_submit', score: score, selected: playbook.map(function(s) { return s.actionId; }) });

      if (score >= 60) {
        updateEvidenceTracker('playbook-design');
        Labs.Toast.show('Playbook submitted (' + score + '/100)', 'success');
      } else {
        Labs.Toast.show('Playbook needs improvement (' + score + '/100)', 'warning');
      }
    }
  });

  // ── Initialize SIEM on the Firewall tab as secondary log view ──
  Labs.SIEM.init({
    container: document.getElementById('tool-firewall'),
    evidenceCorpus: corpus,
    onAction: function(action) {
      sim.dispatch({ type: 'siem_action', action: action.action, entry: action.entry });

      if (action.action === 'timeline') {
        Labs.Timeline.addEvent({
          timestamp: action.entry.timestamp,
          title: action.entry.summary.replace(/<[^>]+>/g, '').substring(0, 80),
          description: action.entry.source.toUpperCase() + ' \u2014 ' + action.entry.severity,
          severity: action.entry.severity,
          sources: [action.entry.source],
          userDiscovered: true
        });
      }
      if (action.action === 'ioc_lookup' && action.entry.detail) {
        var iocTab = document.querySelector('[data-right-tool="ioc"]');
        if (iocTab) iocTab.click();
        Labs.IOCLookup.lookup(action.entry.detail.srcIp);
      }
      if (action.action === 'evidence' && action.entry.evidenceId) {
        updateEvidenceTracker(action.entry.evidenceId);
      }
    }
  });

  // ── Render source-filtered log views (auth, dns) as static tables ──
  // Note: Labs.SIEM is a singleton — calling init() multiple times overwrites
  // its state. Use a simple inline renderer for the filtered-source tabs.
  (function() {
    var SEV_CLASS = { critical: 'sev-crit', high: 'sev-high', medium: 'sev-med', low: 'sev-low', info: 'sev-info' };
    var SEV_LABEL = { critical: 'CRIT', high: 'HIGH', medium: 'MED', low: 'LOW', info: 'INFO' };

    function renderFilteredLogs(containerId, source) {
      var container = document.getElementById(containerId);
      if (!container) return;
      var filtered = corpus.filter(function(e) { return e.source === source; });

      var html = '<div class="siem-filtered-view">';
      html += '<div class="siem-toolbar" style="padding:8px 12px;font-size:11px;color:var(--text-3);">';
      html += 'Showing ' + filtered.length + ' ' + source.toUpperCase() + ' log entries</div>';
      html += '<div class="siem-stream" style="overflow-y:auto;flex:1;">';

      if (filtered.length === 0) {
        html += '<div style="padding:24px;color:var(--text-3);font-size:12px;text-align:center;">No ' + source.toUpperCase() + ' log entries in this dataset.</div>';
      } else {
        for (var i = 0; i < filtered.length; i++) {
          var e = filtered[i];
          var sev = e.severity || 'info';
          var sevCls = SEV_CLASS[sev] || 'sev-info';
          var sevLabel = SEV_LABEL[sev] || 'INFO';
          var ts = e.timestamp || '';
          var summary = e.summary || e.message || '';
          // Strip any HTML tags from summary for safe display
          var div = document.createElement('div');
          div.innerHTML = summary;
          var plainSummary = div.textContent || div.innerText || summary;

          html += '<div class="siem-row" style="display:flex;align-items:center;gap:8px;padding:6px 12px;border-bottom:1px solid var(--border-subtle);font-size:11px;">';
          html += '<span class="siem-sev ' + sevCls + '" style="flex-shrink:0;">' + sevLabel + '</span>';
          html += '<span class="siem-ts" style="color:var(--text-3);flex-shrink:0;font-family:monospace;">' + ts.substring(0, 19) + '</span>';
          html += '<span class="siem-summary" style="color:var(--text-2);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + plainSummary + '</span>';
          html += '</div>';
        }
      }

      html += '</div></div>';
      container.innerHTML = html;
    }

    renderFilteredLogs('tool-auth', 'auth');
    renderFilteredLogs('tool-dns', 'dns');
  }());

  // ── Hide irrelevant tabs (Packet Capture, Threat Intel) for SOAR lab ──
  (function() {
    var hideTools = ['pcap', 'threatintel'];
    hideTools.forEach(function(tool) {
      var btn = document.querySelector('#siem-tabs .soc-tool-tab[data-tool="' + tool + '"]');
      if (btn) btn.style.display = 'none';
      var pane = document.getElementById('tool-' + tool);
      if (pane) {
        pane.innerHTML = '<div style="padding:24px;color:var(--text-3);font-size:12px;text-align:center;">This data source is not available for this scenario.</div>';
      }
    });
  }());

  // ── Initialize Timeline ──
  Labs.Timeline.init({
    container: document.getElementById('tool-timeline'),
    onAction: function(action) {
      sim.dispatch({ type: 'timeline_action', type: action.type, event: action.event });
      if (Labs.Timeline.getEvents().length >= 4) {
        updateEvidenceTracker('playbook-design');
      }
    }
  });

  // ── Initialize IOC Lookup ──
  Labs.IOCLookup.init({
    container: document.getElementById('tool-ioc'),
    knownIOCs: scenario.knownIOCs,
    onAction: function(action) {
      sim.dispatch(action);
    }
  });

  // ── Initialize Actions ──
  Labs.SOCActions.init({
    container: document.getElementById('tool-actions'),
    expectedActions: scenario.expectedActions,
    onAction: function(action) {
      sim.dispatch({ type: 'containment_action', type: action.type, score: action.score, selected: action.selected });
    }
  });

  // ── Start Timer ──
  Labs.Timer.start(function(elapsed) {
    var el = document.getElementById('lab-timer');
    if (el) el.textContent = Labs.Timer.format(elapsed);
  });

  // ── Update level display ──
  var profile = Labs.Progress.getProfile();
  var levelEl = document.getElementById('soc-level');
  if (levelEl) levelEl.textContent = 'Level ' + profile.level + ' \u00b7 ' + Labs.Xp.titleForLevel(profile.level);

  // ── Update event count ──
  var evtEl = document.getElementById('soc-event-count');
  if (evtEl) evtEl.textContent = 'Events: ' + corpus.length;

  // ── Completion handler ──
  function showCompletion(result, elapsed) {
    document.getElementById('complete-time').textContent = Labs.Timer.format(elapsed);
    document.getElementById('complete-score').textContent = result.scoring ? result.scoring.composite : 100;
    document.getElementById('complete-xp').textContent = '+' + (result.scoring ? result.scoring.xp : result.xp);
    document.getElementById('complete-level').textContent = 'Level ' + result.level + ' \u2014 ' + Labs.Xp.titleForLevel(result.level);

    if (scenario.unlocks && scenario.unlocks.length > 0) {
      var unlockEl = document.getElementById('complete-unlock');
      if (unlockEl) {
        unlockEl.style.display = '';
      }
    }

    document.getElementById('lab-complete-overlay').classList.add('visible');

    var reportPanel = document.getElementById('report-panel');
    if (reportPanel && Labs.Debrief) {
      reportPanel.style.display = '';

      var evidenceHtml = '<div class="debrief-evidence">';
      scenario.evidencePieces.forEach(function(piece) {
        var found = !!discoveredEvidence[piece.id];
        evidenceHtml += '<div class="debrief-evidence-item ' + (found ? 'found' : 'missed') + '">' +
          (found ? '\u2713 ' : '\u2717 ') + piece.label + '</div>';
      });
      evidenceHtml += '</div>';

      Labs.Debrief.render({
        container: reportPanel,
        scoring: result.scoring,
        elapsed: elapsed,
        scenario: scenario,
        debriefContent: {
          analysis: '<div class="debrief-card"><h3>Incident: Alert Fatigue from Recurring Scanner</h3><p>The primary noise source was <code>198.51.100.200</code> — a legitimate Qualys vulnerability scanner running weekly SYN scans every Tuesday at 03:00 UTC. The port scan detection rule triggered because its threshold (100 ports/minute) was too aggressive for scheduled security scans.</p><p>Hidden in the noise was a real threat: <code>45.33.32.156</code> conducted Nmap reconnaissance against the external perimeter, fingerprinting services and probing for vulnerabilities. This genuine attack was nearly lost in the flood of false positives from the legitimate scanner.</p></div>' + '<div class="debrief-card"><h3>Evidence Summary</h3>' + evidenceHtml + '</div>',

          framework: '<div class="debrief-card"><h3>SOAR Automation Principles</h3><p><strong>Enrich before deciding:</strong> Every automated playbook should gather context (IP reputation, asset ownership, scan schedule) before taking action. A scan from a known vulnerability scanner requires different handling than a scan from an unknown external IP.</p><p><strong>Threshold tuning:</strong> The original rule triggered at 100 ports/minute — too sensitive for scheduled scans but appropriate for detecting slow reconnaissance. Solution: create a separate rule that excludes known scanner IPs from the port scan threshold, while keeping the threshold for unknown sources.</p><p><strong>Tiered response:</strong> Auto-close alerts from known scanners during scheduled windows. Auto-enrich and escalate for unknown scanners. Auto-block for scanners with high threat intel scores.</p></div>' + '<div class="debrief-card"><h3>Alert Fatigue Reduction</h3><p><strong>The problem:</strong> With 200+ scanner alerts per week and 15 minutes per triage, analysts spend 50+ hours weekly on repetitive noise. This causes alert fatigue, missed real threats, and analyst burnout.</p><p><strong>The fix:</strong> Implementing three SOAR playbooks would auto-handle 80% of scanner alerts:</p><p>1. <strong>Known Scanner Auto-Close:</strong> If source IP matches asset inventory scanner list AND scan occurs during scheduled window, auto-acknowledge with a note.</p><p>2. <strong>Unknown Scanner Enrichment:</strong> If source IP is unknown, query threat intel, check GeoIP, and assess scan aggressiveness. Escalate if reputation score > 70.</p><p>3. <strong>Malicious Scanner Auto-Block:</strong> If threat intel score > 85 and port scan exceeds 500 ports, auto-block at WAF and create incident ticket.</p></div>',

          code: '<div class="debrief-section-title">Playbook Logic</div><div class="debrief-code"><span class="vuln">TRIGGER: Port scan alert received\n\nSTEP 1 — ENRICH: Check source IP against asset inventory\n  IF known scanner AND within schedule window:\n    -> Auto-close, log as "scheduled scan"\n\nSTEP 2 — ENRICH: Query threat intelligence (VirusTotal, AbuseIPDB)\n  Store reputation_score, geo, ASN\n\nSTEP 3 — DECISION: reputation_score > 70?\n  YES -> STEP 4 (malicious path)\n  NO  -> STEP 5 (suspicious path)\n\nSTEP 4 — ACTION (malicious):\n  Block IP at WAF\n  Create P2 incident ticket\n  Notify SOC lead\n\nSTEP 5 — DECISION: ports_scanned > 500 in 5 min?\n  YES -> Create P3 ticket for analyst review\n  NO  -> Auto-close as low-risk recon</span></div><div class="debrief-section-title" style="margin-top:16px;">Scanner Comparison</div><div class="debrief-code"><span class="fix">BENIGN: 198.51.100.200 (Qualys scanner)\n  Schedule: Tuesdays 03:00 UTC\n  Pattern: Sequential SYN scan, 1024 ports\n  Reputation: 8/100 (known scanner)\n  Action: Auto-close\n\nMALICIOUS: 45.33.32.156 (Nmap recon)\n  Schedule: Ad-hoc, non-business hours\n  Pattern: Service fingerprinting, OS detection\n  Reputation: 89/100 (suspicious VPS)\n  Action: Block IP, create incident</span></div>',

          crossPerspective: {
            title: 'What the Attacker Did',
            description: 'The real attacker at 45.33.32.156 timed their reconnaissance to coincide with periods of high alert volume from the legitimate scanner. This is a common technique: attackers who understand SOC operations know that alert fatigue creates blind spots. By scanning during noisy periods, they reduce the chance of their activity being noticed and investigated.',
            linkText: 'Try the Red Team Attack \u2192',
            linkHref: '/labs/red/recon/'
          }
        }
      });
    }

    var statusEl = document.getElementById('soc-mission-status');
    if (statusEl) {
      statusEl.textContent = '\u2713 Incident Resolved';
      statusEl.style.color = '#4ade80';
    }
  }
});
</script>
