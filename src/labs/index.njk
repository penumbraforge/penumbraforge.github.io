<script src="/js/lab-engine.js"></script>
<script>
(function() {
  var Labs = PenumbraLabs;
  var profile = Labs.Progress.getProfile();
  var counts = Labs.Progress.getLabCount();
  var level = Labs.Xp.levelForXp(profile.xp);
  var title = Labs.Xp.titleForLevel(level);
  var progress = Labs.Xp.progressToNextLevel(profile.xp);
  var nextXp = Labs.Xp.xpForNextLevel(level);

  document.getElementById('profile-name').textContent = profile.alias || 'Anonymous Operator';
  document.getElementById('profile-level').textContent = 'Level ' + level + ' — ' + title;
  document.getElementById('profile-xp-text').textContent = profile.xp + ' / ' + nextXp;
  document.getElementById('profile-xp-fill').style.width = Math.round(progress * 100) + '%';
  document.getElementById('profile-completed').textContent = counts.completed;
  document.getElementById('profile-inprogress').textContent = counts.inProgress;

  var completed = Labs.Progress.getCompletedLabs();
  completed.forEach(function(labId) {
    var slugMap = {
      'red-xss-shopstack': 'xss-shopstack', 'red-sqli-vaultbank': 'sqli-vaultbank',
      'red-ssrf-cloudsnap': 'ssrf-cloudsnap', 'red-jwt-devportal': 'jwt-devportal',
      'red-race-giftrush': 'race-giftrush', 'red-idor-medconnect': 'idor-medconnect',
      'blue-alert-triage': 'alert-triage', 'blue-investigate-shopstack': 'investigate-shopstack',
      'blue-phishing-analysis': 'phishing-analysis', 'blue-log-analysis': 'log-analysis',
      'blue-containment': 'containment', 'blue-soar-playbook': 'soar-playbook'
    };
    var slug = slugMap[labId];
    if (!slug) return;
    var link = document.querySelector('a[href*="' + slug + '"]');
    if (link) {
      link.classList.add('lab-card--completed');
      var cta = link.querySelector('.lab-card-cta');
      if (cta) cta.textContent = 'Replay lab →';
      var xp = link.querySelector('.lab-card-xp');
      var prog = Labs.Progress.getLabProgress(labId);
      if (xp && prog) xp.innerHTML = '&#x2713; ' + prog.score + '/100';
      if (xp) xp.style.color = 'var(--sage)';
    }
  });

  Labs.ForgeKeyUI.init();
  document.getElementById('btn-forge-key').addEventListener('click', function() { Labs.ForgeKeyUI.show(); });
})();
</script>
