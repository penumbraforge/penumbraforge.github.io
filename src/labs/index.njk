<script src="/js/lab-engine.js"></script>
<script>
(function() {
  var Labs = PenumbraLabs;
  var profile = Labs.Progress.getProfile();
  var counts = Labs.Progress.getLabCount();
  var level = Labs.Xp.levelForXp(profile.xp);
  var title = Labs.Xp.titleForLevel(level);
  var progress = Labs.Xp.progressToNextLevel(profile.xp);
  var nextXp = Labs.Xp.xpForNextLevel(level);
  var currentXp = Labs.Xp.xpForLevel(level);

  document.getElementById('profile-name').textContent = profile.alias || 'Anonymous Operator';
  document.getElementById('profile-level').textContent = 'Level ' + level + ' — ' + title;
  document.getElementById('profile-xp-text').textContent = profile.xp + ' / ' + nextXp;
  document.getElementById('profile-xp-fill').style.width = Math.round(progress * 100) + '%';
  document.getElementById('profile-completed').textContent = counts.completed;
  document.getElementById('profile-inprogress').textContent = counts.inProgress;

  // Forge Key modal
  Labs.ForgeKeyUI.init();
  document.getElementById('btn-forge-key').addEventListener('click', function() {
    Labs.ForgeKeyUI.show();
  });
})();
</script>
