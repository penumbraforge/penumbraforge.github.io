  var viewer = document.getElementById('log-viewer');
  var searchInput = document.getElementById('log-search');
  var sourceFilter = document.getElementById('log-source-filter');
  var severityFilter = document.getElementById('log-severity-filter');

  function renderLogs() {
    var search = (searchInput.value || '').toLowerCase();
    var source = sourceFilter.value;
    var severity = severityFilter.value;

    var filtered = LOGS.filter(function(log) {
      if (source !== 'all' && log.source !== source) return false;
      if (severity !== 'all' && log.level !== severity) return false;
      if (search) {
        var text = log.msg.replace(/<[^>]+>/g, '').toLowerCase();
        if (text.indexOf(search) === -1 && log.time.indexOf(search) === -1) return false;
      }
      return true;
    });

    document.getElementById('log-count').textContent = filtered.length + ' / ' + LOGS.length;

    var html = '';
    filtered.forEach(function(log) {
      html += '<div class="log-entry' + (log.suspicious ? ' highlighted' : '') + '">' +
        '<span class="log-time">' + log.time + '</span>' +
        '<span class="log-source-tag log-src-' + log.source + '">' + log.source + '</span>' +
        '<span class="log-level log-lvl-' + log.level + '">' + log.level + '</span>' +
        '<span class="log-msg">' + log.msg + '</span>' +
      '</div>';
    });

    viewer.innerHTML = html || '<div style="text-align:center;padding:40px;color:var(--muted);">No logs match your filters.</div>';
  }

  searchInput.addEventListener('input', renderLogs);
  sourceFilter.addEventListener('change', renderLogs);
  severityFilter.addEventListener('change', renderLogs);

  function addEvidence(text) {
    var log = document.getElementById('evidence-log');
    if (log.querySelector('.evidence-empty')) log.innerHTML = '';
    var elapsed = PenumbraLabs.Timer.getElapsed();
    var time = PenumbraLabs.Timer.format(elapsed);
    log.innerHTML += '<div class="evidence-item"><div class="evidence-item-time">' + time + '</div><div class="evidence-item-text">' + text + '</div></div>';
  }

  // Submit findings
  document.getElementById('btn-submit').addEventListener('click', function() {
    var ip = document.getElementById('answer-ip').value.trim();
    var access = document.getElementById('answer-access').value.trim().toLowerCase();
    var exfil = document.getElementById('answer-exfil').value.trim().toLowerCase();

    var allCorrect = true;

    // Check attacker IP
    if (ip === '103.78.44.91') {
      Engine.tryCompleteObjective('attacker');
      addEvidence('Correctly identified attacker IP: 103.78.44.91');
    } else if (ip) {
      Toast.show('Incorrect IP — look for an external IP that appears across multiple log sources', 'error');
      addEvidence('Submitted incorrect attacker IP: ' + ip);
      allCorrect = false;
    } else {
      allCorrect = false;
    }

    // Check access method
    if (access.indexOf('ssh') !== -1) {
      Engine.tryCompleteObjective('access');
      addEvidence('Correctly identified initial access: SSH with stolen credentials');
    } else if (access) {
      Toast.show('Check the auth logs around 04:22 — what protocol was used?', 'error');
      addEvidence('Submitted incorrect access method: ' + access);
      allCorrect = false;
    } else {
      allCorrect = false;
    }

    // Check exfiltration
    if ((exfil.indexOf('financial') !== -1 || exfil.indexOf('report') !== -1 || exfil.indexOf('earning') !== -1) ||
        (exfil.indexOf('2.1') !== -1 && exfil.indexOf('gb') !== -1) ||
        (exfil.indexOf('scp') !== -1 && exfil.indexOf('2.1') !== -1)) {
      Engine.tryCompleteObjective('exfil');
      addEvidence('Correctly identified exfiltrated data: financial reports (2.1 GB)');
    } else if (exfil) {
      Toast.show('Check the web and firewall logs — what files were accessed and how much data was transferred?', 'error');
      addEvidence('Submitted incorrect exfiltration details: ' + exfil);
      allCorrect = false;
    } else {
      allCorrect = false;
    }

    // Final submit
    var progress = Engine.getProgress();
    if (progress.objectivesCompleted.length >= 3 || (allCorrect && ip && access && exfil)) {
      Engine.tryCompleteObjective('submit');

      // Show debrief
      document.getElementById('log-viewer').style.display = 'none';
      document.getElementById('siem-header').style.display = 'none';
      document.querySelector('.siem-summary').style.display = 'none';
      // Hide search bar
      var searchBar = document.querySelector('.blue-dashboard > div:nth-child(2)');
      if (searchBar) searchBar.style.display = 'none';
      var debrief = document.getElementById('blue-debrief');
      debrief.style.display = '';
      debrief.style.flex = '1';
      debrief.style.overflowY = 'auto';
    }
  });

  // Initial render
  renderLogs();
})();
</script>
