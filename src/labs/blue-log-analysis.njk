<div class="soc-case-header">INC-2024-1023</div>
<div class="soc-case-id">Possible Data Exfiltration via DNS Tunneling</div>
<div class="soc-case-narrative">
  At 06:00 UTC, the DLP system flagged a large outbound transfer that completed overnight. Management wants answers: who did this, how did they get in, and what did they take? You have 200 log entries from 4 sources spanning the incident window.
  <br><br>
  Most of these logs are normal business traffic — health checks, routine logins, standard browsing. One threat actor is hiding in the noise. Correlate across sources to find the beacon pattern, identify the C2 domain, and trace the exfiltrated data.
</div>

<div class="soc-case-goal">
  <div class="soc-case-goal-label">Objective 1</div>
  <div class="soc-case-goal-text">Identify the beacon pattern in DNS traffic</div>
</div>
<div class="soc-case-goal">
  <div class="soc-case-goal-label">Objective 2</div>
  <div class="soc-case-goal-text">Find the C2 domain used for DNS tunneling</div>
</div>
<div class="soc-case-goal">
  <div class="soc-case-goal-label">Objective 3</div>
  <div class="soc-case-goal-text">Trace the exfiltrated data and identify the compromised host</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  'use strict';

  var Labs = window.PenumbraLabs;

  // ── Scenario Definition ──
  var scenario = {
    id: 'blue-log-analysis',
    type: 'blue',
    title: 'Signal in the Noise',
    difficulty: 'intermediate',
    estimatedTime: 25,
    xpReward: 250,
    skills: ['investigation-log-analysis', 'investigation-correlation', 'investigation-dns-tunneling'],
    unlocks: [],
    optimalActions: 12,
    techniqueChecks: [
      { id: 'searched-siem', check: function(log) { return log.some(function(a) { return a.type === 'siem_action'; }); }, points: 20 },
      { id: 'pivoted-ip', check: function(log) { return log.some(function(a) { return a.type === 'siem_action' && a.action === 'pivot'; }); }, points: 20 },
      { id: 'used-ioc', check: function(log) { return log.some(function(a) { return a.type === 'ioc_lookup'; }); }, points: 20 },
      { id: 'built-timeline', check: function(log) { return log.some(function(a) { return a.type === 'timeline_action'; }); }, points: 20 },
      { id: 'submitted-containment', check: function(log) { return log.some(function(a) { return a.type === 'containment_action'; }); }, points: 20 }
    ],

    stateGraph: {
      states: {
        'start': { transitions: {
          'found_beacon': 'beacon_found',
          'found_c2_domain': 'c2_found',
          'found_tunnel': 'tunnel_found',
          'found_host': 'host_found'
        }},
        'beacon_found': { transitions: {
          'found_c2_domain': 'multiple_evidence',
          'found_tunnel': 'multiple_evidence',
          'found_host': 'multiple_evidence'
        }},
        'c2_found': { transitions: {
          'found_beacon': 'multiple_evidence',
          'found_tunnel': 'multiple_evidence',
          'found_host': 'multiple_evidence'
        }},
        'tunnel_found': { transitions: {
          'found_beacon': 'multiple_evidence',
          'found_c2_domain': 'multiple_evidence',
          'found_host': 'multiple_evidence'
        }},
        'host_found': { transitions: {
          'found_beacon': 'multiple_evidence',
          'found_c2_domain': 'multiple_evidence',
          'found_tunnel': 'multiple_evidence'
        }},
        'multiple_evidence': { transitions: {
          'found_beacon': 'multiple_evidence',
          'found_c2_domain': 'multiple_evidence',
          'found_tunnel': 'multiple_evidence',
          'found_host': 'multiple_evidence',
          'timeline_complete': 'investigation_complete',
          'report_submitted': 'investigation_complete'
        }},
        'investigation_complete': { terminal: true }
      },
      initialState: 'start'
    },

    validationRules: {
      'found_beacon': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'beacon-pattern';
        }
      },
      'found_c2_domain': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'c2-domain';
        }
      },
      'found_tunnel': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'dns-tunnel';
        }
      },
      'found_host': {
        trigger: 'siem_action',
        condition: function(action) {
          return action.action === 'evidence' && action.entry &&
                 action.entry.evidenceId && action.entry.evidenceId === 'compromised-host';
        }
      },
      'timeline_complete': {
        trigger: 'timeline_action',
        condition: function(action) {
          return action.type === 'timeline_add' &&
                 Labs.Timeline.getEvents().length >= 5;
        }
      },
      'report_submitted': {
        trigger: 'containment_action',
        condition: function(action) {
          return action.type === 'containment_submit' && action.score >= 60;
        }
      }
    },

    nudges: {
      'start': {
        delay: 120,
        text: 'Filter the DNS logs and look for unusual query patterns. External IPs querying internal hostnames is a red flag.'
      },
      'beacon_found': {
        delay: 180,
        text: 'You found the beacon. Now trace the full path — who logged in, what did they access, and where did data go?'
      },
      'multiple_evidence': {
        delay: 240,
        text: 'Good progress. Correlate the DNS anomaly with the auth and firewall logs. The same IP should appear across sources.'
      }
    },

    objectives: [
      { id: 'found_beacon', title: 'Beacon Pattern Identified' },
      { id: 'found_c2_domain', title: 'C2 Domain Discovered' },
      { id: 'found_tunnel', title: 'DNS Tunnel Confirmed' },
      { id: 'found_host', title: 'Compromised Host Located' },
      { id: 'timeline_complete', title: 'Timeline Built' },
      { id: 'report_submitted', title: 'Containment Plan Submitted' }
    ],

    evidencePieces: [
      { id: 'beacon-pattern', label: 'Periodic DNS beacon at regular intervals' },
      { id: 'c2-domain', label: 'C2 domain: data.exfil-tunnel.xyz' },
      { id: 'dns-tunnel', label: 'DNS TXT record tunneling confirmed' },
      { id: 'compromised-host', label: 'Compromised host: 10.0.1.50 (fileserver)' },
      { id: 'ssh-access', label: 'SSH access from 103.78.44.91 (Singapore)' },
      { id: 'data-exfil', label: '2.1 GB exfiltrated via SCP to 45.77.132.18' },
      { id: 'stolen-creds', label: 'j.nakamura credentials used for initial access' },
      { id: 'attack-timeline', label: 'Full attack timeline reconstructed' }
    ],

    knownIOCs: {
      '103.78.44.91': {
        type: 'IPv4', reputation: 'Malicious', score: 88,
        geo: 'Singapore, SG', asn: 'AS4844 SuperNet',
        firstSeen: '2024-02-01', lastSeen: '2024-03-22',
        associations: ['SSH brute force', 'Data exfiltration', 'VPS hosting'],
        tags: ['ssh-attacker', 'exfil', 'asia-pacific']
      },
      '45.77.132.18': {
        type: 'IPv4', reputation: 'Malicious', score: 82,
        geo: 'Amsterdam, Netherlands', asn: 'AS20473 Vultr',
        firstSeen: '2024-03-01', lastSeen: '2024-03-22',
        associations: ['Data staging', 'SCP exfiltration endpoint'],
        tags: ['exfil', 'staging', 'vps']
      },
      'data.exfil-tunnel.xyz': {
        type: 'Domain', reputation: 'Malicious', score: 96,
        geo: 'Unknown', asn: 'AS13335 Cloudflare',
        firstSeen: '2024-03-10', lastSeen: '2024-03-22',
        associations: ['DNS tunneling', 'C2 infrastructure', 'Data exfiltration'],
        tags: ['c2', 'dns-tunnel', 'newly-registered']
      }
    },

    expectedActions: ['block-domain', 'isolate-server', 'preserve-evidence', 'enable-waf']
  };

  // ── Initialize Panel System ──
  Labs.PanelSystem.init({
    container: document.getElementById('workspace'),
    panels: [
      { id: 'panel-casefile', minWidth: 220, defaultWidth: 280 },
      { id: 'panel-siem', flex: true },
      { id: 'panel-tools', minWidth: 280, defaultWidth: 340 }
    ]
  });

  // ── Get Evidence Corpus ──
  var corpus = Labs.EvidenceCorpus.get('blue-log-analysis');

  // Apply procedural randomization so evidence differs each run
  if (Labs.Procedural) {
    var tpl = Labs.EvidenceCorpus.getTemplate('blue-log-analysis');
    if (tpl) {
      corpus = Labs.Procedural.apply(corpus, tpl);

      // Rebuild knownIOCs from randomized corpus
      var c2Ip = null;
      var c2Domain = null;
      for (var _i = 0; _i < corpus.length; _i++) {
        var _e = corpus[_i];
        if (_e.evidenceId === 'c2-domain' && _e.detail) {
          if (_e.detail.response) c2Ip = _e.detail.response;
          if (_e.detail.domain) {
            // Extract base domain from subdomain (e.g. "aGVhcnRiZWF0.newdomain.xyz" -> "newdomain.xyz")
            var parts = _e.detail.domain.split('.');
            if (parts.length > 2) {
              c2Domain = parts.slice(1).join('.');
            } else {
              c2Domain = _e.detail.domain;
            }
          }
        }
      }
      if (c2Domain && c2Domain !== 'x9z-analytics.xyz') {
        if (scenario.knownIOCs['data.exfil-tunnel.xyz']) {
          scenario.knownIOCs['data.' + c2Domain] = scenario.knownIOCs['data.exfil-tunnel.xyz'];
          delete scenario.knownIOCs['data.exfil-tunnel.xyz'];
        }
      }
    }
  }

  // ── Track evidence discoveries ──
  var discoveredEvidence = {};
  var totalEvidence = scenario.evidencePieces.length;

  function updateEvidenceTracker(evidenceId) {
    if (discoveredEvidence[evidenceId]) return;
    discoveredEvidence[evidenceId] = true;

    var panel = document.getElementById('evidence-panel');
    if (panel) {
      var items = panel.querySelectorAll('.soc-evidence-item');
      items.forEach(function(item) {
        if (item.getAttribute('data-evidence-id') === evidenceId) {
          item.classList.remove('undiscovered');
          item.classList.add('discovered');
          var icon = item.querySelector('.soc-evidence-icon');
          if (icon) icon.textContent = '\u2713';
        }
      });
    }

    var count = Object.keys(discoveredEvidence).length;
    var el = document.getElementById('soc-evidence-count');
    if (el) el.textContent = 'Evidence: ' + count + '/' + totalEvidence;
  }

  // ── Initialize Simulation Engine ──
  var sim = Labs.Simulation.init({
    scenario: scenario,
    bridge: Labs.SimulationBridge,
    onStateChange: function(fromState, toState, action) {
      Labs.Toast.show('Evidence discovered', 'success');

      if (action && action.entry && action.entry.evidenceId) {
        updateEvidenceTracker(action.entry.evidenceId);
      }

      var el = document.getElementById('soc-event-count');
      if (el) el.textContent = 'Events: ' + corpus.length;
    },
    onComplete: function() {
      var elapsed = Labs.Timer.stop();
      var evidenceCount = Object.keys(discoveredEvidence).length;
      var scoringData = {
        actionsLog: sim.getActionsLog(),
        nudgesShown: sim._nudgeRef ? sim._nudgeRef._shownCount || 0 : 0,
        nudgesDismissed: sim._nudgeRef ? sim._nudgeRef._dismissCount || 0 : 0,
        evidenceFound: evidenceCount,
        totalEvidence: totalEvidence
      };
      var result = Labs.SimulationBridge.onLabComplete(scenario.id, scenario, elapsed, scoringData);
      showCompletion(result, elapsed);
    }
  });

  // ── Initialize SIEM ──
  Labs.SIEM.init({
    container: document.getElementById('tool-siem'),
    evidenceCorpus: corpus,
    onAction: function(action) {
      sim.dispatch({ type: 'siem_action', action: action.action, entry: action.entry });

      if (action.action === 'timeline') {
        Labs.Timeline.addEvent({
          timestamp: action.entry.timestamp,
          title: action.entry.summary.replace(/<[^>]+>/g, '').substring(0, 80),
          description: action.entry.source.toUpperCase() + ' \u2014 ' + action.entry.severity,
          severity: action.entry.severity,
          sources: [action.entry.source],
          userDiscovered: true
        });
      }
      if (action.action === 'ioc_lookup' && action.entry.detail) {
        var iocTab = document.querySelector('[data-right-tool="ioc"]');
        if (iocTab) iocTab.click();
        Labs.IOCLookup.lookup(action.entry.detail.srcIp);
      }
      if (action.action === 'evidence' && action.entry.evidenceId) {
        updateEvidenceTracker(action.entry.evidenceId);
      }
    }
  });

  // ── Initialize source-filtered SIEM views ──
  ['firewall', 'auth', 'dns'].forEach(function(source) {
    var container = document.getElementById('tool-' + source);
    if (container) {
      var sourceMap = { firewall: 'fw', auth: 'auth', dns: 'dns' };
      var filtered = corpus.filter(function(e) { return e.source === sourceMap[source]; });
      Labs.SIEM.init({
        container: container,
        evidenceCorpus: filtered,
        onAction: function(action) {
          sim.dispatch({ type: 'siem_action', action: action.action, entry: action.entry });
          if (action.action === 'evidence' && action.entry.evidenceId) {
            updateEvidenceTracker(action.entry.evidenceId);
          }
        }
      });
    }
  });

  // ── Initialize Timeline ──
  Labs.Timeline.init({
    container: document.getElementById('tool-timeline'),
    onAction: function(action) {
      sim.dispatch({ type: 'timeline_action', type: action.type, event: action.event });
      if (Labs.Timeline.getEvents().length >= 5) {
        updateEvidenceTracker('attack-timeline');
      }
    }
  });

  // ── Initialize IOC Lookup ──
  Labs.IOCLookup.init({
    container: document.getElementById('tool-ioc'),
    knownIOCs: scenario.knownIOCs,
    onAction: function(action) {
      sim.dispatch(action);
    }
  });

  // ── Initialize Actions ──
  Labs.SOCActions.init({
    container: document.getElementById('tool-actions'),
    expectedActions: scenario.expectedActions,
    onAction: function(action) {
      sim.dispatch({ type: 'containment_action', type: action.type, score: action.score, selected: action.selected });
    }
  });

  // ── Start Timer ──
  Labs.Timer.start(function(elapsed) {
    var el = document.getElementById('lab-timer');
    if (el) el.textContent = Labs.Timer.format(elapsed);
  });

  // ── Update level display ──
  var profile = Labs.Progress.getProfile();
  var levelEl = document.getElementById('soc-level');
  if (levelEl) levelEl.textContent = 'Level ' + profile.level + ' \u00b7 ' + Labs.Xp.titleForLevel(profile.level);

  // ── Update event count ──
  var evtEl = document.getElementById('soc-event-count');
  if (evtEl) evtEl.textContent = 'Events: ' + corpus.length;

  // ── Completion handler ──
  function showCompletion(result, elapsed) {
    document.getElementById('complete-time').textContent = Labs.Timer.format(elapsed);
    document.getElementById('complete-score').textContent = result.scoring ? result.scoring.composite : 100;
    document.getElementById('complete-xp').textContent = '+' + (result.scoring ? result.scoring.xp : result.xp);
    document.getElementById('complete-level').textContent = 'Level ' + result.level + ' \u2014 ' + Labs.Xp.titleForLevel(result.level);

    if (scenario.unlocks && scenario.unlocks.length > 0) {
      var unlockEl = document.getElementById('complete-unlock');
      if (unlockEl) {
        unlockEl.style.display = '';
      }
    }

    document.getElementById('lab-complete-overlay').classList.add('visible');

    var reportPanel = document.getElementById('report-panel');
    if (reportPanel && Labs.Debrief) {
      reportPanel.style.display = '';

      var evidenceHtml = '<div class="debrief-evidence">';
      scenario.evidencePieces.forEach(function(piece) {
        var found = !!discoveredEvidence[piece.id];
        evidenceHtml += '<div class="debrief-evidence-item ' + (found ? 'found' : 'missed') + '">' +
          (found ? '\u2713 ' : '\u2717 ') + piece.label + '</div>';
      });
      evidenceHtml += '</div>';

      Labs.Debrief.render({
        container: reportPanel,
        scoring: result.scoring,
        elapsed: elapsed,
        scenario: scenario,
        debriefContent: {
          analysis: '<div class="debrief-card"><h3>Incident: DNS Tunneling and Data Exfiltration</h3><p>The attacker (<code>103.78.44.91</code>, Singapore) used stolen SSH credentials belonging to sysadmin <code>j.nakamura</code> for initial access. The attack followed a precise kill chain: DNS reconnaissance for internal hostnames, SSH login with valid credentials, targeted file access to financial reports, and 2.1 GB SCP exfiltration to a staging server in the Netherlands.</p><p>The DNS tunneling channel via <code>data.exfil-tunnel.xyz</code> was used for low-bandwidth C2 communication, while SCP handled the bulk data transfer. The attacker\'s total dwell time was only 13 minutes.</p></div>' + '<div class="debrief-card"><h3>Evidence Summary</h3>' + evidenceHtml + '</div>',

          framework: '<div class="debrief-card"><h3>DNS Tunneling Detection</h3><p><strong>Beacon analysis:</strong> DNS tunneling generates regular-interval queries to a single domain with high-entropy subdomain prefixes. Normal DNS traffic is bursty and distributed across many domains. A single domain receiving queries every 30-60 seconds is a strong beacon indicator.</p><p><strong>Query characteristics:</strong> Tunneling queries use unusually long subdomain names (encoded data), TXT record types (larger payload capacity), and consistent timing. Normal queries use A/AAAA records with short, human-readable names.</p><p><strong>Volume anomaly:</strong> A single internal host generating hundreds of DNS queries to one domain in a short window is highly anomalous compared to normal browsing patterns.</p></div>' + '<div class="debrief-card"><h3>Detection Improvements</h3><p><strong>DNS monitoring:</strong> Alert on external IPs querying internal hostnames (<code>*.internal.corp</code>). Alert on single-domain query volume exceeding thresholds. Monitor for TXT record query spikes.</p><p><strong>SSH hardening:</strong> Disable password authentication. Require key-based or certificate-based auth. Deploy jump boxes and IP allowlisting.</p><p><strong>DLP rules:</strong> Alert on SCP/SFTP transfers exceeding 100 MB to external IPs. Require approval for large transfers.</p><p><strong>UEBA baseline:</strong> Flag logins from new geolocations for privileged accounts.</p></div>',

          code: '<div class="debrief-section-title">Attack Chain</div><div class="debrief-code"><span class="vuln">04:15 — DNS recon: 103.78.44.91 queries fileserver.internal.corp\n04:22 — SSH login: j.nakamura from Singapore (stolen creds)\n04:25 — File access: Q4-2025-earnings.xlsx via SCP\n04:26 — File access: M&A-pipeline-2026.pdf via SCP\n04:28 — File access: board-materials-march.pdf via SCP\n04:31 — Exfiltration: 2.1 GB SCP to 45.77.132.18 (Netherlands)\n04:35 — SSH disconnect — dwell time: 13 minutes\n06:00 — DLP alert triggers investigation</span></div><div class="debrief-section-title" style="margin-top:16px;">Key Indicators of Compromise</div><div class="debrief-code"><span class="fix">IP: 103.78.44.91 (attacker — Singapore)\nIP: 45.77.132.18 (exfil staging — Netherlands)\nDomain: data.exfil-tunnel.xyz (DNS C2)\nUser: j.nakamura (compromised sysadmin)\nHost: 10.0.1.50 (fileserver.internal.corp)\nData: 2.1 GB financial reports</span></div>',

          crossPerspective: {
            title: 'What the Attacker Did',
            description: 'From the attacker\'s perspective, this was a targeted intrusion using pre-obtained credentials and internal network knowledge. The DNS tunneling channel provided stealthy C2 while SCP handled bulk exfiltration. The entire operation was completed in 13 minutes — well within the average detection gap for most SOC teams. The attacker\'s prior reconnaissance (knowing internal hostnames and file locations) suggests an earlier compromise or insider knowledge.',
            linkText: 'Try the Red Team Attack \u2192',
            linkHref: '/labs/red/dns-tunnel/'
          }
        }
      });
    }

    var statusEl = document.getElementById('soc-mission-status');
    if (statusEl) {
      statusEl.textContent = '\u2713 Incident Resolved';
      statusEl.style.color = '#4ade80';
    }
  }
});
</script>
