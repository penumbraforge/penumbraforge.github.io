<script src="/js/tool-io.js"></script>
<script type="module">
import { TOOLS } from '/js/tools-lib.js';
import { NET_TOOLS } from '/js/tools-net.js';
var grid = document.getElementById('mcpGrid');
function card(k, reg, net) { return '<div class="wb-mcp-tool"><b>' + k + (net ? ' <span class="wb-mcp-net">net</span>' : '') + '</b><span>' + reg[k].description + '</span></div>'; }
grid.innerHTML = Object.keys(TOOLS).map(function (k) { return card(k, TOOLS); }).join('')
  + Object.keys(NET_TOOLS).map(function (k) { return card(k, NET_TOOLS, true); }).join('');
// Keep the existing code-block action and give it an explicit keyboard target.
document.querySelectorAll('pre[data-copy]').forEach(function (pre) {
  var button = document.createElement('button');
  button.type = 'button';
  button.className = 'agents-copy';
  button.textContent = 'Copy';
  button.setAttribute('aria-label', 'Copy command');
  pre.parentElement.querySelector('.wb-panel-bar').appendChild(button);
  async function copyCommand() {
    var toast = document.getElementById('wbToast');
    try {
      if (!navigator.clipboard) throw new Error('Clipboard unavailable');
      await navigator.clipboard.writeText(pre.textContent.replace(/^#.*$/gm, '').trim());
      toast.textContent = 'Copied to clipboard';
      button.textContent = 'Copied';
    } catch (error) {
      toast.textContent = 'Copy unavailable. Select the command text to copy it manually.';
    }
    toast.classList.add('show');
    clearTimeout(toast._t);
    toast._t = setTimeout(function () { toast.classList.remove('show'); }, 3000);
    clearTimeout(button._t);
    button._t = setTimeout(function () { button.textContent = 'Copy'; }, 2000);
  }
  button.addEventListener('click', copyCommand);
  pre.addEventListener('click', copyCommand);
});
</script>
