<!-- DOCUMENTATION -->
<section class="gate-section" id="docs">
  <div class="gate-container-wide">
    <p class="section-label reveal">Documentation</p>

    <!-- Installation & Setup -->
    <div class="gate-docs-section reveal" id="docs-install">
      <h2 class="gate-docs-heading">Installation &amp; Setup</h2>

      <p class="gate-docs-text">The fastest way to run Gate is with npx -- no install required. For repeated use, install globally.</p>

      <div class="gate-docs-code"><span class="cmt"># Run once without installing</span>
npx @penumbraforge/gate

<span class="cmt"># Install globally</span>
npm install -g @penumbraforge/gate

<span class="cmt"># Verify installation</span>
gate version</div>

      <h3 class="gate-docs-sub" id="docs-init">Project setup</h3>
      <p class="gate-docs-text">Run <code>gate init</code> in any repository to create a <code>.gaterc</code> config file and install the pre-commit hook.</p>

      <div class="gate-docs-code">gate init
<span class="cmt"># creates .gaterc and installs pre-commit hook</span></div>

      <h3 class="gate-docs-sub" id="docs-config">Configuration (.gaterc)</h3>
      <p class="gate-docs-text">Gate works with zero configuration. For customization, create a <code>.gaterc</code> file in your project root. YAML format.</p>

      <div class="gate-docs-code"><span class="cmt"># .gaterc</span>
<span class="kw">severity</span>: high            <span class="cmt"># minimum severity: low, medium, high, critical</span>
<span class="kw">verify</span>: true              <span class="cmt"># opt-in: check if secrets are live (off by default)</span>
<span class="kw">format</span>: text              <span class="cmt"># output: text, json, sarif</span>
<span class="kw">interactive</span>: true         <span class="cmt"># prompt for fix/vault/ignore</span>

<span class="kw">rules</span>:
  <span class="kw">disable</span>:
    - generic-high-entropy <span class="cmt"># disable noisy rules</span>
  <span class="kw">custom</span>:                  <span class="cmt"># add your own patterns</span>
    - <span class="kw">id</span>: internal-api-key
      <span class="kw">pattern</span>: <span class="val">'INTERNAL_[A-Za-z0-9]{32}'</span>
      <span class="kw">severity</span>: high

<span class="kw">ignore</span>:
  <span class="kw">files</span>:
    - <span class="str">'**/*.test.ts'</span>       <span class="cmt"># skip test files</span>
    - <span class="str">'vendor/**'</span>          <span class="cmt"># skip vendor directory</span>
  <span class="kw">values</span>:
    - <span class="str">'EXAMPLE_KEY_*'</span>      <span class="cmt"># ignore placeholder values</span></div>

      <h3 class="gate-docs-sub" id="docs-gateignore">.gateignore</h3>
      <p class="gate-docs-text">Works like .gitignore. One pattern per line. Files matching these patterns are skipped during scanning.</p>

      <div class="gate-docs-code"><span class="cmt"># .gateignore</span>
node_modules/
dist/
*.min.js
vendor/
coverage/
__snapshots__/</div>
    </div>

