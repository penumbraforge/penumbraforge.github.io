<!-- SECURITY PROMISE -->
<section class="gate-section" id="security">
  <div class="gate-container">
    <p class="section-label reveal">Security promise</p>
    <div class="gate-security-list reveal" style="transition-delay: 0.05s;">
      <div class="gate-security-item"><strong>Runs 100% locally.</strong> No telemetry, no cloud, no data ever leaves your machine.</div>
      <div class="gate-security-item"><strong>File permissions hardened.</strong> Config and vault files created with 0o600/0o700 permissions.</div>
      <div class="gate-security-item"><strong>Atomic file writes.</strong> Writes to temp files first, then renames. No partial writes, no corruption.</div>
      <div class="gate-security-item"><strong>Secrets redacted in output.</strong> Terminal output masks credential values. Full values never displayed.</div>
      <div class="gate-security-item"><strong>TLS enforced for verification.</strong> All provider API calls use TLS. No plaintext credential transmission.</div>
      <div class="gate-security-item"><strong>No shell injection.</strong> All subprocesses use execFileSync with explicit argument arrays.</div>
    </div>
  </div>
</section>

<script>
  function copyCmd(btn, text) {
    navigator.clipboard.writeText(text).then(function() {
      btn.textContent = 'copied';
      btn.classList.add('copied');
      setTimeout(function() {
        btn.textContent = 'copy';
        btn.classList.remove('copied');
      }, 2000);
    });
  }

  // Intersection observer for reveal animations
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('.reveal').forEach(function(el) {
    observer.observe(el);
  });
</script>
