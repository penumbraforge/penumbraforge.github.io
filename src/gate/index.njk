<!-- HERO -->
<header class="gate-hero" id="top">
  <div class="reveal">
    <h1 class="gate-hero-name">gate</h1>
  </div>
  <div class="reveal" style="transition-delay: 0.1s;">
    <p class="gate-hero-tagline">A command-line scanner that looks for hardcoded secrets and helps you move them out.</p>
  </div>
  <div class="reveal" style="transition-delay: 0.2s;">
    <p class="gate-hero-sub">Free. Runs on your machine. No account, no telemetry.</p>
  </div>
  <div class="reveal" style="transition-delay: 0.25s;">
    <p class="gate-hero-sub">Experimental, pre-1.0. Detection is pattern-based, so it will produce false positives and miss things. Read any fix before you commit it, and please report what breaks.</p>
  </div>
  <div class="reveal" style="transition-delay: 0.3s;">
    <p class="gate-hero-sub"><a href="/gate/wiki/">Documentation</a>&ensp;&middot;&ensp;<a href="https://github.com/penumbraforge/gate" target="_blank" rel="noopener">GitHub</a></p>
  </div>
</header>

<!-- QUICK START -->
<section class="gate-section" id="quick-start">
  <div class="gate-container">
    <p class="section-label reveal">Quick start</p>
    <div class="gate-install-blocks reveal" style="transition-delay: 0.05s;">
      <div class="gate-install-block">
        <span class="gate-install-label">zero-install</span>
        <code><span class="prompt">$ </span>npx @penumbraforge/gate</code>
        <button class="gate-copy-btn" data-copy="npx @penumbraforge/gate">copy</button>
      </div>
      <div class="gate-install-block">
        <span class="gate-install-label">global</span>
        <code><span class="prompt">$ </span>npm install -g @penumbraforge/gate</code>
        <button class="gate-copy-btn" data-copy="npm install -g @penumbraforge/gate">copy</button>
      </div>
    </div>
    <p class="gate-install-note reveal" style="transition-delay: 0.1s;">One command, no config file needed to start. Requires Node.js {{ versions.gate.node }}+.</p>
  </div>
</section>

