<!-- HERO -->
<header class="gate-hero" id="top">
  <div class="reveal">
    <h1 class="gate-hero-name">gate</h1>
  </div>
  <div class="reveal" style="transition-delay: 0.1s;">
    <p class="gate-hero-tagline">A command-line scanner that looks for hardcoded secrets and helps you move them out.</p>
  </div>
  <div class="reveal" style="transition-delay: 0.2s;">
    <p class="gate-hero-sub">Free. Runs on your machine. No account or intentional product telemetry. Opt-in credential verification and update checks use documented network endpoints.</p>
  </div>
  <div class="reveal" style="transition-delay: 0.25s;">
    <p class="gate-hero-sub">Experimental 2.x software with no published external security or efficacy audit. Detection is pattern-based, so it will produce false positives and miss things. Read any fix before you commit it.</p>
  </div>
  <div class="reveal" style="transition-delay: 0.3s;">
    <p class="gate-hero-sub"><a href="/gate/wiki/">Documentation</a>&ensp;&middot;&ensp;<a href="https://github.com/penumbraforge/gate" target="_blank" rel="noopener">GitHub</a></p>
  </div>
</header>

<!-- QUICK START -->
<section class="gate-section" id="quick-start">
  <div class="gate-container">
    <p class="section-label reveal">Quick start</p>
    <div class="gate-install-blocks reveal" style="transition-delay: 0.05s;">
      <div class="gate-install-block">
        <span class="gate-install-label">zero-install</span>
        <code><span class="prompt">$ </span>npx @penumbraforge/gate scan --all</code>
        <button class="gate-copy-btn" data-copy="npx @penumbraforge/gate scan --all">copy</button>
      </div>
      <div class="gate-install-block">
        <span class="gate-install-label">global</span>
        <code><span class="prompt">$ </span>npm install -g @penumbraforge/gate</code>
        <button class="gate-copy-btn" data-copy="npm install -g @penumbraforge/gate">copy</button>
      </div>
    </div>
    <p class="gate-install-note reveal" style="transition-delay: 0.1s;">The explicit scan inspects tracked files. A bare <code>gate</code> command installs/shows hook status instead of scanning. Requires Node.js {{ versions.gate.node }}+.</p>
  </div>
</section>

<section class="gate-section" id="scope">
  <div class="gate-container-wide">
    <p class="section-label reveal">Current scope</p>
    <div class="gate-docs-section reveal">
      <h2 class="gate-docs-heading">What Gate covers</h2>
      <p class="gate-docs-text">Gate is an experimental local secret-pattern scanner with interactive remediation, optional provider verification, history tooling, and SARIF. Detection is pattern-based and has not been externally audited or benchmarked. Treat findings as review input, not proof that a repository is free of secrets.</p>
    </div>
  </div>
</section>

