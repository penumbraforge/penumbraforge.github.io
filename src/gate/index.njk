<!-- SECURITY PROMISE -->
<section class="gate-section" id="security">
  <div class="gate-container">
    <p class="section-label reveal">How Gate handles your data</p>
    <div class="gate-security-list reveal" style="transition-delay: 0.05s;">
      <div class="gate-security-item"><strong>Runs locally.</strong> No telemetry and no cloud service. The only outbound requests are the opt-in <code>--verify</code> checks.</div>
      <div class="gate-security-item"><strong>Restrictive file permissions.</strong> Config and vault files are created with 0o600/0o700 permissions.</div>
      <div class="gate-security-item"><strong>Atomic file writes.</strong> Writes go to a temp file, then rename, so an interrupted write leaves the original intact.</div>
      <div class="gate-security-item"><strong>Secrets redacted in output.</strong> Terminal output masks matched credential values.</div>
      <div class="gate-security-item"><strong>TLS for verification.</strong> Provider API calls during <code>--verify</code> go over TLS.</div>
      <div class="gate-security-item"><strong>No shell interpolation.</strong> Subprocesses use execFileSync with explicit argument arrays.</div>
    </div>
  </div>
</section>

<script>
  // Reveal animations come from the shared handler in base.njk.
  document.querySelectorAll('.gate-copy-btn[data-copy]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      navigator.clipboard.writeText(btn.dataset.copy).then(function() {
        btn.textContent = 'copied';
        btn.classList.add('copied');
        setTimeout(function() {
          btn.textContent = 'copy';
          btn.classList.remove('copied');
        }, 2000);
      });
    });
  });
</script>
