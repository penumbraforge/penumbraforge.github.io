<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{% block title %}{{ title or site.title }}{% endblock %}</title>
  <meta name="description" content="{% block description %}{{ description or site.description }}{% endblock %}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  {% block head %}
  <!-- Open Graph -->
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:image" content="{{ site.url }}/og-image.png">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ site.url }}/og-image.png">
  <meta name="twitter:title" content="{{ title or site.title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="theme-color" content="#e9ebe6">
  {% endblock %}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.json">

  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="{{ site.url }}/feed.xml">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/style.css?v={{ assetv }}">

  <link rel="stylesheet" href="/css/studio.css?v={{ assetv }}">
  <link rel="stylesheet" href="/css/editorial.css?v={{ assetv }}">

  <!-- Speculation Rules — prerender internal pages on hover for instant navigation -->
  <script type="speculationrules">
  {
    "prefetch": [{ "where": { "href_matches": "/*" }, "eagerness": "moderate" }],
    "prerender": [{ "where": { "href_matches": "/tools/*" }, "eagerness": "moderate" }]
  }
  </script>

  {% block headExtra %}{% endblock %}

  <!-- JSON-LD Structured Data -->
  {% block jsonld %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.name }}",
    "legalName": "{{ site.legalName }}",
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}/apple-touch-icon.png",
    "description": "{{ site.description }}",
    "foundingDate": "{{ site.foundingYear }}",
    "founder": {
      "@type": "Person",
      "name": "{{ site.author.name }}",
      "jobTitle": "Founder",
      "sameAs": ["{{ site.author.linkedin }}"]
    },
    "sameAs": [
      "https://github.com/penumbraforge",
      "{{ site.author.linkedin }}"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "{{ site.author.email }}",
      "contactType": "customer support"
    }
  }
  </script>
  {% endblock %}
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  {% block body %}
  {% if not hideAtmosphere %}
  <!-- Atmosphere — one static painted layer, no JS, no repaint cost -->
  <div class="page-atmosphere" aria-hidden="true"></div>
  {% endif %}

  <!-- Content — z-index: 1, sits above the atmosphere -->
  <div class="content">
    {{ content | safe }}
    {% include "footer.njk" %}
  </div>
  {% endblock %}

  <script defer src="/js/site-nav.js?v={{ assetv }}"></script>

  <!-- Site console — summoned with ⌘` / Ctrl+` -->
  <script defer src="/js/console.js?v={{ assetv }}"></script>

  <!-- Recorded terminal demos — only loaded on pages that have one -->
  <script defer src="/js/demo-player.js?v={{ assetv }}"></script>

  <!-- Cloudflare Web Analytics -->
  <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "6579e863544d4aaea2538c83110ac7e2"}'></script>
</body>
</html>
