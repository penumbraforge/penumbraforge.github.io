{# Red Team Lab Workspace — Eleventy layout (not Nunjucks extends) #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ labTitle }} — Security Labs | Penumbra Forge</title>
  <meta name="description" content="{{ labDescription }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ labTitle }} — Penumbra Forge Security Labs">
  <meta property="og:description" content="{{ labDescription }}">
  <meta property="og:image" content="{{ site.url }}/og-image.png">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200;12..96,300;12..96,400;12..96,500;12..96,600&family=Plus+Jakarta+Sans:ital,wght@0,200;0,300;0,400;0,500;0,600;1,300&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/labs.css">
</head>
<body style="overflow:hidden;height:100vh;">

<!-- Topbar -->
<div class="lab-topbar">
  <a href="/" class="lab-topbar-brand">
    <div class="lab-topbar-orb"></div>
    <span>Penumbra Forge</span>
  </a>
  <div class="lab-topbar-sep"></div>
  <a href="/labs/" class="lab-topbar-back">&#x2190; Labs</a>
  <div class="lab-topbar-sep"></div>
  <span class="lab-topbar-title">{{ labCode }} — {{ labTitle }}</span>
  <span class="lab-topbar-diff diff-{{ labDifficulty }}">{{ labDifficulty }}</span>
  <span class="lab-topbar-timer" id="lab-timer">00:00</span>
  <button class="lab-topbar-reset" onclick="location.reload()">Reset Lab</button>
</div>

<!-- Lab Engine (must load before lab content scripts) -->
<script src="/js/lab-engine.js"></script>

<!-- Workspace -->
<div class="lab-workspace">
  {{ content | safe }}
</div>

<!-- Completion Overlay -->
<div class="lab-complete-overlay" id="lab-complete-overlay">
  <div class="lab-complete-card">
    <div class="lab-complete-icon">&#x1f3c6;</div>
    <div class="lab-complete-title">Lab Complete</div>
    <div class="lab-complete-sub">{{ labCompletionText or 'You successfully completed the lab objectives.' }}</div>
    <div class="lab-complete-stats">
      <div class="lab-complete-stat"><div class="lab-complete-stat-num" id="complete-time">0:00</div><div class="lab-complete-stat-label">Time</div></div>
      <div class="lab-complete-stat"><div class="lab-complete-stat-num" id="complete-score">0</div><div class="lab-complete-stat-label">Score</div></div>
      <div class="lab-complete-stat"><div class="lab-complete-stat-num" id="complete-xp">+0</div><div class="lab-complete-stat-label">XP</div></div>
      <div class="lab-complete-stat"><div class="lab-complete-stat-num" id="complete-hints">0</div><div class="lab-complete-stat-label">Hints</div></div>
    </div>
    <div class="lab-complete-level" id="complete-level"></div>
    <div class="lab-complete-actions">
      <button class="lab-complete-btn lab-complete-btn-primary" onclick="document.getElementById('lab-complete-overlay').classList.remove('visible')">View Debrief</button>
      <a class="lab-complete-btn lab-complete-btn-secondary" id="complete-unlock" href="/labs/" style="display:none;text-decoration:none;">Next Lab &#x2192;</a>
    </div>
  </div>
</div>

<!-- Disclaimer gate -->
<div id="lab-disclaimer-gate" style="display:none;position:fixed;inset:0;background:var(--surface-0);z-index:999;overflow-y:auto;">
  <div style="max-width:600px;margin:0 auto;padding:48px 32px;text-align:center;">
    <div style="font-size:48px;margin-bottom:16px;">&#x1f6e1;</div>
    <h2 style="font-family:var(--font-display);font-size:24px;color:var(--text-1);font-weight:400;margin-bottom:12px;">Before You Begin</h2>
    <p style="font-size:14px;color:var(--text-3);line-height:1.7;margin-bottom:24px;">These labs contain real, intentionally vulnerable applications running on isolated infrastructure. The techniques you learn here are powerful. Use them responsibly.</p>
    <div style="text-align:left;background:var(--surface-1);border:1px solid var(--border);border-radius:12px;padding:24px;margin-bottom:24px;">
      <div style="font-size:13px;color:var(--text-2);line-height:1.8;">
        <div style="margin-bottom:8px;"><span style="color:var(--sage);">&#x2713;</span> For <strong style="color:var(--text-1);">education and authorized testing only</strong></div>
        <div><span style="color:#eb5757;">&#x2717;</span> Do not use against systems <strong style="color:var(--text-1);">without authorization</strong></div>
      </div>
    </div>
    <button id="lab-disclaimer-accept" style="padding:14px 40px;background:rgba(184,165,214,0.12);color:var(--accent-strong);border:1px solid rgba(184,165,214,0.2);border-radius:10px;font-family:var(--font-sans);font-size:14px;cursor:pointer;">I Understand — Start Lab</button>
  </div>
</div>

<!-- Core Scripts -->
<script>
(function() {
  var ACCEPTED_KEY = 'pf-labs-disclaimer-accepted';
  if (!localStorage.getItem(ACCEPTED_KEY)) {
    var gate = document.getElementById('lab-disclaimer-gate');
    gate.style.display = '';
    document.getElementById('lab-disclaimer-accept').addEventListener('click', function() {
      localStorage.setItem(ACCEPTED_KEY, Date.now().toString());
      gate.style.display = 'none';
    });
  }

  // Tab switching
  document.querySelectorAll('.lab-panel-tabs').forEach(function(tabs) {
    var panel = tabs.closest('.lab-mission-panel, .lab-inspector, .blue-mission-panel');
    if (!panel) return;
    tabs.querySelectorAll('.lab-panel-tab').forEach(function(tab) {
      tab.addEventListener('click', function() {
        var tabName = this.getAttribute('data-tab');
        tabs.querySelectorAll('.lab-panel-tab').forEach(function(t) { t.classList.remove('active'); });
        this.classList.add('active');
        panel.querySelectorAll('.lab-tab-content').forEach(function(c) {
          c.classList.toggle('active', c.getAttribute('data-tab-content') === tabName);
        });
      });
    });
  });

  // Console input (if present)
  var consoleInput = document.getElementById('console-input');
  if (consoleInput) {
    consoleInput.addEventListener('keydown', function(e) {
      if (e.key !== 'Enter') return;
      var cmd = this.value.trim();
      if (!cmd) return;
      var out = document.getElementById('console-output');
      out.innerHTML += '<div><span class="c-prompt">$ </span>' + cmd.replace(/</g, '&lt;') + '</div>';

      if (cmd === 'help') {
        out.innerHTML += '<div class="c-info">Available commands:</div>';
        out.innerHTML += '<div class="c-info">  help          — show this help</div>';
        out.innerHTML += '<div class="c-info">  curl [url]    — simulate an HTTP request</div>';
        out.innerHTML += '<div class="c-info">  nmap [target] — simulate a port scan</div>';
        out.innerHTML += '<div class="c-info">  dig [domain]  — simulate DNS lookup</div>';
        out.innerHTML += '<div class="c-info">  cookie        — show current session cookie</div>';
        out.innerHTML += '<div class="c-info">  headers       — show response headers</div>';
        out.innerHTML += '<div class="c-info">  clear         — clear console</div>';
      } else if (cmd === 'cookie' || cmd === 'document.cookie') {
        out.innerHTML += '<div class="c-ok">session=eyJhZG1pbiI6ZmFsc2UsInVzZXIiOiJndWVzdCJ9</div>';
        out.innerHTML += '<div class="c-info">Decoded: {"admin":false,"user":"guest"}</div>';
      } else if (cmd === 'headers') {
        out.innerHTML += '<div>HTTP/1.1 200 OK</div>';
        out.innerHTML += '<div>Content-Type: text/html; charset=UTF-8</div>';
        out.innerHTML += '<div>X-Powered-By: Express</div>';
        out.innerHTML += '<div class="c-err">No Content-Security-Policy header found</div>';
        out.innerHTML += '<div class="c-err">No X-Frame-Options header found</div>';
      } else if (cmd === 'clear') {
        out.innerHTML = '';
      } else if (cmd.startsWith('curl')) {
        var url = cmd.replace('curl', '').replace('-I', '').replace('-v', '').trim();
        if (url) {
          out.innerHTML += '<div class="c-info">Connecting to ' + url.replace(/</g, '&lt;') + '...</div>';
          out.innerHTML += '<div>HTTP/1.1 200 OK</div>';
          out.innerHTML += '<div>Content-Type: text/html</div>';
          out.innerHTML += '<div class="c-ok">&lt;html&gt;...response body...&lt;/html&gt;</div>';
        } else {
          out.innerHTML += '<div class="c-err">Usage: curl [url]</div>';
        }
      } else if (cmd.startsWith('nmap')) {
        var target = cmd.replace('nmap', '').trim();
        out.innerHTML += '<div class="c-info">Starting Nmap scan of ' + (target || 'target').replace(/</g, '&lt;') + '</div>';
        out.innerHTML += '<div>PORT     STATE  SERVICE</div>';
        out.innerHTML += '<div>22/tcp   open   ssh</div>';
        out.innerHTML += '<div>80/tcp   open   http</div>';
        out.innerHTML += '<div>443/tcp  open   https</div>';
        out.innerHTML += '<div>3000/tcp open   node</div>';
        out.innerHTML += '<div class="c-info">4 ports open</div>';
      } else if (cmd.startsWith('dig')) {
        var domain = cmd.replace('dig', '').trim();
        out.innerHTML += '<div class="c-info">;; ANSWER SECTION:</div>';
        out.innerHTML += '<div>' + (domain || 'target.com').replace(/</g, '&lt;') + '  300  IN  A  104.21.48.12</div>';
        out.innerHTML += '<div>' + (domain || 'target.com').replace(/</g, '&lt;') + '  300  IN  A  172.67.154.8</div>';
      } else {
        out.innerHTML += '<div class="c-err">Command not found: ' + cmd.replace(/</g, '&lt;') + '. Type "help" for available commands.</div>';
      }
      this.value = '';
      out.scrollTop = out.scrollHeight;
    });
  }
})();
</script>

<!-- Cloudflare Web Analytics -->
<script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "6579e863544d4aaea2538c83110ac7e2"}'></script>
</body>
</html>
