<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Umbra Docs</title>
  <meta name="description" content="{{ description or 'Umbra documentation — the local AI development environment by Penumbra Forge' }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:title" content="{{ title }} — Umbra Docs">
  <meta property="og:description" content="{{ description or 'Umbra documentation' }}">
  <meta property="og:image" content="{{ site.url }}/og-image.png">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="article">

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,200;0,300;0,400;0,500;0,600;1,300&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=14">
  <link rel="stylesheet" href="/css/docs.css?v=3">
</head>
<body class="docs-body">
  <div class="docs-layout">
    <nav class="docs-sidebar">
      <a href="/umbra/" class="docs-logo">
        <div class="docs-logo-mark"></div>
        <span>Umbra Docs</span>
      </a>

      <div class="docs-nav-group">
        <div class="docs-nav-label">Getting Started</div>
        <a href="/umbra/" class="docs-nav-link {% if page.url == '/umbra/' %}active{% endif %}">Overview</a>
        <a href="/umbra/installation/" class="docs-nav-link {% if page.url == '/umbra/installation/' %}active{% endif %}">Installation</a>
        <a href="/umbra/quickstart/" class="docs-nav-link {% if page.url == '/umbra/quickstart/' %}active{% endif %}">Quick Start</a>
        <a href="/umbra/models/" class="docs-nav-link {% if page.url == '/umbra/models/' %}active{% endif %}">Models</a>
      </div>

      <div class="docs-nav-group">
        <div class="docs-nav-label">Core Features</div>
        <a href="/umbra/chat/" class="docs-nav-link {% if page.url == '/umbra/chat/' %}active{% endif %}">Chat</a>
        <a href="/umbra/editor/" class="docs-nav-link {% if page.url == '/umbra/editor/' %}active{% endif %}">Code Editor</a>
        <a href="/umbra/terminal/" class="docs-nav-link {% if page.url == '/umbra/terminal/' %}active{% endif %}">Terminal</a>
        <a href="/umbra/agent-mode/" class="docs-nav-link {% if page.url == '/umbra/agent-mode/' %}active{% endif %}">Agent Mode</a>
      </div>

      <div class="docs-nav-group">
        <div class="docs-nav-label">AI Features</div>
        <a href="/umbra/knowledge-packs/" class="docs-nav-link {% if page.url == '/umbra/knowledge-packs/' %}active{% endif %}">Knowledge Packs</a>
        <a href="/umbra/codebase-rag/" class="docs-nav-link {% if page.url == '/umbra/codebase-rag/' %}active{% endif %}">Codebase RAG</a>
        <a href="/umbra/inline-completion/" class="docs-nav-link {% if page.url == '/umbra/inline-completion/' %}active{% endif %}">Inline Completion</a>
        <a href="/umbra/mentions/" class="docs-nav-link {% if page.url == '/umbra/mentions/' %}active{% endif %}">@ Mentions</a>
      </div>

      <div class="docs-nav-group">
        <div class="docs-nav-label">Developer Tools</div>
        <a href="/umbra/git/" class="docs-nav-link {% if page.url == '/umbra/git/' %}active{% endif %}">Git Integration</a>
        <a href="/umbra/debugger/" class="docs-nav-link {% if page.url == '/umbra/debugger/' %}active{% endif %}">Debugger</a>
        <a href="/umbra/sandbox/" class="docs-nav-link {% if page.url == '/umbra/sandbox/' %}active{% endif %}">Sandbox Runner</a>
        <a href="/umbra/export/" class="docs-nav-link {% if page.url == '/umbra/export/' %}active{% endif %}">Export &amp; Deploy</a>
      </div>

      <div class="docs-nav-group">
        <div class="docs-nav-label">Customization</div>
        <a href="/umbra/settings/" class="docs-nav-link {% if page.url == '/umbra/settings/' %}active{% endif %}">Settings</a>
        <a href="/umbra/themes/" class="docs-nav-link {% if page.url == '/umbra/themes/' %}active{% endif %}">Themes</a>
        <a href="/umbra/keyboard-shortcuts/" class="docs-nav-link {% if page.url == '/umbra/keyboard-shortcuts/' %}active{% endif %}">Keyboard Shortcuts</a>
        <a href="/umbra/plugins/" class="docs-nav-link {% if page.url == '/umbra/plugins/' %}active{% endif %}">Plugins</a>
      </div>

      <div class="docs-nav-group">
        <div class="docs-nav-label">Architecture</div>
        <a href="/umbra/architecture/" class="docs-nav-link {% if page.url == '/umbra/architecture/' %}active{% endif %}">Overview</a>
        <a href="/umbra/engine-system/" class="docs-nav-link {% if page.url == '/umbra/engine-system/' %}active{% endif %}">Engine System</a>
        <a href="/umbra/deep-hooks/" class="docs-nav-link {% if page.url == '/umbra/deep-hooks/' %}active{% endif %}">Deep Inference Hooks</a>
        <a href="/umbra/api-reference/" class="docs-nav-link {% if page.url == '/umbra/api-reference/' %}active{% endif %}">API Reference</a>
      </div>

      <div class="docs-nav-footer">
        <a href="https://github.com/penumbraforge">GitHub</a>
        <a href="/">Penumbra Forge</a>
      </div>
    </nav>

    <main class="docs-main">
      <article class="docs-content">
        {{ content | safe }}
      </article>

      {% if nextPage %}
      <div class="docs-next">
        <a href="{{ nextPage.url }}">
          <span class="docs-next-label">Next</span>
          <span class="docs-next-title">{{ nextPage.title }} &rarr;</span>
        </a>
      </div>
      {% endif %}

      <footer class="docs-footer">
        <span>&copy; 2026 Penumbra Forge</span>
      </footer>
    </main>
  </div>
</body>
</html>
