<script>
(function() {
  var sidebar = document.getElementById('sidebar');
  var toggle = document.getElementById('sidebarToggle');
  var overlay = document.getElementById('sidebarOverlay');
  var searchInput = document.getElementById('sidebarSearch');
  var items = Array.prototype.slice.call(sidebar.querySelectorAll('.sidebar-item'));
  var sections = Array.prototype.slice.call(sidebar.querySelectorAll('.sidebar-section[data-category]'));
  var dividers = Array.prototype.slice.call(sidebar.querySelectorAll('.sidebar-divider:not(.sidebar-favorites-divider)'));
  var STORAGE_KEY = 'pf-favorites';

  /* --- Search filter --- */
  searchInput.addEventListener('input', function() {
    var q = this.value.toLowerCase().trim();
    sections.forEach(function(sec) {
      var sectionItems = Array.prototype.slice.call(sec.querySelectorAll('.sidebar-item'));
      var visibleCount = 0;
      sectionItems.forEach(function(item) {
        var name = item.getAttribute('data-name') || '';
        var kw = item.getAttribute('data-keywords') || '';
        var match = q === '' || name.indexOf(q) !== -1 || kw.indexOf(q) !== -1;
        item.style.display = match ? '' : 'none';
        if (match) visibleCount++;
      });
      sec.style.display = visibleCount === 0 && q !== '' ? 'none' : '';
    });
    dividers.forEach(function(d) {
      d.style.display = q !== '' ? 'none' : '';
    });
    if (q === '') dividers.forEach(function(d) { d.style.display = ''; });
  });

  /* --- Cmd+K focus --- */
  document.addEventListener('keydown', function(e) {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      searchInput.focus();
      searchInput.select();
    }
  });

  /* --- Mobile toggle --- */
  if (toggle) {
    toggle.addEventListener('click', function() {
      sidebar.classList.toggle('open');
      overlay.classList.toggle('open');
    });
  }
  if (overlay) {
    overlay.addEventListener('click', function() {
      sidebar.classList.remove('open');
      overlay.classList.remove('open');
    });
  }

  /* --- Favorites --- */
  function getFavorites() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; }
    catch(e) { return []; }
  }

  function saveFavorites(favs) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(favs));
  }

  function renderFavorites() {
    var favs = getFavorites();
    var section = document.getElementById('favoritesSection');
    var divider = document.getElementById('favoritesDivider');
    var list = document.getElementById('favoritesList');

    if (favs.length === 0) {
      section.style.display = 'none';
      divider.style.display = 'none';
      return;
    }

    section.style.display = '';
    divider.style.display = '';
    list.innerHTML = '';

    favs.forEach(function(slug) {
      var original = items.find(function(it) { return it.getAttribute('data-slug') === slug; });
      if (!original) return;
      var name = original.querySelector('.sidebar-item-name').textContent;
      var href = original.getAttribute('href');
      var isActive = original.classList.contains('active');

      var a = document.createElement('a');
      a.className = 'sidebar-item' + (isActive ? ' active' : '');
      a.href = href;
      a.setAttribute('data-slug', slug);

      var nameSpan = document.createElement('span');
      nameSpan.className = 'sidebar-item-name';
      nameSpan.textContent = name;
      a.appendChild(nameSpan);

      var star = document.createElement('span');
      star.className = 'sidebar-item-star starred';
      star.innerHTML = '&#9733;';
      star.setAttribute('data-slug', slug);
      star.title = 'Remove favorite';
      star.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        toggleFavorite(slug);
      });
      a.appendChild(star);

      list.appendChild(a);
    });
  }

  function toggleFavorite(slug) {
    var favs = getFavorites();
    var idx = favs.indexOf(slug);
    if (idx === -1) {
      favs.push(slug);
    } else {
      favs.splice(idx, 1);
    }
    saveFavorites(favs);
    updateStarStates();
    renderFavorites();
  }

  function updateStarStates() {
    var favs = getFavorites();
    items.forEach(function(item) {
      var star = item.querySelector('.sidebar-item-star');
      if (!star) return;
      var slug = star.getAttribute('data-slug');
      if (favs.indexOf(slug) !== -1) {
        star.classList.add('starred');
        star.innerHTML = '&#9733;';
      } else {
        star.classList.remove('starred');
        star.innerHTML = '&#9734;';
      }
    });
  }

  /* Star click handlers */
  items.forEach(function(item) {
    var star = item.querySelector('.sidebar-item-star');
    if (!star) return;
    star.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      toggleFavorite(star.getAttribute('data-slug'));
    });
  });

  /* Init */
  updateStarStates();
  renderFavorites();

  /* ============================================================
     SPA-style content swapping — sidebar stays static
     Each tool page is still a real HTML page (SEO intact).
     Clicking a link fetches the page, swaps .tools-content,
     and updates the URL via pushState.
     ============================================================ */
  var contentArea = document.querySelector('.tools-content');
  var isNavigating = false;

  function isToolsLink(href) {
    return href && href.indexOf('/tools/') === 0 && href !== window.location.pathname;
  }

  function updateActiveState(path) {
    /* Update sidebar active states */
    items.forEach(function(item) {
      var href = item.getAttribute('href');
      if (href === path) {
        item.classList.add('active');
      } else {
        item.classList.remove('active');
      }
    });
    /* Update favorites active states */
    var favItems = document.querySelectorAll('#favoritesList .sidebar-item');
    favItems.forEach(function(item) {
      var href = item.getAttribute('href');
      if (href === path) {
        item.classList.add('active');
      } else {
        item.classList.remove('active');
      }
    });
  }

  function swapContent(url, pushState) {
    if (isNavigating) return;
    isNavigating = true;

    fetch(url)
      .then(function(res) {
        if (!res.ok) throw new Error('fetch failed');
        return res.text();
      })
      .then(function(html) {
        /* Parse the fetched page */
        var parser = new DOMParser();
        var doc = parser.parseFromString(html, 'text/html');
        var newContent = doc.querySelector('.tools-content');

        if (!newContent) {
          /* Not a tools page — do a normal navigation */
          window.location.href = url;
          return;
        }

        /* Swap the content area */
        contentArea.innerHTML = newContent.innerHTML;

        /* Update URL */
        if (pushState) {
          history.pushState({ toolsNav: true }, '', url);
        }

        /* Update page title */
        var newTitle = doc.querySelector('title');
        if (newTitle) document.title = newTitle.textContent;

        /* Update active states */
        updateActiveState(url);
        renderFavorites();

        /* Scroll content to top */
        contentArea.scrollTop = 0;
        window.scrollTo(0, 0);

        /* Execute any inline scripts in the new content (tool JS) */
        var scripts = contentArea.querySelectorAll('script');
        scripts.forEach(function(oldScript) {
          var newScript = document.createElement('script');
          if (oldScript.src) {
            newScript.src = oldScript.src;
          } else {
            newScript.textContent = oldScript.textContent;
          }
          oldScript.parentNode.replaceChild(newScript, oldScript);
        });

        /* Close mobile sidebar if open */
        sidebar.classList.remove('open');
        if (overlay) overlay.classList.remove('open');

        isNavigating = false;
      })
      .catch(function() {
        /* Fallback to normal navigation on error */
        window.location.href = url;
        isNavigating = false;
      });
  }

  /* Intercept clicks on links within the tools section */
  document.addEventListener('click', function(e) {
    var link = e.target.closest('a[href]');
    if (!link) return;

    var href = link.getAttribute('href');
    if (!isToolsLink(href)) return;

    /* Don't intercept if modifier keys are held (open in new tab etc) */
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

    e.preventDefault();
    swapContent(href, true);
  });

  /* Handle browser back/forward */
  window.addEventListener('popstate', function(e) {
    if (window.location.pathname.indexOf('/tools/') === 0) {
      swapContent(window.location.pathname, false);
    }
  });
})();
</script>
