<header class="site-header{% if headerTone == 'dark' %} site-header--dark{% endif %}" id="site-header">
  <a href="/" class="site-header-brand" aria-label="Penumbra Forge home">
    <span class="site-header-mark" aria-hidden="true"></span>
    <span class="site-header-name">Penumbra Forge</span>
  </a>
  <button class="site-header-toggle" type="button" aria-controls="site-navigation" aria-expanded="false">Menu <span aria-hidden="true">+</span></button>
  <nav class="site-header-nav" id="site-navigation" aria-label="Main">
    <a href="/#selected-work"{% if productName %} class="active"{% endif %}>Selected work</a>
    <a href="/tools/"{% if "/tools/" in page.url %} class="active" aria-current="{% if page.url == '/tools/' %}page{% else %}true{% endif %}"{% endif %}>Tools</a>
    <a href="/blog/"{% if "/blog/" in page.url %} class="active" aria-current="{% if page.url == '/blog/' %}page{% else %}true{% endif %}"{% endif %}>Notes</a>
    <a href="/about/"{% if page.url == "/about/" %} class="active" aria-current="page"{% endif %}>Studio</a>
    <a href="https://github.com/penumbraforge" target="_blank" rel="noopener" class="site-header-git">GitHub <span aria-hidden="true">↗</span></a>
  </nav>
</header>
