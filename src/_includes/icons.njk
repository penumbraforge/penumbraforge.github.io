{# Hairline icon set — 24x24, 1.5 stroke, currentColor.
   Matches the site's rule-and-hairline aesthetic; replaces the emoji glyphs
   that rendered differently on every platform. Usage: {{ icon("crescent") }} #}
{% macro icon(name, size = 24) -%}
{%- set p = {
  "crescent":  '<path d="M20 14.5A8.5 8.5 0 019.5 4a8.5 8.5 0 1010.5 10.5z"/>',
  "home":      '<path d="M3 10.5L12 3l9 7.5"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5.5h4V20"/>',
  "chip":      '<rect x="7" y="7" width="10" height="10" rx="1.5"/><path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4"/>',
  "shield":    '<path d="M12 3l7.5 3.5v5c0 4.5-3.2 8.4-7.5 9.5-4.3-1.1-7.5-5-7.5-9.5v-5L12 3z"/>',
  "terminal":  '<rect x="3" y="4.5" width="18" height="15" rx="2"/><path d="M7.5 9.5l3 2.5-3 2.5M13 15h4"/>',
  "key":       '<circle cx="8" cy="12" r="4"/><path d="M12 12h9M18 12v3.5M15.5 12v2.5"/>',
  "search":    '<circle cx="11" cy="11" r="7"/><path d="M20 20l-4.2-4.2"/>',
  "copy":      '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 012-2h9"/>',
  "check":     '<path d="M4.5 12.5l5 5 10-11"/>',
  "arrow":     '<path d="M4 12h15M13 6l6 6-6 6"/>',
  "github":    '<path d="M9 19c-4.3 1.4-4.3-2.2-6-2.6m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 00-1.3-3.2 4.3 4.3 0 00-.1-3.2s-1.05-.3-3.6 1.3a12.3 12.3 0 00-6 0C6.45 3.2 5.4 3.5 5.4 3.5a4.3 4.3 0 00-.1 3.2A4.6 4.6 0 004 9.9c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>'
} -%}
<svg class="fx-icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ p[name] | default(p["crescent"]) | safe }}</svg>
{%- endmacro %}
