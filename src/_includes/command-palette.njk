{# Shared ⌘K command palette — included on tool pages and the hub #}
<div class="cp-backdrop" id="cpBackdrop" hidden></div>
<div class="cp" id="cp" role="dialog" aria-modal="true" aria-label="Search tools" hidden>
  <div class="cp-inputbar">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
    <input type="text" id="cpInput" placeholder="Search or run — try 'sha256 of hello', 'cidr 10.0.0.0/24', paste a JWT…" autocomplete="off" spellcheck="false" aria-label="Search or run a tool">
    <kbd>ESC</kbd>
  </div>
  <div class="cp-run" id="cpRun" hidden></div>
  <div class="cp-list" id="cpList" role="listbox"></div>
  <div class="cp-foot"><span><kbd>↑↓</kbd> navigate</span><span><kbd>↵</kbd> open</span><span><kbd>esc</kbd> close</span></div>
</div>

<script id="cpData" type="application/json">
[{% for t in tools %}{% if t.status == "live" %}{"s":"{{ t.slug }}","n":"{{ t.name | replace('"','') }}","c":"{{ t.category }}","d":"{{ t.description | replace('"','') | replace('\n',' ') }}","k":"{{ (t.keywords or []) | join(' ') }}"{% if t.isNew %},"new":1{% endif %}}{% if not loop.last %},{% endif %}{% endif %}{% endfor %}]
</script>

<style>
.cp-backdrop { position: fixed; inset: 0; z-index: 300; background: rgba(3,3,7,0.72); backdrop-filter: blur(6px); animation: cpFade 160ms ease; }
.cp { position: fixed; z-index: 301; top: 12vh; left: 50%; translate: -50% 0; width: min(640px, 92vw);
  background: #0b0b14; border: 1px solid color-mix(in oklab, var(--accent) 26%, var(--border)); border-radius: 8px;
  box-shadow: 0 40px 100px -30px rgba(0,0,0,0.9), 0 0 0 1px rgba(0,0,0,0.4); overflow: hidden; animation: cpIn 200ms cubic-bezier(0.16,1,0.3,1); }
@keyframes cpFade { from { opacity: 0; } } @keyframes cpIn { from { opacity: 0; translate: -50% 12px; } }
.cp-inputbar { display: flex; align-items: center; gap: 12px; padding: 16px 18px; border-bottom: 1px solid var(--border); color: var(--text-3); }
.cp-inputbar input { flex: 1; background: none; border: 0; outline: 0; color: var(--text-1); font-family: var(--font-sans); font-size: 16px; font-weight: 300; }
.cp-inputbar input::placeholder { color: var(--text-3); }
.cp-inputbar kbd, .cp-foot kbd { font-family: var(--font-mono); font-size: 10px; color: var(--text-3); border: 1px solid var(--border); border-radius: 3px; padding: 2px 6px; }
.cp-list { max-height: 52vh; overflow-y: auto; padding: 8px; }
.cp-item { display: flex; align-items: center; gap: 12px; padding: 11px 12px; border-radius: 5px; cursor: pointer; text-decoration: none; }
.cp-item[aria-selected="true"] { background: color-mix(in oklab, var(--accent) 15%, transparent); }
.cp-item-ic { width: 26px; height: 26px; flex-shrink: 0; display: grid; place-items: center; border-radius: 5px; border: 1px solid color-mix(in oklab, var(--accent) 22%, transparent); color: var(--accent); font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; }
.cp-item-body { min-width: 0; flex: 1; }
.cp-item-name { font-size: 13.5px; color: var(--text-1); font-weight: 500; display: flex; align-items: center; gap: 8px; }
.cp-item-name mark { background: color-mix(in oklab, var(--accent) 30%, transparent); color: #fff; border-radius: 2px; }
.cp-item-desc { font-size: 12px; color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cp-item-cat { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; text-transform: uppercase; color: var(--text-3); }
.cp-item .cp-new { font-family: var(--font-mono); font-size: 8px; letter-spacing: 1px; color: var(--accent); border: 1px solid color-mix(in oklab, var(--accent) 40%, transparent); padding: 1px 5px; border-radius: 2px; }
.cp-empty { padding: 30px; text-align: center; color: var(--text-3); font-size: 13px; }
.cp-foot { display: flex; gap: 18px; padding: 10px 18px; border-top: 1px solid var(--border); font-family: var(--font-mono); font-size: 10.5px; color: var(--text-3); }
.cp-foot span { display: flex; align-items: center; gap: 6px; }
/* live run result */
.cp-run { border-bottom: 1px solid var(--border); padding: 12px 14px; background: color-mix(in oklab, var(--accent) 5%, transparent); }
.cp-run-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.cp-run-badge { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 1px; text-transform: uppercase; color: var(--accent); }
.cp-run-open { font-family: var(--font-mono); font-size: 10.5px; color: var(--text-2); }
.cp-run-open:hover { color: var(--accent); }
.cp-run-out { font-family: var(--font-mono); font-size: 12.5px; line-height: 1.6; color: var(--text-1); background: #06060d; border: 1px solid var(--border); border-radius: 4px; padding: 11px 13px; margin: 0; max-height: 220px; overflow: auto; white-space: pre-wrap; word-break: break-all; }
.cp-run-err { color: #e8a87c; }
.cp-run-copy { margin-top: 8px; font-family: var(--font-mono); font-size: 10.5px; color: var(--text-2); background: none; border: 1px solid var(--border); border-radius: 3px; padding: 5px 12px; cursor: pointer; }
.cp-run-copy:hover { border-color: var(--accent); color: var(--accent); }
@media (prefers-reduced-motion: reduce) { .cp, .cp-backdrop { animation: none; } }
</style>

<script>
(function () {
  var cp = document.getElementById('cp'), bd = document.getElementById('cpBackdrop');
  var input = document.getElementById('cpInput'), list = document.getElementById('cpList');
  if (!cp) return;
  var TOOLS = JSON.parse(document.getElementById('cpData').textContent);
  var sel = 0, filtered = TOOLS.slice();

  function esc(s){ return s.replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
  function recents(){ try { return JSON.parse(localStorage.getItem('pf:recent')||'[]'); } catch(e){ return []; } }
  function score(t, q){
    var n=t.n.toLowerCase(), i=n.indexOf(q);
    if(i===0) return 120; if(i>0) return 100-Math.min(i,40);
    if((' '+t.k).indexOf(' '+q)!==-1) return 70;
    if(t.k.indexOf(q)!==-1) return 50;
    if(t.d.toLowerCase().indexOf(q)!==-1) return 30;
    var qi=0; for(var ci=0; ci<n.length&&qi<q.length; ci++){ if(n[ci]===q[qi]) qi++; }
    return (qi===q.length&&q.length>2)?12:0;
  }
  function render(){
    var q=input.value.trim().toLowerCase();
    if(!q){
      var rec=recents(); var recSet={};
      filtered = rec.map(function(s){ recSet[s]=1; return TOOLS.find(function(t){return t.s===s;}); }).filter(Boolean)
        .concat(TOOLS.filter(function(t){ return !recSet[t.s]; }));
    } else {
      filtered = TOOLS.map(function(t){ return {t:t, sc:score(t,q)}; }).filter(function(x){return x.sc>0;})
        .sort(function(a,b){return b.sc-a.sc;}).map(function(x){return x.t;});
    }
    sel = 0;
    if(!filtered.length){ list.innerHTML='<div class="cp-empty">No tools match “'+esc(input.value)+'”.</div>'; return; }
    list.innerHTML = filtered.slice(0,40).map(function(t,idx){
      var nm=t.n, ql=q; if(ql){ var i=nm.toLowerCase().indexOf(ql); if(i>=0) nm=esc(nm.slice(0,i))+'<mark>'+esc(nm.slice(i,i+ql.length))+'</mark>'+esc(nm.slice(i+ql.length)); else nm=esc(nm); } else nm=esc(nm);
      return '<a class="cp-item" role="option" href="/tools/'+t.s+'/" aria-selected="'+(idx===0)+'" data-i="'+idx+'">'
        +'<span class="cp-item-ic">'+esc(t.c.slice(0,2))+'</span>'
        +'<span class="cp-item-body"><span class="cp-item-name">'+nm+(t.new?' <span class="cp-new">NEW</span>':'')+'</span>'
        +'<span class="cp-item-desc">'+esc(t.d)+'</span></span>'
        +'<span class="cp-item-cat">'+esc(t.c)+'</span></a>';
    }).join('');
  }
  function move(d){
    var items=list.querySelectorAll('.cp-item'); if(!items.length) return;
    items[sel] && items[sel].setAttribute('aria-selected','false');
    sel=(sel+d+items.length)%items.length;
    items[sel].setAttribute('aria-selected','true');
    items[sel].scrollIntoView({block:'nearest'});
  }
  function open(){ bd.hidden=false; cp.hidden=false; input.value=''; var rr=document.getElementById('cpRun'); if(rr){rr.hidden=true;rr.innerHTML='';} render(); setTimeout(function(){input.focus();},20); document.documentElement.style.overflow='hidden'; }
  function close(){ bd.hidden=true; cp.hidden=true; document.documentElement.style.overflow=''; }
  function isOpen(){ return !cp.hidden; }

  document.addEventListener('keydown', function(e){
    if((e.metaKey||e.ctrlKey) && e.key.toLowerCase()==='k'){ e.preventDefault(); isOpen()?close():open(); return; }
    if(!isOpen()) return;
    if(e.key==='Escape'){ e.preventDefault(); close(); }
    else if(e.key==='ArrowDown'){ e.preventDefault(); move(1); }
    else if(e.key==='ArrowUp'){ e.preventDefault(); move(-1); }
    else if(e.key==='Enter'){ var it=list.querySelectorAll('.cp-item')[sel]; if(it){ e.preventDefault(); location.href=it.href; } }
  });
  input && input.addEventListener('input', render);
  bd && bd.addEventListener('click', close);
  list && list.addEventListener('mousemove', function(e){ var it=e.target.closest('.cp-item'); if(it){ var i=+it.dataset.i; if(i!==sel){ var items=list.querySelectorAll('.cp-item'); items[sel]&&items[sel].setAttribute('aria-selected','false'); sel=i; it.setAttribute('aria-selected','true'); } } });
  document.querySelectorAll('[data-open-palette]').forEach(function(b){ b.addEventListener('click', function(e){ e.preventDefault(); open(); }); });
  window.__openPalette = open;
})();
</script>

<script type="module">
/* Live "run" — the site you can talk to. Parses intent and executes a
   tools-lib function inline, showing the same result an agent gets over MCP. */
import { TOOLS } from '/js/tools-lib.js';
(function () {
  var input = document.getElementById('cpInput'), runEl = document.getElementById('cpRun');
  if (!input || !runEl) return;
  var PAGE = { hash:'hash-generator', hmac:'hash-generator', base64:'base64-encoder', base64url:'base64-encoder', hex:'base64-encoder', url_encode:'url-encoder', jwt_decode:'jwt-decoder', uuid:'uuid-generator', entropy:'entropy-xray', epoch:'epoch-converter', password:'password-generator', color:'color-converter', cidr:'subnet-calculator', totp:'totp-generator' };
  function normAlgo(s){ s=s.toUpperCase().replace(/[^A-Z0-9]/g,''); if(s==='MD5')return 'MD5'; if(s==='SHA1')return 'SHA-1'; var m=s.match(/SHA(256|384|512)/); return m?'SHA-'+m[1]:'SHA-256'; }
  function esc(s){ return String(s).replace(/[&<>]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c];}); }
  function parse(q){
    q=q.trim(); if(!q) return null; var m;
    if(m=q.match(/^(sha-?1|sha-?256|sha-?384|sha-?512|md5)\s+(?:of\s+)?([\s\S]+)$/i)) return {name:'hash',args:{text:m[2],algo:normAlgo(m[1])},label:normAlgo(m[1])};
    if(m=q.match(/^hash\s+(?:of\s+)?([\s\S]+)$/i)) return {name:'hash',args:{text:m[1],algo:'SHA-256'},label:'sha-256'};
    if(m=q.match(/^base64url\s+(decode|dec)?\s*([\s\S]+)$/i)) return {name:'base64url',args:{text:m[2].trim(),mode:m[1]?'decode':'encode'},label:'base64url'};
    if(m=q.match(/^base64\s+(decode|dec)?\s*([\s\S]+)$/i)) return {name:'base64',args:{text:m[2].trim(),mode:m[1]?'decode':'encode'},label:'base64'};
    if(m=q.match(/^hex\s+(decode|dec)?\s*([\s\S]+)$/i)) return {name:'hex',args:{text:m[2].trim(),mode:m[1]?'decode':'encode'},label:'hex'};
    if(m=q.match(/^url\s+(encode|decode)?\s*([\s\S]+)$/i)) return {name:'url_encode',args:{text:m[2].trim(),mode:/dec/i.test(m[1]||'')?'decode':'encode'},label:'url'};
    if(m=q.match(/^uuid(?:\s*v?\s*([47]))?\s*$/i)) return {name:'uuid',args:{version:m[1]||'4'},label:'uuid'};
    if(m=q.match(/^entropy\s+(?:of\s+)?([\s\S]+)$/i)) return {name:'entropy',args:{text:m[1]},label:'entropy'};
    if(m=q.match(/^password\s*(\d+)?\s*$/i)) return {name:'password',args:{length:+(m[1]||24)},label:'password'};
    if(m=q.match(/^slug(?:ify)?\s+([\s\S]+)$/i)) return {name:'slugify',args:{text:m[1]},label:'slug'};
    if(m=q.match(/^totp\s+([\s\S]+)$/i)) return {name:'totp',args:{key:m[1].trim()},label:'totp'};
    if(m=q.match(/^(?:cidr|subnet)\s+([\s\S]+)$/i)) return {name:'cidr',args:{input:m[1].trim()},label:'subnet'};
    if(m=q.match(/^(?:color|colour)\s+([\s\S]+)$/i)) return {name:'color',args:{input:m[1].trim()},label:'color'};
    if(m=q.match(/^(?:epoch|unix|timestamp)\s+([\s\S]+)$/i)) return {name:'epoch',args:{value:m[1].trim()},label:'epoch'};
    if(m=q.match(/^(?:jwt|decode\s+jwt)\s+([\s\S]+)$/i)) return {name:'jwt_decode',args:{token:m[1].trim()},label:'jwt'};
    if(/^ey[\w-]+\.[\w-]+\.[\w-]*$/.test(q)) return {name:'jwt_decode',args:{token:q},label:'jwt'};
    if(/^\d{1,3}(\.\d{1,3}){3}\/\d{1,2}$/.test(q)) return {name:'cidr',args:{input:q},label:'subnet'};
    if(/^#[0-9a-f]{3}([0-9a-f]{3})?$/i.test(q)) return {name:'color',args:{input:q},label:'color'};
    if(/^\d{10,13}$/.test(q)) return {name:'epoch',args:{value:q},label:'epoch'};
    return null;
  }
  var seq = 0;
  input.addEventListener('input', function () {
    var intent = parse(input.value);
    if (!intent || !TOOLS[intent.name]) { runEl.hidden = true; runEl.innerHTML = ''; return; }
    var my = ++seq;
    Promise.resolve().then(function () { return TOOLS[intent.name].run(intent.args); }).then(function (res) {
      if (my !== seq) return;
      var out = (res && res.output != null) ? String(res.output) : JSON.stringify(res, null, 2);
      var slug = PAGE[intent.name];
      var payload = intent.args.text || intent.args.input || intent.args.value || intent.args.token;
      runEl.hidden = false; runEl.textContent = '';
      var head = document.createElement('div'); head.className = 'cp-run-head';
      var badge = document.createElement('span'); badge.className = 'cp-run-badge'; badge.textContent = '⚡ ' + intent.label;
      head.appendChild(badge);
      if (slug) { var a = document.createElement('a'); a.className = 'cp-run-open'; a.href = '/tools/' + slug + '/' + (payload ? '?in=' + encodeURIComponent(payload) : ''); a.textContent = 'open tool →'; head.appendChild(a); }
      var pre = document.createElement('pre'); pre.className = 'cp-run-out'; pre.textContent = out;
      var copy = document.createElement('button'); copy.className = 'cp-run-copy'; copy.textContent = 'copy';
      copy.addEventListener('click', function (e) { e.stopPropagation(); if (navigator.clipboard) navigator.clipboard.writeText(out); copy.textContent = 'copied'; setTimeout(function () { copy.textContent = 'copy'; }, 1200); });
      runEl.appendChild(head); runEl.appendChild(pre); runEl.appendChild(copy);
    }).catch(function (err) {
      if (my !== seq) return;
      runEl.hidden = false; runEl.textContent = '';
      var pre = document.createElement('pre'); pre.className = 'cp-run-out cp-run-err'; pre.textContent = err.message; runEl.appendChild(pre);
    });
  });
})();
</script>
