{% extends "base.njk" %}

{% block title %}{{ title }} — {{ productName | capitalize }} Wiki | Penumbra Forge{% endblock %}
{% block description %}{{ description or (productName | capitalize) + " wiki — comprehensive documentation." }}{% endblock %}

{% block head %}
<meta property="og:title" content="{{ title }} — {{ productName | capitalize }} Wiki | Penumbra Forge">
<meta property="og:description" content="{{ description or (productName | capitalize) + ' wiki — comprehensive documentation.' }}">
<meta property="og:image" content="{{ site.url }}/og-image.png">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block body %}
<div class="wiki-page">

  <header class="site-header" id="site-header">
    <a href="/" class="site-header-brand" title="Penumbra Forge">
      <div class="site-header-orb" aria-hidden="true"><div class="site-header-orb-backlight"></div><div class="site-header-orb-corona"></div><div class="site-header-orb-glow"></div><div class="site-header-orb-edge"></div><div class="site-header-orb-shadow"></div></div>
          </a>
    <button class="site-header-toggle" aria-label="Toggle menu"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="5" x2="17" y2="5"/><line x1="3" y1="10" x2="17" y2="10"/><line x1="3" y1="15" x2="17" y2="15"/></svg></button>
    <nav class="site-header-nav">
      <a href="/">Home</a>
      <a href="/tools/">Tools</a>
      <a href="/labs/">Labs</a>
        <a href="/blog/">Blog</a>
      <a href="/gate/"{% if productName == "gate" %} class="active"{% endif %}>Gate</a>
      {% if productName == "gate" %}<a href="/gate/wiki/">Wiki</a>{% endif %}
      <a href="/librarian/"{% if productName == "librarian" %} class="active"{% endif %}>Librarian</a>
      {% if productName == "librarian" %}<a href="/librarian/wiki/">Wiki</a>{% endif %}
      <a href="/vexes/"{% if productName == "vexes" %} class="active"{% endif %}>Vexes</a>
      {% if productName == "vexes" %}<a href="/vexes/wiki/">Wiki</a>{% endif %}
      <a href="https://github.com/penumbraforge" target="_blank" rel="noopener">GitHub</a>
    </nav>
  </header>

  <div class="wiki-layout">
    <aside class="wiki-sidebar" id="sidebar">
      <div class="sidebar-title">Wiki</div>
      <ul class="sidebar-nav">
        {% if productName == "gate" %}
        <li><a href="/gate/wiki/"{% if page.url == "/gate/wiki/" %} class="active"{% endif %}>Home</a></li>
        <li><a href="/gate/wiki/getting-started/"{% if page.url == "/gate/wiki/getting-started/" %} class="active"{% endif %}>Getting Started</a></li>
        <li><a href="/gate/wiki/commands/"{% if page.url == "/gate/wiki/commands/" %} class="active"{% endif %}>Commands Reference</a></li>
        <li><a href="/gate/wiki/configuration/"{% if page.url == "/gate/wiki/configuration/" %} class="active"{% endif %}>Configuration</a></li>
        <li><a href="/gate/wiki/ignore-patterns/"{% if page.url == "/gate/wiki/ignore-patterns/" %} class="active"{% endif %}>Ignore Patterns</a></li>
        <li><a href="/gate/wiki/auto-fix/"{% if page.url == "/gate/wiki/auto-fix/" %} class="active"{% endif %}>Auto-Fix Engine</a></li>
        <li><a href="/gate/wiki/verification/"{% if page.url == "/gate/wiki/verification/" %} class="active"{% endif %}>Credential Verification</a></li>
        <li><a href="/gate/wiki/incident-response/"{% if page.url == "/gate/wiki/incident-response/" %} class="active"{% endif %}>Incident Response</a></li>
        <li><a href="/gate/wiki/compliance/"{% if page.url == "/gate/wiki/compliance/" %} class="active"{% endif %}>Compliance Reports</a></li>
        <li><a href="/gate/wiki/github-action/"{% if page.url == "/gate/wiki/github-action/" %} class="active"{% endif %}>GitHub Action</a></li>
        <li><a href="/gate/wiki/security/"{% if page.url == "/gate/wiki/security/" %} class="active"{% endif %}>Security Model</a></li>
        {% elif productName == "librarian" %}
        <li><a href="/librarian/wiki/"{% if page.url == "/librarian/wiki/" %} class="active"{% endif %}>Home</a></li>
        <li><a href="/librarian/wiki/getting-started/"{% if page.url == "/librarian/wiki/getting-started/" %} class="active"{% endif %}>Getting Started</a></li>
        <li><a href="/librarian/wiki/tools-reference/"{% if page.url == "/librarian/wiki/tools-reference/" %} class="active"{% endif %}>Tools Reference</a></li>
        <li><a href="/librarian/wiki/skill-format/"{% if page.url == "/librarian/wiki/skill-format/" %} class="active"{% endif %}>Skill Format</a></li>
        <li><a href="/librarian/wiki/auto-research/"{% if page.url == "/librarian/wiki/auto-research/" %} class="active"{% endif %}>Auto-Research</a></li>
        <li><a href="/librarian/wiki/community-packs/"{% if page.url == "/librarian/wiki/community-packs/" %} class="active"{% endif %}>Community Packs</a></li>
        <li><a href="/librarian/wiki/configuration/"{% if page.url == "/librarian/wiki/configuration/" %} class="active"{% endif %}>Configuration</a></li>
        <li><a href="/librarian/wiki/content-guard/"{% if page.url == "/librarian/wiki/content-guard/" %} class="active"{% endif %}>Content Guard</a></li>
        <li><a href="/librarian/wiki/signing/"{% if page.url == "/librarian/wiki/signing/" %} class="active"{% endif %}>Ed25519 Signing</a></li>
        <li><a href="/librarian/wiki/local-models/"{% if page.url == "/librarian/wiki/local-models/" %} class="active"{% endif %}>Local Models</a></li>
        {% elif productName == "vexes" %}
        <li><a href="/vexes/wiki/"{% if page.url == "/vexes/wiki/" %} class="active"{% endif %}>Home</a></li>
        <li><a href="/vexes/wiki/getting-started/"{% if page.url == "/vexes/wiki/getting-started/" %} class="active"{% endif %}>Getting Started</a></li>
        <li><a href="/vexes/wiki/commands/"{% if page.url == "/vexes/wiki/commands/" %} class="active"{% endif %}>Commands Reference</a></li>
        <li><a href="/vexes/wiki/detection-engine/"{% if page.url == "/vexes/wiki/detection-engine/" %} class="active"{% endif %}>Detection Engine</a></li>
        <li><a href="/vexes/wiki/pre-install-guard/"{% if page.url == "/vexes/wiki/pre-install-guard/" %} class="active"{% endif %}>Pre-Install Guard</a></li>
        <li><a href="/vexes/wiki/ecosystems/"{% if page.url == "/vexes/wiki/ecosystems/" %} class="active"{% endif %}>Ecosystems</a></li>
        <li><a href="/vexes/wiki/ci-cd/"{% if page.url == "/vexes/wiki/ci-cd/" %} class="active"{% endif %}>CI/CD Integration</a></li>
        <li><a href="/vexes/wiki/configuration/"{% if page.url == "/vexes/wiki/configuration/" %} class="active"{% endif %}>Configuration</a></li>
        <li><a href="/vexes/wiki/security/"{% if page.url == "/vexes/wiki/security/" %} class="active"{% endif %}>Security Model</a></li>
        {% endif %}
      </ul>
    </aside>

    <main class="wiki-content">
      {{ content | safe }}
    </main>
  </div>

  {% include "footer.njk" %}

</div>

<button class="sidebar-toggle" onclick="document.getElementById('sidebar').classList.toggle('open'); this.textContent = document.getElementById('sidebar').classList.contains('open') ? 'Close' : 'Menu'">Menu</button>
{% endblock %}
