{% extends "base.njk" %}

{% block title %}{{ title }} — {{ productName | capitalize }} Wiki | Penumbra Forge{% endblock %}
{% block description %}{{ description or (productName | capitalize) + " project documentation." }}{% endblock %}

{% block head %}
<meta property="og:title" content="{{ title }} — {{ productName | capitalize }} Wiki | Penumbra Forge">
<meta property="og:description" content="{{ description or (productName | capitalize) + ' project documentation.' }}">
<meta property="og:image" content="{{ site.url }}/og-image.png">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
{% endblock %}

{% block body %}
<div class="wiki-page">

  {% include "header.njk" %}

  <div class="wiki-shell-head">
    <nav class="editorial-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Studio</a><span aria-hidden="true">/</span><a href="/{{ productName }}/">{{ productName | capitalize }}</a><span aria-hidden="true">/</span><span>Documentation</span>
    </nav>
    <button class="wiki-contents-toggle" id="wiki-sidebar-toggle" type="button" aria-controls="sidebar" aria-expanded="false" hidden>Browse documentation <span aria-hidden="true">+</span></button>
  </div>
  <div class="wiki-layout">
    <aside class="wiki-sidebar" id="sidebar">
      <a class="wiki-project-link" href="/{{ productName }}/">{{ productName | capitalize }} <span aria-hidden="true">↗</span></a>
      <div class="sidebar-title">Documentation</div>
      <nav aria-label="{{ productName | capitalize }} documentation">
      <ul class="sidebar-nav">
        {% if productName == "gate" %}
        <li><a href="/gate/wiki/"{% if page.url == "/gate/wiki/" %} class="active" aria-current="page"{% endif %}>Home</a></li>
        <li><a href="/gate/wiki/getting-started/"{% if page.url == "/gate/wiki/getting-started/" %} class="active" aria-current="page"{% endif %}>Getting Started</a></li>
        <li><a href="/gate/wiki/commands/"{% if page.url == "/gate/wiki/commands/" %} class="active" aria-current="page"{% endif %}>Commands Reference</a></li>
        <li><a href="/gate/wiki/configuration/"{% if page.url == "/gate/wiki/configuration/" %} class="active" aria-current="page"{% endif %}>Configuration</a></li>
        <li><a href="/gate/wiki/ignore-patterns/"{% if page.url == "/gate/wiki/ignore-patterns/" %} class="active" aria-current="page"{% endif %}>Ignore Patterns</a></li>
        <li><a href="/gate/wiki/auto-fix/"{% if page.url == "/gate/wiki/auto-fix/" %} class="active" aria-current="page"{% endif %}>Bounded Source Rewrites</a></li>
        <li><a href="/gate/wiki/verification/"{% if page.url == "/gate/wiki/verification/" %} class="active" aria-current="page"{% endif %}>Credential Verification</a></li>
        <li><a href="/gate/wiki/incident-response/"{% if page.url == "/gate/wiki/incident-response/" %} class="active" aria-current="page"{% endif %}>Incident Artifacts</a></li>
        <li><a href="/gate/wiki/compliance/"{% if page.url == "/gate/wiki/compliance/" %} class="active" aria-current="page"{% endif %}>Reports with Framework Labels</a></li>
        <li><a href="/gate/wiki/github-action/"{% if page.url == "/gate/wiki/github-action/" %} class="active" aria-current="page"{% endif %}>GitHub Action</a></li>
        <li><a href="/gate/wiki/security/"{% if page.url == "/gate/wiki/security/" %} class="active" aria-current="page"{% endif %}>Security Model</a></li>
        {% elif productName == "librarian" %}
        <li><a href="/librarian/wiki/"{% if page.url == "/librarian/wiki/" %} class="active" aria-current="page"{% endif %}>Home</a></li>
        <li><a href="/librarian/wiki/getting-started/"{% if page.url == "/librarian/wiki/getting-started/" %} class="active" aria-current="page"{% endif %}>Getting Started</a></li>
        <li><a href="/librarian/wiki/tools-reference/"{% if page.url == "/librarian/wiki/tools-reference/" %} class="active" aria-current="page"{% endif %}>Tools Reference</a></li>
        <li><a href="/librarian/wiki/skill-format/"{% if page.url == "/librarian/wiki/skill-format/" %} class="active" aria-current="page"{% endif %}>Skill Format</a></li>
        <li><a href="/librarian/wiki/auto-research/"{% if page.url == "/librarian/wiki/auto-research/" %} class="active" aria-current="page"{% endif %}>Auto-Research</a></li>
        <li><a href="/librarian/wiki/community-packs/"{% if page.url == "/librarian/wiki/community-packs/" %} class="active" aria-current="page"{% endif %}>Indexed Packs</a></li>
        <li><a href="/librarian/wiki/configuration/"{% if page.url == "/librarian/wiki/configuration/" %} class="active" aria-current="page"{% endif %}>Configuration</a></li>
        <li><a href="/librarian/wiki/content-guard/"{% if page.url == "/librarian/wiki/content-guard/" %} class="active" aria-current="page"{% endif %}>Content Guard</a></li>
        <li><a href="/librarian/wiki/signing/"{% if page.url == "/librarian/wiki/signing/" %} class="active" aria-current="page"{% endif %}>Ed25519 Signing</a></li>
        <li><a href="/librarian/wiki/local-models/"{% if page.url == "/librarian/wiki/local-models/" %} class="active" aria-current="page"{% endif %}>Local Models</a></li>
        {% elif productName == "vexes" %}
        <li><a href="/vexes/wiki/"{% if page.url == "/vexes/wiki/" %} class="active" aria-current="page"{% endif %}>Home</a></li>
        <li><a href="/vexes/wiki/getting-started/"{% if page.url == "/vexes/wiki/getting-started/" %} class="active" aria-current="page"{% endif %}>Getting Started</a></li>
        <li><a href="/vexes/wiki/commands/"{% if page.url == "/vexes/wiki/commands/" %} class="active" aria-current="page"{% endif %}>Commands Reference</a></li>
        <li><a href="/vexes/wiki/detection-engine/"{% if page.url == "/vexes/wiki/detection-engine/" %} class="active" aria-current="page"{% endif %}>Detection Engine</a></li>
        <li><a href="/vexes/wiki/benchmark/"{% if page.url == "/vexes/wiki/benchmark/" %} class="active" aria-current="page"{% endif %}>Benchmark</a></li>
        <li><a href="/vexes/wiki/pre-install-guard/"{% if page.url == "/vexes/wiki/pre-install-guard/" %} class="active" aria-current="page"{% endif %}>Pre-Install Guard</a></li>
        <li><a href="/vexes/wiki/ecosystems/"{% if page.url == "/vexes/wiki/ecosystems/" %} class="active" aria-current="page"{% endif %}>Ecosystems</a></li>
        <li><a href="/vexes/wiki/ci-cd/"{% if page.url == "/vexes/wiki/ci-cd/" %} class="active" aria-current="page"{% endif %}>CI/CD Integration</a></li>
        <li><a href="/vexes/wiki/configuration/"{% if page.url == "/vexes/wiki/configuration/" %} class="active" aria-current="page"{% endif %}>Configuration</a></li>
        <li><a href="/vexes/wiki/security/"{% if page.url == "/vexes/wiki/security/" %} class="active" aria-current="page"{% endif %}>Security Model</a></li>
        {% endif %}
      </ul>
      </nav>
    </aside>

    <main class="wiki-content" id="main-content">
      {{ content | safe }}
    </main>
  </div>

  {% include "footer.njk" %}

</div>

<script>
(function () {
  var page = document.querySelector('.wiki-page');
  var sidebar = document.getElementById('sidebar');
  var toggle = document.getElementById('wiki-sidebar-toggle');
  if (!page || !sidebar || !toggle) return;

  toggle.hidden = false;
  page.classList.add('wiki-navigation-ready');
  function setOpen(open) {
    sidebar.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.lastElementChild.textContent = open ? '−' : '+';
  }
  toggle.addEventListener('click', function () {
    setOpen(!sidebar.classList.contains('open'));
  });
  page.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && sidebar.classList.contains('open')) {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 901px)').addEventListener('change', function (event) {
    if (event.matches) setOpen(false);
  });
})();
</script>
{% endblock %}
