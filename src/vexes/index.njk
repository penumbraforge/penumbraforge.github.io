<!-- SECURITY DESIGN -->
<section class="vexes-section" id="security">
  <div class="vexes-container">
    <p class="section-label reveal">Security design</p>
    <div class="vexes-security-list reveal" style="transition-delay: 0.05s;">
      <div class="vexes-security-item"><strong>Zero dependencies.</strong> The dependency chain is the attack surface. Acorn is vendored. SQLite is Node.js built-in.</div>
      <div class="vexes-security-item"><strong>Terminal injection protection.</strong> All external data sanitized — CSI, OSC, DCS, C1 controls, and bare ESC bytes.</div>
      <div class="vexes-security-item"><strong>Prototype pollution protection.</strong> Config merging rejects __proto__, constructor, and prototype keys.</div>
      <div class="vexes-security-item"><strong>Command injection prevention.</strong> Guard uses execFileSync with no shell and an allowlist of package managers.</div>
      <div class="vexes-security-item"><strong>Gzip bomb + SSRF protection.</strong> Streaming size limits, HTTPS-only, registry host allowlist.</div>
      <div class="vexes-security-item"><strong>Never recommends vulnerable fixes.</strong> Every suggested version is cross-checked against OSV before display.</div>
    </div>
  </div>
</section>

<script>
  function copyCmd(btn, text) {
    navigator.clipboard.writeText(text).then(function() {
      btn.textContent = 'copied';
      btn.classList.add('copied');
      setTimeout(function() {
        btn.textContent = 'copy';
        btn.classList.remove('copied');
      }, 2000);
    });
  }

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('.reveal').forEach(function(el) {
    observer.observe(el);
  });
</script>
