<!-- 4-LAYER DETECTION ENGINE -->
<section class="vexes-section" id="engine">
  <div class="vexes-container-wide">
    <p class="section-label reveal">4-layer detection engine</p>
    <div class="vexes-features-grid reveal" style="transition-delay: 0.05s;">
      <div class="vexes-feature-card">
        <div class="vexes-layer-num">1</div>
        <h3>AST Code Analysis</h3>
        <p>Parses JavaScript and Python source via acorn AST. Detects <code>eval()</code>, <code>child_process.exec()</code>, credential harvesting, obfuscated code, WebAssembly, DNS exfiltration, and prototype chain escapes.</p>
      </div>
      <div class="vexes-feature-card">
        <div class="vexes-layer-num">2</div>
        <h3>Dependency Graph Profiling</h3>
        <p>Detects phantom dependencies (brand-new packages), typosquatting via edit distance, Unicode homoglyph attacks, and circular staging by the same author.</p>
      </div>
      <div class="vexes-feature-card">
        <div class="vexes-layer-num">3</div>
        <h3>Behavioral Fingerprinting</h3>
        <p>Diffs capability profiles between versions. Catches when a utility library suddenly gains network + process execution capabilities.</p>
      </div>
      <div class="vexes-feature-card">
        <div class="vexes-layer-num">4</div>
        <h3>Registry Metadata Analysis</h3>
        <p>Profiles publish history, maintainer changes, rapid-fire releases, dormant package reactivation, and Sigstore provenance attestations.</p>
      </div>
    </div>
  </div>
</section>

