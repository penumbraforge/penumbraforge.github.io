<script>
// Eclipse corona — flowing light wisps
// Light bleeding off the edge of shadow
(function() {
  const canvas = document.getElementById('eclipse-particles');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const cx = 250;
  const cy = 250;
  const eclipseR = 70;

  const wisps = [];

  function spawnWisp() {
    const angle = Math.random() * Math.PI * 2;
    return {
      angle: angle,
      angleSpeed: (Math.random() - 0.5) * 0.001,
      startR: eclipseR - 4,
      r: eclipseR - 4,
      driftSpeed: 0.03 + Math.random() * 0.08,
      maxR: eclipseR + 20 + Math.random() * 60,
      size: 16 + Math.random() * 35,
      opacity: 0.015 + Math.random() * 0.03,
      life: 0,
      maxLife: 300 + Math.random() * 500,
      hue: 260 + Math.random() * 25,
      lightness: 60 + Math.random() * 15,
      stretch: 0.5 + Math.random() * 0.7,
    };
  }

  for (let i = 0; i < 12; i++) {
    const w = spawnWisp();
    w.life = Math.random() * w.maxLife;
    w.r = w.startR + w.driftSpeed * w.life;
    wisps.push(w);
  }

  function animate() {
    ctx.clearRect(0, 0, 500, 500);

    for (let i = wisps.length - 1; i >= 0; i--) {
      const w = wisps[i];
      w.life++;
      w.r += w.driftSpeed;
      w.angle += w.angleSpeed;

      const progress = w.life / w.maxLife;

      let alpha;
      if (progress < 0.15) {
        alpha = w.opacity * (progress / 0.15);
      } else if (progress > 0.7) {
        alpha = w.opacity * (1 - (progress - 0.7) / 0.3);
      } else {
        alpha = w.opacity;
      }

      const currentSize = w.size * (0.6 + progress * 0.8);

      if (w.life >= w.maxLife || alpha < 0.003) {
        wisps.splice(i, 1);
        wisps.push(spawnWisp());
        continue;
      }

      const x = cx + Math.cos(w.angle) * w.r;
      const y = cy + Math.sin(w.angle) * w.r;

      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(w.angle);
      ctx.scale(1, w.stretch);

      const grad = ctx.createRadialGradient(0, 0, 0, 0, 0, currentSize);
      grad.addColorStop(0, `hsla(${w.hue}, 35%, ${w.lightness}%, ${alpha * 1.5})`);
      grad.addColorStop(0.4, `hsla(${w.hue}, 30%, ${w.lightness}%, ${alpha * 0.6})`);
      grad.addColorStop(1, `hsla(${w.hue}, 25%, ${w.lightness}%, 0)`);

      ctx.beginPath();
      ctx.arc(0, 0, currentSize, 0, Math.PI * 2);
      ctx.fillStyle = grad;
      ctx.fill();

      ctx.restore();
    }

    requestAnimationFrame(animate);
  }

  requestAnimationFrame(animate);
})();

// Hero tool demo — rotating carousel
(function() {
  const slides = document.querySelectorAll('.demo-slide');
  const dots = document.querySelectorAll('.demo-dot');
  const toolName = document.getElementById('demo-tool-name');
  const carousel = document.getElementById('demo-carousel');
  if (!slides.length || !toolName) return;

  let current = 0;
  let timer = null;
  let paused = false;

  function show(index) {
    slides.forEach(function(s, i) {
      if (i === index) {
        s.classList.add('demo-slide--active');
      } else {
        s.classList.remove('demo-slide--active');
      }
    });
    dots.forEach(function(d, i) {
      if (i === index) {
        d.classList.add('demo-dot--active');
      } else {
        d.classList.remove('demo-dot--active');
      }
    });
    toolName.textContent = slides[index].getAttribute('data-tool');
    current = index;
  }

  function next() {
    show((current + 1) % slides.length);
  }

  function startTimer() {
    stopTimer();
    timer = setInterval(function() {
      if (!paused) next();
    }, 5000);
  }

  function stopTimer() {
    if (timer) { clearInterval(timer); timer = null; }
  }

  // Pause on hover
  var liveTool = document.querySelector('.live-tool');
  if (liveTool) {
    liveTool.addEventListener('mouseenter', function() { paused = true; });
    liveTool.addEventListener('mouseleave', function() { paused = false; });
  }

  // Dot click navigation
  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      show(parseInt(dot.getAttribute('data-index'), 10));
      startTimer();
    });
  });

  startTimer();
})();
</script>
